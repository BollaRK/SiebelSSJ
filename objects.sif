				   INACTIVE="N"
				   IS_USER_SEARCH_SPEC="N"
				   NAME="ProductSearchSepc"
				   SEARCH_SPECIFICATION="&quot;(([Cfg Latest Released Flag] = &apos;Y&apos;) OR ([Cfg Latest Released Flag] IS NULL) OR ([Cfg Released Flag] = &apos;N&apos; AND [Cfg Version]=1)) AND EXISTS ([VF Price List Id] = &apos;&quot; + [&amp;VFPricelistId] + &quot;&apos;) AND ([Category] = &apos;Postpay&apos; OR [Type] = &apos;Promotion&apos;) AND EXISTS ([VF SPS Product Category] = &apos;&quot; + [&amp;VFPropFilter] + &quot;&apos;)&quot; +  IIf ([&amp;NetworkProviderName] IS NOT NULL ,  &quot; AND ((((&quot;+ &quot;[Siebel Product Type] = &apos;NBN with MBB&apos;&quot;+ &quot; OR &quot;+ &quot;[Siebel Product Type] = &apos;NBN Only&apos;)&quot;+ &quot; AND &quot;+ &quot;[VF Network Identifier] = &apos;&quot;+[&amp;NetworkProviderName]+&quot;&apos;)&quot; + IIf([&amp;RetriveNBNPlanFlg] = &apos;Y&apos;, &quot;AND (&quot;+ &quot;[Special Siebel Product Type]= &apos;SMB&apos; )&quot;,&quot;&quot;) + &quot;)&quot; + &quot; OR &quot;+ &quot;[Siebel Product Type] = &apos;Voice&apos;)&quot; , &quot; AND (&quot;+ &quot;[Siebel Product Type] &lt;&gt; [FBB]&quot;+ &quot; AND &quot;+ &quot;[Siebel Product Type] &lt;&gt; [FBB1])&quot;)"
				   TYPE="EXPRESSION"
				   UPDATED="01/30/2026 13:16:06"
				   UPDATED_BY="SURESHK"
				   CREATED="01/30/2026 13:16:06"
