			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
	try
	{

		if(MethodName==&quot;ValidateRAFCode&quot;)
		{
			var bsvcr = TheApplication().GetService(&quot;VHA RAF Code Service&quot;);
			var psInpvcr = TheApplication().NewPropertySet();
			var psOutvcr = TheApplication().NewPropertySet();
			var sRAFCode = this.BusComp().GetFieldValue(&quot;VHA RAF Code&quot;);
			psInpvcr.SetProperty(&quot;RAFCode&quot;,sRAFCode);					
			bsvcr.InvokeMethod(&quot;ValidateRAFCode&quot;,psInpvcr,psOutvcr);						
			var sRAFValidation = psOutvcr.GetProperty(&quot;RAFValidation&quot;);	
			var sRAFCodeValidFlag = psOutvcr.GetProperty(&quot;RAFCodeValidFlag&quot;);
			var sRAFFailurecount;
			if(sRAFCodeValidFlag!=&quot;Y&quot;)
			{
				sRAFFailurecount = TheApplication().GetProfileAttr(&quot;RAFFailurecount&quot;);
				sRAFFailurecount = ToNumber(sRAFFailurecount)+1;
				TheApplication().SetProfileAttr(&quot;RAFFailurecount&quot;,sRAFFailurecount);
				this.BusComp().SetFieldValue(&quot;VHA RAF Code&quot;,&quot;&quot;);
				this.BusComp().SetFieldValue(&quot;RAF Status&quot;,&quot;Invalid&quot;);
				this.BusComp().WriteRecord();
				TheApplication().RaiseErrorText(sRAFValidation);
			}
			this.BusComp().SetFieldValue(&quot;RAF Status&quot;,&quot;Valid&quot;);
			this.BusComp().WriteRecord();	
			
		}
		
	}
	catch(e)
	{
		throw (e);		
	}
	finally
	{
		
	}
	return (ContinueOperation);
}"
