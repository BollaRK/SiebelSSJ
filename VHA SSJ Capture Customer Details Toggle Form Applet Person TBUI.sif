			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
	
	//Vasavi added for RAF Code
    if(MethodName == &quot;ValidateRAFCode&quot;)
    {
        var sFailureCount = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_RAF_FAILURE_COUNT&quot;, &quot;FailureCount&quot;);		
		var sEnableRAF = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;ENABLE_RAF&quot;);		
		var sRAFFailurecount = TheApplication().GetProfileAttr(&quot;RAFFailurecount&quot;);		
		if(this.BusComp().GetFieldValue(&quot;VHA RAF Code&quot;) == &quot;&quot; || sRAFFailurecount&gt;=sFailureCount || sEnableRAF!=&quot;Y&quot;)
        {
            CanInvoke = &quot;FALSE&quot;;
            return(CancelOperation);
        }
        else
        {
            var sRAFCode = this.BusComp().GetFieldValue(&quot;VHA RAF Code&quot;);
            var sRAFCodeLen = sRAFCode.length;
			var sRAF = sRAFCode.substring(0,3);
			var sNum=&quot;N&quot;;
			for(var i=4;i&lt;9;i++)
			{
				if((sRAFCode.charCodeAt(i)&lt;48 &amp;&amp; sRAFCode.charCodeAt(i)&gt;57))
				{
					sNum=&quot;N&quot;;
					break;
				}
				else
				{
					sNum=&quot;Y&quot;;
				}

		   }
			
			if(sRAFCodeLen&gt;=9 &amp;&amp; sRAF==&quot;RAF&quot; &amp;&amp; sRAFCode.charCodeAt(3)&gt;=65 &amp;&amp; sRAFCode.charCodeAt(3)&lt;=90 &amp;&amp; sNum==&quot;Y&quot;)
			{
				CanInvoke = &quot;TRUE&quot;;
			    return(CancelOperation);
			}	    
			
		}

    }// end if vasavi added for RAF Code
	
	//Neel 10/6/2014 - Added to Activate Button Change Address once
	//QAS WSDL integration is successful
	//Subramanian 12/8/14 Added to Enable button 
/* Maria - Commented script in precaninvoke method for fix IP18 - 27/03/2019	

if(MethodName == &quot;InvokeAddrValidation&quot; || MethodName == &quot;GetURL&quot;)
	{
		//SK 16.1.18 - R18.1 KOGAN - Added for getting lov value as Y if organization is Kogan. Button will be disabled for Kogan
		var sOrg = TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;); 
		var sOrgLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORG_CONFIGURATION&quot;,sOrg); 
				
		if ( MethodName == &quot;GetURL&quot; &amp;&amp; sOrgLOV == &quot;Y&quot;)
		{
			CanInvoke = &quot;FALSE&quot;;	
		}
		else
		{
			if(TheApplication().GetProfileAttr(&quot;TBUIPostChangeAdd&quot;) == &quot;Y&quot;)
			{			
				CanInvoke = &quot;TRUE&quot;;			
				//return(CancelOperation);		
			}
			if(TheApplication().GetProfileAttr(&quot;TBUIPostChangeAdd&quot;) == &quot;N&quot;)
			{
				CanInvoke = &quot;FALSE&quot;;			
				//return(CancelOperation);
			}
		}
	return(CancelOperation);		
	}*//*
	if(MethodName == &quot;GetURL&quot;) //Added to Activate Button Get Url once Address is updated
	{
		
		if(this.BusComp().GetFieldValue(&quot;Address Status Display&quot;) != &quot;&quot;)
		{
			CanInvoke = &quot;TRUE&quot;;
			return(CancelOperation);		
		}
	}
	
	return (ContinueOperation);*/
}"
			   SEQUENCE="2"
