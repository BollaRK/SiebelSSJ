				   VALUE="IIF(([&amp;BillingNotificationMethod] = &quot;TXT&quot; OR [&amp;BillingNotificationMethod] = &quot;Email and TXT&quot;) AND ([&amp;BillingNotificationMSISDN] &lt;&gt; &quot;61499999999&quot; AND  [&amp;BillingNotificationMSISDN] &lt;&gt; &quot;61499999&quot;), [&amp;BillingNotificationMSISDN],&quot;&quot;)"
				   UPDATED="03/23/2026 15:53:11"
