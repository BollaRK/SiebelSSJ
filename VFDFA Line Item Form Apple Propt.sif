			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
switch (MethodName)
	{
		
	case &quot;DeallocateNewMSISDN&quot;:
		
			
			
				if(this.BusComp().GetFieldValue(&quot;VF MSISDN TBUI&quot;) != &quot;&quot;)
				{
					CanInvoke = &quot;TRUE&quot;;
				    return(CancelOperation);
				}
				else
				{
				CanInvoke = &quot;FALSE&quot;;
				 return(CancelOperation);
				}
							
			break;
					
		case &quot;DeallocateSIM&quot;:
			
			if (this.BusComp().GetFieldValue(&quot;VF SIM TBUI&quot;) != &quot;&quot;)
			{
				CanInvoke = &quot;TRUE&quot;;
				return(CancelOperation);
			}
			else
				{
				CanInvoke = &quot;FALSE&quot;;
				 return(CancelOperation);
				}				
			break;
				
		case &quot;DeallocateIMEI&quot;:
			
			if (this.BusComp().GetFieldValue(&quot;VF IMEI TBUI&quot;) != &quot;&quot;)
			{
				CanInvoke = &quot;TRUE&quot;;
				return(CancelOperation);
			}
			else
				{
				CanInvoke = &quot;FALSE&quot;;
				 return(CancelOperation);
				}				
			break;

		case &quot;ReserveStoreStock&quot;:
			
			if ((this.BusComp().GetFieldValue(&quot;VF IMEI TBUI&quot;) != &quot;&quot; || this.BusComp().GetFieldValue(&quot;VF Device TBUI&quot;) != &quot;&quot;) &amp;&amp; this.BusComp().GetFieldValue(&quot;VF Stock Indicator TBUI&quot;) == &quot;In Stock&quot;)
			{
				CanInvoke = &quot;TRUE&quot;;
				return(CancelOperation);
			}
			else
				{
				CanInvoke = &quot;FALSE&quot;;
				 return(CancelOperation);
				}			
			break;
		case &quot;eSIMAllocate&quot;:    //Added by Sachi for R19.1 Atom Phase 2
			this.BusComp().ActivateField(&quot;VF Root Siebel Product Type&quot;);
			this.BusComp().ActivateField(&quot;Shipping&quot;);
			this.BusComp().ActivateField(&quot;VF SIM TBUI&quot;);
			this.BusComp().ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			var sSiebelProdType = this.BusComp().GetFieldValue(&quot;VF Root Siebel Product Type&quot;);
			var sSIMType = this.BusComp().GetFieldValue(&quot;Shipping&quot;);
			var sSIM = this.BusComp().GetFieldValue(&quot;VF SIM TBUI&quot;);
			var sStockIndi = this.BusComp().GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
			var sVoiceProp = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Voice&quot;);
			var sMBBProp = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;MBB&quot;);
			var sEsim= TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SIM_TYPE&quot;,&quot;eSIM&quot;);
			var sStockIndiLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
			
			if(sSIMType == sEsim &amp;&amp; (sSiebelProdType == sVoiceProp || sSiebelProdType == sMBBProp) &amp;&amp; (sSIM == &quot;&quot; || sSIM == null) &amp;&amp; (sStockIndi != sStockIndiLOV))
			{
				CanInvoke = &quot;TRUE&quot;;
				return(CancelOperation);
			}
			else
			{
				CanInvoke = &quot;FALSE&quot;;
				return(CancelOperation);
			}
			break;	
		

		default:
			break;
	}
	return (ContinueOperation);
}
"
			   SEQUENCE="3"
			   UPDATED="03/06/2026 22:17:19"
			   UPDATED_BY="SWATANTRAS"
			   CREATED="01/09/2026 16:01:51"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
try {
	var retval;
	var QuoteId = &quot;&quot;;
	var inputPropSet = null;
	var outputPropSet = null;
	var taskUIsvc = null;
	switch (MethodName)
	{
		case &quot;VFDeleteRecord&quot;: //subramanian: added to cancel the order
			var strordertype = this.BusComp().ParentBusComp().GetFieldValue(&quot;VF Order Type TBUI&quot;);
			if(strordertype == &quot;Pre to Post transfer&quot;)//Added for Pre to Post scenario
			{
				this.BusComp().DeleteRecord();
			}
			else
			{
				this.BusComp().WriteRecord();
				mCancelServiceOrder(MethodName);
				TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod (&quot;RefreshCurrentApplet&quot;, TheApplication(). NewPropertySet(),TheApplication().NewPropertySet());	
			}
			retval = CancelOperation;
			break;
		case &quot;AddToPromotion&quot;: // Nikhil Joshi: 19.05.2014: Added for Promotion Bundling
			if(this.BusComp().NextSelected())
				TheApplication().RaiseErrorText(&quot;Please Select only One Service Order at a time to add into a Promotion.&quot;);
			this.BusComp().ActivateField(&quot;Billing Account Id&quot;);
			TheApplication().SetProfileAttr(&quot;VFPromotionBillingAccount&quot;, this.BusComp().GetFieldValue(&quot;Billing Account Id&quot;));
			TheApplication().SetProfileAttr(&quot;VFAddToPromotionFromUI&quot;, &quot;Y&quot;);
			break;
		case &quot;GotoCart&quot;:
		     var valswitchin=TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_SSJ_PROP_EDITCART&quot;,&quot;EDITCART&quot;);
			    if(valswitchin == &quot;Y&quot;)
				  {
				  this.BusComp().ParentBusComp().ActivateField(&quot;Parent Order Id&quot;);
		        QuoteId=this.BusComp().ParentBusComp().GetFieldValue(&quot;Parent Order Id&quot;);
					if(QuoteId == &quot;&quot; || QuoteId == null)
						QuoteId = TheApplication().GetProfileAttr(&quot;QuoteId&quot;);

                TheApplication().SetProfileAttr(&quot;FromResumeQuote&quot;,&quot;Y&quot;);
				TheApplication().SetProfileAttr(&quot;SSJParentOrderId&quot;,QuoteId);
				TheApplication().SetProfileAttr(&quot;FromProdConfig&quot;,QuoteId);
				TheApplication().SetProfileAttr(&quot;EditinCart&quot;,&quot;Y&quot;);
				TheApplication().SetProfileAttr(&quot;BackToCartSSJ&quot;,&quot;Y&quot;);
				taskUIsvc = TheApplication().GetService(&quot;Shopping Service&quot;);
				inputPropSet = TheApplication().NewPropertySet();
				outputPropSet = TheApplication().NewPropertySet();
				inputPropSet.SetProperty(&quot;View&quot;, &quot;VHA Sales Calculator SSJ View&quot;);
				inputPropSet.SetProperty(&quot;Business Component&quot;, &quot;Order Entry - Orders&quot;);
				inputPropSet.SetProperty(&quot;Row Id&quot;, QuoteId);
				taskUIsvc.InvokeMethod(&quot;GotoView&quot;, inputPropSet, outputPropSet);
				return (CancelOperation);
				  }
				break;
		case &quot;eSIMAllocate&quot;:
			//Added for tree project
			this.BusComp().ActivateField(&quot;EID&quot;);
			this.BusComp().ActivateField(&quot;eSIM Download&quot;);
			var sEID = this.BusComp().GetFieldValue(&quot;EID&quot;);
			var seSIM = this.BusComp().GetFieldValue(&quot;eSIM Download&quot;);
			var sIMEI = this.BusComp().GetFieldValue(&quot;VF IMEI TBUI&quot;);
			var sType = this.BusComp().GetFieldValue(&quot;Shipping&quot;);
			var sConType = this.BusComp().GetFieldValue(&quot;VF ConnectionType&quot;);
			if( (seSIM == null || seSIM == &quot;&quot;) &amp;&amp; ( sEID == null || sEID == &quot;&quot;))
			{
				TheApplication().RaiseErrorText(&quot;eSIM Download and EID are mandatory. Please enter eSIM Download and EID to proceed further with eSIM allocation&quot;);
			}
			else if( seSIM == null || seSIM == &quot;&quot;)
			{
				TheApplication().RaiseErrorText(&quot;eSIM Download is mandatory. Please enter eSIM Download to proceed further with eSIM allocation&quot;);
			}
			else if((sEID == null || sEID == &quot;&quot;)&amp;&amp; seSIM == &quot;Push&quot; )
			{
				if((sIMEI == &quot;&quot; || sIMEI == null) &amp;&amp; sConType == &quot;Plan and Device&quot;)
				{
					TheApplication().RaiseErrorText(&quot;An IMEI is required. Please enter a value for this field.&quot;)
				}
				else
				{
					TheApplication().RaiseErrorText(&quot;EID is mandatory. Please enter EID to proceed further with eSIM allocation&quot;);
				}
			}
			//Added for tree project
				
			//Added by Sachi for R19.1 Atom Phase 2
			   
			this.BusComp().ParentBusComp().ActivateField(&quot;VHA Confirmation Code&quot;);
			//var sConfirmationCode = this.BusComp().ParentBusComp().GetFieldValue(&quot;VHA Confirmation Code&quot;);
			var sConfirmationCode = mGetConfirmationCode();
				
			if((sConfirmationCode == &quot;&quot; || sConfirmationCode == null) &amp;&amp; (sEID == null || sEID == &quot;&quot;) &amp;&amp; seSIM == &quot;QR Code&quot;)
			{
				/*var sCCode = Clib.rand();
				var len = &quot;&quot;;
				sCCode = sCCode.toString();
				if (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CONFIRM_CODE&quot;,&quot;LastFour&quot;) == &quot;Y&quot;)
				{
					len = sCCode.length;
					 sCCode = sCCode.substring(len-4,len);
				}
				else
				{
				 	sCCode = sCCode.substring(0,4);             
				}*/ //VHA 19.3/PKE/NIRMAL/20JUN2019/Commeneted above logic and added below block for PKE000000076341
				var svc = TheApplication().GetService(&quot;VHA ATOM eSIM Processing Service&quot;);
				var input = TheApplication().NewPropertySet();
				var output = TheApplication().NewPropertySet();
				input.SetProperty(&quot;Seed&quot;, this.BusComp().GetFieldValue(&quot;Id&quot;));
				svc.InvokeMethod(&quot;GenerateRandomCode&quot;, input, output);
				var sCCode = output.GetProperty(&quot;Code&quot;);
				
				this.BusComp().ParentBusComp().SetFieldValue(&quot;VHA Confirmation Code&quot;, sCCode);
				this.BusComp().ParentBusComp().WriteRecord();
			}
			try
			{
				var psInputs,psOutputs,bsInvokeWorkflow;
	            psInputs = TheApplication().NewPropertySet();
				psOutputs = TheApplication().NewPropertySet();
				this.BusComp().WriteRecord();
				sConfirmationCode = mGetConfirmationCode(); // Sachi - 14/02/2019 - R19.1 added for SIT defect 324
				this.BusComp().ActivateField(&quot;VF MSISDN TBUI&quot;);
				this.BusComp().ParentBusComp().ActivateField(&quot;VHA Confirmation Code&quot;);
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
				psInputs.SetProperty(&quot;Object Id&quot;, this.BusComp().GetFieldValue(&quot;Id&quot;));
				psInputs.SetProperty(&quot;RequestId&quot;, this.BusComp().GetFieldValue(&quot;Id&quot;));
				psInputs.SetProperty(&quot;Order Id&quot;, this.BusComp().GetFieldValue(&quot;Order Header Id&quot;));
				psInputs.SetProperty(&quot;OrderSubType&quot;, this.BusComp().GetFieldValue(&quot;VF Order Sub Type TBUI&quot;));
				psInputs.SetProperty(&quot;Confirmation Code&quot;,sConfirmationCode);
				psInputs.SetProperty(&quot;MSISDN&quot;,this.BusComp().GetFieldValue(&quot;VF MSISDN TBUI&quot;));
				psInputs.SetProperty(&quot;EID&quot;,this.BusComp().GetFieldValue(&quot;EID&quot;));
				//this.BusComp().ParentBusComp().GetFieldValue(&quot;VHA Confirmation Code&quot;));
				psInputs.SetProperty(&quot;Action Code&quot;, &quot;Allocate&quot;);
				bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				//refreshScreen();
				bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);				
				//this.BusComp().WriteRecord();
				//this.BusComp().ExecuteQuery(ForwardOnly);
				
				//NROY: 15-JUl-2022 Added for Project Tree
                if(psOutputs.GetProperty(&quot;Error Message&quot;) == &quot;&quot;)
				{
					var sActView = TheApplication().ActiveViewName();
					if(sIMEI != null &amp;&amp; sIMEI != &quot;&quot; &amp;&amp; sEID != null &amp;&amp; sEID != &quot;&quot; &amp;&amp; sActView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; &amp;&amp; sConType == &quot;Plan and Device&quot;)
					{
						var oBO = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
						var oBC = oBO.GetBusComp(&quot;VF IMEI List&quot;);
						with(oBC)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;IMEI&quot;);			
							ActivateField(&quot;EID&quot;);
							SetSearchSpec(&quot;IMEI&quot;, sIMEI);
							ExecuteQuery(ForwardOnly);
							var isRec = FirstRecord();
							if(isRec)
							{
								if(GetFieldValue(&quot;EID&quot;) == null || GetFieldValue(&quot;EID&quot;) == &quot;&quot;)
								{
									SetFieldValue(&quot;EID&quot;,sEID);
									WriteRecord();
								}
							}
						}
					}
				}
				
				retval = CancelOperation;			
			}
			
			catch(e)
			{
				var sErrorMsg = psOutputs.GetProperty(&quot;Error Message&quot;);
                if(sErrorMsg != &quot;&quot;)
                {
                    var sErrMsg = mTrimErrorMessage(sErrorMsg);
                    TheApplication().RaiseErrorText (sErrMsg);
                } 				
			}
			finally
			{
				TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod (&quot;RefreshCurrentApplet&quot;, TheApplication(). NewPropertySet(),TheApplication().NewPropertySet());	
			}
			//retval = CancelOperation;
			
			break;
		case &quot;DeallocateSIM&quot;:
			retval = ContinueOperation;
			this.BusComp().ActivateField(&quot;Shipping&quot;);
			this.BusComp().ActivateField(&quot;Root Order Item Id&quot;);
			this.BusComp().ActivateField(&quot;Order Sub Type&quot;);
			this.BusComp().ActivateField(&quot;EID&quot;);
			//this.BusComp().ParentBusComp().ActivateField(&quot;VHA Confirmation Code&quot;);
			var sSIMType = this.BusComp().GetFieldValue(&quot;Shipping&quot;);
			var eSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
			var sEID = this.BusComp().GetFieldValue(&quot;EID&quot;);
			if(sSIMType == eSIMType)//VHA Muthushankari - 5/12/2018 - Added for R19.1 ATOM Phase2
			{
				var psInputs,psOutputs,bsInvokeWorkflow;
		        psInputs = TheApplication().NewPropertySet();
				psOutputs = TheApplication().NewPropertySet();
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
				psInputs.SetProperty(&quot;SuppressError&quot;,&quot;N&quot;);
				psInputs.SetProperty(&quot;RequestId&quot;, this.BusComp().GetFieldValue(&quot;Root Order Item Id&quot;));
				psInputs.SetProperty(&quot;Action Code&quot;, &quot;Deallocate&quot;);
				psInputs.SetProperty(&quot;OrderSubType&quot;, this.BusComp().GetFieldValue(&quot;Order Sub Type&quot;));
				//Added below TREE phase 2
				psInputs.SetProperty(&quot;EID&quot;, sEID);
				
				//psInputs.SetProperty(&quot;Confirmation Code&quot;, this.BusComp().ParentBusComp().GetFieldValue(&quot;VHA Confirmation Code&quot;));
				try
				{
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				}
				catch(e)
				{
					var sErrorMsg = psOutputs.GetProperty(&quot;Error Message&quot;);
	                if(sErrorMsg != &quot;&quot;)
	                {
	                    var sErrMsg = mTrimErrorMessage(sErrorMsg);
	                    TheApplication().RaiseErrorText (sErrMsg);
	                }		
				}
				finally
				{
					var psInputs,psOutputs,bsInvokeBS;
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;OrderLineItemId&quot;, this.BusComp().GetFieldValue(&quot;Id&quot;));
					bsInvokeBS = TheApplication().GetService(&quot;VF Postpay Utilities TBUI&quot;);
					bsInvokeBS.InvokeMethod(&quot;NullifySIM&quot;, psInputs, psOutputs);
					TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod (&quot;RefreshCurrentApplet&quot;, TheApplication(). NewPropertySet(),TheApplication().NewPropertySet());	
				}
				retval = CancelOperation;
			}		
			break;
		/*case &quot;ReconfigureCxProd&quot;:
			this.BusComp().ActivateField(&quot;VF Configuration Status&quot;);
			this.BusComp().SetFieldValue(&quot;VF Configuration Status&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CONFIG_STATUS&quot;, &quot;Customized&quot;));
			this.BusComp().WriteRecord();
			break;*/
			case &quot;DeallocateIMEI&quot;:
				var bc = this.BusComp();
				bc.ActivateField(&quot;VF SIM TBUI&quot;);
				bc.ActivateField(&quot;Shpping&quot;);
				bc.ActivateField(&quot;eSIM Download&quot;);
				if(bc.GetFieldValue(&quot;Shipping&quot;) == &quot;eSIM&quot; &amp;&amp; bc.GetFieldValue(&quot;eSIM Download&quot;) == &quot;Push&quot; &amp;&amp; (bc.GetFieldValue(&quot;VF SIM TBUI&quot;) != &quot;&quot; &amp;&amp; bc.GetFieldValue(&quot;VF SIM TBUI&quot;) != null))
				{ 
					TheApplication().RaiseErrorText(&quot;Please De-Allocate SIM first and then proceed with IMEI De-Allocation&quot;);	
				}
				break;
			
	case &quot;Accessories&quot;:
    try {
        var app = TheApplication();
        var bo  = app.GetBusObject(&quot;Order Entry (Sales)&quot;);
		

        // Get Order Header Id from the current applet record
        var parentOrderId = this.BusComp().GetFieldValue(&quot;Order Header Id&quot;);
		
		var accBC = bo.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);
        
        // --- To check if accessories and werables were already inserted for resume task scenario to avid duplicate inserts 
        accBC.SetViewMode(AllView);
        accBC.ClearToQuery();
        accBC.SetSearchSpec(&quot;Order Id&quot;, parentOrderId);
        accBC.ExecuteQuery(ForwardOnly);
        
        // If records already exist for this order, STOP processing
        if (accBC.FirstRecord()) {
            // app.SetStatusText(&quot;Accessories already processed for this order.&quot;);
            return (CancelOperation); 
        }
		// --- Deduplication logic END ---
        if (parentOrderId == null || parentOrderId == &quot;&quot;) {
            app.RaiseErrorText(&quot;Order Header Id is required on the current record.&quot;);
        }

        // BCs
        var rootBC = bo.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;); // root discovery
        var oliBC  = bo.GetBusComp(&quot;VF Order Line Item - Light&quot;);          // OLI queries
        var xaBC   = bo.GetBusComp(&quot;Order Item XA&quot;);                       // attributes
        var accBC  = bo.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);             // target BC

        var processed = 0;

        // Find all ROOT OLIs for this Order Id
        with (rootBC) {
            SetViewMode(AllView);
            ClearToQuery();
            ActivateField(&quot;Id&quot;);
            ActivateField(&quot;Order Id&quot;);
            ActivateField(&quot;Parent Order Item Id&quot;);
            SetSearchExpr(&quot;[Order Id] = &apos;&quot; + parentOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;);
            ExecuteQuery(ForwardOnly);

            var recRoot = FirstRecord();
            while (recRoot) {
                var parentOliId = GetFieldValue(&quot;Id&quot;);

                // -------------------------------------------------------------------
                // 0) Device Care Wearables check (any occurrence under this root OLI)
                // -------------------------------------------------------------------
                var deviceCareFound = false;
                with (oliBC) {
                    SetViewMode(AllView);
                    ClearToQuery();
                    ActivateField(&quot;Id&quot;);
                    ActivateField(&quot;Root Order Item Id&quot;);
                    ActivateField(&quot;Product&quot;);
                    SetSearchSpec(&quot;Root Order Item Id&quot;, parentOliId);
                    SetSearchSpec(&quot;Product&quot;, &quot;Vodafone Device Care Wearables&quot;);
                    ExecuteQuery(ForwardOnly);
                    if (FirstRecord()) {
                        deviceCareFound = true;
                    }
                }

                // -------------------------------------------------------------------
                // 1) Collect ALL Accessory/Wearable items under the same root OLI
                // -------------------------------------------------------------------
                var wearList = new Array(); // {RelatedSOId, Name, Code, RRP, Prepay, Term, Type}
                var accList  = new Array();

                with (oliBC) {
                    SetViewMode(AllView);
                    ClearToQuery();
                    ActivateField(&quot;Id&quot;);
                    ActivateField(&quot;Root Order Item Id&quot;);
                    ActivateField(&quot;Product Type&quot;);
                    ActivateField(&quot;Product&quot;);
                    SetSearchSpec(&quot;Root Order Item Id&quot;, parentOliId);
                    SetSearchSpec(&quot;Product Type&quot;, &quot;Accessory&quot;);
                    ExecuteQuery(ForwardOnly);

                    var recA = FirstRecord();
                    while (recA) {
                        var accOliId = GetFieldValue(&quot;Id&quot;);
                        var prodLbl  = GetFieldValue(&quot;Product&quot;); // fallback for name/code

                        var pName = &quot;&quot;, pCode = &quot;&quot;, pRRP = &quot;&quot;, pPre = &quot;&quot;, pTerm = &quot;&quot;, pCat = &quot;&quot;;

                        // Read attribute XAs
                        with (xaBC) {
                            SetViewMode(AllView);
                            ClearToQuery();
                            ActivateField(&quot;Name&quot;);
                            ActivateField(&quot;Value&quot;);
                            ActivateField(&quot;Text Value&quot;);
                            ActivateField(&quot;Object Id&quot;);
                            try { 
                                ActivateField(&quot;Created&quot;); 
                                SetSortSpec(&quot;Created(ASC)&quot;); 
                            } catch (ex) {}
                            SetSearchSpec(&quot;Object Id&quot;, accOliId);
                            ExecuteQuery(ForwardOnly);

                            var xa = FirstRecord();
                            while (xa) {
                                var n = GetFieldValue(&quot;Name&quot;);
                                var v = GetFieldValue(&quot;Value&quot;);
                                if (v == null || v == &quot;&quot;) v = GetFieldValue(&quot;Text Value&quot;);

                                if (n == &quot;Accessory Name&quot;)             { pName = v; }
                                else if (n == &quot;Accessory Code&quot;)        { pCode = v; }
                                else if (n == &quot;Accessory RRP Inc GST&quot;) { pRRP = v; }
                                else if (n == &quot;Prepayment Amount&quot;)     { pPre = v; }
                                else if (n == &quot;Term&quot;)                  { pTerm = v; }
                                else if (n == &quot;Category&quot;)              { pCat  = v; }

                                xa = NextRecord();
                            }
                        }

                        // Fallbacks
                        if (pName == null || pName == &quot;&quot;) pName = prodLbl;
                        if (pCode == null || pCode == &quot;&quot;) pCode = pName;

                        // Build item if we have a valid name/code
                        if (pName != &quot;&quot; &amp;&amp; pCode != &quot;&quot;) {
                            var item = new Object();
                            item.RelatedSOId = parentOliId;
                            item.Name   = pName;
                            item.Code   = pCode;
                            item.RRP    = pRRP;
                            item.Prepay = pPre;
                            item.Term   = pTerm;
                            item.Type   = (pCat == &quot;Secondary Device&quot;) ? &quot;Wearable&quot; : &quot;Accessory&quot;;

                            if (item.Type == &quot;Wearable&quot;) {
                                wearList[wearList.length] = item;
                            } else {
                                accList[accList.length] = item;
                            }
                        }

                        recA = NextRecord();
                    }
                }

                // -------------------------------------------------------------------
                // 2) Optional: GLOBAL Term from APP OLIs (Billing - APP)
                // -------------------------------------------------------------------
                var termGlobal = &quot;&quot;;
                with (oliBC) {
                    SetViewMode(AllView);
                    ClearToQuery();
                    ActivateField(&quot;Id&quot;);
                    ActivateField(&quot;Root Order Item Id&quot;);
                    ActivateField(&quot;Product Type&quot;);
                    SetSearchSpec(&quot;Root Order Item Id&quot;, parentOliId);
                    SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - APP&quot;);
                    ExecuteQuery(ForwardOnly);

                    var rec = FirstRecord();
                    while (rec) {
                        var appOliId = GetFieldValue(&quot;Id&quot;);

                        with (xaBC) {
                            SetViewMode(AllView);
                            ClearToQuery();
                            ActivateField(&quot;Name&quot;);
                            ActivateField(&quot;Value&quot;);
                            ActivateField(&quot;Text Value&quot;);
                            ActivateField(&quot;Object Id&quot;);
                            SetSearchSpec(&quot;Object Id&quot;, appOliId);
                            ExecuteQuery(ForwardOnly);

                            var xa2 = FirstRecord();
                            while (xa2) {
                                var n2 = GetFieldValue(&quot;Name&quot;);
                                var v2 = GetFieldValue(&quot;Value&quot;);
                                if (v2 == null || v2 == &quot;&quot;) v2 = GetFieldValue(&quot;Text Value&quot;);
                                if (n2 == &quot;Term&quot; &amp;&amp; termGlobal == &quot;&quot;) termGlobal = v2;
                                xa2 = NextRecord();
                            }
                        }

                        rec = NextRecord();
                    }
                }

                // -------------------------------------------------------------------
                // 3) INSERT ALL collected Wearables and Accessories (NO DEDUP CHECK)
                // -------------------------------------------------------------------

                // Wearables
                for (var i = 0; i &lt; wearList.length; i++) {
                    var w = wearList[i];
                    var wTerm = (termGlobal != &quot;&quot;) ? termGlobal : (w.Term || &quot;&quot;);

                    with (accBC) {
                        SetViewMode(AllView);
                        // Direct insert, no existence check
                        NewRecord(NewAfter);
                        SetFieldValue(&quot;Related Service Order Id&quot;, w.RelatedSOId);
                        SetFieldValue(&quot;Accessory Name&quot;, w.Name);
                        SetFieldValue(&quot;Accessory Code&quot;, w.Code);
                        SetFieldValue(&quot;Order Id&quot;, parentOrderId);
                        SetFieldValue(&quot;Type&quot;, &quot;Wearable&quot;);
                        if (w.RRP    != &quot;&quot;) SetFieldValue(&quot;VHA RRP inc GST&quot;, w.RRP);
                        if (w.Prepay != &quot;&quot;) SetFieldValue(&quot;VHA Accessory Prepayment Amount&quot;, w.Prepay);
                        if (wTerm    != &quot;&quot;) SetFieldValue(&quot;Contract Term&quot;, wTerm);
                        if (deviceCareFound) SetFieldValue(&quot;VHA EIN&quot;, &quot;Added&quot;);
                        WriteRecord();
                    }
                }

                // Accessories
                for (var j = 0; j &lt; accList.length; j++) {
                    var a = accList[j];
                    var aTerm = (termGlobal != &quot;&quot;) ? termGlobal : (a.Term || &quot;&quot;);

                    with (accBC) {
                        SetViewMode(AllView);
                        // Direct insert, no existence check
                        NewRecord(NewAfter);
                        SetFieldValue(&quot;Related Service Order Id&quot;, a.RelatedSOId);
                        SetFieldValue(&quot;Accessory Name&quot;, a.Name);
                        SetFieldValue(&quot;Accessory Code&quot;, a.Code);
                        SetFieldValue(&quot;Order Id&quot;, parentOrderId);
                        SetFieldValue(&quot;Type&quot;, &quot;Accessory&quot;);
                        if (a.RRP    != &quot;&quot;) SetFieldValue(&quot;VHA RRP inc GST&quot;, a.RRP);
                        if (a.Prepay != &quot;&quot;) SetFieldValue(&quot;VHA Accessory Prepayment Amount&quot;, a.Prepay);
                        if (aTerm    != &quot;&quot;) SetFieldValue(&quot;Contract Term&quot;, aTerm);
                        // if (deviceCareFound) SetFieldValue(&quot;VHA EIN&quot;, &quot;Added&quot;);
                        WriteRecord();
                    }
                }

                processed++;
                recRoot = NextRecord();
            }
        }

        try { 
            app.SetStatusText(&quot;Processed &quot; + processed + &quot; root line item(s) for this order.&quot;); 
        } catch (stx) {}

        retval = CancelOperation;
    } catch (e) {
        throw e;
    }
    break;

		default :
			retval = ContinueOperation;
		break;
	}
	return (retval);
	}

	catch (e)
	{
	throw e;
	}
	finally
	{
	if(defined(bsInvokeWorkflow)) { bsInvokeWorkflow = null; } // This variable is nullified by BALAMURUGAN on 15/10/2019
	}
}"
