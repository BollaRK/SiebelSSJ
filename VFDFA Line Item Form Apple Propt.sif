			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetConfirmationCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetConfirmationCode()
{
 try
 	{
     	var boOrder = TheApplication().GetBusObject(&quot;VHA Sharing Thin BO&quot;);
 		var bcOrder = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items&quot;);
		var sOrderItemId = this.BusComp().GetFieldValue(&quot;Id&quot;);
		var sConfirmationCode = &quot;&quot;;
		with(bcOrder)
		{
			ActivateField(&quot;Confirmation Code&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderItemId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sConfirmationCode = GetFieldValue(&quot;Confirmation Code&quot;);
			}
		}
		return(sConfirmationCode);
 	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e);
		}
		TheApplication().RaiseErrorText(strError);
	}
 	finally
 	{
		bcOrder = null;
		boOrder = null;
 	}
}"
