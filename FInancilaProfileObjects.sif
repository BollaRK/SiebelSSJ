			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidatePhoneNumber"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="
function mValidatePhoneNumber(strNumber,strFieldName)
{
	/*
	 * Component Name        : 	mValidateContactDetail
	 * Method Name           : 	
	 * Component Information : 	This function validates all fields entered
	 *							correct 
	 *
	 * Modification History  :
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 10/06/2014	Neel					Validating Phone Number
	 */
	try
	{
            // Check there are no spaces
			if (strNumber.indexOf(&quot; &quot;) &gt; 0)
			{
				throw (strFieldName + &quot; must be entered with no spaces.&quot;);
			}

			// Check there are no brackets
			if ((strNumber.indexOf(&quot;(&quot;) &gt; 0) || (strNumber.indexOf(&quot;)&quot;) &gt; 0))
			{
				throw (strFieldName + &quot; must be entered with no brackets.&quot;);
			}

			// Check the total length is less than 20
			if (strNumber.length &gt; 20 || strNumber.length &lt; 10)
			{
				throw (strFieldName + &quot; must be less than 20 characters long and greater than 10 characters&quot;);
			}
			
			// Check phone number is numeric
			if (isNaN(strNumber))
			{
				throw (strFieldName + &quot; must be numeric&quot;);
			}
			
			
			//Now validate to see if it&apos;s correct
			if (strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;Home Phone&quot;)
           	{	                      
	           if( strNumber.indexOf(&quot;612&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;613&quot;) != 0 &amp;&amp;   strNumber.indexOf(&quot;614&quot;) != 0  &amp;&amp; strNumber.indexOf(&quot;617&quot;) != 0 &amp;&amp;
	                                               strNumber.indexOf(&quot;618&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;04&quot;) != 0)
	           { 
	           		throw(strFieldName + &quot; must be starting with digits 04, 612, 613, 614, 617 or 618 for Home phone number&quot;);
	           }
                         
           	}//end of if (strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;HomePhone&quot;)
           	else if(strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;Work Phone&quot;)
           	{
           		if( strNumber.indexOf(&quot;612&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;613&quot;) != 0 &amp;&amp;   strNumber.indexOf(&quot;614&quot;) != 0  &amp;&amp;  strNumber.indexOf(&quot;617&quot;) != 0 &amp;&amp;
	                                                strNumber.indexOf(&quot;618&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;6118&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;6113&quot;) != 0 &amp;&amp;
	                                                strNumber.indexOf(&quot;1800&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;13&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;04&quot;) != 0)
				{ 
					throw(strFieldName + &quot; must be starting with digits 1800, 13, 04, 612, 613, 614, 617, 618 , 6118 or 6113 for Work phone&quot;);
				}
          	}
    }
	catch(e)
    {
     	throw(e);
    }
}"
			   SEQUENCE="27"
