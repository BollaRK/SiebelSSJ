			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRemoveDealerCodeonWithdraw"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 13/07/2010	HR		CA PCR08 Remove Dealer Code and Dealer&apos;s Description on Withdrawal.
*/

function mRemoveDealerCodeonWithdraw()
{

				try 
				{ 
				//Set Admin Mode to True to avoid the read only user properties.
				this.InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
				TheApplication().SetProfileAttr(&quot;DealerNotReadOnlyProfAttr&quot;,&quot;Y&quot;);
				this.ClearToQuery();
				this.ExecuteQuery();

				// ADDED FOR CA PCR08 HR:13-07-2010
 	  			
 	  			this.ActivateField(&quot;Dealer Description&quot;);
 	  			this.ActivateField(&quot;Dealer Code&quot;);
 	  			this.SetFieldValue(&quot;Dealer Description&quot;, TheApplication().GetProfileAttr(&quot;sDealerBranch_Log&quot;));
 	  			this.SetFieldValue(&quot;Dealer Code&quot;, TheApplication().GetProfileAttr(&quot;sDealerCode_Log&quot;));
 	  			this.WriteRecord();
 	  			TheApplication().SetProfileAttr(&quot;DealerNotReadOnlyProfAttr&quot;,&quot;N&quot;);
 	  			//Reset Admin Mode
				this.InvokeMethod(&quot;SetAdminMode&quot;, &quot;FALSE&quot;);
				this.ClearToQuery();
				this.ExecuteQuery();
				} 
				catch(e) 
				{ 
				TheApplication().RaiseErrorText(e); 
				}
				finally 
				{
				// Do Nothing
				}
	  			
}"
