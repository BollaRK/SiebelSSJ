			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="trim"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function trim(source)
{
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 20/09/2010	RKishore TD:12748     Remove the leading and trailing spaces in a string
*/
while(source.charAt(0) == &quot; &quot;)
{
source = source.substring(1);
}
return(source);

}"
