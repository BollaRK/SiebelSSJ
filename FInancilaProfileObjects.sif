			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckHardCaps"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Added by Sachi - 20/Aug/2018 - To throw error if the credit class belongs to Credit Cap Class
function mCheckHardCaps(sCreditClass,sCCModDate)
{
	try
	{
		var inps = TheApplication().NewPropertySet();
		var outps = TheApplication().NewPropertySet();
		var bsHCPrcoessService = TheApplication().GetService(&quot;VHA Hard Caps Procesing Service&quot;);
		inps.SetProperty(&quot;CreditClass&quot;,sCreditClass);
		inps.SetProperty(&quot;CreditChkDate&quot;,sCCModDate);
		bsHCPrcoessService.InvokeMethod(&quot;CreditCheckValidation_UI&quot;,inps,outps);
		sHCFormattedDate = outps.GetProperty(&quot;FormattedDateMod&quot;);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		inps = null;
		outps = null;
		bsHCPrcoessService = null;    /* This variable is nullified by Sharukh on 05/04/2019*/

	}
}"
			   SEQUENCE="4"
			   UPDATED="05/09/2022 21:03:19"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:59:06"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mHardCapsValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Added by Sachi - 12/Sep/2018 - To throw error if the credit class belongs to Credit Cap Class
function mHardCapsValidation()
{
	try
	{
		this.BusComp().ActivateField(&quot;VF Credit Class&quot;);
		this.BusComp().ActivateField(&quot;Credit Update Date&quot;);
		var sCreditClass = this.BusComp().GetFieldValue(&quot;VF Credit Class&quot;);
		var sCCModDate = this.BusComp().GetFieldValue(&quot;Credit Update Date&quot;);
		var sCreditClassType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;,sCreditClass);
		
		if((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType) &amp;&amp; (sCCModDate != null &amp;&amp; sCCModDate != &quot;&quot;))
		{
			mCheckHardCaps(sCreditClass,sCCModDate);
		}
		if((sHCFormattedDate != &quot;&quot; &amp;&amp; sHCFormattedDate != null) &amp;&amp; (sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType))   // Sachi - 03/Sep/2018 Added for HardCaps
		{
			TheApplication().RaiseErrorText(&quot;Credit Check may not be submitted until &quot; + sHCFormattedDate + &quot; due to the customer being of credit class &quot; + sCreditClass);	
		}
		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		
	}
}"
