			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRefreshScreen"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	mRefreshScreen
 * Component Information : 	Refreshes the screen to reflect changes to data.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	======================================
 * 27/07/2005	RNZ						Initial Version
 * 19/06/2006	CY						Refresh the Financial Profile as well.
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function mRefreshScreen(sAccountId)
{
 	try
	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.mRefreshScreen:&quot;); 
		}
		
		// Declare variables
 		var boAccount;
 		var bcAccount;
 		var bcFinProf;

		var bcParent = this.ParentBusComp();
		var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);

		boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
		bcAccount = boAccount.GetBusComp(&quot;Account&quot;);

		with (bcAccount)
	 	{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery();
		}

	//	bcFinProf = boAccount.GetBusComp(&quot;Com Financial Profile&quot;);
	
		bcFinProf = boAccount.GetBusComp(&quot;VF Com Financial Profile&quot;);

		with (bcFinProf)
	 	{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Account Id&quot;, sAccountId);
			ExecuteQuery();
		}
	}
	
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		// Destroy Objects
		boAccount = null;
		bcAccount = null;
		bcFinProf = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.mRefreshScreen:&quot;);
		}
	}	
}"
