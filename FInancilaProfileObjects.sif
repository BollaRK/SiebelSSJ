			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetRequestedConnections"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetRequestedConnections(sFinProfId)
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 14/04/2010	DO		Sum the Quantity of each Intended Handset record and
 *						save the total to the Requested Connections field on
 *						the Financial Profile.
*/
{
	try 
	{ 	
		//Objects
		var boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
		var bcFinProf = boAccount.GetBusComp(&quot;VF Com Financial Profile&quot;);
		var bcIntendedHandset = boAccount.GetBusComp(&quot;VF Intended Handset&quot;);
		
		//Variables
		var bIntHandRecord = &quot;&quot;;
		var iQuantity = 0;
		var iQuantityTotal = 0;
		
		bcIntendedHandset.ActivateField(&quot;Quantity&quot;);
		
		with (bcFinProf)
		{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sFinProfId);
			ExecuteQuery();
		}
		
		if (!bcFinProf.FirstRecord())
		{
			throw &quot;Cannot find Financial Profile with Row Id: &quot; + sFinProfId;
		}
		
		bIntHandRecord = bcIntendedHandset.FirstRecord();
		while (bIntHandRecord)
		{
			iQuantity = bcIntendedHandset.GetFieldValue(&quot;Quantity&quot;);
			iQuantity = ToInteger(iQuantity);
			iQuantityTotal = iQuantityTotal + iQuantity;
			
			bIntHandRecord = bcIntendedHandset.NextRecord();
		}
		
		this.SetFieldValue(&quot;VF Requested Connections&quot;, iQuantityTotal);
		this.WriteRecord();
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		//Destroy objects
		bcIntendedHandset = null;
		bcFinProf = null;
		boAccount = null;
	}
}"
