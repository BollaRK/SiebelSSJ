			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDealerCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetDealerCode()
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 22/03/2010	DO		10.3 Credit Approval. Set predefault values for Deal Code
 *						Dealer Description and Sales Channel based off the 
 *						logged on user&apos;s profile.
 * 19/04/2010	DO		10.3 Credit Approval. Defect 39550. Removed references to
 *						Sales Channel because this is now set via the pick map on
 *						the Dealer Description field.
 * 17/6/2010    DFiggis R10.3 UAT#3028 - ReadOnly User property caused error for &quot;New Record&quot;.
                        Admin mode didn&apos;t work so required seperated field
*/
{
	try 
	{ 
		//Declare variables
		var sEmpId = this.GetFieldValue(&quot;VF User Login Id&quot;);
		var sDealer = &quot;&quot;;
		//var sSalesChannel = &quot;&quot;;

		//Declare objects
		var boEmployee = TheApplication().GetBusObject(&quot;Employee&quot;);
		var bcEmployee = boEmployee.GetBusComp(&quot;Employee&quot;);
		
		//Find the employee record associated to the user currently logged in.
		with (bcEmployee)
	 	{
			SetViewMode(AllView);
			ActivateField(&quot;VF Sales Branch Description&quot;); //Dealer Description
			ActivateField(&quot;VF Sales Channel Description&quot;); //Sales Channel
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sEmpId);
			ExecuteQuery();
		}
		
		if (bcEmployee.FirstRecord())
		{
		
			sDealer = bcEmployee.GetFieldValue(&quot;VF Sales Branch Description&quot;);
			
			if (sDealer != &quot;&quot; &amp;&amp; sDealer != null &amp;&amp; sDealer != &quot;undefined&quot;) //Saravanan : 15.2 Defect #48 : 05/05/2015
			{
				//sSalesChannel = bcEmployee.GetFieldValue(&quot;VF Sales Channel Description&quot;);
				
				//Get the picklist that sits on the Dealer Description field
				//DF 17/6/2010 - UAT#3028 - change field to bypass read only user property causing error on &quot;new&quot;.
				//var bcPickList = this.GetPicklistBusComp(&quot;Dealer Description&quot;);
				var bcPickList = this.GetPicklistBusComp(&quot;Dealer Description - Admin&quot;);			
				with (bcPickList)
				{
					ClearToQuery();
					SetSearchSpec(&quot;Description&quot;, &quot;&apos;&quot; + sDealer + &quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						//Pick the dealer description. This will also set the dealer code
						//using the pickmap on the Dealer Description field.
						Pick();
					}
				}
					//this.SetFieldValue(&quot;VF Channel&quot;, sSalesChannel);					
			}//if	
				
				//Destroy picklist object
				bcPickList = null;
	
				//Set the sales channel
		
		}
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		//Destroy objects
		bcEmployee = null;
		boEmployee = null;
	}
}"
