			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSysPref"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSysPref( strPrefName )
{
/*
 * Component Name        : VF Com Financial Profile
 * Method Name           : mGetSysPref
 * Component Information : This method get a system preference
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 03/10/2011	DFiggis R11D		Initial - Copied from BC &apos;Com Invoice Profile&apos;
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */


 try
 {
  	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Com Financial Profile.mGetSysPref&quot;);
	}
	
	var boSysPref;
	var bcSysPref;
	
	boSysPref = TheApplication().GetBusObject( &quot;System Preferences&quot;  );
	bcSysPref = boSysPref.GetBusComp( &quot;System Preferences&quot; );
	
	bcSysPref.ClearToQuery();
	bcSysPref.ActivateField( &quot;Value&quot; );
	bcSysPref.SetSearchSpec( &quot;Name&quot;, strPrefName );
	bcSysPref.ExecuteQuery( ForwardOnly );
	
	if ( bcSysPref.FirstRecord() )
		return( bcSysPref.GetFieldValue( &quot;Value&quot; ) );
	else
		return( &quot;&quot; );

 }
 catch( e )
 {
 	if (defined(e.errText))
	{
		var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
	}
	else
	{
		var strError = e.toString(); 
	}
   	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Com Financial Profile.mGetSysPref.Error:&quot; + strError );
	}
	throw( strError );
 }
 finally
 {
   	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:VF Com Financial Profile.mGetSysPref&quot;);
	}
	
	bcSysPref = null;
	boSysPref = null;
 } 
}"
			   SEQUENCE="8"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
