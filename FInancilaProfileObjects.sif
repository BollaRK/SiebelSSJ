			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCCValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCCValidation()
{
//Added by Veera - 20/O3/2019 - To throw error if expiry date based on Credit Check Matrix is not less than Today&apos;s date
	try
	{
		//var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
		var sCCId = this.GetFieldValue(&quot;Id&quot;);
		var sMExpDt = &quot;&quot;;
		var sExpDtTm = &quot;&quot;;
 		var sCredBO = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
 		var sCredBC = sCredBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
 		with(sCredBC)
 		{
	 		if (sCCId != null &amp;&amp; sCCId != &quot;&quot;)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);
				SetSearchSpec(&quot;Id&quot;, sCCId);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sMExpDt = GetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;); //Backend field
					sExpDtTm = GetFieldValue(&quot;VF Credit Check Expiry Date&quot;); //UI field       
				}
			}
		}
		if(this.GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVE&quot; || this.GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVED&quot;)
		{
			var dTdyDt = new Date();	
			//if (sMExpDt != null &amp;&amp; sMExpDt != &quot;&quot;)
			if (sExpDtTm != null &amp;&amp; sExpDtTm != &quot;&quot;)//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
			{		
				var sMExpDtComp = new Date(sExpDtTm);//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
				var myM = ToInteger(dTdyDt.getMonth()+1);
				var myD = ToInteger(dTdyDt.getDate());
				var myY = ToInteger(dTdyDt.getFullYear());
				var toM = ToInteger(sMExpDtComp.getMonth()+1);
				var toD = ToInteger(sMExpDtComp.getDate());
				var toY = ToInteger(sMExpDtComp.getFullYear());
				var sDispDate = toD + &quot;/&quot; + toM + &quot;/&quot; + toY;
				
				
				
				//if((sCreditClass != &quot;&quot;&amp;&amp;sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType) &amp;&amp; (sCCModDate != null &amp;&amp; sCCModDate != &quot;&quot;))
				if ((myY &lt; toY)||((myY==toY)&amp;&amp;(myM &lt; toM))||((myY==toY)&amp;&amp;(myM==toM)&amp;&amp;(myD &lt;= toD)))
				{
					if((sMExpDtComp != &quot;&quot; &amp;&amp; sMExpDtComp != null))  
					{
						TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_CC_9121&quot;, sDispDate));	
					}
				}
			}
		}
		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sCredBC = null;
		sCredBO = null;
	}
}"
			   SEQUENCE="6"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 18:21:31"
