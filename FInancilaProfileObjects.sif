			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetConsentText"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetConsentText(strOrgId)
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 29/04/2010	DF      Get the Consent Text to display on the applet
*/
{
	try 
	{ 	
		//Declare objects
		var boOrg = TheApplication().GetBusObject(&quot;Organizations&quot;);
		var bcOrg = boOrg.GetBusComp(&quot;Organization&quot;);
		
		//Declare variables
		var strConsentText = &quot;&quot;;
		
		with (bcOrg)
	 	{
			SetViewMode(AllView);
			ActivateField(&quot;VF Credit Check Consent&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, strOrgId);
			ExecuteQuery();
		}
		
		if (bcOrg.FirstRecord())
		{
			strConsentText = bcOrg.GetFieldValue(&quot;VF Credit Check Consent&quot;);
		}
			
		
		return strConsentText;
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{
		//Destroy objects
		bcOrg = null;
		boOrg = null;
	}
}"
