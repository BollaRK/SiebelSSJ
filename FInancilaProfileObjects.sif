			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{
var sCCStatus = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
TheApplication().SetSharedGlobal(&quot;VFCCStatus&quot;,sCCStatus);
/*this.ActivateField(&quot;VF OET User Responsibility&quot;);
var sOETResp = this.GetFieldValue(&quot;VF OET User Responsibility&quot;);
TheApplication().SetSharedGlobal(&quot;VFOETRESP&quot;,sOETResp);
this.ActivateField(&quot;VF NCC Customer Flag&quot;);
var sNCCFlag = this.GetFieldValue(&quot;VF NCC Customer Flag&quot;);
TheApplication().SetSharedGlobal(&quot;VFNCCFlag&quot;,sNCCFlag);*/
}"
			   SEQUENCE="29"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:47"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 22/03/2010	DO		10.3 Credit Approval. Set predefault values for Deal Code
 *						Dealer Description and Sales Channel based off the 
 *						logged on user&apos;s profile.
 * 19/9/19		Pallavi	R19.4 Reduce # field CIR &gt; to auto populate current address
*/
{
	try 
	{ 
		//set new record flag
		this.SetUserProperty(&quot;IsNewRecord&quot;,&quot;Y&quot;);
		
		//KRISHNAS:Added for SSJ Order Fulfil
		this.SetUserProperty(&quot;IsNew&quot;,&quot;Y&quot;);
		var RowId = this.GetFieldValue(&quot;Id&quot;);
		var ssjFlow = TheApplication().GetProfileAttr(&quot;SSJFlow&quot;);//VF KT 16/12/25: Added for Trading Address
		
		//CA PCR08 10.3.1
		TheApplication().SetProfileAttr(&quot;profFPDataAccess&quot;, &quot;Y&quot;);		
		
		//Added for R19.4 Reduce# fields CIR
		var viewname = TheApplication().ActiveViewName();
		if(viewname == &quot;VF Connection View - Credit Check&quot; || viewname == &quot;VF Com Account Financial Profile - Edit View&quot; || viewname == &quot;VF Com Account Financial Profile View&quot;)
		{
		var acntid =  this.GetFieldValue(&quot;Account Id&quot;);			
    	var oBCPick = this.GetPicklistBusComp(&quot;VF Current Address - AU&quot;);
    	
    	if(acntid != null &amp;&amp; acntid != &quot;&quot;)
    	{
	    	with(oBCPick)
		    {
		      ClearToQuery();
		      SetSearchSpec(&quot;Address Account Id&quot;,acntid);
		      ExecuteQuery(ForwardOnly);
		      if (FirstRecord())
		         Pick();
			 } 
		 }
		
		 }//Reduce# fields CIR ends

		 //VF KT 16/12/25: Trading Address Pick Start
		 if(ssjFlow==&quot;Y&quot;){
			var acntid1 =  this.GetFieldValue(&quot;Account Id&quot;);			
    		var oBCPick1 = this.GetPicklistBusComp(&quot;VF Trading Address&quot;);
	    	if(acntid1 != null &amp;&amp; acntid1 != &quot;&quot;)
	    	{
		    	with(oBCPick1)
			    {
			      ClearToQuery();
			      SetSearchSpec(&quot;Address Account Id&quot;,acntid1);
			      ExecuteQuery(ForwardOnly);
			      if (FirstRecord())
			         Pick();
				 } 
			 }

			var ipsInputs = TheApplication().NewPropertySet();
			var ipsOutputs  = TheApplication().NewPropertySet();
			var ibs = TheApplication().GetService(&quot;VHA SSJ Cart Device BS&quot;);
			
			ipsInputs.SetProperty(&quot;FinProfileId&quot;, RowId);	
			ibs.InvokeMethod(&quot;GetDeviceItems&quot;, ipsInputs, ipsOutputs);
			
		//	var AccntId = TheApplication().SetProfileAttr(&quot;Account Id&quot;,this.GetFieldValue(&quot;Account Id&quot;));
	
		 }//VF KT 16/12/25: Trading Address Pick Ends

			
					
			
		
		//VF DO 22/3/10 - 10.3 Credit Approval. Call function to set the
		//predefault dealer values.		
		mSetDealerCode();				

	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
	oBCPick = null;
	ssjFlow= null;//VF KT 16/12/25: Added for Trading Address
	ipsInputs = null;
	ipsOutputs = null;
	ibs = null;
	}
}"
			   SEQUENCE="30"
			   UPDATED="05/04/2026 16:54:08"
			   UPDATED_BY="KRISHNAS"
			   CREATED="03/28/2014 21:45:47"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	BusComp_PreInvokeMethod
 * Component Information : 	Validation around credit checking.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 26/03/2019   Christy     Changed the ApplicationName profile attribute to VHA User Type for Unified Application
 */
function BusComp_PreInvokeMethod (MethodName)
{
	try
	{ 
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.PreInvokeMethod:&quot;); 
		}
		var sRequestedConnections;
		var sActivityCommentsFld;
		var RowId;
		var Status1 = &quot;WITHDRAW&quot;;
		var bcParent = this.ParentBusComp();
		var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);
		var sLOCCS = &quot;&quot;;
		var transactionName = &quot;VF Credit Check Withdrawal&quot;;
		var acceptFlg = &apos;N&apos;;
		var boAccount = this.BusObject();
		var bcIntendedHandset = boAccount.GetBusComp(&quot;VF Intended Handset&quot;);
		RowId = this.GetFieldValue(&quot;Id&quot;);

		switch(MethodName)
		{
			case &quot;EventMethodTriggerCreditCheck&quot;:
				//VF DO 14/4/10 - 10.3 Credit Approval. Calculate the requested connections
				//before setting the variable sent to the Fraud BS.
				mSetRequestedConnections(RowId);			  					
				sRequestedConnections = ToNumber(this.GetFieldValue(&quot;VF Requested Connections&quot;));			  					
			  					
				//DF 11/5/2010 - Moved code to mSetDefaultValues()				
				mSetDefaultValues();
				
				//XA 19/07/2011 - Paperless to check last ID scann session
				if (TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Retail&quot;))
				{
					mScanCheckBeforeCreditCheck();
				}
				mSetDVSTransId(sAccountId); //Suresh G - Added for 19.4
				mSetShippingAddrDetails(sAccountId,RowId); //Suresh G - Added for MR01
				//Rinu - 09/07/2018 - Addded for Hard Caps credit check validations for credit class - x1,x2
			/*	var bsInvokeHardCaps = TheApplication().GetService(&quot;VHA Hard Caps Procesing Service&quot;);
				var sCreditChkDt = this.GetFieldValue(&quot;VF Credit Check Status Modified Date&quot;);
				var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
				var psInput = TheApplication().NewPropertySet();
				var psOutput = TheApplication().NewPropertySet();				
					psInput.SetProperty(&quot;CreditChkDate&quot;,sCreditChkDt);	
					psInput.SetProperty(&quot;CreditClass&quot;,sCreditClass);				
					bsInvokeHardCaps.InvokeMethod(&quot;CreditCheckValidation&quot;, psInput, psOutput);*/
				
				var bsInvokeCreditCheck;
 				var psInputs = TheApplication().NewPropertySet();
			 	var psOutputs = TheApplication().NewPropertySet();
 	
				bsInvokeCreditCheck = TheApplication().GetService(&quot;VF Credit Fraud Check Toolkit Service&quot;);
				psInputs.SetProperty(&quot;Row Id&quot;, RowId);
				psInputs.SetProperty(&quot;Requested Connections&quot;, sRequestedConnections);
				psInputs.SetProperty(&quot;New CC Process&quot;, &quot;Y&quot;); 
				bsInvokeCreditCheck.InvokeMethod(&quot;Invoke Credit Check&quot;, psInputs, psOutputs);
				
				//VF DO 24/3/10 - 10.3 Credit Approval.
				var bsInvokeCreditCheck2;
				var bsSysPref;
 				var psInputs2 = TheApplication().NewPropertySet();
			 	var psOutputs2 = TheApplication().NewPropertySet();
			 	var psSysPrefInputs = TheApplication().NewPropertySet();
			 	var psSysPrefOutputs = TheApplication().NewPropertySet();
			 	var sChannel = this.GetFieldValue(&quot;VF Channel&quot;);
			 	var sLegacyCreditCheckSysPref = &quot;VF Legacy Online Credit Check&quot;;
			 	var sLegacyCreditCheckVal = &quot;&quot;;
 	
				bsInvokeCreditCheck2 = TheApplication().GetService(&quot;VF Credit Fraud Check Toolkit Service - VHA&quot;);
				psInputs2.SetProperty(&quot;Row Id&quot;, RowId);
				psInputs2.SetProperty(&quot;CA Id&quot;, sAccountId);
				
				//Get value for the Legacy Online Credit Check system preference
				bsSysPref = TheApplication().GetService(&quot;VF Get System Preference&quot;);
				psSysPrefInputs.SetProperty(&quot;System Preference Name&quot;, sLegacyCreditCheckSysPref);
				bsSysPref.InvokeMethod(&quot;Get System Preference&quot;, psSysPrefInputs, psSysPrefOutputs);
				sLegacyCreditCheckVal = psSysPrefOutputs.GetProperty(&quot;System Preference Value&quot;);
				
				//Call extra credit check validation for credit checks that 
				//were not initiated from self service or when the Legacy Online
				//Credit Check flag is turned off.
				if (sChannel == &quot;Web Store AU&quot;)
				{
					if (sLegacyCreditCheckVal == &quot;Y&quot;)
					{
						//Do not perform the extra credit check validation
					}
					else
					{
						bsInvokeCreditCheck2.InvokeMethod(&quot;Invoke Credit Check&quot;, psInputs2, psOutputs2);
					}
				}
				else
				{
					bsInvokeCreditCheck2.InvokeMethod(&quot;Invoke Credit Check&quot;, psInputs2, psOutputs2);
				}
				

				psSysPrefOutputs = null;
				psSysPrefInputs = null;
				psOutputs2 = null;
				psInputs2 = null;
				bsSysPref = null;
				bsInvokeCreditCheck2 = null;
	
				/*****************************************************************/
				// Call function to update the Existing Postpay Customer flag.
				/*****************************************************************/
	 			mUpdateExistingPostpay();

				/*****************************************************************/
				// Call business service to calculated the Live Connections.
				/*****************************************************************/
				var bsInvokeCalculateLive;
 				var psInputs = TheApplication().NewPropertySet();
			 	var psOutputs = TheApplication().NewPropertySet();

				bsInvokeCalculateLive = TheApplication().GetService(&quot;VF Live Connections Calculate&quot;);
				psInputs.SetProperty(&quot;Customer Account Id&quot;, sAccountId);
				bsInvokeCalculateLive.InvokeMethod(&quot;CalculateLiveConns&quot;, psInputs, psOutputs);

				mRefreshScreen(sAccountId);
				//Moved the setting of Camp code to new function as a part of CJ
				mSetCampCode();
				
				//For FP created through Online Store, if submit credit check is done from UI, 
				//update channel value to avoid triggering Notify SR
				
				if (sChannel == &quot;VHA Online Store&quot; &amp;&amp; !gEAIFlag)
				{
					this.SetFieldValue(&quot;VF Channel&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SS_CHANNELS&quot;, &quot;DIRECT&quot;));
					this.WriteRecord();
				}
				// VHA Suresh: 25/11/16:
				this.ActivateField(&quot;VHA Credit Submitted App&quot;);
				//this.SetFieldValue(&quot;VHA Credit Submitted App&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CREDIT_SUBMIT_APPLICATION&quot;, TheApplication().GetProfileAttr(&quot;ApplicationName&quot;)));
				//26/3/2019-Christy:Changed the ApplicationName profile attribute to VHA User Type for Unified Application 
				this.SetFieldValue(&quot;VHA Credit Submitted App&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CREDIT_SUBMIT_APPLICATION&quot;, TheApplication().GetProfileAttr(&quot;VHA User Type&quot;)));
				this.WriteRecord();
				
				/*****************************************************************/
				// Call function to create the Asynchronous Component Request
				/*****************************************************************/
				mCallCreditCheckProcessing();
				
			break;
			
		   	 // Don&apos;t insert any other case between &quot;AcceptCreditCheck&quot; and &quot;EventMethodTriggerWithdrawCreditCheck&quot;
		    case &quot;AcceptCreditCheckTBUI&quot;:
		    case &quot;AcceptCreditCheck&quot;:
		    		acceptFlg = &apos;Y&apos;;
		    		this.SetFieldValue(&quot;VF Process Id&quot;, &quot;Approve VFONE Dcsn&quot;);
		    		this.SetFieldValue(&quot;VF Override Code&quot;, &quot;APPROVE&quot;);
		    		
		    case &quot;RejectCreditCheckTBUI&quot;:
		    case &quot;RejectCreditCheck&quot;:		    				    	   
		        	transactionName = &quot;VF Credit Check Acceptance&quot;;
	   			 	if (MethodName == &quot;RejectCreditCheck&quot; || MethodName == &quot;RejectCreditCheckTBUI&quot;)
   				 	{
		    			this.SetFieldValue(&quot;VF Process Id&quot;, &quot;Withdraw VFONE Dcsn&quot;);
		    			this.SetFieldValue(&quot;VF Override Code&quot;, &quot;WITHDRAW&quot;);
		    		}
			case &quot;EventMethodTriggerWithdrawCreditCheck&quot;:
			
				//KPoluru:17/04/2010:TD#39553: Accept flag to  be set before submitting to WBI as this flag is not sent
				//to WBI when setting after submitting to WBI
				if(transactionName == &quot;VF Credit Check Acceptance&quot;)
   			 	{
   			 		this.SetFieldValue(&quot;VF Conditional Approval Accepted&quot;, acceptFlg);
   			 	}
				
				mSetDealerCode();  // To Predefault Dealer Details
			
				WriteRecord();  // VF L3 team: Def #:6574: RAMAA : To save the record 
								// implicitly with user data changes when the user hits the Withdraw button

				var svc = TheApplication().GetService( &quot;Workflow Process Manager&quot; );
	   		 	var inputSvc = TheApplication().NewPropertySet();
				var outputSvc = TheApplication().NewPropertySet();				
				var errorMsg = &quot;&quot;;   		 	
				inputSvc.SetProperty(&quot;ProcessName&quot;, &quot;VF Withdraw Credit Check&quot;);
				inputSvc.SetProperty(&quot;Object Id&quot;, sAccountId);
				//set the transaction type before invoking the workflow
				inputSvc.SetProperty(&quot;TransactionName&quot;, transactionName);
				svc.InvokeMethod(&quot;RunProcess&quot;, inputSvc, outputSvc);				
				errorMsg = outputSvc.GetProperty(&quot;ErrMessage&quot;);

				//Update credit check status and reset Requested Connection to zero

   			 	if(transactionName != &quot;VF Credit Check Acceptance&quot;)
				{
   			 		this.SetFieldValue(&quot;VF Credit Check Status&quot;, Status1);
   			 	}
   			 	
   			 	//VF DO 6/4/10 - 10.3 Credit Approval. When the credit check is accepted, 
   			 	//increase the credit check expiry date to 30 days from today.
   			 	if (MethodName == &quot;AcceptCreditCheck&quot;)
   			 	{
   			 		//DFiggis 3/9/2011 R11D Moved logic to seperate method due to max function length hit.
					mSetExpiryDate();
   			 	}  
   			 	this.ActivateField(&quot;VF Requested Connections&quot;);
   			  	this.SetFieldValue(&quot;VF Requested Connections&quot;, &quot;0&quot;);
   			 	if(errorMsg != &quot;&quot;)
 	  			{
 	  				//KPoluru:22/04/2010: Reset conditional approval accepted falg to balnl in case
 	  				//if there is any error message from decision point. Accept Conditiona/Reject conditions button
 	  				//on Financial PRofile applet will be enabled only if this flag is blank
 	  				this.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
 	  				this.SetFieldValue(&quot;VF Conditional Approval Accepted&quot;, &quot;&quot;);
 	  			}
 	  			WriteRecord();

				var SSJExistCust = TheApplication().GetProfileAttr(&quot;ExistingCustomerFlag&quot;);//Krishna:3/21/2026:SSJ Fulfillment
				if(SSJExistCust == &quot;Y&quot;)
				{
				}
				else
				{
 	  			/*TULASIY:17MAY2022::Created for NCC Flag Changes*/
				var bHandsetRecord1 = &quot;&quot;;
				bcIntendedHandset.InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
				bcIntendedHandset.ClearToQuery();
				bcIntendedHandset.ExecuteQuery();
				bcIntendedHandset.ActivateField(&quot;VF External Device Name&quot;);
				bHandsetRecord1 = bcIntendedHandset.FirstRecord();
				while (bHandsetRecord1)
				{					
					bcIntendedHandset.SetFieldValue(&quot;VF External Device Name&quot;, &quot;N&quot;);
					bHandsetRecord1 = bcIntendedHandset.NextRecord();
				}
				bcIntendedHandset.WriteRecord();
				bcIntendedHandset.InvokeMethod(&quot;SetAdminMode&quot;, &quot;FALSE&quot;);
				bcIntendedHandset.ClearToQuery();
				bcIntendedHandset.ExecuteQuery();
 	  			//NCC Flag Code ends
				}
 	  			if(errorMsg != &quot;&quot;)
 	  			{
 	  				throw(errorMsg);
 	  			}
 			break;

			// Upon Sync Live Connections, call Business Service to calculate Live again
			case &quot;CalculateLive&quot;:
		
				var bsInvokeCalculateLive;
 				var psInputs = TheApplication().NewPropertySet();
			 	var psOutputs = TheApplication().NewPropertySet();

				bsInvokeCalculateLive = TheApplication().GetService(&quot;VF Live Connections Calculate&quot;);
				psInputs.SetProperty(&quot;Customer Account Id&quot;, sAccountId);
				bsInvokeCalculateLive.InvokeMethod(&quot;CalculateLiveConns&quot;, psInputs, psOutputs);

				mRefreshScreen(sAccountId);
			break;
			
			case &quot;ResetCreditCheck&quot;:
				
				this.InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
				this.ClearToQuery();
				this.ExecuteQuery();				
				
				if (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View - Credit Check&quot; || TheApplication().ActiveViewName() == &quot;VF SPS Credit Check Postpay Mobile View&quot;)
				{
				this.SetFieldValue(&quot;VF Sales Agent Name&quot;, TheApplication().GetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;));		
				}
				else
				{
				this.SetFieldValue(&quot;VF Sales Agent Name&quot;, &quot;&quot;);			
				}																				
				//23/01/2015 RR: SPS : Inactivated resetting the Type of Sale field as the field is hidden in TBUI and is mandatory
				
				//24/01/2015 RR: SPS: Added code to set Type of Sale of Existing Customer Credit Check
				var strExstFlg = TheApplication().GetProfileAttr(&quot;VFExistCreditCheck&quot;);
				var strTypeofSale = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CC_TYPE_OF_SALE&quot;, &quot;Sale to Existing Customer&quot;);
				if(strExstFlg == &quot;Y&quot;)
				{
					this.SetFieldValue(&quot;VF Type of Sale&quot;,strTypeofSale);
				}
				this.SetFieldValue(&quot;VF Credit Check Bypass Reason&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VF Porting In&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VF Channel&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VF Requested Connections&quot;, &quot;0&quot;);
				this.SetFieldValue(&quot;VF Conditional Approval Accepted&quot;, &quot;&quot;);  //DFiggis 13/5/2010 - #5272
				this.SetFieldValue(&quot;D B Identifier&quot;, &quot;&quot;);  //DFiggis 25/5/2010 - #2904
				this.SetFieldValue(&quot;VF Credit Check Status&quot;, &quot;New&quot;);
				var sExtValue = this.GetFieldValue(&quot;Id Type&quot;);
				if(sExtValue == &quot;&quot; || sExtValue == null)
				{
					this.SetFieldValue(&quot;Id Type&quot;, &quot;N&quot;);
				}
				
				var sOwnRent = this.GetFieldValue(&quot;Own or Rent&quot;);//Check Explicitly put for Migrated Account
				if(sOwnRent == &quot;&quot; || sOwnRent == null)
				{
					this.SetFieldValue(&quot;Own or Rent&quot;, &quot;Owner&quot;);
				}
				mSetDealerCode();
				//SS:17/11/2016; added for redshield project
					if(TheApplication().ActiveViewName() == &quot;&quot;)
					this.SetFieldValue(&quot;VHA Device Fraud Check Status&quot;,&quot;&quot;);
					else
					this.SetFieldValue(&quot;VHA Device Fraud Check Status&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEVICE_FRAUD_CHK_STATUS&quot;,&quot;SBLORDER&quot;));
					this.SetFieldValue(&quot;VHA Device Fraud Check Txn Id&quot;,&quot;&quot;);

				this.WriteRecord();				
				mResetCampCode();
				var bHandsetRecord = &quot;&quot;;
				bcIntendedHandset.InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
				bcIntendedHandset.ClearToQuery();
				bcIntendedHandset.ExecuteQuery();
				bcIntendedHandset.ActivateField(&quot;VF External Device Name&quot;);//TULASIY:17MAY2022::Created for NCC Flag Changes
				bHandsetRecord = bcIntendedHandset.FirstRecord();
				while (bHandsetRecord)
				{
					bcIntendedHandset.SetFieldValue(&quot;VF External Device Name&quot;, &quot;N&quot;);//TULASIY:17MAY2022::Created for NCC Flag Changes
					bcIntendedHandset.SetFieldValue(&quot;Active Flag&quot;, &quot;N&quot;);
					bHandsetRecord = bcIntendedHandset.NextRecord();
				}
				bcIntendedHandset.WriteRecord();
				bcIntendedHandset.InvokeMethod(&quot;SetAdminMode&quot;, &quot;FALSE&quot;);
				bcIntendedHandset.ClearToQuery();
				bcIntendedHandset.ExecuteQuery();
				//Suma: 240426: Added For Cross Order Type
				var MultiOrdFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;ENABLE_MULTI_ORD_TYPE&quot;);
				var SSJView = TheApplication().ActiveViewName();//Krishna:3/21/2026:SSJ Fulfillment
				if(MultiOrdFlg == &quot;ENABLE_MULTI_ORD_TYPE_Y&quot; &amp;&amp; SSJView == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ Exist Customer&quot;)
				{
				//	var quoteId = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;Order Entry - Orders&quot;).GetFieldValue(&quot;Id&quot;);
				var bcOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
				var QuoteOrderno = TheApplication().GetProfileAttr(&quot;Order Number&quot;);
				with(bcOrder) 
					{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Order Number&quot;);
					SetSearchSpec(&quot;Order Number&quot;, QuoteOrderno);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					var quoteId = GetFieldValue(&quot;Id&quot;);
				//	TheApplication().RaiseErrorText(&quot;Error: &quot; + quoteId + &quot; | &quot; + RowId);
					}
					var bsInvokeAddItem;
 					var psInputs = TheApplication().NewPropertySet();
			 		var psOutputs = TheApplication().NewPropertySet();
 	
					bsInvokeAddItem = TheApplication().GetService(&quot;VHA SSJ Cart Device BS&quot;);
					psInputs.SetProperty(&quot;FinProfileId&quot;, RowId);
					psInputs.SetProperty(&quot;QuoteId&quot;, quoteId);
					bsInvokeAddItem.InvokeMethod(&quot;SSJAddIntededItems&quot;, psInputs, psOutputs);
				}
				
				//Set Admin Mode back to false to re-engage read only user properties.
				this.InvokeMethod(&quot;SetAdminMode&quot;, &quot;FALSE&quot;);
				this.ClearToQuery();
				this.ExecuteQuery();
				break;
				
			// HR 16/06/2010: For CA PCR08 10.3.1
			case &quot;ProvideFPDataAccess&quot;:
					
				if(RowId != null)
				{
				mProvideFPDataAccess();	
				}
				else
				{
				throw(&quot;There is no FP data for this Account&quot;);
				}				
				break;
			
			//HR 16/06/2010: For Merlin Wizard 2011	
			//case &quot;RefreshCreditCheckTBUI&quot;:
			case &quot;RefreshCreditCheck&quot;:	
				mRefreshWizardScreen(sAccountId);
				break;	
				
			//HR 04/11/2011: Added for SR 6962
			
			case &quot;SetDealership&quot;:
				
				var sSalesAgentName = this.GetFieldValue(&quot;VF Sales Agent Name&quot;);
				var sDealerCode   = this.GetFieldValue(&quot;Dealer Code&quot;);
				var sDealerDesc = this.GetFieldValue(&quot;Dealer Description&quot;);
				
				if(sSalesAgentName == &quot;&quot; || sSalesAgentName == null)
				{				
				this.SetFieldValue(&quot;VF Sales Agent Name&quot;, TheApplication().GetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;));
				}
				
				if((sDealerCode == &quot;&quot; || sDealerCode == null) || (sDealerDesc == &quot;&quot; || sDealerDesc == null))
				{
				mSetDealerCode();
				}
				this.WriteRecord();
				break;	
				
				
		}
		return (CancelOperation);
	}
	catch(e)
	{
		//DF 07/05/2010 - R10.3
		var strErrorMessage = &quot;&quot;;
		if(!defined(e.errText))
		{
			strErrorMessage = e.toString();
		}
		else
		{
	    	strErrorMessage = e.errText;
	    }
     	TheApplication().RaiseErrorText(strErrorMessage);				
	}
	finally
	{
		// Destroy Objects
		bcIntendedHandset = null;
		boAccount = null;
		bcParent = null;
		bsInvokeCreditCheck = null;
		bsInvokeCalculateLive = null;
		svc = null;
		inputSvc = null;
		outputSvc = null;
		psInputs = null;
		psOutputs = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.PreInvokeMethod:&quot;);
		}
	}
}"
			   SEQUENCE="31"
			   UPDATED="05/05/2026 22:33:09"
			   UPDATED_BY="SUMA"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreNewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreNewRecord ()
{
	try
	{
		//DFiggis 29/04/2010 - R10.3 VHA Credit Approval
		var strOrgId = TheApplication().GetProfileAttr(&apos;Me.Org.Organization Id&apos;);
		var strConsentText = mGetConsentText(strOrgId);
		TheApplication().SetProfileAttr(&quot;Credit Check Consent Text&quot;,strConsentText)	
	
	
		return (ContinueOperation);
	
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		
	}
}"
			   SEQUENCE="32"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreQuery"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreQuery ()
{
	try
	{
		//DFiggis 29/04/2010 - R10.3 VHA Credit Approval
		var strOrgId = TheApplication().GetProfileAttr(&apos;Me.Org.Organization Id&apos;);
		var strConsentText = mGetConsentText(strOrgId);
		TheApplication().SetProfileAttr(&quot;Credit Check Consent Text&quot;,strConsentText)	
	
	
		return (ContinueOperation);
	
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		
	}
}"
			   SEQUENCE="33"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	BusComp_PreSetFieldValue
 * Component Information : 	Validation around credit checking.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/11/2004	POD						Added code to update fields on credit approval
 * 14/4/2004	POD						Added Expiry date code
 * 26/07/2005	RNZ			4763		Cleaned up the code
 * 30/08/2005	CY			5919		Change Status values
 * 12/05/2008   RAMAA        Validation added to store the &quot;Credit Status&quot; 
 				value only when the user commits the record for Def #: 6574   
 * 23/03/2010	DO			10.3 Credit Approval - Check VF Campaign Code is valid
 * 23/03/2010   KP          10.3 Credit Approval - Validation for Employer Phone added
 * 19/05/2010	KPoluru		Defect#5301   Employer Phone number validation restricted only to Australia
 * 17/20/2011	AS			14593		Introduced new global variables to capture old and new value of &quot;VF Maximum Connects&quot;                             
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Financial Profile.PreSetFieldValue&quot;);
		}
		var vEmploymentStatRefresh = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EMPLMNTSTATREFRESH&quot;); //MADHUR::29-OCT-25::Added for PKE000000123596 START
		if (vEmploymentStatRefresh == &quot;ON&quot;)
		{
			if (FieldName == &quot;VF Financial Status&quot;) 
			{
				this.SetFieldValue(&quot;VF Financial Position&quot;, &quot;&quot;);
			}
		}//MADHUR::29-OCT-25::Added for PKE000000123596 END
		var input2, output2, oBS2;
		var sAccountId, sLiveCon, sApprCon, sReqCon;
	//	var sNewValue;  // VF 25/05/10 XA : to fix defect# 5317 
	// var sPrevValue; AS
		
		switch (FieldName)
		{
			
			case &quot;VF Credit Check Status&quot;:
				//Get existing value for the status field. Used in the activity.
				var sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
				
				//VF L3 Team: RAMAA on 12May08: For TD-6574, To store the &quot;Credit Status&quot; 
				//value only when the user commits the record 
				if ((this.GetUserProperty(&quot;StatusChanged&quot;) != &quot;Y&quot;))
				{
				sPrevValue = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
				//Setting the user property to check the previous credit check status by Sangeetha on 18Mar2011 
				this.SetUserProperty(&quot;PrevCCStatus&quot;, sPrevValue);
				}  		
				// VF L3 Team:12MAy2008:RAMAA: End of TD 6574
				
				sNewValue = FieldValue;
				
				
				//Get the number of Approved, Live and Requested connections
				sApprCon = this.GetFieldValue(&quot;VF Approved Connections&quot;);
				sLiveCon = this.GetFieldValue(&quot;VF Live Connections&quot;);
				sReqCon = this.GetFieldValue(&quot;VF Requested Connections&quot;);

				this.SetUserProperty(&quot;StatusChanged&quot;, &quot;Y&quot;);

				return (ContinueOperation);
			break;

			case &quot;VF Maximum Connects&quot;:
				//Get existing value for the status field. Used in the activity.
				sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
				sPrevValue1 = this.GetFieldValue(&quot;VF Maximum Connects&quot;); //AS 17/10/2011 Changes variable
				sNewValue1 = FieldValue; //AS 17/10/2011 Changes variable
				
				this.SetUserProperty(&quot;MaxConnectsChanged&quot;, &quot;Y&quot;);
				return (ContinueOperation);
			break;
			
			//VF DO 23/3/10 - 10.3 Credit Approval. Check user entered campaign code
			//is valid.
			case &quot;VF Campaign Code UI&quot;:
				if (FieldValue == &quot;&quot; || FieldValue == null)
				{
					return (ContinueOperation);
				}
				else
				{
					var sCodeStatus = mValidateCampaignCode(FieldName, FieldValue);
					if (sCodeStatus == &quot;VALID&quot;)
					{
						return (ContinueOperation);
					}
					else
					{
						throw &quot;An invalid Campaign Code was entered.&quot;;
						return (CancelOperation);
					}
				}
				break;
			
			case &quot;VF Employer Contact Phone&quot;:
				if (this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;)
				{
					oBS2 = TheApplication().GetService(&quot;VF Phone Number Validation&quot;);
					input2 = TheApplication().NewPropertySet();	
					output2 = TheApplication().NewPropertySet();			
					input2.SetProperty(&quot;FieldName&quot;, FieldName);
					input2.SetProperty(&quot;PhoneNumber&quot;, FieldValue);
					oBS2.InvokeMethod(&quot;ValidateWorkPhone&quot;, input2, output2);
				}
			break;
			
			// VF 19/11/2013 WOW CIR 14.0 Start
			
			case &quot;VF Current Years at Address&quot;:
			
				if(isNaN(FieldValue) || ToNumber(FieldValue) &lt; 0 || FieldValue.indexOf(&quot;.&quot;) != -1)
				{
					var sInvalidValue = &quot;The years at current address must be an integer 0 or greater. Please check and put in a valid value.&quot;;
					throw(sInvalidValue);
					return (CancelOperation);
				}
							
			break;
			
			
			case &quot;VF Years with Current Employer&quot;:
						
				if(isNaN(FieldValue) || ToNumber(FieldValue) &lt; 0 || FieldValue.indexOf(&quot;.&quot;) != -1)
				{
					var sInvalidValue = &quot;The years at current employment must be an integer 0 or greater. Please check and put in a valid value.&quot;;
					throw(sInvalidValue);
					return (CancelOperation);
				}
							
			break;
			
			// VF 19/11/2013 WOW CIR 14.0 End
			
			case &quot;VF Previous City&quot;:
			case &quot;VF Previous Country&quot;:
			case &quot;VF Previous Postcode&quot;: 
			case &quot;VF Previous Property Name&quot;:
			case &quot;VF Previous State&quot;:
			case &quot;VF Previous Street&quot;:
			case &quot;VF Previous Street Number&quot;: 
			case &quot;VF Previous Street Type&quot;:
			case &quot;VF Previous Suburb&quot;:
			case &quot;VF Previous Time at Address&quot;:
			case &quot;VF Previous Unit Number&quot;: 
			
				var sCurrVal = this.GetFieldValue(FieldName);
				if(sCurrVal != FieldValue)
					TheApplication().SetProfileAttr(&quot;gPvrAddChange&quot;, &quot;Y&quot;);
				
				break;
				
				//veera: 26/03/2019: Added for IR01	
			case &quot;VF Financial Position&quot;:
				var sActiveView = TheApplication().ActiveViewName();
				var sChVal = this.GetFieldValue(FieldName);
				var bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
 				var psInputs = TheApplication().NewPropertySet();
 				var psOutputs = TheApplication().NewPropertySet(); 
    			psInputs.SetProperty(&quot;Responsibility&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_OVERRIDE_CHK&quot;,&quot;CC Override Resp&quot;));
    			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
    			var sExists = psOutputs.GetProperty(&quot;Exists&quot;);
				if ((TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_VIEW_CHECK&quot;, sActiveView) == &quot;Y&quot;) &amp;&amp; sExists != &quot;Y&quot; &amp;&amp; ((sChVal != &quot;&quot; &amp;&amp; sChVal != null) &amp;&amp; sChVal != FieldValue))
					mCCValidation();
			
			break;
			//Veera: End			
		/*	//Added below code for PKE 23834 : Mahesh : 15-Sep-2015
		
				var sBypass = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_FIN_PROF_VAL&quot;,&quot;Bypass&quot;);
			
			
					
			
				case &quot;VF Previous Postcode&quot;:
				if(sBypass == &quot;N&quot;)
				{
					if(FieldValue.length &gt; 8)
					throw(&quot;Previous Address - Postal code cannot be more than 8 characters.&quot;);
				}
				
				var sCurrVal = this.GetFieldValue(FieldName);
				if(sCurrVal != FieldValue)
					TheApplication().SetProfileAttr(&quot;gPvrAddChange&quot;, &quot;Y&quot;);
				break;
			
				case &quot;VF Previous Street Number&quot;:
				if(sBypass == &quot;N&quot;)
				{
					if(FieldValue.length &gt; 8)
					throw(&quot;Previous Address - Street Number cannot be more than 8 characters.&quot;);
				}
				
				var sCurrVal = this.GetFieldValue(FieldName);
				if(sCurrVal != FieldValue)
					TheApplication().SetProfileAttr(&quot;gPvrAddChange&quot;, &quot;Y&quot;);
				break;
			
				case &quot;VF Previous Unit Number&quot;:
				if(sBypass == &quot;N&quot;)
				{
					if(FieldValue.length &gt; 8)
					throw(&quot;Previous Address - Unit Number cannot be more than 8 characters.&quot;);
				}
				
				var sCurrVal = this.GetFieldValue(FieldName);
				if(sCurrVal != FieldValue)
					TheApplication().SetProfileAttr(&quot;gPvrAddChange&quot;, &quot;Y&quot;);
				break;
			
			
				case &quot;VF Current Postcode&quot;:
				if(sBypass == &quot;N&quot;)
				{
					if(FieldValue.length &gt; 8)
					throw(&quot;Current Address - Postal code cannot be more than 8 characters.&quot;);
				}
				break;
			
				case &quot;VF Current Street Number&quot;:
				if(sBypass == &quot;N&quot;)
				{
					if(FieldValue.length &gt; 8)
					throw(&quot;Current Address - Street Number cannot be more than 8 characters.&quot;);
				}
				break;
			
				case &quot;VF Current Unit Number&quot;:
			    if(sBypass == &quot;N&quot;)
			    {
					if(FieldValue.length &gt; 8)
					throw(&quot;Current Address - Unit Number cannot be more than 8 characters.&quot;);
				}
				break;
			
			
			//Code for PKE 23834 Ends here*/
			
			
			
			
			
		}
	}
	
	catch(e)
	{
		if (defined(e.errText))
		{
			//var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
			
			var strError = e.errText; //VHA:SUI:SANDEEP:19/12/2014 - Removed + &quot;\r\n&quot; + e.toString(); in the line
		}
		else
		{
			var strError = e.toString(); 
		}
		TheApplication().RaiseErrorText(strError);
		//R10.3 Defect #39732
		//DFiggis 29/4/2010 - Removed comments on RaiseError and put commented out throw
		//throw(strError);
	}

	finally
	{
		// Destroy Objects
		/*Below variables are nullified by Sharukh on 01/04/2019*/

		input2 = null;
		output2 = null;
		oBS2 = null;

		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.PreSetFieldValue:&quot;);
		}
	}
}"
