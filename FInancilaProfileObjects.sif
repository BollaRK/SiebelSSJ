			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
	try
	{
	
		var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
		var status = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
		/*var bcDlGrp = TheApplication().GetBusObject(&quot;List Of Values&quot;).GetBusComp(&quot;VF List Of Values - Dealers&quot;); //Added for EGW Mobility
		var sDealerGrp=&quot;&quot;,sDealerCode=&quot;&quot;;
		this.ActivateField(&quot;Dealer Code&quot;);
		sDealerCode = this.GetFieldValue(&quot;Dealer Code&quot;); */

		var sView = TheApplication().ActiveViewName();
		
		with(bcLOV)
		{
			ActivateField(&quot;Value&quot;);
			ActivateField(&quot;Type&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Value&quot;, status);
			SetSearchSpec(&quot;Type&quot;,&quot;VF_CREDIT_CHECK_STATUS&quot;);
			ExecuteQuery();
			if(!FirstRecord())
			{
				TheApplication().RaiseErrorText(&quot;Not a valid Financial Profile Status, please enter valid status&quot;);
			}
		}
		
		/*	with(bcDlGrp)
		{
			ActivateField(&quot;Value&quot;);
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;VF Dealer Group&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Value&quot;, sDealerCode);
			SetSearchSpec(&quot;Type&quot;,&quot;VF_DEALER_CODE&quot;);
			ExecuteQuery();
			if(FirstRecord())
			{
				sDealerGrp = GetFieldValue(&quot;VF Dealer Group&quot;);
				this.SetFieldValue(&quot;VHA Dealer Group&quot;,sDealerGrp);
			}
		}*/

		//Added below code for PKE 23438 : Mahesh : 15-Sep-2015
		// Mahesh: 16-Oct-2015Removed the below Code for PKE 23438 as Solution moved to BS: VF Credit Fraud Check Toolkit Service
					
		/*	if(sView == &quot;VF Connection Wizard View - Credit Check – TBUI&quot; || sView == &quot;VF Connection View - Credit Check&quot; || sView == &quot;VF Com Account Financial Profile - Edit View&quot; || sView == &quot;VF Com Account Financial Profile View&quot;  )
			{
		
			var sBypass = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_FIN_PROF_VAL&quot;,&quot;Bypass&quot;);
			
			var sAddThrehold = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CURR_ADDR_MTHS_TBUI&quot;,&quot;CURR_ADDR_MTHS_TBUI&quot;);
			
			var sPrevAddrs = this.GetFieldValue(&quot;Credit Card Type&quot;);
		
			this.ActivateField(&quot;VF Previous State&quot;);
			this.ActivateField(&quot;VF Previous Postcode&quot;);
			this.ActivateField(&quot;VF Previous Unit Number&quot;);
			this.ActivateField(&quot;VF Previous Street Number&quot;);
			
			
			this.ActivateField(&quot;VF Current Postcode&quot;);
			this.ActivateField(&quot;VF Current Street Number&quot;);
			this.ActivateField(&quot;VF Current Unit Number&quot;);
			this.ActivateField(&quot;VF Current Time at Address&quot;);
			this.ActivateField(&quot;VF Current State&quot;);			
			
		
		
			var sState = this.GetFieldValue(&quot;VF Previous State&quot;);
			
			var cState = this.GetFieldValue(&quot;VF Current State&quot;);
			
			var sPP = this.GetFieldValue(&quot;VF Previous Postcode&quot;);
			var sPSN = this.GetFieldValue(&quot;VF Previous Street Number&quot;);
			var sPUN = this.GetFieldValue(&quot;VF Previous Unit Number&quot;);
			
			var sCP = this.GetFieldValue(&quot;VF Current Postcode&quot;);
			var sCSN = this.GetFieldValue(&quot;VF Current Street Number&quot;);
			var sCUN = this.GetFieldValue(&quot;VF Current Unit Number&quot;);
			
			var sCTA = this.GetFieldValue(&quot;VF Current Time at Address&quot;);
			
			
			
			if(sBypass == &quot;N&quot;)
			{		
			
				
				if(ToNumber(sCTA) &lt;= ToNumber(sAddThrehold) &amp;&amp; ToNumber(sPP.length) &gt; 8)
				TheApplication().RaiseErrorText(&quot;Previous Address - Postal code cannot be more than 8 characters.&quot;);
				
		
				if(ToNumber(sCTA) &lt;= ToNumber(sAddThrehold) &amp;&amp; ToNumber(sPSN.length)&gt; 8)
				TheApplication().RaiseErrorText(&quot;Previous Address - Street Number cannot be more than 8 characters.&quot;);
				
	
				if(ToNumber(sCTA) &lt;= ToNumber(sAddThrehold) &amp;&amp; ToNumber(sPUN.length) &gt; 8)
				TheApplication().RaiseErrorText(&quot;Previous Address - Unit Number cannot be more than 8 characters.&quot;);
				
				
				if((ToNumber(sCTA) &lt;= ToNumber(sAddThrehold) &amp;&amp; ToNumber(cState.length) &gt; 0) &amp;&amp; ToNumber(sState.length) == 0)
				TheApplication().RaiseErrorText(&quot;Previous Address - State cannot be blank.&quot;);
							
							
				
				if(ToNumber(sCP.length) &gt; 8)
				TheApplication().RaiseErrorText(&quot;Current Address - Postal code cannot be more than 8 characters.&quot;+&quot;\n&quot;+&quot;Update the address on the Customer Account then resubmit the Credit Check.&quot;);
				
		
				if(ToNumber(sCSN.length) &gt; 8)
				TheApplication().RaiseErrorText(&quot;Current Address - Street Number cannot be more than 8 characters.&quot;+&quot;\n&quot;+&quot;Update the address on the Customer Account then resubmit the Credit Check.&quot;);
				
	    
				if(ToNumber(sCUN.length) &gt; 8)
				TheApplication().RaiseErrorText(&quot;Current Address - Unit Number cannot be more than 8 characters.&quot;+&quot;\n&quot;+&quot;Update the address on the Customer Account then resubmit the Credit Check.&quot;);
				
				
					
			
			}
			}*/
				
				
		// PKE:23834 : Ends here
		
				
		//NEEL 10/09/2014 - QC2501
		
		if(sView == &quot;VF Connection Wizard View - Credit Check – TBUI&quot; || sView == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ&quot; || sView == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ Exist Customer&quot;)
		{
			TheApplication().Trace(&quot;START:Phone Number Update&quot;); 
			this.ActivateField(&quot;Work Phone&quot;);
			this.ActivateField(&quot;Contact Id&quot;);
			var sWorkPhone = this.GetFieldValue(&quot;Work Phone&quot;);
			var sContactId = this.GetFieldValue(&quot;Contact Id&quot;);
			TheApplication().Trace(&quot;START:Phone Number Update: sWorkPhone:&quot;+sWorkPhone); 
			TheApplication().Trace(&quot;START:Phone Number Update: sContactId:&quot;+sContactId);
			if (sWorkPhone != &quot;&quot;)
			{
				mValidatePhoneNumber(sWorkPhone,&quot;Work Phone&quot;);
				TheApplication().Trace(&quot;START:Phone Number Update: Crossed Validation&quot;);
		
				var boCurrent1 = TheApplication().GetBusObject(&quot;VF Generic TBUI BO&quot;);
				var bcContact1 = boCurrent1.GetBusComp(&quot;VF Contact Thin&quot;);
				bcContact1.SetViewMode(AllView);
				bcContact1.ClearToQuery();
				bcContact1.SetSearchSpec(&quot;Id&quot;, sContactId);
				bcContact1.ExecuteQuery(ForwardBackward);
				
				var x = bcContact1.FirstRecord();
				var y = bcContact1.CountRecords();
				//TheApplication().RaiseErrorText(x+sContactId+y);
				
				TheApplication().Trace(&quot;START:Phone Number Update: FirstRecord :&quot;+x);
				TheApplication().Trace(&quot;START:Phone Number Update: CountRecord :&quot;+y);
				if(bcContact1.FirstRecord())
				{
					TheApplication().Trace(&quot;START:Phone Number Update: Inside FirstRecord&quot;);
					TheApplication().Trace(&quot;START:Phone Number Update: Update Record Id: &quot; + bcContact1.GetFieldValue(&quot;Id&quot;));
					bcContact1.SetFieldValue(&quot;Work Phone #&quot;, sWorkPhone);
					bcContact1.WriteRecord();
					TheApplication().Trace(&quot;START:Phone Number Update: WriteRecord Completed&quot;);
				}
			}
			
			TheApplication().Trace(&quot;START:Phone Number Update: WriteRecord Completed 2&quot;);
			//18/9:Added for regression SIT:To throw the error message when permanent Resident is not entered in tbui View
				this.ActivateField(&quot;VF Employee Check&quot;);
				/*TULASIY:30MAY2022::Created for NOCC Handset Bypass Validation*/
				this.ActivateField(&quot;VF NCC Customer Flag&quot;);
				var sNOCC = this.GetFieldValue(&quot;VF NCC Customer Flag&quot;);
				if(this.GetFieldValue(&quot;VF Employee Check&quot;) != &quot;&quot; &amp;&amp; sNOCC != &quot;Y&quot;)//NOCC Code ends
				{
					TheApplication().RaiseErrorText(&quot;Current Time at Address and Residential details are Required&quot;);
				}//end 
		}	
		// NEEL - CHANGES END
		
		
		
		
		/************31/12/2014 RR: Added for Credit Check Notification in Tablet**********************/
		//var	RowId = this.GetFieldValue(&quot;Id&quot;);
		//TheApplication().TraceOn(&quot;c:\\trace.txt&quot;, &quot;Allocation&quot;, &quot;All&quot;);
		//TheApplication().Trace(&quot;start tracing!&quot;);

		/*this.ActivateField(&quot;Credit Updated By&quot;);
		this.ActivateField(&quot;Account Name&quot;);
		this.ActivateField(&quot;Account Id&quot;);
		this.ActivateField(&quot;VF Credit Check Status&quot;);
		var strLastUpdId = this.GetFieldValue(&quot;Credit Updated By&quot;);
		var strAccountName = this.GetFieldValue(&quot;Account Name&quot;);
		var strAccountId = this.GetFieldValue(&quot;Account Id&quot;);
		var strStatus = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
		var strBody = strAccountId + &quot;#&quot; + RowId + &quot;#&quot; + strStatus;
		
		//TheApplication().Trace(&quot;Last Upd&quot; +strLastUpdId+&quot;;Account Name&quot;+strAccountName+&quot;;Account Id&quot;+strAccountId+&quot;;Status&quot;+strStatus+&quot;;Body&quot;+strBody);
		
		if(strStatus != &quot;New&quot;)
		{
			//TheApplication().Trace(&quot;I am in &quot;+strStatus);
			var strOuts = TheApplication().NewPropertySet();
			var strInps = TheApplication().NewPropertySet();
			var strBS = TheApplication().GetService( &quot;VF SPS Credit Check Notificaion BS&quot;);
			strInps.SetProperty(&quot;Abstract&quot;,strAccountName);
			strInps.SetProperty(&quot;Message&quot;,strBody);
			strInps.SetProperty(&quot;UserId&quot;,strLastUpdId);
			strInps.SetProperty(&quot;Comments&quot;,RowId);	
			strBS.InvokeMethod(&quot;CreateNotificaion&quot;,strInps,strOuts);
			//TheApplication().Trace(&quot;I am done with changes&quot;);
		}*/
		/*******************************************************************************************/
		//TheApplication().Trace(&quot;End of tracing!&quot;);
   		//TheApplication().TraceOff();
	
	
	}
	catch(e)
	{
		throw(e);
	}

	finally
	{
		bcLOV = null;
		boLOV = null;
		bcContact1 = null;
		boCurrent1 = null;
		
	}
		
}"
			   SEQUENCE="35"
			   UPDATED="04/22/2026 22:26:38"
			   UPDATED_BY="KRISHNAS"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	BusComp_SetFieldValue
 * Component Information : 	Validation around credit checking.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 27/07/2005	RNZ						Initial version
 * 22/3/2006	CY			DF W2 12661 Script to set the Full Address, due to Partner Portal access.
 * 30/5/2007	CY			DF PD 4284	Limit Full Address to length 50 for display only.
 * 02/07/2008	VL			DF2729		Change Credit Card Number to VF Current Address - AU
 *										or VF Current Address - NZ depending on ARII Calc
 * 07/04/2010   DFiggis     R10.3 CA    Set Flag if employment status changes.
 * 14/06/2010   RKishore	Defect12748	Remove leading spaces in previous address for address validation issue
 * 15/07/2010	XA			R10.5		Added a logic for ARII if creation thorugh interface
 * 20/12/2010	JSK			R11.1		Added a logic for OLS 3
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function BusComp_SetFieldValue (FieldName)
{
	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Financial Profile.SetFieldValue&quot;);
		}

		// Declare Variables
		var sNum;
		var sProp;
		var sStreet;
		var sCountry;
		var sType;
		var sSuburb;
		var sFull;
		// DF 2729
		var sARII = this.GetFieldValue(&quot;ARII Calc&quot;);
		//var sNewValue; 
		var sChannel;
		var bcParentName;
		
		// XA Butterfly : 15/07/10
		if (TheApplication().GetProfileAttr(&quot;profAttrVFSSInboundCA&quot;) == &quot;Y&quot;)
		{
		  //SKV:21/12/2010:TD#13556: Added only if condition
			if(this.ParentBusComp() != null)
			{
				bcParentName = this.ParentBusComp().Name();
				if(bcParentName == &quot;Account&quot;)
				{
					sARII = this.ParentBusComp().GetFieldValue(&quot;Instantiate ARII&quot;);
				}
			}
		}
		
		switch (FieldName)
		{
			// Get the Current Address details and set the Full concatenated address
			case &quot;VF Current Street Number&quot;:
			case &quot;VF Current Street&quot;:
			case &quot;VF Current Street Type&quot;:
			case &quot;VF Current Property Name&quot;:
			case &quot;VF Current Suburb&quot;:
			case &quot;VF Current Country&quot;:
			// DF2729
			// case &quot;Credit Card Number&quot;:
				//Get the existing values
				sNum = this.GetFieldValue(&quot;VF Current Street Number&quot;);
				sProp = this.GetFieldValue(&quot;VF Current Property Name&quot;);
				sStreet = this.GetFieldValue(&quot;VF Current Street&quot;);
				sType = this.GetFieldValue(&quot;VF Current Street Type&quot;);
				sSuburb = this.GetFieldValue(&quot;VF Current Suburb&quot;);
				sCountry = this.GetFieldValue(&quot;VF Current Country&quot;);
				sFull = sNum + sStreet;
				if (sFull == &quot;&quot;)
					sFull = sProp + &quot; &quot; + sCountry;
				else
					sFull = sNum + &quot; &quot; + sStreet + &quot; &quot; + sType + &quot; &quot; + sSuburb + &quot; &quot; + sCountry;
				sFull = sFull.substring(0,49);
				// DF2729
				// this.SetFieldValue(&quot;Credit Card Number&quot;, sFull);
				// XA Butterfly: commented the codes used for NZ
				/*if (sARII != &quot;Australia&quot;)
					//this.SetFieldValue(&quot;VF Current Address - AU&quot;, sFull);
				//else
					this.SetFieldValue(&quot;VF Current Address - NZ&quot;, sFull);*/
				return (ContinueOperation);
			break;

			// Get the Previous Address details and set the Full concatenated address
			case &quot;VF Previous Street Number&quot;:
			case &quot;VF Previous Street&quot;:
			case &quot;VF Previous Street Type&quot;:
			case &quot;VF Previous Property Name&quot;:
			case &quot;VF Previous Suburb&quot;:
			case &quot;VF Previous Country&quot;:
			case &quot;Credit Card Type&quot;:			
				//Get the existing values
				sNum = this.GetFieldValue(&quot;VF Previous Street Number&quot;);
				sProp = this.GetFieldValue(&quot;VF Previous Property Name&quot;);
				sStreet = this.GetFieldValue(&quot;VF Previous Street&quot;);
				sType = this.GetFieldValue(&quot;VF Previous Street Type&quot;);
				sSuburb = this.GetFieldValue(&quot;VF Previous Suburb&quot;);
				sCountry = this.GetFieldValue(&quot;VF Previous Country&quot;);
				sFull = sNum + sStreet;
				if (sFull == &quot;&quot;)
					sFull = sProp + &quot; &quot; + sCountry;
				else
					sFull = sNum + &quot; &quot; + sStreet + &quot; &quot; + sType + &quot; &quot; + sSuburb + &quot; &quot; + sCountry;
			    //Defect 12748 - RK:20/09/2010:Remove the leading space in previous address
				sFull = trim(sFull)	;
				sFull = sFull.substring(0,49);
				this.SetFieldValue(&quot;Credit Card Type&quot;, sFull);			
				return (ContinueOperation);
			break;
			
			// VF 19/11/2013 WOW CIR 14.0 Start
			
			case &quot;VF Current Months at Address&quot;:
			case &quot;VF Current Years at Address&quot;:
					
					var sMonthsAddr = ToNumber(this.GetFieldValue(&quot;VF Current Months at Address&quot;));
					var sYearsAddr = this.GetFieldValue(&quot;VF Current Years at Address&quot;);
					var sTotalMonthsAddr = (sYearsAddr * 12 ) + sMonthsAddr;
					this.SetFieldValue(&quot;VF Current Time at Address&quot;, sTotalMonthsAddr);
					return (ContinueOperation);
			break;
			
			case &quot;VF Current Time at Address&quot;:
			
					var sTimeMonthsAddr = ToNumber(this.GetFieldValue(&quot;VF Current Time at Address&quot;));
					var sCalYearAddr = ( sTimeMonthsAddr - (sTimeMonthsAddr % 12) ) / 12;
					var sCalMonthsAddr = sTimeMonthsAddr % 12;
					this.SetFieldValue(&quot;VF Current Months at Address&quot;, sCalMonthsAddr);
					this.SetFieldValue(&quot;VF Current Years at Address&quot;, sCalYearAddr);
					return (ContinueOperation);
			break;
			
			case &quot;VF Months with Current Employer&quot;:
			case &quot;VF Years with Current Employer&quot;:
			
					var sMonthsEmp = ToNumber(this.GetFieldValue(&quot;VF Months with Current Employer&quot;));
					var sYearsEmp = this.GetFieldValue(&quot;VF Years with Current Employer&quot;);
					var sTotalMonthsEmp = (sYearsEmp * 12 ) + sMonthsEmp
					this.SetFieldValue(&quot;VF Time in Current Employer&quot;, sTotalMonthsEmp);
					return (ContinueOperation);
			
			break;
			
			case &quot;VF Time in Current Employer&quot;:
			
					var sTimeMonthsEmp = ToNumber(this.GetFieldValue(&quot;VF Time in Current Employer&quot;));
					var sCalYearEmp = ( sTimeMonthsEmp - (sTimeMonthsEmp % 12) ) / 12;
					var sCalMonthsEmp = sTimeMonthsEmp % 12;
					this.SetFieldValue(&quot;VF Months with Current Employer&quot;, sCalMonthsEmp);
					this.SetFieldValue(&quot;VF Years with Current Employer&quot;, sCalYearEmp);
					return (ContinueOperation);
			
			break;
			//ShilpaRaj :: 21May2024 :: For Tallyman_to_PCC Upgrade.
			case &quot;VF Credit Score&quot;:
			case &quot;VF Maximum Connects&quot;:
			case &quot;VF Credit Check Status Modified Date&quot;:
			case &quot;VF Credit Class&quot;:
			case &quot;VF Employer Current&quot;:
			case &quot;VF Financial Position&quot;:
			case &quot;VF Financial Status&quot;:
				//TheApplication().SetProfileAttr(&quot;Test&quot;,&quot;Y&quot;);
				this.SetUserProperty(&quot;SyncAccount&quot;,&quot;Y&quot;);
				return (ContinueOperation);
			break;
			//  VF 19/11/2013 WOW CIR 14.0 Start
			
			
			//set flag to trigger Send Credit Check Result interface -- AU Web Evolution project
			case &quot;VF Credit Check Status&quot;:
				this.SetUserProperty(&quot;SyncAccount&quot;,&quot;Y&quot;);// BHava 13/06/24 Created for Tallyman to PCC 
				sNewValue = this.GetFieldValue(&quot;VF Credit Check Status&quot;); 
				sChannel = this.GetFieldValue(&quot;VF Channel&quot;);
				//VF JSK 20/12/2010 Added a logic for VHA Online Store
				if((sChannel == &quot;Web Store AU&quot; ||sChannel == &quot;VHA Online Store&quot;)&amp;&amp; (sNewValue == &quot;WAITINFO&quot; || sNewValue == &quot;REFCOM&quot; || sNewValue == &quot;CONDAPPRVE&quot; || sNewValue == &quot;REFERRED&quot; || sNewValue == &quot;REFER&quot; || sNewValue == &quot;DECLINE&quot; || sNewValue == &quot;DECLINED&quot; || sNewValue == &quot;APPROVE&quot; || sNewValue == &quot;APPROVED&quot; || sNewValue == &quot;ACCEPT&quot; || sNewValue == &quot;WITHDRAW&quot;))
				{
					//SS Added below to set the channel value when the submit is not triggered from siebel
					if(sChannel == &quot;VHA Online Store&quot; &amp;&amp; this.GetUserProperty(&quot;PrevCCStatus&quot;) != &quot;Pending&quot;)
						this.SetUserProperty(&quot;SendCreditCheckResult&quot;, &quot;&quot;);
					else
						this.SetUserProperty(&quot;SendCreditCheckResult&quot;,sChannel);
				}

				return (ContinueOperation);
		}

	}
	
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		TheApplication().RaiseErrorText(strError);
	}

	finally
	{
		// Destroy Objects
		// Nothing to destroy
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.SetFieldValue:&quot;);
		}
	}
}"
			   SEQUENCE="36"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	BusComp_WriteRecord
 * Component Information : 	Updates account status and calls BS to create activity.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 27/07/2005	RNZ						Initial version
 * 11/5/2005	CY						Call mUpdateAccountStatus
 * 2/09/2005	CY			5919		Call mUpdateCreditDetails
 * 08/09/2088   Baranwas				SubmitCreditcheck Interface
 * 22/04/2010 KARP	If the updates comes from Interface the Credit Check Expiry Date will be updated
 	irrespective of status is changed or not.
 * 11/02/2011	JSK						Added OLS logic
 * 02/09/2011   DFiiggis   R11D         Made 30 day credit check expiry a sys pref
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function BusComp_WriteRecord ()
{
	try
	{	
		//TheApplication().TraceOn(&quot;C:\\OnVeerWRa.txt&quot;,&quot;Allocation&quot;,&quot;All&quot;);
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.WriteRecord:&quot;); 
		}
		
		// Declare Variables
		var inputActivity;
		var outputActivity;
		var AutoActivity;
		var sActivityCommentsFld;
		
		var bsOutbound;
		var psInputs;
		var psOutputs;
		var RowId;
		var sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
		//var sNewValue = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
		var bcHandset;
		var sCCStatus;
		var boActive;
		var ExpiryDate;
		var dateForm; 
		var timeForm;
		
		RowId = this.GetFieldValue(&quot;Id&quot;);
		
		//**************************************************
		// Credit Check Status changes
		//**************************************************
					
		if (this.GetUserProperty(&quot;StatusChanged&quot;) == &quot;Y&quot; )
		{
			this.SetUserProperty(&quot;StatusChanged&quot;, &quot;N&quot;);

			// Call function to update the other credit details
			mUpdateCreditDetails();
		
			// Call function to update the customer account Status
			mUpdateAccountStatus(sAccountId, sNewValue);

			//Set up business service for creating an automated activity.
			inputActivity = TheApplication().NewPropertySet();
			outputActivity = TheApplication().NewPropertySet();
			AutoActivity = TheApplication().GetService( &quot;VF Generate Activity Service&quot;);
		
			//Sets the activity comments variable
			sActivityCommentsFld = &quot;Credit Check Status updated from &quot; + sPrevValue + &quot; to &quot; + sNewValue;	
			
			with (inputActivity)
	    	{
    			SetProperty(&quot;Type&quot;, &quot;Other&quot;);
    			SetProperty(&quot;Description&quot;, &quot;Credit Check Status Updated&quot;);
    			SetProperty(&quot;Account Object Id&quot;, sAccountId);
	    		SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
    			SetProperty(&quot;Comment&quot;, sActivityCommentsFld);
    			SetProperty(&quot;Category&quot;, &quot;Delivery&quot;);
			}
		  	
		  	try
		  	{
			  	AutoActivity.InvokeMethod(&quot;GenerateActivity&quot;, inputActivity, outputActivity);		
			}
			
			catch (e)
			{
				throw (e);
			}
			
			//call business service when credit check ststus field is updated by Decision Point
			//and it would send a outbound message
			if(this.GetUserProperty(&quot;IsNewRecord&quot;) == &quot;&quot; &amp;&amp; this.GetUserProperty(&quot;SendCreditCheckResult&quot;)!=&quot;&quot;)
			{
				psInputs = TheApplication().NewPropertySet();
				psOutputs  = TheApplication().NewPropertySet();
				bsOutbound = TheApplication().GetService(&quot;VF Web Store Service&quot;);
				psInputs.SetProperty(&quot;CustomerAccountId&quot;, sAccountId);
				psInputs.SetProperty(&quot;FinProfileId&quot;, RowId);
				psInputs.SetProperty(&quot;Channel&quot;, this.GetUserProperty(&quot;SendCreditCheckResult&quot;));
						  	
			  	try
			  	{
				  	bsOutbound.InvokeMethod(&quot;CreditCheckResult&quot;, psInputs, psOutputs);		
					//VF JSK 11/02/2011 Added OLS logic
					this.SetUserProperty(&quot;SendCreditCheckResult&quot;,&quot;&quot;);
				}
				
				catch (e)
				{
					throw (e);
				}
			}
		}// end if (this.GetUserProperty(&quot;StatusChanged&quot;) == &quot;Y&quot; )
		//KARP 19/04/2010 Added For Credit Approval Project
		else if (gEAIFlag == &quot;Y&quot;)
		{
			// Start - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
			this.ActivateField(&quot;VF Credit Class&quot;);
			var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
			this.ActivateField(&quot;VF Financial Position&quot;);
			var sOccupation = this.GetFieldValue(&quot;VF Financial Position&quot;);
			this.ActivateField(&quot;VF Financial Status&quot;);
			var sEmpStatus = this.GetFieldValue(&quot;VF Financial Status&quot;)
			var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;, sCreditClass);

			if(sEmpStatus == &quot;Unemployed&quot; &amp;&amp; sOccupation == &quot;&quot; &amp;&amp; sOccupation == null)//Guru: 12/11/2021 - Added if block as part of PKE#93960
			{
				var strExpiryIncDays = mGetSysPref(&quot;VF UN CC Expiry Window - Days&quot;);
				this.SetFieldValue(&quot;VF Financial Position&quot;, &quot;Unemployed&quot;);
			}
			if(sEmpStatus != &quot;Unemployed&quot; &amp;&amp; sOccupation != &quot;&quot; &amp;&amp; sOccupation != null)
			{
				//R11D 3/9/2011 DFIGGIS Get the credit check increment sys pref			
				if((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap))
				{
					var strExpiryIncDays = mGetSysPref(&quot;VF HC CC Expiry Window - Days&quot;);
				}
				else
				{
					var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;);
				}
			}
			// End - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
			gEAIFlag == &quot;N&quot;
			// Sets up the Expiry date of 30 days from when the credit check was approved.
			ExpiryDate = new Date();
			//R11D 3/9/2011 DFiggis
			//ExpiryDate.setDate(ExpiryDate.getDate()+1*30); 
			ExpiryDate.setDate(ExpiryDate.getDate()+1 * strExpiryIncDays);
			dateForm = (ExpiryDate.getMonth() + 1) + &quot;/&quot; + (ExpiryDate.getDate()) + &quot;/&quot; + ExpiryDate.getFullYear();
			timeForm = dateForm + &quot; &quot; + ExpiryDate.getHours() + &quot;:&quot; + ExpiryDate.getMinutes() + &quot;:&quot; + ExpiryDate.getSeconds();
			//Sets the fields that are updated once a credit check is approved.
					if((TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;RestrictCCUpdate&quot;)) != &quot;Y&quot;)  //Veera: 05/17/2019: MR2: Added for MR1 Fallout
					{
						if((this.GetFieldValue(&quot;VHA Expiry Date Calc&quot;)) != &quot;Y&quot;)
						{
							this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
							this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
						}
					}
					else
					{
						this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
						this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
					}
			this.WriteRecord();
			
		}
		
		//*****************************************************
		// Create activity if Max Connections has been updated
		//*****************************************************
		if (this.GetUserProperty(&quot;MaxConnectsChanged&quot;) == &quot;Y&quot;)
		{
			this.SetUserProperty(&quot;MaxConnectsChanged&quot;, &quot;N&quot;);
		
			//Set up business service for creating an automated activity.
			inputActivity = TheApplication().NewPropertySet();
			outputActivity = TheApplication().NewPropertySet();
			AutoActivity = TheApplication().GetService( &quot;VF Generate Activity Service&quot;);
		
			//Sets the activity comments variable
			sActivityCommentsFld = &quot;Credit Check Maximum Connections updated from &quot; + sPrevValue1 + &quot; to &quot; + sNewValue1; //AS 17/10/2011 Changes variables
			
			with (inputActivity)
	    	{
    			SetProperty(&quot;Type&quot;, &quot;Other&quot;);
				SetProperty(&quot;Description&quot;, &quot;Credit Check Maximum Connections Updated&quot;);
    			SetProperty(&quot;Account Object Id&quot;, sAccountId);
	    		SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
    			SetProperty(&quot;Comment&quot;, sActivityCommentsFld);
    			SetProperty(&quot;Category&quot;, &quot;Delivery&quot;);
			}
		  	
		  	try
		  	{
			  	AutoActivity.InvokeMethod(&quot;GenerateActivity&quot;, inputActivity, outputActivity);		
			}
			
			catch (e)
			{
				throw (e);
			}
			
		}
		
	
		sCCStatus = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
		TheApplication().SetSharedGlobal(&quot;VFCCStatus&quot;,sCCStatus);
		var sViewName = TheApplication().ActiveViewName();
		if ((sViewName == &quot;VF Com Account Financial Profile View&quot;) || (sViewName == &quot;VF Com Account Financial Profile - Edit View&quot;))
		{
			boActive = TheApplication().ActiveBusObject();
			bcHandset = boActive.GetBusComp(&quot;VF Intended Handset&quot;);
			bcHandset.ClearToQuery();
			bcHandset.ExecuteQuery();
		}
		/********11/02/2015 RR: Added for Credit Check notification in SPS Tablet flow********/
		this.ActivateField(&quot;Account Name&quot;);
		this.ActivateField(&quot;VF Credit Check Status&quot;);
		var strLastUpName = TheApplication().GetProfileAttr(&quot;Login Name&quot;);
		var EmpBO = TheApplication().GetBusObject(&quot;Employee&quot;);
		var EmpBC = EmpBO.GetBusComp(&quot;Employee&quot;);
		with(EmpBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Login Name&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Login Name&quot;, strLastUpName);
			ExecuteQuery();
			if(FirstRecord())
			{
				var strLastUpdId = GetFieldValue(&quot;Id&quot;);
			}
		}
		var strAccountName = this.GetFieldValue(&quot;Account Name&quot;);
		var strStatus = this.GetFieldValue(&quot;VF Credit Check Status&quot;);
		var strBody = sAccountId + &quot;#&quot; + RowId + &quot;#&quot; + strStatus;
		var strOuts = TheApplication().NewPropertySet();
		var strInps = TheApplication().NewPropertySet();
		var strBS = TheApplication().GetService( &quot;VF SPS Credit Check Notificaion BS&quot;);
		var strApp = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
		strInps.SetProperty(&quot;Abstract&quot;,strAccountName);
		strInps.SetProperty(&quot;Message&quot;,strBody);
		strInps.SetProperty(&quot;UserId&quot;,strLastUpdId);
		strInps.SetProperty(&quot;Comments&quot;,RowId);
		var strApp = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
		if(strApp == &quot;Siebel eChannel for CME_Mobile&quot;)
		{
			if(strStatus == &quot;Pending&quot;)
			{
				strBS.InvokeMethod(&quot;CreateNotificaion&quot;,strInps,strOuts);
			}
		}
		if(strStatus != &quot;New&quot; &amp;&amp; strStatus != &quot;Pending&quot;)
		{
				strBS.InvokeMethod(&quot;mResponseNotification&quot;,strInps,strOuts);
					
		}	
		//ShilpaRaj::Created21May24::Tallyman_to_PCC Upgrade:
		if (this.GetUserProperty(&quot;SyncAccount&quot;) == &quot;Y&quot;)
		{
		this.SetUserProperty(&quot;SyncAccount&quot;, &quot;N&quot;);
		mSyncAccountBC();
		}
		/*******************************************************************************************/

		/*var sViewName = TheApplication().ActiveViewName();
		if ((sViewName == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ&quot; || sViewName == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ Exist Customer&quot;) &amp;&amp; this.GetUserProperty(&quot;IsNew&quot;) == &quot;Y&quot;)
		//if (sViewName == &quot;VF Connection Wizard View - Credit Check – TBUI - SSJ&quot;)
			{
			this.SetUserProperty(&quot;IsNew&quot;, &quot;N&quot;);		
			var ipsInputs = TheApplication().NewPropertySet();
			var ipsOutputs  = TheApplication().NewPropertySet();
			var ibs = TheApplication().GetService(&quot;VHA SSJ Cart Device BS&quot;);
			
			ipsInputs.SetProperty(&quot;FinProfileId&quot;, RowId);
			ipsInputs.SetProperty(&quot;QuoteId&quot;,&quot;&quot;);
			try
		  	{
				
			  	ibs.InvokeMethod(&quot;GetDeviceItems&quot;, ipsInputs, ipsOutputs);
				
			}
			
			catch (e)
			{
				throw (e);
			}
					

		}*/
				
	}
	catch (e)
	{

	
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		
		
		
	}
	finally
	{
		// Destroy Objects
		psInputs = null;
		psOutputs = null;
		strInps = null;
		strOuts = null;
		//ipsInputs = null;
		//ipsOutputs = null;
		//ibs = null;
		strBS = null;
		bsOutbound = null;
		bcHandset = null;

		/*Below variables are nullified by Sharukh on 01/04/2019*/
		
		//EmpBC = null;
		if(defined(EmpBC)) { EmpBC = null; }//This variable is nullified by BALAMURUGAN on 24/10/2019
		AutoActivity = null;
		inputActivity = null;
		outputActivity = null;
		boActive = null;
		//EmpBO = null;
		if(defined(EmpBO)) { EmpBO = null; }//This variable is nullified by BALAMURUGAN on 24/10/2019
		

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.WriteRecord:&quot;);
		}
	}
}"
			   SEQUENCE="37"
			   UPDATED="01/29/2026 22:23:20"
			   UPDATED_BY="KRISHNAS"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="FnPreInvoke_Comments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function FnPreInvoke_Comments()
{
/*
 * Component Name			: Com Financial Profile
 * Method Name           	: BusComp_PreInvokeMethod
 * Component Information 	: Logic to process the submit and withdrawal requests
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 27/07/2005	RNZ			4763		Totally re-written code
 * 18/08/2005	CY			5919		WriteRecord required
 * 12/05/2006	CY			CR1219		Add Update Existing Postpay flag
 * 7/06/2006	CY			14843		Calculate Live upon Submit
 * 6/06/2007	CY			4625		Default fields to 0 not null
 * 14/06/2007   CY			Prod#4789	Add validation for DP data constraints
 * 12/05/2008   RAMAA       Added code to Save the record implicitly when the user hits the &quot;Withdraw Credit Check&quot; button for Def #: 6574 
 * 24/03/2010	DO			10.3 Credit Approval. Added branch to call new credit check	validation.
 * 24/03/2010   KPOLURU         10.3 Credit Approval     Added case staements for Accept/Reject conditional approval
 * 30/03/2010	DO			10.3 Credit Approval. Added case for ResetCreditCheck.
 * 06/04/2010	DO			10.3 Credit Approval. Update the credit check expiry date when a conditionally approved credit check is accepted.
 * 07/04/2010	DO			10.3 Credit Approval. Copy the UI Campaign Code value to the integration Campaign Code value.
 * 14/04/2010	DO			10.3 Credit Approval. Calculate the requested connectionsbefore setting the variable sent to the Fraud BS.
 * 18/06/2010   HR          10.3.1 CA PCR08 Added New Case for ProvideFPDataAccess
 * 23/07/2010	KARP		Campaign Code search should be case insensitive(Defect# 12903)
 * 02/10/2010   DFiggis     Moved credit expiry date calculation for acceptance of conditional approval to seperate method.
 * 12/07/2013	SIBIC		Reset campaign code for CJ and setting code moved to new function
 */
}"
