			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDVSTransId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetDVSTransId(AccountId)
{
//VHA NandhiniG 26/07/20 : Changed the SearchSpec and conditions to set the DVS Transaction Id Value in Credit Check Request as part of  Aug Rel - VEVO CIR.	
try
{	
	if(AccountId != null &amp;&amp; AccountId != &quot;&quot;)
	{		
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);	
		var sAccBC = sBO.GetBusComp(&quot;Account&quot;);
		var sConBC = sBO.GetBusComp(&quot;Contact&quot;);
		var sConIdBC = sBO.GetBusComp(&quot;VF Contact Id&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Configuration List&quot;);
		var sContactId = &quot;&quot;, sPPCountryFlag = &quot;Y&quot;,sDVSTranId = &quot;&quot;,sDVSSuccessTime = &quot;&quot;,sLocalPP = &quot;&quot;;
		var sSearchExpr1 = &quot;&quot;;
		var sSearchExpr2 = &quot;&quot;;
		var sDVSId = &quot;&quot;, sPassportId = &quot;&quot;, sLicenseId=&quot;&quot;,sMediId = &quot;&quot;;
		var sInvPPId = &quot;&quot;,sInvDLId = &quot;&quot;,sInvMCId= &quot;&quot;,sValidIDType = &quot;&quot; , sDVSTranId = &quot;&quot;;
		var sPassport = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Passport&quot;);
		var sDrivLicense = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Driver&apos;s Licence&quot;);
		var sMediCard = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Medicare Card&quot;);
		var sIP = &quot;NA&quot;, sPP = &quot;NA&quot;, sDL = &quot;NA&quot;, sMC = &quot;NA&quot;,sIPId = &quot;&quot; ,sInvIPId = &quot;&quot;,sVEVOSysdown = &quot;&quot;,sValidIDFlag = &quot;&quot;,sDVSTranIdType = &quot;&quot;,sDVSIdAvailable = &quot;N&quot;;
		
		with(sAccBC)
		{			
		 	ClearToQuery();		
			ActivateField(&quot;Primary Contact Id&quot;);			
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, AccountId);		
			ExecuteQuery();
			if(FirstRecord())
			{
				sContactId = GetFieldValue(&quot;Primary Contact Id&quot;);
			
			
				with (sConBC)
				{					
					SetViewMode(AllView);
					ClearToQuery();					
					ActivateField(&quot;Id&quot;);				
					SetSearchSpec(&quot;Id&quot;, sContactId);
					ExecuteQuery(ForwardOnly);					
					if (FirstRecord())
					{
						with(sConIdBC)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;Id Type&quot;);
							ActivateField(&quot;DVS Transaction Id&quot;);
							ActivateField(&quot;VHA Remove Existing Id&quot;);
							ActivateField(&quot;Country of Issue&quot;);
							ActivateField(&quot;VHA IsVEVOSysdown&quot;);
							ActivateField(&quot;VHA Primary ID Captured Ref&quot;);
						//	sSearchExpr1 = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos;	AND ([Id Type] = &apos;&quot;+sPassport+&quot;&apos; OR [Id Type] = &apos;&quot;+sDrivLicense+&quot;&apos; OR [Id Type] = &apos;&quot;+sMediCard+&quot;&apos;) AND [DVS Successful Time] IS NOT NULL AND [DVS Transaction Id] IS NOT NULL&quot;	
						//	SetSearchExpr(&apos;[Contact Id] = &quot;&apos;+sContactId+&apos;&quot;	AND ([Id Type] = &quot;&apos;+sPassport+&apos;&quot; OR [Id Type] = &quot;&apos;+sDrivLicense+&apos;&quot; OR [Id Type] = &quot;&apos;+sMediCard+&apos;&quot;) AND [DVS Successful Time] IS NOT NULL AND [DVS Transaction Id] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &quot;Y&quot; OR [VHA Remove Existing Id] IS NULL)&apos;);
							SetSearchExpr(&apos;[Contact Id] = &quot;&apos;+sContactId+&apos;&quot;	AND ([Id Type] = &quot;&apos;+sPassport+&apos;&quot; OR [Id Type] = &quot;&apos;+sDrivLicense+&apos;&quot; OR [Id Type] = &quot;&apos;+sMediCard+&apos;&quot;) AND [VHA Primary ID Captured Ref] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &quot;Y&quot; OR [VHA Remove Existing Id] IS NULL)&apos;);
						//	SetSearchExpr(&quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos;	AND ([Id Type] = &apos;&quot;+sPassport+&quot;&apos; OR [Id Type] = &apos;&quot;+sDrivLicense+&quot;&apos; OR [Id Type] = &apos;&quot;+sMediCard+&quot;&apos;) AND [VHA Primary ID Captured Ref] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &apos;Y&apos; OR [VHA Remove Existing Id] IS NULL)&quot;);
							ExecuteQuery(ForwardOnly);	
							var irec = 	FirstRecord();
							if(FirstRecord())
							{
							sDVSIdAvailable = &quot;Y&quot;;			
							while(irec)
							{
								sDVSTranId = GetFieldValue(&quot;DVS Transaction Id&quot;);
								sDVSSuccessTime = GetFieldValue(&quot;DVS Successful Time&quot;);
								
								if(GetFieldValue(&quot;Id Type&quot;) == sPassport)
								{
									sPPCountryFlag = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;PassportCountry|&quot;+GetFieldValue(&quot;Country of Issue&quot;));
									if(sPPCountryFlag == &quot;Y&quot;)
									{
									sLocalPP = &quot;Y&quot;;
										if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
										{
											sPassportId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sPP = &quot;Y&quot;;
										}
										else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
										{
											sPassportId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sPP = &quot;N&quot;;
										}
									}
									else 
									{
										sVEVOSysdown = GetFieldValue(&quot;VHA IsVEVOSysdown&quot;);																	
										if(((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)) || (sVEVOSysdown == 1))
											sIP = &quot;Y&quot;;
										else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
											sIP = &quot;N&quot;;
									}
								}
								else if(GetFieldValue(&quot;Id Type&quot;) == sDrivLicense)
								{	
									if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null)  &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
									{
										sLicenseId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sDL = &quot;Y&quot;;
									}
									else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
									{
										sLicenseId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sDL = &quot;N&quot;;
									}
								}
								else if(GetFieldValue(&quot;Id Type&quot;) == sMediCard)
								{
									if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
									{
										sMediId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sMC = &quot;Y&quot;
									}
									else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
									{
										sMediId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sMC = &quot;N&quot;;
									}
								}
								
							irec = NextRecord();		
							}
							}
							if(sLocalPP == &quot;Y&quot;)
								sIP = &quot;NA&quot;;

							var sSearchSpec = &quot;[Type] = &apos;VHA_DVS_CC_REQUEST_VALUE&apos; AND [Active Flg] = &apos;Y&apos; AND [String 1] = &apos;&quot;+sIP+&quot;&apos; AND [String 2] = &apos;&quot;+sPP+&quot;&apos; AND [String 3] = &apos;&quot;+sDL+&quot;&apos; AND [String 4] = &apos;&quot;+sMC+&quot;&apos;&quot;;
							with(sBC)
							{
								ActivateField(&quot;Value&quot;);
								ActivateField(&quot;Name&quot;);
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchExpr(sSearchSpec);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									sValidIDFlag = GetFieldValue(&quot;Name&quot;);
									sDVSTranIdType = GetFieldValue(&quot;Value&quot;);					
								}
							}
							
							if(sDVSTranIdType == &quot;Passport&quot;)
								sDVSId = sPassportId;
							else if (sDVSTranIdType == &quot;DL&quot;)
								sDVSId = sLicenseId;
							else if (sDVSTranIdType == &quot;MC&quot;)
								sDVSId = sMediId;

						if(sDVSIdAvailable == &quot;N&quot;)
							{
								SetViewMode(AllView);
								ClearToQuery();	
								ActivateField(&quot;Id Type&quot;);
								ActivateField(&quot;VHA Primary ID Captured Ref&quot;);
								ActivateField(&quot;VHA Remove Existing Id&quot;);
								SetSearchExpr(&quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos; AND ([VHA Remove Existing Id] &lt;&gt; &apos;Y&apos; OR [VHA Remove Existing Id] IS NULL)&quot;);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									var isrec1 = FirstRecord();
									while(isrec1)
									{
										if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CC_NONDVS_ID&quot;,GetFieldValue(&quot;Id Type&quot;)) == &quot;Y&quot;)
										{
											sValidIDFlag = &quot;Y&quot;;
										}
										else if((GetFieldValue(&quot;VHA Primary ID Captured Ref&quot;) == &quot;&quot; || GetFieldValue(&quot;VHA Primary ID Captured Ref&quot;) == null) &amp;&amp; 
										TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DVS_PP_TBUI&quot;,GetFieldValue(&quot;Id Type&quot;)) == &quot;Y&quot;)
										{
											sDVSSuccessTime = GetFieldValue(&quot;DVS Successful Time&quot;);
											sDVSTranId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sValidIDFlag = &quot;Y&quot;;
											if(GetFieldValue(&quot;Id Type&quot;) == sPassport &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sPassportId = sDVSTranId;
											else if(GetFieldValue(&quot;Id Type&quot;) == sDrivLicense &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sLicenseId = sDVSTranId;
											else if(GetFieldValue(&quot;Id Type&quot;) == sMediCard &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sMediId = sDVSTranId;
										}
									isrec1 = NextRecord();
									}
									if(sPassportId != &quot;&quot; &amp;&amp; sPassportId != null)
										sDVSId = sPassportId;
									else if (sLicenseId != &quot;&quot; &amp;&amp; sLicenseId != null)
										sDVSId = sLicenseId;
									else if (sMediId != &quot;&quot; &amp;&amp; sMediId != null)
										sDVSId = sMediId;
								//VHA NandhiniG 07/10/20 : Added for VEVO Post Production issue fix.
								}
							}

						}
					}
				}
			}
		}
	}
	//if(sDVSId != null &amp;&amp; sDVSId != &quot;&quot;)
	//{	
		this.ActivateField(&quot;VHA Device Fraud Check Txn Id&quot;);
		this.ActivateField(&quot;VHA ValidIdIdent&quot;);
		this.SetFieldValue(&quot;VHA Device Fraud Check Txn Id&quot;,sDVSId);
		this.SetFieldValue(&quot;VHA ValidIdIdent&quot;,sValidIDFlag);
		this.WriteRecord();
		this.InvokeMethod(&quot;RefreshBusComp&quot;);
//	}
}

catch(e)
{
throw(e);
}
	
finally
{
	sAccBC = null;
	sConBC = null;
	sConIdBC = null;
	sBC = null;
	sBO = null;
	sContactId = null;
	sSearchExpr1 = null;
	sSearchExpr2 = null;
	sDVSId = null;
		
}
}"
