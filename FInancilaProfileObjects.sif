			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 18/06/2010	HR		Created for CA PCR08
*/

function mProvideFPDataAccess()
{
	try 
	{ 	
		TheApplication().SetProfileAttr(&quot;profFPDataAccess&quot;, &quot;Y&quot;);
		this.InvokeMethod(&quot;RefreshRecord&quot;);
		mAuditTrailDataAccess();	
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{
	// Do Nothing	
	}
}"
