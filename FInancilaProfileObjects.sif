			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDefaultValues"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetDefaultValue
 * Component Information : 	This calls a business service which creates a component
 *							request (batch job) to process the credit check for the account.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/5/2010    DFiggis     R10.3 CA    Moved code from PreInvokeMethod because method reach max text length.	
 * 12/5/2010    DFiggis     #5233       Production fix to set Residential Status for Corporates.			
 */
function mSetDefaultValues()
{

	try 
	{ 		
		/*****************************************************************/
		// Defect 4625 - default field values to 0.
		// Save the record with user data changes
		/*****************************************************************/
		if (this.GetFieldValue(&quot;VF Previous Time at Address&quot;) == &quot;&quot;)
		 	this.SetFieldValue(&quot;VF Previous Time at Address&quot;, &quot;0&quot;);
		if (this.GetFieldValue(&quot;Account Type&quot;) == &quot;Person&quot;)
		{
			if (this.GetFieldValue(&quot;VF Number of Credit Cards&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Number of Credit Cards&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Gross Income&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Gross Income&quot;, &quot;0&quot;);
		}
		else
		{
			if (this.GetFieldValue(&quot;VF Director Net Monthly Income&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Director Net Monthly Income&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Director Time in Industry&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Director Time in Industry&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Num Partners-Owners&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Num Partners-Owners&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Number of Corporate Entities&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Number of Corporate Entities&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Number of Locations&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Number of Locations&quot;, &quot;0&quot;);
	 	}


		/*****************************************************************/
		// Defect 4789 - Set the Application Type.
		/*****************************************************************/
		if (this.GetFieldValue(&quot;Account Type&quot;) == &quot;Person&quot;)
		 	this.SetFieldValue(&quot;VF Credit Application Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_APP_TYPE&quot;,&quot;Consumer&quot;));
		else
		 	this.SetFieldValue(&quot;VF Credit Application Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_APP_TYPE&quot;,&quot;Commercial&quot;));

			
		/*****************************************************************/
		// Defect 5233 - Set the Residential Status for Corporates.
		/*****************************************************************/		
		if (this.GetFieldValue(&quot;Account Type&quot;) != &quot;Person&quot;)
		{
			this.SetFieldValue(&quot;Own or Rent&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_RESIDENTIAL_STATUS&quot;,&quot;Unknown&quot;));
		}
		//01/02/2015RR: Added code for setting proper Intended Usage before submit
		
		var strAccId = this.GetFieldValue(&quot;Account Id&quot;);
		var strType = &quot;&quot;;
		var strCustType = &quot;&quot;;
		var strSTFlg = &quot;&quot;;
		var strBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var strBC = strBO.GetBusComp(&quot;Account&quot;);
		with(strBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;SOHO Customer&quot;);
			ActivateField(&quot;VF Customer Type&quot;); //Saravanan : 24/04/15: Defect# 15.2 - 96
			SetSearchSpec(&quot;Id&quot;,strAccId);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
				strType = GetFieldValue(&quot;Type&quot;);
				strSTFlg = GetFieldValue(&quot;SOHO Customer&quot;);
				strCustType = GetFieldValue(&quot;VF Customer Type&quot;);	
			}
			if(strCustType == &quot;Person&quot;) // &amp;&amp; (strSTFlg == &quot;N&quot; || strSTFlg == &quot;&quot;))
				this.SetFieldValue(&quot;VF Intended Usage&quot;,&quot;Private&quot;);
			else
				this.SetFieldValue(&quot;VF Intended Usage&quot;,&quot;Commercial&quot;);
		}
		
			
		WriteRecord();
		
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{
		strBC = null;
		strBO = null;
	}
}"
			   SEQUENCE="17"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetExpiryDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetExpiryDate
 * Component Information : 	This method set the expriy date on the Fin Profile.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/9/2010    DFiggis     R11D        Moved code from PreInvokeMethod because method reach max text length.	
 */
function mSetExpiryDate()
{
	try 
	{ 
		// Start - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
		this.ActivateField(&quot;VF Credit Class&quot;);
		var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
		this.ActivateField(&quot;VF Financial Position&quot;);
		var sOccupation = this.GetFieldValue(&quot;VF Financial Position&quot;);
		this.ActivateField(&quot;VF Financial Status&quot;);
		var sEmpStatus = this.GetFieldValue(&quot;VF Financial Status&quot;);
		var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;, sCreditClass);	
		
		if(sEmpStatus == &quot;Unemployed&quot; &amp;&amp; sOccupation == null &amp;&amp; sOccupation == &quot;&quot;)//Guru: 12/11/2021 - Added if block as part of PKE#93960
		{
			var strExpiryIncDays = mGetSysPref(&quot;VF UN CC Expiry Window - Days&quot;);
			this.SetFieldValue(&quot;VF Financial Position&quot;, &quot;Unemployed&quot;);
		}
		if(sEmpStatus != &quot;Unemployed&quot; &amp;&amp; sOccupation != &quot;&quot; &amp;&amp; sOccupation != null)
		{
			if((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap))
			{
				var strExpiryIncDays = mGetSysPref(&quot;VF HC CC Expiry Window - Days&quot;); 
			}
			else
			{
				var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;); 
			}
		}
		//End - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
		//R11D 3/9/2011 DFIGGIS Get the credit check increment sys pref
		//var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;);   			 	   			 	
 		var dToday = new Date();
 		//Get the current time in milliseconds
 		var iToday = dToday.getTime();	
 		//Add 30 days (calculated as milliseconds) to the current time
		//R11D 3/9/2011 DFiggis, remove 30 day hard coding
 		//var iNewExpiryDate = iToday + (30 * 24 * 60 * 60 * 1000);
 		var iNewExpiryDate = iToday + (strExpiryIncDays * 24 * 60 * 60 * 1000);		 		
 		var dNewExpiryDate = new Date(iNewExpiryDate);
		var sDateForm = (dNewExpiryDate.getMonth() + 1) + &quot;/&quot; + dNewExpiryDate.getDate() + &quot;/&quot; + dNewExpiryDate.getFullYear();
		var sTimeForm = sDateForm + &quot; &quot; + dNewExpiryDate.getHours() + &quot;:&quot; + dNewExpiryDate.getMinutes() + &quot;:&quot; + dNewExpiryDate.getSeconds();
 		this.ActivateField(&quot;VF Credit Check Expiry Date&quot;);
		this.ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);//smart lock pke change
					if((TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;RestrictCCUpdate&quot;)) != &quot;Y&quot;)  //Veera: 05/17/2019: MR2: Added for MR1 Fallout
					{
						if((this.GetFieldValue(&quot;VHA Expiry Date Calc&quot;)) != &quot;Y&quot;)
						{
							this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
							this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
						}	
					}
					else
					{
						this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
						this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
					}
 		dNewExpiryDate = null;
 		dToday = null;
   			 			
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{

	}
}"
