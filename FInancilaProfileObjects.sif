			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="(declarations)"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Global variables
var gStatusApproved;
var gFieldValue;
