			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpdateIDScanSession"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Saravanan J: 23-03-2025 created for Imagine ID Scan and Submit Credit Check Issue.
function fnUpdateIDScanSession(Inputs,Outputs)
{
	try 
	{	var sCustId = Inputs.GetProperty(&quot;CustId&quot;);
		var sAccBO = TheApplication().GetBusObject(&quot;Account&quot;);
 		var sAccBC = sAccBO.GetBusComp(&quot;Account&quot;);
		var sContactBC = sAccBO.GetBusComp(&quot;Contact&quot;);
		var sIDScanBC = sAccBO.GetBusComp(&quot;VF ID Scan Session&quot;);
		var isRec = &quot;&quot;, isRecord = &quot;&quot;, iRecord = &quot;&quot;, sRecId = &quot;&quot;, sPrConId = &quot;&quot;;
		with(sAccBC)
 		{		
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Primary Contact Id&quot;);
			ActivateField(&quot;VF Primary Scan Session Id&quot;);				
			SetSearchSpec(&quot;Id&quot;,sCustId);
			ExecuteQuery(ForwardOnly);			
			isRec = FirstRecord();
			if(isRec)
			{
				sPrConId = GetFieldValue(&quot;Primary Contact Id&quot;);
				if(sPrConId != &quot;&quot; &amp;&amp; sPrConId != null)
				{			
					with(sContactBC)
					{		
						ClearToQuery();
						SetViewMode(AllView);					
						SetSearchSpec(&quot;Id&quot;,sPrConId);
						ExecuteQuery(ForwardOnly);			
						isRecord = FirstRecord();
						if(isRecord)	
						{
							with(sIDScanBC)
							{		
								ClearToQuery();
								SetViewMode(AllView);
								ActivateField(&quot;Primary Contact Id&quot;);					
								SetSearchSpec(&quot;Primary Contact Id&quot;,sPrConId);
								SetSortSpec(&quot;Created(DESCENDING)&quot;);
								ExecuteQuery(ForwardOnly);			
								iRecord = FirstRecord();
								if(iRecord)	
								{
									sRecId = GetFieldValue(&quot;Id&quot;);
									sAccBC.SetFieldValue(&quot;VF Primary Scan Session Id&quot;, sRecId);
									sAccBC.WriteRecord();
									Outputs.SetProperty(&quot;ScanId&quot;, sRecId);									  
								}//if(iRecord)
							}//with(sIDScanBC)			  
						}//if(isRecord)
					}//with(sContactBC)						
				}//if(sPrConId != &quot;&quot;)
			}//if(isRec)
		}//with(sAccBC)
        	
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{		
		sIDScanBC = null;
		sContactBC = null;
		sAccBC = null;
		sAccBO = null;			
	}

}

"
			   SEQUENCE="3"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="04/01/2025 17:55:58"
			   CREATED_BY="SADMIN">
