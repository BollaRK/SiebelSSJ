			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mResetCampCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mResetCampCode
 * Component Information : 	This function will Reset campaign code
 * ============ ===========	===========	================================
 * 12/7/2013	SIBIC		Moved code to a seprate function as the script limit had reached
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function mResetCampCode()
{
 try
 {
	 	// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:VF Com Financial Profile.mResetCampCode:&quot;); 
		}			
		
		var sCJCampCodeRestricted;
		this.ActivateField(&quot;VF CJ Campaign Code Read Only Flg&quot;);
		sCJCampCodeRestricted = this.GetFieldValue(&quot;VF CJ Campaign Code Read Only Flg&quot;);
		
		if (sCJCampCodeRestricted!= &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;VF Campaign Code UI&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;VF Campaign Code&quot;, &quot;&quot;);
			this.WriteRecord(); 
		}
	
				
 }
 
 catch (e)
 {
		if (defined(e.errText))
		{
			var sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var sErrorMessage = e.toString(); 
		}
		
		throw(sErrorMessage);	
 }
 
 finally
 {
	
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: VF Com Financial Profile.mResetCampCode:&quot;);
		}
 }
}"
			   SEQUENCE="13"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mScanCheckBeforeCreditCheck"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mScanCheckBeforeCreditCheck()
{
/*
 * Component Name        : 	VF Com Financial Profile - Credit Check Applet
 * Method Name           : 	mScanCheckBeforeCreditCheck
 * Component Information : 	This function checks wheather the scan has been done for the ID or not,if not shows the error message.
 *
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========	================================
 * 15/06/2011	VIJAY		Paperless Project			Initial Version
 * 19/07/2011   XA			TD6711			This code is copied from Applet level to this BC &amp; added refined logic
 */
	try
	{
		// Trace Stmt
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:BC - VF Com Financial Profile.mLaunchScanner()&quot;);
		}
			var  dtCreditChkReqDate,vParentAccountId,bIsDealerEligible,boConShowCase,bcIDScanSession;
			var strUploadedSuccessfully,dtUploadedDate,strScanBypassReason,oUploadedDate,vUploadedDateInms,vTimeInms;
			var vScanLmitTime,dtScanCreatedDate,oCreditChkReqDate,vCreditChkReqDateInms,oScanCreatedDate,vdtScanCreatedDateInms,val,iVal;
			var oCreatedDate;
			var vCreatedDateInms;
			var strCurrentSubmitCheckDate;
			var strCurrentSubmitCheckDateInms;
			var strPrimaryScanRecord;
			var Inputs = TheApplication().NewPropertySet();
			var Out = TheApplication().NewPropertySet();
			
			bIsDealerEligible=TheApplication().GetProfileAttr(&quot;IsDealerEnableForIdScan&quot;);
			
			if(bIsDealerEligible==&quot;TRUE&quot;) {
				mUpdateAccountScanEnabled(&quot;Y&quot;);
			} else {
				mUpdateAccountScanEnabled(&quot;N&quot;);
			}
			
			if(bIsDealerEligible==&quot;TRUE&quot;)
			 {
				//dtCreditChkReqDate=this.GetFieldValue(&quot;VF Credit Check Requested Date&quot;);
				strCurrentSubmitCheckDate = this.GetFieldValue(&quot;VF Submit CC Initiated Date Time Calc&quot;);
				oCreditChkReqDate=new Date(strCurrentSubmitCheckDate);
				vCreditChkReqDateInms=oCreditChkReqDate.getTime();
				
				vParentAccountId = this.ParentBusComp().GetFieldValue(&quot;Id&quot;);
				if (vParentAccountId != null &amp;&amp; vParentAccountId != &quot;&quot;)
				{					
					Inputs.SetProperty(&quot;CustId&quot;, vParentAccountId)
					fnUpdateIDScanSession(Inputs, Out);
				}
				//strPrimaryScanRecord = this.ParentBusComp().GetFieldValue(&quot;VF Primary Scan Session Id&quot;);
				strPrimaryScanRecord = Out.GetProperty(&quot;ScanId&quot;);

				//VF RT 27-07-2011: Added as part of the Performance Analysis.
				if(strPrimaryScanRecord == &quot;&quot; || strPrimaryScanRecord == null)
				{
					throw(&quot;Your store is enabled for ID scanning and you have not scanned the customer’s ID documents.  Please create a new ID scanning session.&quot;);  
				}
								
				boConShowCase = TheApplication().GetBusObject(&quot;VF Connection Showcase&quot;);
				bcIDScanSession = boConShowCase.GetBusComp(&quot;VF ID Scan Session&quot;);
				
					with(bcIDScanSession)
				     {
						ClearToQuery();
						ActivateField(&quot;Uploaded Date&quot;);
						ActivateField(&quot;ID Scan Bypass Reason Code&quot;);
						SetSearchSpec(&quot;Id&quot;,strPrimaryScanRecord);
						//SetSearchSpec(&quot;Customer Account Id&quot;,vParentAccountId);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
					  		dtUploadedDate	= GetFieldValue(&quot;Uploaded Date&quot;);
							strScanBypassReason	=GetFieldValue(&quot;ID Scan Bypass Reason Code&quot;);
							dtScanCreatedDate=GetFieldValue(&quot;Created&quot;);
							
							val=TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;PP_ID_SCAN_DURATION&quot;,&quot;IDScanDurationLimit&quot;);
					 		iVal=ToInteger(val);
					 		vTimeInms=iVal*60*60*1000;
							
							if (dtUploadedDate!=&quot;&quot;)
							{
							 	oUploadedDate=new Date(dtUploadedDate);
								vUploadedDateInms=oUploadedDate.getTime();
								vScanLmitTime=vCreditChkReqDateInms-vUploadedDateInms;
								
					 			if(vScanLmitTime&gt;vTimeInms)
									throw(&quot;Your store is enabled for ID scanning and you have not scanned a recent copy of the customer’s ID document(s) since the previous credit check.  Please create a new ID scanning session.&quot;); 
							 }
							 else
							 {
							 	if(strScanBypassReason != &quot;&quot;)
							 	{
							 		oCreatedDate=new Date(dtScanCreatedDate);
									vCreatedDateInms=oCreatedDate.getTime();
									vScanLmitTime=vCreditChkReqDateInms-vCreatedDateInms;
							 	
							 		if(vScanLmitTime&gt;vTimeInms)
										throw(&quot;Your store is enabled for ID scanning and you have not scanned a recent copy of the customer’s ID document(s) since the previous credit check.  Please create a new ID scanning session.&quot;); 
							 	}
							 	else
							 	{
							 			throw(&quot;You have bypassed the last ID Scanning. Please select a valid ID scanning Bypass Reason code.&quot;); 
							 	}
							 }
						} 
						else
						{
							throw(&quot;Your store is enabled for ID scanning and you have not scanned the customer’s ID documents.  Please create a new ID scanning session.&quot;);  // CUZZILLAR, 13/07/2011, Stop Credit Check if there are no Scan Sessions
						}
				     }//with
				
				}//IsDealerEligible
	
	}//try
	catch(e)
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			TheApplication().Trace(&quot;ERROR:BC-VF Com Financial Profile.mScanCheckBeforeCreditCheck().Err=&quot; + e.errText);
		
		throw (e);
	}
	finally
	{
			bcIDScanSession = null;
			boConShowCase	= null;
			oUploadedDate	= null;
			oScanCreatedDate = null;
			oCreditChkReqDate = null;
			Inputs = null;
			Out = null;
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			TheApplication().Trace(&quot;END:BC-VF Com Financial Profile.mScanCheckBeforeCreditCheck()&quot;);
	}

}//mScanCheckBeforeCreditCheck"
			   SEQUENCE="14"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetCampCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetCampCode
 * Component Information : 	This function will Mask campaign code
 * ============ ===========	===========	================================
 * 14/8/2013	SIBIC		This code is moved as it existed in the Preinvoke method with minor changes for CJ
 *							Moved code to a seprate function as the script limit had reached
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function mSetCampCode()
{
 try
 {
 		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:VF Com Financial Profile.mSetCampCode:&quot;); 
		}	
		
		//VF DO 7/4/10 - 10.3 Credit Approval.
		var sUICampaignCode = this.GetFieldValue(&quot;VF Campaign Code UI&quot;);
		var aField = new Array(); // MADHUR::25-MAY-23::Added for CPVT-648
		var sCampCode = new Array();// MADHUR::25-MAY-23::Added for CPVT-648 
    	aField = sUICampaignCode.split(&quot;,&quot;);// MADHUR::25-MAY-23::Added for CPVT-648
		var sMaskValue = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CC_CAMPAIGN_CD&quot;,&quot;MASK&quot;);
	
		if((sUICampaignCode != &quot;&quot;) &amp;&amp; (sUICampaignCode != sMaskValue) )
		{
			//VF:KPOLURU:05/05/2010:Defect#5197: Set the lIC value to Campaign Code , this is the expected value by 
			//Decision Point, below code gets the LIC not the Value
		
			var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
			var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);			
			var bLOVRecord = &quot;&quot;;
			var sCampaignCode = &quot;&quot;;
			for( var i=0;i&lt;aField.length;i++)// MADHUR::25-MAY-23::Added forloop for CPVT-648 
	    	{
				//KARP 23/07/2010 Constructing a case insensitive search expression					
				var sType = &quot;VF_CC_CAMPAIGN_CD&quot;;
				var sActive = &quot;Y&quot;;
	
				// MADHUR::25-MAY-23::commented beolw searchspec for CPVT-648
				/*var sSearchExpr = &quot;[Type] = &apos;&quot; + sType + &quot;&apos;&quot;
						+ &quot; AND [Active] = &apos;&quot; + sActive + &quot;&apos;&quot;
						+ &quot;	AND [Value] ~LIKE &apos;&quot; + sUICampaignCode + &quot;*&apos;&quot;;*/
	
				// MADHUR::25-MAY-23::Added for CPVT-648
				var sSearchExpr = &quot;[Type] = &apos;&quot; + sType + &quot;&apos;&quot;
						+ &quot; AND [Active] = &apos;&quot; + sActive + &quot;&apos;&quot;
						+ &quot;	AND [Value] ~LIKE &apos;&quot; + aField[i] + &quot;*&apos;&quot;;
	
				with (bcLOV)
				{
					SetViewMode(AllView);
					ActivateField(&quot;Type&quot;);
					ActivateField(&quot;Active&quot;);
					ActivateField(&quot;Value&quot;);
					ActivateField(&quot;Name&quot;);
					ActivateField(&quot;VF Campaign Code&quot;);
					ClearToQuery();
					SetSearchExpr(sSearchExpr);
					ExecuteQuery();
					if(FirstRecord())
					{
						sCampCode[i] = GetFieldValue(&quot;Name&quot;); // MADHUR:25-MAY-23::Added for CPVT-648
						//this.SetFieldValue(&quot;VF Campaign Code&quot;, GetFieldValue(&quot;Name&quot;));// MADHUR::25-MAY-23::COMMENTED for CPVT-648
					}//if(FirstRecord())
				}//with (bcLOV)
			}//for
				this.SetFieldValue(&quot;VF Campaign Code&quot;, sCampCode);// MADHUR::25-MAY-23::Added for CPVT-648
		}//if((sUICampaignCode 
		this.WriteRecord();
			
 }//try
 
 catch (e)
 {
		if (defined(e.errText))
		{
			var sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var sErrorMessage = e.toString(); 
		}
		
		throw(sErrorMessage);	
 }//catch
 
 finally
 {
	
	/*Below variables are nullified by Sharukh on 01/04/2019*/
	//	bcLOV = null;
	//boLOV = null;
	/*Below variables are nullified by BALAMURUGAN on 24/10/2019*/
		if(defined(bcLOV)) { bcLOV = null; }
		if(defined(boLOV)) { boLOV = null; }


	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: VF Com Financial Profile.mSetCampCode:&quot;);
		}
 }//finally
}"
			   SEQUENCE="15"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
