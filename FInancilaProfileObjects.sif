			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateAccountScanEnabled"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	mUpdateAccountScanEnabled
 * Component Information : 	This function will Update the VF Is Scan Enabled on the Account BC for the user
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/08/2011	CUZZILLAR	7216		Set field for IO
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */
 
function mUpdateAccountScanEnabled(bIsScanEnabled)
{
	try
	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.mUpdateAccountScanEnabled:&quot;); 
		}
		
		// Declare variables
		var boAccount;
		var bcAccount;
		var bcParent = this.ParentBusComp();
		var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);

		boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
		bcAccount = boAccount.GetBusComp(&quot;Account&quot;);

		with (bcAccount)
		{
			//SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;VF Is Scan Enabled&quot;);
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardOnly);

			// If the Account is found then set
			if (FirstRecord())
			{
				// Set the Account Status and Save
				SetFieldValue(&quot;VF Is Scan Enabled&quot;, bIsScanEnabled);
				WriteRecord();
			}
		}
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		//VF JoseL-Added for def 8980.
		throw(strError);
	}
	finally
	{
		// Destroy Objects
		bcAccount = null;
		boAccount = null;
		bcParent = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.mUpdateAccountScanEnabled:&quot;);
		}
	}
}"
