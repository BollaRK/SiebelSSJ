			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAuditTrailDataAccess"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 18/06/2010	HR		Created for CA PCR08
*/

function mAuditTrailDataAccess()
{
	try 
	{ 	
		//Declare objects
		var boFPAL = TheApplication().GetBusObject(&quot;VF Financial Profile Access Log&quot;);
		var bcFPACL = boFPAL.GetBusComp(&quot;VF Financial Profile Access Log&quot;);
		var bcParent = this.ParentBusComp();
		var sCustomer_AccountId = bcParent.GetFieldValue(&quot;Id&quot;)
		TheApplication().SetProfileAttr(&quot;profFPDataAccess_Acc_Id&quot;, sCustomer_AccountId);
		
		with (bcFPACL)
	 	{			
			NewRecord(NewAfter);
			SetFieldValue(&quot;VF FP Customer Id&quot;, sCustomer_AccountId);
			SetFieldValue(&quot;VF Employee First Name&quot;, TheApplication().GetProfileAttr(&quot;sFirstName_Log&quot;));
			SetFieldValue(&quot;VF Employee Last Name&quot;, TheApplication().GetProfileAttr(&quot;sLastName_Log&quot;));
		//	SetFieldValue(&quot;VF Dealer&quot;, TheApplication().GetProfileAttr(&quot;sDealerCode_Log&quot;));
		//	SetFieldValue(&quot;VF Sales Channel&quot;, TheApplication().GetProfileAttr(&quot;sDealerBranch_Log&quot;));
		//	SetFieldValue(&quot;VF Sales Channel&quot;, TheApplication().GetProfileAttr(&quot;sDealerBranch_Log&quot;));
			SetFieldValue(&quot;VF Creator ID&quot;, TheApplication().LoginName());					
			WriteRecord();	
		}
		
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{
		//Destroy objects
		bcFPACL = null;
		boFPAL = null;		
	}
}"
