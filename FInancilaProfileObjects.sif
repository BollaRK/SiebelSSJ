			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCallCreditCheckProcessing"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Bulk Initiator
 * Method Name           : 	mCallCreditCheckProcessing
 * Component Information : 	This calls a business service which creates a component
 *							request (batch job) to process the credit check for the account.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 				RemkoZ					Initial Version
 * 15/7/05		SLV						Changed code so it only creates a
 *										component request, not an RCR as only
 *										1 record is to be processed.
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function mCallCreditCheckProcessing()
{
 try
 {
 	// Trace statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
	{ 
		TheApplication().Trace(&quot;START:Com Financial Profile.mCallCreditCheckProcessing:&quot;); 
	}
 	
 	// Declare variables
 	var bsCreditCheck;
 	var psInputs = TheApplication().NewPropertySet();
 	var psOutputs = TheApplication().NewPropertySet();
	var currentDate;
    var dateForm;
    var timeForm;

	var boAccount;
	var bcFinProf;
	var bcParent = this.ParentBusComp();
	var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);
 		
	bsCreditCheck = TheApplication().GetService(&quot;VF Credit Fraud Check Toolkit Service&quot;);
	psInputs.SetProperty(&quot;Customer Account Id&quot;, this.GetFieldValue(&quot;Account Id&quot;));

	try
	{
		//Call method which creates a component request to process the credit check
		bsCreditCheck.InvokeMethod(&quot;Create ASR&quot;, psInputs, psOutputs);
	}
	catch (e)
	{
		throw (e);
	}

/*
	boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
	bcFinProf = boAccount.GetBusComp(&quot;Com Financial Profile&quot;);

	with (bcFinProf)
 	{
		SetViewMode(AllView);
		ActivateField(&quot;VF Credit Check Requested Date&quot;);
		ClearToQuery();
		SetSearchSpec(&quot;Account Id&quot;, sAccountId);
		ExecuteQuery();
			
		if (FirstRecord())
		{
			//Retrieves the current system date/time
			currentDate = new Date();
			dateForm = (currentDate.getMonth() + 1) + &quot;/&quot; + currentDate.getDate() + &quot;/&quot; + currentDate.getFullYear();
			timeForm = dateForm + &quot; &quot; + currentDate.getHours() + &quot;:&quot; + currentDate.getMinutes() + &quot;:&quot; + currentDate.getSeconds();

			//Update the status and the datetime the request was submitted.
			SetFieldValue(&quot;VF Credit Check Requested Date&quot;, timeForm);
			SetFieldValue(&quot;VF Credit Check Status&quot;, &quot;Pending&quot;);
			WriteRecord();
		}
	} 	
	mRefreshScreen(sAccountId);
*/
 }
 
 catch (e)
 {
	if (defined(e.errText))
	{
		var sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
	}
	else
	{
		var sErrorMessage = e.toString(); 
	}
	
	throw(sErrorMessage);	
 }
 
 finally
 {
	// destroy objects
	psOutputs = null;
	psInputs = null;
	bsCreditCheck = null;
	boAccount = null;
	bcFinProf = null;
	
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.mCallCreditCheckProcessing:&quot;);
		}
 }
}"
			   SEQUENCE="5"
