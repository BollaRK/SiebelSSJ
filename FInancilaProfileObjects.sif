			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateCreditDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	mUpdateCreditDetails
 * Component Information : 	This function will Update the other Financial Profile fields
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 2/09/2005	CY			5919		Update other credit fields must be executed after WriteRecord
 * 15/09/2005	CY			6577		Set the Approved Connections using global variables
 * 13/10/2005	CY			7404		Remove all actions upon a DECLINE
 * 10/11/2007	CY			6127		Set Approved with Live value
 * 27/11/2008	JoseL		8980		Added throw statement in Catch block.
 * 20/04/2010   KARP        Credit Approval After Credit Approval project DP will send the Approved Connections.
 *									Siebel will not calculate it.
 * 21/05/2010   Kpoluru	   TD#5291      Update &quot;Direct Payment Method&quot; and &quot;outRight Purchase Flag&quot; to blank when status is APPROVE
 * 02/09/2011   DFiiggis    R11D         Made 30 day credit check expiry a sys pref
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */

function mUpdateCreditDetails()
{
	try
	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.mUpdateCreditDetails:&quot;); 
		}
	
		// Declare Variables
		var iApprovedConnections;
		var ExpiryDate;
		var dateForm; 
		var timeForm;
		var Status1 = &quot;APPROVED&quot;;
		var Status2 = &quot;APPROVE&quot;;
		var Status3 = &quot;CONDAPPRVE&quot;;
		var Status4 = &quot;ACCEPT&quot;;
		var Status5 = &quot;WITHDRAW&quot;;
		var Status6 = &quot;DECLINE&quot;;
		var iCurrentApprovedConnections = this.GetFieldValue(&quot;VF Approved Connections&quot;);
		
	//	var sNewValue = this.GetFieldValue(&quot;VF Credit Check Status&quot;);  // VF 25/05/10 XA : to fix defect# 5317
		var sLiveCon = this.GetFieldValue(&quot;VF Live Connections&quot;);
		var sReqCon = this.GetFieldValue(&quot;VF Requested Connections&quot;);

		//Activate the fields to be used later
		//SLV 3/7/06 - Commented this out as requested by Siebel code review
		//this.ActivateField(&quot;VF Credit Check Status Modified Date&quot;);
		//this.ActivateField(&quot;VF Credit Check Expiry Date&quot;);
		//this.ActivateField(&quot;VF Approved Connections&quot;);
		//this.ActivateField(&quot;VF Requested Connections&quot;);

		// There are 4 acceptable status values
		if (sNewValue == Status1 || sNewValue == Status2 ||
			sNewValue == Status3 || sNewValue == Status4 )
		{   
					/*************************************************************************
			     	* Get the requested connections field and using this set the new
				 	* value for the approved connections field. Approved is set to existing 
				 	* approved number plus those that have just been approved.
				 	*************************************************************************/

					// Sets up the Expiry date of 30 days from when the credit check was approved.
					// Start - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
					this.ActivateField(&quot;VF Credit Class&quot;);
					var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
					var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;, sCreditClass);
					
					//R11D 3/9/2011 DFIGGIS Get the credit check increment sys pref
					if((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap))
					{
						var strExpiryIncDays = mGetSysPref(&quot;VF HC CC Expiry Window - Days&quot;);
					}
					else
					{
						var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;);
					}
					// End - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.					
					ExpiryDate = new Date();
    				//ExpiryDate.setDate(ExpiryDate.getDate()+1*30);
    				ExpiryDate.setDate(ExpiryDate.getDate()+1 * strExpiryIncDays);    				
    				dateForm = (ExpiryDate.getMonth() + 1) + &quot;/&quot; + (ExpiryDate.getDate()) + &quot;/&quot; + ExpiryDate.getFullYear();
    				timeForm = dateForm + &quot; &quot; + ExpiryDate.getHours() + &quot;:&quot; + ExpiryDate.getMinutes() + &quot;:&quot; + ExpiryDate.getSeconds();

					// Set the Approved Connections value from the global variables
					//iApprovedConnections = ToNumber(sReqCon) + ToNumber(sApprCon);
					iApprovedConnections = ToNumber(sReqCon) + ToNumber(sLiveCon);

					//Sets the fields that are updated once a credit check is approved.
					if((TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;RestrictCCUpdate&quot;)) != &quot;Y&quot;)  //Veera: 05/17/2019: MR2: Added for MR1 Fallout
					{
						if((this.GetFieldValue(&quot;VHA Expiry Date Calc&quot;)) != &quot;Y&quot;)
						{
							this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
							this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//smart block PKE changes
						}
					}
					else
					{
						this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
						this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//smart block PKE changes
					}
					//KARP 20/04/2010 After Credit Approval project DP will send the Approved Connections.
					//Siebel will not calculate it.
					if (iCurrentApprovedConnections == &quot;&quot;)
					{
						this.SetFieldValue(&quot;VF Approved Connections&quot;, ToNumber(iApprovedConnections));
					}
					//KARP 23/04/2010 Credit Approval Requested Connections will not be made zero.
					//THis will be made zero only when the Reset button is clicked.
					//this.SetFieldValue(&quot;VF Requested Connections&quot;, ToNumber(0));
		}
							
		//If the credit check is being withdrawn...
		if (sNewValue == Status5)
		{   
					//Sets the fields that are updated once a credit check is withdrawn
					if((TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;RestrictCCUpdate&quot;)) != &quot;Y&quot;)  //Veera: 05/17/2019: MR2: Added for MR1 Fallout
					{
						if((this.GetFieldValue(&quot;VHA Expiry Date Calc&quot;)) != &quot;Y&quot;)
						{
							this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, &quot;&quot;);
						}
					}
					else
					{
						this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, &quot;&quot;);
					}
					this.SetFieldValue(&quot;VF Credit Class&quot;, &quot;&quot;);
					//KARP 23/04/2010 Credit Approval
					this.SetFieldValue(&quot;VF Conditional Approval Accepted&quot;, &quot;&quot;);
					//this.SetFieldValue(&quot;VF Approved Connections&quot;, ToNumber(0));
					
		} 	

		/* Defect #7404
		//If the credit check is being declined...
		if (sNewValue == Status6)
		{   
					//Sets the fields that are updated once a credit check is declined
					this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, &quot;&quot;);
					this.SetFieldValue(&quot;VF Requested Connections&quot;, ToNumber(0));	
					this.SetFieldValue(&quot;VF Approved Connections&quot;, ToNumber(0));
		} 
		*/
		
		// 21/05/2010: Kpoluru:TD#5291:Update &quot;Direct Payment Method&quot; and &quot;outRight Purchase Flag&quot; to blank when status is APPROVE
		if (sNewValue == Status2)
		{
			this.SetFieldValue(&quot;VF Direct Payment Method&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;VF Purchase Handset Outright Flag&quot;, &quot;&quot;);
		}
		this.WriteRecord();

	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		//VF JoseL-Added for def 8980.
		throw(strError);
	}

	finally
	{
		// Destroy Objects
		// Nothing to destroy
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.mUpdateCreditDetails:&quot;);
		}
	}
}"
			   SEQUENCE="24"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateExistingPostpay"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	mUpdateExistingPostpay
 * Component Information : 	This function will Update the Existing Postpay Flag automatically
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	==================================================
 * 12/05/2006	CY						Initial Version
 * 20/06/2006	CY						Move the SetField for Status and Request Date here
 * 27/11/2008	JoseL		8980		Added throw statement in Catch block.
 * 04/05/2011	SangeethaS	R11.C		Added logic to set VF Customer Flag for Butterfly migrated Customers 
 *										once the migrated order is created in siebel
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
**/
 
function mUpdateExistingPostpay()
{
	try
	{
		// Declare variables
		var boAccount;
		var bcBilling;
		var bcParent = this.ParentBusComp();
		var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);
		var sExists = &quot;N&quot;;
		var sRowId;
		var sBillStat;
		var currentDate;
    	var dateForm;
   		var timeForm;
		
		//SS added for CR-2nd service offer on 04May2011
   		var sLiveCon = this.GetFieldValue(&quot;VF Live Connections&quot;);
   		var sChannel;
   		var bcOrder;
   		// end of variable declaration by SS
   		
   		
		// If Parent business component is Account, search for Billing Accounts
		if ((bcParent != null) &amp;&amp; (bcParent.Name() == &quot;Account&quot;))
		{
			boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
			bcBilling = boAccount.GetBusComp(&quot;VF Billing Account&quot;);
			
			//SS added for CR 2nd service offer Release 11.C
			bcOrder = boAccount.GetBusComp(&quot;Order Entry - Orders&quot;);
			
			this.ActivateField(&quot;VF Existing Customer Flag&quot;);
			bcParent.ActivateField(&quot;VF Channel&quot;);
			sChannel = bcParent.GetFieldValue(&quot;VF Channel&quot;);
			with (bcOrder)
				{
					ActivateField(&quot;Order Sub Type&quot;);
					ActivateField(&quot;VF Order Channel&quot;);
					ActivateField(&quot;Status&quot;);
					ActivateField(&quot;Account Id&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchExpr(&quot;[Account Id] = &apos;&quot;+sAccountId+&quot;&apos; AND [Order Sub Type] = &apos;Connect&apos; AND [VF Order Channel] = &apos;3MIG&apos; AND ([Status] = &apos;Pending&apos; OR [Status] = &apos;Submitted&apos; OR [Status] = &apos;On Hold&apos; OR [Status] = &apos;Transfer Pending&apos; OR [Status] = &apos;Failed&apos;)&quot;);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
							sExists = &quot;Y&quot;;
		
					}

				}
			//end of changes for 2nd service offer
			//SS added else condition to the existing code for 2nd service offer	
			
			with (bcBilling)
			{
				ClearToQuery();
				ActivateField(&quot;Account Status&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Master Account Id&quot;, sAccountId);
				SetSearchSpec(&quot;Account Type Code&quot;, &quot;Billing&quot;);
				SetSearchSpec(&quot;Payment Method Calc&quot;, &quot;Postpay&quot;);
				ExecuteQuery(ForwardOnly);

				// Loop through each Billing Account and check the Status
				if (FirstRecord() == true)
				{
					do
					{
						sRowId = GetFieldValue(&quot;Id&quot;);
						sBillStat = GetFieldValue(&quot;Account Status&quot;);
						if ((sBillStat == &quot;Active&quot;) || (sBillStat == &quot;Overdue&quot;))
						{
							sExists = &quot;Y&quot;;
						}
					} while (NextRecord() == true)
				}				
			}
		}// end of parent bc! = null
		// Set the Existing Postpay Customer Flag and Save Record
		this.ActivateField(&quot;VF Existing Customer Flag&quot;);
		this.SetFieldValue(&quot;VF Existing Customer Flag&quot;, sExists);

		//Retrieves the current system date/time
		currentDate = new Date();
		dateForm = (currentDate.getMonth() + 1) + &quot;/&quot; + currentDate.getDate() + &quot;/&quot; + currentDate.getFullYear();
		timeForm = dateForm + &quot; &quot; + currentDate.getHours() + &quot;:&quot; + currentDate.getMinutes() + &quot;:&quot; + currentDate.getSeconds();

		//Update the status and the datetime the request was submitted.
		this.SetFieldValue(&quot;VF Credit Check Requested Date&quot;, timeForm);
		this.SetFieldValue(&quot;VF Credit Check Status&quot;, &quot;Pending&quot;);
		this.WriteRecord();

	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		//VF JoseL-Added for def 8980.
		throw(strError);
   }
	finally
	{
		// Destroy Objects
		bcOrder = null;  /* This variable is nullified by Sharukh on 01/04/2019*/
		
		bcBilling = null;
		bcParent = null;
		boAccount = null;

	}
}"
			   SEQUENCE="25"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCampaignCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCampaignCode(FieldName, FieldValue)
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 23/03/2010	DO		Check the campaign code enters matches those stored as
 *						LOVs. Raise error if there&apos;s no match.
*/
{
	try 
	{ 	
		//Declare objects
		var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
		
		//Declare variables
		var sLOVType = &quot;VF_CC_CAMPAIGN_CD&quot;;
		var sFieldValLower = FieldValue.toLowerCase();
		var bLOVRecord = &quot;&quot;;
		var sLOV = &quot;&quot;;
		var sLOVLower = &quot;&quot;;
		var aField = new Array(); // MADHUR::13-APR-23::Added for CPVT-648 Starts
    	aField = sFieldValLower.split(&quot;,&quot;);
	    for( var i=0;i&lt;aField.length;i++)// MADHUR::13-APR-23::Added forloop for CPVT-648 
	    {
			var sCodeStatus = &quot;INVALID&quot;;// MADHUR::13-APR-23::moved into forloop for CPVT-648
			with (bcLOV)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;Active&quot;);
				ActivateField(&quot;Value&quot;);
				SetSearchSpec(&quot;Type&quot;, sLOVType); 
				SetSearchSpec(&quot;Active&quot;, &quot;Y&quot;);
				ExecuteQuery();
				bLOVRecord = bcLOV.FirstRecord();
				while (bLOVRecord)
				{
					sLOV = bcLOV.GetFieldValue(&quot;Value&quot;);
					sLOVLower = sLOV.toLowerCase();
					
					if (sLOVLower == aField[i])
					{
						sCodeStatus = &quot;VALID&quot;;
						break;
					}
					bLOVRecord = bcLOV.NextRecord();
				}
				
				
         	}//with (bcLOV)
			//MADHUR::13-APR-23::added if cond for CPVT-648
			if(sCodeStatus == &quot;INVALID&quot;)
			{
				break;
			}//end if MADHUR::13-APR-23::added if cond for CPVT-648	
	    }//for( var i=0;i&lt;aField.length;i++) // MADHUR::13-APR-23::Added for CPVT-648 Ends
		
		
		return sCodeStatus;
	} //try
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}//catch
	finally 
	{
		//Destroy objects
		bcLOV = null;
		boLOV = null;
	}//finally
}//function"
			   SEQUENCE="26"
			   UPDATED="04/01/2025 17:55:57"
