			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateAccountStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Financial Profile
 * Method Name           : 	mUpdateAccountStatus
 * Component Information : 	This function will Update the Customer Account Status
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/05/2005	CY						Initial Version
 * 27/07/2005	RNZ						Moved script to BC
 * 26/08/2005	CY			#5919		Use bcParent = Account instead of SearchSpec
 * 27/11/2008	JoseL		8980		Added throw statement in Catch block.
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
 
function mUpdateAccountStatus(AccountId, FieldValue)
{
	try
	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Financial Profile.mUpdateAccountStatus:&quot;); 
		}
		
		// Declare variables
		var boLOV;
		var bcLOV;
		var LOVType;
		var boAccount;
		var bcAccount;
		var sAccountStatus;
		var sNewStatus;
		var bcParent = this.ParentBusComp();
		var sAccountId = bcParent.GetFieldValue(&quot;Id&quot;);

		boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
		bcAccount = boAccount.GetBusComp(&quot;Account&quot;);

		with (bcAccount)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Account Status&quot;);
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardOnly);

			// If the Account is found then get the Status
			if (FirstRecord())
			{
				// Check if Status is not already Active
				sAccountStatus = GetFieldValue(&quot;Account Status&quot;);
				if (sAccountStatus != &apos;Active&apos;)
				{
					// Retrieve corresponding Account status values 
					// as listed under High on the credit check status LOV
					boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
					bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
					LOVType = &quot;VF_CREDIT_CHECK_STATUS&quot;;
				
					with (bcLOV)
					{
						ClearToQuery();
						SetViewMode(AllView);
						ActivateField(&quot;High&quot;);
						SetSearchSpec(&quot;Type&quot;, LOVType);
						SetSearchSpec(&quot;Name&quot;, &quot;\&quot;&quot;+sNewValue+&quot;\&quot;&quot;);
						ExecuteQuery(ForwardOnly);
				
						if (FirstRecord())
						{	
							sNewStatus = GetFieldValue(&quot;High&quot;);		
						}
						else
						{
							throw (&quot;VFErrorCode#&quot; + &quot;99017&quot;
							+ &quot; - The Value (&quot; + sNewValue + &quot;)&quot;
							+ &quot; can not be found in LOV VF_CREDIT_CHECK_STATUS&quot;);
						}
					}
					// Set the Account Status and Save
					SetFieldValue(&quot;Account Status&quot;, sNewStatus);
					WriteRecord();
				}
			}
		}
		mRefreshScreen(sAccountId);
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		//VF JoseL-Added for def 8980.
		throw(strError);
	}
	finally
	{
		// Destroy Objects
		//JoseL-Rearranged the order Def 8980
		bcLOV = null;
		boLOV = null;
		bcAccount = null;
		boAccount = null;
		bcParent = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: Com Financial Profile.mUpdateAccountStatus:&quot;);
		}
	}
}"
