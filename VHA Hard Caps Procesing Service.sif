			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCreditCheckValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCreditCheckValidation(Inputs,Outputs)
{
/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	fnCreditCheckValidation
 * Component Information : 	This function takes a date and adds a specified number of months 
 *							and throw validation message on submit credit check button
 * Inputs				 : CreditChkDate, CreditClass
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 06/07/2018	RINU					Initial Version
 */
 
try{
	var sCreditChkDate = Inputs.GetProperty(&quot;CreditChkDate&quot;);	
	var sCreditClass = Inputs.GetProperty(&quot;CreditClass&quot;);
	var dtoday = new Date;
	var dmonth = dtoday.getMonth ()+1;
	//var sCreditClassX1 = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_CLASS&quot;,&quot;X1&quot;);
	//var sCreditClassX2 = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_CLASS&quot;,&quot;X2&quot;);
	var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;,sCreditClass);
	
	if((sCreditChkDate != &quot;&quot; &amp;&amp; sCreditChkDate != null) &amp;&amp; ((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap)))
	{
		// Array holding the last day for each month
		var aLastDays = new Array(31,28,31,30,31,30,31,31,30,31,30,31)
	
		// Calculation Variables
		var iInDays;
		var iOutDays;
		var iInMonths;
		var iOutMonths;
		var iMonthCarryOver;
		var iInYears;
		var iOutYears;
		var iNumYearsToAdd;
		var dOutDate;
		var iMonthReference;
		var iMonthsToAdd = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_CHECK_MONTHS&quot;,sCreditClass);
		sCreditChkDate = new Date(sCreditChkDate); 

		iInYears = sCreditChkDate.getFullYear();
		iInMonths = sCreditChkDate.getMonth() + 1 ;
		iInDays = sCreditChkDate.getDate();
		iInDays = iInDays + 1;
		
		// Find the last day of the month in which the &quot;Out Date&quot; falls.
		iMonthReference = (iInMonths + ToNumber(iMonthsToAdd));
		iMonthReference = (iMonthReference % 12);
		if (iMonthReference == 0)
			{
				iMonthReference = 12
			}
		
		
		if (iInDays &lt;= aLastDays[iMonthReference - 1] )
		{
			iOutDays = iInDays;
			iMonthCarryOver = 0;
		}
		else
		{
			iOutDays = 1;
			iMonthCarryOver = 1;
		}
	
		// Calculate the value for the end date month
		iOutMonths = ((iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd)) % 12);
		if (iOutMonths == 0)	{iOutMonths = 12};
		iOutMonths = iOutMonths - 1;
	
		//Calculate the value for the end date year
		if ((( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) % 12) != 0)
		{
			iNumYearsToAdd = ToInteger( ( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) / 12 );
		}
		else
		{
			iNumYearsToAdd = (ToInteger( ( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) / 12 ) - 1);
		}
		iOutYears = iInYears + iNumYearsToAdd;
		
		// Create a new date value based on the above calculations
		dOutDate = new Date (iOutYears, iOutMonths, iOutDays);
		
		var sFormattedDate = dOutDate.getDate() + &quot;/&quot; + (dOutDate.getMonth() + 1) + &quot;/&quot; + dOutDate.getFullYear();
		
		
	//Throw validation if the dOutDate is less than today	
	if(dOutDate &gt;= dtoday)
		{
			sCreditCheckFlg = &quot;DISABLE&quot;;
			if(TheApplication().ActiveViewName() == &quot;VF Connection Wizard View - Credit Check – TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Com Account Financial Profile View&quot; || TheApplication().ActiveViewName() == &quot;VF Com Account Financial Profile - Edit View&quot;)
			{
		    	TheApplication().RaiseErrorText(&quot;Credit Check may not be submitted until &quot; + sFormattedDate + &quot; due to the customer being of credit class &quot; + sCreditClass);
		    }
		}
		else
			sCreditCheckFlg = &quot;ENABLE&quot;;

}
}//try
catch (e){
	
	throw(e);
	
}finally{
		aLastDays = null;
		iInDays = null;
		iOutDays = null;
		iInMonths = null;
		iOutMonths = null;
		iMonthCarryOver = null;
		iInYears = null;
		iOutYears = null;
		iNumYearsToAdd = null;
		dOutDate = null;
		iMonthReference = null;
		iInYears = null;
		iInMonths = null;
		iInDays = null;
}   
}"
			   SEQUENCE="3"
			   UPDATED="05/20/2019 23:31:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCreditCheckValidation_UI"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCreditCheckValidation_UI(Inputs,Outputs)
{
	/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	fnCreditCheckValidation_UI
 * Component Information : 	This function takes a date and adds a specified number of months 
 *							and show the next eligible date to re-submit credit check in UI
 * Inputs				 : CreditChkDate, CreditClass
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/08/2018	Sachi					Initial Version
 */
 
try{
	var sCreditChkDate = Inputs.GetProperty(&quot;CreditChkDate&quot;);	
	var sCreditClass = Inputs.GetProperty(&quot;CreditClass&quot;);
	var dtoday = new Date;
	var dmonth = dtoday.getMonth ()+1;
	var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;,sCreditClass);
	
	if((sCreditChkDate != &quot;&quot; &amp;&amp; sCreditChkDate != null) &amp;&amp; ((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap)))
	{
		// Array holding the last day for each month
		var aLastDays = new Array(31,28,31,30,31,30,31,31,30,31,30,31)
	
		// Calculation Variables
		var iInDays;
		var iOutDays;
		var iInMonths;
		var iOutMonths;
		var iMonthCarryOver;
		var iInYears;
		var iOutYears;
		var iNumYearsToAdd;
		var dOutDate;
		var iMonthReference;
		var iMonthsToAdd = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_CHECK_MONTHS&quot;,sCreditClass);
		sCreditChkDate = new Date(sCreditChkDate); 

		iInYears = sCreditChkDate.getFullYear();
		iInMonths = sCreditChkDate.getMonth() + 1 ;
		iInDays = sCreditChkDate.getDate();
		iInDays = iInDays + 1;
		
		// Find the last day of the month in which the &quot;Out Date&quot; falls.
		iMonthReference = (iInMonths + ToNumber(iMonthsToAdd));
		iMonthReference = (iMonthReference % 12);
		if (iMonthReference == 0)
			{
				iMonthReference = 12
			}
		
		
		if (iInDays &lt;= aLastDays[iMonthReference - 1] )
		{
			iOutDays = iInDays;
			iMonthCarryOver = 0;
		}
		else
		{
			iOutDays = 1;
			iMonthCarryOver = 1;
		}
	
		// Calculate the value for the end date month
		iOutMonths = ((iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd)) % 12);
		if (iOutMonths == 0)	{iOutMonths = 12};
		iOutMonths = iOutMonths - 1;
	
		//Calculate the value for the end date year
		if ((( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) % 12) != 0)
		{
			iNumYearsToAdd = ToInteger( ( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) / 12 );
		}
		else
		{
			iNumYearsToAdd = (ToInteger( ( iInMonths + iMonthCarryOver + ToNumber(iMonthsToAdd) ) / 12 ) - 1);
		}
		iOutYears = iInYears + iNumYearsToAdd;
		
		// Create a new date value based on the above calculations
		dOutDate = new Date (iOutYears, iOutMonths, iOutDays);
		
		var sFormattedDate = (dOutDate.getMonth() + 1) + &quot;/&quot; + dOutDate.getDate()  + &quot;/&quot; + dOutDate.getFullYear();
		var sFormattedDateMOD = dOutDate.getDate() + &quot;/&quot; + (dOutDate.getMonth() + 1) + &quot;/&quot; + dOutDate.getFullYear();
		Outputs.SetProperty(&quot;FormattedDate&quot;,sFormattedDate);
		if(dOutDate &gt;= dtoday)
		{
			Outputs.SetProperty(&quot;FormattedDateMod&quot;,sFormattedDateMOD);
		}
}
}//try
catch (e){
	
	throw(e);
	
}finally{
		aLastDays = null;
		iInDays = null;
		iOutDays = null;
		iInMonths = null;
		iOutMonths = null;
		iMonthCarryOver = null;
		iInYears = null;
		iOutYears = null;
		iNumYearsToAdd = null;
		dOutDate = null;
		iMonthReference = null;
		iInYears = null;
		iInMonths = null;
		iInDays = null;
} 
}"
