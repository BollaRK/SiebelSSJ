			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetCurrentStatusForIDD"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetCurrentStatusForIDD(Inputs,Outputs)
{
    /*
     * Component Name        : 	VHA Hard Caps Procesing Service
     * Method Name/Fn         : mGetCurrentStatusForIDD	
     * Component Information : 	To Check IDD Product Present in Asset Level or Not.
     * Modification History  :
     * Date			Author		Config #			Description
     * ============ ===========	===========			================================
     *  17-08-2018  Vinodhini   Hardcaps
     */
    try {

        //Object Declarations
        var oAssetBo = TheApplication().GetBusObject(&quot;VF Asset&quot;);
        var oAssetComponent = oAssetBo.GetBusComp(&quot;VHA Asset Mgmt - Asset (Order Mgmt)&quot;);
       
        var sIDDExists = &quot;N&quot;;
		var sIDD = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;IDD&quot;);
		var sAssetId = Inputs.GetProperty(&quot;Asset Id&quot;);

       var strSearchExpr = &quot;[Root Asset Id] = &apos;&quot; + sAssetId + &quot;&apos; AND &quot; + &quot; [Status] = &apos;Active&apos; &quot; + &quot; AND &quot; + &quot;[VHA Spl Siebel Rate Type] = &apos;&quot; + sIDD + &quot;&apos;&quot;;

		if(sAssetId != &quot;&quot;)
		{
			with(oAssetComponent) 
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchExpr(strSearchExpr);
				ExecuteQuery(ForwardOnly);
				var isPrimRec = FirstRecord();
				if(isPrimRec) 
				{
					sIDDExists = &quot;Y&quot;;	
				}
			}
			Outputs.SetProperty(&quot;IDDExists&quot;,sIDDExists);
		}
    } 
    catch (e) 
    {
        throw (e);

    } 
    finally 
    {
        oAssetComponent = null;
        oAssetBo = null;
    }
}"
