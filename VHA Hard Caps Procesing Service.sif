			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckDuplicateBarringRecords"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckDuplicateBarringRecords(Inputs, Outputs)
{
	/*
     * Component Name        :  VHA Hardcaps Processing Service
     * Method Name               :  mCheckDuplicateBarringRecords
     * Component Information :  This fn is to check the duplicate barring records while submitting
     * Modification History  :
     * Date   Author  Config #   Description
     * ============ =========== ===========   ================================
     *  02-02-2018   Vinodhini    HardCaps
     */
	try
	{
		var oBarringBo = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var oBarringBC = oBarringBo.GetBusComp(&quot;VHA Current Processing Status BC&quot;);
		
		var sRootAssetInteg = Inputs.GetProperty(&quot;RootAssetIntegrationId&quot;);
		var sBarStatus = Inputs.GetProperty(&quot;BarStatus&quot;);
		var StrProduct = Inputs.GetProperty(&quot;Service&quot;);
		var sBarId = Inputs.GetProperty(&quot;CurrentRecId&quot;);
		var ErrCode = &quot;VHA_HARDCAP_007&quot;;
	
		
     if(sRootAssetInteg != &quot;&quot;)
	 {
		 
		with(oBarringBC) 
		{
			ActivateField(&quot;Current Status&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			var strSearchExpr1 = &quot;[Asset Integration Id] = &apos;&quot; + sRootAssetInteg + &quot;&apos; AND &quot; + &quot;[Service] = &apos;&quot; + StrProduct + &quot;&apos; AND &quot; + &quot;[Current Status] = &apos;&quot; + sBarStatus + &quot;&apos; AND [Id] &lt;&gt; &apos;&quot; + sBarId + &quot;&apos;&quot;;
			SetSearchExpr(strSearchExpr1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
			    Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;VFErrorCode#:&quot; + ErrCode + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ErrCode,sBarStatus));
				TheApplication().RaiseErrorText(&quot;VFErrorCode#:&quot; + ErrCode + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ErrCode,sBarStatus));
			}
		}//with(oBarringBo)
	 }
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	oBarringBC = null;
    oBarringBo = null;	
	}
}"
