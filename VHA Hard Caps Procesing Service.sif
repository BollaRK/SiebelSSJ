			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteCapsDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Written by Kailash for deleting any hard caps records already exists for order item id.

function mDeleteCapsDetails(sOrderItmId)
{
	try
	{
		var sCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Hard Caps&quot;);
	//	var sOrderId=Inputs.GetProperty(&quot;Order Id&quot;);
	//	var sOrderItmId=Inputs.GetProperty(&quot;Root Line Item Id&quot;);
		var oThrottleBC = TheApplication().GetBusObject(&quot;VHA Throttle Order&quot;).GetBusComp(&quot;VHA Throttle Details&quot;);
		if(sOrderItmId != &quot;&quot; &amp;&amp; sCaps != &quot;&quot;)
		{
			with(oThrottleBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Service Order Id&quot;, sOrderItmId);
				SetSearchSpec(&quot;Type&quot;,sCaps);
				ExecuteQuery(ForwardOnly);
				while(FirstRecord())
				{
					DeleteRecord();
				}
			}
		}
	}
	catch (e)
	{
		throw(e);
	}
	finally
	{
		oThrottleBC = null;
	}
}"
