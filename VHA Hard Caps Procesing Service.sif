			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPreSubmitDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPreSubmitDetails(sOrderId, sRootLineId, sOrderType, sGetModifyTypeOut,sCustAstIntId)
{
    /*
     * Component Name        : 	VHA Hard Caps Procesing Service
     * Method Name/Fn         : mGetPreSubmitModify	
     * Component Information : 	
     * Modification History  :
     * Date			Author		Config #			Description
     * ============ ===========	===========			================================
     *  23-08-2018  Kailash   Hardcaps				This function will check if RPC/Booster/IDD added for order types
	 *  26-12-2018  Sathish   19.1 PKE#             IDD/Data in submit XML fixed for BAU to BAU and BAU to HC change prop scenarios
     */
    try {

        //Object Declarations
        var boOrder = TheApplication().GetBusObject(&quot;Order Entry UNISIM BO&quot;);
		var bcOrderItemsSimple = boOrder.GetBusComp(&quot;VF Order Entry - Line Item - Primary Product&quot;);
        var bcOrderItems = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
       
		var sBooster = &quot;N&quot;, sRPC = &quot;N&quot;, sIDD = &quot;N&quot;;
		var sAll = &quot;&quot;;
		var sNewRootId = &quot;&quot;;
		var sRootSplTypeToProp,sCapsTypeTarget=&quot;&quot;;
		var sMaxSpeedBooster = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Hard Caps Data Booster&quot;);
		var sIDDProdType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;IDD&quot;);
		var sDeconFrom = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Decon/Con Transfer FROM&quot;);
		var sChnDscnt = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Ownership Disconnect&quot;);
		
		
		if (sOrderType == sChnDscnt || sOrderType ==sDeconFrom   )
		{
		
			var strSearchExpr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND &quot; + &quot;[Root Order Item Id] = &apos;&quot; + sRootLineId + &quot;&apos;AND &quot; + &quot;[Primary Product Flag] = &apos;Y&apos;&quot;;
		
		}
		if (sOrderType == &quot;Change Proposition&quot;)
		{
		
			var strSearchExpr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND &quot; + &quot;[Cust Asset Integration Id] = &apos;&quot; + sCustAstIntId + &quot;&apos;AND &quot; + &quot;[Primary Product Flag] = &apos;Y&apos; AND &quot; + &quot;[Action Code] = &apos;Add&apos;&quot;;
		
		}
			if (sOrderType  == &quot;Modify&quot;)
		{
		
			var strSearchExpr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND &quot; + &quot;[Root Order Item Id] = &apos;&quot; + sRootLineId + &quot;&apos;AND &quot; + &quot;[Primary Product Flag] = &apos;Y&apos; AND &quot; + &quot;[Action Code] = &apos;Add&apos;&quot;;
		}

	   //SG : Below query to identify RPC
        with(bcOrderItemsSimple) 
        {
        	SetViewMode(AllView);
            ClearToQuery();
            ActivateField(&quot;Action Code&quot;);
			if(sOrderId != &quot;&quot; &amp;&amp; sRootLineId != &quot;&quot;)
			SetSearchExpr(strSearchExpr);
            ExecuteQuery(ForwardOnly);
            var isPrimRec = FirstRecord();


			if(isPrimRec) 
			{ 
			sRPC = &quot;Y&quot;;
			sNewRootId= GetFieldValue(&quot;Root Order Item Id&quot;);
			if (sNewRootId != &quot;&quot;)
			{
				bcOrderItems.SetViewMode(AllView);
				bcOrderItems.ActivateField(&quot;Special Rating List Type&quot;);
				bcOrderItems.ClearToQuery();
				bcOrderItems.SetSearchSpec(&quot;Id&quot;,sNewRootId);
				bcOrderItems.ExecuteQuery(ForwardOnly);
				if(bcOrderItems.FirstRecord())
				{
				sRootSplTypeToProp = bcOrderItems.GetFieldValue(&quot;Special Rating List Type&quot;);
				sCapsTypeTarget = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, sRootSplTypeToProp);								
				}

			}
        }
	 }

		
		
		if(sOrderType == sDeconFrom || sOrderType == sChnDscnt)
		{

		var strSearchExpr1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND &quot; + &quot; [Root Order Item Id] = &apos;&quot; + sRootLineId + &quot;&apos;AND &quot; + &quot; ([Siebel Product Type] = &apos;&quot; + sMaxSpeedBooster +&quot;&apos; OR [Special Rating List Type] = &apos;&quot; + sIDDProdType +&quot;&apos;)&quot;;
		}
		if (sOrderType == &quot;Change Proposition&quot;)
		{
		var strSearchExpr1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND &quot; + &quot; [Custom Asset Integration Id] = &apos;&quot; + sCustAstIntId + &quot;&apos;AND &quot; + &quot; (([Siebel Product Type] = &apos;&quot; + sMaxSpeedBooster +&quot;&apos; OR [Special Rating List Type] = &apos;&quot; + sIDDProdType +&quot;&apos;) AND [Action Code] = &apos;Add&apos;)&quot;;
		
		}
		
		if (sOrderType  == &quot;Modify&quot;)
		{
		var strSearchExpr1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND &quot; + &quot; [Root Order Item Id] = &apos;&quot; + sRootLineId + &quot;&apos;AND &quot; + &quot; (([Siebel Product Type] = &apos;&quot; + sMaxSpeedBooster +&quot;&apos; OR [Special Rating List Type] = &apos;&quot; + sIDDProdType +&quot;&apos;) AND [Action Code] = &apos;Add&apos;)&quot;;
		}

		//SG : Below query to identify IDD/Booster added
			
		with(bcOrderItems) 
		{
			ClearToQuery();
			ActivateField(&quot;Action Code&quot;);
			ActivateField(&quot;Siebel Product Type&quot;);
			ActivateField(&quot;Special Rating List Type&quot;);
			if(sOrderId != &quot;&quot; &amp;&amp; sRootLineId != &quot;&quot;)
				SetSearchExpr(strSearchExpr1);
			ExecuteQuery(ForwardOnly);
			var isPrimRec = FirstRecord();
			while (isPrimRec) 
			{
				if (GetFieldValue(&quot;Siebel Product Type&quot;) == sMaxSpeedBooster)
					sBooster = &quot;Y&quot;;
				else
					sIDD = &quot;Y&quot;;
		  
				isPrimRec = NextRecord();			
			}
		}



	if(sRPC == &apos;Y&apos;)
	{					
		if (sRootSplTypeToProp == sCapsTypeTarget &amp;&amp; ( sRootSplTypeToProp !=&quot;&quot; &amp;&amp; sRootSplTypeToProp != null)&amp;&amp; sIDD == &apos;N&apos;)
		{
		sAll = &apos;AllIDDbar&apos;;
		}
		else if (sRootSplTypeToProp == sCapsTypeTarget &amp;&amp; ( sRootSplTypeToProp !=&quot;&quot; &amp;&amp; sRootSplTypeToProp != null)&amp;&amp; (sIDD == &apos;Y&apos;))
		{					
		sAll = &apos;AllUnbar&apos;;
		}

		else if(sIDD == &apos;N&apos;)
		{					
		sAll = &apos;AllUnbar&apos;;
		}					
						
	}
	
					
	if(sRPC == &apos;N&apos;)
	{
	if(sBooster == &apos;Y&apos; &amp;&amp; sIDD == &apos;Y&apos;)
	sAll = &apos;AllUnbar&apos;;
	else if(sBooster == &apos;Y&apos; &amp;&amp; sIDD == &apos;N&apos;)
	sAll = &apos;Booster&apos;;
	else if(sIDD == &apos;Y&apos; &amp;&amp; sBooster == &apos;N&apos;)
	sAll = &apos;IDD&apos;;
	}
sGetModifyTypeOut.SetProperty(&quot;sAll&quot;, sAll);
sGetModifyTypeOut.SetProperty(&quot;NewRootId&quot;, sNewRootId);

    } 
    catch (e) 
    {
        throw (e);

    } 
    finally 
    {
		bcOrderItems = null;
        bcOrderItemsSimple = null;
        boOrder = null;
    }
}"
			   SEQUENCE="18"
			   UPDATED="11/23/2020 19:23:21"
			   UPDATED_BY="SADMIN"
			   CREATED="05/20/2019 23:31:22"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPropositionSplType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPropositionSplType(Inputs,Outputs)
{
	try
	{	
		var oBO = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;);
		var oLineItemBC = oBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		var sOLISpecialProdType = &quot;&quot;, sRecExist = &quot;&quot;, sHardCaps = &quot;&quot;;
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sRootLineId = Inputs.GetProperty(&quot;Root Line Item Id&quot;);
		var sNewRootId = Inputs.GetProperty(&quot;New Root Order Item Id&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;Order Sub Type&quot;);
		var sActionCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;DELTA_ACTION_CODE&quot;, &quot;New&quot;);
		var sOrderChgProp = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Proposition&quot;);
		var sChnCnt = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Ownership Connect&quot;);
		var sOLIStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FS_ORDER_STATUS&quot;, &quot;Complete&quot;);
		
		
		
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			with(oLineItemBC)
			{
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Special Product Type&quot;);
				ActivateField(&quot;VF Service Order Sub Type&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Status&quot;);
				SetViewMode(AllView);
				ClearToQuery();				
				if(sNewRootId != &quot;&quot; &amp;&amp; sNewRootId != null &amp;&amp; sOrderSubType == sOrderChgProp)
				{
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + sNewRootId + &quot;&apos; AND [Action Code] = &apos;&quot; + sActionCode + &quot;&apos; AND [Status] = &apos;&quot; + sOLIStatus + &quot;&apos;&quot;);
				}
				else
				{
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + sRootLineId + &quot;&apos; AND [Action Code] = &apos;&quot; + sActionCode + &quot;&apos; AND [Status] = &apos;&quot; + sOLIStatus + &quot;&apos; AND [VF Service Order Sub Type] = &apos;&quot; + sChnCnt + &quot;&apos;&quot;);
				}
				
				ExecuteQuery(ForwardOnly);
				sRecExist = FirstRecord();
				if(sRecExist)
				{
					sOLISpecialProdType = GetFieldValue(&quot;Special Product Type&quot;);				
					
					if(sOLISpecialProdType != &quot;&quot; &amp;&amp; sOLISpecialProdType!= null)
					{
						var sCapsType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HARD_CAP_AUTO_TXT&quot;, sOLISpecialProdType);
						if(sCapsType == &quot;Y&quot;)
						{
							sHardCaps = &quot;Y&quot;;
						}
						
					}
					if(sHardCaps == &quot;Y&quot;)
					{
						Outputs.SetProperty(&quot;IsHardCaps&quot;, sHardCaps);
					}	
					else
					{
						Outputs.SetProperty(&quot;IsHardCaps&quot;, &quot;&quot;);
					}					
				}				
			}			
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oLineItemBC = null;	
		oBO = null;
	}
}"
			   SEQUENCE="19"
