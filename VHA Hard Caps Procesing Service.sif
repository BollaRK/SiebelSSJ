			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mIsCappedCustomer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	mIsCappedCustomer
 * Component Information : 	This function checks if customer is credit capped customer.
 *							
 * Inputs				 : Account Id
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/07/2018	Kathambari		Initial Version
 */



function mIsCappedCustomer(Inputs,Outputs)
{
try{
var	IsCapCust = &quot;N&quot;;
var AccountId = Inputs.GetProperty(&quot;AccountId&quot;);
//var class2 = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CREDIT_CLASS&quot;,&quot;X2&quot;);
var BO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
var Accntbc = BO.GetBusComp(&quot;VF Account Thin TBUI&quot;);
var finprof = BO.GetBusComp(&quot;VF Com Financial Profile TBUI&quot;);
if(AccountId != &quot;&quot;)
{
	with(Accntbc)
	{
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchExpr(&quot;[Id] = &apos;&quot; + AccountId + &quot;&apos;&quot;);
		ExecuteQuery(ForwardOnly);
		var fr = FirstRecord();
		if(fr)
		{
		 with(finprof)
		 {
			var finanrec =  FirstRecord();
			if(finanrec)
			{
			 var creditclass = GetFieldValue(&quot;VF Credit Class&quot;);
			 var class1 = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HARD_CAP_CC&quot;,creditclass);
				 if(creditclass == class1 &amp;&amp; class1 != &quot;&quot; &amp;&amp; class1 != null)
				 {
					 IsCapCust = &quot;Y&quot;;
				 }		
			 }
		 }
		}
		Outputs.SetProperty(&quot;IsCapCust&quot;,IsCapCust);
	}
}
}
catch(e)
{
throw(e);
}
finally
{
Accntbc = null;
finprof = null;
BO = null;
}
}"
