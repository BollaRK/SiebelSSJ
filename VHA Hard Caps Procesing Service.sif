			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckExistingBarring"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckExistingBarring(Inputs, Outputs)
{
	 /*
     * Component Name        :  VHA Hardcaps Processing Service
     * Method Name           :  mCheckExistingBarring
     * Component Information :  This is to check the barring records under the asset
     * Modification History  :
     * Date   Author  Config #   Description
     * ============ =========== ===========   ================================
     *  02-02-2018   Vinodhini    HardCaps
     */
	try
	{
		var boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var bcHLB = boAsset.GetBusComp(&quot;VF High Level Bars&quot;);
		var sObar = &quot;OBAR&quot;;
		var sAbar = &quot;ABAR&quot;;
		var ABAR_ERROR = &quot;13109&quot;;
		var OBAR_ERROR = &quot;13112&quot;;
		var sAssetId = Inputs.GetProperty(&quot;AssetId&quot;);
		
		
		if(sAssetId != &quot;&quot;)
		{
			with (bcHLB)
			{
				ActivateField(&quot;Bar Type&quot;);
				ActivateField(&quot;Bar Reason&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchExpr(&quot;[Parent Asset Id] = &apos;&quot; + sAssetId + &quot;&apos; AND (([Bar Type] = &apos;&quot; + sAbar + &quot;&apos;) OR ([Bar Type] = &apos;&quot; + sObar + &quot;&apos;))&quot;);
				ExecuteQuery(ForwardOnly);
				var isrec = FirstRecord();
				
				if(FirstRecord())
				{
					if(GetFieldValue(&quot;Bar Type&quot;) == sAbar)
					{
					    Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;VFErrorCode#:&quot; + ABAR_ERROR + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ABAR_ERROR) +   &quot; due to&quot; + &quot; &quot; +GetFieldValue(&quot;Bar Reason&quot;));
						TheApplication().RaiseErrorText (&quot;VFErrorCode#:&quot; + ABAR_ERROR + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ABAR_ERROR) +   &quot; due to&quot; + &quot; &quot; +GetFieldValue(&quot;Bar Reason&quot;));
					}	
					else
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;VFErrorCode#:&quot; + OBAR_ERROR + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, OBAR_ERROR) +   &quot; due to&quot; + &quot; &quot; +GetFieldValue(&quot;Bar Reason&quot;));
						TheApplication().RaiseErrorText (&quot;VFErrorCode#:&quot; + OBAR_ERROR + &quot;-&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, OBAR_ERROR) +   &quot; due to&quot;+ &quot; &quot; +GetFieldValue(&quot;Bar Reason&quot;));
				    }
				}
			}
	
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcHLB = null;
		boAsset = null;
	}
}"
