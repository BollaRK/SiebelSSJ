			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckExpiryDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckExpiryDate(Inputs, Outputs)
{
	/*
     * Component Name        :  VHA Hardcaps Processing Service
     * Method Name               :  mCheckExpirtDate
     * Component Information :  This is to check the expiry date of Data Record and update the status.
     * Modification History  :
     * Date   Author  Config #   Description
     * ============ =========== ===========   ================================
     *  02-02-2018   Vinodhini    HardCaps
     */
	try
	{
		var oBarringBo = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var oBarringBC = oBarringBo.GetBusComp(&quot;VHA Current Processing Status BC&quot;);
		
		var sRootAssetInteg = Inputs.GetProperty(&quot;RootAssetIntegrationId&quot;);
		var sBarStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HC_USAGE_STATUS&quot;,&quot;Barred&quot;);
		var sUnBarStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HC_USAGE_STATUS&quot;,&quot;Unbarred&quot;);
		var StrProduct = Inputs.GetProperty(&quot;Service&quot;);
		
		
     if((sRootAssetInteg != &quot;&quot;) &amp;&amp; (StrProduct == &quot;Data&quot;))
	 {
		 
		with(oBarringBC) 
		{
			ActivateField(&quot;Current Status&quot;);
			ActivateField(&quot;Transaction Status&quot;);
			ActivateField(&quot;Reason Code&quot;);
			ActivateField(&quot;Processed Date&quot;);
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Channel&quot;);
			ActivateField(&quot;Inactivated Date&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			var strSearchExpr1 = &quot;[Asset Integration Id] = &apos;&quot; + sRootAssetInteg + &quot;&apos; AND &quot; + &quot;[Service] = &apos;&quot; + StrProduct + &quot;&apos; AND &quot; + &quot;[Current Status] = &apos;&quot; + sBarStatus + &quot;&apos; AND [Expiry Date] &lt;= Timestamp()&quot;;
			SetSearchExpr(strSearchExpr1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				SetFieldValue(&quot;Current Status&quot;,sUnBarStatus);
				WriteRecord();
				//TheApplication().RaiseErrorText(&quot;Please change the Current status which is already exists&quot;);
			}
		}//with(oBarringBo)
	 }
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{
	oBarringBC = null;
    oBarringBo = null;	
	}
}"
