			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateOldAssetXMRRef"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateOldAssetXMRRef(sOrderId ,sRootLineId,sNewRootId)
{
/*
 * Component Name        :  VHA Buffet Processing Service
 * Method Name/Fn         : mUpdateOldAssetXMRRef 
 * Component Information :  This fn updates existing asset xm par asset id reference for change prop
 * Modification History  :
 * Date   Author  Config #   Description
 * ============ =========== ===========   ================================
 *  13-04-2018   Vinodhini   Hardcaps
 */

try
{
		var bContinue,strNewIAId,strOldIAId,sNewAssetId=&quot;&quot;;

		var boOrder = TheApplication().GetBusObject(&quot;MACD Performance Order&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;MACD Order Entry - Orders&quot;);
		var bcOrderLineItems = boOrder.GetBusComp(&quot;MACD Order Entry - Line Items&quot;);

		var boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var bcAsset = boAsset.GetBusComp(&quot;Asset Mgmt - Asset - Header Simple&quot;);
		var bcPasses = boAsset.GetBusComp(&quot;VHA Current Processing Status BC&quot;);
		var bcTransaction = boAsset.GetBusComp(&quot;VHA Transaction History BC&quot;);
			
			
			bcOrder.ClearToQuery();
			bcOrder.SetViewMode(AllView);
			bcOrder.SetSearchSpec( &quot;Id&quot;, sOrderId );
			bcOrder.ExecuteQuery( ForwardOnly );
			
			if (bcOrder.FirstRecord())
			{
				bcOrderLineItems.ClearToQuery();
				bcOrderLineItems.ActivateField( &quot;Root Asset Integration Id&quot; );		
				bcOrderLineItems.ActivateField(	&quot;Action Code&quot; );
				
				if(sRootLineId != &quot;&quot; &amp;&amp; sNewRootId != &quot;&quot;)
				bcOrderLineItems.SetSearchExpr(&quot;[Id] = &apos;&quot; + sRootLineId + &quot;&apos; OR [Id] = &apos;&quot; + sNewRootId + &quot;&apos;&quot;);
				else
				bcOrderLineItems.SetSearchSpec( &quot;Parent Order Item Id&quot;, &quot;= &apos;&apos;&quot; );
				bcOrderLineItems.ExecuteQuery(ForwardOnly);
				bContinue = bcOrderLineItems.FirstRecord();
				while ( bContinue )
				{
				
					if ( bcOrderLineItems.GetFieldValue( &quot;Action Code&quot; ) == &quot;Add&quot; )
					{
						// Asset Id of the new reparented IA
						strNewIAId = bcOrderLineItems.GetFieldValue( &quot;Root Asset Integration Id&quot; );
						
					}
					else
					{

						strOldIAId = bcOrderLineItems.GetFieldValue( &quot;Root Asset Integration Id&quot; );
						
					}
					
					bContinue = bcOrderLineItems.NextRecord();
				}
			
			}

			
			if(strNewIAId != &quot;&quot; &amp;&amp; strOldIAId != &quot;&quot;)
			{				
				bcAsset.ClearToQuery();
				bcAsset.SetViewMode( AllView );	
				//bcAsset.ActivateField( &quot;Integration Id&quot; );
				bcAsset.SetSearchSpec( &quot;Integration Id&quot;, strNewIAId );
				bcAsset.ExecuteQuery( ForwardOnly );
				if(bcAsset.FirstRecord())
				{
				
				gNewAssetId = bcAsset.GetFieldValue(&quot;Id&quot;);
				
				}
				if (gNewAssetId != &quot;&quot;)
				{
					
					bcAsset.ClearToQuery();
					bcAsset.SetViewMode( AllView );	
					bcAsset.SetSearchSpec( &quot;Integration Id&quot;, strOldIAId );
					bcAsset.ExecuteQuery( ForwardOnly );
					if(bcAsset.FirstRecord())
					{
					
					    bcPasses.ActivateField(&quot;Asset Id&quot;);
						bcPasses.ClearToQuery();
						bcPasses.SetViewMode(AllView);
						bcPasses.SetSearchSpec(&quot;Asset Integration Id&quot;, strOldIAId );
						bcPasses.ExecuteQuery( ForwardOnly );
						var isRecFound = bcPasses.FirstRecord();
						
						while(isRecFound)
						{
						bcPasses.SetFieldValue(&quot;Asset Id&quot;,gNewAssetId);	
						isRecFound = bcPasses.NextRecord();
						}
						
						bcTransaction.ActivateField(&quot;Asset Id&quot;);
						bcTransaction.ClearToQuery();
						bcTransaction.SetViewMode(AllView);
						bcTransaction.SetSearchSpec(&quot;Asset Integration Id&quot;, strOldIAId );
						bcTransaction.ExecuteQuery( ForwardOnly );
						var isRec = bcTransaction.FirstRecord();
						
						while(isRec)
						{
						bcTransaction.SetFieldValue(&quot;Asset Id&quot;,gNewAssetId);	
						isRec = bcTransaction.NextRecord();
						}
					
					}
				
				}
			
			}	
}
catch(e)
{
 throw(e);
}
finally
{
	bcOrderLineItems = null;
	bcOrder = null;
	boOrder = null;
	bcPasses = null;
	bcTransaction = null;
	bcAsset = null;
	boAsset = null;

}	
}"
