			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mIsAccessoryAdded"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	mIsAccessoryAdded
 * Component Information : 	This function checks if any accessories are added to specific order.
 *							
 * Inputs				 : Order Id
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/07/2018	Kathambari		Initial Version
 */

function mIsAccessoryAdded(Inputs,Outputs)
{
try
{
var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var	AccessoryPresent = &quot;N&quot;;
var BO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
var LineItemBC = BO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
var FulfillmentBc = BO.GetBusComp(&quot;VHA AOA Fulfilment Items&quot;);
var AccessBC = BO.GetBusComp(&quot;VHA Accessory Items&quot;);
if(OrderId != &quot;&quot;)
{
with(LineItemBC)
{
	ClearToQuery();
	SetViewMode(AllView);
	SetSearchExpr(&quot;[Root Order Item Id] = [Id] AND [Order Header Id] = &apos;&quot; + OrderId + &quot;&apos;&quot;);
	ExecuteQuery(ForwardOnly);
	var fr = FirstRecord();
	while(fr)
	{
		var RelServOrderId = GetFieldValue(&quot;Id&quot;);
		with(FulfillmentBc)
		{
		SetSearchExpr(&quot;[Related Service Order Id] = &apos;&quot; + RelServOrderId + &quot;&apos;&quot;);
		ExecuteQuery(ForwardOnly);
		var frec = FirstRecord();
		if(frec)
		{
			AccessoryPresent = &quot;Y&quot;;
		}
		}
		with(AccessBC)
		{
			SetSearchExpr(&quot;[Related Service Order Id] = &apos;&quot; + RelServOrderId + &quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			var faccrec = FirstRecord();
			if(faccrec)
			{
				AccessoryPresent = &quot;Y&quot;;
			}
		}
	fr = NextRecord();
	}
	Outputs.SetProperty(&quot;AccessoryPresent&quot;,AccessoryPresent);
}
}
}
catch(e)
{
throw(e);
}
finally
{
LineItemBC = null;
FulfillmentBc = null;
AccessBC = null;
BO = null;
}
}"
			   SEQUENCE="21"
