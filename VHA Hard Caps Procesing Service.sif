			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckPrimaryContact"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckPrimaryContact(Inputs,Outputs)
{
	var PrimaryContactNumber = Inputs.GetProperty(&quot;PrimaryContactNumber&quot;);
	if((PrimaryContactNumber.substring(0,3) == &quot;614&quot; || PrimaryContactNumber.substring(0,2) == &quot;04&quot;) &amp;&amp; 
		(PrimaryContactNumber.length == 11 || PrimaryContactNumber.length == 10))
	{
		Outputs.SetProperty(&quot;PrimaryContactNumber&quot;,PrimaryContactNumber);
	}
	else
	{
		Outputs.SetProperty(&quot;PrimaryContactNumber&quot;,&quot;&quot;);
	}
}
"
