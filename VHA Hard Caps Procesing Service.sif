			   UPDATED_BY="SADMIN"
			   CREATED="05/20/2019 23:31:22"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
/*
 * Modification History  :
 * Date			Author		Config #	   Description
 * ============ ===========	=============  =======================
 * 05/07/2018	Rinu 		18.4 HardCaps    Invoked for Hard Caps
 * 13/07/2018	Kailash 	18.4 HardCaps  Added for Hard Caps
 * 17/07/2018	Vinodhini 	18.4 HardCaps  Added for Hard Caps
 */
	try
	{
		var bsError;
		var	psErrorInput;
		var psErrorOutput;
		switch(MethodName)
		{
			case &quot;CreditCheckValidation&quot;:
			fnCreditCheckValidation(Inputs,Outputs);
			break;
			
			case &quot;CreditCheckValidation_UI&quot;:  // Sachi - 17/Aug/2018 Added for HardCaps
			fnCreditCheckValidation_UI(Inputs,Outputs);
			break;
			
			case &quot;CapsAccessoryValidation&quot;:	//Sachi - 20/Sep/2018 Added for APP/Non App/Secondary device validation for Hardcaps
			mCapsAccessoryValidation(Inputs, Outputs)
			break;
			
			case &quot;CheckifCreditCapPropAdded&quot;:
			mCheckifCreditCapPropAdded(Inputs,Outputs);
			break;
			
			case &quot;IsCappedCustomer&quot;:
			mIsCappedCustomer(Inputs,Outputs);
			break;
			
			case &quot;IsAccessoryAdded&quot;:
			mIsAccessoryAdded(Inputs,Outputs);
			break;
			
			case &quot;UpdateCapsDetails&quot;://Kailash-13/Jul/18-Added for HardCaps
			mUpdateCapsDetails(Inputs);
			break;
			
			//Vinodhini-17/07/2018-Added for HardCaps
			case &quot;PostOrderHardCapsProcess&quot;:
			mPostOrderHardCapsProcess(Inputs,Outputs);
			break;
			
			case &quot;IsMoreThanOneServiceAdded&quot;:
			mIsMoreThanOneServiceAdded(Inputs,Outputs);
			break;
			
			case &quot;ButtonEnable&quot;://Kailash-25/Jul/18-Added for HardCaps
			mCheckCapsEnable(Inputs, Outputs);
			break;
			
			case &quot;HardCapsValidation&quot;:
			mHardCapsValidation(Inputs,Outputs);
			break;
			
			//Vinodhini-03/08/2018-Added for HardCaps
			case &quot;SubmitBarValidation&quot;:
			mCheckExistingBarring(Inputs, Outputs);
			mCheckExpiryDate(Inputs, Outputs);
			mCheckDuplicateBarringRecords(Inputs, Outputs);
			break;
			
			//Vinodhini-17/08/2018-Added for HardCaps
			case &quot;GetCurrentStatusForIDD&quot;:
			mGetCurrentStatusForIDD(Inputs,Outputs);
			break;
			
			case &quot;GetPropositionSplType&quot;:  //Sachi - 20/03/2019 - Added for IR01 Interim Release.
			mGetPropositionSplType(Inputs,Outputs);
			break;

			case &quot;CheckAmazonPrimeSubscription&quot;:  //Jaya-23/10/2020-Added for Nov Rel-Amazon Prime
			mCheckAmazonPrimeSubscription(Inputs,Outputs);
			break;

			case &quot;CheckPrimaryContact&quot;:
			mCheckPrimaryContact(Inputs,Outputs);
			break;
			
			default:
			break;
		}
		return (CancelOperation);
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		//nothing
	}
	return (ContinueOperation);
}"
