			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mHardCapsValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mHardCapsValidation(Inputs,Outputs)
{
try
{
var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var AccountId = Inputs.GetProperty(&quot;AccountId&quot;);
var sOrderType = Inputs.GetProperty(&quot;sOrderType&quot;);
var psInputs = TheApplication().NewPropertySet();
var psOutputs = TheApplication().NewPropertySet();
psInputs.SetProperty(&quot;AccountId&quot;,AccountId);
mIsCappedCustomer(psInputs,psOutputs);
var IsCapCust = psOutputs.GetProperty(&quot;IsCapCust&quot;);
psInputs = TheApplication().NewPropertySet();
psOutputs = TheApplication().NewPropertySet();
psInputs.SetProperty(&quot;OrderId&quot;, OrderId);
mCheckifCreditCapPropAdded(psInputs,psOutputs);
var CapPropPresent = psOutputs.GetProperty(&quot;CapPropPresent&quot;);
var ServiceLimitExceeds = psOutputs.GetProperty(&quot;ServiceLimitExceeds&quot;);
var CredicapPropErrmsg;
var ErrorMsg = &quot;&quot;;
//VHA Sneha - Added below script for 19.1 TOT CIR
var sSet = &quot;N&quot;;
var sAssetBO, sAssetBC;
if(AccountId != &quot;&quot; &amp;&amp; AccountId != null)
		{
	sAssetBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
	sAssetBC = sAssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
	with(sAssetBC)
			{
			ActivateField(&quot;Service Account Id&quot;);				
			ActivateField(&quot;Capped Service Type&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Service Account Id&quot;,AccountId);
			SetSearchSpec(&quot;Status&quot;,&quot;Active&quot;);
			SetSearchSpec(&quot;Capped Service Type&quot;,&quot;Assured Cap&quot;);
			ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{						
						/*var sCaps = GetFieldValue(&quot;Capped Service Type&quot;);
						var sCapsLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;Assured Cap&quot;);
						if(sCaps == sCapsLov)
						{*/
							sSet = &quot;Y&quot;;
							
					}
							
			}

		}
if(IsCapCust == &quot;Y&quot;)
{
	var CapTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HARD_CAP_ORDER_TYPE&quot;,sOrderType);
				if(sOrderType==CapTypeLOV)
				{
					if(CapPropPresent == &quot;N&quot;)
					{
					 CredicapPropErrmsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_HARDCAP_009&quot;);
					}
					//VHA Sneha - Added below script for 19.1 TOT CIR
					if(CapPropPresent == &quot;Y&quot; &amp;&amp; sSet == &quot;Y&quot;)
					{
					 CredicapPropErrmsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_HARDCAP_002&quot;);
					}
					if (ServiceLimitExceeds == &quot;Y&quot;)
					{
						var servicelimiterrmsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_HARDCAP_002&quot;);
					}
				var InputsPS = TheApplication().NewPropertySet();
				var outputsPS = TheApplication().NewPropertySet();
				InputsPS.SetProperty(&quot;OrderId&quot;, OrderId);
				mIsAccessoryAdded(InputsPS,outputsPS);
				var AccessoryPresent = outputsPS.GetProperty(&quot;AccessoryPresent&quot;);
				
				if(AccessoryPresent == &quot;Y&quot;)
				{
					var ErrMsgAccessory = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_HARDCAP_004&quot;);
				}
				}
}
else
{
	var BAUTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_BAU_ORDER_TYPE&quot;,sOrderType);
				if(sOrderType==BAUTypeLOV)
				{
					if(CapPropPresent == &quot;Y&quot;)
					{
					CredicapPropErrmsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_HARDCAP_003&quot;);
					//TheApplication().RaiseErrorText(CredicapPropErrmsg);
					//throw(CredicapPropErrmsg);
					}
					//Vinodhini-21/09/2018-Added code for restrict the accessory for vodafone caps
					if(BAUTypeLOV == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;,&quot;Change Proposition&quot;))
					{
					 mCapsAccessoryValidation(Inputs, Outputs);
					}
				}
}		
			if(CredicapPropErrmsg != &quot;&quot; &amp;&amp; CredicapPropErrmsg != null)
			{
				ErrorMsg = CredicapPropErrmsg;
			}
			else if (servicelimiterrmsg != &quot;&quot; &amp;&amp; servicelimiterrmsg != null)
			{
				ErrorMsg = servicelimiterrmsg;
			}
			else if(ErrMsgAccessory != &quot;&quot; &amp;&amp; ErrMsgAccessory != null)
			{
				ErrorMsg = ErrMsgAccessory;
			}
			if(ErrorMsg != &quot;&quot;)
			Outputs.SetProperty(&quot;ErrorMsg&quot;,ErrorMsg);
}
catch(e)
{
/*	if (!defined(e.errText))
		{
		TheApplication().RaiseErrorText(e.toString());
		}
		else
		{
		TheApplication().RaiseErrorText(e.errText);
		}*/
throw(e);
}
finally
{
	sAssetBC = null;
	sAssetBO =  null;
}
}"
			   SEQUENCE="20"
