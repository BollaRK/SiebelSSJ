			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mIsMoreThanOneServiceAdded"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	mIsMoreThanOneServiceAdded
 * Component Information : 	This function checks if any accessories are added to specific order.
 *							
 * Inputs				 : Order Id
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/07/2018	Kathambari		Initial Version
 */

function mIsMoreThanOneServiceAdded(Inputs,Outputs)
{
try
{
var ServiceLimitExceeds = &quot;N&quot;;
var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var BO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
var BC = BO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
if(OrderId != &quot;&quot;)
{
with(BC)
{
	ClearToQuery();
	SetViewMode(AllView);
	SetSearchExpr(&quot;[Root Order Item Id] = [Id] AND [Order Header Id] = &apos;&quot; + OrderId + &quot;&apos;&quot;);
	ExecuteQuery(ForwardOnly);
	var NoOfService = CountRecords();
	if(NoOfService &gt; 1)
	{
		ServiceLimitExceeds = &quot;Y&quot;;
	}
	Outputs.SetProperty(&quot;ServiceLimitExceeds&quot;,ServiceLimitExceeds);
}
}
}
catch(e)
{
throw(e);
}
finally
{
OrderId = null;
NoOfService = null;
BC = null;
BO = null;
}


}"
			   SEQUENCE="23"
			   UPDATED="11/23/2020 19:23:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPostOrderHardCapsProcess"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPostOrderHardCapsProcess(Inputs, Outputs) 
{
    /*
     * Component Name        :  VHA Hard Caps Procesing Service
     * Method Name/Fn         : mPostOrderHardCapsProcess 
     * Component Information :  This fn is to create new Hardcaps Products under asset
     * Modification History  :
     * Date   Author  Config #   Description
     * ============ =========== ===========   ================================
     *  10-07-2018   Vinodhini   HardCaps
     */
    try 
    {
        //Declare Variables 
        var sOrderType, sRootAssetInteg;

        //Objects Declaration section 
        var oOrderBo = TheApplication().GetBusObject(&quot;Order Entry UNISIM BO&quot;);
        var oOrderLineBC = oOrderBo.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
		
		var sLOVBC = TheApplication().GetBusObject(&quot;List Of Values&quot;).GetBusComp(&quot;List Of Values&quot;);
				
		var isRec = &quot;&quot;, StrProduct = &quot;&quot;, sSplSiebelRatingList = &quot;&quot;, sActionCd = &quot;&quot;, sFromPropType = &quot;&quot;;
		var sInactivateCapsRequired = &quot;N&quot;, sActivateCapsRequired = &quot;N&quot;;
		
        var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
        var sRootLineId = Inputs.GetProperty(&quot;Root Line Item Id&quot;);
        var sNewRootId = Inputs.GetProperty(&quot;New Root Order Item Id&quot;);
		var sOrderType = Inputs.GetProperty(&quot;Order Sub Type&quot;);
				
		var sCreditCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;Credit Caps&quot;);
		var sVodafoneCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;Vodafone Caps&quot;);
		//NROY 20-Sep-2023 Added for eSIM Carrier App Trial Customer
		var sTrialSubscription = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;Trial Subscription&quot;);
		
		var sSiebelProdType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Hard Caps&quot;);
		var sGetModifyTypeOut = TheApplication().NewPropertySet();

        if(sOrderId != &quot;&quot; &amp;&amp; sRootLineId != &quot;&quot;) 
        {
			with(oOrderLineBC) 
			{
				ActivateField(&quot;Root Asset Integration Id&quot;);
				ActivateField(&quot;Custom Asset Integration Id&quot;);
				ActivateField(&quot;Special Rating List Type&quot;);
				ActivateField(&quot;VHA Spl Rating List Type Calc&quot;);
				ActivateField(&quot;Action Code&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				if(sOrderType == &quot;Change Proposition&quot; &amp;&amp; sNewRootId != &quot;&quot; &amp;&amp; sNewRootId != null) 
				{						
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND ([Id] = &apos;&quot; + sRootLineId + &quot;&apos; OR [Id] = &apos;&quot; + sNewRootId + &quot;&apos;)&quot;);
				}
				else
				{
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + sRootLineId + &quot;&apos;&quot;);
				}
				ExecuteQuery(ForwardOnly);
				var irec = FirstRecord();
				
				while(irec)
				{
					sActionCd = GetFieldValue(&quot;Action Code&quot;);
					if(sActionCd == &quot;Delete&quot;)
					{
						sFromPropType = GetFieldValue(&quot;VHA Spl Rating List Type Calc&quot;);
						sRootAssetInteg = GetFieldValue(&quot;Root Asset Integration Id&quot;);
						
					}
					else
					{
						if (sOrderType == &quot;Change Proposition&quot;) 
							sRootAssetInteg = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
						else
							sRootAssetInteg = GetFieldValue(&quot;Root Asset Integration Id&quot;);
						sSplSiebelRatingList = GetFieldValue(&quot;VHA Spl Rating List Type Calc&quot;);
						
					}
					irec = NextRecord();					
				}
				  
			} //line bc
			if((sRootAssetInteg != &quot;&quot;) &amp;&amp; (sRootAssetInteg!= null))
			{
				if(sFromPropType == sCreditCaps || sFromPropType == sVodafoneCaps)
				{
					sInactivateCapsRequired = &quot;Y&quot;;					
				}
				if(sSplSiebelRatingList == sCreditCaps || sSplSiebelRatingList == sVodafoneCaps || sSplSiebelRatingList == sTrialSubscription)
				{
					sActivateCapsRequired = &quot;Y&quot;;
				}						
						
				if(sOrderType == &quot;Change Proposition&quot;)
				{
					mUpdateOldAssetXMRRef(sOrderId,sRootLineId,sNewRootId);				
				}				
				else if(sOrderType == &quot;Modify&quot; &amp;&amp; sRootLineId != &quot;&quot; &amp;&amp; sActivateCapsRequired == &quot;Y&quot;)
				{
					mGetModifyType(sOrderId, sRootLineId, sGetModifyTypeOut);
					
					if (sGetModifyTypeOut.GetProperty(&quot;Booster&quot;) == &quot;Y&quot; || sGetModifyTypeOut.GetProperty(&quot;RPC&quot;) == &quot;Y&quot; || 
					sGetModifyTypeOut.GetProperty(&quot;IDD&quot;) == &quot;Y&quot;)
					{
						sInactivateCapsRequired = &quot;Y&quot;;
					}
					else
					{
						sActivateCapsRequired = &quot;N&quot;;
					}
					
					//To Handle the Booster and IDD scenerio.
					if(sGetModifyTypeOut.GetProperty(&quot;Booster&quot;) == &quot;Y&quot; &amp;&amp; sGetModifyTypeOut.GetProperty(&quot;IDD&quot;) == &quot;Y&quot;)
					{
						sGetModifyTypeOut.SetProperty(&quot;Booster&quot;,&quot;N&quot;);
						sGetModifyTypeOut.SetProperty(&quot;IDD&quot;,&quot;N&quot;);
					}
				}
				
				if (sInactivateCapsRequired == &quot;Y&quot; || sActivateCapsRequired == &quot;Y&quot;)
				{
				  sLOVBC.SetViewMode(AllView);
				  sLOVBC.ClearToQuery();
				  sLOVBC.ActivateField(&quot;Type&quot;);
				  sLOVBC.ActivateField(&quot;Name&quot;);
				  sLOVBC.ActivateField(&quot;Value&quot;);
				  sLOVBC.SetSearchSpec(&quot;Type&quot;, &quot;VHA_USAGE_PRODUCT&quot;);
				  sLOVBC.SetSearchSpec(&quot;Name&quot;,sSiebelProdType);
				  sLOVBC.ExecuteQuery(ForwardOnly);
				  isRec = sLOVBC.FirstRecord();
  
				  while(isRec)
				  {
					  StrProduct = sLOVBC.GetFieldValue(&quot;Value&quot;);
					  
					 
					   if(StrProduct !=&quot;&quot; &amp;&amp; StrProduct !=null)
					   {
						if(((sGetModifyTypeOut.GetProperty(&quot;Booster&quot;) == &quot;Y&quot; &amp;&amp; StrProduct != &quot;Data&quot;) || 
						(sGetModifyTypeOut.GetProperty(&quot;IDD&quot;) == &quot;Y&quot; &amp;&amp; StrProduct != &quot;IDD&quot;)) &amp;&amp; 
						sGetModifyTypeOut.GetProperty(&quot;RPC&quot;) != &quot;Y&quot;)
						{
							//Do Nothing
						}
						else
						{
							sGetModifyTypeOut.SetProperty(&quot;sInactivateCapsRequired&quot;,sInactivateCapsRequired);
							sGetModifyTypeOut.SetProperty(&quot;sActivateCapsRequired&quot;,sActivateCapsRequired);
							mCreateandUpdateHardcapsProducts(sRootAssetInteg,sOrderType,StrProduct,sGetModifyTypeOut);
						}
					   }					   
					isRec = sLOVBC.NextRecord();
				  }
				}
			}//if((sRootAssetInteg != &quot;&quot;) &amp;&amp; (sRootAssetInteg!= null))
        }//if(sOrderId != &quot;&quot;) 

    } //try
       
    catch (e) 
    {
        throw (e);

    } 
    finally 
    {
        oOrderLineBC = null;
        sLOVBC = null;
        oOrderBo = null;
		sGetModifyTypeOut = null;        
    }


}"
			   SEQUENCE="24"
			   UPDATED="10/10/2023 19:21:32"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateCapsDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateCapsDetails(Inputs)
{
 /*
     * Component Name        : 	VHA Hard Caps Procesing Service
     * Method Name/Fn         : mGetPreSubmitModify	
     * Component Information : 	
     * Modification History  :
     * Date			Author		Config #			Description
     * ============ ===========	===========			================================
     *  23-08-2018  Kailash   Hardcaps				This function will check if RPC/Booster/IDD added for order types
	 *  26-12-2018  Sathish   19.1 PKE#             IDD/Data in submit XML fixed for BAU to BAU and BAU to HC change prop scenarios
     */
	try
	{


		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sOrderItmId = Inputs.GetProperty(&quot;Root Line Item Id&quot;);
				
		var sOrderChgProp = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Proposition&quot;);
		var sOrderModify = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Modify&quot;);				
		var sDeconFrom = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Decon/Con Transfer FROM&quot;);
		var sChnDscnt = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Ownership Disconnect&quot;);
		
		var sDelActnCd = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;DELTA_ACTION_CODE&quot;, &quot;Deleted&quot;);		
		var sCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Hard Caps&quot;);
		var sVHACaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;Vodafone Caps&quot;);		
		
		var isRec=&apos;N&apos;, sRPC, sBooster, sIDD, sActnCd=&apos;&apos;, sRootActnCd=&apos;&apos;, isFirstRec=&apos;&apos;, sVal=&apos;&apos;, sRootSplType, sCustAstIntId=&apos;&apos;, sOrderType, sAll, sTotIDD ;
		var	oOrderBO = TheApplication().GetBusObject(&quot;VHA Throttle Order Details&quot;);
		var oOrderLineBC = oOrderBO.GetBusComp(&quot;VHA Order Item Throttle Sharing Group Details&quot;);				
		
		with (oOrderLineBC)
		{
			if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
			{

				ActivateField(&quot;Action Code&quot;);			
				ActivateField(&quot;Root Custom Asset Int Id&quot;);
				ActivateField(&quot;Display Reason&quot;);
				ActivateField(&quot;Root Order Item Action Code&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ActivateField(&quot;Root Special Siebel Type&quot;);
				ActivateField(&quot;VHA Service Order Sub Type&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				if(sOrderItmId !=&quot;&quot; &amp;&amp; sOrderItmId !=null)
				SetSearchSpec(&quot;Root Order Item Id&quot;, sOrderItmId);
				SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);			
				ExecuteQuery(ForwardOnly);
				isRec = FirstRecord();
				
				while(isRec)
				{				
					
					sActnCd = GetFieldValue(&quot;Action Code&quot;);
					sRootActnCd = GetFieldValue(&quot;Root Order Item Action Code&quot;);				
					sRootSplType = GetFieldValue(&quot;Root Special Siebel Type&quot;);
					sOrderType = GetFieldValue(&quot;VHA Service Order Sub Type&quot;);			
					var sCapsType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, sRootSplType);								
					sCustAstIntId = GetFieldValue(&quot;Root Custom Asset Int Id&quot;);				
					sOrderItmId = GetFieldValue(&quot;Root Order Item Id&quot;);			
					
					//SG 26-12-2018 Modified Below section for PKE# TOT/ConDecon scenario
					if((sOrderType == sDeconFrom || sOrderType == sChnDscnt )&amp;&amp; sRootSplType == sCapsType &amp;&amp; (sRootSplType !=&quot;&quot; &amp;&amp; sRootSplType != null))
					{

						var sGetModifyTypeOut = TheApplication().NewPropertySet();							
						if(sOrderItmId != &quot;&quot; &amp;&amp; sOrderItmId != null)
						{

						 mGetPreSubmitDetails(sOrderId, sOrderItmId, sOrderType, sGetModifyTypeOut,sCustAstIntId);
						//SG: Modified for PKE# Generic function for AddCapdetailsInSubmit used
						sAll = sGetModifyTypeOut.GetProperty(&quot;sAll&quot;);					
						var sNewRootId = sGetModifyTypeOut.GetProperty(&quot;NewRootId&quot;);

						if(sAll == &apos;AllUnbar&apos; || sAll == &apos;AllIDDbar&apos; || sAll == &apos;Booster&apos; || sAll == &apos;IDD&apos;)
						{
						AddCapDetailsInSubmit(sOrderItmId ,sAll,sCustAstIntId);
						
						}
	
						}
					}
				
					//SG 26-12-2018:Added Below section for PKE# change Prop scenario
					//if(sCapsType == &quot;&quot; &amp;&amp; (sOrderType == sOrderChgProp &amp;&amp; sCustAstIntId !=&quot;&quot; &amp;&amp;(sRootActnCd != sDelActnCd)))
					if(sRootSplType == sCapsType &amp;&amp; ( sRootSplType !=&quot;&quot; &amp;&amp; sRootSplType != null) &amp;&amp; sOrderType == sOrderChgProp &amp;&amp; sCustAstIntId !=&quot;&quot; &amp;&amp; sRootActnCd == sDelActnCd)
					{

						var sGetModifyTypeOut = TheApplication().NewPropertySet();
						//mGetPreSubmitChangeProp(sOrderId, sOrderItmId, sOrderType, sGetModifyTypeOut,sCustAstIntId);
						mGetPreSubmitDetails(sOrderId, sOrderItmId, sOrderType, sGetModifyTypeOut,sCustAstIntId);
						sAll = sGetModifyTypeOut.GetProperty(&quot;sAll&quot;);
						var sNewRootId = sGetModifyTypeOut.GetProperty(&quot;NewRootId&quot;);
						if(sAll == &apos;AllUnbar&apos; || sAll == &apos;AllIDDbar&apos; || sAll == &apos;Booster&apos; || sAll == &apos;IDD&apos;)
						{
						AddCapDetailsInSubmit(sNewRootId,sAll,sCustAstIntId);
						
						}
					 }

					//SG 26-12-2018 Modified Below section for PKE# modify scenario
					/*if ((sRootSplType == sCapsType &amp;&amp; sRootSplType != &quot;&quot; &amp;&amp; sRootSplType != null) &amp;&amp; ((sOrderType == sOrderChgProp &amp;&amp; sCustAstIntId !=&quot;&quot; &amp;&amp;(sRootActnCd != sDelActnCd)) || (sOrderType == sOrderModify &amp;&amp; sOrderItmId !=&apos;&apos; &amp;&amp; (sActnCd != sDelActnCd))))*/
					if (sRootSplType == sCapsType &amp;&amp; ( sRootSplType !=&quot;&quot; &amp;&amp; sRootSplType != null) &amp;&amp; sOrderType == sOrderModify &amp;&amp; sOrderItmId !=&apos;&apos; &amp;&amp; sActnCd != sDelActnCd)
					{
						var sGetModifyTypeOut = TheApplication().NewPropertySet();	
						if(sOrderItmId != &quot;&quot; &amp;&amp; sOrderItmId != null)
						{							
						mGetPreSubmitDetails(sOrderId, sOrderItmId, sOrderType, sGetModifyTypeOut,sCustAstIntId);
						sAll = sGetModifyTypeOut.GetProperty(&quot;sAll&quot;);

						if(sAll == &apos;AllUnbar&apos; || sAll == &apos;AllIDDbar&apos; || sAll == &apos;Booster&apos; || sAll == &apos;IDD&apos;)
						{
						AddCapDetailsInSubmit(sOrderItmId,sAll,sCustAstIntId );
						}


						}

					}			
		

				isRec = NextRecord();

		}				
		
        }
	}

}
	
	catch (e)
	{
		throw(e);
	}
	
	finally
	{
		//sLOVBC = null;
		oOrderLineBC = null;				
		oOrderBO = null;
		sGetModifyTypeOut = null;
	}
}"
			   SEQUENCE="25"
			   UPDATED="11/23/2020 19:23:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
