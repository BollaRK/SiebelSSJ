			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="AddCapDetailsInSubmit"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function AddCapDetailsInSubmit(sOrderItmId,sAll,sCustAstIntId)
{
 /*
     * Component Name        : 	VHA Hard Caps Procesing Service
     * Method Name/Fn         : mGetPreSubmitModify	
     * Component Information : 	
     * Modification History  :
     * Date			Author		Config #			Description
     * ============ ===========	===========			================================
     * 26-12-2018  Sathish   19.1 PKE#             IDD/Data in submit XML fixed for BAU to BAU and BAU to HC change prop scenarios
     */

	try
	{
		var sCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Hard Caps&quot;);
		var sVHACaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;Vodafone Caps&quot;);		
		var sBar = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HC_IDD_DEFAULT&quot;, &quot;Barred&quot;);
		var sUnbar = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HC_USAGE_STATUS&quot;, &quot;Unbarred&quot;);
		var sData = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;TT_AREA&quot;, &quot;Data&quot;);
		var sIDDVal = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;IDD&quot;);
		var isFirstRec ,sVal=&quot;&quot;;
		var oThrottleBC = TheApplication().GetBusObject(&quot;VHA Throttle Order&quot;).GetBusComp(&quot;VHA Throttle Details&quot;);		
						//mDeleteCapsDetails(sOrderItmId);
					
						var sLOVBC = TheApplication().GetBusObject(&quot;List Of Values&quot;).GetBusComp(&quot;List Of Values&quot;);
						with(sLOVBC)
						{
							ActivateField(&quot;Type&quot;);
							ActivateField(&quot;Name&quot;);
							ActivateField(&quot;Value&quot;);
							ActivateField(&quot;Sub Type&quot;);
							ClearToQuery();
							SetViewMode(AllView);

							if(sAll == &apos;AllUnbar&apos; || sAll == &apos;AllIDDbar&apos;)
							{
								SetSearchSpec(&quot;Type&quot;,&quot;VHA_USAGE_PRODUCT&quot;);
								SetSearchSpec(&quot;Name&quot;,sCaps);
							}
							else if(sAll == &apos;Booster&apos;)
							{
								SetSearchSpec(&quot;Type&quot;,&quot;VHA_USAGE_PRODUCT&quot;);
								SetSearchSpec(&quot;Sub Type&quot;, sData);
							}
							else if(sAll == &apos;IDD&apos;)
							{
								SetSearchSpec(&quot;Type&quot;,&quot;VHA_USAGE_PRODUCT&quot;);
								SetSearchSpec(&quot;Sub Type&quot;, sIDDVal);
							}
							ExecuteQuery(ForwardOnly);
							isFirstRec = FirstRecord();
							while(isFirstRec)
							{
								sVal = GetFieldValue(&quot;Value&quot;);
								with(oThrottleBC)
								{
									ActivateField(&quot;PCRF Expiry Date&quot;);
									ActivateField(&quot;Product&quot;);
									ActivateField(&quot;Status&quot;);
									NewRecord(NewAfter);
									if (sAll == &apos;AllUnbar&apos; || sAll == &apos;AllIDDbar&apos;)
									{
									mGetPCRFDate(sCustAstIntId);	
									SetFieldValue(&quot;PCRF Expiry Date&quot;, sExpiryDate);
									}
									else if (sAll == &apos;Booster&apos;)
									{
										mGetPCRFDate(sCustAstIntId);
										SetFieldValue(&quot;PCRF Expiry Date&quot;,sExpiryDate);
									}
									SetFieldValue(&quot;Product&quot;, sVal);
									if(sAll == &apos;AllUnbar&apos; || (sAll == &apos;AllIDDbar&apos; &amp;&amp; sVal == sData) || sAll == &apos;Booster&apos; || sAll == &apos;IDD&apos;)
									{
										SetFieldValue(&quot;Status&quot;, sUnbar);
									}
									else if(sAll == &apos;AllIDDbar&apos; &amp;&amp; sVal == sIDDVal)
										SetFieldValue(&quot;Status&quot;, sBar);
									SetFieldValue(&quot;Type&quot;, sCaps);
									SetFieldValue(&quot;Service Order Id&quot;, sOrderItmId);
									WriteRecord();
								}
								isFirstRec = NextRecord();	
							}
						}
					

}
catch(e)
{
throw(e);
}
finally
{
oThrottleBC = null;
}

}"
			   SEQUENCE="2"
