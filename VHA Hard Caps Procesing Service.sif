			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCapsAccessoryValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	   Description
 * ============ ===========	=============  =============================================================================================
 * 20/09/2018	Kailash 		18.4 HardCaps  Added for APP/Non App/Secondary device validation (if the asset belongs to Vodafone Caps)
 */
 
function mCapsAccessoryValidation(Inputs, Outputs)
{
	try
	{
		var sCustIntId = &quot;&quot;, sValidThrow = &quot;N&quot;;
		var sOrderid = Inputs.GetProperty(&quot;OrderId&quot;);	
		var sOrdFunction = Inputs.GetProperty(&quot;OrdFunction&quot;);
		var sSessionId = Inputs.GetProperty(&quot;SessionId&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcLineItem = boOrder.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);		
		var sVHACaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;Vodafone Caps&quot;);
		var sOrdFun = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_FUNCTION&quot;, &quot;UPGRADE&quot;);
		var bcAsset,bcUpgOffer,bcAPP,boAsset,bcAccessory;
		if(sOrderid != &quot;&quot;)
		{
			with(bcLineItem)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Custom Asset Integration Id&quot;);
				ActivateField(&quot;MSISDN&quot;);
				SetSearchSpec(&quot;Order Header Id&quot;, sOrderid);
				SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;is null&quot;);
				SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; &apos;Delete&apos;&quot;);
				SetSearchSpec(&quot;Special Product Type&quot;,sVHACaps);
				ExecuteQuery(ForwardOnly);
				var isrec = FirstRecord();
				while(isrec)
				{
					sCustIntId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
					var sMSISDN = GetFieldValue(&quot;MSISDN&quot;);
					if(sCustIntId != &quot;&quot; &amp;&amp; sCustIntId != null &amp;&amp; sOrdFunction == sOrdFun &amp;&amp; sSessionId != &quot;&quot;)
					{											
						bcAsset = boOrder.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
						bcUpgOffer = boOrder.GetBusComp(&quot;VF Upgrade Offer&quot;);
					    bcAPP = boOrder.GetBusComp(&quot;VHA Accessory Items Upgrade TBUI&quot;);						
						bcAsset.SetViewMode(AllView);
						bcAsset.ClearToQuery();	
						bcAsset.ActivateField(&quot;VHA Secondary Subscription Flg&quot;);
						bcUpgOffer.ActivateField(&quot;VHA APP Count Calc&quot;);
						bcUpgOffer.ActivateField(&quot;VHA Secondary Device Count Calc&quot;);						
						bcAPP.SetSearchSpec(&quot;Status&quot;,&quot;In Process&quot;);						
						bcAsset.SetSearchSpec(&quot;Integration Id&quot;,sCustIntId);		
						bcUpgOffer.SetSearchSpec(&quot;Wizard Session Id&quot;,sSessionId);							
						bcAsset.ExecuteQuery(ForwardOnly);
						if(bcAsset.FirstRecord())
						{
							if(bcAsset.GetFieldValue(&quot;VHA Secondary Subscription Flg&quot;) == &quot;Y&quot;)	
								sValidThrow = &quot;Y&quot;;
							else if(bcUpgOffer.GetFieldValue(&quot;VHA APP Count Calc&quot;)&gt;0 || bcUpgOffer.GetFieldValue(&quot;VHA Secondary Device Count Calc&quot;) &gt;0)
								sValidThrow = &quot;Y&quot;;								
							else if(bcAPP.FirstRecord() == true)
								sValidThrow = &quot;Y&quot;;
						}											
					}					
					else if(sCustIntId != &quot;&quot; &amp;&amp; sCustIntId != null)
					{
						boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
					    bcAsset = boAsset.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
						bcAsset.SetViewMode(AllView);
						bcAsset.ClearToQuery();	
						bcAsset.ActivateField(&quot;VHA Secondary Subscription Flg&quot;);
						bcAsset.SetSearchSpec(&quot;Integration Id&quot;,sCustIntId);						
						bcAsset.ExecuteQuery(ForwardOnly);

						if(bcAsset.FirstRecord())
						{
							if(bcAsset.GetFieldValue(&quot;VHA Secondary Subscription Flg&quot;) == &quot;Y&quot;)
								sValidThrow = &quot;Y&quot;;
							else 
							{
								var sAssetId = bcAsset.GetFieldValue(&quot;Id&quot;);
								bcAccessory = boAsset.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
								var strSearchExpr = &quot;[Contract End Date] &gt;= Today() AND [Status] = &apos;Active&apos; AND [Root Asset Id] = &apos;&quot; + sAssetId + &quot;&apos;&quot;;
								bcAccessory.SetViewMode(AllView);
								bcAccessory.ClearToQuery();	
								bcAccessory.SetSearchExpr(strSearchExpr);
								bcAccessory.ExecuteQuery(ForwardOnly);
							
								if(bcAccessory.FirstRecord() == true)
									sValidThrow = &quot;Y&quot;;
							}
						}							
					}
					if(sValidThrow == &quot;Y&quot;)
					{
						TheApplication().RaiseErrorText(&quot;MSISDN # &quot; + sMSISDN + &quot; Please cancel / terminate all the Active APP Contract, Please remove all the new APP Accessories and Secondary Devices purchased, and Please disconnect the Secondary Subscription to purchase the Vodafone Cap Plan.&quot;);
					}
					isrec = NextRecord();
				}
			}
		}
	}
	
	catch(e)
	{
		throw (e);
	}
	
	finally
	{		
		bcAPP = null;
		bcUpgOffer = null;
		bcAsset = null;
		bcLineItem = null;
		bcAccessory = null;
		boOrder = null;
		boAsset = null;
	}
}"
			   SEQUENCE="5"
			   UPDATED="05/20/2019 23:31:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckAmazonPrimeSubscription"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Jaya - created for Nov Rel-Amazon Prime - 23/10/2020
function mCheckAmazonPrimeSubscription(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oLineItemBC = oBO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
	
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sRootLineId = Inputs.GetProperty(&quot;Root Order Line Item Id&quot;);
		var sNewRootId = Inputs.GetProperty(&quot;New Root Order Item Id&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;OrderSubType&quot;);
	
		var strOldAssetId = Inputs.GetProperty(&quot;Asset Id&quot;);
		var sBillAccId = Inputs.GetProperty(&quot;Old Billing Account Id&quot;);
	
		var sRecExist,sPrimeElig;
	
		var sOrderChgProp = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Change Proposition&quot;);
		var sOrderConnect = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Connect&quot;);
		var sOrderModify = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;, &quot;Modify&quot;);
	
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			with(oLineItemBC)
			{
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Special Rating List Type&quot;);
				ActivateField(&quot;Vendor Part Number&quot;);
				ActivateField(&quot;Action Code&quot;);
				SetViewMode(AllView);
				ClearToQuery();				
				if(sNewRootId != &quot;&quot; &amp;&amp; sNewRootId != null &amp;&amp; sOrderSubType == sOrderChgProp)
				{
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sNewRootId + &quot;&apos; AND [Action Code] = &apos;Add&apos;AND [Special Rating List Type] = &apos;Prime Subscription&apos;&quot;);
				}
				else if(sOrderSubType == sOrderConnect || sOrderSubType == sOrderModify)
				{
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sRootLineId + &quot;&apos; AND [Action Code] = &apos;Add&apos; AND [Special Rating List Type] = &apos;Prime Subscription&apos;&quot;);
				}
				ExecuteQuery(ForwardOnly);
				sRecExist = FirstRecord();
				if(sRecExist)
				{
				//	var sPrime = GetFieldValue(&quot;Special Rating List Type&quot;);
					var sVendPrtNum = GetFieldValue(&quot;Vendor Part Number&quot;);
					var sProdName = GetFieldValue(&quot;Product&quot;);
	
					sPrimeElig = &quot;Y&quot;;
	
					/*if((sPrime != null || sPrime != &quot;&quot;) &amp;&amp; sPrime == &quot;Prime Subscription&quot;)
					{
						sPrimeElig = &quot;Y&quot;;
					}*/
	
					if(sPrimeElig == &quot;Y&quot;)
					{
						//Outputs.SetProperty(&quot;sPrimeEligible&quot;, sPrimeElig);
						Outputs.SetProperty(&quot;PrimeEligible&quot;, sPrimeElig);
						Outputs.SetProperty(&quot;Product&quot;, sProdName);
						Outputs.SetProperty(&quot;SAMId&quot;, sVendPrtNum);
					}	
					else
					{
						Outputs.SetProperty(&quot;sPrimeEligible&quot;, &quot;&quot;);
					}
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oLineItemBC = null;
		oBO = null;
	}
}"
