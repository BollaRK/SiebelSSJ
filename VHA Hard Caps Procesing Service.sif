			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckifCreditCapPropAdded"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VHA Hard Caps Procesing Service
 * Function Name         : 	mCheckifCreditCapPropAdded
 * Component Information : 	This function checks if any Hard cap propositions added to specific order.
 *							
 * Inputs				 : Order Id
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/07/2018	Kathambari		Initial Version
 */
function mCheckifCreditCapPropAdded(Inputs,Outputs)
{
try
{
var	CapPropPresent = &quot;N&quot;;
var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var psInputs = TheApplication().NewPropertySet();
var psOutputs = TheApplication().NewPropertySet();
var BO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
var BC = BO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
var SubTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;,&quot;Change Proposition&quot;);
var ModifyLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;,&quot;Modify&quot;);
var sTOT = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_SUB_TYPE&quot;,&quot;Change Ownership Connect&quot;);

var LOVBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
var LOVBC  = LOVBO.GetBusComp(&quot;List Of Values&quot;);
with (LOVBC)
{
	ActivateField(&quot;Value&quot;);
	ClearToQuery();
	SetViewMode(AllView);
	SetSearchExpr(&quot;[Type] = &apos;VHA_HARD_CAP_SPL_PROD_TYPE&apos;&quot;);
	ExecuteQuery(ForwardOnly);
	var frec = FirstRecord();
	while(frec)
	{
		var CapProdTypeLOV = GetFieldValue(&quot;Value&quot;);
		if(OrderId != &quot;&quot;)
		{
		with(BC)
		{
		ActivateField(&quot;Special Rating List Type&quot;);
		ActivateField(&quot;Action Code&quot;);
		ActivateField(&quot;VF Service Order Sub Type&quot;);
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchExpr(&quot;[Root Order Item Id] = [Id] AND [Order Header Id] = &apos;&quot; + OrderId + &quot;&apos;&quot;);
		ExecuteQuery(ForwardOnly);
		var recExits = FirstRecord();
			while(recExits)
			{
				if(CapPropPresent == &quot;N&quot;)
				{	
					var SubType = GetFieldValue(&quot;VF Service Order Sub Type&quot;);
					var SplSiebelProdType = GetFieldValue(&quot;Special Rating List Type&quot;);
					if((SubType == SubTypeLOV &amp;&amp; SplSiebelProdType == CapProdTypeLOV) ||(SubType == ModifyLOV &amp;&amp; SplSiebelProdType == CapProdTypeLOV))
					{
						var actioncode = GetFieldValue(&quot;Action Code&quot;);
						Outputs.SetProperty(&quot;Actioncode&quot;,actioncode);
						Outputs.SetProperty(&quot;SubType&quot;,SubType);
						if(actioncode == &quot;Add&quot;)
						{
							CapPropPresent = &quot;Y&quot;;
						}
					}
					else if(SplSiebelProdType == CapProdTypeLOV)
					{
					   CapPropPresent = &quot;Y&quot;
					}
					recExits = NextRecord();
				}
				else
				{
					break;
				}
			}
		}
		}
		
		frec = NextRecord();
		
		
	}

	Outputs.SetProperty(&quot;CapPropPresent&quot;,CapPropPresent);
	psInputs.SetProperty(&quot;OrderId&quot;,OrderId);
	mIsMoreThanOneServiceAdded(psInputs,psOutputs);
	var ServiceLimitExceeds = psOutputs.GetProperty(&quot;ServiceLimitExceeds&quot;);
	Outputs.SetProperty(&quot;ServiceLimitExceeds&quot;,ServiceLimitExceeds);
	
}


}
catch(e)
{
throw(e);
}
finally
{
OrderId = null;
BC = null;
BO = null;
LOVBC = null;
LOVBO = null;

}

}"
			   SEQUENCE="11"
			   UPDATED="11/23/2020 19:23:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateandUpdateHardcapsProducts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateandUpdateHardcapsProducts(sRootAssetInteg,sOrderType,StrProduct,sGetModifyTypeOut) 
{
    /*
     * Component Name        :  VHA Hardcaps Processing Service
     * Method Name               :  mCreateandUpdateHardcapsProducts
     * Component Information :  This fn is to create new Hardcaps Products under asset
     * Modification History  :
     * Date   Author  Config #   Description
     * ============ =========== ===========   ================================
     *  23-03-2018   Vinodhini    HardCaps
     */

    try 
    {
        //Object Declarations
        var oAssetBo = TheApplication().GetBusObject(&quot;VF Asset&quot;);
        var oAssetBC = oAssetBo.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
        var oAssetXM = oAssetBo.GetBusComp(&quot;VHA Current Processing Status BC&quot;);

        var dtToday = new Date;
        var sFormattedTodayDate = (dtToday.getMonth() + 1) + &quot;/&quot; + dtToday.getDate() + &quot;/&quot; + dtToday.getFullYear();
        var sFormattedTodayDateTime = sFormattedTodayDate + &quot; &quot; + dtToday.getHours() + &quot;:&quot; + dtToday.getMinutes() + &quot;:&quot; + dtToday.getSeconds();
        var sTransactionStatus = &quot;&quot;;
		var sProdType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Hard Caps&quot;);
        var sChannel = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CHANNEL_TP&quot;, &quot;CRM&quot;);
		var sCompletedStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USAGE_PRODUCT_STATUS&quot;, &quot;Completed&quot;);
		var sInprogressStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USAGE_PRODUCT_STATUS&quot;, &quot;In Progress&quot;);
        var sInactiveStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USAGE_PRODUCT_STATUS&quot;, &quot;Inactive&quot;);
		var sFailedStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USAGE_PRODUCT_STATUS&quot;, &quot;Failed&quot;);
		var sUnbar = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HC_USAGE_STATUS&quot;,&quot;Unbarred&quot;);
		var sbar = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HC_USAGE_STATUS&quot;,&quot;Barred&quot;);
		var sIDDInput = TheApplication().NewPropertySet();
		var sIDDOut = TheApplication().NewPropertySet();
	
		var InactivateCaps = sGetModifyTypeOut.GetProperty(&quot;sInactivateCapsRequired&quot;);
		var ActivateCaps = sGetModifyTypeOut.GetProperty(&quot;sActivateCapsRequired&quot;);

        with(oAssetBC) 
        {
            SetViewMode(AllView);
            ClearToQuery();
            SetSearchSpec(&quot;Integration Id&quot;, sRootAssetInteg);
            ExecuteQuery(ForwardOnly);

            var isAssetRec = FirstRecord();
            if (isAssetRec) 
            {
                var sAssetId = GetFieldValue(&quot;Id&quot;);
                with(oAssetXM) 
                {
					ActivateField(&quot;Asset Id&quot;);
					ActivateField(&quot;Asset Integration Id&quot;);
					ActivateField(&quot;Service&quot;);
					ActivateField(&quot;Current Status&quot;);
					ActivateField(&quot;Transaction Status&quot;);
					ActivateField(&quot;Reason Code&quot;);
					ActivateField(&quot;Processed Date&quot;);
					ActivateField(&quot;Type&quot;);
					ActivateField(&quot;Channel&quot;);
					ActivateField(&quot;Inactivated Date&quot;);
					SetViewMode(AllView);
					//Vinodhini-09/10/2018-Added order type condition to inactivate already created Products while reprocessing.
					if (InactivateCaps == &quot;Y&quot; || sOrderType == &quot;Connect&quot; ||sOrderType == &quot;Change Ownership Connect&quot; || sOrderType == &quot;Reactivate&quot; || sOrderType == &quot;Decon/Con Transfer TO&quot;)
					{
						ClearToQuery();
						var strSearchExpr1 = &quot;[Asset Integration Id] = &apos;&quot; + sRootAssetInteg + &quot;&apos; AND &quot; + &quot;[Service] = &apos;&quot; + StrProduct + &quot;&apos; AND (([Transaction Status] = &apos;&quot; + sCompletedStatus + &quot;&apos;) OR ([Transaction Status] = &apos;&quot; + sInprogressStatus + &quot;&apos;))&quot;;
						SetSearchExpr(strSearchExpr1);
						ExecuteQuery(ForwardOnly);
						var isPassesRec = FirstRecord();					
					//Below logic will add passes							
						while(isPassesRec)
						{
							
							sTransactionStatus = GetFieldValue(&quot;Transaction Status&quot;);
							
							if (sTransactionStatus == sCompletedStatus)
							{
								SetFieldValue(&quot;Transaction Status&quot;, sInactiveStatus);
								SetFieldValue(&quot;Inactivated Date&quot;, sFormattedTodayDateTime);
							}
							if(sTransactionStatus == sInprogressStatus)
							{
								SetFieldValue(&quot;Transaction Status&quot;, sFailedStatus);
							}
								SetFieldValue(&quot;Reason Code&quot;, sOrderType);
								WriteRecord();
								
								isPassesRec = NextRecord();
						}//isPassesRec = NextRecord();		
					}
					
					if(ActivateCaps == &quot;Y&quot;)
					{
						//FnCall is to decide the Current Status Of IDD Product
						if(StrProduct == &quot;IDD&quot;)
						{
							if (sOrderType == &quot;Change Proposition&quot; &amp;&amp; gNewAssetId != &quot;&quot;) 
							{
							sIDDInput.SetProperty(&quot;Asset Id&quot;,gNewAssetId);
							}
							else
							sIDDInput.SetProperty(&quot;Asset Id&quot;,sAssetId);
						
							mGetCurrentStatusForIDD(sIDDInput,sIDDOut);
						}
					   
						NewRecord(NewAfter);
						if (sOrderType == &quot;Change Proposition&quot; &amp;&amp; gNewAssetId != &quot;&quot;) 
						{
						SetFieldValue(&quot;Asset Id&quot;, gNewAssetId);
						}
						SetFieldValue(&quot;Asset Integration Id&quot;, sRootAssetInteg);
						SetFieldValue(&quot;Service&quot;,StrProduct);
						if(sIDDOut.GetProperty(&quot;IDDExists&quot;) == &quot;Y&quot; || StrProduct != &quot;IDD&quot;)
						SetFieldValue(&quot;Current Status&quot;,sUnbar);
						else
						SetFieldValue(&quot;Current Status&quot;,sbar);
						SetFieldValue(&quot;Transaction Status&quot;,sCompletedStatus);
						SetFieldValue(&quot;Reason Code&quot;,sOrderType);
						SetFieldValue(&quot;Processed Date&quot;,sFormattedTodayDateTime);
						SetFieldValue(&quot;Type&quot;,sProdType);
						SetFieldValue(&quot;Channel&quot;,sChannel);
						WriteRecord();
					}										            
                }//with(oAssetXM) 

            }//isAssetRec

        }//with(oAssetBC) 

    } //try
    catch (e) 
    {
        throw (e);
    } 
    finally 
    {

        oAssetXM = null;
        oAssetBC = null;
        oAssetBo = null;
        sIDDInput = null;
        sIDDOut  = null;
    }

}"
			   SEQUENCE="13"
			   UPDATED="11/23/2020 19:23:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/01/2018 13:56:00"
			   CREATED_BY="SADMIN">
