			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPCRFDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Written by Kailash for getting PCRF End Date for submit XMl.

function mGetPCRFDate(sCustAstIntId)
{
 try
 {

  var oBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
  var oBC = oBO.GetBusComp(&quot;VHA Current Processing Status BC&quot;);
  var sdata = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;TT_AREA&quot;, &quot;Data&quot;);

  if(sCustAstIntId != &quot;&quot; &amp;&amp; sdata != &quot;&quot;)
  {

   with (oBC)
   {
    ActivateField(&quot;Asset Integration Id&quot;);  
    ActivateField(&quot;Expiry Date&quot;); 
    ActivateField(&quot;Service&quot;);
    SetViewMode(AllView);
    ClearToQuery();
    SetSearchSpec(&quot;Asset Integration Id&quot;,sCustAstIntId);
    SetSearchSpec(&quot;Service&quot;,sdata);
    ExecuteQuery(ForwardOnly);
    if(FirstRecord())
{

     sExpiryDate = GetFieldValue(&quot;Expiry Date&quot;);
}

   }
  }
 }
 
 catch(e)
 {
  throw(e);
 }
 
 finally
 {
  oBC = null;
  oBO = null;
 }
}"
