			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckCapsEnable"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	   Description
 * ============ ===========	=============  ==================================================================
 * 05/07/2018	Kailash 		18.4 HardCaps  Invoked for Button Enable/Disable functionality @ Asset/CA/BA level
 */

function mCheckCapsEnable(Inputs, Outputs)
{	
	try
	{
		var sCARowId = &quot;&quot;, sBARowId = &quot;&quot;, sAssetId = &quot;&quot;, sAssetCheck = &quot;&quot;, sAccntCheck = &quot;&quot;,sCreditDateCheck = &quot;&quot;; 
		var sCreditClass = &quot;&quot;, sCreditModDate = &quot;&quot;;
		var sAssetBO, sAssetBC, sFinanProfBO, sFinanProfBC;
		var Inps, Outs;
				
		sCARowId = Inputs.GetProperty(&quot;CARowId&quot;);
		sAssetCheck = Inputs.GetProperty(&quot;sAssetCheck&quot;);
		sAccntCheck = Inputs.GetProperty(&quot;sAccntCheck&quot;);
		sCreditClass = Inputs.GetProperty(&quot;sCreditClass&quot;);
		sCreditModDate = Inputs.GetProperty(&quot;sCreditModDate&quot;); 
		sAssetId = Inputs.GetProperty(&quot;sAssetId&quot;);	
			
		
		if(sCARowId != &quot;&quot; || sCARowId != null)
		{			
			if(sAssetCheck != &quot;Y&quot;)
			{								
				sAssetBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
				sAssetBC = sAssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
				with(sAssetBC)
				{
					ActivateField(&quot;Service Account Id&quot;);				
					ActivateField(&quot;VHA Hard Caps&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Service Account Id&quot;,sCARowId);
					SetSearchSpec(&quot;Status&quot;,&quot;Active&quot;);
					SetSearchSpec(&quot;Id&quot;,sAssetId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{						
						var sCaps = GetFieldValue(&quot;VHA Hard Caps&quot;);
						var sVodCaps = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;Vodafone Caps&quot;);
						var xClass = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, sCaps);								
						if((sCaps == xClass) &amp;&amp; (sCaps != sVodCaps))										
							sAssetCheck = &quot;DISABLE&quot;;
					}
				}
			}
			if(sAccntCheck != &quot;Y&quot;)
			{				
				sFinanProfBO = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
				sFinanProfBC = sFinanProfBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
				with(sFinanProfBC)
				{
					ActivateField(&quot;Account Id&quot;);
					ActivateField(&quot;Credit Update Date&quot;);					
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Account Id&quot;,sCARowId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{						
						sCreditClass = GetFieldValue(&quot;VF Credit Class&quot;);
						if(sCreditClass != &quot;&quot;)
						{						
							var xClass = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_HARD_CAP_CC&quot;, sCreditClass);						
							sCreditModDate = GetFieldValue(&quot;Credit Update Date&quot;);												
							if(sCreditClass == xClass)							
								sAccntCheck = &quot;DISABLE&quot;;
						}
					}	
				}
			}
			
			if(sCreditDateCheck != &quot;Y&quot;)
			{				
				Inps = TheApplication().NewPropertySet();
				Outs = TheApplication().NewPropertySet();
				Inps.SetProperty(&quot;CreditChkDate&quot;,sCreditModDate);
				Inps.SetProperty(&quot;CreditClass&quot;,sCreditClass);
				fnCreditCheckValidation(Inps,Outs);
																			
			}						
		}	

		Outputs.SetProperty(&quot;DateEnable&quot;,sCreditCheckFlg);
		
		if(sAccntCheck == &quot;Y&quot; || sAccntCheck == &quot;DISABLE&quot;)
			Outputs.SetProperty(&quot;AccountEnable&quot;,&quot;DISABLE&quot;);
		else
			Outputs.SetProperty(&quot;AccountEnable&quot;,&quot;ENABLE&quot;);
		if(sAssetCheck == &quot;Y&quot; || sAssetCheck == &quot;DISABLE&quot;)
			Outputs.SetProperty(&quot;AssetEnable&quot;,&quot;DISABLE&quot;);
		else
			Outputs.SetProperty(&quot;AssetEnable&quot;,&quot;ENABLE&quot;);
			
		
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sFinanProfBC = null;
		sAssetBC = null;
		sFinanProfBO = null;
		sAssetBO = null;
		Inps = &quot;&quot;;
		Outs = &quot;&quot;;
	}
}"
			   SEQUENCE="7"
