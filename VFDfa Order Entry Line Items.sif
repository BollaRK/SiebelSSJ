			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{
	ActivateField(&quot;VF Order Sub Type TBUI&quot;);
	if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) == null)
	{
		var sRootItemId = this.GetFieldValue(&quot;Root Order Item Id&quot;);
		TheApplication().SetProfileAttr(&quot;gVF_ROOT_ID&quot;,sRootItemId);
		var sRootActionCode = this.GetFieldValue(&quot;Root Action Code&quot;);
		TheApplication().SetProfileAttr(&quot;gVF_ROOT_ACTION_CODE&quot;,sRootActionCode);
	}
}"
