			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
/*
 * Component Name        : 	Order Entry - Line Items
 * Method Name           : 	BusComp_PreInvokeMethod
 * Component Information : 	Triggers functions based on this bus comp.
 *							Methods are mostly supported using User Properties
 *							but extra code to support enabling/disabling of 
 *							buttons, record refreshs &amp; error handling is here.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 16/03/2005	PK			W2			Initial Version
 * 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
	// Error Handling declarations
	var psErrorInput;
	var psErrorOutput;
	var bsError;	
	var strError = &quot;&quot;;
	// Return value
	var iReturnValue;
	var sRenewModemErrFlg = &quot;N&quot;;
	try
	{
		// trace stmt - exclude IsActive since WebApplet_PreCanInvoke calls it a billion times
		if ((TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) &amp;&amp; (MethodName != &quot;IsActive&quot;))
		{
			TheApplication().Trace(&quot;START:Order Entry - Line Items.PreInvokeMethod.MethodName=&quot; + MethodName);
		}		
		switch (MethodName)
		{
			//UNISIM MSISDN Deallocation
			case &quot;DeallocateNewMSISDNUniSIM&quot;:
				ActivateField(&quot;New MSISDN Id&quot;);
				if(GetFieldValue(&quot;New MSISDN Id&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;New MSISDN Id&quot;) != null)
				{
					mDeallocateMSISDN();
					iReturnValue = CancelOperation;
				}
				break;
				//vasavi added below case for moconsq	
			case &quot;OverrideCoverageCheck&quot;:
				var sLoginName = TheApplication().GetProfileAttr(&quot;Login Name&quot;);
				this.ParentBusComp().ActivateField(&quot;FWA Override User ID&quot;);
				this.ParentBusComp().SetFieldValue(&quot;FWA Override User ID&quot;,sLoginName);
				this.ParentBusComp().WriteRecord();
				TheApplication().SetProfileAttr(&quot;TestAddr&quot;,sLoginName);
				iReturnValue = CancelOperation;
			break;	
			//end Vasavi added for moocnsq			
			
			
			// Requests that run workflows need a refresh record to display the changes they make
			case &quot;DeallocateNewMSISDN&quot;:
				ActivateField(&quot;VF Order Sub Type TBUI&quot;);
				if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != null)
				{
				    mDeallocateMSISDN();
				   	iReturnValue = CancelOperation;
				}
				else
				{
					try
					{
						this.InvokeMethod(MethodName + &quot;OK&quot;);
						if(TheApplication().ActiveViewName() == &quot;VF Order Entry - Pending Transfer Number Request View&quot;)
						{
							this.ParentBusComp().SetFieldValue(&quot;VF Fulfilment Message Flag&quot;,&quot;&quot;);
							this.ParentBusComp().WriteRecord();
						}
						refreshScreen();
						iReturnValue = CancelOperation;
					}
					catch(e)
					{
						refreshScreen();
						throw (e);
					}
				}
				break;
			case &quot;DeallocateSIM&quot;:
				ActivateField(&quot;VF Order Sub Type TBUI&quot;);
				if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != null)
				{
					try
					{
						//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
						mDeallocateSIM();
						var psInputs,psOutputs,bsInvokeBS;
						psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;OrderLineItemId&quot;, this.GetFieldValue(&quot;Id&quot;));
						bsInvokeBS = TheApplication().GetService(&quot;VF Postpay Utilities TBUI&quot;);
						refreshScreen();
						bsInvokeBS.InvokeMethod(&quot;NullifySIM&quot;, psInputs, psOutputs);
						//this.SetFieldValue(&quot;VF SIM TBUI&quot;,&quot;&quot;);*/
						refreshScreen();
						iReturnValue = CancelOperation;
					}	
					catch(e)
					{
						throw (e);
					}
				}
				break;
			case &quot;DeallocateIMEI&quot;:
				ActivateField(&quot;VF Order Sub Type TBUI&quot;);
				if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != null)
				{
					try
					{
						TheApplication().SetProfileAttr(&quot;TBUIDEALLOCATEIMEI&quot;,&quot;Y&quot;);
						var psInputs,psOutputs,bsInvokeWorkflow;
			            psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM DeAllocate IMEI TBUI&quot;);
						psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						psInputs.SetProperty(&quot;RootOrderItemId&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));
						bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						refreshScreen();
						bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
						refreshScreen();
						iReturnValue = CancelOperation;
						
					}
					catch(e)
					{
						throw (e);
					}
				
				}//end of if
				else if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) == &quot;&quot; &amp;&amp; GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;)
				{
					try
					{
						TheApplication().SetProfileAttr(&quot;TBUIDEALLOCATEIMEI&quot;,&quot;Y&quot;);
						var psInputs,psOutputs,bsInvokeWorkflow;
			            psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM DeAllocate IMEI TBUI&quot;);
						psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						psInputs.SetProperty(&quot;RootOrderItemId&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));
						bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						refreshScreen();
						bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
						refreshScreen();
						iReturnValue = CancelOperation;
					}
					catch(e)
					{
						throw (e);
					}
				}//end of else if
				else
				{
					iReturnValue = CancelOperation;		
				}
				//Added for Reusemodem nullify Defect fix 2426
				this.ActivateField(&quot;VF Reuse Modem Flg&quot;);
				if(this.GetFieldValue(&quot;VF Reuse Modem Flg&quot;) == &quot;Y&quot;);
				{
					var sReuseIMEIRootLine = &quot;&quot;;
					this.ActivateField(&quot;Root Order Item Id&quot;);
					sReuseIMEIRootLine = this.GetFieldValue(&quot;Root Order Item Id&quot;);
					NullifyReuseFlg(sReuseIMEIRootLine)
				}
				break;
			/*case &quot;eSIMAllocate&quot;:
				try
				{
					var psInputs,psOutputs,bsInvokeWorkflow;
		            psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					this.ParentBusComp().ActivateField(&quot;VHA Confirmation Code&quot;)
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
					psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;RequestId&quot;, this.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
					psInputs.SetProperty(&quot;Confirmation Code&quot;,this.ParentBusComp().GetFieldValue(&quot;VHA Confirmation Code&quot;));
					psInputs.SetProperty(&quot;Action Code&quot;, &quot;Allocate&quot;);
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					//refreshScreen();
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
					this.WriteRecord();
					refreshScreen();
					iReturnValue = CancelOperation;					
				}
				catch(e)
				{
					throw(e);
				}
			break;*/
			case &quot;eSIMAllocate&quot;:			
				iReturnValue = CancelOperation;	
				
			break;
			
			//Sakthi: 14/10 Added for Reuse Modem
			case &quot;ReuseModem&quot;:
				try
				{
					var sStatus = &quot;&quot;;
					var sReuseOrderLine = &quot;&quot;;
					var sReuseOrder = &quot;&quot;;
					sRenewModemErrFlg = &quot;Y&quot;;
					TheApplication().SetProfileAttr(&quot;VFReuseModemFlg&quot;,&quot;Y&quot;);
					this.ActivateField(&quot;VF COL COT Asset Info&quot;);
					this.ActivateField(&quot;Shipping&quot;);
					this.ActivateField(&quot;Root Order Item Id&quot;);
					this.ActivateField(&quot;Order Header Id&quot;);
					sReuseOrderLine = this.GetFieldValue(&quot;Root Order Item Id&quot;);
					sReuseOrder = this.GetFieldValue(&quot;Order Header Id&quot;);
					var sCAssetInfo = this.GetFieldValue(&quot;VF COL COT Asset Info&quot;);
					var sSIMType = this.GetFieldValue(&quot;Shipping&quot;);
					var sSIMTypePhysical = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;Physical&quot;);
					var sSIMTypeeSIM = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;eSIM&quot;);
					var sSIMDownload = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SIM&quot;, &quot;QR Code&quot;);
					var sCAssetArray = sCAssetInfo.split(&quot;|&quot;);
					var sOldMSISDN = sCAssetArray[2];
					var sValidateReuseModem = ValidateReuseModem(sCAssetArray[1]);	
					if(sValidateReuseModem == null ||  sValidateReuseModem == &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;The selected service does not have a Vodafone managed modem&quot;);
					}
					else
					{
					    this.SetFieldValue(&quot;VF IMEI TBUI&quot;,sValidateReuseModem);
						if(sSIMType == sSIMTypePhysical)
						{
							var sValidateSIMReuse = ValidateSIMReuseModem(sCAssetArray[1],sReuseOrder,sReuseOrderLine);
							this.SetFieldValue(&quot;VF SIM TBUI&quot;,sValidateSIMReuse);
						}
						else if(sSIMType == sSIMTypeeSIM)
						{
							this.SetFieldValue(&quot;eSIM Download&quot;,sSIMDownload);
							var opsInputs,opsOutputs,obsInvokeBS;
							opsInputs = TheApplication().NewPropertySet();
							opsOutputs = TheApplication().NewPropertySet();
							opsInputs.SetProperty(&quot;OrderId&quot;, sReuseOrder);
							opsInputs.SetProperty(&quot;ServiceOrderId&quot;, sReuseOrderLine);
							obsInvokeBS = TheApplication().GetService(&quot;VHA Fibre Upgrade Processing Ext Service&quot;);
							obsInvokeBS.InvokeMethod(&quot;AutoAllocateSIM&quot;, opsInputs, opsOutputs);
						}
						this.WriteRecord();
						var psInputs,psOutputs,bsInvokeBS;
						psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;OrderId&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;NetworkProviderName&quot;, this.GetFieldValue(&quot;NetworkProviderName&quot;));
						psInputs.SetProperty(&quot;Device&quot;, this.GetFieldValue(&quot;VF Handset Code TBUI&quot;));
						psInputs.SetProperty(&quot;StockIndicator&quot;, this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;));
						psInputs.SetProperty(&quot;IMEI&quot;, this.GetFieldValue(&quot;VF IMEI TBUI&quot;));
						bsInvokeBS = TheApplication().GetService(&quot;VHA Fibre Connect Processing Service&quot;);
						bsInvokeBS.InvokeMethod(&quot;mAddModemLineItems&quot;, psInputs, psOutputs);
						sStatus = psOutputs.GetProperty(&quot;Status&quot;);
					if (sStatus == &quot;2 Products Added succesfully&quot; || sStatus == &quot;All Product Added succesfully&quot;)
					{
						if(sReuseOrderLine != null &amp;&amp; sReuseOrderLine != &quot;&quot;)
						{
							UpdateReuseFlg(sReuseOrderLine,sOldMSISDN);
						}
						this.WriteRecord();
						this.InvokeMethod(&quot;RefreshRecord&quot;);
						iReturnValue = CancelOperation;
					}
					else if(sStatus == &quot;No Product Added&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Modem is not compatible with the target Network provider&quot;);
						iReturnValue = CancelOperation;
					}
					}
					TheApplication().SetProfileAttr(&quot;VFReuseModemFlg&quot;,&quot;&quot;);
				}
				catch(e)
				{
					TheApplication().SetProfileAttr(&quot;VFReuseModemFlg&quot;,&quot;&quot;);
					throw (e);
				}
				finally
				{
					TheApplication().SetProfileAttr(&quot;VFReuseModemFlg&quot;,&quot;&quot;);
					psInputs = null;
					psOutputs = null;
				}
			break;		
					
			default:
				iReturnValue = ContinueOperation;
			break;
		}
		return (iReturnValue);
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			strError = e.toString(); 
		}

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Line Items BC&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_PreInvokeMethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		//TheApplication().RaiseErrorText(strError);
		if(sRenewModemErrFlg == &quot;Y&quot;)
		{
			throw(e);
		}
		else
		{
			TheApplication().RaiseErrorText(strError);
		}
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		psInputs = null;
		psOutputs = null;
/*Below variables are nullified by JAGJIT on 18/03/2019*/
		//bsInvokeBS = null;
		//bsInvokeWorkflow = null;
		/*Below variables are nullified by Balamurugan on 03/10/2019*/
	if(defined(bsInvokeBS)) { bsInvokeBS = null; }
	if(defined(bsInvokeWorkflow)) { bsInvokeWorkflow = null; }


		if ((TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) &amp;&amp; (MethodName != &quot;IsActive&quot;))
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.PreInvokeMethod.MethodName=&quot; + MethodName + &quot; strError=&quot; + strError);
		}
	}
}"
			   SEQUENCE="18"
			   UPDATED="01/09/2026 16:03:42"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:03:42"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreNewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreNewRecord ()
{
	return (ContinueOperation);
}"
			   SEQUENCE="19"
			   UPDATED="01/09/2026 16:03:42"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:03:42"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	try
	{
		var bsValidate,psIn,psOut;
		var sPINFlag = &quot;N&quot;;//SK 106.17 - Added for Retrofit 17.2 on 17.3
		switch (FieldName)
		{
			case &quot;VF TNR Id&quot;:
				var sRowId = this.GetFieldValue(&quot;Id&quot;);
				var strOldTNRId = this.GetFieldValue(&quot;VF TNR Id&quot;);
				var sOrderHeaderId = this.GetFieldValue(&quot;Order Header Id&quot;);
				bsValidate = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
				psIn = TheApplication().NewPropertySet();
				psOut = TheApplication().NewPropertySet();
				psIn.SetProperty(&quot;LineItemId&quot;, sRowId);
				psIn.SetProperty(&quot;OrderId&quot;, sOrderHeaderId);
				psIn.SetProperty(&quot;TNRId&quot;, FieldValue);
				psIn.SetProperty(&quot;OldTNRId&quot;, strOldTNRId);
				bsValidate.InvokeMethod(&quot;ValidateLineItems&quot;, psIn, psOut);
				sRefresh = &quot;Y&quot;;
				return (ContinueOperation);
				break;
			//SK 106.17 - Added for Retrofit 17.2 on 17.3
			case &quot;Service PIN&quot;:
				//Muthushankari 27/3/2017 Added for R17.2 Service PIN Validation CIR
				var svc, input, output;
				var eai_flag = TheApplication().GetProfileAttr(&quot;EAI_FLAG&quot;);
				var bulk_flag = TheApplication().GetProfileAttr(&quot;VFBulkPinNoValidation&quot;);
				var post_order_flag = TheApplication().GetProfileAttr(&quot;ASSET_POST_ORDER_FLAG&quot;);
				var reparenting_flag = TheApplication().GetProfileAttr(&quot;REPARENTING_FLAG&quot;);
				var pre_to_post_flag = TheApplication().GetProfileAttr(&quot;VHA_PRE_TO_POST_FLAG&quot;);
				var post_pre_flag = TheApplication().GetProfileAttr(&quot;VHA_POST_TO_PRE_FLAG&quot;);
				var tot_flag = TheApplication().GetProfileAttr(&quot;VHA_TOT_FLAG_PIN&quot;);  // VHA Sharukh Added For 19.1 PKE347
				var bulk_connection = TheApplication().GetProfileAttr(&quot;VHA_BULK_FLAG&quot;);
				this.ActivateField(&quot;VHA Responsibility Calc&quot;);
				var resp_exists = this.GetFieldValue(&quot;VHA Responsibility Calc&quot;);
				if (eai_flag == &quot;Y&quot; || bulk_flag == &quot;TRUE&quot; || post_order_flag == &quot;Y&quot; || reparenting_flag == &quot;Y&quot; || pre_to_post_flag == &quot;Y&quot; || post_pre_flag == &quot;Y&quot; || tot_flag  == &quot;Y&quot; || bulk_connection == &quot;TRUE&quot;)
				{
					// Do Nothing
				}
				else if(FieldValue == &quot;&quot; || FieldValue == null)
				{
					svc = TheApplication().GetService(&quot;VF Network Settings BS&quot;);
					input = TheApplication().NewPropertySet();
					input.SetProperty(&quot;Type&quot;, &quot;VHA_PIN_VALIDATION&quot;);
					input.SetProperty(&quot;LIC&quot;, &quot;Log Error&quot;);
					output = TheApplication().NewPropertySet();
					svc.InvokeMethod(&quot;QueryLOV&quot;, input, output);
					var sDesc = output.GetProperty(&quot;Desc&quot;);
					sPINFlag = &quot;Y&quot;;
					TheApplication().RaiseErrorText(sDesc);
				}
				else
				{
					if(resp_exists != &quot;Y&quot;)
					{
						svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						input = TheApplication().NewPropertySet();
						output = TheApplication().NewPropertySet();
						input.SetProperty(&quot;ProcessName&quot;, &quot;VHA PIN Validation Process&quot;);
						input.SetProperty(&quot;PIN&quot;, FieldValue);
						sPINFlag = &quot;Y&quot;;
						svc.InvokeMethod(&quot;RunProcess&quot;, input, output);
					}
				}
				return (ContinueOperation);
				break;
			case &quot;VF Sharing Order&quot;:
				if (FieldValue == &quot;Y&quot;)
				{
					var sSharingCompatibility = this.GetFieldValue(&quot;Sharing Compatibility&quot;);
					var sOrderId = this.GetFieldValue(&quot;Order Header Id&quot;);
					var sErrormessage = CheckSharingCompatibility(sSharingCompatibility,sOrderId);
					if (sErrormessage != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(sErrormessage);
					}
				}
				return (ContinueOperation);
				break;
			case &quot;VF MSISDN TBUI&quot;: //MANOHARG:11032026: Added code for Defect CM-8246.
				if((TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;) &amp;&amp; TheApplication().GetProfileAttr(&quot;sCOrderFunction&quot;) == &quot;UPGRADE&quot;)
				{
					TheApplication().SetProfileAttr(&quot;MSISDN11&quot;,&quot;TEST&quot;);
					this.ActivateField(&quot;MSISDN&quot;);
					this.ActivateField(&quot;New MSISDN&quot;);
					if((this.GetFieldValue(&quot;MSISDN&quot;) != &quot;&quot;) || (this.GetFieldValue(&quot;MSISDN&quot;) != null))
					{
						var msisdn = this.GetFieldValue(&quot;MSISDN&quot;);

						this.SetFieldValue(&quot;VF MSISDN TBUI&quot;,msisdn);
						TheApplication().SetProfileAttr(&quot;MSISDN&quot;,msisdn);
					}
				}
				return (ContinueOperation);
			break;
			//Glady: 08.03.2017 Added for PKE000000040833
			//Pugal R17.2 PKE000000040833 Added if condition &amp; profile attribute - SIT Defect#146
			
			case &quot;VF Port In TBUI&quot;:						
				var sActView = TheApplication().ActiveViewName();
				if (sActView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || sActView == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot; || sActView == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)
				{
					var sLovVal = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_WIZ_MSISDN_SOURCE&quot;,&quot;New&quot;);
					if(FieldValue == sLovVal)
					{				
						var sPortInMSISDN = GetFieldValue(&quot;VF Port In - Service Number TBUI&quot;);
						var sDOB = GetFieldValue(&quot;VF Port In - DOB TBUI&quot;);
						var sAccount = GetFieldValue(&quot;VF Port In - Service Account TBUI&quot;);					
						this.ActivateField(&quot;New MSISDN Id&quot;);
						var sNewMSISDNId = GetFieldValue(&quot;New MSISDN Id&quot;);						
						this.ActivateField(&quot;New MSISDN&quot;);
						var sNewMSISDN = GetFieldValue(&quot;New MSISDN&quot;);																											
						if ((sPortInMSISDN != &quot;&quot; &amp;&amp; sPortInMSISDN != null) &amp;&amp; ((sNewMSISDNId == &quot;&quot; &amp;&amp; sNewMSISDNId == null) || (sPortInMSISDN != sNewMSISDN)))
						{						
							SetFieldValue(&quot;VF Port In - Service Number TBUI&quot;,&quot;&quot;);
							if (sDOB != &quot;&quot; &amp;&amp; sDOB != null)
								SetFieldValue(&quot;VF Port In - DOB TBUI&quot;,&quot;&quot;);
							if (sAccount != &quot;&quot; &amp;&amp; sAccount != null)
								SetFieldValue(&quot;VF Port In - Service Account TBUI&quot;,&quot;&quot;);
						}						
					}
				}
				return (ContinueOperation);
			break;
			case &quot;VF Stock Indicator TBUI&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					this.ActivateField(&quot;Reservation Id&quot;);//VHA Kamali:25/05/2022 - updated for Ring and Collect
					if((FieldValue == &quot;Out of Stock&quot; || FieldValue==&quot;Out of Stock - Connect Later&quot;) &amp;&amp; (this.GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;))
					{
						TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before changing to Out of Stock - Connect Later.&quot;);
					}
				}
				return (ContinueOperation);
				break;
			case &quot;VF ConnectionType&quot;:
				var sLovType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;SIM Only&quot;);
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					this.ActivateField(&quot;Reservation Id&quot;);
					if((FieldValue == sLovType || FieldValue == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Bring Your Device&quot;)) &amp;&amp; (this.GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;))
					{
						TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before changing to SIM Only or Bring Your Device.&quot;);
					}
				}
				ActivateField(&quot;Insurance Inc GST&quot;);
				if(FieldValue == sLovType)
				{
					var sInsurance = GetFieldValue(&quot;Insurance Inc GST&quot;);
					if(sInsurance != null &amp;&amp; sInsurance != &quot;&quot;)
					{
						SetFieldValue(&quot;Insurance Inc GST&quot;,&quot;&quot;);
					}
				}
				var sPlanDevice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Plan and Device&quot;);
				if(FieldValue == sPlanDevice)
				{
				  this.ActivateField(&quot;Access Technology&quot;);
				  TheApplication().SetProfileAttr(&quot;PD&quot;,this.GetFieldValue(&quot;Access Technology&quot;));
				  /* //Start ; santoshb commented the changes for CR1077
                  if(this.GetFieldValue(&quot;Access Technology&quot;) == &quot;TRANSACT-HFC&quot;)
				  {
				     TheApplication().RaiseErrorText(&quot;For Vision Transact HFC Technology Plan and Device is not applicable.Please select Bring Your Device from dropdown list.&quot;);
                  } */  //End ; santoshb commented the changes for CR1077
				}
				return (ContinueOperation);
			break;		
		//Anbu : 21.01.2015 created for Aggregate Alerts
			case &quot;VF AA Set Notification MSISDN&quot;:
				if(FieldValue == &apos;Y&apos;)
				{
					try
					{
						var orderid = TheApplication().ActiveBusObject().GetBusComp(&quot;Order Entry - Orders&quot;).GetFieldValue(&quot;Id&quot;);
						var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
						var oBC = oBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
						with(oBC)
						{
							SetViewMode(AllView);
							ActivateField(&quot;Order Header Id&quot;);
							ActivateField(&quot;VF AA Set Notification MSISDN&quot;);
							ClearToQuery();
							var Searchst = &quot;[Order Header Id] = &apos;&quot; + orderid + &quot;&apos; AND ([VF AA Set Notification MSISDN] = &apos;Y&apos;)&quot;;
							SetSearchExpr(Searchst);
							ExecuteQuery(ForwardBackward);
							if(FirstRecord())
							{
								TheApplication().RaiseErrorText(&quot;The Set Notification flag already checked for another record, please uncheck the other record and select this record&quot;);
								return (CancelOperation);
							}
						}
					}
					catch(e)
					{
						throw (e);
					}
					finally
					{
						oBO = null;
						oBC = null;
						Searchst =null;
					}
				}
				return (ContinueOperation);
				break;	
			
			
			case &quot;Status&quot;:
				if (FieldValue == &quot;Submitted&quot;)
				{
					TheApplication().SetProfileAttr(&quot;OldLineItemStatusValue&quot;, this.GetFieldValue(&quot;Status&quot;));
				}
				return (ContinueOperation);
			break;
			//Nikhil Joshi: 14.10.2014: Added below from BC &quot;VF Order Entry - Line Items&quot; for TBUI
			case &quot;VF IMEI TBUI&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					this.ActivateField(&quot;Reservation Id&quot;);
					if(this.GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before allocating IMEI&quot;);
					}
				}
				var sValidateSIMType = &quot;&quot;;
				ActivateField(&quot;VF Order Sub Type TBUI&quot;);
				ActivateField(&quot;Shipping&quot;);
				//Karthika : 28/05/2015 : Added the below script for PKE000000022510 
				var sIMEI = FieldValue;
				TheApplication().SetProfileAttr(&quot;VFIMEITBUI&quot;,sIMEI);
				TheApplication().SetProfileAttr(&quot;skucodessj&quot;,this.GetFieldValue(&quot;VF Handset Code TBUI&quot;));
			//	TheApplication().SetProfileAttr(&quot;SiebelProductType&quot;, this.GetFieldValue(&quot;VF Siebel Product Type&quot;));// Muthushankari 27/2/2017 Added for PIPE
				var sSiebelProductType = this.GetFieldValue(&quot;VF Siebel Product Type&quot;) //PIPE - Roseline -18/05/2017 : Added for defect# 328
				var sOrderItemId = this.GetFieldValue(&quot;Id&quot;);
				var sSIMType = this.GetFieldValue(&quot;Shipping&quot;);
				var sConnectOrderSubType = this.GetFieldValue(&quot;VF Order Sub Type TBUI&quot;);
				//Balaji 9/4/2018 added for restricting IMEI for Hard Caps
				this.ActivateField(&quot;Special Rating List Type&quot;);
				var sSplSiebType = this.GetFieldValue(&quot;Special Rating List Type&quot;);
				var sCapsType = sSplSiebType.substring(0,11);
				if(sSplSiebType != &quot;&quot;)
				{
				   var sAssured = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;,&quot;Credit Caps&quot;);
				   var sVodCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CAP_SPLSBL_PROD_TYPE&quot;, &quot;Vodafone Caps&quot;);
				   if(sCapsType == sAssured &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_IMEI_CAP_ENABLE&quot;,&quot;Hard Cap&quot;) == &quot;ON&quot;)
				   {
		               TheApplication().RaiseErrorText(&quot;Allocate IMEI not allowed for Hard Caps&quot;);
		           }
		           else if(sSplSiebType == sVodCap &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_IMEI_CAP_ENABLE&quot;,&quot;Vodafone Cap&quot;) == &quot;ON&quot;)
		           {
		               TheApplication().RaiseErrorText(&quot;Allocate IMEI not allowed for Hard Caps&quot;);
		           }
				}//End //Balaji 9/4/2018 added for restricting IMEI for Hard Caps
				//Start- SBABU added for IMEI validations for RC - 30May22
				if(TheApplication().ActiveViewName() ==&quot;VF R&amp;C Order Fulfillment View&quot;)
				{
					var vIMEIProdCode = TheApplication().GetProfileAttr(&quot;ItemCode&quot;);
					if (vIMEIProdCode !=&quot;&quot; &amp;&amp; sIMEI != &quot;&quot;)
					{
						var bcVFIMEIList = TheApplication().GetBusObject(&quot;VF IMEI List&quot;).GetBusComp(&quot;VF IMEI List&quot;);
						with(bcVFIMEIList)
						{
							SetViewMode(AllView)
							ClearToQuery();
							ActivateField(&quot;IMEI&quot;);
							ActivateField(&quot;Product Code&quot;);			
							SetSearchSpec(&quot;IMEI&quot;, sIMEI);
							SetSearchSpec(&quot;Product Code&quot;, vIMEIProdCode);
							ExecuteQuery(ForwardOnly);		
							if (!FirstRecord())
							{
								TheApplication().RaiseErrorText(&quot;The entered IMEI product code does not match in IMEI Matrix.&quot;);
							}
							else
							{
							}							
						}
					}
				}//End- SBABU added for IMEI validations for RC

				var bsIMEIService = TheApplication().GetService(&quot;VF IMEI Toolkit Service&quot;);
 	 	        var psInputs = TheApplication().NewPropertySet();
 		        var psOutputs = TheApplication().NewPropertySet();
 		        if(sConnectOrderSubType != &quot;&quot; &amp;&amp; sConnectOrderSubType != null &amp;&amp; sConnectOrderSubType == &quot;New Connection&quot;)
 		        {
 		        	sValidateSIMType = &quot;Y&quot;;
 		        }

	 	     	if (sIMEI != null &amp;&amp; sIMEI != &quot;&quot;)
	 	    	{
		 			psInputs.SetProperty(&quot;IMEI&quot;, sIMEI);
		 			psInputs.SetProperty(&quot;Order Item Id&quot;, sOrderItemId);
		 			psInputs.SetProperty(&quot;SIM Type&quot;, sSIMType);
		 			psInputs.SetProperty(&quot;SIMTypeCheck&quot;, sValidateSIMType);  
		 			psInputs.SetProperty(&quot;SiebelProductType&quot;, sSiebelProductType); //PIPE - Roseline -18/05/2017 : Added for defect# 328
					psInputs.SetProperty(&quot;SplProductType&quot;,sSplSiebType);

					//Sathish - Added for Fibre connect
					psInputs.SetProperty(&quot;FCConnectOrderSubType&quot;,sConnectOrderSubType);
		 			
		 			bsIMEIService.InvokeMethod(&quot;ValidateIMEI&quot;, psInputs, psOutputs);
		 			var sIMEIValid = psOutputs.GetProperty(&quot;Status&quot;);
		 			var sIMEISIMTypeError = psOutputs.GetProperty(&quot;IMEI SIM Type Error&quot;);
		 			
		 			if (sIMEIValid == &quot;Invalid&quot;)
		 			{
						var IMEIErrorMsg = psOutputs.GetProperty(&quot;ErrorMsg&quot;);
						if(IMEIErrorMsg != &quot;&quot; &amp;&amp; IMEIErrorMsg != null &amp;&amp; IMEIErrorMsg != &quot;undefined&quot;)
							{
								TheApplication().RaiseErrorText(IMEIErrorMsg);
							}
					}
					if (sIMEISIMTypeError != &quot;&quot; &amp;&amp; sIMEISIMTypeError != null &amp;&amp; sIMEISIMTypeError != &quot;undefined&quot;)
					{
						TheApplication().RaiseErrorText(sIMEISIMTypeError);
					}
					else 
					{
						if((sIMEI != null &amp;&amp; sIMEI != &quot;&quot;) &amp;&amp; (GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != null))
						{
							TheApplication().SetProfileAttr(&quot;sIMEISoldError&quot;,&quot;&quot;);
							var psInputs,psOutputs,bsInvokeWorkflow;
							var psErrorInput;
							var psErrorOutput;
							var bsError;	
							var strError = &quot;&quot;;
							var strErrorMsg=&quot;&quot;;
						    psInputs = TheApplication().NewPropertySet();
							psOutputs = TheApplication().NewPropertySet();
							psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Allocate IMEI TBUI&quot;);
							psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
							psInputs.SetProperty(&quot;OLI Id&quot;, this.GetFieldValue(&quot;Id&quot;));
							psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
							psInputs.SetProperty(&quot;IMEI&quot;, FieldValue);
							bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
							bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
							if(TheApplication().GetProfileAttr(&quot;sIMEISoldError&quot;) != &quot;&quot;)
							{
								strErrorMsg = TheApplication().GetProfileAttr(&quot;sIMEISoldError&quot;);
							}
							else
							{
								strErrorMsg = psOutputs.GetProperty(&quot;Error Message&quot;);
							}
							if(strErrorMsg != &quot;&quot;)
							{
								TheApplication().RaiseErrorText(strErrorMsg);
								TheApplication().SetProfileAttr(&quot;sIMEISoldError&quot;,&quot;&quot;);
							}
						}	
					}
				}				
				
				return(ContinueOperation);
			break;
			case &quot;Shipping&quot;:
				var sView = TheApplication().ActiveViewName();
				if(sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot; || sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || sView == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)
				{
					if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;)
					{
						this.ActivateField(&quot;Reservation Id&quot;);
						if(this.GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;)
						{
							TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before changing SIM Type&quot;);
						}
					}
					//NROY: 03/08/22 Added for Project Tree 
					var sSIMTypePhysical = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;,&quot;Physical&quot;);
					var sEID = this.GetFieldValue(&quot;EID&quot;);
					var seSIMDownload = this.GetFieldValue(&quot;eSIM Download&quot;);
					if(FieldValue == sSIMTypePhysical || FieldValue == null || FieldValue == &quot;&quot;)
					{
						if(sEID != null &amp;&amp; sEID !=&quot;&quot;)
						{
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
							this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
						}
						if(seSIMDownload != null &amp;&amp; seSIMDownload != &quot;&quot;)
						{
							this.SetFieldValue(&quot;eSIM Download&quot;,&quot;&quot;);
						}
					}	
				}
				return (ContinueOperation);
				break;
			//Nikhil Joshi: 14.10.2014: Added below from BC &quot;VF Order Entry - Line Items&quot; for TBUI
			case &quot;VF SIM TBUI&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					this.ActivateField(&quot;Reservation Id&quot;);
					if(this.GetFieldValue(&quot;Reservation Id&quot;) != null &amp;&amp; this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before allocating SIM&quot;);
					}
				}
				try
				{
					ActivateField(&quot;VF Order Sub Type TBUI&quot;);
					if((FieldValue != null &amp;&amp; FieldValue != &quot;&quot;) &amp;&amp;
					(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) != null))
					{
						var psInputs,psOutputs,bsInvokeBS,strNewSIMId,psInp;
						var psErrorInput;
						var psErrorOutput;
						var bsError;	
						var strError = &quot;&quot;;
						var strsimstatus =&quot;&quot;;
						//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
			            psInputs = TheApplication().NewPropertySet();
			            psInp = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;Root Order Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						//psInputs.SetProperty(&quot;SIM&quot;, FieldValue);
						var sSIMValue = FieldValue; //Selva#13/09/2014 Defect#2135
					  	if (sSIMValue.length == 10)
						{			
							var boSystemPref = TheApplication().GetBusObject(&quot;System Preferences&quot;);  
				   			var bcSystemPref = boSystemPref.GetBusComp(&quot;System Preferences&quot;);
				   			var strValue =&quot;&quot;;
			       			with (bcSystemPref)
			   				{
			    				ClearToQuery();
			    				ActivateField(&quot;Name&quot;);
			    				ActivateField(&quot;Value&quot;);
			    				SetViewMode(AllView);
			    				SetSearchSpec(&quot;Name&quot;,&quot;VF SIM Prefix Value&quot;);
			    				ExecuteQuery(ForwardOnly);
			    				if(FirstRecord())
			    					strValue = GetFieldValue(&quot;Value&quot;);    
			  				}
							sSIMValue = strValue + sSIMValue;
							//this.SetFieldValue(&quot;VF SIM TBUI&quot;,sSIMValue);								
						} 
						if(TheApplication().GetProfileAttr(&quot;VFReuseModemFlg&quot;) == &quot;&quot;)//SakthiR Added for Reuse Modem
						{
							psInputs.SetProperty(&quot;SIM&quot;, sSIMValue);
							bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
							bsInvokeBS.InvokeMethod(&quot;CheckSIMOnExistingOrder&quot;, psInputs, psOutputs);
							psInputs.Reset();
							psOutputs.Reset();
							bsInvokeBS = TheApplication().GetService(&quot;VF OM Query SIM Details&quot;);
							psInputs.SetProperty(&quot;ARII&quot;, &quot;Australia&quot;);
							//psInputs.SetProperty(&quot;New Serial Number&quot;, FieldValue);
							psInputs.SetProperty(&quot;New Serial Number&quot;, sSIMValue);//Selva#13/09/2014 Defect#2135
							psInputs.SetProperty(&quot;Service Provider&quot;, &quot;Vodafone AU&quot;);
							bsInvokeBS.InvokeMethod(&quot;QuerySIMDetails&quot;, psInputs, psOutputs);
							strsimstatus = psOutputs.GetProperty(&quot;Status&quot;);
							//MURALIDHARANK 15/09/2014 Defect 2427 Check on Existing SIM Status
							if((strsimstatus == &quot;Received&quot;) || (strsimstatus == &quot;Cancelled&quot;))
							{
								psInp = psOutputs.Copy();
								psInputs.Reset();
								psOutputs.Reset();
								bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
								bsInvokeBS.InvokeMethod(&quot;CreateNewSIMAndIMSI&quot;, psInp, psOutputs);
								strNewSIMId = psOutputs.GetProperty(&quot;SIM Id&quot;);
								psInputs.Reset();
								psOutputs.Reset();
								bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
								psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
								psInputs.SetProperty(&quot;New SIM Id&quot;, strNewSIMId);
								psInputs.SetProperty(&quot;Root Line Item Id&quot;,this.GetFieldValue(&quot;Root Order Item Id&quot;));
								bsInvokeBS.InvokeMethod(&quot;SetLineItemNewSIMAndIMSI&quot;, psInputs, psOutputs);
							}	
							else
							{
								//strError=&quot;SIM is not available for allocation&quot;;
								//Neel 07.10.2014 - Change Error Message
								strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
								TheApplication().RaiseErrorText(strError);
							}
						}
					}
					return(ContinueOperation);
				}
				catch(e)
				{
					if((strError !=null) &amp;&amp; (strError !=&quot;&quot;))
					{
						//throw(e);
						strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
						TheApplication().RaiseErrorText(strError);
					}
					else
					{
						strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
						strError = ToString(e);
						psErrorInput  = TheApplication().NewPropertySet();
						psErrorOutput = TheApplication().NewPropertySet();
						bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
						psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Order Entry - Line Items BC&quot;);
						psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_PreSetField&quot;);
						psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
						bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
						strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
						TheApplication().RaiseErrorText(strError);
					}
				}
				finally
				{
					psInputs=null;
					psOutputs=null;
					bsInvokeBS=null;
					psErrorInput=null;
					psErrorOutput=null;
					psInp=null;
					bsError=null;
					TheApplication().SetProfileAttr(&quot;DeAllocateAction&quot;,&quot;&quot;); //R17.2-PKE000000040833
				}
			break;
			case &quot;EID&quot;:     
				if(FieldValue != null &amp;&amp; FieldValue != &quot;&quot;)
				{
					var psInputs,psOutputs,bsInvokeWorkflow, sErrMsg;
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Validate EID&quot;);
					psInputs.SetProperty(&quot;EIDValue&quot;,FieldValue);
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
					sErrMsg = psOutputs.GetProperty(&quot;ErrMsg&quot;);
					if(sErrMsg != null &amp;&amp; sErrMsg != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(sErrMsg);
					}
					else
					{
						//this.SetFieldValue(&quot;Shipping&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;));
						var seSIMDownload = this.GetFieldValue(&quot;eSIM Download&quot;);
						if(seSIMDownload == null || seSIMDownload == &quot;&quot;)
						{
							this.SetFieldValue(&quot;eSIM Download&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;));
						}
					}	
				}
				return(ContinueOperation);
			break;

			case &quot;eSIM Download&quot;:
				var seSIMDownloadQRCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;QR Code&quot;);
				var sEID = this.GetFieldValue(&quot;EID&quot;);
				if(FieldValue == seSIMDownloadQRCode || FieldValue == null || FieldValue == &quot;&quot;)
				{
					if(sEID != null &amp;&amp; sEID !=&quot;&quot;)
					{
						this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
						this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
					}
					this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
				}
				return(ContinueOperation);
			break;
		}
	}
	catch(e)
	{
		//10.6.17 -  Added for Retrofit 17.2 to 17.3
		if (sPINFlag == &quot;Y&quot;)
			TheApplication().RaiseErrorText(e.toString());
		else
			throw(e);
	}
	finally
	{
		psIn = null;
		psOut = null;
		bsValidate = null;
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		//svc = null;
		if(defined(svc)) { svc = null; } //Balamurugan 14/10/2019 - Nullified variable 
		input = null;
		output = null;
		//bcSystemPref = null;
		//boSystemPref = null;
		//bsIMEIService = null;
		//bsInvokeWorkflow = null;
		/*Below variables are nullified by Balamurugan on 14/10/2019*/
	if(defined(bcSystemPref)) { bcSystemPref = null; }
	if(defined(boSystemPref)) { boSystemPref = null; }
	if(defined(bsIMEIService)) { bsIMEIService = null; }
	if(defined(bsInvokeWorkflow)) { bsInvokeWorkflow = null; }
	}	
}"
			   SEQUENCE="20"
			   UPDATED="04/09/2026 19:56:49"
			   UPDATED_BY="ANGANAD"
			   CREATED="01/09/2026 16:03:42"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
/*
 * Component Name        : 	Order Entry - Line Items
 * Method Name           : 	BusComp_PreWriteRecord
 * Component Information :  One-off charges need a static price copied in
 *							from the column RX_AVG_PRICE in the table
 *							S_PROD_INT (this is populated during product
 *							sync). Code to do this is located here.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 6/04/2006	JLing		DF12867		Initial Version
 */


	// Error Handling declarations
	var psErrorInput;
	var psErrorOutput;
	var bsError;	
	var strError = &quot;&quot;;

	// Return value
	var iReturnValue = ContinueOperation;
	
	// Other vars
	var sProdId;
	var sProdType;
	var sCurPrice = &quot;&quot;;
	var sPrice = &quot;&quot;;
	
	var boProduct;
	var bcProduct;
	
	


	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;TRACE START:Order Entry - Line Items.BusComp_PreWriteRecord&quot;);
		}	

		sProdId = this.GetFieldValue(&quot;Product Id&quot;);	
		sProdType = this.GetFieldValue(&quot;Product Type&quot;);
		sCurPrice = this.GetFieldValue(&quot;Product Sync Stored Price&quot;);
	
		
		// Only do this if this record is a One-off Charge
		// Do a recheck - dont ever set this again if its set once.
		if ((sProdType == gOneOffChargeType) &amp;&amp; (sCurPrice == &quot;&quot;))
		//if (sProdType == gOneOffChargeType)
		{

			// Query the product table and copy in value from 
			// RX_AVG_PRICE to local column COST_AMT
			// This is in the &quot;Product Sync Stored Price&quot; field

			boProduct = TheApplication().GetBusObject(&quot;Admin Product Definition&quot;);
			// Need a non cached query on products
			bcProduct = boProduct.GetBusComp(&quot;VF Internal Product - Non Cached&quot;);
			bcProduct.ClearToQuery();
			bcProduct.SetViewMode(AllView);
			bcProduct.ActivateField(&quot;Product Sync Price&quot;);
			bcProduct.SetSearchSpec(&quot;Id&quot;, sProdId);
			bcProduct.ExecuteQuery(ForwardOnly);			
			
			// Get the value in RX_AVG_PRICE
			if (bcProduct.FirstRecord())
			{
				sPrice = bcProduct.GetFieldValue(&quot;Product Sync Price&quot;);
				//this.ActivateField(&quot;Product Sync Stored Price&quot;);
				
				if (sPrice == &quot;&quot;)
				{
					// If no price is present, set this col to zero.
					this.SetFieldValue(&quot;Product Sync Stored Price&quot;, 0);
				} else
				{
					// Otherwise, copy the value of RX_AVG_PRICE into this bc
					this.SetFieldValue(&quot;Product Sync Stored Price&quot;, sPrice);
				}
			}
	
		
		}
		
return (iReturnValue);
	}
	catch(e)
	{
	
		strError = ToString(e);

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Line Items BC&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_NewRecord&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		
		bcProduct = null;
		boProduct = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.BusComp_PreWriteRecord&quot;);
		}		
	}
	
}"
