			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckSharingCompatibility"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckSharingCompatibility(sSharingCompatibility,sOrderId)
{
	try
	{
			var sBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
			var sBC = sBO.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
			var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [VF Sharing Order] = &apos;Y&apos;&quot;;
			var SharingComp;
			
			var sErrMsg;
			with (sBC)
			{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchExpr(sSearchspec);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							 SharingComp = GetFieldValue(&quot;Sharing Compatibility&quot;);
							 if (sSharingCompatibility == SharingComp)
							 {
								sErrMsg = &quot;&quot;;
							 }
							 else
							 {
								sErrMsg = &quot;VFErrorCode#  96006&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96006&quot;);	
								
							 }	
						}
						else
						{
							sErrMsg = &quot;&quot;;
						}
						
			}
			return(sErrMsg);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		sBC = null;
		sBO = null;
	}
}"
