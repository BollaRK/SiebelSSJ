			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateReuseModem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateReuseModem(AssetId)
{
	try
	{
			var sBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
			var sBC = sBO.GetBusComp(&quot;VF IMEI History&quot;);
			var sAssetId = AssetId;
			var sSearchspec = &quot;[Parent Asset Id] = &apos;&quot; + sAssetId + &quot;&apos; AND  [Status] = &apos;Active&apos;&quot;;
			var sIMEI = &quot;&quot;;
			with (sBC)
			{
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Parent Asset Id&quot;);
						ActivateField(&quot;Status&quot;);
						ActivateField(&quot;Asset Number&quot;);
						SetSearchExpr(sSearchspec);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							 sIMEI = GetFieldValue(&quot;Asset Number&quot;);
						}
						else
						{
							sIMEI = &quot;&quot;;
						}
						
			}
			return(sIMEI);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		
		sBC = null;
		sBO = null;
	}
}"
