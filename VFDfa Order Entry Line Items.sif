			var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
			var OutstockLov 	= TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_STOCK_INDICATOR&quot;,&quot;Out of Stock&quot;);
			if(serviceStInd == sConnectNow || serviceStInd == sConnectLater)
			{
			var BusObj 	= TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var busComp 	= BusObj.GetBusComp(&quot;VHA Accessory Items&quot;);
			with(busComp)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;VHA App Stock Indicator&quot;);
				ActivateField(&quot;Related Service Order Id&quot;);
				SetSearchSpec(&quot;Related Service Order Id&quot;,RelSrOrderId)
				ExecuteQuery();
				var fr = FirstRecord();
				while(fr)
				{
				SetFieldValue(&quot;VHA App Stock Indicator&quot;,OutstockLov);
				fr = NextRecord();
				}
				ClearToQuery();
				ExecuteQuery();
			}
			}
			break;*/
			//Kathambari - 29/04/2016 - End of code
		}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Order Entry - Line Items.BusComp_SetFieldValue.strError=&quot; + strError);
		}
		//var strDisplayError = ErrorHandling(strError, &quot;BusComp_SetFieldValue&quot;); //TD11803
		//TheApplication().RaiseErrorText(strDisplayError);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.BusComp_SetFieldValue&quot;);
		}
	}
}"
