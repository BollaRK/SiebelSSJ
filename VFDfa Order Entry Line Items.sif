			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateSIMReuseModem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateSIMReuseModem(AssetId,sReuseOrder,sReuseOrderLine)
{
	try
	{
			var sBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
			var sBC = sBO.GetBusComp(&quot;VF Resource Mgmt - SIM Relationship&quot;);
			var sSIMAsset = &quot;&quot;;
			var sOrder = &quot;&quot;;
			var sRootItem = &quot;&quot;;
			var sAssetId = AssetId;
			var sSearchspec = &quot;[Parent Asset Id] = &apos;&quot; + sAssetId + &quot;&apos; AND  [Status] = &apos;Active&apos;&quot;;
			var sSIM = &quot;&quot;;
			with (sBC)
			{
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Parent Asset Id&quot;);
						ActivateField(&quot;Status&quot;);
						ActivateField(&quot;Asset Number&quot;);
						ActivateField(&quot;Asset Id&quot;);
						SetSearchExpr(sSearchspec);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							 sSIM = GetFieldValue(&quot;Asset Number&quot;);
							 sSIMAsset = GetFieldValue(&quot;Asset Id&quot;) 
						}
						else
						{
							sSIM = &quot;&quot;;
						}
						
			}
			sOrder = sReuseOrder;
			sRootItem = sReuseOrderLine;
			var psInputs,psOutputs,bsInvokeBS;
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;New SIM Id&quot;, sSIMAsset);
			psInputs.SetProperty(&quot;Order Id&quot;, sOrder);
			psInputs.SetProperty(&quot;Root Line Item Id&quot;, sRootItem);
			bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
			bsInvokeBS.InvokeMethod(&quot;SetLineItemNewSIMAndIMSI&quot;, psInputs, psOutputs);
			return(sSIM);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		
		sBC = null;
		sBO = null;
		psInputs = null;
		psOutputs = null;
	}
}"
			   SEQUENCE="12"
