			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	Order Entry - Line Items
 * Method Name           :	BusComp_SetFieldValue
 * Component Information :	Removing the non-standard charcaters from the User Name field.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 23/07/2009	RC			DF 11212    Removing the non-standard charcaters from the 
 *                                      User Name field.
 * 21/09/2009 Sibi Chakko	DF 11684	For excluding the validation of 11212 for regions other thn AU.
 *										For excluding the validation for numerals
 * 20/12/2011   ParthaS	    TD 11803    Commented Unknown method &apos;ErrorHandling&apos;
 * 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages									
 */
function BusComp_SetFieldValue (FieldName)
{
	try
	{
	    //************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;TRACE START:Order Entry - Line Items.BusComp_SetFieldValue&quot;);
		}
		switch (FieldName)
		{
            // Code for the DF 11212 to remove the non-standard characters from User Name field.  		
		    case &quot;VF Installed Asset Name&quot;:
				// Added condition to skip validation for other regions Def 11684 --Sibi Chakko
				if (this.GetFieldValue(&quot;Account ARII&quot;) == &quot;Australia&quot;)
				{
					var strUname = GetFieldValue(&quot;VF Installed Asset Name&quot;);
					var strFinalString;	  
					var strLength = strUname.length;
					var strArray = new Array(strLength);
					var i = 0;
					var j = 0;
					var strChar;
					var CharCode;  
					for(i=0;i&lt;strLength;i++)
					{
						strChar = strUname.charAt(i);
						CharCode = strChar.charCodeAt(0);
						// Added condition to skip validation for numerals Def 11684 --Sibi Chakko
						if(((CharCode &gt;64) &amp;&amp; (CharCode &lt; 91)) || ((CharCode &gt;96) &amp;&amp; (CharCode&lt;123)) || ((CharCode&gt;47) &amp;&amp; (CharCode&lt;58)))
						{      			 	 
							strArray[j]=strChar;
							j++;
						}
						else
						{
							strArray[j] = &quot; &quot;;
							j++;
						}
					}
					strFinalString = strArray.join(&quot;&quot;);
					SetFieldValue(&quot;VF Installed Asset Name&quot;, strFinalString);
					break; // Code for the DF 11212 Ends.
				}
			case &quot;VF SIM TBUI&quot;:
				if(TheApplication().ActiveViewName() == &quot;VF R&amp;C Order Fulfillment View&quot;)
				{					
					this.ActivateField(&quot;Reservation Id&quot;);
					this.ActivateField(&quot;Shipping&quot;);	
					if(this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;VF SIM TBUI&quot;) == &quot;&quot;)
					{
						var sSIMType = this.SetFieldValue(&quot;Shipping&quot;,&quot;&quot;);						
						this.WriteRecord();
						TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
					}									
					else if (this.GetFieldValue(&quot;Shipping&quot;)!= &quot;Physical&quot;){
					if(this.GetFieldValue(&quot;Reservation Id&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;VF SIM TBUI&quot;) != &quot;&quot;)
					{
						var sSIMType = this.SetFieldValue(&quot;Shipping&quot;,&quot;Physical&quot;);						
						this.WriteRecord();
						TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
					}}
					else {}
				}
			case &quot;Shipping&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					// vasavi 21/06/2022 Added for tree project
					var sStockIndicator = this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;); 
					var sSIMType = this.GetFieldValue(&quot;Shipping&quot;);
					var sSIMTypePhysical = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;,&quot;Physical&quot;);
					var sSIMTypeeSIM = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
					var sESIMDownloadPush = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;);
					var sESIMDownloadQRCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;QR Code&quot;);
					var seSIMDownload = this.GetFieldValue(&quot;eSIM Download&quot;);
					if(sSIMType == sSIMTypePhysical || sSIMType == null || sSIMType == &quot;&quot; )
					{
						if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
						{
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
							this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
						}
						this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
					}
					
					if(sSIMType == sSIMTypeeSIM)
					{
						if(seSIMDownload == null || seSIMDownload == &quot;&quot;)
						{
							this.SetFieldValue(&quot;eSIM Download&quot;,sESIMDownloadPush);
						}
						if(sStockIndicator == &quot;In Stock&quot; || sStockIndicator == null || sStockIndicator == &quot;&quot;)
						{
							var sConnectionType = this.GetFieldValue(&quot;VF ConnectionType&quot;);
							if(sConnectionType == &quot;Plan and Device&quot;)
							{
								var sIMEI = this.GetFieldValue(&quot;VF IMEI TBUI&quot;);
								if(sIMEI != null &amp;&amp; sIMEI != &quot;&quot; &amp;&amp; sSIMType != sSIMTypePhysical &amp;&amp; seSIMDownload != sESIMDownloadQRCode)
								{
									var sIMEIEID = &quot;&quot;;
									var oBO = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
									var oBC = oBO.GetBusComp(&quot;VF IMEI List&quot;);
									with(oBC)
									{
										SetViewMode(AllView);
										ClearToQuery();
										ActivateField(&quot;IMEI&quot;);			
										ActivateField(&quot;EID&quot;);
										SetSearchSpec(&quot;IMEI&quot;, sIMEI);
										ExecuteQuery(ForwardOnly);
										var isRec = FirstRecord();
										if(isRec)
											sIMEIEID = GetFieldValue(&quot;EID&quot;);
									}
									if(sIMEIEID != &quot;&quot; &amp;&amp; sIMEIEID != null)
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
										this.SetFieldValue(&quot;EID&quot;,sIMEIEID);
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);	
									}
									else 
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
										this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
									}
								}
							}
							else 
							{
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
								this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
							}
						}
						if(sStockIndicator == &quot;Out of Stock - Connect Later&quot;)
						{
							if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
							{
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
								this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
							}
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
						}
					}
				this.WriteRecord();				
				}//Added for tree project
				
				break;
			case &quot;VHA SSJ Portin Options&quot;:
				var sPortInOpt = this.GetFieldValue(&quot;VHA SSJ Portin Options&quot;);
				TheApplication().SetProfileAttr(&quot;Tes1&quot;,sPortInOpt);
				if (sPortInOpt == &quot;Yes - Prepay&quot;)
				{
					this.ActivateField(&quot;Contact Birth Date&quot;);
					var sDOB = this.GetFieldValue(&quot;Contact Birth Date&quot;);
					TheApplication().SetProfileAttr(&quot;Tes2&quot;,sDOB);
					this.SetFieldValue(&quot;VF Port In - DOB TBUI&quot;,sDOB);
					this.WriteRecord();
					TheApplication().SetProfileAttr(&quot;Tes3&quot;,this.GetFieldValue(&quot;VF Port In - DOB TBUI&quot;));
				}
			
			break;
				// vasavi Added for	tree project
			case &quot;eSIM Download&quot;:
				var sView = TheApplication().ActiveViewName();
				var seSIMDownloadQRCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;QR Code&quot;);
				var seSIMDownloadPush = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;);
				var seSIMDownload = this.GetFieldValue(&quot;eSIM Download&quot;);
				
				if(sView != &quot;&quot; &amp;&amp; sView != null)
				{
					var sIMEI = this.GetFieldValue(&quot;VF IMEI TBUI&quot;);
					var sStockIndicator = this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;); 
					var sSIMType = this.GetFieldValue(&quot;Shipping&quot;);
					var sConnectionType = this.GetFieldValue(&quot;VF ConnectionType&quot;);
					var sIMEIEID = &quot;&quot;;

					if(seSIMDownload == seSIMDownloadPush &amp;&amp; sSIMType != TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;Physical&quot;))
					{
						if(sIMEI != &quot;&quot; &amp;&amp; sIMEI != null)
						{					
							var oBO = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
							var oBC = oBO.GetBusComp(&quot;VF IMEI List&quot;);
							with(oBC)
							{
								SetViewMode(AllView);
								ClearToQuery();
								ActivateField(&quot;IMEI&quot;);			
								ActivateField(&quot;EID&quot;);
								SetSearchSpec(&quot;IMEI&quot;, sIMEI);
								ExecuteQuery(ForwardOnly);
								var isRec = FirstRecord();
								if(isRec)
									sIMEIEID = GetFieldValue(&quot;EID&quot;);
							}
						}
						if(sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot; || sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || sView == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;) 
						{
							if(sStockIndicator == &quot;In Stock&quot; || sStockIndicator == null || sStockIndicator == &quot;&quot;)
							{
								if(sConnectionType == &quot;Plan and Device&quot;)
								{
									if(sIMEI != &quot;&quot; &amp;&amp; sIMEI != null &amp;&amp; sIMEIEID != &quot;&quot; &amp;&amp; sIMEIEID != null)
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
										this.SetFieldValue(&quot;EID&quot;,sIMEIEID);
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
									}
									else if(sIMEI != &quot;&quot; &amp;&amp; sIMEI != null &amp;&amp; (sIMEIEID == &quot;&quot; || sIMEIEID == null))
									{	
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
										this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
									}
									else if(sIMEI == &quot;&quot; || sIMEI == null)
									{	
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
									}
								}
								else if (sConnectionType == &quot;SIM Only&quot; || sConnectionType == &quot;Bring Your Device&quot;) 
								{	
									this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
									this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
								}
							}
							if(sStockIndicator == &quot;Out of Stock - Connect Later&quot;)
							{
								if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
								{
									this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
									this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
								}
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
							}
						}
						//if(sView == &quot;VF Order Entry - SIM Allocation View&quot; || sView == &quot;VF Order Entry - IMEI Allocation View&quot; || sView == &quot;VF Order Entry - Line Items Detail View&quot;)
						else
						{
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
							if(sIMEIEID != &quot;&quot; &amp;&amp; sIMEIEID != null)
							{
								this.SetFieldValue(&quot;EID&quot;,sIMEIEID);
							}
						}
					}
					this.WriteRecord();
				}
				break;
								
			case &quot;VF Stock Indicator TBUI&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					if((this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;) != &quot;&quot;) || (this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;) != null))
					{
						if(this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;) == &quot;Out of Stock - Connect Later&quot;)
						{
							if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
							{
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
								this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
							}
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
						}
						WriteRecord();
					}
				}
				break;
			case &quot;VF MSISDN TBUI&quot;:
				if(((TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;) || (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ConnectTBUIIMEIAtomPh2&quot;) == &quot;Y&quot;))
				{
					if((this.GetFieldValue(&quot;VF MSISDN TBUI&quot;) != &quot;&quot;) || (this.GetFieldValue(&quot;VF MSISDN TBUI&quot;) != null))
					{
						WriteRecord();
					}
				}
				break;
			//Nikhil Joshi: 14.10.2014: Added below from BC &quot;VF Order Entry - Line Items&quot; for TBUI
			case &quot;VF ConnectionType&quot;:
				ActivateField(&quot;VF Order Sub Type TBUI&quot;);
				if(GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Order Sub Type TBUI&quot;) == null)
				{
					var strconnectiontype = this.GetFieldValue(&quot;VF ConnectionType&quot;);
					var strview = TheApplication().ActiveViewName();
					if((strview == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) &amp;&amp; (strconnectiontype==&quot;Account Level Proposition&quot;))
					{
						SetFieldValue(&quot;VF Stock Indicator TBUI&quot;, &quot;In Stock&quot;);
					}
				}
				//SK 10.6.17 - Added below code for retrofit from 17.2 on 17.3
				//Pugal R17.2 26May17 Added below code for PKE000000047738
				if(GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;SIM Only&quot;)
				{
					var sDevice = GetFieldValue(&quot;VF Device TBUI&quot;);
					if(sDevice != &quot;&quot; &amp;&amp; sDevice != null)
						this.SetFieldValue(&quot;VF Device TBUI&quot;,&quot;&quot;);
				}
				//NROY: 19-JUl-22 Added for Project Tree
				var sView = TheApplication().ActiveViewName();
				if(((sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) || (TheApplication().ActiveViewName() == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)) &amp;&amp; this.GetFieldValue(&quot;Shipping&quot;) == &quot;eSIM&quot; &amp;&amp; this.GetFieldValue(&quot;eSIM Download&quot;) == &quot;Push&quot; &amp;&amp; (this.GetFieldValue(&quot;VF SIM TBUI&quot;) == null || this.GetFieldValue(&quot;VF SIM TBUI&quot;) == &quot;&quot;))
				{
					if(GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;SIM Only&quot; || GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;Bring Your Device&quot;)
					{
						this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
						this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
					}
					if(GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;Plan and Device&quot;)
					{
						if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
						{
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
							this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
						}
						this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);	
					}
				}
			break;
			case &quot;Status&quot;:
				if(this.GetFieldValue(&quot;Id&quot;) == this.GetFieldValue(&quot;Root Order Item Id&quot;))
				{
					SetOrderDateTimeMetrics(this.GetFieldValue(&quot;Status&quot;), TheApplication().GetProfileAttr(&quot;OldLineItemStatusValue&quot;));
				}
				TheApplication().SetProfileAttr(&quot;OldLineItemStatusValue&quot;, &quot;&quot;);
			break;
			//Pugal - 16/6/2016 - Added for PKE35535

			case &quot;VF IMEI TBUI&quot;:
			if(TheApplication().ActiveViewName() ==&quot;VF R&amp;C Order Fulfillment View&quot;)
				{
					var oOrderBO = TheApplication().GetBusObject(&quot;Order Item&quot;);
					var oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
					var oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
					with (oLineBC)
					{	 ClearToQuery();
						 SetViewMode(AllView);
						 SetSearchSpec(&quot;Root Order Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));					
						 SetSearchSpec(&quot;Product Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - GPP&quot;));
						 //SetSearchSpec(&quot;VHA Siebel Product Type&quot;,TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Device&quot;));
						 SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
						 ExecuteQuery(ForwardBackward);			
						 if (FirstRecord())
						 {				 			
							with(oLineXA)
							{
								ClearToQuery();
								SetViewMode(AllView);
								ActivateField(&quot;Text Value&quot;);
								SetSearchSpec(&quot;Name&quot;,&quot;IMEI/Serial Number&quot;);
								ExecuteQuery(ForwardOnly);								
								if (FirstRecord()){
									SetFieldValue(&quot;Text Value&quot;, this.GetFieldValue(&quot;VF IMEI TBUI&quot;));
									WriteRecord();
								}
							}
						 }
					}	
				}
				TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
				
				//Added for tree project
				var sView = TheApplication().ActiveViewName();
				if((sView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; &amp;&amp; this.GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;Plan and Device&quot;) ||(sView == &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot; &amp;&amp; this.GetFieldValue(&quot;VF ConnectionType&quot;) == &quot;Plan and Device&quot;) ||  sView == &quot;VF Order Entry - IMEI Allocation View&quot; || sView == &quot;VF Order Entry - Line Items Detail View&quot;)
				{
					var sIMEIEID = &quot;&quot;;
					var sSIMType = this.GetFieldValue(&quot;Shipping&quot;);
					var sSIMTypeeSIM =  TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
					var sSIMTypePhysical =  TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;Physical&quot;);
					var sIMEI = this.GetFieldValue(&quot;VF IMEI TBUI&quot;);
					var seSIMDownload = this.GetFieldValue(&quot;eSIM Download&quot;);
					var sEID = this.GetFieldValue(&quot;EID&quot;);
					var sStockIndicator = this.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;); 
					if(sStockIndicator == &quot;In Stock&quot; || sStockIndicator == null || sStockIndicator == &quot;&quot;)
					{
						if((sIMEI == &quot;&quot; || sIMEI == null) &amp;&amp; (sEID != null &amp;&amp; sEID != &quot;&quot;))
						{
							if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
							{
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
								this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
							}
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
						}
						if(sIMEI != &quot;&quot; &amp;&amp; sIMEI != null &amp;&amp; sSIMType != sSIMTypePhysical &amp;&amp; seSIMDownload != TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;QR Code&quot;))
						{
							var oBO = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
							var oBC = oBO.GetBusComp(&quot;VF IMEI List&quot;);
							with(oBC)
							{
								SetViewMode(AllView);
								ClearToQuery();
								ActivateField(&quot;IMEI&quot;);			
								ActivateField(&quot;EID&quot;);
								SetSearchSpec(&quot;IMEI&quot;, sIMEI);
								ExecuteQuery(ForwardOnly);
								var isRec = FirstRecord();
								if(isRec)
								{
									sIMEIEID = GetFieldValue(&quot;EID&quot;);
								}
							}
					
							if(sIMEIEID != &quot;&quot; &amp;&amp; sIMEIEID != null)
							{
								if(sSIMType == null || sSIMType == &quot;&quot;)
								{
									this.SetFieldValue(&quot;Shipping&quot;, sSIMTypeeSIM);
									if(seSIMDownload == null || seSIMDownload == &quot;&quot;)
									{
										this.SetFieldValue(&quot;eSIM Download&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;));
									}
								}
								else if(sSIMType == sSIMTypeeSIM &amp;&amp; (seSIMDownload == null || seSIMDownload == &quot;&quot;))
								{
									this.SetFieldValue(&quot;eSIM Download&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;));
								}
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
								this.SetFieldValue(&quot;EID&quot;,sIMEIEID);
								this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
							}
							else
							{
								if(sSIMType == sSIMTypeeSIM &amp;&amp; (seSIMDownload == null || seSIMDownload == &quot;&quot;))
								{
									this.SetFieldValue(&quot;eSIM Download&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;));
								}

								if(this.GetFieldValue(&quot;eSIM Download&quot;) == &quot;Push&quot; || this.GetFieldValue(&quot;eSIM Download&quot;) == &quot;&quot;)
								{
									if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
										this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
									}
									if(this.GetFieldValue(&quot;eSIM Download&quot;) == &quot;Push&quot;)
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);	
									}
									else 
									{
										this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
									}
								}
							}
						}
					}
					if(sStockIndicator == &quot;Out of Stock - Connect Later&quot;)
					{
						if(this.GetFieldValue(&quot;EID&quot;) != null &amp;&amp; this.GetFieldValue(&quot;EID&quot;) !=&quot;&quot;)
						{
							this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;N&quot;);
							this.SetFieldValue(&quot;EID&quot;,&quot;&quot;);
						}
						this.SetFieldValue(&quot;EID Read Only Flag1&quot;,&quot;Y&quot;);
					}					
				}
			break; //Added for tree project

			//SK 10.6.17 - Added below code for retrofit from 17.2 on 17.3
			case &quot;VF Sharing Order&quot;:
				this.ActivateField(&quot;VF Sharing Order&quot;);
				var sActiveView = TheApplication().ActiveViewName();
		       	if(this.GetFieldValue(&quot;VF Sharing Order&quot;) == &quot;N&quot;)
		       	{		
					this.ActivateField(&quot;Sharing Lead MSISDN&quot;);
					this.ActivateField(&quot;Sharing New Lead MSISDN&quot;);
					this.ActivateField(&quot;Sharing Action&quot;);
					if ((sActiveView == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || sActiveView == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot; || sActiveView == &quot;VHA Customise Service View - Manage Service&quot;) &amp;&amp; (this.GetFieldValue(&quot;Sharing Group Id&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Sharing Group Id&quot;) == null || this.GetFieldValue(&quot;Sharing Action Calc&quot;) == &quot;&quot;))
					{
						this.SetFieldValue(&quot;Sharing Lead MSISDN&quot;,&quot;&quot;);
						this.SetFieldValue(&quot;Sharing New Lead MSISDN&quot;,&quot;&quot;);
						this.SetFieldValue(&quot;Sharing Action&quot;,&quot;&quot;);
						this.WriteRecord();
					}
				}//Added code for PKE000000045550
			break;
			//Kathambari - 29/04/2016 - Added for AOA- To change accessory stock indicator to out of stock when service stInd is out of stock
			/*case &quot;VF Stock Indicator TBUI&quot;:
