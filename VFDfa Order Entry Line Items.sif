			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetCustomFieldsForPromServiceOrders"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Nikhil Joshi: 28.07.2014: Added for Promotion Bundling
function SetCustomFieldsForPromServiceOrders (sOrderId,sLineItemId)
{
	try
	{
		this.ActivateField(&quot;Action Code&quot;);
		this.ActivateField(&quot;Parent Order Item Id&quot;);
		var sApp=TheApplication(), sErrorMsg=&quot;&quot;, bRecord=false, bUpdateFields=false, i=0;
		var sOwnerContactId=&quot;&quot;,sBillingAccountId=&quot;&quot;,sContactMM=&quot;&quot;,sContactFirstName=&quot;&quot;,sContactLastName=&quot;&quot;;
		var sServicePIN=&quot;&quot;,sVFInstalledAssetName=&quot;&quot;,sVFServiceOrderSubType=&quot;&quot;;
		var sBO,sBC,sBO1,sBC1;
		sBO = sApp.GetBusObject(&quot;Order Item&quot;);
		sBC = sBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		sBO1 = sApp.GetBusObject(&quot;QAS Account Address Billing&quot;);
		sBC1 = sBO1.GetBusComp(&quot;VF Billing Account&quot;);
		with(sBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Owner Contact Id&quot;);
			ActivateField(&quot;Service PIN&quot;);
			ActivateField(&quot;VF Installed Asset Name&quot;);
			ActivateField(&quot;VF Service Order Sub Type&quot;);
//			ActivateField(&quot;Display Reason Code&quot;);
//			ActivateField(&quot;VF Comments&quot;);
//			ActivateField(&quot;VF TNR Id&quot;);
//			ActivateField(&quot;VF Transfer Sub Type Connect&quot;);
			SetSearchExpr(&quot;[Id] = &apos;&quot;+sLineItemId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			for(bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			{
				sBillingAccountId = GetFieldValue(&quot;Billing Account Id&quot;);
				sOwnerContactId = GetFieldValue(&quot;Owner Contact Id&quot;);
				sServicePIN = GetFieldValue(&quot;Service PIN&quot;);
				sVFInstalledAssetName = GetFieldValue(&quot;VF Installed Asset Name&quot;);
				sVFServiceOrderSubType = GetFieldValue(&quot;VF Service Order Sub Type&quot;);
				if(sVFServiceOrderSubType == &quot;&quot; || sVFServiceOrderSubType == null)
					SetFieldValue(&quot;VF Service Order Sub Type&quot;, &quot;Connect&quot;);
				if((sOwnerContactId != &quot;&quot; &amp;&amp; sOwnerContactId != null &amp;&amp; sServicePIN != &quot;&quot; &amp;&amp;
				sServicePIN != null &amp;&amp; sVFInstalledAssetName != &quot;&quot; &amp;&amp; sVFInstalledAssetName != null) ||
				(sBillingAccountId == &quot;&quot; || sBillingAccountId == null))
					continue;
				with(sBC1)
				{
					ActivateField(&quot;Password&quot;);
					ActivateField(&quot;Primary Contact Id&quot;);
					ActivateField(&quot;Billing Account Primary Contact First Name&quot;);
					ActivateField(&quot;Billing Account Primary Contact Last Name&quot;);
					ActivateField(&quot;Billing Account Primary Contact M/M&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Id] = &apos;&quot;+sBillingAccountId+&quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sServicePIN = GetFieldValue(&quot;Password&quot;);
						sOwnerContactId = GetFieldValue(&quot;Primary Contact Id&quot;);
						sContactFirstName = GetFieldValue(&quot;Billing Account Primary Contact First Name&quot;);
						sContactLastName = GetFieldValue(&quot;Billing Account Primary Contact Last Name&quot;);
						sContactMM = GetFieldValue(&quot;Billing Account Primary Contact M/M&quot;);
						if(sContactMM != &quot;&quot; &amp;&amp; sContactMM != null)
							sVFInstalledAssetName = sContactMM+&quot; &quot;+sContactFirstName+&quot; &quot;+sContactLastName;
						else if(sContactLastName != &quot;&quot; &amp;&amp; sContactLastName != null)
							sVFInstalledAssetName = sContactFirstName+&quot; &quot;+sContactLastName;
					}
				}
				if(GetFieldValue(&quot;Owner Contact Id&quot;) == &quot;&quot; || GetFieldValue(&quot;Owner Contact Id&quot;) == null)
					SetFieldValue(&quot;Owner Contact Id&quot;, sOwnerContactId);
				if(GetFieldValue(&quot;Service PIN&quot;) == &quot;&quot; || GetFieldValue(&quot;Service PIN&quot;) == null)
					SetFieldValue(&quot;Service PIN&quot;, sServicePIN);
				if(GetFieldValue(&quot;VF Installed Asset Name&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Installed Asset Name&quot;) == null)
					SetFieldValue(&quot;VF Installed Asset Name&quot;, sVFInstalledAssetName);
//				if(GetFieldValue(&quot;Display Reason Code&quot;) == &quot;&quot; || GetFieldValue(&quot;Display Reason Code&quot;) == null)
//					SetFieldValue(&quot;Display Reason Code&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF Comments&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Comments&quot;) == null)
//					SetFieldValue(&quot;VF Comments&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF TNR Id&quot;) == &quot;&quot; || GetFieldValue(&quot;VF TNR Id&quot;) == null)
//					SetFieldValue(&quot;VF TNR Id&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF Transfer Sub Type Connect&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Transfer Sub Type Connect&quot;) == null)
//					SetFieldValue(&quot;VF Transfer Sub Type Connect&quot;, &quot;&quot;);
				WriteRecord();
			}//for(bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Line Number&quot;);
			ActivateField(&quot;Line Number&quot;);
			SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Root Order Item Id] = [Id]&quot;);
			SetSortSpec(&quot;Created(ASCENDING)&quot;);
			ExecuteQuery(ForwardOnly);
			for(i=1,bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			{
				SetFieldValue(&quot;VF Line Number&quot;, i++);
				WriteRecord();
			}
		}//with(sBC)
	}
	catch(e)
	{
		sErrorMsg += e.errText;
		sApp.RaiseErrorText(sErrorMsg);
	}
	finally
	{
		sApp = null;
		sBC = sBO = null;
/*Below variables are nullified by JAGJIT on 18/03/2019*/
		sBC1 = null;
		sBO1 = null;


	}
}"
