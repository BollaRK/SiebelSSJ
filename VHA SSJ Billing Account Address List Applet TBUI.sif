			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="RefreshAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function RefreshAddress(MethodName)
{

/*
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==================================================================
 * 12/12/2014  Subramanian Production 		Refresh Issue in TBUI RefreshAddressTBUI Button			  
 */
	try
	{
		
		TheApplication().Trace(&quot;Before Refresh&quot;);

		//var sId = this.BusComp().GetFieldValue(&quot;Account Id&quot;);
		this.BusComp().SetViewMode(AllView);
		this.BusComp().ClearToQuery();
		this.BusComp().ExecuteQuery();
		
		TheApplication().Trace(&quot;After Refresh&quot;);
	
	}
	
	catch(e)
	{
	
		throw (e);
	}
	finally
	{
	
	}	



}"
			   SEQUENCE="1"
			   UPDATED="03/17/2026 21:01:10"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="03/17/2026 21:01:10"
			   CREATED_BY="RAVIKUMARB">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_InvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Account Address List Applet (SCW) - Street
 * Method Name           : 	WebApplet_InvokeMethod
 * Component Information : 	Method handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2005	RNZ			Defect 665	An Update to Billing Account Address was not displayed 
 *										in Billing Profile without a refresh of the parent.
 */

// MIND: This code is also duplicated on the other Account Address List Applets (SCW)

function WebApplet_InvokeMethod (MethodName)
{
	try
	{
		// Declare variables
		var oBC;
		var pBC;
		var sId;
	
		switch (MethodName)
		{
			// only execute logic when the &quot;Save&quot; button is clicked by the user
			case &quot;ExplicitWriteRecord&quot;:
			
			this.BusComp().WriteRecord();
		
			/*	oBC = this.BusComp();
				pBC = oBC.ParentBusComp();
				// Get the Row Id of the current parent record to use in the refresh
				sId = pBC.GetFieldValue(&quot;Id&quot;);
			
				// Refresh view
				pBC.ClearToQuery();
				pBC.SetSearchSpec(&quot;Id&quot;, sId);
			   	pBC.ExecuteQuery();*/
			break;
			// VF 27/05/2009 VL - Added for PR265 to force users to query QAS at least once			
		//	case &quot;EditRecord&quot;://commented fot TBUI scenario to skip QAS check while edit
			case &quot;NewRecord&quot;:
				TheApplication().SetProfileAttr(&quot;QAS Query Executed&quot;, &quot;N&quot;);
				TheApplication().SetProfileAttr(&quot;QAS Query Validation&quot;, &quot;Y&quot;);
			break;
			default:
			break;
		}
	}
	catch (e)
	{
		throw (e);
	}
	finally
	{
		// empty
	}
}"
			   SEQUENCE="2"
			   UPDATED="03/17/2026 21:01:10"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="03/17/2026 21:01:10"
			   CREATED_BY="RAVIKUMARB">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{

//Added for TBUI, record  will not be editable for end dated record

if(MethodName == &quot;EditRecord&quot; ||  MethodName == &quot;SetPrimary&quot;)
{
	this.BusComp().ActivateField(&quot;End Date&quot;);
	var sEndDate = this.BusComp().GetFieldValue(&quot;End Date&quot;);
	if(sEndDate == &quot;&quot; || sEndDate == null)
	{
	CanInvoke = &quot;TRUE&quot;; 		
	return (CancelOperation);
	}
	else
	{
	CanInvoke = &quot;FALSE&quot;; 		
	return (CancelOperation);
	}
}
	return (ContinueOperation);
}"
			   SEQUENCE="3"
			   UPDATED="03/17/2026 21:01:10"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="03/17/2026 21:01:10"
			   CREATED_BY="RAVIKUMARB">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
if(MethodName == &quot;EditRecord&quot;)
{
	
	TheApplication().SetProfileAttr(&quot;QAS Query Executed&quot;, &quot;Y&quot;); // Added for Postpay TBUI, to supress the QAS error while save/change
	TheApplication().SetProfileAttr(&quot;QAS Query Validation&quot;, &quot;N&quot;);	
	
}
if(MethodName == &quot;RefreshAddressTBUI&quot;)
{
	var smethodname = &quot;RefreshAddress&quot;;
	RefreshAddress(smethodname);
    return(CancelOperation);
}

else if(MethodName==&quot;NewRecord&quot;)
{
		TheApplication().SetProfileAttr(&quot;QAS Query Executed&quot;, &quot;N&quot;);
		TheApplication().SetProfileAttr(&quot;QAS Query Validation&quot;, &quot;Y&quot;);
}
else if(MethodName == &quot;ExplicitWriteRecord&quot;) //Added for PKE000000023205 fix - chitra - 29/05/2015
{
	var bQASExecuted = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;); 
	TheApplication().SetProfileAttr(&quot;QAS Query Validation&quot;, &quot;N&quot;);
	if (bQASExecuted != &quot;Y&quot;)
		{
			TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query PSMA at least once before saving an unvalidated address.&quot;);
		}
}


	return (ContinueOperation);
}"
