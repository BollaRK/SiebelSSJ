		<BUSINESS_COMPONENT
		   CACHE_DATA="N"
		   CLASS="CSSBCBase"
		   COMMENTS="Created for PIPE"
		   DIRTY_READS="Y"
		   DISTINCT="N"
		   FORCE_ACTIVE="N"
		   GENREASSIGNACT="N"
		   INACTIVE="N"
		   INSERT_UPDATE_ALL_COLUMNS="N"
		   LOG_CHANGES="Y"
		   MULTI_RECIPIENT_SELECT="N"
		   NAME="VHA NBN Order Details"
		   NO_DELETE="N"
		   NO_INSERT="N"
		   NO_MERGE="N"
		   NO_UPDATE="N"
		   OBJECT_LOCKED="N"
		   OWNER_DELETE="N"
		   POPUP_VISIBILITY_AUTO_ALL="N"
		   SCRIPTED="Y"
		   SEARCH_SPECIFICATION="[Type] = &apos;NBN Order Details&apos;"
		   TABLE="S_ORDER_ITEM_XM"
		   TYPE="Non-Transient"
		   UPDATED="03/27/2018 15:58:23"
		   UPDATED_BY="SADMIN"
		   CREATED="08/06/2017 23:44:49"
		   CREATED_BY="SADMIN">
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
try
{
    if(MethodName == &quot;CancelNBNOrder&quot;)
	{
	 var sErrMsg = &quot;&quot;;
	 var strWORKFLOW_NAME = &quot;VHA NBN Manage Order&quot;;
	 var strWORKFLOW_NAME_hold = &quot;VF OM Cancel Order&quot;;
	 //var strWORKFLOWREST_NAME=&quot;VHA NBN Manage Order-Rest&quot;;
	 var ServiceOrderId = this.GetFieldValue(&quot;Service Order Id&quot;);
	 var NBNOrderNum = this.GetFieldValue(&quot;NBN Order Id&quot;);
	 var serviceProvider= this.GetFieldValue(&quot;Service Provider Reference&quot;); 
	 var callsToCoreCheck= this.GetFieldValue(&quot;Calls To Core API Calc&quot;);
	 var io = &quot;[VHA NBN Order Details.Service Order Id]=&quot;;
	 var searchSpec = &quot;&quot;+io+&quot; &apos;&quot;+ServiceOrderId+&quot;&apos;&quot; ;
	 var ActiveBO = TheApplication().ActiveBusObject();
     var OrderBC = ActiveBO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;); 
 
     var err1 = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9032&quot;);
     var err2 = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9033&quot;);
     var err3 = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9034&quot;);
     
     var sFtn = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Building&quot;);
     var sFtb = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Node&quot;);
     var sFtc = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Curb&quot;); //SURESH G - Added for FTTC CR
     
	 var sAppmtId = &quot;&quot;;
	 var sAppStDt = &quot;&quot;;
	 var bsWFManager;
	 var psInputs;
	 var psOutputs;
	 var strError;
	 var gErrorMessage;

	 //Sakthi:Start:Added for Imagine Cancel Vision Order
	 this.ActivateField(&quot;NBN Order Status&quot;);
	 this.ActivateField(&quot;Access Technology&quot;);
	 var NBNOrderStatus = this.GetFieldValue(&quot;NBN Order Status&quot;); 							
	 var sAccessTech =  this.GetFieldValue(&quot;Access Technology&quot;);
	 var sPONR = &quot;&quot;;
	 //Sakthi:End:Added for Imagine Cancel Vision Order

		OrderBC.SetViewMode(AllView);
		OrderBC.ClearToQuery();
		OrderBC.ActivateField(&quot;Status&quot;);
		OrderBC.ActivateField(&quot;Billing Account Id&quot;);
		OrderBC.ActivateField(&quot;Service Account Id&quot;);
		OrderBC.ActivateField(&quot;Siebel Product Type&quot;);	
		OrderBC.ActivateField(&quot;VF Network Identifier&quot;);	 //Added for Imagine
		OrderBC.SetSearchSpec(&quot;Id&quot;, ServiceOrderId);
		OrderBC.ExecuteQuery(ForwardOnly);
		if(OrderBC.FirstRecord())
		{
			var status = OrderBC.GetFieldValue(&quot;Status&quot;);
			var BillingAccId = OrderBC.GetFieldValue(&quot;Billing Account Id&quot;);
			var serviceAccId = OrderBC.GetFieldValue(&quot;Service Account Id&quot;);
			var SiebelProdType = OrderBC.GetFieldValue(&quot;Siebel Product Type&quot;);
			var strNetworkProvider = OrderBC.GetFieldValue(&quot;VF Network Identifier&quot;); //Added for Imagine
			//var serviceProvider=&quot;TPG&quot;;//Divya added need to fetch from calc value for testing
			this.ActivateField(&quot;Order Id&quot;);
			var OrderId = this.GetFieldValue(&quot;Order Id&quot;);
			var sa = &quot;[Header.Id]=&quot;;
			var srchSpec = &quot;&quot;+sa+&quot; &apos;&quot;+OrderId+&quot;&apos;&quot; ;
	        if(status != &quot;Pending&quot; &amp;&amp; status != &quot;On Hold&quot;)
			{
				 if(NBNOrderNum == &quot;&quot; &amp;&amp; NBNOrderNum == null)
				 {
				    throw(&quot;VFErrorCode#VHA_PIPE_9032: &quot;+ err1 +&quot; &quot;);				    
				 }
	             else
	             {		             
					//Lavanya Added for NBN Appointment Date Comparison - Starts.		             
     				 this.ActivateField(&quot;Cancel&quot;);
     				 this.ActivateField(&quot;Access Technology&quot;);
     				 if(this.GetFieldValue(&quot;Cancel&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Cancel&quot;) == null)
     				 {
     					throw(&quot;VFErrorCode#VHA_PIPE_9033: &quot;+ err2 +&quot; &quot;);
     				 }
     				 
     				 if((strNetworkProvider == &quot;NBN&quot; &amp;&amp; (this.GetFieldValue(&quot;Access Technology&quot;) == sFtn || this.GetFieldValue(&quot;Access Technology&quot;) == sFtb || this.GetFieldValue(&quot;Access Technology&quot;) == sFtc)) || strNetworkProvider == &quot;OPTICOMM&quot;)
					 {
	     				 	/* var oAppBC = ActiveBO.GetBusComp(&quot;VHA NBN Appointment&quot;); 
							oAppBC.SetViewMode(AllView);				      				 
	     				 	oAppBC.ClearToQuery();
							oAppBC.ActivateField(&quot;Order Item Id&quot;);
							oAppBC.ActivateField(&quot;Status&quot;);
							oAppBC.ActivateField(&quot;Appointment Start Date&quot;);					
							oAppBC.SetSearchExpr(&quot;[Order Item Id] = &apos;&quot;+ServiceOrderId+&quot;&apos; AND ([Status] &lt;&gt; &apos;Cancelled&apos; AND [Status] &lt;&gt; &apos;Completed&apos;)&quot;);
							oAppBC.ExecuteQuery(ForwardOnly);
							if(oAppBC.FirstRecord())
							{
								sAppmtId = oAppBC.GetFieldValue(&quot;Id&quot;);
								sAppStDt = oAppBC.GetFieldValue(&quot;Appointment Start Date&quot;);
							} */
							this.ActivateField(&quot;Appointment Status&quot;);
							this.ActivateField(&quot;Appnt Strt Dt&quot;);
							this.ActivateField(&quot;NBN Appointment Id&quot;);
							
							var apptStatus = this.GetFieldValue(&quot;Appointment Status&quot;);
					 		sAppStDt = this.GetFieldValue(&quot;Appnt Strt Dt&quot;);
					 		sAppmtId = this.GetFieldValue(&quot;NBN Appointment Id&quot;);
							
		     				 if(sAppmtId == &quot;&quot; || sAppmtId == null)
					         {
					         }
					         else
					         {	
					         	 //SK - 1.02.18 - Added below condition to trigger only if Status has N configured in LOV
								 if ( TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NBN_ALLOW_APP_PONR_CHECK&quot;,&quot;Cancel|&quot;+apptStatus) == &quot;N&quot;) 
								 {
									 var sSchedule = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ORDER_PONR_CONFIG&quot;,&quot;NBNOrderPONR|FTTNBAppointmentScheduleName&quot;);				        
									 this.ActivateField(&quot;Appnt Strt Dt&quot;);	
									 var bsAppoint = TheApplication().GetService (&quot;Workflow Process Manager&quot;);
									 var bsInp = TheApplication().NewPropertySet();
									 var bsOut = TheApplication().NewPropertySet();	
									 bsInp.SetProperty(&quot;ProcessName&quot;, &quot;VHA Get Business Hours Time&quot;);							 
									 bsInp.SetProperty(&quot;StartTime&quot;, this.GetFieldValue(&quot;GetStamp&quot;));
									 bsInp.SetProperty(&quot;EndTime&quot;, sAppStDt);	
									 bsInp.SetProperty(&quot;ScheduleName&quot;, sSchedule);
									 bsInp.SetProperty(&quot;Unit&quot;, &quot;Hours&quot;);
									 bsInp.SetProperty(&quot;TimeZone&quot;, &quot;(GMT+10:00) Canberra, Melbourne, Sydney&quot;);							 
									 bsAppoint.InvokeMethod(&quot;RunProcess&quot;, bsInp, bsOut);					     
									 var sBusTime = bsOut.GetProperty(&quot;BElapsedTime&quot;);
									 var sBusLov = &quot;&quot;;
									 if(strNetworkProvider == &quot;NBN&quot;)
										sBusLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ORDER_PONR_CONFIG&quot;,&quot;NBNOrderPONR|FTTNBAppointmentDurationHours&quot;);
									 if(strNetworkProvider == &quot;OPTICOMM&quot;)
										sBusLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ORDER_PONR_CONFIG&quot;,&quot;OPTIOrderPONR|AppointmentDurationHours&quot;);

									 if(ToInteger(sBusTime) &lt; ToInteger(sBusLov))
									 {
										throw(&quot;VFErrorCode#VHA_PIPE_9034: &quot;+ err3 +&quot; &quot;);
									 }
								 }
							     
						     }
						 }					     
						//Lavanya Added for NBN Appointment Date Comparison - Ends.    		             
					 	
						//Added for Imagine						
						var strTransactionName = &quot;&quot;;
						if(strNetworkProvider == &quot;NBN&quot; || strNetworkProvider == &quot;&quot; || strNetworkProvider == null)
						{
							strNetworkProvider = &quot;NBN&quot;;
							strTransactionName = &quot;VHA NBN Cancel Order REST Service&quot;;
						}
						if(strNetworkProvider == &quot;OPTICOMM&quot;)
						{
							strTransactionName = &quot;VHA OPTI Cancel Order REST Service&quot;;
						}
						if(strNetworkProvider == &quot;VISION&quot;)
						{
							//strTransactionName = &quot;VHA VISION Cancel Order REST Service&quot;;

							//TheApplication().RaiseErrorText(&quot;Cancel Order for Vision cannot be done from Siebel.&quot;); // Not in Imagine R1.1 scope. May need to incorporate later.
							//Sakthi:Start:Added for Imagine Cancel Vision Order
							if(sAccessTech.substring(0,5) == &quot;FTTBW&quot; &amp;&amp; NBNOrderStatus != null &amp;&amp; NBNOrderStatus !=&quot;&quot;)
								sPONR = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ORDER_PONR_CONFIG&quot;,&quot;VISIONFTTBW|&quot; + NBNOrderStatus.toUpperCase());
							if(sAccessTech.substring(0,8) == &quot;TRANSACT&quot; &amp;&amp; NBNOrderStatus != null &amp;&amp; NBNOrderStatus !=&quot;&quot;)
								sPONR = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ORDER_PONR_CONFIG&quot;,&quot;VISIONTRANSACT|&quot; + NBNOrderStatus.toUpperCase());
							
							if(sPONR == &quot;Y&quot;)
							{
								throw(&quot;VFErrorCode#VHA_PIPE_9034: &quot;+ err3 +&quot; &quot;);
							}
							else
							{
								strTransactionName = &quot;VFVisionCancelOrder&quot;;
								strWORKFLOW_NAME = &quot;VHA Vision Cancel Order WF&quot;;
							}
							//Sakthi:End:Added for Imagine Cancel Vision Order
						}
						//Added for Imagine
						
						bsWFManager = TheApplication().GetService (&quot;Workflow Process Manager&quot;);
					 	psInputs = TheApplication().NewPropertySet();
					 	psOutputs = TheApplication().NewPropertySet();
						this.ActivateField(&quot;Cancel&quot;);
						this.ActivateField(&quot;NBN Order Type&quot;);

						if(strNetworkProvider == &quot;NBN&quot; || strNetworkProvider == &quot;OPTICOMM&quot;)//Sakthi:Added for Imagine Cancel Vision Order
						{

							psInputs.SetProperty(&quot;ProcessName&quot;, strWORKFLOW_NAME);
							psInputs.SetProperty(&quot;searchSpec&quot;, searchSpec);				         
							psInputs.SetProperty(&quot;BillingAccId&quot;, BillingAccId);
							psInputs.SetProperty(&quot;serviceAccId&quot;, serviceAccId);
							psInputs.SetProperty(&quot;srchSpec&quot;, srchSpec);
							psInputs.SetProperty(&quot;CancelResn&quot;, this.GetFieldValue(&quot;Cancel&quot;));      //Lavanya added for NBN Cancel
							psInputs.SetProperty(&quot;NbnType&quot;, this.GetFieldValue(&quot;NBN Order Type&quot;)); //Lavanya added for NBN Cancel
							psInputs.SetProperty(&quot;OrderItemXMId&quot;, this.GetFieldValue(&quot;Id&quot;)); //Ravindra: Added this line of code for R3.4 
							psInputs.SetProperty(&quot;SiebelProdType&quot;, SiebelProdType);		
							psInputs.SetProperty(&quot;NetworkProvider&quot;, strNetworkProvider); //Added for Imagine	
							psInputs.SetProperty(&quot;TransactionName&quot;, strTransactionName); //Added for Imagine	
						 
							if(callsToCoreCheck==&quot;Y&quot;){
								psInputs.SetProperty(&quot;RESTCall&quot;, &quot;Y&quot;);	
								psInputs.SetProperty(&quot;NBNOrderId&quot;, NBNOrderNum);
								if (serviceProvider != &quot;&quot; &amp;&amp; serviceProvider != null)
								{
								psInputs.SetProperty(&quot;Service Provider Reference&quot;, serviceProvider);
								}
								else
								{
									psInputs.SetProperty(&quot;Service Provider Reference&quot;, &quot;VHA&quot;);
								}							
							}
						}
						//Sakthi:Start:Added for Imagine Cancel Vision Order
						if(strNetworkProvider == &quot;VISION&quot;)
						{
							this.ActivateField(&quot;RSPIdCalc&quot;);
							this.ActivateField(&quot;Service Account Number&quot;); //Create a new field using join with S_ORG_EXT.PAR_ROW_ID = Service Account Id
							this.ActivateField(&quot;Customer Reference Number&quot;); //Create a new field
							this.ActivateField(&quot;New Customer Reference Id&quot;); //added for 2.2 GFast
							this.ActivateField(&quot;Service Id&quot;); //added for 2.2 GFast
							//Sakthi:START:23/7/25:added for 2.2 GFast
							var sNewCustRef = &quot;&quot;;
							var sOldCustRef = &quot;&quot;;
							var sConnectCustRef = &quot;&quot;;
							sNewCustRef = this.GetFieldValue(&quot;New Customer Reference Id&quot;);
							sConnectCustRef = this.GetFieldValue(&quot;Customer Reference Number&quot;);
							sOldCustRef = this.GetFieldValue(&quot;Service Id&quot;);
							//Sakthi:END:23/7/25:added for 2.2 GFast
							psInputs.SetProperty(&quot;ProcessName&quot;, strWORKFLOW_NAME);
							psInputs.SetProperty(&quot;Transaction Name&quot;, strTransactionName); 
							psInputs.SetProperty(&quot;VisionOrderId&quot;, NBNOrderNum);
							psInputs.SetProperty(&quot;RSPId&quot;, this.GetFieldValue(&quot;RSPIdCalc&quot;));
							psInputs.SetProperty(&quot;CustomerAccountNumber&quot;, this.GetFieldValue(&quot;Service Account Number&quot;));
							psInputs.SetProperty(&quot;OrderItemXMId&quot;, this.GetFieldValue(&quot;Id&quot;)); //Ravindra: Added this line of code for R3.4 
							//psInputs.SetProperty(&quot;CustomerReference&quot;, this.GetFieldValue(&quot;Customer Reference Number&quot;));
							//Sakthi:START:23/7/25:added for 2.2 GFast
							if (sNewCustRef != &quot;&quot; &amp;&amp; sNewCustRef != null)
							{
								psInputs.SetProperty(&quot;CustomerReference&quot;, sNewCustRef);
							}
							else if(sConnectCustRef != &quot;&quot; &amp;&amp; sConnectCustRef != null)
							{
								psInputs.SetProperty(&quot;CustomerReference&quot;, sConnectCustRef);
							}
							else
							{
								psInputs.SetProperty(&quot;CustomerReference&quot;, sOldCustRef);
							}
							//Sakthi:END:23/7/25:added for 2.2 GFast
							psInputs.SetProperty(&quot;AccessTechnology&quot;, sAccessTech);
							psInputs.SetProperty(&quot;BillingAccntId&quot;, BillingAccId);
							psInputs.SetProperty(&quot;CancelResn&quot;, this.GetFieldValue(&quot;Cancel&quot;));      
							psInputs.SetProperty(&quot;NbnType&quot;, this.GetFieldValue(&quot;NBN Order Type&quot;)); 	
						}
						//Sakthi:End:Added for Imagine Cancel Vision Order						 
					     bsWFManager.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs); 
					  }
					  
				 }
				 else
				 {
				  
				     bsWFManager = TheApplication().GetService (&quot;Workflow Process Manager&quot;);
					 psInputs = TheApplication().NewPropertySet();
					 psOutputs = TheApplication().NewPropertySet();						 
					 psInputs.SetProperty(&quot;ProcessName&quot;, strWORKFLOW_NAME_hold);
			         psInputs.SetProperty(&quot;RootLineItemId&quot;, ServiceOrderId);
			         //psInputs.SetProperty(&quot;RowId&quot;, OrderId);
			         psInputs.SetProperty(&quot;Object Id&quot;, OrderId);				 
				     bsWFManager.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);  
					     
				 }
				 //Ravindra: Added the below code for NBN Cancel Order PKE
				 var sErrMsgSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NBN_CANCEL_ORDER_FLG&quot;, &quot;SWITCH&quot;);
				 sErrMsg = psOutputs.GetProperty(&quot;Error Message&quot;);
				 if((sErrMsg == &quot;&quot;)  &amp;&amp; (sErrMsgSwitch == &quot;ON&quot;))
				 {
				 	TheApplication().SetProfileAttr(&quot;ErrMsg&quot;, sErrMsg);			 	
				 	TheApplication().SetProfileAttr(&quot;CancelBtnChk&quot;, &quot;Y&quot;);
					this.SetFieldValue(&quot;CancelBtnFlg&quot;, &quot;Y&quot;);
					this.WriteRecord();
				 }				 
				 this.ParentBusComp().InvokeMethod(&quot;RefreshRecord&quot;);
	      }	    	    
	    
       }
	return (CancelOperation);
    }	
	catch(e)
	{		
		if (defined(e.errText))
		{
			strError = e.errText + &quot;\r\n&quot; + e.toString(); 
			gErrorMessage = strError;
		}
		else
		{
			strError = e.toString(); 
			gErrorMessage = strError;
		}
		throw(e);
	}
	
	finally
	{
	    OrderBC = null;
	    //oAppBC = null;
	    ActiveBO = null;	  
	 	psInputs = null;
		psOutputs = null;
		bsWFManager = null;
		sBusTime = &quot;&quot;;
		sBusLov = &quot;&quot;;
		bsOut = &quot;&quot;;
		bsInp = &quot;&quot;;
		err1=&quot;&quot;;
		err2=&quot;&quot;;
		err3=&quot;&quot;;
		bsAppoint = null;
		sAppStDt = &quot;&quot;;
		sAppmtId = &quot;&quot;;
		sSchedule = &quot;&quot;;
		sFtn = &quot;&quot;;
		sFtb = &quot;&quot;;
		/*Below variables are nullified by JAGJIT on 27/03/2019*/
		bsInp = null;
		bsOut = null;
	} 
	return (ContinueOperation);
}"
