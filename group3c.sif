			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetCoverageCheckURL"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetCoverageCheckURL(sId)
{
try {
	
			/*var	boCoverageChk = TheApplication().GetBusObject(&quot;VF Coverage Check Thin&quot;);
			var	bcCoverageChk = boCoverageChk.GetBusComp(&quot;VF Coverage Check Thin&quot;);
			bcCoverageChk.SetViewMode(AllView);
			bcCoverageChk.ClearToQuery();
			bcCoverageChk.ActivateField(&quot;Map URL&quot;);
			bcCoverageChk.ActivateField(&quot;Status&quot;);
			bcCoverageChk.SetSearchSpec(&quot;Id&quot;,sId);
			bcCoverageChk.ExecuteQuery(ForwardOnly);
			if (bcCoverageChk.FirstRecord())
			{
			//Map URL,Status
			//with (bcCoverageChk) 
					gStatus	= bcCoverageChk.GetFieldValue(&quot;Status&quot;);
					gURL	= bcCoverageChk.GetFieldValue(&quot;Map URL&quot;);
			}*/
			var BOCoverageBand = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;);
			var BCCoverageBand = BOCoverageBand.GetBusComp(&quot;VF Coverage Check Band&quot;);
			var sPriorityPrev = &quot;&quot;;
			var sMBB1 = &quot;&quot;;
			var sMBB2 = &quot;&quot;;
			var sMBB3 = &quot;&quot;;
			var sMBB4 = &quot;&quot;;
			var sMBB5 = &quot;&quot;;
			var IsRecord = &quot;&quot;;
			BCCoverageBand.SetViewMode(AllView);
			BCCoverageBand.ClearToQuery();
			BCCoverageBand.ActivateField(&quot;Map URL&quot;);
			BCCoverageBand.ActivateField(&quot;Status&quot;);
			BCCoverageBand.SetSearchSpec(&quot;Coverage Id&quot;,sId);
			BCCoverageBand.ExecuteQuery(ForwardOnly);
			IsRecord = BCCoverageBand.FirstRecord();
			
			while(IsRecord){
				switch(BCCoverageBand.GetFieldValue(&quot;Coverage Status Priority&quot;)){
				 	case &quot;1&quot; :
				 		sMBB1 = BCCoverageBand.GetFieldValue(&quot;MBB Backup Coverage Status&quot;);
				 	break;
				 	case &quot;2&quot; :
				 		sMBB2 = BCCoverageBand.GetFieldValue(&quot;MBB Backup Coverage Status&quot;);
				 	break;
				 	case &quot;3&quot; :
				 		sMBB3 = BCCoverageBand.GetFieldValue(&quot;MBB Backup Coverage Status&quot;);
				 	break;
				 	case &quot;4&quot; :
				 		sMBB4 = BCCoverageBand.GetFieldValue(&quot;MBB Backup Coverage Status&quot;);
				 	break;
				 	case &quot;5&quot; :
				 		sMBB5 = BCCoverageBand.GetFieldValue(&quot;MBB Backup Coverage Status&quot;);
				 	break;
				 	default:
				 		gMBBCoverage = &quot;&quot;;//Roseline:04/07/2017 - Added to nullify the global variable
				 	break;
				}
				IsRecord = BCCoverageBand.NextRecord();
				
			}
			//Roseline:04/07/2017 - Changed the coverage value based on the priority to display the correct value
			if(sMBB1 != &quot;&quot; &amp;&amp; sMBB1 != null){
					gMBBCoverage = sMBB1;
				}
			else if(sMBB2 != &quot;&quot; &amp;&amp; sMBB2 != null){
					gMBBCoverage = sMBB2;
				}
			else if(sMBB3 != &quot;&quot; &amp;&amp; sMBB3 != null){
					gMBBCoverage = sMBB3;
				}
			else if(sMBB4 != &quot;&quot; &amp;&amp; sMBB4 != null){
					gMBBCoverage = sMBB4;
				}
			else if(sMBB5 != &quot;&quot; &amp;&amp; sMBB5 != null){
					gMBBCoverage = sMBB5;
				}
			

		}
		catch (e)
		{
			throw (&quot;From mGetCoverageCheckURL &quot;+e);
		} 
		finally {
			sId = null;
			//bcCoverageChk = null;
			//boCoverageChk = null;
			BCCoverageBand = null;
			BOCoverageBand = null;
		}
}"
