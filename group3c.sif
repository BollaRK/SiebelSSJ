			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{

	if(MethodName == &quot;SiteQualification&quot;)
	{
		try
		{
			var svc = TheApplication().GetService(&quot;VHA FBB BS&quot;);//(&quot;Workflow Process Manager&quot;);
    		var Input = TheApplication().NewPropertySet();
    		var Output = TheApplication().NewPropertySet();
			var sSessionId,sLocationId;
			var sBO = TheApplication().ActiveBusObject();
			var sBC1= sBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
			var sServProvRef = this.ParentBusComp().GetFieldValue(&quot;Service Provider Reference&quot;);// VHA NG 16/09/21 : NBN Rationalization
    		var sBC = sBO.GetBusComp(&quot;VHA NBN Manage Service BC&quot;);
			var sId = sBC.GetFieldValue(&quot;Id&quot;);
			//NROY: 29/10/2023 Added for Fibre Upgrade
			TheApplication().SetProfileAttr(&quot;SiteQualificationId&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;FibreConnectServiceable&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;FibreUpgradeHighSpeed&quot;,&quot;&quot;);

			with (sBC)
			{
				ActivateField(&quot;Wizard Session Id&quot;);
				ActivateField(&quot;NBN Location Id&quot;);
				ActivateField(&quot;Site Qualification Id&quot;);
				SetSearchSpec(&quot;Id&quot;,sId);
				ExecuteQuery();
				if(FirstRecord())
				{			
    				sSessionId = sBC.GetFieldValue(&quot;Wizard Session Id&quot;);
    				sLocationId = sBC.GetFieldValue(&quot;NBN Location Id&quot;);
				}
			}
			Input.SetProperty(&quot;OrderId&quot;, sSessionId);
			Input.SetProperty(&quot;LocationId&quot;, sLocationId);
			Input.SetProperty(&quot;ServProvRef&quot;, sServProvRef);// VHA NG 16/09/21 : NBN Rationalization
			svc.InvokeMethod(&quot;NBNSiteQual&quot;, Input, Output);
			this.SetFieldValue(&quot;Site Qualification Id&quot;, Output.GetProperty(&quot;SQId&quot;));
			
			//NROY: 29/10/2023 Added for Fibre Upgrade
			this.ActivateField(&quot;Fiber Connect Serviceable&quot;);
			this.SetFieldValue(&quot;Fiber Connect Serviceable&quot;, Output.GetProperty(&quot;FibreConnectServiceable&quot;)); 
			TheApplication().SetProfileAttr(&quot;SiteQualificationId&quot;,Output.GetProperty(&quot;SQId&quot;));
			TheApplication().SetProfileAttr(&quot;FibreConnectServiceable&quot;,Output.GetProperty(&quot;FibreConnectServiceable&quot;));
			TheApplication().SetProfileAttr(&quot;FibreUpgradeHighSpeed&quot;,Output.GetProperty(&quot;FibreUpgradeHighSpeed&quot;));

			this.WriteRecord();
			this.ClearToQuery();
			this.ExecuteQuery();
			
		}//try
		catch(e)
		{
			throw(e);
		}
		finally
		{
			Input = null;
			Output = null;
			svc = null;
		} 	   		
		return(CancelOperation);
	}
	
	if(MethodName == &quot;OneSQ&quot;)
	{
		try
		{
			var svc = TheApplication().GetService(&quot;VHA FBB BS&quot;);//(&quot;Workflow Process Manager&quot;);
    		var Input = TheApplication().NewPropertySet();
    		var Output = TheApplication().NewPropertySet();
			var sSessionId,sLocationId;
			var sBO = TheApplication().ActiveBusObject();
			var sBC1= sBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
			var sServProvRef = this.ParentBusComp().GetFieldValue(&quot;Service Provider Reference&quot;);// VHA NG 16/09/21 : NBN Rationalization
    		var sNBNAddrId = this.ParentBusComp().GetFieldValue(&quot;Service Point Address Id&quot;);//Vasavi added for Imagine manage Service vision
			var sNetIden = this.ParentBusComp().GetFieldValue(&quot;NetworkIdentifier&quot;);//Vasavi added for Imagine manage Service vision
			var sBC = sBO.GetBusComp(&quot;VHA NBN Manage Service BC&quot;);
			var sId = sBC.GetFieldValue(&quot;Id&quot;);
			this.ParentBusComp().ActivateField(&quot;NetworkIdentifier&quot;);
			var Network = this.ParentBusComp().GetFieldValue(&quot;NetworkIdentifier&quot;);
			//NROY: 29/10/2023 Added for Fibre Upgrade
			TheApplication().SetProfileAttr(&quot;SiteQualificationId&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;FibreConnectServiceable&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;FibreUpgradeHighSpeed&quot;,&quot;&quot;);

			with (sBC)
			{
				ActivateField(&quot;Wizard Session Id&quot;);
				ActivateField(&quot;NBN Location Id&quot;);
				ActivateField(&quot;Site Qualification Id&quot;);
				SetSearchSpec(&quot;Id&quot;,sId);
				ExecuteQuery();
				if(FirstRecord())
				{			
    				sSessionId = sBC.GetFieldValue(&quot;Wizard Session Id&quot;);
    				sLocationId = sBC.GetFieldValue(&quot;NBN Location Id&quot;);
				}
			}
			Input.SetProperty(&quot;NBNAddrId&quot;, sNBNAddrId);//Vasavi added for Imagine manage Service vision
			Input.SetProperty(&quot;Network&quot;, sNetIden);//Vasavi added for Imagine manage Service vision
			Input.SetProperty(&quot;OrderId&quot;, sSessionId);
			Input.SetProperty(&quot;LocationId&quot;, sLocationId);
			Input.SetProperty(&quot;Network&quot;, Network);
			Input.SetProperty(&quot;ServProvRef&quot;, sServProvRef);// VHA NG 16/09/21 : NBN Rationalization
			svc.InvokeMethod(&quot;NBNOneSiteQual&quot;, Input, Output);
			this.SetFieldValue(&quot;Site Qualification Id&quot;, Output.GetProperty(&quot;SQId&quot;));
			
			//NROY: 29/10/2023 Added for Fibre Upgrade
			this.ActivateField(&quot;Fiber Connect Serviceable&quot;);
			this.SetFieldValue(&quot;Fiber Connect Serviceable&quot;, Output.GetProperty(&quot;FibreConnectServiceable&quot;)); 
			TheApplication().SetProfileAttr(&quot;SiteQualificationId&quot;,Output.GetProperty(&quot;SQId&quot;));
			TheApplication().SetProfileAttr(&quot;FibreConnectServiceable&quot;,Output.GetProperty(&quot;FibreConnectServiceable&quot;));
			TheApplication().SetProfileAttr(&quot;FibreUpgradeHighSpeed&quot;,Output.GetProperty(&quot;FibreUpgradeHighSpeed&quot;));

			this.WriteRecord();
			this.ClearToQuery();
			this.ExecuteQuery();
			
		}//try
		catch(e)
		{
			throw(e);
		}
		finally
		{
			Input = null;
			Output = null;
			svc = null;
		} 	   		
		return(CancelOperation);
	}	
	
	return (ContinueOperation);
}"
