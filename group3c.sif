			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreQuery"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreQuery ()
{
/*
 * Component Name        : 	VHA FBB SS Login Info Thin
 * Method Name           : 	BusComp_PreQuery
 * Component Information : 	Checks a search spec has been entered. Designed
 *							to stop bad queries running against database and
 *							hanging sessions.
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 26/06/2017	Roseline				Initial Version
 */	
try
{
	if (TheApplication().GetSharedGlobal(&quot;FIND_BUTTON_CLICKED&quot;) == &quot;TRUE&quot;)
	{
		TheApplication().SetSharedGlobal(&quot;FIND_BUTTON_CLICKED&quot;, &quot;&quot;);
		if (this.GetSearchExpr() == &quot;&quot;)
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;19999&quot;));
	}
		
	return (ContinueOperation);
}
catch (e)
{
		throw(e);	
}
finally
{
}
}"
			   SEQUENCE="2"
			   UPDATED="08/06/2017 23:44:52"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:44:52"
