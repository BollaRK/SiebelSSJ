			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ClearAddressFields"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VHA Connect FBB TBC.BusComp_PreInvokeMethod
 * Method Name           : 	ClearAddressFields
 * Component Information : 	
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/02/2016	SK						Initial Version
 */
function ClearAddressFields()
{
	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VHA Connect FBB TBC.BusComp_PreInvokeMethod.ClearAddressFields&quot;);
		}
		
			//Activate Coverage Check Done Flag
			this.ActivateField(&quot;Coverage Check Done&quot;);
			this.ActivateField(&quot;Coverage Check Status&quot;);
			
			//Activating TBC Address fields
			this.ActivateField(&quot;Check NBN Address&quot;);
			this.ActivateField(&quot;Site Qualification&quot;);
			this.ActivateField(&quot;Check Address Flag&quot;);
			this.ActivateField(&quot;NBN Address&quot;);
			this.ActivateField(&quot;NBN Location Id&quot;);
			this.ActivateField(&quot;Address Selected&quot;);
			this.ActivateField(&quot;Address Status&quot;);
			this.ActivateField(&quot;QAS Address&quot;);
			this.ActivateField(&quot;QAS Address Status&quot;);
			this.ActivateField(&quot;WSDL Address Building&quot;);
			this.ActivateField(&quot;WSDL Address Type&quot;);
			this.ActivateField(&quot;WSDL Country&quot;);
			this.ActivateField(&quot;WSDL DPID&quot;);
			this.ActivateField(&quot;WSDL Floor&quot;);
			this.ActivateField(&quot;WSDL Floor Type&quot;);
			this.ActivateField(&quot;WSDL PO Box&quot;);
			this.ActivateField(&quot;WSDL Post Code&quot;);
			this.ActivateField(&quot;WSDL Private Bag&quot;);
			this.ActivateField(&quot;WSDL State&quot;);
			this.ActivateField(&quot;WSDL Street Name&quot;);
			this.ActivateField(&quot;WSDL Street Number&quot;);
			this.ActivateField(&quot;WSDL Street Type&quot;);
			this.ActivateField(&quot;WSDL Suburb&quot;);
			this.ActivateField(&quot;WSDL Validation Status&quot;);
			
			
			//SK 8.5.17 - Added below QAS fields nullifying code for Defect 241 as old values keep passing in the outbound xml
			//Setting QAS Address fields to null
			this.SetFieldValue(&quot;Address Selected&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Address Status&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;QAS Address&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;QAS Address Status&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Address Building&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Address Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Country&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL DPID&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Floor&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Floor Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL PO Box&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Post Code&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Private Bag&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL State&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Street Name&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Street Number&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Street Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Suburb&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;WSDL Validation Status&quot;,&quot;&quot;);
			
			//Setting address field values to null
			this.SetFieldValue(&quot;Site Qualification&quot;, &quot;N&quot;);
			this.SetFieldValue(&quot;Check Address Flag&quot;,&quot;Y&quot;);
			this.SetFieldValue(&quot;NBN Address&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;NBN Location Id&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Coverage Check Done&quot;, &quot;N&quot;);      //Reset Coverage check flag
			this.SetFieldValue(&quot;Check NBN Address&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Coverage Check Status&quot;, &quot;&quot;);
			WriteRecord();

	}

	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{
		
	}
}"
