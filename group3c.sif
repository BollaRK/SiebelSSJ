			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
try
{
	sNewFlag = &quot;Y&quot;;	
	this.WriteRecord();
	
	/*Modified the logic as part of FTTC-CR release*/
    var ActiveView = 	TheApplication().GetProfileAttr(&quot;ActiveViewName&quot;);
    var IsOrderFeasibilityreq = &quot;&quot;;
    var Lookupname = &quot;&quot;;
    if(ActiveView == &quot;VHA Native Order Appointment View&quot;)
    {
       Lookupname = &quot;Native&quot;;
    }
    else if (ActiveView == &quot;VHA NBN Appointment TBUI&quot; || ActiveView == &quot;VHA NBN Appointment Change Location TBUI&quot;)
    {
       Lookupname = &quot;TBUI&quot;;
       IsOrderFeasibilityreq = &quot;Y&quot;;
       
    }
    else if(ActiveView == &quot;VHA NBN Trouble Ticket - Appointment View&quot;)
    {
       Lookupname = &quot;TT&quot;;    
    }
 //   if(Lookupname != &quot;&quot;)
    if(Lookupname != &quot;&quot; &amp;&amp; Lookupname != null) //Roseline - Added
    {
    var LOVText = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEMAND_TYPE_UPDATE&quot;,Lookupname);
    if(LOVText == &quot;Y&quot;)
	{
		var sOrderItemId = this.GetFieldValue(&quot;Order Item Id&quot;);		
	    var sOrderId = this.GetFieldValue(&quot;Order Id&quot;);
	    var AppointmentId = this.GetFieldValue(&quot;Id&quot;);	
	    
        var wfservice = TheApplication().GetService(&quot;Workflow Process Manager&quot;);	
        var wfInputPS = TheApplication().NewPropertySet();
        var wfOutputPS = TheApplication().NewPropertySet();
        wfInputPS.SetProperty(&quot;Object Id&quot;,sOrderId);
        wfInputPS.SetProperty(&quot;Order Line Item Id&quot;,sOrderItemId);
        wfInputPS.SetProperty(&quot;IsOrderFeasibilityreq&quot;,IsOrderFeasibilityreq);
        wfInputPS.SetProperty(&quot;AppointmentId&quot;,AppointmentId);
        /*called this wf to stamp the demand type value*/
        wfInputPS.SetProperty(&quot;ProcessName&quot;,&quot;VHA FBB Set Demand Type WF&quot;);
        wfservice.InvokeMethod(&quot;RunProcess&quot;,wfInputPS,wfOutputPS);
        
	/*	var sAccessTech = &quot;&quot;;
		var sTransferType = &quot;&quot;;
		var sServiceClass = &quot;&quot;;
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sSQBC = sBO.GetBusComp(&quot;VHA Site Qualification Thin BC&quot;);
		var sConfigBC = sBO.GetBusComp(&quot;VHA Configuration List&quot;);
		var sApptBC = sBO.GetBusComp(&quot;VHA NBN Appointment Thin&quot;);
		var ApptCalc = &quot;&quot;;
		var sType = &quot;VHA_FBB_APPOINTMENT_ELIGIBILITY&quot;;
		var searchst = &quot;&quot;
		var sAmendDemandType = &quot;&quot;;
		with(sSQBC)
			{				
				ActivateField(&quot;AppointEligibilityCalc&quot;);
				ActivateField(&quot;Access Technology&quot;);
				ActivateField(&quot;NBN Transfer Type&quot;);
				ActivateField(&quot;Serviceability Class Calc&quot;);				
				ClearToQuery();
				SetViewMode(AllView);			
				SetSearchSpec(&quot;Order Line Item Id&quot;,sOrderItemId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					ApptCalc = GetFieldValue(&quot;AppointEligibilityCalc&quot;);
					sAccessTech = GetFieldValue(&quot;Access Technology&quot;);
					sTransferType = GetFieldValue(&quot;NBN Transfer Type&quot;);
					sServiceClass = GetFieldValue(&quot;Serviceability Class Calc&quot;);
					with(sConfigBC)
					{
						ClearToQuery();
						ActivateField(&quot;String 17&quot;);
						SetViewMode(AllView);					
						searchst = &quot;[Type] = &apos;&quot; + sType + &quot;&apos; AND [String 26] = &apos;&quot; + ApptCalc + &quot;&apos; AND [String 2] = &apos;&quot; + sTransferType + &quot;&apos; AND [String 1] = &apos;&quot; +sServiceClass+ &quot;&apos; AND [Name] = &apos;&quot; + sAccessTech + &quot;&apos;&quot;;
						SetSearchExpr(searchst);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sAmendDemandType = GetFieldValue(&quot;String 17&quot;);																				
							
						}
					}
				}
			}
			
			if(sAmendDemandType != &quot;&quot; &amp;&amp; sAmendDemandType != null)
			{	
				var sId = this.GetFieldValue(&quot;Id&quot;);			
				with(sApptBC)
				{
					ClearToQuery();
					ActivateField(&quot;DemandType&quot;);
					SetViewMode(AllView);			
					SetSearchSpec(&quot;Id&quot;, sId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						SetFieldValue(&quot;DemandType&quot;, sAmendDemandType);
						WriteRecord();
					}
				}
			}*/
			}
		
	}
	//this.WriteRecord();
	this.ExecuteQuery();
}
catch(e)
	{
		throw(e);
	}
	finally
	{
		/*sSQBC = null;
		sConfigBC = null;
		sApptBC = null;
		sBO = null;*/

		/*Below variables are nullified by JAGJIT on 27/03/2019*/
		wfservice = null;
		wfInputPS = null;
		wfOutputPS = null;

	}	
}"
