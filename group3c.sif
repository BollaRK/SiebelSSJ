			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateLead"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateLead()
{
	try{	
		var sBO = TheApplication().ActiveBusObject();
		var sBC = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);
		var sBC1 = sBO.GetBusComp(&quot;VHA Connect FBB TBC&quot;);
		var sBC2 = sBO.GetBusComp(&quot;Action&quot;);
		var sCustName = sBC1.GetFieldValue(&quot;Customer Name&quot;);
		var sCustCont = sBC1.GetFieldValue(&quot;Customer Contact&quot;);
		var sCustEmail = sBC1.GetFieldValue(&quot;Customer Email&quot;);
		var sessionId = sBC1.GetFieldValue(&quot;Session Id&quot;);
		var sParActivityId = sBC.GetFieldValue(&quot;Id&quot;);
		
		with(sBC2)
		{
			ActivateField(&quot;Parent Activity Id&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Parent Activity Id&quot;, sParActivityId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
					TheApplication().RaiseErrorText(&quot;Multiple Leads cannot be created for same SQ&quot;);
			}
		}
		
		if(sCustName == &apos;&apos; || sCustCont == &apos;&apos; || sCustEmail == &apos;&apos;)
		{
			TheApplication().RaiseErrorText(&quot;Customre Name, Contact &amp; Email are mandatory for Lead Creation&quot;);
		}
	
	//	var sBc = sBO.GetBusComp(&quot;VF Capture Customer Details TBC&quot;);
	//	var sParActivityId = sBC.GetFieldValue(&quot;Id&quot;);
		var sComments = &quot;Lead Created for FBB&quot;;
		var sDesc = &quot;Lead Capture&quot;;
	/*	var sRowId = sBc.GetFieldValue(&quot;Customer Row Id&quot;);
		var sStatus = sBC.GetFieldValue(&quot;Status&quot;);
		var sPlannedServiceabilityDate = sBC.GetFieldValue(&quot;Planned Serviceability Date&quot;);
		var sCSAId = sBC.GetFieldValue(&quot;CSA Id&quot;);
		var sAccessTechnology = sBC.GetFieldValue(&quot;Access Technology&quot;);
		var sServiceabilityClass= sBC.GetFieldValue(&quot;Serviceability Class&quot;);
		var sNBNSiteQualificationStatus= sBC.GetFieldValue(&quot;NBN Site Qualification Status&quot;);*/
		var boAction = TheApplication().GetBusObject(&quot;Action&quot;);		// Siebel Review. Previously Account BO
		var bcAction = boAction.GetBusComp(&quot;Action&quot;);
		bcAction.NewRecord(NewAfter);
		bcAction.SetFieldValue(&quot;Parent Activity Id&quot;, sParActivityId);
		bcAction.SetFieldValue(&quot;Description&quot;, sDesc);
		bcAction.SetFieldValue(&quot;Comment&quot;, sComments);
	/*	bcAction.SetFieldValue(&quot;Row Id&quot;,sRowId);
	    bcAction.SetFieldValue(&quot;Status&quot;,sStatus);
	    bcAction.SetFieldValue(&quot;Planned Serviceability Date&quot;,sPlannedServiceabilityDate);
	    bcAction.SetFieldValue(&quot;CSA Id&quot;,sCSAId);
	    bcAction.SetFieldValue(&quot;Access Technology&quot;,sAccessTechnology);
	    bcAction.SetFieldValue(&quot;Serviceability Class&quot;,sServiceabilityClass);
	    bcAction.SetFieldValue(&quot;NBN Site Qualification Status&quot;,sNBNSiteQualificationStatus);*/
	    var bcPick = bcAction.GetPicklistBusComp(&quot;Status&quot;);
		bcPick.ClearToQuery();
		bcPick.SetSearchSpec(&quot;Name&quot;, &quot;Auto-Created&quot;);
		bcPick.ExecuteQuery(ForwardOnly);
		if (bcPick.FirstRecord())
		{
			bcPick.Pick();
		}
		bcPick = bcAction.GetPicklistBusComp(&quot;Activity Category&quot;);
		bcPick.ClearToQuery();
		bcPick.SetSearchSpec(&quot;Name&quot;, &quot;System Generated&quot;);
		bcPick.ExecuteQuery(ForwardOnly);
			
		if (bcPick.FirstRecord())
		{
			bcPick.Pick();
		}
		
		bcPick = bcAction.GetPicklistBusComp(&quot;Type&quot;);
		bcPick.ClearToQuery();
		bcPick.SetSearchSpec(&quot;Name&quot;, &quot;Lead Capture&quot;);
		bcPick.ExecuteQuery(ForwardOnly);
				
		if (bcPick.FirstRecord())
		{
			bcPick.Pick();
		}	
		
		bcAction.WriteRecord();

	}
	catch(e){
	
	throw(e);
	
	}
	finally{

	/*Below variables are nullified by Sharukh on 02/04/2019*/
	sBC = null;
	sBC1 = null;
	sBC2 = null;
	bcAction = null;
	bcPick = null;
	sBO = null;
	boAction = null;

	
	}

