			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	try
	{
	var error=&quot;&quot;;
	switch (FieldName)
	{
		case &quot;VHA Retrieve NBN Plans&quot;:
		if (FieldValue == &quot;Y&quot;)
		{
		  TheApplication().SetProfileAttr(&quot;sCustomerSegment&quot;,&quot;Business&quot;);
		  TheApplication().SetProfileAttr(&quot;NBNRetrievePlans&quot;,&quot;Y&quot;);	
		}
		break;
		case &quot;Notification Email&quot;:
		if ((FieldValue != &quot;&quot;) &amp;&amp; (FieldValue != null))
		{
			var bsEmail = TheApplication().GetService(&quot;VF TBUI Utilities&quot;);
			var EmailInputs = TheApplication().NewPropertySet();
			var EmailOutputs = TheApplication().NewPropertySet();
			EmailInputs.SetProperty(&quot;ShipEmailId&quot;,FieldValue);
			bsEmail.InvokeMethod(&quot;ValidateEmail&quot;, EmailInputs, EmailOutputs);
			error = EmailOutputs.GetProperty(&quot;ErrorMessage&quot;);
		}
		break;
		case &quot;Customer Contact&quot;:
		if ((FieldValue != &quot;&quot;) &amp;&amp; (FieldValue != null))
		{
			var strNumber=FieldValue;
			if(strNumber.indexOf(&quot;614&quot;)!= 0)
			{
				throw(strNumber + &quot; must be starting with digit 614&quot;) ;
			}
			if ((strNumber.length)!=11)
			{
				throw (strNumber + &quot; must be 11 character long.&quot;);
			}
		}	
		break;
		default:
		break;
	}
	return (ContinueOperation);  
}


 catch(e)
	{
	throw(e);
	}
	finally
	{
			/*Below variables are nullified by Sharukh on 02/04/2019*/

		if(defined(bsEmail)) { bsEmail = null; }
		if(defined(EmailInputs)) { EmailInputs = null; }
		if(defined(EmailOutputs)) { EmailOutputs = null; }

	}
}"
