			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="(declarations)"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//SK - 1142017 - Commented as manual address flag is no longer used
/*function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	try
{	
	if(FieldName == &quot;Manual Address&quot; &amp;&amp; FieldValue == &quot;Y&quot;) 
	{
				var bQASExecuted = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;);
				if (bQASExecuted != &quot;Y&quot;)
					{
						
						TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query QAS at least once before saving an unvalidated address.&quot;);
					}
		
	}
	
}
catch(e)
{
throw(e);
}
finally
{
}
	return (ContinueOperation);
}*/"
			   SEQUENCE="1"
			   UPDATED="08/06/2017 23:44:33"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:44:33"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{

 this.SetFieldValue(&quot;Session Id&quot;, TheApplication().GetProfileAttr(&quot;TBUISessionId&quot;));
 	
}"
			   SEQUENCE="5"
			   UPDATED="07/23/2024 17:09:25"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:44:33"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
	if(MethodName == &quot;ViewRefresh&quot;)
	{
		var sCurrSessionId = this.GetFieldValue(&quot;Session Id&quot;);
		TheApplication().SetProfileAttr(&quot;OneSQManualAddr&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PickRCount&quot;,&quot;&quot;);
		var sBO = TheApplication().ActiveBusObject();
		var sBC = sBO.GetBusComp(&quot;VHA Connect FBB TBC&quot;);
		var sBC1 = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);
		sBC1.InvokeMethod(&quot;RefreshBusComp&quot;);
		return (CancelOperation);
	}
	if(MethodName == &quot;OneSQ&quot;)
	{
		try
		{
			var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
    		var Input = TheApplication().NewPropertySet();
    		var Output = TheApplication().NewPropertySet();
    		var sSessId = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Capture Customer Details TBC&quot;).GetFieldValue(&quot;Session Id&quot;);
    		this.SetFieldValue(&quot;Session Id&quot;, sSessId);
    		var sSessionId = this.GetFieldValue(&quot;Session Id&quot;);
    		var sLocationId = this.GetFieldValue(&quot;NBN Location Id&quot;);
			var Network = &quot;&quot;, NBNBusiNetwork = &quot;&quot;;
			NBNBusiNetwork = this.GetFieldValue(&quot;VHA Retrieve NBN Plans&quot;);
			Network = TheApplication().GetProfileAttr(&quot;OverrideNetwork&quot;);
			if (Network != &quot;&quot; &amp;&amp; Network != null)
				Network = Network.toUpperCase();
			TheApplication().SetProfileAttr(&quot;OverrideNetwork&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;EnhCovChekHide&quot;,&quot;&quot;);
			if((Network == &quot;&quot; || Network == null) &amp;&amp; (TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;NBN Reactivate&quot; || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;NBN Transfer Reversal&quot;))//SBABU added for Imagine
			{
				Network = TheApplication().GetProfileAttr(&quot;ReactiveNetwork&quot;);
				if (Network != &quot;&quot; &amp;&amp; Network != null)
					Network = Network.toUpperCase();
			}
			if (NBNBusiNetwork == &quot;Y&quot; &amp;&amp; Network == &quot;&quot;)
				Network = &quot;NBN&quot;;
			TheApplication().SetProfileAttr(&quot;Network&quot;,Network);
    		var statusNew = &quot;New&quot;;
    		var statusExpired = &quot;Expired&quot;;
    		var SQstatus = &quot;Rejected&quot;;

    		var bo = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
      		var bc = bo.GetBusComp(&quot;VHA Site Qualification BC&quot;);
			var sGeographicSiteAPICalled = &quot;N&quot;;
			TheApplication().SetProfileAttr(&quot;GeographicSiteAPIError&quot;, &quot;N&quot;); //NROY Added to block user to select CVC Id for any error in GeographicSiteAPI
			
     		with(bc)
      		{
         		ClearToQuery();	
         		ActivateField(&quot;Session Id&quot;);
         		ActivateField(&quot;Status&quot;);         		
				var searchst = &quot;[Session Id] = &apos;&quot; + sSessionId + &quot;&apos; AND [Status] = &apos;&quot; + statusNew + &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);	
				var count = CountRecords();	
				TheApplication().SetProfileAttr(&quot;count&quot;,count);
				for(var i =1; i&lt;=count; i++)
				{
					SetFieldValue(&quot;Status&quot;, &quot;Expired&quot;);
					WriteRecord();
				}
				
      		}
			TheApplication().SetProfileAttr(&quot;OneSQ1&quot;,sSessionId + sLocationId);
			// VHA NandhiniG 19/07/21 : Added for NBN Rationalization Project
			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableNBNSiteQualificationRESTAPI&quot;) == &quot;Y&quot;)
			{
			
				if((TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) != &quot;NBN Reactivate&quot;) &amp;&amp; (TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) != &quot;NBN Transfer Reversal&quot;) &amp;&amp; TheApplication().GetProfileAttr(&quot;LOCSearch&quot;)!= &quot;LOCSearch&quot; || TheApplication().GetProfileAttr(&quot;SQNBNLocId&quot;) == &quot;N&quot;)
				{	
					var sss = this.GetFieldValue(&quot;WSDL Floor&quot;);
					TheApplication().SetProfileAttr(&quot;sss&quot;,sss);
					Input.SetProperty(&quot;state&quot;, this.GetFieldValue(&quot;WSDL State&quot;));
					Input.SetProperty(&quot;suburb&quot;, this.GetFieldValue(&quot;WSDL Suburb&quot;));
					Input.SetProperty(&quot;postcode&quot;, this.GetFieldValue(&quot;WSDL Post Code&quot;));
					Input.SetProperty(&quot;streetName&quot;, this.GetFieldValue(&quot;WSDL Street Name&quot;));
					Input.SetProperty(&quot;streetType&quot;, this.GetFieldValue(&quot;WSDL Street Type&quot;));
					Input.SetProperty(&quot;streetNumber&quot;, this.GetFieldValue(&quot;WSDL Street Number&quot;));
					Input.SetProperty(&quot;streetNumber2&quot;, this.GetFieldValue(&quot;Street Road Number2&quot;));
					Input.SetProperty(&quot;streetTypeSuffix&quot;, this.GetFieldValue(&quot;Street Road Type Suffix Code&quot;));
					Input.SetProperty(&quot;unitType&quot;, this.GetFieldValue(&quot;WSDL Floor Type&quot;));
					Input.SetProperty(&quot;unitNumber&quot;, this.GetFieldValue(&quot;WSDL Floor&quot;));
					Input.SetProperty(&quot;complexRoadName&quot;,this.GetFieldValue(&quot;Secondary Road Name&quot;));
					Input.SetProperty(&quot;buildingName&quot;, this.GetFieldValue(&quot;WSDL Address Building&quot;));
					Input.SetProperty(&quot;complexRoadTypeCode&quot;, this.GetFieldValue(&quot;Secondary Road Type Code&quot;));
					Input.SetProperty(&quot;secondaryComplexName&quot;, this.GetFieldValue(&quot;Secondary Site Building Name&quot;));
					Input.SetProperty(&quot;complexRoadNumber1&quot;, this.GetFieldValue(&quot;Secondary Road Number1&quot;));
					Input.SetProperty(&quot;complexRoadNumber2&quot;, &quot;&quot;);
					Input.SetProperty(&quot;complexRoadSuffixCode&quot;, &quot;&quot;);
					Input.SetProperty(&quot;allotmentNumber&quot;, this.GetFieldValue(&quot;Lot Number&quot;));
					Input.SetProperty(&quot;buildingLevelType&quot;, this.GetFieldValue(&quot;Level Type&quot;));
					Input.SetProperty(&quot;buildingLevelNumber&quot;, this.GetFieldValue(&quot;Level Number&quot;));
					Input.SetProperty(&quot;planNumber&quot;, this.GetFieldValue(&quot;Plan Number&quot;));
					if (TheApplication().GetProfileAttr(&quot;SkipGeo&quot;) != &quot;SkipGeo&quot;)
					{
						Input.SetProperty(&quot;GnafPid&quot;, this.GetFieldValue(&quot;WSDL DPID&quot;));
						Input.SetProperty(&quot;latitude&quot;, this.GetFieldValue(&quot;WSDL Latitude&quot;));
						Input.SetProperty(&quot;longitude&quot;, this.GetFieldValue(&quot;WSDL Longitude&quot;));
					}
					Input.SetProperty(&quot;FlowOneSQ&quot;,&quot;Addr&quot;);
				}
				else if((TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;NBN Reactivate&quot; || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;NBN Transfer Reversal&quot;) &amp;&amp; Network == &quot;VISION&quot;)
				{
                  var sBS = TheApplication().GetService(&quot;VHA FBB BS&quot;);
				  var psOut = TheApplication().NewPropertySet();
				  var psInp = TheApplication().NewPropertySet();
				  psInp.SetProperty(&quot;NBNLocId&quot;,this.GetFieldValue(&quot;NBN Location Id&quot;));
                  sBS.InvokeMethod(&quot;QueryServiceNBNAddress&quot;, psInp, psOut);
				  Input.SetProperty(&quot;state&quot;, psOut.GetProperty(&quot;state&quot;));
				  Input.SetProperty(&quot;suburb&quot;, psOut.GetProperty(&quot;suburb&quot;));
				  Input.SetProperty(&quot;postcode&quot;, psOut.GetProperty(&quot;postcode&quot;));
				  Input.SetProperty(&quot;streetName&quot;, psOut.GetProperty(&quot;streetName&quot;));
			      Input.SetProperty(&quot;streetType&quot;, psOut.GetProperty(&quot;streetType&quot;));
			 	  Input.SetProperty(&quot;streetNumber&quot;, psOut.GetProperty(&quot;streetNumber&quot;));
                  Input.SetProperty(&quot;FlowOneSQ&quot;,psOut.GetProperty(&quot;FlowOneSQ&quot;));
				}
				else
				{
					Input.SetProperty(&quot;FlowOneSQ&quot;,&quot;LOC&quot;);
					Input.SetProperty(&quot;Id&quot;, sLocationId);
					if(Network == &quot;&quot; || Network == null) //Daffi:11/12/2025:Added This Line for CM-6272
					Network = &quot;NBN&quot;;//added for imagine R1.1 fix.
					var ManualLocIdSearchSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;ManualLocIdSearch&quot;);					
					if (ManualLocIdSearchSwitch == &quot;ON&quot;)
						TheApplication().SetProfileAttr(&quot;ManualLocIdSearch&quot;,&quot;Y&quot;);
				} 
				Input.SetProperty(&quot;SessionId&quot;,sSessionId);
				Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA OneSQ REST API Process&quot;);
				Input.SetProperty(&quot;TransactionName&quot;, &quot;VHAOneSQRESTAPI&quot;); 
				Input.SetProperty(&quot;MapName&quot;, &quot;VHA OneSQ REST API Response Map&quot;); 
				if (TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;) == &quot;Kogan&quot;)
					Network =  &quot;NBN&quot;;				
				Input.SetProperty(&quot;serviceName&quot;, Network); 
				Input.SetProperty(&quot;FlowName&quot;, &quot;SQ&quot;);
				Input.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHAOneSQRESTAPIIO&quot;);
				//TheApplication().SetProfileAttr(&quot;OneSQ2&quot;,sSessionId + sLocationId);
				TheApplication().SetProfileAttr(&quot;LOCSearch&quot;,&quot;&quot;);
				svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
				
				if(Output.GetProperty(&quot;Error Code&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;Error Message&quot;) != &quot;&quot;)
					TheApplication().RaiseErrorText(Output.GetProperty(&quot;Error Message&quot;));

				if(Network == &quot;&quot; || Network == null)
					Network = Output.GetProperty(&quot;PriorityNetwork&quot;);

				TheApplication().SetProfileAttr(&quot;COTPSMASingleCall&quot;, &quot;&quot;);
			}
			else
			{
	    		Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA Generic VBC&quot;);    		
	    		Input.SetProperty(&quot;BusObject&quot;, &quot;VHA VBC Generic&quot;);    	
	    		Input.SetProperty(&quot;BusComp&quot;, &quot;VF Transaction Settings&quot;);
	    		Input.SetProperty(&quot;TransactionName&quot;, &quot;VHA NBN Single Site Qualification&quot;);
	    		Input.SetProperty(&quot;TransactionType&quot;, &quot;INBOUND&quot;);    		
	    		Input.SetProperty(&quot;In IO Name&quot;, &quot;VHA Site Qualification IO&quot;);    		
	    		Input.SetProperty(&quot;ManualSearch&quot;, &quot;Y&quot;);
	    		Input.SetProperty(&quot;SessionId&quot;, this.GetFieldValue(&quot;Session Id&quot;));
	    		Input.SetProperty(&quot;PropSet1&quot;, sLocationId);    		
	    		svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
			}
    		this.SetFieldValue(&quot;Site Qualification&quot;, &quot;Y&quot;);
    		var sBO = TheApplication().ActiveBusObject();
    		var sBC = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);
    		var sBC2 = sBO.GetBusComp(&quot;VHA Site Qualification Service List&quot;);
    		var sBC3 = sBO.GetBusComp(&quot;VHA Site Qualification Attributes&quot;);
			var bc = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);
     		with(bc)
      		{
         		ClearToQuery();	
         		ActivateField(&quot;Session Id&quot;);
				ActivateField(&quot;Status&quot;);
         		ActivateField(&quot;OneSQConfirmedNetwork&quot;);         		
				var searchst = &quot;[Session Id] = &apos;&quot; + sSessionId + &quot;&apos; AND [Status] = &apos;&quot; + statusNew + &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);	
				var count = CountRecords();	
				for(var i =1; i&lt;=count; i++)
				{
					SetFieldValue(&quot;OneSQConfirmedNetwork&quot;, Network);
					//Sakthi: Modified if codition for CR1075
					if (TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;Change Technology&quot; || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;&quot; || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;Additional Connect&quot; || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;Change NBN Address&quot;  || TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;Change Location FWA&quot;)
					{
						if(Network == &quot;OPTICOMM&quot;)
							SetFieldValue(&quot;Override Network&quot;,TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NETWORK_PROVIDER&quot;,&quot;OPTICOMM&quot;));
						else if(Network == &quot;VISION&quot;)
							SetFieldValue(&quot;Override Network&quot;,TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NETWORK_PROVIDER&quot;,&quot;VISION&quot;));
						else
							SetFieldValue(&quot;Override Network&quot;,Network);
					}
					WriteRecord();
				}
				
      		}
			if (TheApplication().GetProfileAttr(&quot;NBNAddrSessLocPick&quot;) != &quot;&quot;)
			{
				sBC.ActivateField(&quot;Premise Address Id&quot;);
				//sBC.SetFieldValue(&quot;NBN Location Id&quot;,TheApplication().GetProfileAttr(&quot;NBNAddrSessLocPick&quot;));
				sBC.SetFieldValue(&quot;Premise Address Id&quot;,TheApplication().GetProfileAttr(&quot;NBNaddressIdPick&quot;));
				TheApplication().SetProfileAttr(&quot;NBNAddrSessLocPick&quot;,&quot;&quot;);
				TheApplication().SetProfileAttr(&quot;NBNaddressIdPick&quot;,&quot;&quot;);
			}
    		sBC.WriteRecord();

    		sBC.InvokeMethod(&quot;RefreshBusComp&quot;);
			var sSQId = sBC.GetFieldValue(&quot;Id&quot;);
			var sCSAId = sBC.GetFieldValue(&quot;CSA Id&quot;);
			var sOSAId = sBC.GetFieldValue(&quot;OSA Id&quot;);
			var sAccessTech = sBC.GetFieldValue(&quot;Access Technology&quot;);
			var sNBNLocId = sBC.GetFieldValue(&quot;NBN Location Id&quot;);
			var sNBNAddress = sBC.GetFieldValue(&quot;NBN Address&quot;);
			var sWSDLAddress = this.GetFieldValue(&quot;WSDL Address&quot;);
			var sbo = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
      		var sbc = sbo.GetBusComp(&quot;VHA Site Qualification Thin BC&quot;);
      		TheApplication().SetProfileAttr(&quot;SQId&quot;,sSQId);
      		TheApplication().SetProfileAttr(&quot;CSAId&quot;,sCSAId);
			TheApplication().SetProfileAttr(&quot;OSAId&quot;,sOSAId);
			TheApplication().SetProfileAttr(&quot;TestLocId&quot;,sNBNLocId);

			this.SetFieldValue(&quot;NBN Location Id&quot;,sNBNLocId);
			this.SetFieldValue(&quot;NBN Address&quot;,sNBNAddress);
			TheApplication().SetProfileAttr(&quot;sNBNAddressFBB&quot;,sNBNAddress);//Can be removed-Imagine
			TheApplication().SetProfileAttr(&quot;sWSDLAddressFBB&quot;,sWSDLAddress);//Can be removed-Imagine
			this.WriteRecord();

			// VHA NandhiniG 07/12/21 : Added for NBNR Project
			var sWFProcMgrBS = &quot;&quot;,psOutputs = &quot;&quot;, psInputs = &quot;&quot;, sNBNSpeed = &quot;&quot;, sErrorMessage = &quot;&quot;, sRestAPIErrMsg = &quot;&quot;;
			//NROY 18-Mar-22 Added for NBNR2 BRE Call
			var vBRECall = &quot;N&quot;; 

			//Sathish 31-May-24 Added for NBNR2 IINET CVC Fetch from matrix PKE117514
			var sIINETCVC = &quot;N&quot;;

			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableGeographicSiteAPI&quot;) == &quot;Y&quot;)
			{
				if(TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;) == &quot;Vodafone AU&quot; || (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_SWITCH&quot;,&quot;SWITCH&quot;) == &quot;ON&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;) == &quot;Kogan&quot;)) //NROY: 10/04/2023 Added for NBNR Phase2 Kogan project 
				{
					if(TheApplication().GetProfileAttr(&quot;VHAConnectFBB&quot;) == &quot;Y&quot;) {vBRECall = &quot;Y&quot;;}
					var sManageServicesSubType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
					if(sManageServicesSubType == &quot;Change NBN Address&quot; || sManageServicesSubType == &quot;Modify&quot; || sManageServicesSubType == &quot;NBN Reactivate&quot; || sManageServicesSubType == &quot;NBN Transfer Reversal&quot; || sManageServicesSubType == &quot;Change Location FWA&quot;)
					{
						if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;VHA&quot;){vBRECall = &quot;Y&quot;;}
						else if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;TPG&quot;){vBRECall = &quot;Y&quot;;}
						else if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;IINET&quot;){
						if(Network.toUpperCase() == &quot;NBN&quot;){
						sIINETCVC = &quot;Y&quot;;
						}else if(Network.toUpperCase() == &quot;OPTICOMM&quot; || Network.toUpperCase() == &quot;VISION&quot;){
                        vBRECall = &quot;Y&quot;;
						}
						if(Network.toUpperCase() == &quot;NBN&quot; &amp;&amp; (TheApplication().GetProfileAttr(&quot;OldPriorityNetwork&quot;) == &quot;OPTICOMM&quot; || TheApplication().GetProfileAttr(&quot;OldPriorityNetwork&quot;) == &quot;VISION&quot;)){
                        vBRECall = &quot;Y&quot;;
						}
						}
						else{vBRECall = &quot;N&quot;;}
					}
				}else{vBRECall = &quot;N&quot;;}
			}else{vBRECall = &quot;N&quot;;}

			TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;N&quot;);

			if(vBRECall == &quot;Y&quot; &amp;&amp; (Network.toUpperCase() == &quot;VISION&quot;))//Vasavi added for Imagine vision case
				TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;);

			if(vBRECall == &quot;Y&quot; &amp;&amp; ((Network.toUpperCase() == &quot;NBN&quot; &amp;&amp; sCSAId != &quot;&quot; &amp;&amp; sCSAId != null) || (Network.toUpperCase() == &quot;OPTICOMM&quot; &amp;&amp; sOSAId != &quot;&quot; &amp;&amp; sOSAId != null)))
			{
				sGeographicSiteAPICalled = &quot;Y&quot;;
				TheApplication().SetProfileAttr(&quot;GeoAPICalled&quot;, &quot;Y&quot;); //Sakthi:Added for decoupling CVC Call
				TheApplication().SetProfileAttr(&quot;GeoSQId&quot;, sSQId);//Sakthi:Added for decoupling CVC Call
				TheApplication().SetProfileAttr(&quot;GeoNetwork&quot;, Network);//Sakthi:Added for decoupling CVC Call
				if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableOldGeoSiteAPI&quot;) == &quot;Y&quot;)//Sakthi:Added for decoupling CVC Call
				{
					sWFProcMgrBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					psOutputs = TheApplication().NewPropertySet();
					psInputs = TheApplication().NewPropertySet();
			
					if(Network.toUpperCase() == &quot;OPTICOMM&quot;){
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Opticomm OVC WF&quot;);
						psInputs.SetProperty(&quot;OSAId&quot;, sOSAId); 
					}else
					{
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Geographic Site API Process&quot;);
						psInputs.SetProperty(&quot;Transaction Name&quot;, &quot;VHAGeographicSiteAPI&quot;); 
						psInputs.SetProperty(&quot;MapName&quot;, &quot;VHA Geographic Site Map&quot;); 
						psInputs.SetProperty(&quot;CVCId&quot;, sCSAId); 
						psInputs.SetProperty(&quot;serviceName&quot;, &quot;NBN&quot;); 
						sBC.ActivateField(&quot;VHAHighSpeedAttribute&quot;);
						sNBNSpeed = sBC.GetFieldValue(&quot;VHAHighSpeedAttribute&quot;);
						sNBNSpeed = sNBNSpeed.replace(/[^0-9]/g, &apos;&apos;);
						psInputs.SetProperty(&quot;bandwidth&quot;,sNBNSpeed);
					}
					psInputs.SetProperty(&quot;SQId&quot;, sSQId); 
					psInputs.SetProperty(&quot;FlowName&quot;, &quot;SQ&quot;);
				
					sWFProcMgrBS.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
					sErrorMessage = psOutputs.GetProperty(&quot;Error Message&quot;);
					sRestAPIErrMsg = psOutputs.GetProperty(&quot;RestAPIErrMsg&quot;);
				}

				TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;); //NR 22/03/22 added to check in VHA Change Location FBB SQ Subtask, VHA Reactivate/Transfer Reversal Subtask, VHA SQ Sub Task

				if(sErrorMessage !=&quot;&quot;)
				{	
					TheApplication().RaiseErrorText(sErrorMessage);
				}
				else if(sRestAPIErrMsg !=&quot;&quot;)
				{
					TheApplication().RaiseErrorText(sRestAPIErrMsg);
				}
				
			}
			else if(sIINETCVC == &quot;Y&quot; &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableIINETCVCUpdate&quot;) == &quot;Y&quot;)
			{
				fnGetCVCIdFromIINETConfig(sCSAId,sSQId);
				//TheApplication().SetProfileAttr(&quot;SkipValidateSQ&quot;, &quot;Y&quot;);
				TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;);//sangari:09/05/2025:Added for Reactivate Hotfix
			
			}
			else{
				if (sCSAId != &quot;&quot; &amp;&amp; sCSAId != null)
				{
					with(sbc)
					{
						ActivateField(&quot;Id&quot;);
						ActivateField(&quot;CSA Id&quot;);
						ActivateField(&quot;Selected CVC&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Id&quot;,sSQId);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							var calcUtiStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_CVC_UTILIZATION_CONFIG&quot;, &quot;Status|Full&quot;);
							var pickBC = GetPicklistBusComp(&quot;Selected CVC&quot;);					
							with(pickBC)
							{
								ClearToQuery();	
								var searchst = &quot;[CSA Identifier] = &apos;&quot; + sCSAId + &quot;&apos; AND [Calc Utilization Status] &lt;&gt; &apos;&quot; + calcUtiStatus + &quot;&apos;&quot;;
								SetSearchExpr(searchst);	
								ExecuteQuery(ForwardOnly);		
								if(FirstRecord())
								{
									Pick();
								}
							}	
							
						}			
					sbc.WriteRecord();
					}
				}
			}
    		sBC.InvokeMethod(&quot;RefreshBusComp&quot;);
    		sBC2.InvokeMethod(&quot;RefreshBusComp&quot;);
    		sBC3.InvokeMethod(&quot;RefreshBusComp&quot;); 		 
    	}//try
		catch(e)
		{
			if(sGeographicSiteAPICalled == &quot;Y&quot;)
			{
				TheApplication().SetProfileAttr(&quot;GeographicSiteAPIError&quot;, &quot;Y&quot;);
			}
			throw(e);
		}
		finally
		{
			Input = null;
			Output = null;
			svc = null;
			bc = null;
			bo = null;
			sBC3 = null;
			sBC2 = null;
			sBC = null;
			sBO = null;
			sbc = null;
			pickBC = null;
			sbo = null;
		} 	   		
		
		return(CancelOperation);
	}
	if(MethodName == &quot;SiteQualification&quot;)
	{
		try
		{
			var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
    		var Input = TheApplication().NewPropertySet();
    		var Output = TheApplication().NewPropertySet();
    		var sSessId = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Capture Customer Details TBC&quot;).GetFieldValue(&quot;Session Id&quot;);
    		this.SetFieldValue(&quot;Session Id&quot;, sSessId);
    		var sSessionId = this.GetFieldValue(&quot;Session Id&quot;);
    		var sLocationId = this.GetFieldValue(&quot;NBN Location Id&quot;);
    		var statusNew = &quot;New&quot;;
    		var statusExpired = &quot;Expired&quot;;
    		var SQstatus = &quot;Rejected&quot;;
    		
    		var bo = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
      		var bc = bo.GetBusComp(&quot;VHA Site Qualification BC&quot;);
			var sGeographicSiteAPICalled = &quot;N&quot;;
			TheApplication().SetProfileAttr(&quot;GeographicSiteAPIError&quot;, &quot;N&quot;); //NROY Added to block user to select CVC Id for any error in GeographicSiteAPI
			
     		with(bc)
      		{
         		ClearToQuery();	
         		ActivateField(&quot;Session Id&quot;);
         		ActivateField(&quot;Status&quot;);         		
				var searchst = &quot;[Session Id] = &apos;&quot; + sSessionId + &quot;&apos; AND [Status] = &apos;&quot; + statusNew + &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);	
				var count = CountRecords();	
				for(var i =1; i&lt;=count; i++)
				{
					SetFieldValue(&quot;Status&quot;, &quot;Expired&quot;);
					WriteRecord();
				}
				
      		}
			
			// VHA NandhiniG 19/07/21 : Added for NBN Rationalization Project
			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableNBNSiteQualificationRESTAPI&quot;) == &quot;Y&quot;)
			{
				Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA SQ REST API Process&quot;);
				Input.SetProperty(&quot;TransactionName&quot;, &quot;VHASiteQualificationRESTAPI&quot;); 
				Input.SetProperty(&quot;MapName&quot;, &quot;VHA SQ REST API Response Map&quot;); 
				Input.SetProperty(&quot;SessionId&quot;,sSessionId);
				Input.SetProperty(&quot;Id&quot;, sLocationId); 
				Input.SetProperty(&quot;serviceName&quot;, &quot;NBN&quot;); 
				Input.SetProperty(&quot;FlowName&quot;, &quot;SQ&quot;);
				Input.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Site Qualification RESTAPI IO&quot;);
				svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
				if(Output.GetProperty(&quot;Error Code&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;Error Message&quot;) != &quot;&quot;)
					TheApplication().RaiseErrorText(Output.GetProperty(&quot;Error Message&quot;));
			}
			else
			{
	    		Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA Generic VBC&quot;);    		
	    		Input.SetProperty(&quot;BusObject&quot;, &quot;VHA VBC Generic&quot;);    	
	    		Input.SetProperty(&quot;BusComp&quot;, &quot;VF Transaction Settings&quot;);
	    		Input.SetProperty(&quot;TransactionName&quot;, &quot;VHA NBN Single Site Qualification&quot;);
	    		Input.SetProperty(&quot;TransactionType&quot;, &quot;INBOUND&quot;);    		
	    		Input.SetProperty(&quot;In IO Name&quot;, &quot;VHA Site Qualification IO&quot;);    		
	    		Input.SetProperty(&quot;ManualSearch&quot;, &quot;Y&quot;);
	    		Input.SetProperty(&quot;SessionId&quot;, this.GetFieldValue(&quot;Session Id&quot;));
	    		Input.SetProperty(&quot;PropSet1&quot;, sLocationId);    		
	    		svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
			}
    		this.SetFieldValue(&quot;Site Qualification&quot;, &quot;Y&quot;);
    		var sBO = TheApplication().ActiveBusObject();
    		var sBC = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);
    		var sBC2 = sBO.GetBusComp(&quot;VHA Site Qualification Service List&quot;);
    		var sBC3 = sBO.GetBusComp(&quot;VHA Site Qualification Attributes&quot;);
    		sBC.WriteRecord();
    		sBC.InvokeMethod(&quot;RefreshBusComp&quot;);
    		
			var sSQId = sBC.GetFieldValue(&quot;Id&quot;);
			var sCSAId = sBC.GetFieldValue(&quot;CSA Id&quot;);
			var sAccessTech = sBC.GetFieldValue(&quot;Access Technology&quot;);
			var sbo = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
      		var sbc = sbo.GetBusComp(&quot;VHA Site Qualification Thin BC&quot;);
      		TheApplication().SetProfileAttr(&quot;SQId&quot;,sSQId);
      		TheApplication().SetProfileAttr(&quot;CSAId&quot;,sCSAId);

			// VHA NandhiniG 07/12/21 : Added for NBNR Project
			var sWFProcMgrBS = &quot;&quot;,psOutputs = &quot;&quot;, psInputs = &quot;&quot;, sNBNSpeed = &quot;&quot;, sErrorMessage = &quot;&quot;, sRestAPIErrMsg = &quot;&quot;;
			//NROY 18-Mar-22 Added for NBNR2 BRE Call
			var vBRECall = &quot;N&quot;; 

			//Sathish 31-May-24 Added for NBNR2 IINET CVC Fetch from matrix PKE117514
			var sIINETCVC = &quot;N&quot;;

			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableGeographicSiteAPI&quot;) == &quot;Y&quot;)
			{
				if(TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;) == &quot;Vodafone AU&quot; || (TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_SWITCH&quot;,&quot;SWITCH&quot;) == &quot;ON&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;) == &quot;Kogan&quot;)) //NROY: 10/04/2023 Added for NBNR Phase2 Kogan project 
				{
					if(TheApplication().GetProfileAttr(&quot;VHAConnectFBB&quot;) == &quot;Y&quot;) {vBRECall = &quot;Y&quot;;}
					var sManageServicesSubType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
					if(sManageServicesSubType == &quot;Change NBN Address&quot; || sManageServicesSubType == &quot;Modify&quot; || sManageServicesSubType == &quot;NBN Reactivate&quot; || sManageServicesSubType == &quot;NBN Transfer Reversal&quot;)
					{
						if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;VHA&quot;) {vBRECall = &quot;N&quot;;}
						else if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;TPG&quot;) {vBRECall = &quot;Y&quot;;}
						else if(TheApplication().GetProfileAttr(&quot;ServiceProviderReference&quot;) == &quot;IINET&quot;) {sIINETCVC = &quot;Y&quot;;}
						else{vBRECall = &quot;N&quot;;}
					}
				}else{vBRECall = &quot;N&quot;;}
			}else{vBRECall = &quot;N&quot;;}

			TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;N&quot;);
			if(vBRECall == &quot;Y&quot;)
			{
				sGeographicSiteAPICalled = &quot;Y&quot;;
				sWFProcMgrBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				psOutputs = TheApplication().NewPropertySet();
				psInputs = TheApplication().NewPropertySet();
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Geographic Site API Process&quot;);
				psInputs.SetProperty(&quot;Transaction Name&quot;, &quot;VHAGeographicSiteAPI&quot;); 
				psInputs.SetProperty(&quot;MapName&quot;, &quot;VHA Geographic Site Map&quot;); 
				psInputs.SetProperty(&quot;CVCId&quot;, sCSAId); 
				psInputs.SetProperty(&quot;serviceName&quot;, &quot;NBN&quot;); 
				sBC.ActivateField(&quot;VHAHighSpeedAttribute&quot;);
				sNBNSpeed = sBC.GetFieldValue(&quot;VHAHighSpeedAttribute&quot;);
				sNBNSpeed = sNBNSpeed.replace(/[^0-9]/g, &apos;&apos;);
				psInputs.SetProperty(&quot;bandwidth&quot;,sNBNSpeed);
				psInputs.SetProperty(&quot;SQId&quot;, sSQId); 
				psInputs.SetProperty(&quot;FlowName&quot;, &quot;SQ&quot;);
				
				sWFProcMgrBS.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				sErrorMessage = psOutputs.GetProperty(&quot;Error Message&quot;);
				sRestAPIErrMsg = psOutputs.GetProperty(&quot;RestAPIErrMsg&quot;);

				TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;); //NR 22/03/22 added to check in VHA Change Location FBB SQ Subtask, VHA Reactivate/Transfer Reversal Subtask, VHA SQ Sub Task

				if(sErrorMessage !=&quot;&quot;)
				{	
					TheApplication().RaiseErrorText(sErrorMessage);
				}
				else if(sRestAPIErrMsg !=&quot;&quot;)
				{
					TheApplication().RaiseErrorText(sRestAPIErrMsg);
				}
				
			}
			else if(sIINETCVC == &quot;Y&quot; &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableIINETCVCUpdate&quot;) == &quot;Y&quot;)
			{
				fnGetCVCIdFromIINETConfig(sCSAId,sSQId);
				TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;);//sangari:09/05/2025:Added for Reactivate Hotfix
			
			}			
			else{								
					with(sbc)
					{
						ActivateField(&quot;Id&quot;);
						ActivateField(&quot;CSA Id&quot;);
						ActivateField(&quot;Selected CVC&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Id&quot;,sSQId);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							var calcUtiStatus = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_CVC_UTILIZATION_CONFIG&quot;, &quot;Status|Full&quot;);
							var pickBC = GetPicklistBusComp(&quot;Selected CVC&quot;);					
							with(pickBC)
							{
								ClearToQuery();	
								var searchst = &quot;[CSA Identifier] = &apos;&quot; + sCSAId + &quot;&apos; AND [Calc Utilization Status] &lt;&gt; &apos;&quot; + calcUtiStatus + &quot;&apos;&quot;;
								SetSearchExpr(searchst);	
								ExecuteQuery(ForwardOnly);		
								if(FirstRecord())
								{
									Pick();
								}
							}	
							
						}			
					sbc.WriteRecord();
					}				
			}
    		sBC.InvokeMethod(&quot;RefreshBusComp&quot;);
    		sBC2.InvokeMethod(&quot;RefreshBusComp&quot;);
    		sBC3.InvokeMethod(&quot;RefreshBusComp&quot;); 		 
    	}//try
		catch(e)
		{
			if(sGeographicSiteAPICalled == &quot;Y&quot;)
			{
				TheApplication().SetProfileAttr(&quot;GeographicSiteAPIError&quot;, &quot;Y&quot;);
			}
			throw(e);
		}
		finally
		{
			Input = null;
			Output = null;
			svc = null;
			bc = null;
			bo = null;
			sBC3 = null;
			sBC2 = null;
			sBC = null;
			sBO = null;
			sbc = null;
			pickBC = null;
			sbo = null;
		} 	   		
		
		return(CancelOperation);
	}
	//Subramanian - 14.2.17 - Added code to clear address fields
	if(MethodName == &quot;ChangeAddress&quot;)
	{
		try
		{
			TheApplication().SetProfileAttr(&quot;GeoSQId&quot;, &quot;&quot;);//Sakthi:Added for clear profile attribute
			TheApplication().SetProfileAttr(&quot;GeoAPICalled&quot;, &quot;&quot;);//Sakthi:Added for clear profile attribute
			TheApplication().SetProfileAttr(&quot;GeoNetwork&quot;, &quot;&quot;);//Sakthi:Added for clear profile attribute
			TheApplication().SetProfileAttr(&quot;GeographicSiteAPIError&quot;, &quot;N&quot;); //NROY Added to block user to select CVC Id for any error in GeographicSiteAPI
			var bo = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
      		var bc = bo.GetBusComp(&quot;VHA Site Qualification BC&quot;);
    		with(bc)
      		{
         		ClearToQuery();	
         		ActivateField(&quot;Session Id&quot;);
         		ActivateField(&quot;Status&quot;);
         		ActivateField(&quot;NBN Site Qualification Status&quot;);
         		var sSessionId = this.GetFieldValue(&quot;Session Id&quot;);    		
    			var statusNew = &quot;New&quot;;
    			var statusExpired = &quot;Expired&quot;;
    			var SQstatus = &quot;Rejected&quot;;
				var searchst = &quot;[Session Id] = &apos;&quot; + sSessionId + &quot;&apos; AND ([Status] = &apos;&quot; + statusNew + &quot;&apos; OR [Status] = &apos;&quot; + statusExpired + &quot;&apos;) AND [NBN Site Qualification Status] = &apos;&quot; +SQstatus+ &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);	
				var count = CountRecords();	
				for(var i =1; i&lt;=count; i++)
				{
					SetFieldValue(&quot;Status&quot;, &quot;Closed&quot;);
					WriteRecord();
				}
				
				ClearToQuery();	
         		ActivateField(&quot;Session Id&quot;);
         		ActivateField(&quot;Status&quot;);  
         		var sSessionId = this.GetFieldValue(&quot;Session Id&quot;);    		
    			var statusNew = &quot;New&quot;;       		
				var searchst = &quot;[Session Id] = &apos;&quot; + sSessionId + &quot;&apos; AND [Status] = &apos;&quot; + statusNew + &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);	
				var count = CountRecords();	
				for(var i =1; i&lt;=count; i++)
				{
					SetFieldValue(&quot;Status&quot;, &quot;Expired&quot;);
					WriteRecord();
				}			
								
      		}
      		
      		
			//Check NBN Address FLag set to N to clear out NBN Location Id and QAS address
			var sNBNAddr = this.GetFieldValue(&quot;Check NBN Address&quot;);
			if(sNBNAddr == &quot;&quot; || sNBNAddr == null || sNBNAddr == &quot;Y&quot;)
			{
				this.SetFieldValue(&quot;Check NBN Address&quot;,&quot;N&quot;);
				this.SetFieldValue(&quot;Manual Address&quot;,&quot;N&quot;);
				TheApplication().SetProfileAttr(&quot;QAS Query Executed&quot;,&quot;&quot;);	 //SK 5.5.17 - Added for resetting QAS Query Executed. Validation will be fired if QAS is not done when clicking manual address pickapplet	
				WriteRecord();
			}
			
			//Clears all the manual address fields
			ClearAddressFields();
			var psInputs = TheApplication().NewPropertySet();
			var psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;Refresh All&quot;, &quot;Y&quot;);
			TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, psInputs, psOutputs);
			
		}//try
		catch(e)
		{
			throw(e);
		}
		finally
		{
			bc = null;
			bo = null;
			psInputs = null;
			psOutputs = null;
		} 
		return(CancelOperation);
	}
	if(MethodName == &quot;CreateLead&quot;)
	{	
		mCreateLead();
		return(CancelOperation);
	}

	return (ContinueOperation);
	
}"
			   SEQUENCE="6"
