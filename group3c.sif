			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord() 
{
    try 
    {
		
        if (sNewFlag == &quot;Y&quot;)
         {
            var sOrderItemId = this.GetFieldValue(&quot;Order Item Id&quot;);
            var sSRId = this.GetFieldValue(&quot;Service Request Id&quot;);
            var sNBNsLocId,sNBNLocationId;
            if (TheApplication().GetProfileAttr(&quot;ActiveViewName&quot;) == &quot;VHA NBN Trouble Ticket - Appointment View&quot;) 
            {
                sNBNsLocId = mTTCreateAppointmentContact(sSRId);
                this.SetFieldValue(&quot;NBN Location Id&quot;, sNBNsLocId);
                this.SetFieldValue(&quot;NBN Trouble Ticket&quot;, sTTRefId);
            } 
            else 
            {	
            	var OnlineAppt = TheApplication().GetProfileAttr(&quot;OnlineAppt&quot;);
            	if(OnlineAppt != &quot;Y&quot;)
            	{
                sNBNsLocId = mCreateAppointmentContact(sOrderItemId);
				
				//NROY Added temporary code for Fibre Connect. Need to remove when UpsertNBN details is created in Fibre Upgrade Order LIne Items
				var sView = TheApplication().ActiveViewName();				
				var sFibreUpgradeNBNLocationId = TheApplication().GetProfileAttr(&quot;FibreUpgradeNBNLocationId&quot;);
				if ((sNBNsLocId == &quot;&quot; || sNBNsLocId == null) &amp;&amp;  sFibreUpgradeNBNLocationId != &quot;&quot; &amp;&amp; sFibreUpgradeNBNLocationId != null)
				{	
					sNBNsLocId = sFibreUpgradeNBNLocationId;
				}
                this.SetFieldValue(&quot;NBN Location Id&quot;, sNBNsLocId);
                }
               
            }
            sNewFlag = &quot;&quot;;
        }


    } 
    catch (e) 
    {
        throw (e);
    } 
    finally 
    {
        //sTBC = null;
        TheApplication().SetProfileAttr(&quot;OnlineAppt&quot;, &quot;&quot;);
    }
    return (ContinueOperation);
}"
			   SEQUENCE="8"
			   UPDATED="02/16/2026 12:50:02"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:44:42"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateAppointmentContact"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateAppointmentContact(sOrderItemId)
{
	try
	{
		var sIndexofC =&quot;&quot;;
		var sEmail = &quot;&quot;;
		var sName =	&quot;&quot;,sFullName=&quot;&quot;;
		var sContact = &quot;&quot;;
		var sLocId = &quot;&quot;;
		var sContactType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPOINTMENT_CONTACT_TYPE&quot;,&quot;End User&quot;);
		var boNBNOrderDetails= TheApplication().GetBusObject(&quot;VHA NBN Order Details DSQ&quot;);			
	    var bcNBNOrderDetails = boNBNOrderDetails.GetBusComp(&quot;VHA NBN Order Details&quot;);
	    var bcNBNContact = TheApplication().ActiveBusObject().GetBusComp(&quot;VHA NBN Appointment Contact Details&quot;);
		
		bcNBNOrderDetails.ActivateField(&quot;NBN Order Id&quot;);
		bcNBNOrderDetails.ActivateField(&quot;Order Contact #&quot;);
		bcNBNOrderDetails.ActivateField(&quot;Order Contact Email Id&quot;);	
		bcNBNOrderDetails.ActivateField(&quot;Order Contact Name&quot;);
		bcNBNOrderDetails.ActivateField(&quot;NBN Location Id&quot;);
		bcNBNOrderDetails.ActivateField(&quot;Appointment Required Flag&quot;);
		bcNBNOrderDetails.ActivateField(&quot;Appointment Id&quot;);
		bcNBNOrderDetails.SetViewMode(AllView);
		bcNBNOrderDetails.ClearToQuery();
		bcNBNOrderDetails.SetSearchSpec(&quot;Service Order Id&quot;, sOrderItemId);
	    bcNBNOrderDetails.ExecuteQuery(ForwardOnly);    	
		if(bcNBNOrderDetails.FirstRecord())
			{
				sEmail = bcNBNOrderDetails.GetFieldValue(&quot;Order Contact Email Id&quot;);
				sFullName = bcNBNOrderDetails.GetFieldValue(&quot;Order Contact Name&quot;);   				
				sContact = bcNBNOrderDetails.GetFieldValue(&quot;Order Contact #&quot;);
				sLocId = bcNBNOrderDetails.GetFieldValue(&quot;NBN Location Id&quot;);
				var sOrderId = bcNBNOrderDetails.GetFieldValue(&quot;NBN Order Id&quot;);
				if(sEmail != &quot;&quot; &amp;&amp; sContact != &quot;&quot; &amp;&amp; sFullName != &quot;&quot;)
				{
					bcNBNContact.NewRecord(NewAfter);
					bcNBNContact.SetFieldValue(&quot;Email&quot;,sEmail);
					bcNBNContact.SetFieldValue(&quot;Mobile/Phone&quot;,sContact);
					sIndexofC = sFullName.indexOf(&quot;,&quot;);
					if(sIndexofC &gt;= 0)
						{
							sName = sFullName.split(&quot;,&quot;);
							bcNBNContact.SetFieldValue(&quot;First Name&quot;,sName[1]);
							bcNBNContact.SetFieldValue(&quot;Last Name&quot;,sName[0]);
						}
					else 
		   				{
		   					bcNBNContact.SetFieldValue(&quot;First Name&quot;,sFullName);
						}
					bcNBNContact.SetFieldValue(&quot;Contact Type&quot;,sContactType);
					bcNBNContact.WriteRecord();
				}
				bcNBNOrderDetails.SetFieldValue(&quot;Appointment Id&quot;,this.GetFieldValue(&quot;Id&quot;));
				bcNBNOrderDetails.SetFieldValue(&quot;Appointment Required Flag&quot;,&quot;Y&quot;);
				bcNBNOrderDetails.WriteRecord();
				this.ActivateField(&quot;NBN Order Id&quot;);
				this.SetFieldValue(&quot;NBN Order Id&quot;,sOrderId);
				this.WriteRecord();
			} 
			return(sLocId);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcNBNContact = null;
		bcNBNOrderDetails = null;
		boNBNOrderDetails = null;
	}
}"
			   SEQUENCE="2"
			   UPDATED="08/06/2017 23:44:42"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:44:42"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTTCreateAppointmentContact"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTTCreateAppointmentContact(sSRId)
{
	try
	{
		var boNBNTT = TheApplication().GetBusObject(&quot;VHA NBN Trouble Ticket BO&quot;);			
		var bcNBNTT = boNBNTT.GetBusComp(&quot;VHA NBN Service Request&quot;);
		with(bcNBNTT)
		{
			ActivateField(&quot;NBN Location Id&quot;);		
			ActivateField(&quot;Appointment Id&quot;);
			ActivateField(&quot;VF External Ref Number&quot;);
			InvokeMethod(&quot;SetAdminMode&quot;,&quot;TRUE&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sSRId);
	    	ExecuteQuery(ForwardOnly);
		    if(FirstRecord())
		    {
				var sLocId = GetFieldValue (&quot;NBN Location Id&quot;);
				sTTRefId = GetFieldValue(&quot;VF External Ref Number&quot;);
				SetFieldValue(&quot;Appointment Id&quot;,this.GetFieldValue(&quot;Id&quot;));
				WriteRecord();
				return(sLocId);
			}  
		}
	}
	catch(e)
	{
		throw (e);
	}
	finally
	{
		bcNBNTT = null;
		boNBNTT = null;
	}
}"
