			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetCVCIdFromIINETConfig"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetCVCIdFromIINETConfig(sCSAId,sSQId)
{
//Sathish: Created for NBNR2 - 20/06/2023
try
	{
		var oConfigListBo = TheApplication().GetBusObject(&quot;VHA Configuration List&quot;);
		var oConfigListBc = oConfigListBo.GetBusComp(&quot;VHA Configuration List&quot;);
		var oSiteQualBO = TheApplication().GetBusObject(&quot;VHA SQ Thin BO&quot;);
		var oSiteQualBC = oSiteQualBO.GetBusComp(&quot;VHA SQ Thin BC&quot;);
	  	
		
		var sConfigListType =&quot;VHA_IINET_POI_MATRIX_DATA&quot;;
		var sConfigListName = &quot;POIMatrixData&quot;;
		var sCVCId =&quot;&quot;;
		var sSearchExpr=&quot;&quot;;
		
			
				with (oConfigListBc)
				{
					sSearchExpr =  &quot;[Name]=&apos;&quot;+sConfigListName +&quot;&apos;  AND [Type]=&apos;&quot;+sConfigListType+&quot;&apos; AND [String 1]=&apos;&quot;+sCSAId+&quot;&apos; AND [Active Flg]=&apos;Y&apos;&quot;;
					ActivateField(&quot;Value&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(sSearchExpr);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						sCVCId= GetFieldValue(&quot;Value&quot;);
					}
				}
				if (sCVCId != &quot;&quot; &amp;&amp; sCVCId != null)
				{
				
					with (oSiteQualBC)
					{
						ActivateField(&quot;Selected CVC&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Id&quot;,sSQId);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							SetFieldValue(&quot;Selected CVC&quot;,sCVCId);
							WriteRecord();
						}
					}
				}
				
				
				
			
	}
	catch (e)
	{
	throw(e);
	}
	finally
	{
	
	oConfigListBc = null;	
	oConfigListBo = null;
	oSiteQualBC = null;
	oSiteQualBO= null;
	}
}"
