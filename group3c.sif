			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateCoverageCheckbyAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateCoverageCheckbyAddress(strOriginator, strStreetNum, strStreetName, strStreetType, strSurburb, strState, strPostalCode)
{
//PIPE : kailash Modified the code based on existing BS as per review comments	
	try
	{
			 var psInputs = TheApplication().NewPropertySet();
			 var psOutputs = TheApplication().NewPropertySet();
	 		 var bsCover = TheApplication().GetService(&quot;VF Coverage Check BS&quot;);
						 
			psInputs.SetProperty(&quot;Originator&quot;, strOriginator);
			psInputs.SetProperty(&quot;StreetNum&quot;, strStreetNum);
			psInputs.SetProperty(&quot;StreetName&quot;, strStreetName);
			psInputs.SetProperty(&quot;StreetType&quot;, strStreetType);
			psInputs.SetProperty(&quot;Surburb&quot;, strSurburb);
			psInputs.SetProperty(&quot;State&quot;, strState);
			psInputs.SetProperty(&quot;PostalCode&quot;, strPostalCode);					 
		    bsCover.InvokeMethod(&quot;CreateCoverageCheckbyAddress&quot;, psInputs, psOutputs);
		    gCCId1 =  psOutputs.GetProperty(&quot;CoverageChkId&quot;);
	}
	catch (e) {
		throw e;
	} 
	finally 
	{
	psInputs = null;
	psOutputs = null;
	bsCover = null;
	}

}"
