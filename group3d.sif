			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WrapSearchExpr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 04/06/2015	Balaji		UNISIMTBUI      Initial Version
 *
 */
function WrapSearchExpr(IDType)
{
 var p = /(&apos;)/g;
 return &quot;&apos;&quot; + IDType.replace(p, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;;
}"
			   SEQUENCE="22"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mBlacklistIDCheck"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 04/06/2015	Balaji		UNISIMTBUI      Initial Version
 * 20/07/2015   Roseline	Defect# 583	 	Changed the searchSpec for Blacklist check
 */
function mBlacklistIDCheck() {
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mBlacklistIDCheck&quot;);
		}
		var strError;
		// Declare variables
		var BLC_LST_TBUI = &quot;19211&quot;;
		var INV_ID_NUM = &quot;19210&quot;;
		var IDType;
		var IDNumber;
		var SplChar;
		var CustType;
		var StartDate;
		var EndDate;
		var Name;
		var SearchExpr;
		var SearchExpr1;
		var IDCount;
		var j = 0;
		var MessageId = &quot;&quot;;
		var Error = &quot;Y&quot;;
		var strInvalidErrorMsg = &quot;VFErrorCode#: &quot; + INV_ID_NUM + &quot; Invalid Id Number&quot;;
		// Get Interface Paramaters


		CustType = this.GetFieldValue(&quot;Customer Type&quot;);
		/*if (CustType == &quot;&quot;) {
		throw(&quot;Customer Type is Missing&quot;);
		}*/

		IDType = this.GetFieldValue(&quot;ID Type&quot;);
		IDNumber = this.GetFieldValue(&quot;Reference Number&quot;);

		//To check ID Number is Alphanumeric
		var BlacklistBO = TheApplication().GetBusObject(&quot;VF UNISIM BlacklistID BO&quot;);
		var BlacklistBC = BlacklistBO.GetBusComp(&quot;VF UNISIM BlacklistID BC&quot;);
		BlacklistBC.ActivateField(&quot;VF ID Type&quot;);
		BlacklistBC.ActivateField(&quot;VF ID Number&quot;);
		BlacklistBC.SetViewMode(AllView);
		BlacklistBC.ClearToQuery();
		BlacklistBC.SetSearchSpec(&quot;VF ID Type&quot;, &quot;Generic Rules&quot;);
		BlacklistBC.SetSearchSpec(&quot;VF Rule Type&quot;, &quot;Special Characters&quot;);
		BlacklistBC.ExecuteQuery(ForwardOnly);

		if (BlacklistBC.FirstRecord()) {
			SplChar = BlacklistBC.GetFieldValue(&quot;VF ID Number&quot;);
		}

		var l = IDNumber.length;
		var rStrspn = Clib.strspn(IDNumber, &quot;0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdfeghijklmnopqrstuvwxyz&quot; + SplChar);
		var rStrspnA = rStrspn;
		
		//&quot;Only characters 0-9, A-Z are allowed. Change character:&quot; + rStrspnA;
		//if all characters in string does not match the character set, validation failed
		if (rStrspnA != l) {
			throw(strInvalidErrorMsg)
		}
	//Roseline 20/07/2015 - Changed search spec for defect# 583
	SearchExpr1 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + IDNumber + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
	//SearchExpr1 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + IDNumber + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
	
		var RecFlag = &quot;&quot;;
		var strErrorMessage = &quot;VFErrorCode#: &quot; + BLC_LST_TBUI + &quot; Id is Blacklisted&quot;;
		BlacklistBC.ActivateField(&quot;VF Start Date&quot;);
		BlacklistBC.ActivateField(&quot;VF End Date&quot;);
		//BlacklistBC.ActivateField(&quot;VF Issuer&quot;);
		//BlacklistBC.ActivateField(&quot;VF Country&quot;);
		//BlacklistBC.ActivateField(&quot;VF Color&quot;);
		BlacklistBC.ActivateField(&quot;VF Active Flg&quot;);
		BlacklistBC.ActivateField(&quot;VF Current Date&quot;);
	//	BlacklistBC.ActivateField(&quot;Version Status&quot;);
		BlacklistBC.SetViewMode(AllView);
		BlacklistBC.ClearToQuery();
		BlacklistBC.SetSearchExpr(SearchExpr1);
		BlacklistBC.ExecuteQuery(ForwardBackward);

		if (BlacklistBC.FirstRecord()) {
			//Check for valid start and end date
			StartDate = BlacklistBC.GetFieldValue(&quot;VF Start Date&quot;);
			EndDate = BlacklistBC.GetFieldValue(&quot;VF End Date&quot;);

			if (StartDate == &quot;&quot; &amp;&amp; EndDate == &quot;&quot;) {
				throw(strErrorMessage);
			} //if date check

			if (StartDate != &quot;&quot; || EndDate != &quot;&quot;) {
				//Today for comparison
				var CurrentDate = new Date;
				var DD = CurrentDate.getDate();
				var MM = CurrentDate.getMonth() + 1;
				var YYYY = CurrentDate.getFullYear();
				var sHRS = CurrentDate.getHours();
				var sMIN = CurrentDate.getMinutes();
				var sSEC = CurrentDate.getSeconds();
				var today = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY) + &quot; &quot; + sHRS + &quot;:&quot; + sMIN + &quot;:&quot; + sSEC;
				var newdate = new Date(today);
				var startdate = new Date(StartDate);
				var enddate = new Date(EndDate);

				if (startdate != &quot;&quot;) {
					if (startdate &gt;= newdate) {
						Error = &quot;N&quot;;
					}
				}

				if (enddate != &quot;&quot;) {
					if (enddate &lt;= newdate) {
						Error = &quot;N&quot;;
					}
				}

				if (Error != &quot;N&quot;) {
					throw(strErrorMessage);
				}
			} // if date check
		} //first record
		else {
			//Checking Blacklist Table for repeating digits
			var counter = &quot;1&quot;;
			var sCounter1=&quot;1&quot;;
			var IDlength =  IDNumber.length;
			var sCheckLength = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_BLACKLISTID_CHECKLEN&quot;,&quot;CheckLength&quot;);
			
			if (IDlength &gt; sCheckLength)
			{
				for (var i = 0; i &lt; IDlength; i++) 
				{
					/**** To Blacklist/Block consecutive 
						numbers like 123456...etc******/
					if (IDNumber.charCodeAt(i) &lt; IDNumber.charCodeAt(i+1))
					{
						if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i + 1) - 1 )
						{
							counter++;
						}
					}
					/**** To Blacklist/Block  Consecutive 
					numbers in reverse like 7654321/8765432...etc******/
					if (IDNumber.charCodeAt(i) &gt; IDNumber.charCodeAt(i+1))
					{
						if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i + 1) + 1)
						{
							counter++; 
						}
					}
					if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i+1))
					{
						sCounter1++;
					}			
				}
			
				if (IDlength == counter || IDlength == sCounter1)
				{
					throw(strInvalidErrorMsg);
				}
		
			} // End of if (IDlength &gt; sCheckLength)
			
		/*	BlacklistBC.SetViewMode(AllView);
			BlacklistBC.ClearToQuery();
			var Search = &quot;[VF ID Type] = &apos;Generic Rules&apos; AND [VF ID Number] = &apos;&quot; + IDNumber + &quot;&apos; AND [VF Rule Type] = &apos;Repeating Numbers&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
			BlacklistBC.SetSearchExpr(Search);
			BlacklistBC.ExecuteQuery(ForwardOnly);
			var isRec = BlacklistBC.FirstRecord();
			if (isRec) {
				//check for valid start and end date
				StartDate = BlacklistBC.GetFieldValue(&quot;VF Start Date&quot;);
				EndDate = BlacklistBC.GetFieldValue(&quot;VF End Date&quot;);

				if (StartDate == &quot;&quot; &amp;&amp; EndDate == &quot;&quot;) {
					throw(strInvalidErrorMsg);
				} //if date check

				if (StartDate != &quot;&quot; || EndDate != &quot;&quot;) {
					//Today for comparison
					var CurrentDate = new Date;
					var DD = CurrentDate.getDate();
					var MM = CurrentDate.getMonth() + 1;
					var YYYY = CurrentDate.getFullYear();
					var sHRS = CurrentDate.getHours();
					var sMIN = CurrentDate.getMinutes();
					var sSEC = CurrentDate.getSeconds();
					var today = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY) + &quot; &quot; + sHRS + &quot;:&quot; + sMIN + &quot;:&quot; + sSEC;
					var newdate = new Date(today);
					startdate = new Date(StartDate);
					enddate = new Date(EndDate);
					if (startdate != &quot;&quot;) {
						if (startdate &gt;= newdate) {
							Error = &quot;N&quot;;
						}
					}

					if (enddate != &quot;&quot;) {
						if (enddate &lt;= newdate) {
							Error = &quot;N&quot;;
						}
					}
					
					if (Error != &quot;N&quot;) {
						throw(strInvalidErrorMsg);
					}
				} //if date check
			} // if  isrec*/

			//Checking for Blacklist Table for ID Number Series
			var IDNumlen = IDNumber.length;
			var IDArray = new Array();
			var ArrayIDLen;
			var k = 0;
			var isRecord;
			BlacklistBC.SetViewMode(AllView);
			BlacklistBC.ActivateField(&quot;VF Black Series Flag&quot;);
			BlacklistBC.ActivateField(&quot;VF ID Type&quot;);
			BlacklistBC.ActivateField(&quot;VF Customer Type&quot;);
			BlacklistBC.ActivateField(&quot;VF Active Flg&quot;);
		//	BlacklistBC.ActivateField(&quot;Version Status&quot;);
			BlacklistBC.ClearToQuery();
			//Roseline 20/07/2015 - Changed search spec for defect# 583
			var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF Black Series Flag] = &apos;Y&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
			//var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF Black Series Flag] = &apos;Y&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
			BlacklistBC.SetSearchExpr(searchexpr2);
			BlacklistBC.ExecuteQuery(ForwardOnly);

			isRecord = BlacklistBC.FirstRecord();

			//var len = BlacklistBC.CountRecords();
			while (isRecord) {
				IDArray[k] = BlacklistBC.GetFieldValue(&quot;VF ID Number&quot;);
				k++;
				isRecord = BlacklistBC.NextRecord();
			}
			
			// Below logic reduces the IDNumber length and do query in Blacklist Table
			for (var j = 0; j &lt; IDArray.length; j++) {
				
				ArrayIDLen = IDArray[j].length;
				var TrimArrIDLen = ArrayIDLen - 1;
				var ArrayIDNumVal = IDArray[j].substring(0, ArrayIDLen - 1);
				var TrimIDNum;
				if (IDNumlen == TrimArrIDLen) {
					
					TrimIDNum = IDNumber;
				}
				if (IDNumlen &gt; TrimArrIDLen) {
					
					TrimIDNum = IDNumber.substring(0, ArrayIDLen - 1);
				}
				if (TrimIDNum == ArrayIDNumVal) {
					
					BlacklistBC.SetViewMode(AllView);
					BlacklistBC.ClearToQuery();
					//Roseline 20/07/2015 - Changed search spec for defect# 583
					var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + TrimIDNum + &quot;*&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
				//	var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + TrimIDNum + &quot;*&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
					BlacklistBC.SetSearchExpr(searchexpr2);
					BlacklistBC.ExecuteQuery(ForwardOnly);
					
					var numcnt = BlacklistBC.CountRecords();
					if (numcnt &gt; 0) {
						//check for valid start and end date
						StartDate = BlacklistBC.GetFieldValue(&quot;VF Start Date&quot;);
						EndDate = BlacklistBC.GetFieldValue(&quot;VF End Date&quot;);
						
						if (StartDate == &quot;&quot; &amp;&amp; EndDate == &quot;&quot;) {
							throw(strErrorMessage);
						} //if date check
						if (StartDate != &quot;&quot; || EndDate != &quot;&quot;) {
							//Today for comparison
							var CurrentDate = new Date;
							var DD = CurrentDate.getDate();
							var MM = CurrentDate.getMonth() + 1;
							var YYYY = CurrentDate.getFullYear();
							var sHRS = CurrentDate.getHours();
							var sMIN = CurrentDate.getMinutes();
							var sSEC = CurrentDate.getSeconds();
							var today = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY) + &quot; &quot; + sHRS + &quot;:&quot; + sMIN + &quot;:&quot; + sSEC;
							var newdate = new Date(today);
							startdate = new Date(StartDate);
							enddate = new Date(EndDate);
							if (startdate != &quot;&quot;) {
								if (startdate &gt;= newdate) {
									Error = &quot;N&quot;;
								}
							}
							if (enddate != &quot;&quot;) {
								if (enddate &lt;= newdate) {
									Error = &quot;N&quot;;
								}
							}
							
							if (Error != &quot;N&quot;) {
								throw(strErrorMessage);
							}
						} //if date check
					} //if numcnt
				} //if Trimval comparison
			} //for
		} //else
	} catch (e) {	
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects
		BlacklistBO = null;
		BlacklistBC = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mBlacklistIDCheck&quot;);
		}
	}
} // Main fn"
			   SEQUENCE="2"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCallPostpayIdValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCallPostpayIdValidation() 
{
	try 
	{
		var strError;
		// Declare variables
		var DVSwf;
		var sDVSSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Enable Postpay DVS Validation&quot;);
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		sSSJIdType = sIdType;
		var sInternPassport = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_VEVO_CONTACT_ID&quot;, &quot;International Passport&quot;);
		var sOverrideResp = this.GetFieldValue(&quot;Skip DVS Resp&quot;);
		var sDVSTransId = this.GetFieldValue(&quot;DVS Trans Id&quot;);
		var sCancallDVS = &quot;N&quot;;
		var sContChanged = this.GetFieldValue(&quot;ContactChanged&quot;); 
		var pDVSIns = TheApplication().NewPropertySet();
		var pDVSOut = TheApplication().NewPropertySet();
		var sFirstName = &quot;&quot;,sMiddleName = &quot;&quot;,sLastName = &quot;&quot;,sFullName = &quot;&quot;;
		var sNoDVSCall = &quot;N&quot;, countryCode = &quot;&quot;,sCountry = &quot;&quot;,LOVBO = &quot;&quot;,LOVBC = &quot;&quot;,sContactIdBC=&quot;&quot;,sCountryCodeFlag = &quot;&quot;,sFailContactId = &quot;&quot;,sContactId1 = &quot;&quot;,sContactId = &quot;&quot;;
		//sContactId1 = this.GetFieldValue(&quot;Contact Id&quot;);
		if(TheApplication().ActiveViewName() == &quot;VF Select Service View - TBUI&quot;)
		{
			sFailContactId = TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Postpay Upgrade Contact Id Failure TBUI&quot;);
			TheApplication().ActiveBusObject().GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;).ActivateField(&quot;Account Primary Contact Id&quot;);
			sContactId = TheApplication().ActiveBusObject().GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;).GetFieldValue(&quot;Account Primary Contact Id&quot;);
		}
		if(TheApplication().ActiveViewName() == &quot;VF Customer ID Details – Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF SSJ Customer ID Details – Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Customer ID Details – PretoPost TBUI&quot;)//MJ:Added SSJ View for DFA
		{
			sFailContactId = TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Postpay Contact Id Failure TBUI&quot;);
			TheApplication().ActiveBusObject().GetBusComp(&quot;Contact&quot;).ActivateField(&quot;Id&quot;);
			sContactId = TheApplication().ActiveBusObject().GetBusComp(&quot;Contact&quot;).GetFieldValue(&quot;Id&quot;);
		}
		//Set the default properties
		pDVSIns.SetProperty(&quot;OrgName&quot;, &quot;Postpay_Rule_Id&quot;);
		var sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
		//Customer details
		var sConBO = TheApplication().GetBusObject(&quot;VF Generic TBUI BO&quot;);
		var sConBC = sConBO.GetBusComp(&quot;VF Contact Thin&quot;);
		if(sContactId != &quot;&quot; &amp;&amp; sContactId != null &amp;&amp; sContactId != &quot;No Match Row Id&quot;)
		{
			with (sConBC)
			{
				ActivateField(&quot;Email Address&quot;);
				ActivateField(&quot;M/M&quot;);
				ActivateField(&quot;Middle Name&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;,sContactId); 
				ExecuteQuery(ForwardOnly);		
				if (FirstRecord())
				{
					pDVSIns.SetProperty(&quot;Cust_Title&quot;, GetFieldValue(&quot;M/M&quot;));
					pDVSIns.SetProperty(&quot;Cust_FirstName&quot;, GetFieldValue(&quot;First Name&quot;));
					pDVSIns.SetProperty(&quot;Cust_LastName&quot;, GetFieldValue(&quot;Last Name&quot;));
					pDVSIns.SetProperty(&quot;Cust_MiddleName&quot;, GetFieldValue(&quot;Middle Name&quot;));
					pDVSIns.SetProperty(&quot;Cust_DOB&quot;, GetFieldValue(&quot;Date of Birth&quot;));
					pDVSIns.SetProperty(&quot;Cust_EmailAddress&quot;, GetFieldValue(&quot;Email Address&quot;));
				}
			}
		}

		//Address details
		pDVSIns.SetProperty(&quot;Addr_StreetType&quot;, this.GetFieldValue(&quot;Addr StreetType&quot;));
		pDVSIns.SetProperty(&quot;Addr_City&quot;, this.GetFieldValue(&quot;Addr City&quot;));
		pDVSIns.SetProperty(&quot;Addr_State&quot;, this.GetFieldValue(&quot;Addr State&quot;));
		pDVSIns.SetProperty(&quot;Addr_Country&quot;, this.GetFieldValue(&quot;Addr Country&quot;));
		pDVSIns.SetProperty(&quot;Addr_PostalCode&quot;, this.GetFieldValue(&quot;Addr PostalCode&quot;));
		pDVSIns.SetProperty(&quot;Addr_Address1&quot;, this.GetFieldValue(&quot;Addr Address1&quot;));
		pDVSIns.SetProperty(&quot;Addr_Address2&quot;, this.GetFieldValue(&quot;Addr Address2&quot;));
		
		pDVSIns.SetProperty(&quot;MaxLimitOverride&quot;,this.GetFieldValue(&quot;Max Limit Override Resp&quot;));
		pDVSIns.SetProperty(&quot;ActiveView&quot;,TheApplication().ActiveViewName());
		pDVSIns.SetProperty(&quot;Action&quot;,&quot;CaptureIdTBC&quot;);
		pDVSIns.SetProperty(&quot;ActiveBO&quot;,TheApplication().ActiveBusObject().Name());
		pDVSIns.SetProperty(&quot;OverallLock&quot;,this.GetFieldValue(&quot;VF Overall Lock&quot;));
		pDVSIns.SetProperty(&quot;MClock&quot;,this.GetFieldValue(&quot;VF MC Lock&quot;));
		pDVSIns.SetProperty(&quot;PassportLock&quot;,this.GetFieldValue(&quot;VF Passport Lock&quot;));
		pDVSIns.SetProperty(&quot;VISALock&quot;,this.GetFieldValue(&quot;VF VISA Lock&quot;));
		pDVSIns.SetProperty(&quot;DLLock&quot;,this.GetFieldValue(&quot;VF DL Lock&quot;));
		pDVSIns.SetProperty(&quot;VerificationId&quot;, this.GetFieldValue(&quot;DVS Trans Id&quot;));
		pDVSIns.SetProperty(&quot;RefNum&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
		//VHA Guruprasad - 26/06/2020 - Added if condition for R20 - Aug Rel - VeVo Validation CIR
		if(sIdType == sInternPassport)
		{
			pDVSIns.SetProperty(&quot;Id_IDType&quot;, &quot;Passport&quot;);
			pDVSIns.SetProperty(&quot;Country&quot;,this.GetFieldValue(&quot;International Country&quot;));
		}
		else
		{
			pDVSIns.SetProperty(&quot;Id_IDType&quot;, sIdType);
			pDVSIns.SetProperty(&quot;Country&quot;,this.GetFieldValue(&quot;Country&quot;));
		}
		pDVSIns.SetProperty(&quot;ContRowId&quot;,sContactId);
		pDVSIns.SetProperty(&quot;CustSegment&quot;,this.GetFieldValue(&quot;Customer Type&quot;));
		pDVSIns.SetProperty(&quot;AccountId&quot;,this.GetFieldValue(&quot;Account Id&quot;));
		pDVSIns.SetProperty(&quot;PerName&quot;,this.GetFieldValue(&quot;Person Name&quot;));
		pDVSIns.SetProperty(&quot;ExpiryDate&quot;,this.GetFieldValue(&quot;Expiry Date&quot;));
		pDVSIns.SetProperty(&quot;OverAllCnt&quot;,this.GetFieldValue(&quot;VF Max ID Limit&quot;));
		pDVSIns.SetProperty(&quot;TBUISessionId&quot;,this.GetFieldValue(&quot;TBUI Session Id&quot;));
		pDVSIns.SetProperty(&quot;CountryV&quot;,this.GetFieldValue(&quot;Country Visa&quot;));
		pDVSIns.SetProperty(&quot;QCondition&quot;,this.GetFieldValue(&quot;QCondition&quot;));
		pDVSIns.SetProperty(&quot;Issuedate&quot;,this.GetFieldValue(&quot;Issue Date&quot;));
		pDVSIns.SetProperty(&quot;Issuer&quot;,this.GetFieldValue(&quot;Issuer&quot;));
		pDVSIns.SetProperty(&quot;DOB&quot;,this.GetFieldValue(&quot;DOB&quot;));
		pDVSIns.SetProperty(&quot;DVSSuccessTime&quot;,this.GetFieldValue(&quot;Today&quot;));
		pDVSIns.SetProperty(&quot;FailAttempts&quot;,this.GetFieldValue(&quot;Fail Attempts&quot;));
		pDVSIns.SetProperty(&quot;PrimaryIdType&quot;,this.GetFieldValue(&quot;Primary ID Type&quot;));
		pDVSIns.SetProperty(&quot;SecondaryIdType&quot;,this.GetFieldValue(&quot;Secondary ID Type&quot;));
		if(sContChanged == &quot;N&quot;)
			pDVSIns.SetProperty(&quot;VerificationId&quot;, sDVSTransId);
			switch (sIdType) 
			{
			case &quot;Passport&quot;:
			case &quot;International Passport&quot;:
					sCancallDVS = &quot;Y&quot;;
					pDVSIns.SetProperty(&quot;Id_PassportNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
					pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
					pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
					pDVSIns.SetProperty(&quot;Id_MiddleName&quot;, this.GetFieldValue(&quot;Middle Name&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
					if(sIdType == &quot;Passport&quot;)
						sCountry = this.GetFieldValue(&quot;Country&quot;);
					else
						sCountry = this.GetFieldValue(&quot;International Country&quot;);
					sCountryCodeFlag = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;PassportCountry|&quot;+sCountry);
					if(sCountryCodeFlag != &quot;Y&quot;)
					{
						if (sCountry != &quot;&quot; &amp;&amp; sCountry != null)
						{
							LOVBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
							LOVBC = LOVBO.GetBusComp(&quot;List Of Values&quot;);
							with(LOVBC)
							{
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchSpec(&quot;Type&quot;,&quot;VF_VISA_COUNTRY&quot;);
								SetSearchSpec(&quot;Value&quot;,sCountry);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
									countryCode = GetFieldValue(&quot;Sub Type&quot;);
							}
						}
					pDVSIns.SetProperty(&quot;Id_CountryCode&quot;, countryCode);
					}
				break;
			case &quot;Green Medicare Card&quot;:
			case &quot;Interim Medicare Card&quot;:
			case &quot;Reciprocal Medicare Card&quot;:
			case &quot;Medicare Card&quot;:
					sCancallDVS = &quot;Y&quot;;
					sFirstName =  this.GetFieldValue(&quot;Given Name&quot;);
					sLastName = this.GetFieldValue(&quot;Surname&quot;);
					sMiddleName = this.GetFieldValue(&quot;Middle Name&quot;);
					sMiddleName = sMiddleName.replace(/^\s+|\s+$/gm,&apos;&apos;);
					if((sFirstName == &quot;&quot; || sFirstName == null) &amp;&amp; (sMiddleName == &quot;&quot; || sMiddleName == null))
						sFullName = sLastName;
					else if((sFirstName != &quot;&quot; &amp;&amp; sFirstName != null)  &amp;&amp; (sMiddleName != &quot;&quot; &amp;&amp; sMiddleName != null))
						sFullName = sFirstName + &quot; &quot;+ sMiddleName + &quot; &quot; + sLastName;
					else if ((sFirstName == &quot;&quot; || sFirstName == null) &amp;&amp; (sMiddleName != &quot;&quot; &amp;&amp; sMiddleName != null))
						sFullName = sMiddleName + &quot; &quot; + sLastName;
					else if ((sFirstName != &quot;&quot; &amp;&amp; sFirstName != null) &amp;&amp; (sMiddleName == &quot;&quot; || sMiddleName == null))
						sFullName = sFirstName + &quot; &quot; + sLastName;
					pDVSIns.SetProperty(&quot;Id_PersonName&quot;, sFullName);
					pDVSIns.SetProperty(&quot;PerName&quot;,sFullName);
					pDVSIns.SetProperty(&quot;Mc_Firstname&quot;,sFirstName);//VHA Guruprasad: 05/02/2021 - Added for PKE#89631
					pDVSIns.SetProperty(&quot;Mc_Surname&quot;,sLastName);
					pDVSIns.SetProperty(&quot;Id_CardNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_MedicareReferenceNumber&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
					pDVSIns.SetProperty(&quot;Id_ExpiryDate&quot;, this.GetFieldValue(&quot;Medicare Expiry Date&quot;));
					pDVSIns.SetProperty(&quot;Id_CardColor&quot;, this.GetFieldValue(&quot;Card Color&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
			case &quot;Driver&apos;s Licence&quot;:
					sCancallDVS = &quot;Y&quot;;
					pDVSIns.SetProperty(&quot;Id_LicenseNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_DLCardNumber&quot;, this.GetFieldValue(&quot;Driving License Card Number&quot;));
					pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
					pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
					pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
					pDVSIns.SetProperty(&quot;Id_DLIssuer&quot;, this.GetFieldValue(&quot;Issuer&quot;));
					pDVSIns.SetProperty(&quot;Id_MiddleName&quot;, this.GetFieldValue(&quot;Middle Name&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
			default:
					sCancallDVS = &quot;N&quot;;
				break;
			}
			if(sIdType == &quot;Proof of Age Card(Govt Issued)&quot;)
			{
				pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
				pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
				pDVSIns.SetProperty(&quot;Id_MiddleName&quot;, this.GetFieldValue(&quot;Middle Name&quot;));
				pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
			}
			if (sDVSSwitch == &quot;ON&quot; &amp;&amp; sOverrideResp == &quot;N&quot;) 
				pDVSIns.SetProperty(&quot;CallDVSTransaction&quot;, sCancallDVS);
			else
				pDVSIns.SetProperty(&quot;CallDVSTransaction&quot;, &quot;N&quot;);
			//Call DVS WF
			DVSwf = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			pDVSIns.SetProperty(&quot;ProcessName&quot;, &quot;VHA Generic Postpay Id Validation Workflow&quot;);
			DVSwf.InvokeMethod(&quot;RunProcess&quot;, pDVSIns, pDVSOut);
			strError = pDVSOut.GetProperty(&quot;Error Message&quot;);
			if(strError != &quot;&quot; &amp;&amp; strError != null)
			{
			if(pDVSOut.GetProperty(&quot;DVSStatus&quot;) != &quot;&quot; &amp;&amp; pDVSOut.GetProperty(&quot;DVSStatus&quot;) != null)
			{
				this.SetFieldValue(&quot;IsDVSCalled&quot;,pDVSOut.GetProperty(&quot;IsDVSCalled&quot;));
				this.SetFieldValue(&quot;Fail Attempts&quot;,pDVSOut.GetProperty(&quot;FailsAttempts&quot;));
				this.SetFieldValue(&quot;VF Passport Lock&quot;,pDVSOut.GetProperty(&quot;PassPortLock&quot;));
				this.SetFieldValue(&quot;VF MC Lock&quot;,pDVSOut.GetProperty(&quot;MCLock&quot;));
				this.SetFieldValue(&quot;VF VISA Lock&quot;,pDVSOut.GetProperty(&quot;VISALock&quot;));
				this.SetFieldValue(&quot;VF DL Lock&quot;,pDVSOut.GetProperty(&quot;DLLock&quot;));
				this.SetFieldValue(&quot;DVS Trans Id&quot;,pDVSOut.GetProperty(&quot;DVSTransId&quot;));
				TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
			}
			if(pDVSOut.GetProperty(&quot;sDVSOverAllSts&quot;) == &quot;ALL_SOURCES_LOCKED_OUT&quot;)
				this.SetFieldValue(&quot;VF Overall Lock&quot;, &quot;Y&quot;);
			sFailContactId.SetViewMode(AllView);
			sFailContactId.ClearToQuery();
			sFailContactId.ExecuteQuery(ForwardBackward);
				throw(strError);
			}
			this.SetFieldValue(&quot;ContactChanged&quot;,&quot;N&quot;);
			this.SetFieldValue(&quot;VF Max ID Limit&quot;, ToNumber(this.GetFieldValue(&quot;VF Max ID Limit&quot;)) + 1);
			this.SetFieldValue(&quot;IsDVSCalled&quot;,pDVSOut.GetProperty(&quot;IsDVSCalled&quot;));
			this.SetFieldValue(&quot;Fail Attempts&quot;,pDVSOut.GetProperty(&quot;FailsAttempts&quot;));
			/*this.SetFieldValue(&quot;VF Passport Lock&quot;,pDVSOut.GetProperty(&quot;PassPortLock&quot;));
			this.SetFieldValue(&quot;VF MC Lock&quot;,pDVSOut.GetProperty(&quot;MCLock&quot;));
			this.SetFieldValue(&quot;VF VISA Lock&quot;,pDVSOut.GetProperty(&quot;VISALock&quot;));
			this.SetFieldValue(&quot;VF DL Lock&quot;,pDVSOut.GetProperty(&quot;DLLock&quot;)); suresh*/
			this.SetFieldValue(&quot;DVS Trans Id&quot;,pDVSOut.GetProperty(&quot;DVSTransId&quot;));
			this.SetFieldValue(&quot;EnableAdd&quot;, &quot;FALSE&quot;);
			
		/*	if(TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_POSTPAY_IDTYPE_PRIMARY&quot;,sIdType) == &quot;Y&quot;)	// VHA Suresh P: added to nullify Prim Id disp
			{
				if(sIdType == &quot;Driver&apos;s Licence&quot;)
				{
					var sIssuer = &quot;&quot;, sQCOnd = &quot;&quot;;
					if(this.GetFieldValue(&quot;Issuer&quot;) == &quot;NSW&quot;)
					{
						if(this.GetFieldValue(&quot;QCondition&quot;) ==&quot;Y&quot;)
							sQCOnd = &quot;Yes&quot;;
						else
							sQCOnd = &quot;No&quot;;
						var sValue = sIdType+&quot;|NSW|&quot;+sQCOnd;
						this.SetFieldValue(&quot;VHA Prim ID – DL Captured&quot;,sValue);
					}
					else
					{
						var sValue = sIdType+&quot;|Other|NA&quot;;
						this.SetFieldValue(&quot;VHA Prim ID – DL Captured&quot;,sValue);
					}
				}
				else if(sIdType == &quot;Passport&quot;)
					this.SetFieldValue(&quot;VHA Prim ID – Passport Captured&quot;,sIdType);
				else if(sIdType == &quot;Proof of Age Card(Govt Issued)&quot;)
					this.SetFieldValue(&quot;VHA Prim ID – PA Captured&quot;,sIdType);
					
				//this.SetFieldValue(&quot;CCIsCreditCard&quot;,&quot;&quot;);
			}*/

			TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
			mNullifyfields();
			
			sFailContactId.SetViewMode(AllView);
			sFailContactId.ClearToQuery();
			sFailContactId.ExecuteQuery(ForwardBackward);

			if(TheApplication().ActiveViewName() == &quot;VF Select Service View - TBUI&quot;)
				sContactIdBC = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Identification Details TBUI&quot;);
			else
				sContactIdBC = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Contact Id&quot;);
			sContactIdBC.SetViewMode(AllView);
			sContactIdBC.ClearToQuery();
			sContactIdBC.ExecuteQuery(ForwardBackward);

			this.SetViewMode(AllView);
			this.ClearToQuery();
			this.ExecuteQuery(ForwardBackward);
			
			this.SetFieldValue(&quot;Primary ID Type&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Secondary ID Type&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Offer ID Type&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Issuer&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Country&quot;, &quot;&quot;);

	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		sConBC = null;
		sConBO = null;
		DVSwf = null;
		pDVSIns = null;
		pDVSOut = null;
}
	}"
