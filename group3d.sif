			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
	try
		{
			var sUpgradeTBUI = TheApplication().GetProfileAttr(&quot;PrepayUpgradeTBUI&quot;);
			var sAccId = TheApplication().GetProfileAttr(&quot;sUpgradeAccId&quot;);
			var sUAccntId,sURemEL,sUOrderId,sUCustType;
			
			if(sUpgradeTBUI == &quot;UpgradeView&quot;)
			{
				TheApplication().SetProfileAttr(&quot;if&quot;,&quot;if&quot;);
				TheApplication().SetProfileAttr(&quot;PrepayUpgradeTBUI&quot;,&quot;&quot;);			
		
				var sSessionId = TheApplication().GetProfileAttr(&quot;SessionIdPA&quot;);
				TheApplication().SetProfileAttr(&quot;SessionIdPA&quot;, &quot;&quot;);
			    var FinBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);	    
			    
				var sUpgrFinProfBC = FinBO.GetBusComp(&quot;VF Com Financial Profile TBUI&quot;);
				var sAccountBC = FinBO.GetBusComp(&quot;Account&quot;);
				var sOrderBC = BusObject().GetBusComp(&quot;Order Entry - Orders&quot;); 
				
				
				with(sUpgrFinProfBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Account Id&quot;);
					ActivateField(&quot;VHA Remaining Equipment Limit&quot;);


					SetSearchSpec(&quot;Account Id&quot;,sAccId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
					sUAccntId = GetFieldValue(&quot;Account Id&quot;);
					sURemEL = GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;);
					}
					
				}
			
					with(sAccountBC)
						{ClearToQuery();
						SetViewMode(AllView);
						ActivateField(&quot;VF Customer Type&quot;);
					
						SetSearchSpec(&quot;Id&quot;,sAccId);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
						sUCustType = GetFieldValue(&quot;VF Customer Type&quot;);
						}
					}
			
					sUOrderId = sOrderBC.GetFieldValue(&quot;Id&quot;);
			
					TheApplication().SetProfileAttr(&quot;Acc&quot;,sUAccntId);
					TheApplication().SetProfileAttr(&quot;Rem&quot;,sURemEL);
					TheApplication().SetProfileAttr(&quot;Ord&quot;,sUOrderId);
					TheApplication().SetProfileAttr(&quot;Cus&quot;,sUCustType);	
			
				this.ActivateField(&quot;Account Id&quot;);
				this.ActivateField(&quot;Order Id&quot;);
				this.ActivateField(&quot;Remaining Equipment Limit&quot;);
				this.ActivateField(&quot;Customer Type&quot;);
				this.ActivateField(&quot;Session Id&quot;);
				 
				 
				 this.SetFieldValue(&quot;Account Id&quot;, sUAccntId);
				 //this.SetFieldValue(&quot;Remaining Equipment Limit&quot;, sURemEL);
				 this.SetFieldValue(&quot;Order Id&quot;, sUOrderId);
				 this.SetFieldValue(&quot;Customer Type&quot;, sUCustType);
				 this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
				 this.WriteRecord();
			}
			else if(TheApplication().GetProfileAttr(&quot;NewAPP&quot;) == &quot;Y&quot;)
			{
				//TheApplication().SetProfileAttr(&quot;VHA Kali&quot;, &quot;Test&quot;);
				var sOrderBC = this.BusObject().GetBusComp(&quot;Order Entry - Orders&quot;); 
				sOrderBC.ActivateField(&quot;Account Id&quot;);
				/*var sFinProfBC = this.BusObject().GetBusComp(&quot;VF Com Financial Profile TBUI&quot;);
				var sAccountBC = this.BusObject().GetBusComp(&quot;Account&quot;);
				/*sFinProfBC.ActivateField(&quot;Account Id&quot;);
				sOrderBC.ActivateField(&quot;Id&quot;);
				sAccountBC.ActivateField(&quot;VF Customer Type&quot;);		
				this.ActivateField(&quot;Account Id&quot;);
				this.ActivateField(&quot;Order Id&quot;);
				this.ActivateField(&quot;Remaining Equipment Limit&quot;);
				this.ActivateField(&quot;Customer Type&quot;);
				var sAccntId = sFinProfBC.GetFieldValue(&quot;Account Id&quot;);
				var sRemEL = sFinProfBC.GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;);
				var sOrderId = sOrderBC.GetFieldValue(&quot;Id&quot;);
				var sCustType = sAccountBC.GetFieldValue(&quot;VF Customer Type&quot;);*/
				var sRemEL;
				var sAccntId =sOrderBC.GetFieldValue(&quot;Account Id&quot;);
				var sOrderId = sOrderBC.GetFieldValue(&quot;Id&quot;);
				var sCustType = sOrderBC.GetFieldValue(&quot;Order Account Type&quot;);
				TheApplication().SetProfileAttr(&quot;Acc&quot;,sAccntId);
				TheApplication().SetProfileAttr(&quot;Rem&quot;,&quot;1000&quot;);
				TheApplication().SetProfileAttr(&quot;Ord&quot;,sOrderId);
				TheApplication().SetProfileAttr(&quot;Cus&quot;,sCustType);
				
				this.SetFieldValue(&quot;Account Id&quot;, sAccntId);
				//this.SetFieldValue(&quot;Remaining Equipment Limit&quot;, sRemEL);
				this.SetFieldValue(&quot;Order Id&quot;, sOrderId);
				this.SetFieldValue(&quot;Customer Type&quot;, sCustType);
				this.WriteRecord();
			}
			else 
			{
				var sOrderBC = this.BusObject().GetBusComp(&quot;Order Entry - Orders&quot;); 
				var sFinProfBC = this.BusObject().GetBusComp(&quot;VF Com Financial Profile TBUI&quot;);
				var sAccountBC = this.BusObject().GetBusComp(&quot;Account&quot;);
				sFinProfBC.ActivateField(&quot;Account Id&quot;);
				sAccountBC.ActivateField(&quot;Id&quot;);
				sOrderBC.ActivateField(&quot;Id&quot;);
				sAccountBC.ActivateField(&quot;VF Customer Type&quot;);
				sFinProfBC.ActivateField(&quot;VHA Remaining Equipment Limit&quot;);		
				this.ActivateField(&quot;Account Id&quot;);
				this.ActivateField(&quot;Order Id&quot;);
				this.ActivateField(&quot;Remaining Equipment Limit&quot;);
				this.ActivateField(&quot;Customer Type&quot;);
				var sAccntId=sAccountBC.GetFieldValue(&quot;Id&quot;);// = sFinProfBC.GetFieldValue(&quot;Account Id&quot;);
				var sRemEL;
				with(sFinProfBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Account Id&quot;);
					ActivateField(&quot;VHA Remaining Equipment Limit&quot;);
					SetSearchSpec(&quot;Account Id&quot;,sAccntId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
						sRemEL = GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;);
				}	
				//var sRemEL = sFinProfBC.GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;);
				var sOrderId = sOrderBC.GetFieldValue(&quot;Id&quot;);
				var sCustType = sAccountBC.GetFieldValue(&quot;VF Customer Type&quot;);
				TheApplication().SetProfileAttr(&quot;Acc&quot;,sAccntId);
				TheApplication().SetProfileAttr(&quot;Rem&quot;,sRemEL);
				TheApplication().SetProfileAttr(&quot;Ord&quot;,sOrderId);
				TheApplication().SetProfileAttr(&quot;Cus&quot;,sCustType);
				
				this.SetFieldValue(&quot;Account Id&quot;, sAccntId);
				//this.SetFieldValue(&quot;Remaining Equipment Limit&quot;, sRemEL);
				this.SetFieldValue(&quot;Order Id&quot;, sOrderId);
				this.SetFieldValue(&quot;Customer Type&quot;, sCustType);
				this.WriteRecord();
			}	
	
	
	
		} 
	
		catch(e)
		{
			throw(e);
		}
	
		finally
		{
			/*sAccntId = null;
			sRemEL = null;
			sOrderId = null;
			sCustType = null;
			sFinProfBC = null;
			sAccountBC = null;	
			sOrderBC= null;
			sAccId = null;*/
		}
}"
			   SEQUENCE="1"
			   UPDATED="09/12/2019 17:37:08"
			   UPDATED_BY="SADMIN"
			   CREATED="09/12/2019 17:37:08"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
	
	try
	{
	
			
		if(MethodName == &quot;CalculatePrepayments&quot;)
		
		{
			var sID = this.GetFieldValue(&quot;Id&quot;);
			if(sID != &quot;&quot;)
			{
				this.ClearToQuery();
				this.SetSearchSpec(&quot;Id&quot;, sID);
				this.ExecuteQuery(ForwardBackward);
			}

			var svc = TheApplication().GetService(&quot;VHA Prepayments BS&quot;);
    		var Input = TheApplication().NewPropertySet();
    		var Output = TheApplication().NewPropertySet();
    		var sInput = TheApplication().NewPropertySet();
    		var sOutput = TheApplication().NewPropertySet();
    		var sTotalRRP = &quot;&quot;;
    		var sPrepayOption = &quot;&quot;;
    		var sUpfrontPay = &quot;&quot;;
    		var i=0;
    		var sMPPRRP = &quot;&quot;;
    		var sAPPRRP = &quot;&quot;;
    		
    		this.ActivateField(&quot;Order Id&quot;);
    		this.ActivateField(&quot;Remaining Equipment Limit&quot;);
    		this.ActivateField(&quot;Prepayment Option&quot;);
    		this.ActivateField(&quot;Device Accessory Amount&quot;);
    		this.ActivateField(&quot;Recalculate Prepayment&quot;);    		
    		this.ActivateField(&quot;Total MPP Prepayment&quot;);
    		this.ActivateField(&quot;Total APP Prepayment&quot;);
    		this.ActivateField(&quot;Prepayment Amount ReadOnly&quot;);
    		this.ActivateField(&quot;Ready To Pay Upfront&quot;);
    		
    		
    		var sOrderId = this.GetFieldValue(&quot;Order Id&quot;);
    		var sRemEL = this.GetFieldValue(&quot;Remaining Equipment Limit&quot;);
    		Input.SetProperty(&quot;OrderId&quot;, sOrderId);
    		
    		svc.InvokeMethod(&quot;CalculatePrepayments&quot;, Input, Output);
			sTotalRRP = Output.GetProperty(&quot;TotalRRP&quot;);
			sMPPRRP = Output.GetProperty(&quot;MPPPrepayment&quot;);
			sAPPRRP = Output.GetProperty(&quot;APPPrepayment&quot;);
			
			sInput.SetProperty(&quot;RemainingEL&quot;, sRemEL);
			sInput.SetProperty(&quot;TotalRRP&quot;, sTotalRRP);
			svc.InvokeMethod(&quot;UpfrontPrepayment&quot;, sInput, sOutput);
			
			sPrepayOption = sOutput.GetProperty(&quot;PrepayOption&quot;);
			sUpfrontPay = sOutput.GetProperty(&quot;UpfrontPay&quot;);
			
			//this.SetFieldValue(&quot;Device Accessory Amount&quot;, sTotalRRP);
			
			this.SetFieldValue(&quot;Total APP Prepayment&quot;, sAPPRRP);
			this.SetFieldValue(&quot;Total MPP Prepayment&quot;, sMPPRRP);
			this.SetFieldValue(&quot;Prepayment Option&quot;, sPrepayOption);
			this.SetFieldValue(&quot;Recalculate Prepayment&quot;, i);
			if(ToNumber(sRemEL) &gt; 0 )
				this.SetFieldValue(&quot;Prepayment Amount ReadOnly&quot;, &quot;Y&quot;);
			//this.SetFieldValue(&quot;Ready To Pay Upfront&quot;, 0);
			this.SetFieldValue(&quot;Required Min Prepayment Amount&quot;, sUpfrontPay);
			this.WriteRecord();
			
			return (CancelOperation);
    	}
		return (ContinueOperation);	
	}
	
	catch(e)
	{
	throw(e);
	}
	
	finally
	{
	svc = &quot;&quot;;
	Input = &quot;&quot;;
	Output = &quot;&quot;;
	sInput = &quot;&quot;;
	sOutput = &quot;&quot;;
	sOrderId = &quot;&quot;;
	sTotalRRP = &quot;&quot;;
	sMPPRRP = &quot;&quot;;
    sAPPRRP = &quot;&quot;;
	
	}
	
}"
			   SEQUENCE="2"
			   UPDATED="04/30/2020 21:39:04"
			   UPDATED_BY="SADMIN"
			   CREATED="09/12/2019 17:37:08"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{

	//VHA Prashanth 280519: Added Field validation for Prepayment Amount
	//if ((FieldName == &quot;Ready To Pay Upfront&quot; )&amp;&amp; (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;|| TheApplication().ActiveViewName()==&quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || TheApplication().ActiveViewName()==&quot;VF Eligibility and Offers View - TBUI&quot;))//TheApplication().GetProfileAttr(&quot;PrepaymentsValidation&quot;)!=&quot;Y&quot;)
	//Kalidas:26/06/2019:If condition modified for NewAPP - Prepayment requirement
	if ((FieldName == &quot;Ready To Pay Upfront&quot; )&amp;&amp; (TheApplication().ActiveViewName() == &quot;VF Connection Wizard View – Shopping Cart – TBUI HI&quot;|| TheApplication().ActiveViewName()==&quot;VF Connection Wizard View – Shopping Cart – TBUI&quot; || TheApplication().ActiveViewName()==&quot;VF Eligibility and Offers View - TBUI&quot; || TheApplication().ActiveViewName()== &quot;VHA Select Accessory TBUI - Manage APP View&quot;))//TheApplication().GetProfileAttr(&quot;PrepaymentsValidation&quot;)!=&quot;Y&quot;)
	{
		
	  	var sValue = 0, sLimit=0,sMin=0, sDeviceAcc=0, sType=&quot;&quot;, sInv=&quot;&quot;, iInt = 0;
		
		try{
		sValue = ToNumber(FieldValue);
		iInt = ToInteger(FieldValue);
		sLimit = ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Prepayment Limit&quot;));
		sDeviceAcc = ToNumber(this.GetFieldValue(&quot;Device Accessory Amount&quot;));
		sType = this.GetFieldValue(&quot;Prepayment Option&quot;);
		sMin = ToNumber(this.GetFieldValue(&quot;Required Min Prepayment Amount&quot;));
		sInv = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;,&quot;Involuntary&quot;);
			
			/*if (sValue != ToNumber(iInt))	//Commented as this is not required.		
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_09&quot;));
			else*/ if (sValue &lt; 0)			
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_01&quot;));
			else if (sValue &gt; sLimit)
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_02&quot;,sLimit));
			else if (sValue &gt; sDeviceAcc)
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_03&quot;));
			else if (sType == sInv &amp;&amp; sValue &lt; sMin)
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_04&quot;));
		}//try
		catch (e){
		throw e;
		}
		finally{
		iInt=null;
		sValue = null;
		sLimit=null;
		sMin=null;
		sDeviceAcc=null;
		sType=null;
		sInv=null;	
		}
	}//VHA Prashanth 280519:End

	return (ContinueOperation);
}"
			   SEQUENCE="3"
			   UPDATED="09/12/2019 17:37:08"
			   UPDATED_BY="SADMIN"
			   CREATED="09/12/2019 17:37:08"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
	try
	{
	
	if(FieldName == &quot;Required Min Prepayment Amount&quot;)
	{
		this.ActivateField(&quot;Required Min Prepayment Amount&quot;);
		this.ActivateField(&quot;Ready To Pay Upfront&quot;);
		var sReqMinAmt = this.GetFieldValue(&quot;Required Min Prepayment Amount&quot;);
		var sPPMin = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Prepayment Limit&quot;);
		if(ToNumber(sReqMinAmt) &lt;= ToNumber(sPPMin))
		{
			this.SetFieldValue(&quot;Ready To Pay Upfront&quot;, ToNumber(sReqMinAmt));
			this.WriteRecord();
		}
		else if (ToNumber(sReqMinAmt) &gt; ToNumber(sPPMin))
		{
		TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_13&quot;,sPPMin));
		}
	}
	}
	
	catch(e)
	{	
	throw(e);
	}
	
	finally
	{
		sReqMinAmt = null;
		sPPMin	= null;
	}
	
}"
			   SEQUENCE="4"
			   UPDATED="09/12/2019 17:37:08"
			   UPDATED_BY="SADMIN"
			   CREATED="09/12/2019 17:37:08"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
	TheApplication().SetProfileAttr(&quot;VFPrepaymentAmt&quot;,this.GetFieldValue(&quot;Ready To Pay Upfront&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Total APP Prepayment&quot;,this.GetFieldValue(&quot;Total APP Prepayment&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Total MPP Prepayment&quot;,this.GetFieldValue(&quot;Total MPP Prepayment&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Remaining Equipment Limit&quot;,this.GetFieldValue(&quot;Remaining Equipment Limit&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Required Min Prepayment Amount&quot;,this.GetFieldValue(&quot;Required Min Prepayment Amount&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Device Accessory Amount&quot;,this.GetFieldValue(&quot;Device Accessory Amount&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Order Id&quot;,this.GetFieldValue(&quot;Order Id&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Prepayment Option&quot;,this.GetFieldValue(&quot;Prepayment Option&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;Ready To Pay Upfront&quot;,this.GetFieldValue(&quot;Ready To Pay Upfront&quot;));//Kalidas:16/07/2019:Code added for PretoPost Prepayment Requirement
	TheApplication().SetProfileAttr(&quot;PrePaymentRO&quot;,&quot;&quot;);
}"
			   SEQUENCE="5"
