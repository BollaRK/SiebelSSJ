		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mDOB&quot;);
		}
		var strError;
		var DATE_EXP = &quot;19254&quot;;
		//var dToday = new Date();
		//var dtExpDt = new Date(sDOB);
		this.ActivateField(&quot;VF DOB Check Flag&quot;);
		var sDOBChkFlg = this.GetFieldValue(&quot;VF DOB Check Flag&quot;);
		 
	//	if (dToday &lt; dtExpDt) {
	        if (sDOBChkFlg == &quot;Y&quot;) {
			throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date Of Birth should be less than today.&quot;)
		}
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mDOB&quot;);
		}
	}
}"
			   SEQUENCE="8"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDVSCall"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/06/2015	Balaji		UNISIMTBUI      Initial Version
 *
 */
function mDVSCall(Outputs) 
{
	try 
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mDVSCall&quot;);
		}
		var strError;
		// Declare variables
		var DVSwf;
		var sDVSSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Enable Postpay DVS Validation&quot;);
		var sOverrideDVS = this.GetFieldValue(&quot;DVS Override Flag&quot;);
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		var sOverrideResp = this.GetFieldValue(&quot;Skip DVS Resp&quot;);
		var sCancallDVS = &quot;N&quot;;
		var sContChanged = this.GetFieldValue(&quot;ContactChanged&quot;); //Roseline 15/07/2015 - Added for defect# 553
		var pDVSIns = TheApplication().NewPropertySet();
		var pDVSOut = TheApplication().NewPropertySet();
		var DVSStatus;
		var DVSStatusMsg;
		var DVSTransId;
		var DVSOverAllSts;
		var sNoDVSCall = &quot;N&quot;, countryCode = &quot;&quot;;
		var sPassportCountry = &quot;&quot;;
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		if(sIdType == &quot;Green Medicare Card&quot; || sIdType == &quot;Interim Medicare Card&quot; || sIdType == &quot;Reciprocal Medicare Card&quot;)
		sIdType = &quot;Medicare Card&quot;;
		// Roseline 15/07/2015 - Added for defect# 553
		
		if(sIdType == &quot;Passport&quot;)
		sPassportCountry = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;PassportCountry|&quot;+this.GetFieldValue(&quot;Country&quot;));
		else
		sPassportCountry = &quot;Y&quot;;
		

				
		//Set DVS Transsaction Id for DVS Call
		var sDVSTransId = this.GetFieldValue(&quot;DVS Trans Id&quot;);
		if(sContChanged == &quot;Y&quot;)
		{
			pDVSIns.SetProperty(&quot;VerificationId&quot;, &quot;&quot;);
		}
		else if(sContChanged == &quot;N&quot;)
		{
			pDVSIns.SetProperty(&quot;VerificationId&quot;, sDVSTransId);
		}//end
		
		//Set the default properties
		//Customer details
		pDVSIns.SetProperty(&quot;Cust_Title&quot;, this.GetFieldValue(&quot;Cust Title&quot;));
		pDVSIns.SetProperty(&quot;Cust_FirstName&quot;, this.GetFieldValue(&quot;Cust FirstName&quot;));
		pDVSIns.SetProperty(&quot;Cust_LastName&quot;, this.GetFieldValue(&quot;Cust LastName&quot;));
		pDVSIns.SetProperty(&quot;Cust_MiddleName&quot;, this.GetFieldValue(&quot;Cust MiddleName&quot;));
		pDVSIns.SetProperty(&quot;Cust_DOB&quot;, this.GetFieldValue(&quot;Cust DOB&quot;));
		pDVSIns.SetProperty(&quot;Cust_EmailAddress&quot;, this.GetFieldValue(&quot;Cust EmailAddress&quot;));
		//Address details
		pDVSIns.SetProperty(&quot;Addr_StreetType&quot;, this.GetFieldValue(&quot;Addr StreetType&quot;));
		pDVSIns.SetProperty(&quot;Addr_City&quot;, this.GetFieldValue(&quot;Addr City&quot;));
		pDVSIns.SetProperty(&quot;Addr_State&quot;, this.GetFieldValue(&quot;Addr State&quot;));
		pDVSIns.SetProperty(&quot;Addr_Country&quot;, this.GetFieldValue(&quot;Addr Country&quot;));
		pDVSIns.SetProperty(&quot;Addr_PostalCode&quot;, this.GetFieldValue(&quot;Addr PostalCode&quot;));
		pDVSIns.SetProperty(&quot;Addr_Address1&quot;, this.GetFieldValue(&quot;Addr Address1&quot;));
		pDVSIns.SetProperty(&quot;Addr_Address2&quot;, this.GetFieldValue(&quot;Addr Address2&quot;));
		//pDVSIns.SetProperty(&quot;VerificationId&quot;, this.GetFieldValue(&quot;DVS Trans Id&quot;));
		pDVSIns.SetProperty(&quot;Id_IDType&quot;, sIdType);

		if (sDVSSwitch == &quot;ON&quot; &amp;&amp; sOverrideResp == &quot;N&quot; &amp;&amp; sPassportCountry == &quot;Y&quot;) 
		{
			switch (sIdType) {
			case &quot;Passport&quot;:
					sCancallDVS = &quot;Y&quot;;
					pDVSIns.SetProperty(&quot;Id_PassportNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
					pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
					pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
					pDVSIns.SetProperty(&quot;Id_Gender&quot;, this.GetFieldValue(&quot;Gender&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
			case &quot;Green Medicare Card&quot;:
			case &quot;Interim Medicare Card&quot;:
			case &quot;Reciprocal Medicare Card&quot;:
			case &quot;Medicare Card&quot;:
					sCancallDVS = &quot;Y&quot;;
					pDVSIns.SetProperty(&quot;Id_CardNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_MedicareReferenceNumber&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
					pDVSIns.SetProperty(&quot;Id_ExpiryDate&quot;, this.GetFieldValue(&quot;Medicare Expiry Date&quot;));
					pDVSIns.SetProperty(&quot;Id_PersonName&quot;, this.GetFieldValue(&quot;Person Name&quot;));
					pDVSIns.SetProperty(&quot;Id_CardColor&quot;, this.GetFieldValue(&quot;Card Color&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
						
			case &quot;VISA&quot;:
					sCancallDVS = &quot;Y&quot;;
					var countryOfIssue = this.GetFieldValue(&quot;Country&quot;);
					if (countryOfIssue != &quot;&quot; &amp;&amp; countryOfIssue != null)
					{
						var LOVBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
						var LOVBC = LOVBO.GetBusComp(&quot;List Of Values&quot;);
						with(LOVBC)
						{
							ClearToQuery();
							SetViewMode(AllView);
							SetSearchSpec(&quot;Type&quot;,&quot;VF_VISA_COUNTRY&quot;);
							SetSearchSpec(&quot;Value&quot;,countryOfIssue);
							ExecuteQuery(ForwardOnly);
							
							if(FirstRecord())
							{
								countryCode = GetFieldValue(&quot;Sub Type&quot;);
							}
						}
					}
					pDVSIns.SetProperty(&quot;Id_PassportNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
					pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
					pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
					pDVSIns.SetProperty(&quot;Id_MiddleName&quot;, this.GetFieldValue(&quot;Middle Name&quot;));
					pDVSIns.SetProperty(&quot;Id_CountryCode&quot;, countryCode);
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
			case &quot;Driver&apos;s Licence&quot;:
					sCancallDVS = &quot;Y&quot;;
					pDVSIns.SetProperty(&quot;Id_LicenseNumber&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					pDVSIns.SetProperty(&quot;Id_DLCardNumber&quot;, this.GetFieldValue(&quot;Driving License Card Number&quot;));
					pDVSIns.SetProperty(&quot;Id_GivenName&quot;, this.GetFieldValue(&quot;Given Name&quot;));
					pDVSIns.SetProperty(&quot;Id_Surname&quot;, this.GetFieldValue(&quot;Surname&quot;));
					pDVSIns.SetProperty(&quot;Id_DateofBirth&quot;, this.GetFieldValue(&quot;DOB&quot;));
					pDVSIns.SetProperty(&quot;Id_DLIssuer&quot;, this.GetFieldValue(&quot;Issuer&quot;));
					pDVSIns.SetProperty(&quot;Id_TermsConditions&quot;, &quot;On&quot;);
				break;
			default:
					sNoDVSCall = &quot;Y&quot;;
					Outputs.SetProperty(&quot;DVSOverAllSts&quot;, &quot;DVSDisabled&quot;);
					Outputs.SetProperty(&quot;DVSStatus&quot;, &quot;DVSDisabled&quot;);
					Outputs.SetProperty(&quot;DVSStatusMsg&quot;, DVSStatusMsg);
					Outputs.SetProperty(&quot;DVSTransID&quot;, &quot;&quot;);
				break;
			}
		} 
		else 
		{
			sNoDVSCall = &quot;Y&quot;;
			Outputs.SetProperty(&quot;DVSOverAllSts&quot;, &quot;DVSDisabled&quot;);
			Outputs.SetProperty(&quot;DVSStatus&quot;, &quot;DVSDisabled&quot;);
			Outputs.SetProperty(&quot;DVSStatusMsg&quot;, DVSStatusMsg);
			Outputs.SetProperty(&quot;DVSTransID&quot;, &quot;&quot;);
		}
		if (sCancallDVS == &quot;Y&quot;) 
		{
			//Call DVS WF
			DVSwf = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			pDVSIns.SetProperty(&quot;ProcessName&quot;, &quot;VF UNISIM Customer ID Validation - Outbound WF&quot;);
			pDVSIns.SetProperty(&quot;OrgName&quot;, &quot;Postpay_Rule_Id&quot;);
			DVSwf.InvokeMethod(&quot;RunProcess&quot;, pDVSIns, pDVSOut);
			DVSStatus = pDVSOut.GetProperty(&quot;Status&quot;);
			DVSOverAllSts = pDVSOut.GetProperty(&quot;Outcome&quot;);
			DVSStatusMsg = pDVSOut.GetProperty(&quot;Reason&quot;);
			DVSTransId = pDVSOut.GetProperty(&quot;VerificationId&quot;);

			Outputs.SetProperty(&quot;DVSStatus&quot;, DVSStatus);
			Outputs.SetProperty(&quot;DVSStatusMsg&quot;, DVSStatusMsg);
			Outputs.SetProperty(&quot;DVSTransId&quot;, DVSTransId);
			Outputs.SetProperty(&quot;DVSOverAllSts&quot;, DVSOverAllSts);
			this.SetFieldValue(&quot;ContactChanged&quot;,&quot;N&quot;);
		}
	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		DVSwf = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mDVSCall&quot;);
		}
	}
}"
			   SEQUENCE="9"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mEnableNewId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mEnableNewId() 
{
/*
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========	   ================================
 * 10/07/2015   Roseline 	Defect# 586     Enable New button in Id List applet 
 */
	try 
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mDOB&quot;);
		}
		this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
		TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
		mFailureAttempts();
	}
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mDOB&quot;);
		}
	}
}"
			   SEQUENCE="10"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mExpDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/06/2015	Balaji		UNISIMTBUI      Initial Version
 *
 */
function mExpDate(Medicrd, sExpiryDate) {
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mExpDate&quot;);
		}
		var DATE_EXP = &quot;19252&quot;;
		var dToday = new Date();
		if (Medicrd != &quot;Y&quot;)
		{
			var dtExpDt = new Date(sExpiryDate);
		
			if (dToday &gt;= dtExpDt) 
			{
				throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be greater than today.&quot;)
			}
		}
		else // For Medicard
		{
			var sLength = sExpiryDate.length;
			var SplChar = &quot;/&quot;;
			var rStrspn = Clib.strspn(sExpiryDate, &quot;0123456789&quot; + SplChar);
			if (sLength == rStrspn)
			{
					if(sLength == 7)
					{
							if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Green Medicare Card&quot;) //  12/2019
							{
								var sMid =  sExpiryDate.charAt(2);								
								if (sMid == SplChar)
								{
									var sArray = sExpiryDate.split(SplChar);
									var sMonth = sArray[0];  //42
									var sYear = sArray[1];  //2019
									if (ToNumber(sMonth) &gt; 0 &amp;&amp; ToNumber(sMonth) &lt;= 12)
									{
										var sCurMonth = dToday.getMonth() + 1; //12
										var sCurYear = dToday.getFullYear();  //2019
										if ( sCurYear &gt; ToNumber(sYear))
										{
										    throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Green Medicare Date should be future Date, mm/yyyy format&quot;);// change error message for rel19.4 SIT Defect 93 
										}
										if (sCurYear == ToNumber(sYear) &amp;&amp; sCurMonth &gt; ToNumber(sMonth))
										{
									      	throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Green Medicare Date should be future Date, mm/yyyy format&quot;);// change error message for rel19.4 SIT Defect 93
										}						
									}
                                   else
                                   {
                                      throw(&quot;VFErrorCode#: Green Medicare Date Should be in mm/yyyy format&quot;)
                                   }
						      	}
						    }
						else if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Interim Medicare Card&quot;|| this.GetFieldValue(&quot;ID Type&quot;) == &quot;Reciprocal Medicare Card&quot;)
						{
					     	throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be in  dd/mm/yy format&quot;)
						}
						else
						{
						     throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be in mm/yyyy or dd/mm/yy format&quot;) 
						}
		      }//End of if(sLength == 7)
				else if (sLength == 10)
				{   //added by balajim for rel19.4 for SIT Defect 93
                    if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Green Medicare Card&quot;)
                    {
                        throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Green Medicare Date should be in mm/yyyy format&quot;) 
                    }
                    else if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Interim Medicare Card&quot;|| this.GetFieldValue(&quot;ID Type&quot;) == &quot;Reciprocal Medicare Card&quot;)
                    {
                       throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be in dd/mm/yy format&quot;)
                    }//added by balajim for rel19.4 for SIT Defect 93
                    else
                    {
						var sSep1 = sExpiryDate.charAt(2);
						var sSep2 = sExpiryDate.charAt(5);
						
						if (sSep2 != SplChar || sSep2 != SplChar)
						{
							throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be in dd/mm/yyyy or mm/yyyy format&quot;)
						}
		
						var sArr = sExpiryDate.split(SplChar);
						var sDD = sArr[0];
						var sMM = sArr[1];
						var sYYYY = sArr[2];
						var sExpDate = sMM + SplChar + sDD + SplChar + sYYYY ;
						var dtMedExpDt = new Date(sExpDate);
						if (dToday &gt;= dtMedExpDt) 
						{
							throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be greater than today.&quot;)
						}
                  }
				} // End of	else if (sLength == 10)
					else if(sLength == 8)
					{	
						if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Interim Medicare Card&quot;|| this.GetFieldValue(&quot;ID Type&quot;) == &quot;Reciprocal Medicare Card&quot;)
						{
							var sSep1 = sExpiryDate.charAt(2);
							var sSep2 = sExpiryDate.charAt(5);
							
							if (sSep2 != SplChar || sSep2 != SplChar) // 22/22/22
							{
							throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be in dd/mm/yy format&quot;);
							}
							var sArr = sExpiryDate.split(SplChar);
							var sDD = ToInteger(sArr[0]); //42
							var sMM = ToInteger(sArr[1]); //22
							var sYY = ToInteger(sArr[2]); //22
							var sExpDate = sMM + SplChar + sDD + SplChar + sYY ;
							var curM = ToInteger(dToday.getMonth() + 1);//12
							var curD = ToInteger(dToday.getDate());//01
							var curY = ToString(dToday.getFullYear());//2019
							curY = ToNumber(curY.substring(2,4)); //19
							if(sDD &gt; 31 || sMM &gt; 12)
                            {
                               throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be in dd/mm/yy format&quot;);
                            }
                           if((curY == sYY) &amp;&amp; (curM &gt; sMM))
                           {
                             throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be greater than today.&quot;);
                           }
						
							/*if((sYY &lt; curY) || ((sYY == curY) &amp;&amp; (sMM &lt; curM)) || ((sYY == curY) &amp;&amp; (sMM == curM) &amp;&amp; (sDD &lt;= curD)))
							{
							
							throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Reciprocal/interim Medicare Date should be greater than today.&quot;);
							}*/
						}
						else if(this.GetFieldValue(&quot;ID Type&quot;) == &quot;Green Medicare Card&quot;)
						{
						    throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Green Medicare Date should be in  mm/yyyy format&quot;)
						}
						else
						{
						    //throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be in dd/mm/yy or mm/yyyy format&quot;)
						}	
					}
               else
			{
				throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date should be in dd/mm/yy or mm/yyyy format&quot;)
			}
			}// End of if (sLength == rStrspn)
			
		}// End of Medicard loop.
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects
		if (defined(sArr))sArr = null;
		if (defined(dtMedExpDt))dtMedExpDt = null;
		if (defined(sArray))sArray = null;
		if (defined(dtExpDt))dtExpDt = null;
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mExpDate&quot;);
		}
	}
}"
			   SEQUENCE="11"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mFailureAttempts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/06/2015	Balaji		UNISIMTBUI      Initial Version
 *
 */
function mFailureAttempts() {
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mFailureAttempts&quot;);
		}
		var strError;
		// Declare variables
		var sTotalFail = this.GetFieldValue(&quot;Fail Attempts&quot;);
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		var oActiveObj = TheApplication().ActiveBusObject();
		var oContactId = oActiveObj.GetBusComp(&quot;VF Contact Id&quot;);
		var oFailContactId = oActiveObj.GetBusComp(&quot;VHA Postpay Contact Id Failure TBUI&quot;);
		var sAttempts;
		this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
		TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);

		oFailContactId.SetViewMode(AllView);
		oFailContactId.ClearToQuery();
		oFailContactId.SetSearchSpec(&quot;Id Type&quot;, WrapSearchExpr(sIdType));
		oFailContactId.ExecuteQuery(ForwardBackward);
		if (oFailContactId.FirstRecord()) {
			sAttempts = oFailContactId.GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
			oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, ToNumber(sAttempts) + 1);
			this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail) + 1);
			oFailContactId.WriteRecord();
		} else {
			oFailContactId.NewRecord(NewAfter);
			oFailContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, 1);
			this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail) + 1);
			oFailContactId.WriteRecord();
		}
		oFailContactId.SetViewMode(AllView);
		oFailContactId.ClearToQuery();
		oFailContactId.ExecuteQuery(ForwardBackward);		
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects
		oActiveObj = null;
		oFailContactId = null;
		oContactId = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mFailureAttempts&quot;);
		}
	}
}"
			   SEQUENCE="12"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
