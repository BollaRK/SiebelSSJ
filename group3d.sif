			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mStubUpsert"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 04/06/2015	Balaji		UNISIMTBUI      Initial Version
 *
 */
// Current not used.. It was used as stup when DVS interface was under contruction

function mStubUpsert()
{
	var sTotalFail = this.GetFieldValue(&quot;Fail Attempts&quot;);
	var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
	var oActiveObj = TheApplication().ActiveBusObject();
	var oContactId = oActiveObj.GetBusComp(&quot;VF Contact Id&quot;);
	var oFailContactId = oActiveObj.GetBusComp(&quot;VF UNISIM Contact Id Failure TBUI&quot;);
	var sAttempts;
	this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
	TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
	switch(sIdType)
	{
		case &quot;Australian Passport&quot;:		
		if(this.GetFieldValue(&quot;Passport Number&quot;) == &quot;1234&quot;)
		{
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.SetSearchSpec(&quot;Id Type&quot;, sIdType);
			oFailContactId.ExecuteQuery(ForwardOnly);
			if(oFailContactId.FirstRecord())
			{
				sAttempts = oFailContactId.GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, ToNumber(sAttempts)+1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}
			else
			{		
				oFailContactId.NewRecord(NewAfter);
				oFailContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, 1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();					
			}				
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.ExecuteQuery();				
		}
		else
		{
			oContactId.NewRecord(NewAfter);
			oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
			oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
			oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
			oContactId.WriteRecord();
			mNullifyfields();
		}
		break;		
		case &quot;Medicare Card&quot;:		
		if(this.GetFieldValue(&quot;Medicare Card Number&quot;) == &quot;1234&quot;)
		{
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.SetSearchSpec(&quot;Id Type&quot;, sIdType);
			oFailContactId.ExecuteQuery(ForwardOnly);
			if(oFailContactId.FirstRecord())
			{
				sAttempts = oFailContactId.GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, ToNumber(sAttempts)+1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}
			else
			{		
				oFailContactId.NewRecord(NewAfter);
				oFailContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, 1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}				
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.ExecuteQuery();
		}
		else
		{
			oContactId.NewRecord(NewAfter);
			oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
			oContactId.SetFieldValue(&quot;Medicare Reference Number&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
			oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
			oContactId.SetFieldValue(&quot;Card Color&quot;, this.GetFieldValue(&quot;Card Color&quot;));
			oContactId.WriteRecord();
			mNullifyfields();
		}
		break;			
		case &quot;VISA&quot;:
		if(this.GetFieldValue(&quot;Passport Number&quot;) == &quot;1234&quot;)
		{
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.SetSearchSpec(&quot;Id Type&quot;, sIdType);
			oFailContactId.ExecuteQuery(ForwardOnly);
			if(oFailContactId.FirstRecord())
			{
				sAttempts = oFailContactId.GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, ToNumber(sAttempts)+1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}
			else
			{		
				oFailContactId.NewRecord(NewAfter);
				oFailContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, 1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}				
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.ExecuteQuery();
		}
		else
		{
			oContactId.NewRecord(NewAfter);
			oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
			//oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
			oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
			oContactId.WriteRecord();
			mNullifyfields();
		}
		break;
		case &quot;Driver&apos;s Licence&quot;:
		if(this.GetFieldValue(&quot;Passport Number&quot;) == &quot;1234&quot;)
		{
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.SetSearchSpec(&quot;Id Type&quot;, sIdType);
			oFailContactId.ExecuteQuery(ForwardOnly);
			if(oFailContactId.FirstRecord())
			{
				sAttempts = oFailContactId.GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, ToNumber(sAttempts)+1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}
			else
			{		
				oFailContactId.NewRecord(NewAfter);
				oFailContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
				oFailContactId.SetFieldValue(&quot;VF No. Of Failed Attempts&quot;, 1);
				this.SetFieldValue(&quot;Fail Attempts&quot;, ToNumber(sTotalFail)+1);
				oFailContactId.WriteRecord();
			}				
			oFailContactId.SetViewMode(AllView);
			oFailContactId.ClearToQuery();
			oFailContactId.ExecuteQuery();
		}
		else
		{
			oContactId.NewRecord(NewAfter);
			oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
			oContactId.SetFieldValue(&quot;State of Issue&quot;, this.GetFieldValue(&quot;Issuer&quot;));
			//oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
			oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
			oContactId.WriteRecord();
			mNullifyfields();
		}
		break;
		case &quot;Existing Customer&quot;:
		if(mGetCustomerDetails())
		{
			oContactId.NewRecord(NewAfter);
			oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
			oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;MSISDN&quot;));
		}
		else
		{
			TheApplication().RaiseErrorText(&quot;No Identification details for the customer. Please proceed as Not Validated&quot;);
		}
		break;
		default:
		TheApplication().RaiseErrorText(&quot;Out&quot;);
		break;		
	}
}"
			   SEQUENCE="19"
			   UPDATED="01/24/2026 18:53:15"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:33"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpsertIdDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========		================================
 * 09/06/2015	Balaji		UNISIMTBUI      Initial Version
 * 25/06/2015   Rupak                   	Field Changed to &quot;VF Medicare Expiry Date&quot;
 * 14/07/2015   Roseline	Defect# 639 	Added validation logic for Existing Prepay Customer
 * 							Defect# 511		Added logic to disable the ID Type if DVS is success
 * 13/08/2015   Roseline	Defect# 1015 	Enabled Failure attempts capture for DVS Error Scenario
 							Defect# 1016 	Restrict addition of another ID once Existing Customer is added successfully.
 */ 
function mUpsertIdDetails() 
{
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mUpsertIdDetails&quot;);
		}
		var strError;
		// Declare variables
		var ID_NOT_FOUND = &quot;19229&quot;;
		var ID_LOCK_CD = &quot;19303&quot;;
		var ID_OVERAL_CD = &quot;19212&quot;;
		var ID_ERR_CD = &quot;19308&quot;;
		var ID_INVLD_CD = &quot;19307&quot;;
		var ID_INPRG_CD = &quot;19306&quot;;
		var ID_LOCK_CD = &quot;19303&quot;;
		var EXISCUST_PREPAY = &quot;19245&quot;;
		var sIdTypeMedicare = &quot;&quot;;
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		if(sIdType == &quot;Green Medicare Card&quot; || sIdType == &quot;Interim Medicare Card&quot; || sIdType == &quot;Reciprocal Medicare Card&quot;)
		sIdTypeMedicare = &quot;Medicare Card&quot;;
		var sTBUISessionId = this.GetFieldValue(&quot;TBUI Session Id&quot;);
		var oActiveObj = TheApplication().ActiveBusObject();
		var oContactId = oActiveObj.GetBusComp(&quot;VF Contact Id&quot;);
		var sDVSStatus;
		var sDVSStatusMsg;
		var sDVSTransId;
		var sDVSOverAllSts;
		var sActivityId;
		var sActiveServices;
		var sOverAllCnt = this.GetFieldValue(&quot;VF Max ID Limit&quot;);
		var sExistingCustCnt = this.GetFieldValue(&quot;VF Max EC ID Limit&quot;);
		//var Inputs = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();		

	
			
		this.SetFieldValue(&quot;VF Max ID Limit&quot;, ToNumber(sOverAllCnt) + 1); //increment the Overall count for all id types		
	 
		if (sIdType != &quot;Existing Customer&quot; &amp;&amp; sIdType != &quot;Not Validated&quot;) 
		{
			mDVSCall(Outputs);
			sDVSStatus = Outputs.GetProperty(&quot;DVSStatus&quot;);
			sDVSStatusMsg = Outputs.GetProperty(&quot;DVSStatusMsg&quot;);
			sDVSTransId = Outputs.GetProperty(&quot;DVSTransId&quot;);
			sDVSOverAllSts = Outputs.GetProperty(&quot;DVSOverAllSts&quot;);
			
			if (sDVSOverAllSts != &quot;ALL_SOURCES_LOCKED_OUT&quot;) 
			{
				switch (sDVSStatus) 
				{
				case &quot;VALID&quot;:
				case &quot;DVSDisabled&quot;:
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;Y&quot;); // Bypass DVM
					oContactId.NewRecord(NewAfter);
					TheApplication().SetProfileAttr(&quot;VFContactId&quot;, &quot;Y&quot;);
					switch (sIdType)
					{
					case &quot;Passport&quot;:
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
						if(sDVSStatus == &quot;VALID&quot;)
                        oContactId.SetFieldValue(&quot;DVS Successful Time&quot;, this.GetFieldValue(&quot;Today&quot;)); //balajim added to insert DVS Sucessfultime -Rel19.4 24/9/2019
                        break;
					case &quot;Green Medicare Card&quot;:
					case &quot;Interim Medicare Card&quot;:
					case &quot;Reciprocal Medicare Card&quot;:
					case &quot;Medicare Card&quot;:	
					
						oContactId.ActivateField(&quot;Id Reference Number&quot;);					
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdTypeMedicare);
						oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
						oContactId.ActivateField(&quot;Medicare Reference Number&quot;);
						oContactId.ActivateField(&quot;Card Color&quot;);
						oContactId.ActivateField(&quot;VF Medicare Expiry Date&quot;);
						oContactId.ActivateField(&quot;Expiry Date&quot;);
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
						oContactId.SetFieldValue(&quot;Medicare Reference Number&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
						oContactId.SetFieldValue(&quot;Card Color&quot;, this.GetFieldValue(&quot;Card Color&quot;));						
						oContactId.SetFieldValue(&quot;VF Medicare Expiry Date&quot;, this.GetFieldValue(&quot;Medicare Expiry Date&quot;));
						if(sDVSStatus == &quot;VALID&quot;)
                        oContactId.SetFieldValue(&quot;DVS Successful Time&quot;, this.GetFieldValue(&quot;Today&quot;)); //balajim added to insert DVS Sucessfultime -Rel19.4 24/9/2019		 				
						break;
					
					case &quot;VISA&quot;:						
						oContactId.SetFieldValue(&quot;UNISIM Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
					//	oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country Visa&quot;));
						oContactId.SetFieldValue(&quot;VF Visa Country of Issue&quot;, this.GetFieldValue(&quot;Country Visa&quot;));
						oContactId.SetFieldValue(&quot;VF UNISIM Category&quot;, &quot;A&quot;);
						oContactId.SetFieldValue(&quot;Id Points&quot;, &quot;100&quot;);
						if(sDVSStatus == &quot;VALID&quot;)
                        oContactId.SetFieldValue(&quot;DVS Successful Time&quot;, this.GetFieldValue(&quot;Today&quot;)); //balajim added to insert DVS Sucessfultime -Rel19.4 24/9/2019
						break;
					case &quot;Driver&apos;s Licence&quot;:
						oContactId.ActivateField(&quot;VHA Updated Cont Id Ref&quot;);
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;State of Issue&quot;, this.GetFieldValue(&quot;Issuer&quot;));
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
                        if(this.GetFieldValue(&quot;QCondition&quot;) == &quot;Y&quot;)
                        {
                          oContactId.SetFieldValue(&quot;VHA Updated Cont Id Ref&quot;, &quot;1&quot;);  //balajim added in -Rel19.4 04/10/2019
                        }
						if(sDVSStatus == &quot;VALID&quot;)
                        oContactId.SetFieldValue(&quot;DVS Successful Time&quot;, this.GetFieldValue(&quot;Today&quot;)); //balajim added to insert DVS Sucessfultime -Rel19.4 24/9/2019
						break;
					default:
                        oContactId.ActivateField(&quot;Country of Issue&quot;);
                        oContactId.ActivateField(&quot;State of Issue&quot;);
                        oContactId.ActivateField(&quot;VF LOA Issue Date&quot;);
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
						oContactId.SetFieldValue(&quot;Driving License Card Number&quot;, this.GetFieldValue(&quot;Driving License Card Number&quot;));	//DVS					
						//oContactId.SetFieldValue(&quot;State of Issue&quot;, this.GetFieldValue(&quot;Issuer&quot;));
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
                        oContactId.SetFieldValue(&quot;VF LOA Issue Date&quot;, this.GetFieldValue(&quot;Issue Date&quot;))
                        oContactId.SetFieldValue(&quot;Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
                        oContactId.SetFieldValue(&quot;State of Issue&quot;, this.GetFieldValue(&quot;Issuer&quot;));
						this.SetFieldValue(&quot;EnableAdd&quot;, &quot;FALSE&quot;);
						break;
					}
					var sValidationIndicator = &quot;&quot;;   // Sachi - 06/16/2018 - Added for UniSIM Id Sighting CIR // Start
					
					var svc = TheApplication().GetService(&quot;VF Network Settings BS&quot;); 
					var psIn = TheApplication().NewPropertySet();
					var psOut = TheApplication().NewPropertySet();
					psIn.SetProperty(&quot;Type&quot;,&quot;VHA_ID_VALIDATION_TYPE&quot;);
					psIn.SetProperty(&quot;LIC&quot;,sDVSStatus);
					svc.InvokeMethod(&quot;QueryLOV&quot;,psIn,psOut);
					sValidationIndicator = psOut.GetProperty(&quot;Desc&quot;);
					
					oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					oContactId.ActivateField(&quot;Validation Indicator&quot;);
					oContactId.ActivateField(&quot;Date Of Birth&quot;);
					oContactId.ActivateField(&quot;Activity Id&quot;);
					oContactId.ActivateField(&quot;TBUI Session Id&quot;);
					oContactId.SetFieldValue(&quot;Validation Indicator&quot;,sValidationIndicator);   // Sachi - 06/16/2018 - Added for UniSIM Id Sighting CIR // End
					oContactId.SetFieldValue(&quot;Date Of Birth&quot;, this.GetFieldValue(&quot;DOB&quot;));					
					if (sDVSStatus == &quot;VALID&quot;) 
					{	
						// To change the Add button, New button disable and ID sighting read only
						this.SetFieldValue(&quot;EnableAdd&quot;, &quot;FALSE&quot;);
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;Y&quot;);
						TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
						sActivityId = mCreateActivity(sIdType);
						oContactId.SetFieldValue(&quot;Activity Id&quot;, sActivityId);
					}					
					oContactId.SetFieldValue(&quot;DVS Transaction Id&quot;, sDVSTransId);
					oContactId.SetFieldValue(&quot;TBUI Session Id&quot;, sTBUISessionId);//Roseline:24/08/2015 - Added to store TBUI session ID
					oContactId.WriteRecord();
					oContactId.SetViewMode(AllView);
					oContactId.ClearToQuery();
					oContactId.ExecuteQuery(ForwardBackward);
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;N&quot;);					
					mNullifyfields();
					break;

				case &quot;LOCKED_OUT&quot;:
					// var ID_LOCK_CD  = &quot;19303&quot;; - Passport Id type has been Lockout in DVS.
					switch (sIdType) 
					{
					case &quot;Passport&quot;:
						this.SetFieldValue(&quot;VF Passport Lock&quot;, &quot;Y&quot;);
						break;
					case &quot;Green Medicare Card&quot;:
						this.SetFieldValue(&quot;VF MC Lock&quot;, &quot;Y&quot;);
						break;
					case &quot;Interim Medicare Card&quot;:
						this.SetFieldValue(&quot;VF MC Lock&quot;, &quot;Y&quot;);
						break;
					case &quot;Reciprocal Medicare Card&quot;:
						this.SetFieldValue(&quot;VF MC Lock&quot;, &quot;Y&quot;);
						break;
					case &quot;VISA&quot;:
						this.SetFieldValue(&quot;VF VISA Lock&quot;, &quot;Y&quot;);
						break;
					case &quot;Driver&apos;s Licence&quot;:
						this.SetFieldValue(&quot;VF DL Lock&quot;, &quot;Y&quot;);
						break;
					default:
						break;
					}
					//Enable the New button &amp; ID sighting in ID list Applet
					mEnableNewId();
					throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; - Id type has been Lockout in DVS.&quot;);
					break;

				case &quot;IN_PROGRESS&quot;:
					this.SetFieldValue(&quot;DVS Trans Id&quot;, sDVSTransId);
					mEnableNewId();
					throw(&quot;VFErrorCode#: &quot; + ID_INPRG_CD + &quot; DVS validation failed. Proceed with different ID type.&quot;);
					break;

				case &quot;INVALID&quot;:
					this.SetFieldValue(&quot;DVS Trans Id&quot;, sDVSTransId);
					mEnableNewId();
					// var ID_INVLD_CD = &quot;19307&quot; - DVS validation failed. Enter the valid data.
					throw(&quot;VFErrorCode#: &quot; + ID_INVLD_CD + &quot; DVS validation failed. Enter the valid data.&quot;);
					break;

				case &quot;Error&quot;:
					// var ID_ERR_CD = &quot;19308&quot;; - Error in the DVS interface
					//Enable the New button &amp; ID sighting in ID list Applet
					//Roseline: 13/08/2015 - Removed for defect# 1015
					//Need to enable capturing of Failure attempts for error scenario also
					/*this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
					TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
					//mFailureAttempts();*/
					mEnableNewId(); //Roseline: 13/08/2015 - Added for defect# 1015
					throw(&quot;VFErrorCode#: &quot; + ID_ERR_CD + &quot; Error in the DVS interface.&quot;);
					break;

				default:
					break;
				}
				//Roseline 14/07/2015 - Added for defect# 511
				if(sDVSStatus == &quot;VALID&quot;)
				{
					//this.SetFieldValue(&quot;EnableIdType&quot;,&quot;Y&quot;);
				} 
			} 
			else 
			{
				//throw Err
				//Enable the New button &amp; ID sighting in ID list Applet
				this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
				TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
				// var ID_OVERAL_CD = &quot;19212&quot;; - Maximum attempts has been reached to validate Id details with DVS
				this.SetFieldValue(&quot;VF Overall Lock&quot;, &quot;Y&quot;);
				throw(&quot;VFErrorCode#: &quot; + ID_OVERAL_CD + &quot; Maximum attempts has been reached to validate Id details with DVS.&quot;);
			}
		}		
	} 
	catch (e)
	{
		TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;N&quot;); // Bypass DVM
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		oActiveObj = null;
		oContactId = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mUpsertIdDetails&quot;);
		}
	}
}"
			   SEQUENCE="20"
			   UPDATED="01/24/2026 18:53:15"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:33"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidationDts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	 Description
 * ============ ===========	===========	 ================================
 * 04/06/2015	Balaji		UNISIMTBUI      Initial Version
 * 14/07/2015   Roseline    Defect# 635  	Added script to enable New button &amp; ID Sighting after Maintenance Code error
 *
 */
function mValidationDts() 
{
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mValidationDts&quot;);
		}
		var strError;
		// Declare variables
		var REQ_FLD_CODE = &quot;19251&quot;;
		var FAIL_ATTEMTS = &quot;19212&quot;;
		var ID_TYPE = &quot;19250&quot;;
		var MAX_ATT_CD = &quot;19301&quot;;
		var OVERALL_LOCK_CD = &quot;19302&quot;;
		var ID_LOCK_CD = &quot;19303&quot;;
		var MAINT_ID_CD = &quot;19304&quot;;
		var MAX_EC_CD = &quot;19305&quot;;
		var sMaxLimit = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;DVS Postpay Limit&quot;);
		var sErrMsg = &quot;VFErrorCode#: &quot; + REQ_FLD_CODE + &quot; Enter the value for all required fields.&quot;
		var Medicrd = &quot;N&quot;;	
		var sMaxLimitOverride = this.GetFieldValue(&quot;Max Limit Override Resp&quot;);
		var sContactId = this.GetFieldValue(&quot;Contact Id&quot;);
		var sIdTypeTBC = this.GetFieldValue(&quot;ID Type&quot;);
		var sFailAtt = &quot;&quot;;
		var oActiveObj = TheApplication().ActiveBusObject();		
		var oFailContactId = oActiveObj.GetBusComp(&quot;VHA Postpay Contact Id Failure TBUI&quot;);
		with(oFailContactId)
		{
			ActivateField(&quot;Id Type&quot;);
			ActivateField(&quot;VF No. Of Failed Attempts&quot;);
			ActivateField(&quot;Contact Id&quot;);									
			ClearToQuery(); 
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id Type&quot;, WrapSearchExpr(sIdTypeTBC));
			SetSearchSpec(&quot;Contact Id&quot;, sContactId);
			//var searchst = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos; AND [Id Type] = &apos;&quot;+WrapSearchExpr(sIdTypeTBC)+&quot;&apos;&quot;;
			//SetSearchExpr(searchst);
			ExecuteQuery(ForwardOnly);	
			if(FirstRecord())
			{
			 	sFailAtt = GetFieldValue(&quot;VF No. Of Failed Attempts&quot;); 
			}
		}				
	
		if (ToNumber(sFailAtt) &lt; ToNumber(sMaxLimit) || sMaxLimitOverride == &quot;Y&quot;) {
			var sOverrideDVS = this.GetFieldValue(&quot;DVS Override Flag&quot;);
			var IdType = this.GetFieldValue(&quot;ID Type&quot;);			
			var Medcardnum = this.GetFieldValue(&quot;Medicare Card Number&quot;);
			var Medrefnum = this.GetFieldValue(&quot;Medicare Reference Number&quot;);
			var Pername = this.GetFieldValue(&quot;Person Name&quot;);
			var Ccolor = this.GetFieldValue(&quot;Card Color&quot;);
			var Edate = this.GetFieldValue(&quot;Expiry Date&quot;);
			var Passnum = this.GetFieldValue(&quot;Passport Number&quot;);
			var Surname = this.GetFieldValue(&quot;Surname&quot;);
			var Gname = this.GetFieldValue(&quot;Given Name&quot;);
			var Gender = this.GetFieldValue(&quot;Gender&quot;);
			var DOB = this.GetFieldValue(&quot;DOB&quot;);
			var Mname = this.GetFieldValue(&quot;Middle Name&quot;);
			var Msisdn = this.GetFieldValue(&quot;MSISDN&quot;);
			var Pin = this.GetFieldValue(&quot;PIN&quot;);
			var Country = this.GetFieldValue(&quot;Country&quot;);
			var Issuer = this.GetFieldValue(&quot;Issuer&quot;);
			var RefNum = this.GetFieldValue(&quot;Reference Number&quot;);
			var DLCardNum = this.GetFieldValue(&quot;Driving License Card Number&quot;);
			var MedExpDate = this.GetFieldValue(&quot;Medicare Expiry Date&quot;);
			var CountryV = this.GetFieldValue(&quot;Country Visa&quot;);
			var DLCardNum = this.GetFieldValue(&quot;Driving License Card Number&quot;);//DVS
			var DLIssuer = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_DL_ISSUER&quot;,this.GetFieldValue(&quot;Issuer&quot;));//DVS
			if (this.GetFieldValue(&quot;VF Overall Lock&quot;) == &quot;N&quot; || sMaxLimitOverride == &quot;Y&quot;) {

				if (IdType == &quot;&quot; || IdType == null) {
				//	TheApplication().RaiseErrorText(&quot;Please Enter the value for ID Type.&quot;);
					throw(&quot;VFErrorCode#: &quot; + ID_TYPE + &quot; Please Enter the value for ID Type.&quot;)
				}
				switch (IdType)
				{
				case &quot;Green Medicare Card&quot;:
				case &quot;Interim Medicare Card&quot;:
				case &quot;Reciprocal Medicare Card&quot;:
					if(sOverrideDVS == &quot;Y&quot; || (mGetSystemPreference(&quot;DVSMedicare&quot;) == &quot;N&quot; &amp;&amp; (sOverrideDVS == &quot;N&quot; || sOverrideDVS == &quot;&quot;))){
						if (this.GetFieldValue(&quot;VF MC Lock&quot;) == &quot;N&quot;) 
						{
							if (Medcardnum == &quot;&quot; || RefNum == &quot;&quot; || Pername == &quot;&quot; || Ccolor == &quot;&quot; || MedExpDate == &quot;&quot;) {
								//TheApplication().RaiseErrorText(&quot;Enter the value for all required fields.&quot;);
								throw(sErrMsg);
							}
						} 
						else 
						{
							throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; Medicare Card Id type has been Lockout in DVS.&quot;);
						}
					} 
					else 
					{	
						//Roseline 14/07/2015 - Added for defect# 635
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
						TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
						throw(&quot;VFErrorCode#: &quot; + MAINT_ID_CD + &quot; DVS call for Medicare Card validation is under maintanance.&quot;);
					}
					Medicrd = &quot;Y&quot;;
					mExpDate(Medicrd, MedExpDate);
					//Call Blocklist chk
					mBlacklistIDCheck();
					break;
					
				case &quot;Passport&quot;:
					if(sOverrideDVS == &quot;Y&quot; || (mGetSystemPreference(&quot;DVSPassport&quot;) == &quot;N&quot; &amp;&amp; (sOverrideDVS == &quot;N&quot; || sOverrideDVS == &quot;&quot;))){
						if (this.GetFieldValue(&quot;VF Passport Lock&quot;) == &quot;N&quot;) 
						{
							if (RefNum == &quot;&quot; || Surname == &quot;&quot; || Gname == &quot;&quot; || Gender == &quot;&quot; || Edate == &quot;&quot; || DOB == &quot;&quot; || Country == &quot;&quot;) {
								//TheApplication().RaiseErrorText(&quot;Please enter the value for all required fields.&quot;);
								throw(sErrMsg);
							}
						} else {
							throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; Passport Id type has been Lockout in DVS.&quot;);
						}
					} 
					else
					{
						//Roseline 14/07/2015 - Added for defect# 635
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
						TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
						throw(&quot;VFErrorCode#: &quot; + MAINT_ID_CD + &quot; DVS call for Passport validation is under maintanance.&quot;);
					}
					mExpDate(Medicrd, Edate);
					mDOB(DOB);
					//Call Blocklist chk
					mBlacklistIDCheck();
					break;
					
				case &quot;VISA&quot;:
					if(sOverrideDVS == &quot;Y&quot; || (mGetSystemPreference(&quot;DVSVisa&quot;) == &quot;N&quot; &amp;&amp; (sOverrideDVS == &quot;N&quot; || sOverrideDVS == &quot;&quot;))){
						if (this.GetFieldValue(&quot;VF VISA Lock&quot;) == &quot;N&quot;) 
						{					
							if (RefNum == &quot;&quot; || Surname == &quot;&quot; || Gname == &quot;&quot; || Gender == &quot;&quot; || Edate == &quot;&quot; || DOB == &quot;&quot; || CountryV == &quot;&quot;) {
								throw(sErrMsg);
							}
						} else {
							throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; VISA Id type has been Lockout in DVS.&quot;);
						}
					} 
					else 
					{
						//Roseline 14/07/2015 - Added for defect# 635
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
						TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
						throw(&quot;VFErrorCode#: &quot; + MAINT_ID_CD + &quot; DVS call for VISA validation is under maintanance.&quot;);
					}
					mExpDate(Medicrd, Edate);
					mDOB(DOB);
					//Call Blocklist chk
					mBlacklistIDCheck();
					break;
					
				case &quot;Driver&apos;s Licence&quot;:
					if(sOverrideDVS == &quot;Y&quot; || (mGetSystemPreference(&quot;DVSDriverLicence&quot;) == &quot;N&quot; &amp;&amp; (sOverrideDVS == &quot;N&quot; || sOverrideDVS == &quot;&quot;))){
						if (this.GetFieldValue(&quot;VF DL Lock&quot;) == &quot;N&quot;) 
						{
							if (RefNum == &quot;&quot; || (DLCardNum == &quot;&quot; &amp;&amp; DLIssuer == &quot;Y&quot;) || Surname == &quot;&quot; || Gname == &quot;&quot; || Country == &quot;&quot; || Edate == &quot;&quot; || Issuer == &quot;&quot; || DOB == &quot;&quot;) {
								throw(sErrMsg);
							}
							
						} else {
							throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; Driver&apos;s Licence Id type has been Lockout in DVS.&quot;);
						}
					} 
					else 
					{
						//Roseline 14/07/2015 - Added for defect# 635
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
						TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
						throw(&quot;VFErrorCode#: &quot; + MAINT_ID_CD + &quot; DVS call for Driver&apos;s Licence validation is under maintanance.&quot;);
					}

					mExpDate(Medicrd, Edate);
					mDOB(DOB);
					//Call Blocklist chk
					mBlacklistIDCheck();
					break;
				default:
                 //balajiM Added for Rel19.4 - 24Sep2019
	                        if (RefNum == &quot;&quot;)
	                        {
	                           throw(sErrMsg);
	                        }
                            /*if(IdType == &quot;Letter of Authority&quot; &amp;&amp; issuedate == &quot;&quot;)
                            {
                               TheApplication().RaiseErrorText (&quot;VFErrorCode#19259: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19259&quot;));
                            }*/
                            var sNumPattern = /[^0-9]/g;
                            var NumPP1 = RefNum.substring(0,5);
                            if(IdType == &quot;Credit/Debit Card&quot;)
                            {
                               if(RefNum.length != 6 || NumPP1.match(sNumPattern))
                               {
                               TheApplication().RaiseErrorText (&quot;VFErrorCode#19259: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19260&quot;));
                               }
                            }
                            /*if(IdType == &quot;Proof of Age Card(Govt Issued)&quot; &amp;&amp; Issuer == &quot;&quot;)
                            {
                               TheApplication().RaiseErrorText (&quot;VFErrorCode#19259: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19261&quot;));
                            }*/
                            if((IdType == &quot;Proof of Age Card(Govt Issued)&quot;) &amp;&amp; Edate == &quot;&quot;)
                            {
                               TheApplication().RaiseErrorText (&quot;VFErrorCode#19259: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19262&quot;));
                            }
                            if((IdType == &quot;Proof of Age Card(Govt Issued)&quot;) &amp;&amp; Issuer == &quot;&quot;)
                            {
                               TheApplication().RaiseErrorText (&quot;VFErrorCode#19259: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19263&quot;));
                            }
                            mPostpayExpDate(Medicrd, Edate);
                            //balajiM Added for Rel19.4 - 24Sep2019
					break;
				}
			} 
			else 
			{
				throw(&quot;VFErrorCode#: &quot; + FAIL_ATTEMTS + &quot; Maximum attempts has been reached to validate Id details with DVS&quot;);
			}
		} 
		else {
			throw(&quot;VFErrorCode#: &quot; + MAX_ATT_CD + &quot; Maximum attempts has been reached to validate &amp; add the Id details&quot;);
		}
	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mValidationDts&quot;);
		}
	}

}"
