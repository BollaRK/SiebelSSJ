			   SCRIPT="function BusComp_PreWriteRecord ()
{
try
{
	var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
	var IsValidated = this.GetFieldValue(&quot;VHA IsValidated&quot;);
	
		/*if (sIdType == &quot;None of the Above&quot;)
		{  
			this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
			TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
			
		}*/
		
		if(IsValidated != &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;Y&quot;);
			//TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
		}
}
catch (e) 
    {
        throw (e);
    } 
    finally 
    {
    }		
	return (ContinueOperation);
}"
