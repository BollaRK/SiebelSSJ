			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckforExistingId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========	   ================================
 * 10/07/2015   Roseline 	Defect# 511     check whether ID type is already existing
 *											 
 */
function mCheckforExistingId(ContactId) 
{
	try 
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mCheckforExistingId&quot;);
		}
		var sIdType, isRec, sDVSTranId, sRemoveExistingId;
		var EXISTING_ID = &quot;19270&quot;;
		var IdType = this.GetFieldValue(&quot;ID Type&quot;);
		if(IdType == &quot;Green Medicare Card&quot; || IdType == &quot;Interim Medicare Card&quot; || IdType == &quot;Reciprocal Medicare Card&quot;)
		IdType = &quot;Medicare Card&quot;;
		var sContIdBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sContIdBC = sContIdBO.GetBusComp(&quot;VF Contact Id&quot;);
		with(sContIdBC)
		{	
			sContIdBC.ActivateField(&quot;VHA Remove Existing Id&quot;);
			sContIdBC.SetViewMode(AllView);
			sContIdBC.ClearToQuery();
			SetSearchSpec(&quot;Id Type&quot;, WrapSearchExpr(IdType));
			SetSearchSpec(&quot;Contact Id&quot;, ContactId);			
			sContIdBC.ExecuteQuery(ForwardBackward);
			isRec = sContIdBC.FirstRecord();
			if(isRec)
			{
				sIdType = sContIdBC.GetFieldValue(&quot;Id Type&quot;);
				sDVSTranId = sContIdBC.GetFieldValue(&quot;DVS Transaction Id&quot;);
				sRemoveExistingId = sContIdBC.GetFieldValue(&quot;VHA Remove Existing Id&quot;);
				
				if(sIdType == IdType &amp;&amp; (sDVSTranId != null &amp;&amp; sDVSTranId != &quot;&quot;) &amp;&amp; (sRemoveExistingId == &quot;&quot; || sRemoveExistingId == null || sRemoveExistingId == &quot;N&quot;))
				//if(sIdType == IdType)
				{	
					throw(&quot;VFErrorCode#19270: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;DVS19270&quot;));
				}
				else if(sIdType == IdType &amp;&amp; (sRemoveExistingId == &quot;&quot; || sRemoveExistingId == null || sRemoveExistingId == &quot;N&quot;))
				{
					throw(&quot;VFErrorCode#10205: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;10205&quot;));
				
				}
			}
			else
			{
				// Do Nothing
			}
		}//with(sContIdBC)			
	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mCheckforExistingId&quot;);
		}
	}
} // Main fn"
			   SEQUENCE="5"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateActivity(sIdType) {
	/*
	 * Modification History  : Create Activity for Id Success
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 12/06/2015	Roseline	UNISIMTBUI    Initial Version
	 *
	 */
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mCreateActivity&quot;);
		}
		var strError;
		// Declare variables
		var sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
		var FailAttempt = &quot;Failures: &quot;;
		var sTBUISessionId = this.GetFieldValue(&quot;TBUI Session Id&quot;);
		var fIdType = &quot;&quot;;
		var fFailCount,
		isRec;
		var sDescription;

	/*	var oActiveObj = TheApplication().ActiveBusObject();
		var oFailContactId = oActiveObj.GetBusComp(&quot;VF UNISIM Contact Id Failure TBUI&quot;);
		with (oFailContactId) {
			SetViewMode(AllView);
			ActivateField(&quot;Activity Id&quot;);
			ActivateField(&quot;Id Type&quot;);
			ActivateField(&quot;VF No. Of Failed Attempts&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Activity Id&quot;, &quot;IS NULL&quot;);
			ExecuteQuery(ForwardBackward);
			var isRec = FirstRecord();
			while (isRec) {
				fIdType = GetFieldValue(&quot;Id Type&quot;);
				fFailCount = GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);
				FailAttempt = FailAttempt + fIdType + &quot;-&quot; + fFailCount + &quot;;&quot;;
				isRec = NextRecord();
			}
		}
		if (fIdType != &quot;&quot;) {
			sDescription = FailAttempt + &quot;Success: &quot; + sIdType + &quot;;&quot; + sTBUISessionId;
		} else {
			sDescription = &quot;Success: &quot; + sIdType + &quot;;&quot; + sTBUISessionId;
		}*/
		sDescription = &quot;Success: &quot; + sIdType + &quot;;&quot; + sTBUISessionId;
		//Create Activity
		var sType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;TODO_TYPE&quot;, &quot;Postpay DVS ID Validation&quot;);
		var svcActivities = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);
		var psActivityInp = TheApplication().NewPropertySet();
		var psActivityOut = TheApplication().NewPropertySet();
		psActivityInp.SetProperty(&quot;Account Object Id&quot;, sAccountId);
		psActivityInp.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);
		psActivityInp.SetProperty(&quot;Type&quot;, sType);
		psActivityInp.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
		psActivityInp.SetProperty(&quot;Description&quot;, sDescription);
		psActivityInp.SetProperty(&quot;Comment&quot;, sDescription);
		svcActivities.InvokeMethod(&quot;GenerateActivity&quot;, psActivityInp, psActivityOut);
		var sActivityId = psActivityOut.GetProperty(&quot;Activity Id&quot;);

		/*with (oFailContactId) {
			var isRec = FirstRecord();
			while (isRec) {
				SetFieldValue(&quot;Activity Id&quot;, sActivityId);
				WriteRecord();
				isRec = NextRecord();
			}
		}*/
		return (sActivityId);
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects
		//oActiveObj = null;
		//oFailContactId = null;
		svcActivities = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VF UNISIM Add Identification TBC.mCreateActivity&quot;);
		}
	}
}"
			   SEQUENCE="7"
