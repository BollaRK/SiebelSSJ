			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckforExistingId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckforExistingId(IdType) 
{
	try 
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mCheckforExistingId&quot;);
		}
		var sIdType, isRec, sDVSTranId;
		var EXISTING_ID = &quot;19270&quot;;
		
		var sContIdBO = TheApplication().ActiveBusObject();
		var sContIdBC = sContIdBO.GetBusComp(&quot;VF Contact Id&quot;);
		with(sContIdBC)
		{
			sContIdBC.SetViewMode(AllView);
			sContIdBC.ClearToQuery();
			sContIdBC.ExecuteQuery(ForwardBackward);
			isRec = sContIdBC.FirstRecord();
			if(isRec)
			{
				sIdType = sContIdBC.GetFieldValue(&quot;Id Type&quot;);
				sDVSTranId = sContIdBC.GetFieldValue(&quot;DVS Transaction Id&quot;);
				if((sDVSTranId != &quot;&quot; || sDVSTranId != null)&amp;&amp; sIdType == IdType)
				//if(sIdType == IdType)
				{
					throw(&quot;VFError#: &quot;+EXISTING_ID+&quot; Already an ID with type &quot; +sIdType+ &quot; exits. Please add another Id type.&quot;);	
				}
			}
			else
			{
				// Do Nothing
			}
		}//with(sContIdBC)			
	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
	/*Below variables are nullified by Sharukh on 02/04/2019*/
	sContIdBC = null;
	sContIdBO = null;


// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VHA Kogan Capture Id Details TBC.mCheckforExistingId&quot;);
		}
	}
} // Main fn"
			   SEQUENCE="3"
			   UPDATED="04/12/2019 14:15:56"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
