			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckIDCombination"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckIDCombination()
{
	try
	{
		var sAccId = this.GetFieldValue(&quot;Account Id&quot;);
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;); //Added for SSJ ID detail msg
		TheApplication().SetProfileAttr(&quot;sIdType1&quot;,sIdType);
		var sSSJLOV = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;SSJ_IDDET_MSG&quot;);
		var sFlow = &quot;&quot;,sIdIdentifier=&quot;&quot;;
		var sActView = TheApplication().ActiveViewName();
		if(sActView == &quot;VF Customer ID Details – Postpay TBUI&quot; || sActView == &quot;VF SSJ Customer ID Details – Postpay TBUI&quot;)
			sFlow = &quot;New Connection&quot;;
		else if(sActView == &quot;VF Customer ID Details – PretoPost TBUI&quot;)
			sFlow = &quot;Pre to Post transfer&quot;;
		else if(sActView == &quot;VF Select Service View - TBUI&quot;)
			sFlow = &quot;UPGRADE&quot;;
			
			
		if(sAccId != &quot;&quot; &amp;&amp; sAccId != null &amp;&amp; sFlow != &quot;UPGRADE&quot; &amp;&amp; sFlow != &quot;&quot;)
		{
		var sInp = TheApplication().NewPropertySet();
		var sOut = TheApplication().NewPropertySet();
		var sService = TheApplication().GetService(&quot;VHA Postpay DVS Validation BS&quot;);
		sInp.SetProperty(&quot;AccountId&quot;,sAccId);
		sInp.SetProperty(&quot;OrderTypeTBUI&quot;,sFlow);
		sService.InvokeMethod(&quot;CheckForDVSEnablement&quot;,sInp,sOut);
		

		if(sSSJIdType == &quot;Passport&quot; || sSSJIdType == &quot;International Passport&quot; || sSSJIdType == &quot;Driver&apos;s Licence&quot; || sSSJIdType == &quot;Proof of Age Card(Govt Issued)&quot;)
			sIdIdentifier = &quot;Primary ID&quot;;
		else if(sSSJIdType == &quot;Green Medicare Card&quot; || sSSJIdType == &quot;Interim Medicare Card&quot; || sSSJIdType == &quot;Reciprocal Medicare Card&quot; ||sSSJIdType == &quot;Defence Force ID&quot;||sSSJIdType == &quot;DVA Health Care Card&quot; ||sSSJIdType == &quot;Gold Veteran Affairs Card&quot;)
			sIdIdentifier = &quot;Secondary ID&quot;;
		else if(sSSJIdType == &quot;Pensioner Card&quot; || sSSJIdType == &quot;Student ID&quot;)
			sIdIdentifier = &quot;Offer ID&quot;;

		if(sOut.GetProperty(&quot;DVSIDCheckRequired&quot;) == &quot;Y&quot;)
			{
			sService.InvokeMethod(&quot;CheckDVSContactDetails&quot;,sInp,sOut);
			if(sOut.GetProperty(&quot;ErrorMessageOut&quot;) ==&quot;&quot; || (sOut.GetProperty(&quot;ErrorMessageOut&quot;) != &quot;&quot; &amp;&amp; sOut.GetProperty(&quot;SuggestionMessage&quot;) == &quot;Y&quot;)){
				//if(sSSJLOV == &quot;SSJ_IDDET_MSG_Y&quot;)//VHA KT 05/03/26: Commented this line &amp; added below as it is impacting BAU TBUI(CM-7938)
				if(TheApplication().GetProfileAttr(&quot;SSJFlow&quot;)==&quot;Y&quot;)
					TheApplication().SetProfileAttr(&quot;VHAIDCombinationWarning&quot;,&quot;Id has been validated and updated&quot;);
				else
					TheApplication().SetProfileAttr(&quot;VHAIDCombinationWarning&quot;,&quot;All requested identification has been provided, please proceed with the order.&quot;);
				}
			}
		
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally{}
}"
			   SEQUENCE="6"
