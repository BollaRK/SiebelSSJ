			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
	var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
	var IsValidated = this.GetFieldValue(&quot;VHA IsValidated&quot;);
	var DVSOverrideFlag = this.GetFieldValue(&quot;DVS Override Flag&quot;);

		if (sIdType == &quot;None of the Above&quot;)
		{  
			this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
			TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
			
		}
		
		else if(IsValidated != &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;Y&quot;);
			TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
		}
		
		if(DVSOverrideFlag == &quot;Y&quot;)
		{
			TheApplication().SetProfileAttr(&quot;USIMIDSighted&quot;, &quot;Y&quot;);
		}
		
		else
		{
			TheApplication().SetProfileAttr(&quot;USIMIDSighted&quot;, &quot;N&quot;);
		}
		
	return (ContinueOperation);
}"
			   SEQUENCE="27"
			   UPDATED="01/24/2026 18:53:14"
			   UPDATED_BY="MONISHAJ"
			   CREATED="11/06/2019 15:08:32"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
	//Roseline 15/07/2015 - Added for Defect# 553
	//To set the field &apos;ContactChanged&apos; to &apos;Y&apos; if Contact fields sent to DVS are set
	 
	switch (FieldName) 
	{
			case &quot;Cust Title&quot;:
			case &quot;Cust FirstName&quot;:
			case &quot;Cust LastName&quot;:
			case &quot;Cust MiddleName&quot;:
			case &quot;Cust DOB&quot;:
			case &quot;Cust EmailAddress&quot;:
			case &quot;Addr Address1&quot;:
			case &quot;Addr Address2&quot;:
			case &quot;Addr City&quot;:
			case &quot;Addr Country&quot;:
			case &quot;Addr PostalCode&quot;:
			case &quot;Addr State&quot;:
			case &quot;Addr StreetType&quot;:
				this.SetFieldValue(&quot;ContactChanged&quot;,&quot;Y&quot;);			
				break;
				
			default:
				break;
			
	}
	

	var IdType = this.GetFieldValue(&quot;ID Type&quot;); // Sachin - 06/15/2018 - Added for UniSIM Id Sighting CIR.
	
	if(FieldName == &quot;ID Type&quot; || FieldName == &quot;DVS Override Flag&quot;) //Vinodhini-Added for UNISIM CR. // Sachin - 06/15/2018 - Added DVS Override Flag condition to existing expression.
	{
		this.WriteRecord();
	}
	//Added for DVS
	if(FieldName == &quot;Primary ID Type&quot; || FieldName == &quot;Secondary ID Type&quot; || FieldName == &quot;Offer ID Type&quot;)
	{
		if(this.GetFieldValue(&quot;Driving License Card Number&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;Driving License Card Number&quot;) != null)
		{
			this.SetFieldValue(&quot;Issuer&quot;,&quot;NSW&quot;);
			this.SetFieldValue(&quot;Driving License Card Number&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Issuer&quot;,&quot;&quot;);
		}
	}
	if (FieldName == &quot;Issuer&quot;)
	{
		var DLIssuer = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_DL_ISSUER&quot;,this.GetFieldValue(&quot;Issuer&quot;));
		if(DLIssuer == &quot;N&quot;)
		{
			this.SetFieldValue(&quot;DL Flag&quot;,&quot;N&quot;);
			this.SetFieldValue(&quot;Driving License Card Number&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;DL Flag&quot;,&quot;&quot;);
		}
	}//Added for DVS
	
}"
