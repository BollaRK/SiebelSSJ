			if (sTestingPCIToken != &quot;&quot; &amp;&amp; sTestingPCIToken != null)
			{
				sUniqueId = sTestingPCIToken;
				strInp.SetProperty(&quot;Bypass&quot;,&quot;Y&quot;);
			}
