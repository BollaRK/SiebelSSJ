			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mDOB&quot;);
		}
		var strError;
		var DATE_EXP = &quot;19254&quot;;
		this.ActivateField(&quot;VF DOB Check Flag&quot;);
		var sDOBChkFlg = this.GetFieldValue(&quot;VF DOB Check Flag&quot;);
		 
	//	if (dToday &lt; dtExpDt) {
	        if (sDOBChkFlg == &quot;Y&quot;) {
			throw(&quot;VFErrorCode#: &quot;+DATE_EXP+&quot; Date Of Birth should be less than today.&quot;)
