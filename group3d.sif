			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{	
try
{
	if(FieldName == &quot;ID Type&quot;)
	{
		var sPassport = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;Passport&quot;);
		var sDL = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;Driver&apos;s Licence&quot;);
		var sVisa = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;VISA&quot;);
		//this.SetFieldValue(&quot;Card Color&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Country&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;DOB&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Expiry Date&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Gender&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
		if(this.GetFieldValue(&quot;Driving License Card Number&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;Driving License Card Number&quot;) != null)
			this.SetFieldValue(&quot;Driving License Card Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Issuer&quot;, &quot;&quot;);
	//	this.SetFieldValue(&quot;MSISDN&quot;, &quot;&quot;);
		//this.SetFieldValue(&quot;Medicare Card Number&quot;, &quot;&quot;);
	//	this.SetFieldValue(&quot;Medicare Reference Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;PIN&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Passport Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Person Name&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
		//this.SetFieldValue(&quot;Medicare Expiry Date&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Country Code&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Country Visa&quot;, &quot;&quot;);
		/*if(this.GetFieldValue(&quot;DVS Override Flag&quot;) == &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;DVS Override Flag&quot;, &quot;N&quot;);
		}*/
		this.SetFieldValue(&quot;Reference Number&quot;, &quot;&quot;);
	//	this.SetFieldValue(&quot;MSISDN Type&quot;, &quot;&quot;);
		
		var FirstName = this.GetFieldValue(&quot;Cust FirstName&quot;);
		var MiddleName = this.GetFieldValue(&quot;Cust MiddleName&quot;);
		var LastName = this.GetFieldValue(&quot;Cust LastName&quot;);
		var DOB = this.GetFieldValue(&quot;Cust DOB&quot;);
		var PersonName = FirstName + &quot; &quot; + MiddleName + &quot; &quot; + LastName;
		
		if (FieldValue == sDL || FieldValue == sPassport)
		{  
			this.SetFieldValue(&quot;Surname&quot;, LastName);
			this.SetFieldValue(&quot;DOB&quot;, DOB);
			this.SetFieldValue(&quot;Given Name&quot;, FirstName);
		 }
		else if (FieldValue == sVisa)
		{  
			this.SetFieldValue(&quot;Surname&quot;, LastName);
			this.SetFieldValue(&quot;DOB&quot;, DOB);
			this.SetFieldValue(&quot;Given Name&quot;, FirstName);
			this.SetFieldValue(&quot;Middle Name&quot;, MiddleName);
		 }
		/*else if (FieldValue == &quot;Medicare Card&quot;)
		 {
		 this.SetFieldValue(&quot;Person Name&quot;, PersonName);  
		 }*/
	}
}
	catch (e) 
    {
        throw (e);
    } 
    finally 
    {
	}
	return (ContinueOperation);
}"
