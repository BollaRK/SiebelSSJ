			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckForDVSId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckForDVSId (sContactId){

		
		var sBO = TheApplication().GetBusObject(&quot;VF Contact Id&quot;);
		var sBC = sBO.GetBusComp(&quot;VF Contact Id&quot;);
		//var sContactId = Inputs.GetProperty(&quot;ContactId&quot;);//this.BusComp().GetFieldValue(&quot;Contact Id&quot;);
		var CCExists = &quot;NotFound&quot;;
		if(sContactId != &quot;&quot;)
		{
			with(sBC)
			{
				
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;DVS Transaction Id&quot;);
				var SerachExpr = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos; AND [DVS Transaction Id] IS NOT NULL&quot;;				
				//SetSearchSpec(&quot;Contact Id&quot;, sContactId);
				//SetSearchSpec(&quot;DVS Transaction Id&quot;, &quot;IS NOT NULL&quot;);
				SetSearchExpr(SerachExpr);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					CCExists = &quot;Found&quot;;
					//TheApplication().RaiseErrorText(&quot;Only One Credit Card Record can be added.&quot;);
					
				}
			}
		}
		
		//Outputs.SetProperty(&quot;CCExists&quot;,CCExists);
		
		if(CCExists == &quot;Found&quot;){
			TheApplication().RaiseErrorText(&quot;There is already a valid DVS Id captured for the customer. Please delete the Id to recapture the DVS Validated Id&quot;);
		}

}"
