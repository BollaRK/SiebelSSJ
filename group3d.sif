			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPostpayExpDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPostpayExpDate(Medicrd, sExpiryDate)
{
//balajiM - Added for Postpay Non DVS Expiry date check - 10/16/2019
try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VF UNISIM Add Identification TBC.mPostpayExpDate&quot;);
		}
		var DATE_EXP = &quot;19252&quot;;
		var dToday = new Date();
		if (Medicrd != &quot;Y&quot;)
		{
			var dtExpDt = new Date(sExpiryDate);
		
			if (dToday &gt;= dtExpDt) 
			{
				throw(&quot;VFErrorCode#: Expiry Date must be greater than or equal to today&apos;s date. Please enter a valid value for the field.&quot;)
			}
		}
		
		
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		
	}
}"
			   SEQUENCE="18"
