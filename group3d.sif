	   UPDATED_BY="SADMIN"
	   CREATED="05/19/2019 19:19:46"
	   CREATED_BY="SADMIN"
	   FIO_PLACEHOLDER_FIO="TRUE">
		<BUSINESS_COMPONENT
		   CACHE_DATA="N"
		   CLASS="CSSBusComp"
		   DIRTY_READS="Y"
		   DISTINCT="N"
		   FORCE_ACTIVE="N"
		   GENREASSIGNACT="N"
		   INACTIVE="N"
		   INSERT_UPDATE_ALL_COLUMNS="N"
		   LOG_CHANGES="Y"
		   MULTI_RECIPIENT_SELECT="N"
		   NAME="VHA Prepayment Credit Card Details"
		   NO_DELETE="N"
		   NO_INSERT="N"
		   NO_MERGE="N"
		   NO_UPDATE="N"
		   OWNER_DELETE="N"
		   POPUP_VISIBILITY_AUTO_ALL="N"
		   SCRIPTED="Y"
		   SEARCH_SPECIFICATION="[Type] = &apos;Credit Card Details&apos;"
		   TABLE="S_ORG_EXT_XM"
		   TYPE="Non-Transient"
		   UPDATED="09/30/2019 11:59:12"
		   UPDATED_BY="SADMIN"
		   CREATED="09/30/2019 11:59:12"
		   CREATED_BY="SADMIN">
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
try{
 if(MethodName == &quot;mManualRefresh&quot;)
 {
			//this.ActivateField(&quot;Billing Account Id&quot;);
			//var BAN = this.GetFieldValue(&quot;Billing Account Id&quot;);
			//throw(&quot;StartRefresh&quot;);
			var BAN = TheApplication().GetProfileAttr(&quot;PrepaymentsBACId&quot;);
			BAN = &quot;BAN:&quot;+ BAN;
			var strWF = TheApplication().GetService(&quot;Workflow Process Manager&quot;); 
			var strinp = TheApplication().NewPropertySet(); 
			var strout = TheApplication().NewPropertySet(); 
			strinp.SetProperty(&quot;Identifier&quot;,BAN);
			strinp.SetProperty(&quot;ClientRef&quot;,BAN);
			strinp.SetProperty(&quot;ProcessName&quot;,&quot;VF PCI Token Complete Workflow&quot;);
			strWF.InvokeMethod(&quot;RunProcess&quot;,strinp,strout); 
			var strCCNum = strout.GetProperty(&quot;CCToken&quot;);
			var strCCType = strout.GetProperty(&quot;CCType&quot;);
			var strCCExpYr = strout.GetProperty(&quot;CCExpYr&quot;);
			var strCCExpMonth = strout.GetProperty(&quot;CCExpMon&quot;);
			var strCCExp = strout.GetProperty(&quot;CCExpDt&quot;);
			var strCCHolderName = strout.GetProperty(&quot;CCHolder&quot;);
			var sFusionCode	       = strout.GetProperty(&quot;BWErrCode&quot;);
          	var sException  		   = strout.GetProperty(&quot;WorkflowWithError&quot;);
          	var sDispMessage	       = strout.GetProperty(&quot;Display Error Message&quot;);
		  	var sErrorMessage    	   = strout.GetProperty(&quot;Error Message&quot;);
		  	var sErrorStatus    	   = strout.GetProperty(&quot;ErrorStatus&quot;);
			var sExpiryDt	= strCCExpMonth+&quot;/&quot;+strCCExpYr;
            if (sErrorStatus == &quot;FAILED&quot;)
			{
				//External Errors
	            TheApplication().RaiseErrorText(sErrorMessage);
	        }           
            else
            {
            	this.NewRecord(NewAfter);
	          				
				this.ActivateField(&quot;Credit Card Token Number&quot;);//
				this.ActivateField(&quot;Card Holder Name&quot;);//
				this.ActivateField(&quot;Card Type&quot;);//
				this.ActivateField(&quot;Expiry Date&quot;);
				this.SetFieldValue(&quot;Credit Card Token Number&quot;,strCCNum);//
				this.SetFieldValue(&quot;Card Holder Name&quot;,strCCHolderName);//
				this.SetFieldValue(&quot;Card Type&quot;,strCCType);//
				this.SetFieldValue(&quot;Payment Status&quot;,&quot;New&quot;);
				this.SetFieldValue(&quot;Expiry Date&quot;,sExpiryDt);
				this.WriteRecord();	
				TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
			}
		 if(TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SWITCH&quot;, &quot;CreditCardPay&quot;) ==&quot;Y&quot;)
		 {
			this.ClearToQuery();
			this.ExecuteQuery(ForwardBackward);
			this.SetSortSpec(&quot;Created (DESC)&quot;);
		}
 	return (CancelOperation);
 }         //End of Code
		
	
	}
	
	catch(e)
{throw(e);
}
finally
{
}
	return (ContinueOperation);
}"
			   SEQUENCE="1"
			   UPDATED="09/30/2019 12:01:54"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 12:01:54"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
	
try
{
	if(FieldName == &quot;Select&quot;)
	{
	this.ActivateField(&quot;Prepayment Record Id&quot;);
	this.ActivateField(&quot;Id&quot;);
	var sXMId = this.GetFieldValue(&quot;Prepayment Record Id&quot;);
	var sCurrent = this.GetFieldValue(&quot;Id&quot;);
	var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	//var sXMbc = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
	var sCreditBC = sBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
	var flag = &quot;Y&quot;;	
	var searchSpec = &quot;[Select] = &apos;&quot; + flag + &quot;&apos; AND [Prepayment Record Id] = &apos;&quot; + sXMId + &quot;&apos; AND [Id] &lt;&gt; &apos;&quot; + sCurrent + &quot;&apos;&quot;;
	
	with(sCreditBC)
		{
		ClearToQuery();
		SetViewMode(AllView);
		ActivateField(&quot;Prepayment Record Id&quot;);
		ActivateField(&quot;Select&quot;);
		ActivateField(&quot;Id&quot;);
		SetSearchExpr(searchSpec);	
		ExecuteQuery(ForwardBackward);
		var count = CountRecords();
		for(var i=1; i&lt;=count; i++)
			{
			SetFieldValue(&quot;Select&quot;, &quot;N&quot;);
			WriteRecord();
			//TheApplication().SetProfileAttr(&quot;SelectFlag&quot;, &quot;Y&quot;); // VHA Prashanth 310719: Incorporated the review comments
			} 
		
		}
	
		//this.InvokeMethod(&quot;RefreshBusComp&quot;);
		TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
	}
	
	}
	
	catch(e)
	{
		throw(e);
	}
	
	
	finally
	{
		sXMId = null;
		sCurrent = null;
		sBO = null;
		sCreditBC = null;
		flag = null;
		searchSpec = null;
	}
	return (ContinueOperation);
}"
