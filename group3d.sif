			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{	 
try
{
	switch (FieldName) 
	{
			case &quot;Cust Title&quot;:
			case &quot;Cust FirstName&quot;:
			case &quot;Cust LastName&quot;:
			case &quot;Cust MiddleName&quot;:
			case &quot;Cust DOB&quot;:
			case &quot;Cust EmailAddress&quot;:
			case &quot;Addr Address1&quot;:
			case &quot;Addr Address2&quot;:
			case &quot;Addr City&quot;:
			case &quot;Addr Country&quot;:
			case &quot;Addr PostalCode&quot;:
			case &quot;Addr State&quot;:
			case &quot;Addr StreetType&quot;:
				this.SetFieldValue(&quot;ContactChanged&quot;,&quot;Y&quot;);			
				break;
				
			default:
				break;
			
	}
	if(FieldName == &quot;ID Type&quot;)
	{
		if(this.GetFieldValue(&quot;ID Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;Passport&quot;))
		{
			this.SetFieldValue(&quot;Country&quot;,&quot;Australia&quot;);
		}
		this.WriteRecord();
		if(this.GetFieldValue(&quot;Driving License Card Number&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;Driving License Card Number&quot;) != null)
		{
			this.SetFieldValue(&quot;Issuer&quot;,&quot;NSW&quot;);
			this.SetFieldValue(&quot;Driving License Card Number&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Issuer&quot;,&quot;&quot;);
		}
	}
	//Added for DVS
	if (FieldName == &quot;Issuer&quot;)
	{
		
		var DLIssuer = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_DL_ISSUER&quot;,this.GetFieldValue(&quot;Issuer&quot;));
		if(DLIssuer == &quot;N&quot;)
		{
			this.SetFieldValue(&quot;DL Flag&quot;,&quot;N&quot;);
			this.SetFieldValue(&quot;Driving License Card Number&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;DL Flag&quot;,&quot;&quot;);
		}
	}
}
catch (e) 
    {
        throw (e);
    } 
finally 
    {
    }
	
}"
			   SEQUENCE="22"
			   UPDATED="08/09/2022 22:17:07"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WrapSearchExpr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WrapSearchExpr(IDType)
{
 var p = /(&apos;)/g;
 return &quot;&apos;&quot; + IDType.replace(p, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;;
}"
