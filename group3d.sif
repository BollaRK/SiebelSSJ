			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpsertIdDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpsertIdDetails() 
{
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mUpsertIdDetails&quot;);
		}
		var strError;
		// Declare variables
		var ID_NOT_FOUND = &quot;19229&quot;;
		var ID_LOCK_CD = &quot;19303&quot;;
		var ID_OVERAL_CD = &quot;19212&quot;;
		var ID_ERR_CD = &quot;19308&quot;;
		var ID_INVLD_CD = &quot;19307&quot;;
		var ID_INPRG_CD = &quot;19306&quot;;
		var ID_LOCK_CD = &quot;19303&quot;;
		var EXISCUST_PREPAY = &quot;19245&quot;;
		var sIdType = this.GetFieldValue(&quot;ID Type&quot;);
		var sTBUISessionId = this.GetFieldValue(&quot;TBUI Session Id&quot;);
		var oActiveObj = TheApplication().ActiveBusObject();
		var oContactId = oActiveObj.GetBusComp(&quot;VF Contact Id&quot;);
		var sDVSStatus;
		var sDVSStatusMsg;
		var sDVSTransId;
		var sDVSOverAllSts;
		var sActivityId;
		var sOverAllCnt = this.GetFieldValue(&quot;VF Max ID Limit&quot;);
	//	var sExistingCustCnt = this.GetFieldValue(&quot;VF Max EC ID Limit&quot;);
		var Outputs = TheApplication().NewPropertySet();
		var sPassport = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;Passport&quot;);
		var sDL = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;Driver&apos;s Licence&quot;);
		var sVisa = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_ID_TYPE&quot;,&quot;VISA&quot;);
		
		/*var sCustTBC = this.BusObject().GetBusComp(&quot;VF Capture Customer Details UNISIM TBC&quot;);
		sCustTBC.ActivateField(&quot;No Of Active Services&quot;);
		var sActiveServices = sCustTBC.GetFieldValue(&quot;No Of Active Services&quot;);
		// end*/
				
		this.SetFieldValue(&quot;VF Max ID Limit&quot;, ToNumber(sOverAllCnt) + 1); //increment the Overall count for all id types		
		/*if (sIdType == &quot;Existing Customer&quot;)
		 {
			this.SetFieldValue(&quot;VF Max EC ID Limit&quot;, ToNumber(sExistingCustCnt) + 1);
			if (mGetCustomerDetails() == &quot;true&quot;)
			 {
				var sMSISDNType = this.GetFieldValue(&quot;MSISDN Type&quot;);
				if(sActiveServices &gt; 5 &amp;&amp; sMSISDNType == &quot;Prepay&quot;)
				{
					throw(&quot;VFErrorCode#:&quot; + EXISCUST_PREPAY + &quot; - Existing customer has &gt;5 active services and must enter another ID.&quot;); 
				}
				//end
				else
				{
				    TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;Y&quot;); // Bypass DVM
					oContactId.ActivateField(&quot;Activity Id&quot;);
					oContactId.NewRecord(NewAfter);
					oContactId.SetFieldValue(&quot;UNISIM Id Type&quot;, sIdType);
					oContactId.SetFieldValue(&quot;MSISDN Type&quot;, this.GetFieldValue(&quot;MSISDN Type&quot;))
					oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;MSISDN&quot;));
					sActivityId = mCreateActivity(sIdType);
					oContactId.SetFieldValue(&quot;Activity Id&quot;, sActivityId);
					oContactId.SetFieldValue(&quot;TBUI Session Id&quot;, sTBUISessionId);
					oContactId.WriteRecord();
					oContactId.SetViewMode(AllView);
					oContactId.ClearToQuery();
					oContactId.ExecuteQuery(ForwardBackward);
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;N&quot;); // Bypass DVM
					mNullifyfields();
					this.SetFieldValue(&quot;EnableIdType&quot;,&quot;Y&quot;);
				}
			} 
			else
			{	
				mEnableNewId();
				throw(&quot;VFErrorCode#: &quot; + ID_NOT_FOUND + &quot; Valid Id details Not found.&quot;);
			}				
		} */
		if (sIdType != &quot;&quot;) 
		{
			mDVSCall(Outputs);
			sDVSStatus = Outputs.GetProperty(&quot;DVSStatus&quot;);
			sDVSStatusMsg = Outputs.GetProperty(&quot;DVSStatusMsg&quot;);
			sDVSTransId = Outputs.GetProperty(&quot;DVSTransId&quot;);
			sDVSOverAllSts = Outputs.GetProperty(&quot;DVSOverAllSts&quot;);

			if (sDVSOverAllSts != &quot;ALL_SOURCES_LOCKED_OUT&quot;) 
			{
				switch (sDVSStatus) 
				{
				case &quot;VALID&quot;:
				case &quot;DVSDisabled&quot;:
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;Y&quot;); // Bypass DVM
					oContactId.NewRecord(NewAfter);
					switch (sIdType)
					{
					case sPassport:
						oContactId.SetFieldValue(&quot;UNISIM Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;VF Visa Country of Issue&quot;, this.GetFieldValue(&quot;Country&quot;));
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
						oContactId.SetFieldValue(&quot;VHA Kogan Channel Type&quot;, this.GetFieldValue(&quot;Channel Type&quot;));
						break;
					/*case &quot;Medicare Card&quot;:
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;Medicare Reference Number&quot;, this.GetFieldValue(&quot;Medicare Card Number&quot;));
						oContactId.SetFieldValue(&quot;Card Color&quot;, this.GetFieldValue(&quot;Card Color&quot;));						
						oContactId.SetFieldValue(&quot;VF Medicare Expiry Date&quot;, this.GetFieldValue(&quot;Medicare Expiry Date&quot;));						
						break;*/
					case sVisa:
						oContactId.SetFieldValue(&quot;UNISIM Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
						oContactId.SetFieldValue(&quot;VF Visa Country of Issue&quot;, this.GetFieldValue(&quot;Country Visa&quot;));
						//oContactId.SetFieldValue(&quot;VF UNISIM Category&quot;, &quot;A&quot;);
						oContactId.SetFieldValue(&quot;Id Points&quot;, &quot;100&quot;);
						oContactId.SetFieldValue(&quot;VHA Kogan Channel Type&quot;, this.GetFieldValue(&quot;Channel Type&quot;));
						break;
					case sDL:
						oContactId.SetFieldValue(&quot;Id Type&quot;, sIdType);
						oContactId.SetFieldValue(&quot;State of Issue&quot;, this.GetFieldValue(&quot;Issuer&quot;));
						oContactId.SetFieldValue(&quot;Expiry Date&quot;, this.GetFieldValue(&quot;Expiry Date&quot;));
						oContactId.SetFieldValue(&quot;VHA Kogan Channel Type&quot;, this.GetFieldValue(&quot;Channel Type&quot;));
						break;
					default:
						break;
					}
					oContactId.SetFieldValue(&quot;Id Reference Number&quot;, this.GetFieldValue(&quot;Reference Number&quot;));
					oContactId.SetFieldValue(&quot;Driving License Card Number&quot;, this.GetFieldValue(&quot;Driving License Card Number&quot;));
					oContactId.SetFieldValue(&quot;Date Of Birth&quot;, this.GetFieldValue(&quot;DOB&quot;));					
					if (sDVSStatus == &quot;VALID&quot;) 
					{
					/*	var oTBC = this.BusObject().GetBusComp(&quot;VF Capture Customer Details UNISIM TBC&quot;);
						oTBC.ActivateField(&quot;ValidIdPresent&quot;);
						oTBC.SetFieldValue(&quot;ValidIdPresent&quot;, &quot;Y&quot;);*/
						this.SetFieldValue(&quot;EnableAdd&quot;, &quot;FALSE&quot;);
						this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;Y&quot;);
					//	TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;N&quot;);
						sActivityId = mCreateActivity(sIdType);
						oContactId.SetFieldValue(&quot;Activity Id&quot;, sActivityId);
					}					
					oContactId.SetFieldValue(&quot;DVS Transaction Id&quot;, sDVSTransId);
					oContactId.SetFieldValue(&quot;TBUI Session Id&quot;, sTBUISessionId);
					oContactId.WriteRecord();
					oContactId.SetViewMode(AllView);
					oContactId.ClearToQuery();
					oContactId.ExecuteQuery(ForwardBackward);
					TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;N&quot;);					
					mNullifyfields();
					break;

				case &quot;LOCKED_OUT&quot;:
					switch (sIdType) 
					{
					case sPassport:
						this.SetFieldValue(&quot;VF Passport Lock&quot;, &quot;Y&quot;);
						break;
					/*case &quot;Medicare Card&quot;:
						this.SetFieldValue(&quot;VF MC Lock&quot;, &quot;Y&quot;);
						break;*/
					case sVisa:
						this.SetFieldValue(&quot;VF VISA Lock&quot;, &quot;Y&quot;);
						break;
					case sDL:
						this.SetFieldValue(&quot;VF DL Lock&quot;, &quot;Y&quot;);
						break;
					default:
						break;
					}
					mEnableNewId();
					throw(&quot;VFErrorCode#: &quot; + ID_LOCK_CD + &quot; - Id type has been Lockout in DVS.&quot;);
					break;

				case &quot;IN_PROGRESS&quot;:
					this.SetFieldValue(&quot;DVS Trans Id&quot;, sDVSTransId);
					mEnableNewId();
					throw(&quot;VFErrorCode#: &quot; + ID_INPRG_CD + &quot; DVS validation failed. Proceed with different ID type.&quot;);
					break;

				case &quot;INVALID&quot;:
					this.SetFieldValue(&quot;DVS Trans Id&quot;, sDVSTransId);
					mEnableNewId();
					// var ID_INVLD_CD = &quot;19307&quot; - DVS validation failed. Enter the valid data.
					throw(&quot;VFErrorCode#: &quot; + ID_INVLD_CD + &quot; DVS validation failed. Enter the valid data.&quot;);
					break;

				case &quot;Error&quot;:
					mEnableNewId();
					throw(&quot;VFErrorCode#: &quot; + ID_ERR_CD + &quot; Error in the DVS interface.&quot;);
					break;

				default:
					break;
				}
				if(sDVSStatus == &quot;VALID&quot; || sDVSStatus == &quot;DVSDisabled&quot;)
				{
					this.SetFieldValue(&quot;EnableIdType&quot;,&quot;Y&quot;);
				} 
			} 
			else 
			{
				this.SetFieldValue(&quot;IsDVSCalled&quot;, &quot;N&quot;);
				//TheApplication().SetProfileAttr(&quot;EnableNewUSIM&quot;, &quot;Y&quot;);
				this.SetFieldValue(&quot;VF Overall Lock&quot;, &quot;Y&quot;);
				throw(&quot;VFErrorCode#: &quot; + ID_OVERAL_CD + &quot; Maximum attempts has been reached to validate Id details with DVS.&quot;);
			}
		}		
	} 
	catch (e)
	{
		TheApplication().SetProfileAttr(&quot;InsertFromScript&quot;, &quot;N&quot;); // Bypass DVM
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		
		oContactId = null;
		oActiveObj = null;
		Outputs = null;		/* This variable is nullified by Sharukh on 02/04/2019*/


		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VHA Kogan Capture Id Details TBC.mUpsertIdDetails&quot;);
		}
	}
}"
			   SEQUENCE="15"
