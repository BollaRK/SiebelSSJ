			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetCustomerDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetCustomerDetails() 
{
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mGetCustomerDetails&quot;);
		}
		var strError;
		// Declare variables

		var sMSISDN;
		var sAssetId;
		var sStatus;
		var sMSISDNType;
		var sAccountId;
		var sContactId, sPIN, sAssetPIN,sAccountPIN;
		var ConSearchSpec;
		var US_MSISDN_IA = &quot;19227&quot;;
		var US_MSISDN_NF = &quot;19248&quot;;
		var US_CON_NOTFOUND = &quot;19228&quot;;
		var US_ACC_NOTFOUND = &quot;19249&quot;;
		var US_PIN_NOTVALID = &quot;19255&quot;;
		var sIdType ,isRec;
		var ID_ERR_MSG = &quot;19229&quot;;
		var out = &quot;true&quot;;
		
		sMSISDN = this.GetFieldValue(&quot;MSISDN&quot;);
		sPIN = this.GetFieldValue(&quot;PIN&quot;);
		var MSISDNBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var MSISDNBC = MSISDNBO.GetBusComp(&quot;VF Resource Mgmt - MSISDN Relationship&quot;);
		with (MSISDNBC) 
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Asset Number&quot;);
			ActivateField(&quot;Status&quot;);
			ActivateField(&quot;Asset Id&quot;);
			ActivateField(&quot;Parent Asset Id&quot;);
			SetSearchSpec(&quot;Asset Number&quot;, sMSISDN);
			ExecuteQuery(ForwardOnly);
			var IsRecFound = FirstRecord();
			var ValidRecPresent = &quot;&quot;;
			var count = 0;
			while(IsRecFound)
			{
				count++;
				sStatus = GetFieldValue(&quot;Status&quot;);
				if (sStatus == &quot;Inactive&quot; || sStatus == &quot;Ported Out&quot;) 
				{
  					if(ValidRecPresent == &quot;true&quot;)
  					{
  					}
  					else
  					{
					ValidRecPresent = &quot;false&quot;;
					}
				}
				else
				{
			    	ValidRecPresent = &quot;true&quot;;
			    	sAssetId = GetFieldValue(&quot;Parent Asset Id&quot;);
				}
			IsRecFound = NextRecord();	
		
			}
			if(count &gt; 0 &amp;&amp; ValidRecPresent == &quot;false&quot;)
			{
					mEnableNewId();		
					throw(&quot;VFError#: &quot;+US_MSISDN_IA+&quot; MSISDN is Inactive.&quot;);
			}
			else if(count == 0)
			{	
				mEnableNewId();			
				throw(&quot;VFError#: &quot;+US_MSISDN_NF+&quot; MSISDN not found.&quot;);
			}
		} //with MSISDN BC

		var sAssetBC = MSISDNBO.GetBusComp(&quot;Asset Mgmt - Asset - Header Simple&quot;);
		with (sAssetBC) 
		{
			SetViewMode(AllView);
			ActivateField(&quot;Service Account Id&quot;);
			ActivateField(&quot;Account Primary Contact Id&quot;);
			ActivateField(&quot;Payment Method&quot;);
			ActivateField(&quot;Service PIN&quot;);
			ActivateField(&quot;Status&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sAssetId);
			ExecuteQuery(ForwardBackward);
			if (FirstRecord()) 
			{
				sAccountId = GetFieldValue(&quot;Service Account Id&quot;);
				sContactId = GetFieldValue(&quot;Account Primary Contact Id&quot;);
				sAssetPIN = GetFieldValue(&quot;Service PIN&quot;);
				this.SetFieldValue(&quot;MSISDN Type&quot;, GetFieldValue(&quot;Payment Method&quot;));
				if (sAccountId == &quot;&quot; || sAccountId == null || sAccountId == &quot;No Match Row Id&quot;) 
				{
					mEnableNewId();
					throw(&quot;VFError#: &quot;+US_ACC_NOTFOUND+&quot; Customer Account not found.&quot;);
				}
				if ((sContactId == &quot;No Match Row Id&quot;) || (sContactId == &quot;&quot;)) 
				{
					mEnableNewId();
					throw(&quot;VFError#: &quot;+US_CON_NOTFOUND+&quot; Contact not found.&quot;);
				}
			}
		} //with (sAssetBC)
		var sAccountBC = MSISDNBO.GetBusComp(&quot;Account&quot;); 
		with (sAccountBC) 
		{
			SetViewMode(AllView);
			ActivateField(&quot;Password&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
				sAccountPIN = GetFieldValue(&quot;Password&quot;);
			}
			if(sPIN != sAccountPIN)
			{
				mEnableNewId();
				throw(&quot;VFError#: &quot;+US_PIN_NOTVALID+&quot; MSISDN and PIN combination is invalid.&quot;);	
			}
			
		}
		var ConIDBO = TheApplication().GetBusObject(&quot;VF Contact Id&quot;);
		var ConIDBC = ConIDBO.GetBusComp(&quot;VF Contact Id&quot;);
		with (ConIDBC) {
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Contact Id&quot;);
			ActivateField(&quot;VF Primary&quot;);
			ConSearchSpec = &quot;[Contact Id] = &apos;&quot; + sContactId + &quot;&apos;&quot;;
			SetSearchExpr(ConSearchSpec);
			ExecuteQuery(ForwardOnly);
			isRec = FirstRecord();
			if(!isRec)
			{
				out = &quot;false&quot;; 				
			}
			while(isRec)
			{
				sIdType	= GetFieldValue(&quot;Id Type&quot;);
				if(sIdType == &quot;Not Validated&quot;)
				{
					out = &quot;false&quot;;					
				}
				isRec = NextRecord();
			}			
		}
		return(out);
	} 
	catch (e) 
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally 
	{
		// Destroy Objects
		sAccountBC = null; /* This variable is nullified by Sharukh on 02/04/2019*/
		MSISDNBO = null;
		MSISDNBC = null;
		sAssetBC = null;
		ConIDBO = null;
		ConIDBC = null;
		


		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END:VHA Kogan Capture Id Details TBC.mGetCustomerDetails&quot;);
		}
	}
} // Main fn"
			   SEQUENCE="10"
			   UPDATED="04/12/2019 14:15:56"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSysPref"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSysPref(Name)
{
	try
	{
		var sSysprefbs = TheApplication().GetService(&quot;PRM ANI Utility Service&quot;);
		var ins = TheApplication().NewPropertySet();
		var outs = TheApplication().NewPropertySet();
		
		ins.SetProperty(&quot;System Preference Name&quot;, Name);
		sSysprefbs.InvokeMethod(&quot;GetSystemPreference&quot;, ins, outs);
		return(outs.GetProperty(&quot;System Preference Value&quot;));
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sSysprefbs = null;
		/*Below variables are nullified by Sharukh on 02/04/2019*/
		ins = null;
		outs = null;

	}
}"
			   SEQUENCE="11"
			   UPDATED="04/12/2019 14:15:56"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSystemPreference"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSystemPreference (sSysPrefName)
{
	try
	{	
		var bcSysPref;
		var boSysPref;
		var sSysPrefValue;
		
		boSysPref = TheApplication().GetBusObject(&quot;System Preferences&quot;);
		bcSysPref = boSysPref.GetBusComp(&quot;System Preferences&quot;);
		bcSysPref.SetViewMode(AllView);
		bcSysPref.ActivateField(&quot;Name&quot;);
		bcSysPref.ActivateField(&quot;Value&quot;);
		bcSysPref.ClearToQuery();
		bcSysPref.SetSearchSpec(&quot;Name&quot;, sSysPrefName);
		bcSysPref.ExecuteQuery(ForwardOnly);		
		if(bcSysPref.FirstRecord())
		{
			sSysPrefValue = bcSysPref.GetFieldValue(&quot;Value&quot;);
		}
		return(sSysPrefValue);
	}
	catch(e)
	{	
		throw(e);
	}
	finally
	{
		bcSysPref = null;
		boSysPref = null;	
	}
}"
			   SEQUENCE="12"
			   UPDATED="03/27/2018 15:56:09"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mNullifyfields"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mNullifyfields()
{	
	try
	{

	//Set Fields to Null	
//	this.SetFieldValue(&quot;Card Color&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Country&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;DOB&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Expiry Date&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Gender&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;ID Type&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Issuer&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;MSISDN&quot;, &quot;&quot;);
//	this.SetFieldValue(&quot;Medicare Card Number&quot;, &quot;&quot;);
//	this.SetFieldValue(&quot;Medicare Reference Number&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;PIN&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Passport Number&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Person Name&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
	//this.SetFieldValue(&quot;Medicare Expiry Date&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Country Visa&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;Country Code&quot;, &quot;&quot;);
/*	if(this.GetFieldValue(&quot;DVS Override Flag&quot;) == &quot;Y&quot;)
	{
		this.SetFieldValue(&quot;DVS Override Flag&quot;, &quot;N&quot;);
	}*/
	this.SetFieldValue(&quot;Reference Number&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;DVS Trans Id&quot;, &quot;&quot;);
	this.SetFieldValue(&quot;MSISDN Type&quot;, &quot;&quot;);
	
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{

	}

}"
