			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateActivity(sIdType) {
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mCreateActivity&quot;);
		}
		var strError;
		// Declare variables
		var sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
		var FailAttempt = &quot;Failures: &quot;;
		var sTBUISessionId = this.GetFieldValue(&quot;TBUI Session Id&quot;);
		var fIdType = &quot;&quot;;
		var fFailCount,
		isRec;
		var sDescription;


		sDescription = &quot;Success: &quot; + sIdType + &quot;;&quot; + sTBUISessionId;
		//Create Activity
		var sType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;TODO_TYPE&quot;, &quot;Kogan ID Validation&quot;);
	//	var svcActivities = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);  //Sachi - 25thOct2019 - Commented and added below line for SBL UPG Activity Framework
		var svcActivities = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var psActivityInp = TheApplication().NewPropertySet();
		var psActivityOut = TheApplication().NewPropertySet();
		psActivityInp.SetProperty(&quot;ProcessName&quot;, &quot;VF Generate Activity General&quot;);  //Sachi - 25thOct2019 - added as part of SBL UPG Activity Framework
		psActivityInp.SetProperty(&quot;Account Object Id&quot;, sAccountId);
		psActivityInp.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);
		psActivityInp.SetProperty(&quot;Type&quot;, sType);
		psActivityInp.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
		psActivityInp.SetProperty(&quot;Description&quot;, sDescription);
		psActivityInp.SetProperty(&quot;Comment&quot;, sDescription);
	//	svcActivities.InvokeMethod(&quot;GenerateActivity&quot;, psActivityInp, psActivityOut);  //Sachi - 25thOct2019 - Commented and added below line for SBL UPG Activity Framework
		svcActivities.InvokeMethod(&quot;RunProcess&quot;, psActivityInp, psActivityOut);
		var sActivityId = psActivityOut.GetProperty(&quot;Activity Id&quot;);

		return (sActivityId);
	} catch (e) {
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		svcActivities = null;

		/*Below variables are nullified by Sharukh on 02/04/2019*/
		psActivityInp = null;
		psActivityOut = null;


		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VHA Kogan Capture Id Details TBC.mCreateActivity&quot;);
		}
	}
}"
