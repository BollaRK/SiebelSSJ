			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mBlacklistIDCheck"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mBlacklistIDCheck() {
	try {
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START:VHA Kogan Capture Id Details TBC.mBlacklistIDCheck&quot;);
		}
		var strError;
		// Declare variables
		var BLC_LST_TBUI = &quot;19211&quot;;
		var INV_ID_NUM = &quot;19210&quot;;
		var IDType;
		var IDNumber;
		var SplChar;
		var CustType;
		var StartDate;
		var EndDate;
		var Name;
		var SearchExpr;
		var SearchExpr1;
		var IDCount;
		var j = 0;
		var MessageId = &quot;&quot;;
		var Error = &quot;Y&quot;;
		var strInvalidErrorMsg = &quot;VFErrorCode#: &quot; + INV_ID_NUM + &quot; Invalid Id Number&quot;;
		// Get Interface Paramaters

		CustType = this.GetFieldValue(&quot;Customer Type&quot;);
		IDType = this.GetFieldValue(&quot;ID Type&quot;);
		IDNumber = this.GetFieldValue(&quot;Reference Number&quot;);

		//To check ID Number is Alphanumeric
		var BlacklistBO = TheApplication().GetBusObject(&quot;VF UNISIM BlacklistID BO&quot;);
		var BlacklistBC = BlacklistBO.GetBusComp(&quot;VF UNISIM BlacklistID BC&quot;);
		BlacklistBC.ActivateField(&quot;VF ID Type&quot;);
		BlacklistBC.ActivateField(&quot;VF ID Number&quot;);
		BlacklistBC.SetViewMode(AllView);
		BlacklistBC.ClearToQuery();
		BlacklistBC.SetSearchSpec(&quot;VF ID Type&quot;, &quot;Generic Rules&quot;);
		BlacklistBC.SetSearchSpec(&quot;VF Rule Type&quot;, &quot;Special Characters&quot;);
		BlacklistBC.ExecuteQuery(ForwardOnly);

		if (BlacklistBC.FirstRecord()) {
			SplChar = BlacklistBC.GetFieldValue(&quot;VF ID Number&quot;);
		}

		var l = IDNumber.length;
		var rStrspn = Clib.strspn(IDNumber, &quot;0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdfeghijklmnopqrstuvwxyz&quot; + SplChar);
		var rStrspnA = rStrspn;
		
		//&quot;Only characters 0-9, A-Z are allowed. Change character:&quot; + rStrspnA;
		//if all characters in string does not match the character set, validation failed
		if (rStrspnA != l) {
			throw(strInvalidErrorMsg)
		}
	//Roseline 20/07/2015 - Changed search spec for defect# 583
	SearchExpr1 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + IDNumber + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
	//SearchExpr1 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + IDNumber + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
	
		var RecFlag = &quot;&quot;;
		var strErrorMessage = &quot;VFErrorCode#: &quot; + BLC_LST_TBUI + &quot; Id is Blacklisted&quot;;
		BlacklistBC.ActivateField(&quot;VF Start Date&quot;);
		BlacklistBC.ActivateField(&quot;VF End Date&quot;);
		BlacklistBC.ActivateField(&quot;VF Active Flg&quot;);
		BlacklistBC.ActivateField(&quot;VF Current Date&quot;);
		BlacklistBC.SetViewMode(AllView);
		BlacklistBC.ClearToQuery();
		BlacklistBC.SetSearchExpr(SearchExpr1);
		BlacklistBC.ExecuteQuery(ForwardBackward);

		if (BlacklistBC.FirstRecord()) {
			//Check for valid start and end date
			StartDate = BlacklistBC.GetFieldValue(&quot;VF Start Date&quot;);
			EndDate = BlacklistBC.GetFieldValue(&quot;VF End Date&quot;);

			if (StartDate == &quot;&quot; &amp;&amp; EndDate == &quot;&quot;) {
				throw(strErrorMessage);
			} //if date check

			if (StartDate != &quot;&quot; || EndDate != &quot;&quot;) {
				//Today for comparison
				var CurrentDate = new Date;
				var DD = CurrentDate.getDate();
				var MM = CurrentDate.getMonth() + 1;
				var YYYY = CurrentDate.getFullYear();
				var sHRS = CurrentDate.getHours();
				var sMIN = CurrentDate.getMinutes();
				var sSEC = CurrentDate.getSeconds();
				var today = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY) + &quot; &quot; + sHRS + &quot;:&quot; + sMIN + &quot;:&quot; + sSEC;
				var newdate = new Date(today);
				var startdate = new Date(StartDate);
				var enddate = new Date(EndDate);

				if (startdate != &quot;&quot;) {
					if (startdate &gt;= newdate) {
						Error = &quot;N&quot;;
					}
				}

				if (enddate != &quot;&quot;) {
					if (enddate &lt;= newdate) {
						Error = &quot;N&quot;;
					}
				}

				if (Error != &quot;N&quot;) {
					throw(strErrorMessage);
				}
			} // if date check
		} //first record
		else {
			//Checking Blacklist Table for repeating digits
			var counter = &quot;1&quot;;
			var sCounter1=&quot;1&quot;;
			var IDlength =  IDNumber.length;
			var sCheckLength = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_BLACKLISTID_CHECKLEN&quot;,&quot;CheckLength&quot;);
			
			if (IDlength &gt; sCheckLength)
			{
				for (var i = 0; i &lt; IDlength; i++) 
				{
					/**** To Blacklist/Block consecutive 
						numbers like 123456...etc******/
					if (IDNumber.charCodeAt(i) &lt; IDNumber.charCodeAt(i+1))
					{
						if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i + 1) - 1 )
						{
							counter++;
						}
					}
					/**** To Blacklist/Block  Consecutive 
					numbers in reverse like 7654321/8765432...etc******/
					if (IDNumber.charCodeAt(i) &gt; IDNumber.charCodeAt(i+1))
					{
						if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i + 1) + 1)
						{
							counter++; 
						}
					}
					if (IDNumber.charCodeAt(i) == IDNumber.charCodeAt(i+1))
					{
						sCounter1++;
					}			
				}
			
				if (IDlength == counter || IDlength == sCounter1)
				{
					throw(strInvalidErrorMsg);
				}
		
			} // End of if (IDlength &gt; sCheckLength)

			//Checking for Blacklist Table for ID Number Series
			var IDNumlen = IDNumber.length;
			var IDArray = new Array();
			var ArrayIDLen;
			var k = 0;
			var isRecord;
			BlacklistBC.SetViewMode(AllView);
			BlacklistBC.ActivateField(&quot;VF Black Series Flag&quot;);
			BlacklistBC.ActivateField(&quot;VF ID Type&quot;);
			BlacklistBC.ActivateField(&quot;VF Customer Type&quot;);
			BlacklistBC.ActivateField(&quot;VF Active Flg&quot;);
		//	BlacklistBC.ActivateField(&quot;Version Status&quot;);
			BlacklistBC.ClearToQuery();
			var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF Black Series Flag] = &apos;Y&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
			//var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF Black Series Flag] = &apos;Y&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
			BlacklistBC.SetSearchExpr(searchexpr2);
			BlacklistBC.ExecuteQuery(ForwardOnly);

			isRecord = BlacklistBC.FirstRecord();

			//var len = BlacklistBC.CountRecords();
			while (isRecord) {
				IDArray[k] = BlacklistBC.GetFieldValue(&quot;VF ID Number&quot;);
				k++;
				isRecord = BlacklistBC.NextRecord();
			}
			
			// Below logic reduces the IDNumber length and do query in Blacklist Table
			for (var j = 0; j &lt; IDArray.length; j++) {
				
				ArrayIDLen = IDArray[j].length;
				var TrimArrIDLen = ArrayIDLen - 1;
				var ArrayIDNumVal = IDArray[j].substring(0, ArrayIDLen - 1);
				var TrimIDNum;
				if (IDNumlen == TrimArrIDLen) {
					
					TrimIDNum = IDNumber;
				}
				if (IDNumlen &gt; TrimArrIDLen) {
					
					TrimIDNum = IDNumber.substring(0, ArrayIDLen - 1);
				}
				if (TrimIDNum == ArrayIDNumVal) {
					
					BlacklistBC.SetViewMode(AllView);
					BlacklistBC.ClearToQuery();
					var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + TrimIDNum + &quot;*&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos;&quot;;
				//	var searchexpr2 = &quot;[VF ID Type] = &quot; + WrapSearchExpr(IDType) + &quot; AND [VF ID Number] = &apos;&quot; + TrimIDNum + &quot;*&apos; AND [VF Customer Type] = &apos;&quot; + CustType + &quot;&apos; AND [VF Active Flg] = &apos;Y&apos; AND [Version Status] = &apos;Activated&apos;&quot;;
					BlacklistBC.SetSearchExpr(searchexpr2);
					BlacklistBC.ExecuteQuery(ForwardOnly);
					
					var numcnt = BlacklistBC.CountRecords();
					if (numcnt &gt; 0) {
						//check for valid start and end date
						StartDate = BlacklistBC.GetFieldValue(&quot;VF Start Date&quot;);
						EndDate = BlacklistBC.GetFieldValue(&quot;VF End Date&quot;);
						
						if (StartDate == &quot;&quot; &amp;&amp; EndDate == &quot;&quot;) {
							throw(strErrorMessage);
						} //if date check
						if (StartDate != &quot;&quot; || EndDate != &quot;&quot;) {
							//Today for comparison
							var CurrentDate = new Date;
							var DD = CurrentDate.getDate();
							var MM = CurrentDate.getMonth() + 1;
							var YYYY = CurrentDate.getFullYear();
							var sHRS = CurrentDate.getHours();
							var sMIN = CurrentDate.getMinutes();
							var sSEC = CurrentDate.getSeconds();
							var today = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY) + &quot; &quot; + sHRS + &quot;:&quot; + sMIN + &quot;:&quot; + sSEC;
							var newdate = new Date(today);
							startdate = new Date(StartDate);
							enddate = new Date(EndDate);
							if (startdate != &quot;&quot;) {
								if (startdate &gt;= newdate) {
									Error = &quot;N&quot;;
								}
							}
							if (enddate != &quot;&quot;) {
								if (enddate &lt;= newdate) {
									Error = &quot;N&quot;;
								}
							}
							
							if (Error != &quot;N&quot;) {
								throw(strErrorMessage);
							}
						} //if date check
					} //if numcnt
				} //if Trimval comparison
			} //for
		} //else
	} catch (e) {	
		TheApplication().RaiseErrorText(e.toString());
	}
	finally {
		// Destroy Objects
		BlacklistBO = null;
		BlacklistBC = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;END:VHA Kogan Capture Id Details TBC.mBlacklistIDCheck&quot;);
		}
	}
} // Main fn"
			   SEQUENCE="1"
			   UPDATED="03/27/2018 15:56:09"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:56:09"
			   CREATED_BY="SADMIN">
