			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mFieldValidations"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mFieldValidations()
{
	try
	{
	var IdType = this.GetFieldValue(&quot;ID Type&quot;);	
	//var sMedicareNumber = this.GetFieldValue(&quot;Medicare Card Number&quot;);
	//var sReferenceNum = this.GetFieldValue(&quot;Passport Number&quot;);
	var sReferenceNum = this.GetFieldValue(&quot;Reference Number&quot;);
	var str = &quot;&quot;;
	var sAlphaNumPattern = /[^0-9A-Z]/g;
	var sNumPattern = /[^0-9]/g;
	var sNum =  /[0-9]/g;
	var sAlphaPattern = /[^A-Z]/g;
	var sAlpha = /[A-Z]/g;
    var sLowercaseAlpha	= /[a-z]/g
	var sAUAlphaPP1 = sReferenceNum.substring(0,1);
	var sAUNumPP1 = sReferenceNum.substring(1,8);
    //var sAUNumPP2 = sReferenceNum.substring(2,9);
	var sAUAlphaPP2 = sReferenceNum.substring(0,2);
	var sAUNumPP2 = sReferenceNum.substring(2,9);
    var sCountry = this.GetFieldValue(&quot;Country&quot;); // balajim added for Rel19.4 change cam on 31Oct2019
	var sMediNumb = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_MEDICARD_RESTRICT_PREFIX&quot;, sAUAlphaPP1); //balajiM added for Rel19.4 - 9Oct2019
	
	
	if(IdType == &quot;Green Medicare Card&quot; || IdType == &quot;Interim Medicare Card&quot; || IdType == &quot;Reciprocal Medicare Card&quot;)
	{
        //balajiM added for Rel19.4 - 9Oct2010
           if(sMediNumb == &quot;Y&quot;)
           {
               TheApplication().RaiseErrorText (&quot;VFErrorCode#19670: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19670&quot;));
           }//balajiM added for Rel19.4 - 9Oct2010
		if((sReferenceNum != &quot;&quot; &amp;&amp; sReferenceNum != null) &amp;&amp; (sReferenceNum.match(sNumPattern) || sReferenceNum.length != 10))
		{
		   TheApplication().RaiseErrorText (&quot;VFErrorCode#19258: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19258&quot;));
		}
	}
    //for australia passport
	if(sReferenceNum != null &amp;&amp; sReferenceNum != &quot;&quot; &amp;&amp; IdType == &quot;Passport&quot; &amp;&amp; sCountry == &quot;Australia&quot;)
	{
		if(sAUAlphaPP2.match(sAlphaPattern))// || sReferenceNum.length != 7 ||sAUNumPP.match(sNumPattern))
		{
			
			if(sAUAlphaPP1.match(sAlphaPattern) || sReferenceNum.length != 8 ||sAUNumPP1.match(sNumPattern))
			{
				if(sAUAlphaPP1.match(sAlphaPattern) || sReferenceNum.length != 9 || sAUNumPP2.match(sNumPattern))//added by balajiM for defect Rel19.4 SIT Defect 93
				{
				TheApplication().RaiseErrorText (&quot;VFErrorCode#19255: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19255&quot;));
				}
			}		
		}
		else
		{
			if(sAUAlphaPP2.match(sAlphaPattern) || sReferenceNum.length != 9 || sAUNumPP2.match(sNumPattern))
			{
				TheApplication().RaiseErrorText (&quot;VFErrorCode#19255: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19255&quot;));
			}
		}	
		
	}
    // for international Passport
    if(sReferenceNum != null &amp;&amp; sReferenceNum != &quot;&quot; &amp;&amp; IdType == &quot;Passport&quot; &amp;&amp; sCountry != &quot;Australia&quot;)
	{
		if(sReferenceNum.match(sAlphaNumPattern) || sReferenceNum.length &gt; 14)
		{
               TheApplication().RaiseErrorText (&quot;VFErrorCode#19672: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19672&quot;)); 
		}	
		
	}
	if(sReferenceNum != null &amp;&amp; sReferenceNum != &quot;&quot; &amp;&amp; IdType == &quot;Driver&apos;s Licence&quot;)
	{
		//if(sReferenceNum.match(sAlpha))
		//{
			//if(sReferenceNum.match(sNum))
			//{
				if(sReferenceNum.match(sAlphaNumPattern) || sReferenceNum.length &gt; 10)
				{
                    if(sReferenceNum.match(sLowercaseAlpha))
                    {
                       TheApplication().RaiseErrorText (&quot;VFErrorCode#19671: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19671&quot;));
                    }
                    else
					//str = &quot;Incorrect Driver License Format. Should be alphanumberic with length 10&quot;;
					TheApplication().RaiseErrorText (&quot;VFErrorCode#19256: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19256&quot;));
				}
			//}
			/*else
			{
				TheApplication().RaiseErrorText (&quot;VFErrorCode#19256: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19256&quot;));
			}	
		}
		else
		{
			TheApplication().RaiseErrorText (&quot;VFErrorCode#19256: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19256&quot;));
		}*/
		
	
	}
	//balajiM added for Rel19.4 - 25Sep2019
	if(sReferenceNum != null &amp;&amp; sReferenceNum != &quot;&quot; &amp;&amp; IdType == &quot;VISA&quot;)
	{  
	  if(sReferenceNum.match(sAlphaNumPattern))
	  {
	      TheApplication().RaiseErrorText (&quot;VFErrorCode#19264: &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19264&quot;));
	  }
	     
	}//balajiM added for Rel19.4 - 25Sep2019
	if(str != null &amp;&amp; str != &quot;&quot;)
	throw(str);
	}
	catch(e)
	{
	throw(e);
	}
	finally
	{
	
	//sMedicareNumber = null;
	sReferenceNum = null;
	//sDriverLicense = null;
	str = null;
	sAlphaNumPattern = null;
	sNumPattern = null;
	sNum =  null;
	sAlphaPattern = null;
	sAlpha = null;	
	sAUAlphaPP1 = null;
	sAUNumPP1 = null;
	sAUAlphaPP2 = null;
	sAUNumPP2 = null;
	
	}
}"
