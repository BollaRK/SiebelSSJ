			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{	
	if(FieldName == &quot;Primary ID Type&quot; || FieldName == &quot;Secondary ID Type&quot; || FieldName == &quot;Offer ID Type&quot;)
	{//VHA Guruprasad : 10/07/2020 : Added for VeVo CIR
		this.SetFieldValue(&quot;VHA EnableIdTypeFields&quot;,&quot;N&quot;);
		this.SetFieldValue(&quot;VHA PPIdent&quot;,&quot;&quot;);
		if(FieldName == &quot;Primary ID Type&quot;)
		{
			this.SetFieldValue(&quot;Secondary ID Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Offer ID Type&quot;,&quot;&quot;);
		}
		if(FieldName == &quot;Secondary ID Type&quot;)
		{
			this.SetFieldValue(&quot;Primary ID Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Offer ID Type&quot;,&quot;&quot;);
		}
		if(FieldName == &quot;Offer ID Type&quot;)
		{
			this.SetFieldValue(&quot;Primary ID Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Secondary ID Type&quot;,&quot;&quot;);
		}
		this.SetFieldValue(&quot;Card Color&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Country&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;International Country&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;DOB&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Expiry Date&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Gender&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Issuer&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;MSISDN&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Medicare Card Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Medicare Reference Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;PIN&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Passport Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Person Name&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Medicare Expiry Date&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Issue Date&quot;,&quot;&quot;);
		this.SetFieldValue(&quot;Country Code&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;Country Visa&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;ID Type&quot;, FieldValue);

		if(this.GetFieldValue(&quot;DVS Override Flag&quot;) == &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;DVS Override Flag&quot;, &quot;N&quot;);
		}
		this.SetFieldValue(&quot;Reference Number&quot;, &quot;&quot;);
		this.SetFieldValue(&quot;MSISDN Type&quot;, &quot;&quot;);
		
		var FirstName = this.GetFieldValue(&quot;Cust FirstName&quot;);
		var MiddleName = this.GetFieldValue(&quot;Cust MiddleName&quot;);
		var LastName = this.GetFieldValue(&quot;Cust LastName&quot;);
		var DOB = this.GetFieldValue(&quot;Cust DOB&quot;);
		var PersonName = FirstName + &quot; &quot; + MiddleName + &quot; &quot; + LastName; ///vinodhini -Added for defect#71
		
		if (FieldValue == &quot;Driver&apos;s Licence&quot; || FieldValue == &quot;Passport&quot;)
		{  
			if(FieldValue == &quot;Passport&quot;)
				this.SetFieldValue(&quot;VHA PPIdent&quot;,&quot;PP&quot;);
			this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;DOB&quot;, &quot;&quot;);
            this.SetFieldValue(&quot;Country&quot;, &quot;Australia&quot;); //balajiM Added for Rel19.4 - 25Sep2019
		}
		else if (FieldValue == &quot;VISA&quot;)
		{  
			this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;DOB&quot;, DOB);

		}
		else if (FieldValue == &quot;Green Medicare Card&quot; || FieldValue == &quot;Interim Medicare Card&quot; || FieldValue == &quot;Reciprocal Medicare Card&quot;)
		{
			this.SetFieldValue(&quot;Person Name&quot;, &quot;&quot;);  
			this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
		}//VHA Guruprasad - 26/06/2020 - Added below code for Aug Rel - VeVo CIR
		else if (FieldValue == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_VEVO_CONTACT_ID&quot;,&quot;International Passport&quot;))
		{
			this.SetFieldValue(&quot;VHA PPIdent&quot;,&quot;IP&quot;);
			this.SetFieldValue(&quot;DOB&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Given Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Middle Name&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Surname&quot;, &quot;&quot;);
		}
        else
        {
			this.SetFieldValue(&quot;Country&quot;, &quot;Australia&quot;); //balajiM Added for Rel19.4 - 25Sep2019
		}
	if(FieldValue == &quot;Passport&quot; || FieldValue == &quot;International Passport&quot; || FieldValue == &quot;Driver&apos;s Licence&quot; || FieldValue == &quot;Proof of Age Card(Govt Issued)&quot;)
		this.SetFieldValue(&quot;VHA EnableIdTypeFields&quot;,&quot;Y&quot;);
	}	
	return (ContinueOperation);
}"
			   SEQUENCE="26"
