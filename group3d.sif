		var ContactId = sContactBC.GetFieldValue(&quot;Id&quot;);
		this.SetFieldValue(&quot;VHA IsValidated&quot;,&quot;Y&quot;);
		mCheckForDVSId(ContactId);
		
		mValidationDts();
		mUpsertIdDetails();
