		   CREATED_BY="SADMIN">
			<APPLET_LOCALE
			   APPLICATION_CODE="STD"
			   INACTIVE="N"
			   LANGUAGE_CODE="ENU"
			   NAME="ENU-STD"
			   REDO="N"
			   TITLE="Financial Profile"
			   TRANSLATE="Y"
			   UPDATED="01/09/2026 15:56:01"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:56:01"
			   CREATED_BY="SADMIN">
			</APPLET_LOCALE>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
/*
 * Component Name        : 	VF Credit Check Applet
 * Method Name           : 	WebApplet_PreCanInvokeMethod
 * Component Information : 	Method handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 16/05/2005	CY						Invoke button (methods)
 * 23/06/2005	CY						Add controls upon Withdrawal
 * 26/07/2005	RNZ						Changes for defect 
 * 3/08/2005	CY						Changes for defect #5295 
 * 12/09/2005	CY						Changes for defect #5919 
 * 04/10/2005	ZZ						Added NewRecord check, only allow creation of a new record if 
 *										there is no Financial Profile already. This fixed the bug around
 *										query, ie. if you query for a record that does not exist, Siebel
 *										will enable the new button, this is not correct, as there should be
 *										one financial profile per customer account.
 * 09/03/2010	DO						Added cases for AcceptCreditCheck, RejectCreditCheck
 *										and ResetCreditCheck.
 * 16/03/2010   DFiggis     PR351       Various modifications for VHA Credit Approval project.
 *                                        + removed some of the NZ specific stuff.
 * 20/04/2010	DO						Removed reference to this.FirstRecord() because this code
 *										is called from VF Intended Handset - ChangeRecord(). When
 *										FirstRecord is called, the Handset BC always returns to the
 *										first record and so the user cannot step off the first
 *										Handset record.
 * 18/05/2010   KPoluru		Defect#5288	  &quot;Withdraw&quot;, &quot;Accept&quot; and &quot;REject&quot; buttons disabled after credit check expiry dates
 */

	// Declare Variables
	var BusComp;
	var ContinueCancel = ContinueOperation;
	var currentId;
	var creditstatus = &quot;&quot;;
	var expirydate;
	var currentdate;
	var dExpiryDate;
	var condAccepted;
	var Status1 = &quot;New&quot;;	
	var Status2 = &quot;Failed&quot;;
	var Status3 = &quot;Pending&quot;;
	var Status4 = &quot;APPROVE&quot;;
	var Status5 = &quot;CONDAPPRVE&quot;;		
	var Status6 = &quot;WITHDRAW&quot;;
	var Status7 = &quot;DECLINE&quot;;
	var Status8 = &quot;REFERRED&quot;;	
	var Status9 = &quot;ACCEPT&quot;;	
	
	var bParBCIsActive = &quot;N&quot;;
	var parentAccountId = &quot;&quot;;
	var oAccountBO;
	var oFinProfileBC;	
	var bcParent;
	
	var sDealerCode;		
	var sDealerDesc;
	var sSalesAgentName;
	
 	try
 	{
		//VF DO 20/4/10 - 10.3 Credit Approval. Commenting out the code that uses 
		//&quot;this&quot; and will query a separate business object. 	
/*	 	BusComp = this.BusComp();
	 	
		if (BusComp.FirstRecord())
		{
			creditstatus = BusComp.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
			expirydate   = BusComp.GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);		
			condAccepted = BusComp.GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);		
		}
*/		
			 	
	 	//Does Parent BC exist and is Active
		bcParent = this.BusComp().ParentBusComp();
		if (bcParent != null)
		{
			if (bcParent.InvokeMethod(&quot;IsActive&quot;) == &quot;Y&quot;) // parent BC has a record
			{
				bParBCIsActive = &quot;Y&quot;;
			}
		}	 	
 
 		switch (MethodName)
		{
 
	 		//*********************************************
			//* New		
			//********************************************* 				
			case &quot;NewRecord&quot;:
			//	if (this.BusComp().ParentBusComp() != null)
			//	{
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;Com Financial Profile&quot;);
					with(oFinProfileBC)
					{
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
						if (FirstRecord())
						{
							CanInvoke		= &quot;FALSE&quot;;
							ContinueCancel	= CancelOperation;			
						}
						else
						{
							CanInvoke		= &quot;TRUE&quot;;
							ContinueCancel	= CancelOperation;
						}
					}
			//	}
			//	else
			//	{
			//		CanInvoke		= &quot;FALSE&quot;;
			//		ContinueCancel	= CancelOperation;
			//	}				
				break;
 	
			//*********************************************
			//* Submit		
			//********************************************* 	
			case &quot;EventMethodTriggerCreditCheck&quot;:

			//	if (bParBCIsActive == &quot;Y&quot;)
			//	{	
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
					
					oFinProfileBC.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
					
					with(oFinProfileBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
					}

					if (oFinProfileBC.FirstRecord())
					{
						creditstatus = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
						expirydate   = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);		
						condAccepted = oFinProfileBC.GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);		
					}
					
		        	if (creditstatus == Status1 || 
			        	creditstatus == Status2 ||
			        	creditstatus == Status6) 
					{
						CanInvoke		= &quot;TRUE&quot;;
						ContinueCancel	= CancelOperation;
					}
					else 
					{
						CanInvoke		= &quot;FALSE&quot;;
						ContinueCancel	= CancelOperation;
			    	}
			    
			   // }
			  //  else
			  //  {
			  //  	CanInvoke		= &quot;FALSE&quot;;
			//		ContinueCancel	= CancelOperation;
			 //   }
				break;

			//*********************************************
			//* Withdraw		
			//********************************************* 
			case &quot;EventMethodTriggerWithdrawCreditCheck&quot;:
	
			//	if (bParBCIsActive == &quot;Y&quot;)				
			//	{	
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
					
					oFinProfileBC.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
					
					with(oFinProfileBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
					}

					if (oFinProfileBC.FirstRecord())
					{
						creditstatus = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
						expirydate   = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);		
						condAccepted = oFinProfileBC.GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);		
					}

					currentdate = new Date();
	       			dExpiryDate = new Date(expirydate);
					var iCurrentDate = currentdate.getTime();
					var iExpiryDate = dExpiryDate.getTime();
					
					if (creditstatus == Status4 || 
						creditstatus == Status9 ||
	 				    (creditstatus == Status5 &amp;&amp; iExpiryDate &gt;= iCurrentDate))				            
		        	{
						CanInvoke		= &quot;TRUE&quot;;
						ContinueCancel	= CancelOperation;
					}
					else 
					{	
						CanInvoke		= &quot;FALSE&quot;;
						ContinueCancel	= CancelOperation;
	    			}
		    		
	    	//	}
		    //	else
		    //	{
		    //		CanInvoke		= &quot;FALSE&quot;;
			//		ContinueCancel	= CancelOperation;
		    //	}
		    	
				break;
		
			
			//*********************************************
			//* Accept or Reject		
			//*********************************************
			case &quot;AcceptCreditCheck&quot;:
			case &quot;RejectCreditCheck&quot;:
				
			//	if (bParBCIsActive == &quot;Y&quot;)				
			//	{	
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
					
					oFinProfileBC.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
					
					with(oFinProfileBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
					}

					if (oFinProfileBC.FirstRecord())
					{
						creditstatus = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
						expirydate   = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);		
						condAccepted = oFinProfileBC.GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);		
					}

					currentdate = new Date();
	       			dExpiryDate = new Date(expirydate);
					var iCurrentDate = currentdate.getTime();
					var iExpiryDate = dExpiryDate.getTime();
					
			        if (creditstatus == Status5 &amp;&amp; (condAccepted == &quot;&quot; || condAccepted == null) &amp;&amp; iExpiryDate &gt;= iCurrentDate)				            
	        		{
						CanInvoke		= &quot;TRUE&quot;;
						ContinueCancel	= CancelOperation;
					}
					else 
					{	
						CanInvoke		= &quot;FALSE&quot;;
						ContinueCancel	= CancelOperation;
	   				}
	   		//	}
	   			break;
			
			//*********************************************
			//* Reset	
			//*********************************************		
			case &quot;ResetCreditCheck&quot;:
			
			//	if (bParBCIsActive == &quot;Y&quot;)				
			//	{
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
					
					oFinProfileBC.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
					
					with(oFinProfileBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
					}

					if (oFinProfileBC.FirstRecord())
					{
						creditstatus = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
						expirydate   = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);		
						condAccepted = oFinProfileBC.GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);		
					}
					
	      			//If Conditional approved accept / reject must be set 
	       			if (creditstatus == Status5)
	       			{ 
	       			    currentdate = new Date();
	       			    dExpiryDate = new Date(expirydate);
						var iCurrentDate = currentdate.getTime();
						var iExpiryDate = dExpiryDate.getTime();
						
						//If within 30 day window but user has not accepted / rejected
			        	if (iExpiryDate &gt;= iCurrentDate &amp;&amp; condAccepted != &quot;&quot;)
			        	{					
							CanInvoke		= &quot;TRUE&quot;;
							ContinueCancel	= CancelOperation;
						}
						//If credit check has expired
						else if(iExpiryDate &lt; iCurrentDate)
						{
							CanInvoke		= &quot;TRUE&quot;;
							ContinueCancel	= CancelOperation;						
						}
						//Within 30 day window and user has not accepted / rejected
						else 
						{	
							CanInvoke		= &quot;FALSE&quot;;
							ContinueCancel	= CancelOperation;
		   				}	       			    
		       			    
					}
			        else if (creditstatus == Status4 ||
			                 creditstatus == Status6 ||
			        	     creditstatus == Status7 ||
			        	     creditstatus == Status9)				            
	        		{	        		
						CanInvoke		= &quot;TRUE&quot;;
						ContinueCancel	= CancelOperation;
					}
					else 
					{	
						CanInvoke		= &quot;FALSE&quot;;
						ContinueCancel	= CancelOperation;
	   				}
	   		//	}
	   			break;
	   			
	   		// HR : 04-11-2011 Added for SR 6962
			
			case &quot;SetDealership&quot;:
						
					parentAccountId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
					oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
					oFinProfileBC = oAccountBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
					
					// oFinProfileBC.ActivateField(&quot;VF Conditional Approval Accepted&quot;);
					
					with(oFinProfileBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,parentAccountId);
						ExecuteQuery();
					}

					if (oFinProfileBC.FirstRecord())
					{
					creditstatus = oFinProfileBC.GetFieldValue(&quot;VF Credit Check Status&quot;);	 
					sDealerCode   = oFinProfileBC.GetFieldValue(&quot;Dealer Code&quot;);		
					sDealerDesc = oFinProfileBC.GetFieldValue(&quot;Dealer Description&quot;);
					sSalesAgentName = oFinProfileBC.GetFieldValue(&quot;VF Sales Agent Name&quot;);	
					}
			
					if(creditstatus == Status1 &amp;&amp; ((sDealerCode == &quot;&quot; || sDealerCode == null) || (sDealerDesc == &quot;&quot; || sDealerDesc == null) || (sSalesAgentName == &quot;&quot; || sSalesAgentName == null) ))
					{
					CanInvoke		= &quot;TRUE&quot;;
					ContinueCancel	= CancelOperation;						
					}
					else 
					{	
					CanInvoke		= &quot;FALSE&quot;;
					ContinueCancel	= CancelOperation;
		   			} 
					break;	
	   			
		
			case &quot;RefreshCreditCheck&quot;:
					CanInvoke		= &quot;TRUE&quot;;
					ContinueCancel	= CancelOperation;	
					break;
					
						
						
       		default:
				ContinueCancel = ContinueOperation;
				break;
		}
	}
	
	catch (e)
	{
		var strError = e.toString();
		throw (e);
	}
	
	finally
	{
		dExpiryDate = null;
		currentdate = null;
		//BusComp = null;
		oFinProfileBC = null;
		oAccountBO = null;
		bcParent = null;
		
		return(ContinueCancel);
	}
}"
			   SEQUENCE="4"
			   UPDATED="01/09/2026 16:01:51"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:51"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
/*
 * Component Name        : 	Com Financial Profile - Credit Check Applet AU
 * Method Name           : 	WebApplet_PreInvokeMethod
 * Component Information : 	Capture of dealer code info within the Financial Profile for Credit Check
 *							
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==================================================================
 * 19/07/2008	AnoopS		Def # 8580	  Capture of dealer code info within the Financial Profile for Credit Check				  
 */
 var sContinueCheck;
	try 
	{ 	
		// Trace statement 
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;Com Financial Profile - Credit Check Applet AU.WebApplet_PreInvokeMethod.MethodName=&quot; + MethodName); 
		} 
		switch (MethodName) 
		{ 
			case &quot;EventMethodTriggerCreditCheck&quot;: 
			//Veera: 20/03/2019: Added for Credit Check Validation based on Matrix
				var bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
 				var psInputs = TheApplication().NewPropertySet();
 				var psOutputs = TheApplication().NewPropertySet(); 
    			psInputs.SetProperty(&quot;Responsibility&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_OVERRIDE_CHK&quot;,&quot;CC Override Resp&quot;));
    			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
 				var sExists = psOutputs.GetProperty(&quot;Exists&quot;);
				this.BusComp().ActivateField(&quot;Account Id&quot;);
				var AccountId = this.BusComp().GetFieldValue(&quot;Account Id&quot;);
				var strCustType = &quot;&quot;;
				var boAccount = TheApplication().GetBusObject(&quot;VF Account Thin&quot;);
				var bcAccount = boAccount.GetBusComp(&quot;VF Account Thin&quot;);

				with (bcAccount)
			 	{
					SetViewMode(AllView);
					ActivateField(&quot;Customer Type&quot;);
					ClearToQuery();
					SetSearchSpec(&quot;Id&quot;, AccountId);
					ExecuteQuery();
				}
		
				if (bcAccount.FirstRecord())
				{
					strCustType = bcAccount.GetFieldValue(&quot;Customer Type&quot;);
									
				}
				
				if ((sExists != &quot;Y&quot;) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_UPD_CUST&quot;, strCustType) == &quot;Y&quot; ))
					mCCValidation();
			//Veera: End
			if(this.BusComp().GetFieldValue(&quot;Dealer Description&quot;) == &quot;&quot;) 
			{
				sContinueCheck = CancelOperation;
				TheApplication().RaiseErrorText(&quot;Please select a Dealer before submitting the Credit Check request!&quot;); 
			}
			else
			{
				sContinueCheck = ContinueOperation;	
			} 
			break; 
			
			case &quot;ResetCreditCheck&quot;: 
			
					TheApplication().SetProfileAttr(&quot;SSJReset&quot;, &quot;Y&quot;);     
			//Veera: 20/03/2019: Added for Credit Check Validation based on Matrix
				var bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
 				var psInputs = TheApplication().NewPropertySet();
 				var psOutputs = TheApplication().NewPropertySet(); 
    			psInputs.SetProperty(&quot;Responsibility&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_OVERRIDE_CHK&quot;,&quot;CC Override Resp&quot;));
    			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
    			var sExists = psOutputs.GetProperty(&quot;Exists&quot;);
				this.BusComp().ActivateField(&quot;Account Id&quot;);
				var AccountId = this.BusComp().GetFieldValue(&quot;Account Id&quot;);
				var strCustType = &quot;&quot;;
				var boAccount = TheApplication().GetBusObject(&quot;VF Account Thin&quot;);
				var bcAccount = boAccount.GetBusComp(&quot;VF Account Thin&quot;);

				with (bcAccount)
			 	{
					SetViewMode(AllView);
					ActivateField(&quot;Customer Type&quot;);
					ClearToQuery();
					SetSearchSpec(&quot;Id&quot;, AccountId);
					ExecuteQuery();
				}
		
				if (bcAccount.FirstRecord())
				{
					strCustType = bcAccount.GetFieldValue(&quot;Customer Type&quot;);
									
				}
				
				if ((sExists != &quot;Y&quot;) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_UPD_CUST&quot;, strCustType) == &quot;Y&quot; ))
					mCCValidation_Reset();//TULASIY:09MAY2022::Created for NCC ExpDt Reset Bypass Validation 
			//Veera: End  
			break;
			
			case &quot;EventMethodTriggerWithdrawCreditCheck&quot;:   
			
				TheApplication().SetProfileAttr(&quot;SSJWithdraw&quot;, &quot;Y&quot;);  
			//Veera: 20/03/2019: Added for Credit Check Validation based on Matrix
				var bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
 				var psInputs = TheApplication().NewPropertySet();
 				var psOutputs = TheApplication().NewPropertySet(); 
    			psInputs.SetProperty(&quot;Responsibility&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_OVERRIDE_CHK&quot;,&quot;CC Override Resp&quot;));
    			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
    			var sExists = psOutputs.GetProperty(&quot;Exists&quot;);
				this.BusComp().ActivateField(&quot;Account Id&quot;);
				var AccountId = this.BusComp().GetFieldValue(&quot;Account Id&quot;);
				var strCustType = &quot;&quot;;
				var boAccount = TheApplication().GetBusObject(&quot;VF Account Thin&quot;);
				var bcAccount = boAccount.GetBusComp(&quot;VF Account Thin&quot;);

				with (bcAccount)
			 	{
					SetViewMode(AllView);
					ActivateField(&quot;Customer Type&quot;);
					ClearToQuery();
					SetSearchSpec(&quot;Id&quot;, AccountId);
					ExecuteQuery();
				}
		
				if (bcAccount.FirstRecord())
				{
					strCustType = bcAccount.GetFieldValue(&quot;Customer Type&quot;);
									
				}
				
				if ((sExists != &quot;Y&quot;) &amp;&amp; (TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CC_UPD_CUST&quot;, strCustType) == &quot;Y&quot; ))
					mCCValidation();
			//Veera: End
			break; 
			
			Default: 
			break; 
		} 
	} 
	catch(e) 
	{ 
		//*************************************
		//* Error Handling
		//*************************************
		var strErrorMsg;
		if (!defined(e.errText)) 
		{ 
		strErrorMsg = e.toString(); 
		} 
		else 
		{ 
		strErrorMsg = e.errText; 
		} 
		TheApplication().RaiseErrorText(strErrorMsg); 
	} 
	finally 
	{
	
		AccountId=null;
		boAccount=null;
		bcAccount=null;
		strCustType=null; 
		// Trace statement 
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Financial Profile - Credit Check Applet AU.WebApplet_PreInvokeMethod.MethodName=&quot; + MethodName);
		}
	} 
	return(sContinueCheck);
}"
			   SEQUENCE="5"
			   UPDATED="03/20/2026 18:53:44"
			   UPDATED_BY="KRISHNAS"
			   CREATED="01/09/2026 16:01:51"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCCValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCCValidation()
{
//Added by Veera - 20/O3/2019 - To throw error if expiry date based on Credit Check Matrix is not less than Today&apos;s date
	try
	{
		this.BusComp().ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);
		var sCCId = this.BusComp().GetFieldValue(&quot;Id&quot;);
		var sMExpDt = &quot;&quot;;
		var sExpDtTm = &quot;&quot;;
 		var sCredBO = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
 		var sCredBC = sCredBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
 		with(sCredBC)
 		{
	 		if (sCCId != null &amp;&amp; sCCId != &quot;&quot;)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);
				SetSearchSpec(&quot;Id&quot;, sCCId);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sMExpDt = GetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;); //Backend field
					sExpDtTm = GetFieldValue(&quot;VF Credit Check Expiry Date&quot;); //UI field       
				}
			}
		}

		if(this.BusComp().GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVE&quot; || this.BusComp().GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVED&quot;)
		{
			var dTdyDt = new Date();
			
			//if (sMExpDt != null &amp;&amp; sMExpDt != &quot;&quot;)
			if (sExpDtTm != null &amp;&amp; sExpDtTm != &quot;&quot;)//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
			{
				var sMExpDtComp = new Date(sExpDtTm);//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
				var myM = ToInteger(dTdyDt.getMonth()+1);
				var myD = ToInteger(dTdyDt.getDate());
				var myY = ToInteger(dTdyDt.getFullYear());
				var toM = ToInteger(sMExpDtComp.getMonth()+1);
				var toD = ToInteger(sMExpDtComp.getDate());
				var toY = ToInteger(sMExpDtComp.getFullYear());
				var sDispDate = toD + &quot;/&quot; + toM + &quot;/&quot; + toY;
				
				//var sDispDate = 	 
				
				//if((sCreditClass != &quot;&quot;&amp;&amp;sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType) &amp;&amp; (sCCModDate != null &amp;&amp; sCCModDate != &quot;&quot;))
				if ((myY &lt; toY)||((myY==toY)&amp;&amp;(myM &lt; toM))||((myY==toY)&amp;&amp;(myM==toM)&amp;&amp;(myD &lt;= toD)))
				{
					if((sMExpDtComp != &quot;&quot; &amp;&amp; sMExpDtComp != null))  
					{
						TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_CC_9121&quot;, sDispDate));	
					}
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sCredBC = null;
		sCredBO = null;
	}
}"
			   SEQUENCE="1"
			   UPDATED="01/09/2026 16:01:51"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:51"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCCValidationWR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCCValidationWR()
{
//Added by Veera - 20/O3/2019 - To throw error if expiry date based on Credit Check Matrix is not less than Today&apos;s date
	try
	{
		var sCreditClass = this.BusComp().GetFieldValue(&quot;VF Credit Class&quot;);
		var sCCId = this.BusComp().GetFieldValue(&quot;Id&quot;);
		var sExpDateSP = this.BusComp().GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);
		
		var sCCServ = TheApplication().GetService(&quot;VF SPS Credit Check Handset Service&quot;);
		var psInp1 = TheApplication().NewPropertySet();
		var psOut1 = TheApplication().NewPropertySet();
		var psInp2 = TheApplication().NewPropertySet();
		var psOut2 = TheApplication().NewPropertySet();
		
		psInp1.SetProperty(&quot;CreditId&quot;, sCCId);
		
		sCCServ.InvokeMethod(&quot;CCGetExpiryDate&quot;,psInp1, psOut1);
		
		psInp2.SetProperty(&quot;ExpiryDays&quot;, psOut1.GetProperty(&quot;ExpiryDuration&quot;));
		psInp2.SetProperty(&quot;AccID&quot;, psOut1.GetProperty(&quot;AccId&quot;));
		
		sCCServ.InvokeMethod(&quot;CCGetOrderDate&quot;, psInp2, psOut2);
		
		var dSubmitDt = new Date(psOut2.GetProperty(&quot;SubmitDate&quot;));
		var dSubmitExpiry = new Date(psOut2.GetProperty(&quot;SubmitDateAdd&quot;));
		var sDispDate = psOut2.GetProperty(&quot;DispDate&quot;);
		var dTdyDt = new Date();
		
		if (dSubmitExpiry != null &amp;&amp; dSubmitExpiry != &quot;&quot;)
		{
			var myM = ToInteger(dTdyDt.getMonth()+1);
			var myD = ToInteger(dTdyDt.getDate());
			var myY = ToInteger(dTdyDt.getFullYear());
			var toM = ToInteger(dSubmitExpiry.getMonth()+1);
			var toD = ToInteger(dSubmitExpiry.getDate());
			var toY = ToInteger(dSubmitExpiry.getFullYear());
			
			
			
			//if((sCreditClass != &quot;&quot;&amp;&amp;sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType) &amp;&amp; (sCCModDate != null &amp;&amp; sCCModDate != &quot;&quot;))
			if ((myY &lt; toY)||((myY==toY)&amp;&amp;(myM &lt; toM))||((myY==toY)&amp;&amp;(myM==toM)&amp;&amp;(myD &lt;= toD)))
			{
				var psInpUpd = TheApplication().NewPropertySet();
				var psOutUpd = TheApplication().NewPropertySet();
				
				psInpUpd.SetProperty(&quot;ExExpiryDt&quot;, sExpDateSP);
				psInpUpd.SetProperty(&quot;NewExpiryDt&quot;, dSubmitExpiry);
				psInpUpd.SetProperty(&quot;FinPropId&quot;, sCCId);
				sCCServ.InvokeMethod(&quot;CCSetExpDtWR&quot;, psInpUpd, psOutUpd);
				//TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;).InvokeMethod(&quot;RefreshCurrentApplet&quot;, TheApplication().NewPropertySet(), TheApplication().NewPropertySet());
				
				if(sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) 
				{
					TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_CC_9121&quot;, sDispDate));	
				}
				
			}
		}
			
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		psInp1 = &quot;&quot;;
		psOut1 = &quot;&quot;;
		psInp2 = &quot;&quot;;
		psOut2 = &quot;&quot;;	
		psInpUpd = &quot;&quot;;
		psOutUpd = &quot;&quot;;
	}
}"
			   SEQUENCE="3"
			   UPDATED="01/09/2026 16:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:52"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCCValidation_Reset"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCCValidation_Reset()
{
//Added by Veera - 20/O3/2019 - To throw error if expiry date based on Credit Check Matrix is not less than Today&apos;s date
	try
	{
		var sExpLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NCC_EXP_DATE&quot;, &quot;NCCEXPDATE&quot;);//TULASIY:05MAY2022::NCC Expiry Date Bypass Validation 		
		var sCreditClass;//TULASIY:05MAY2022::NCC Expiry Date Bypass Validation 		
		this.BusComp().ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);
		var sCCId = this.BusComp().GetFieldValue(&quot;Id&quot;);
		var sMExpDt = &quot;&quot;;
		var sExpDtTm = &quot;&quot;;
 		var sCredBO = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
 		var sCredBC = sCredBO.GetBusComp(&quot;VF Com Financial Profile&quot;);
 		with(sCredBC)
 		{
	 		if (sCCId != null &amp;&amp; sCCId != &quot;&quot;)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);
				ActivateField(&quot;VF Credit Class&quot;);//TULASIY:05MAY2022::NCC Expiry Date Bypass Validation
				SetSearchSpec(&quot;Id&quot;, sCCId);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sMExpDt = GetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;); //Backend field
					sExpDtTm = GetFieldValue(&quot;VF Credit Check Expiry Date&quot;); //UI field 
					sCreditClass = GetFieldValue(&quot;VF Credit Class&quot;);//TULASIY:05MAY2022::NCC Expiry Date Bypass Validation      
				}
			}
		}

		if(this.BusComp().GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVE&quot; || this.BusComp().GetFieldValue(&quot;VF Credit Check Status&quot;) == &quot;APPROVED&quot;)
		{
			var dTdyDt = new Date();
			
			//if (sMExpDt != null &amp;&amp; sMExpDt != &quot;&quot;)
			if (sExpDtTm != null &amp;&amp; sExpDtTm != &quot;&quot;)//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
			{
			   if(sCreditClass == &quot;NCC&quot; &amp;&amp; sExpLOV == &quot;Y&quot;)//TULASIY:05MAY2022::NCC Expiry Date Bypass Validation
			   {
			   }
			   else
			   {
					var sMExpDtComp = new Date(sExpDtTm);//Guru: 12/11/2021 - Changed from backend to UI field validation as part of PKE#93960
					var myM = ToInteger(dTdyDt.getMonth()+1);
					var myD = ToInteger(dTdyDt.getDate());
					var myY = ToInteger(dTdyDt.getFullYear());
					var toM = ToInteger(sMExpDtComp.getMonth()+1);
					var toD = ToInteger(sMExpDtComp.getDate());
					var toY = ToInteger(sMExpDtComp.getFullYear());
					var sDispDate = toD + &quot;/&quot; + toM + &quot;/&quot; + toY;
					
					//var sDispDate = 	 
					
					//if((sCreditClass != &quot;&quot;&amp;&amp;sCreditClass != null &amp;&amp; sCreditClass == sCreditClassType) &amp;&amp; (sCCModDate != null &amp;&amp; sCCModDate != &quot;&quot;))
						if ((myY &lt; toY)||((myY==toY)&amp;&amp;(myM &lt; toM))||((myY==toY)&amp;&amp;(myM==toM)&amp;&amp;(myD &lt;= toD)))
						{
							if((sMExpDtComp != &quot;&quot; &amp;&amp; sMExpDtComp != null))  
							{	
								TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_CC_9121&quot;, sDispDate));	
							}
						}
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sCredBC = null;
		sCredBO = null;
	}
}"
