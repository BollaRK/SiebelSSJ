			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="(declarations)"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="var gNewFlag = false;"
			   SEQUENCE="1"
			   UPDATED="01/09/2026 16:01:56"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:56"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_InvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_InvokeMethod (MethodName)
{
/*
 * Component Name        : 	VF Billing Account List Applet - Sub - Connection
 * Method Name           : 	WebApplet_InvokeMethod
 * Component Information : 	Refresh Billing Account for connection because it has new
 *							intersection with Cut Address (see VF Billing Account Write Record event)
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==================================================================
 * 18/07/2005	RP						  Initial build
 */
 
 try
 {
 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Billing Account List Applet - Sub - Connection.WebApplet_InvokeMethod.MethodName =&quot; + MethodName);
	}

	var	psErrorInput;
	var	psErrorOutput;
	var	bsError;
	var idCurrent;
	var bContinue = true;
	var bcBillAccount;
	
	
	// Check if this is an Explicit WriteRecord event for a new record
	if ( MethodName == &quot;ExplicitWriteRecord&quot; &amp;&amp; gNewFlag )
	{
		// Reset flag
		gNewFlag = false;
		
		// Since RefreshRecord does not requery child BC, 
		// then it is necessary to requery the Billing BC.

		bcBillAccount = this.BusComp();
		idCurrent = bcBillAccount.GetFieldValue( &quot;Id&quot; );
		
		bcBillAccount.ClearToQuery();
		bcBillAccount.ExecuteQuery( ForwardBackward );	// Must be ForwardBackward
		
		bContinue = bcBillAccount.FirstSelected();
		if ( bContinue )
		{
			while ( bContinue  )
			{
				if ( bcBillAccount.GetFieldValue( &quot;Id&quot; ) != idCurrent )
					bContinue = bcBillAccount.NextRecord();
				else
					bContinue = false;
			}
		}
	}
		
 }
 catch( e )
 {
 	var strErrorMsg;
  	if (defined(e.errText))
	{
		strErrorMsg = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		strErrorMsg = arguments.callee + ToString(e); 
	}

 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Billing Account List Applet - Sub - Connection.WebApplet_InvokeMethod.ErrorMsg:&quot; + strErrorMsg);
	}
	
	if(strErrorMsg != &quot;&quot;)
	{
		//*************************************
		//* Error Handling
		//*************************************
		strErrorMsg = &quot;VF Billing Account List Applet - Sub - Connection.WebApplet_InvokeMethod: &quot; + strErrorMsg;
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Billing Account List Applet - Sub - Connection&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreInvokemethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;,strErrorMsg); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strErrorMsg = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strErrorMsg);
	}
	else
	{
		TheApplication().RaiseErrorText(e.errText);
	}
	
 }
 finally
 {
	psErrorInput  = null;
	psErrorOutput = null;
	bsError = null;
	bcBillAccount = null;
	
 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:VF Billing Account List Applet - Sub - Connection.WebApplet_InvokeMethod.MethodName=&quot; + MethodName);
	}
 }

}"
			   SEQUENCE="2"
			   UPDATED="01/09/2026 16:01:56"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:56"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
/*
 * Component Name        : 	VF Billing Account List Applet - Sub - Connection
 * Method Name           : 	WebApplet_PreCanInvokeMethod
 * Component Information : 	Disable Edit if Payment Method is Prepay
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==================================================================
 * 18/07/2005	RP						  Initial build
 */
 
 try
 {
 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Billing Account List Applet - Sub - Connection.WebApplet_PreCanInvokeMethod.MethodName =&quot; + MethodName);
	}

	var	psErrorInput;
	var	psErrorOutput;	
	var	bsError;
	var	ContinueCancel = ContinueOperation;
	var bcBillAccount;
		
	if ( MethodName == &quot;EditRecord&quot; )
	{
		bcBillAccount = this.BusComp();
		try
		{
			if ( bcBillAccount.InvokeMethod( &quot;IsActive&quot; ) != &quot;N&quot; )
			{
				if ( bcBillAccount.GetFieldValue( &quot;Payment Method&quot; ) == &quot;Prepay&quot; ) 	
				{
					CanInvoke = &quot;FALSE&quot;;
					ContinueCancel = CancelOperation;
				}
			}
		}
		catch( e )
		{
			// Do nothing. IsActive sometimes randomly errored when there is
			// no record on this version of Siebel.
		}
	}
	
	return ( ContinueCancel );
		
 }
 catch( e )
 {
 	var strErrorMsg;
  	if (defined(e.errText))
	{
		strErrorMsg = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		strErrorMsg = arguments.callee + ToString(e); 
	}

 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Billing Account List Applet - Sub - Connection.WebApplet_PreCanInvokeMethod.ErrorMsg:&quot; + strErrorMsg);
	}
	
	if(strErrorMsg != &quot;&quot;)
	{
		//*************************************
		//* Error Handling
		//*************************************
		strErrorMsg = &quot;VF Billing Account List Applet - Sub - Connection.WebApplet_PreCanInvokeMethod: &quot; + strErrorMsg;
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Billing Account List Applet - Sub - Connection&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreInvokemethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;,strErrorMsg); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strErrorMsg = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strErrorMsg);
	}
	else
	{
		TheApplication().RaiseErrorText(e.errText);
	}
	
 }
 finally
 {
	psErrorInput  = null;
	psErrorOutput = null;
	bsError = null;
	bcBillAccount = null;

 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:VF Billing Account List Applet - Sub - Connection.WebApplet_PreCanInvokeMethod.MethodName=&quot; + MethodName);
	}
 }
}"
			   SEQUENCE="3"
			   UPDATED="01/09/2026 16:01:56"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:56"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
/*
 * Component Name        : 	VF Billing Account List Applet - Sub - Connection
 * Method Name           : 	WebApplet_PreInvokeMethod
 * Component Information : 	Set global flag for new Record. This is used to requery during InvokeMethod
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==================================================================
 * 18/07/2005	RP						  Initial build
 */
 
 try
 {
 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Billing Account List Applet - Sub - Connection.WebApplet_PreInvokeMethod.MethodName =&quot; + MethodName);
	}

	var	psErrorInput;
	var	psErrorOutput;
	var	bsError;
	
	if ( MethodName == &quot;NewRecord&quot; )
	{
		gNewFlag = true;		
	}
		
 }
 catch( e )
 {
 	var strErrorMsg;
  	if (defined(e.errText))
	{
		strErrorMsg = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		strErrorMsg = arguments.callee + ToString(e); 
	}

 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Billing Account List Applet - Sub - Connection.WebApplet_PreInvokeMethod.ErrorMsg:&quot; + strErrorMsg);
	}
	
	if(strErrorMsg != &quot;&quot;)
	{
		//*************************************
		//* Error Handling
		//*************************************
		strErrorMsg = &quot;VF Billing Account List Applet - Sub - Connection.WebApplet_PreInvokeMethod: &quot; + strErrorMsg;
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Billing Account List Applet - Sub - Connection&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreInvokemethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;,strErrorMsg); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strErrorMsg = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strErrorMsg);
	}
	else
	{
		TheApplication().RaiseErrorText(e.errText);
	}
	
 }
 finally
 {
	psErrorInput  = null;
	psErrorOutput = null;
	bsError = null;

 	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:VF Billing Account List Applet - Sub - Connection.WebApplet_PreInvokeMethod.MethodName=&quot; + MethodName);
	}
 }

}"
