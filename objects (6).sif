			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
	var strReturnValue = ContinueOperation;
	switch (MethodName)
	{
		case &quot;SendEmail&quot;:
		{	
			CanInvoke = &quot;TRUE&quot;;
			strReturnValue = CancelOperation;
		}
	}
	return(strReturnValue);
}"
			   SEQUENCE="1"
			   UPDATED="04/11/2026 19:15:08"
			   UPDATED_BY="SUJATHAS"
			   CREATED="04/11/2026 19:15:08"
			   CREATED_BY="SUJATHAS">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function WebApplet_PreInvokeMethod (MethodName)
{
	//Vinodhini-12/12/2018-Added for Atom Phase2
	try
	{

		if(MethodName == &quot;SendEmail&quot;)
		{
           // Email Issue Fix Starts
            this.BusComp().WriteRecord();
            this.BusComp().ParentBusComp().ActivateField(&quot;Id&quot;);
			var sRootLineid = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
			var psInputs1,psOutputs1,bsInvokeWorkflow1;
			var psInputs1 = TheApplication().NewPropertySet();
			var psOutputs1 = TheApplication().NewPropertySet(); 
			var sNewEmail = TheApplication().GetProfileAttr(&quot;SIMSwapEmailAdd&quot;);
			
			var bsInvokeWorkflow1 = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			psInputs1.SetProperty(&quot;ProcessName&quot;, &quot;VHA QREmail Refresh&quot;);
			psInputs1.SetProperty(&quot;NewEmail&quot;, sNewEmail);
			psInputs1.SetProperty(&quot;RequestId&quot;, sRootLineid);
			bsInvokeWorkflow1.InvokeMethod(&quot;RunProcess&quot;, psInputs1, psOutputs1);
            TheApplication().SetProfileAttr(&quot;SIMSwapEmailAdd&quot;, &quot;&quot;)
            this.BusComp().WriteRecord();// Email issue End
    
			this.BusComp().ParentBusComp().ActivateField(&quot;Order Header Id&quot;);
			var sOrderId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Order Header Id&quot;);
			var ErrMsg = &quot;&quot;;
			var SearchSpec = &quot;[SourceOrderId] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			var psInputs,psOutputs,bsInvokeWorkflow;
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			if(sOrderId != &quot;&quot;)
			{
				bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA ATOM Email Validation Workflow&quot;);
				psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
				psInputs.SetProperty(&quot;SearchString&quot;, SearchSpec);
				bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				
				ErrMsg = psInputs.GetProperty(&quot;ErrorMsg&quot;);
				
				if(ErrMsg != null &amp;&amp; ErrMsg != &quot;&quot;)
				{
					throw(ErrMsg);
				}
				
				else
				{
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Async Send Email Workflow&quot;);
					psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
					psInputs.SetProperty(&quot;SearchString&quot;, SearchSpec);
					psInputs.SetProperty(&quot;Email Template Name&quot;, &quot;VHA eSIM Activation QR Code Email&quot;);
					psInputs.SetProperty(&quot;SourceBusObj&quot;, &quot;VHA Email BO&quot;);
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				}
				
	 
			}
            //Fix for Email Starts here
			var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
			var psIn = TheApplication().NewPropertySet();
			var psOut = TheApplication().NewPropertySet();
			psIn.SetProperty(&quot;Refresh All&quot;,&quot;Y&quot;);
			svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;,psIn,psOut);// Email issue ends 
			return (CancelOperation);
		}
		//vha Balaji 17/12/2018 added for atom phase2
		if(MethodName == &quot;Drilldown&quot;)
		{
		   var sOrderBO = TheApplication().ActiveBusObject();
		   var sAttId = sOrderBO.GetBusComp(&quot;VHA QR Code Attachments BC&quot;).GetFieldValue(&quot;Id&quot;);
           var sInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		   var sInputs = TheApplication().NewPropertySet();
		   var sOutputs = TheApplication().NewPropertySet();
		   sInputs.SetProperty(&quot;ProcessName&quot;,&quot;VHA QRCode Imports Update&quot;);
		   sInputs.SetProperty(&quot;AttachmentId&quot;,sAttId);
           sInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, sInputs, sOutputs);
      	   return (ContinueOperation);
		   
		}
		
 return (ContinueOperation);
		
	}
	
	catch(e)
	{
		throw(e);
	}
	finally{
	  sInputs = null;
      sOutputs = null;	
	}
}"
			   SEQUENCE="2"
