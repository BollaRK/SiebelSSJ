				<TASK_STEP_CONTEXT COMMENTS="Tariq 30-SEP-2014. Modified the searchspec to be in sync with core" EXPRESSION_BUSINESS_COMPONENT="VF Internal Product TBUI" FILTER_BUSINESS_COMPONENT="VF Internal Product TBUI" INACTIVE="N" IS_USER_SEARCH_SPEC="N" NAME="ProductSearchSepc" SEARCH_SPECIFICATION="&quot;(([Cfg Latest Released Flag] = 'Y') OR ([Cfg Latest Released Flag] IS NULL) OR ([Cfg Released Flag] = 'N' AND [Cfg Version]=1)) AND EXISTS ([VF Price List Id] = '&quot; + [&amp;VFPricelistId] + &quot;') AND ([Category] = 'Postpay' OR [Type] = 'Promotion') AND EXISTS ([VF SPS Product Category] = '&quot; + [&amp;VFPropFilter] + &quot;')&quot; +  IIf ([&amp;NetworkProviderName] IS NOT NULL ,  &quot; AND ((((&quot;+ &quot;[Siebel Product Type] = 'NBN with MBB'&quot;+ &quot; OR &quot;+ &quot;[Siebel Product Type] = 'NBN Only')&quot;+ &quot; AND &quot;+ &quot;[VF Network Identifier] = '&quot;+[&amp;NetworkProviderName]+&quot;')&quot; + IIf([&amp;RetriveNBNPlanFlg] = 'Y', &quot;AND (&quot;+ &quot;[Special Siebel Product Type]= 'SMB' )&quot;,&quot;&quot;) + &quot;)&quot; + &quot; OR &quot;+ &quot;[Siebel Product Type] = 'Voice')&quot; , &quot; AND (&quot;+ &quot;[Siebel Product Type] &lt;&gt; [FBB]&quot;+ &quot; AND &quot;+ &quot;[Siebel Product Type] &lt;&gt; [FBB1])&quot;)" TYPE="EXPRESSION" UPDATED="01/30/2026 13:16:06" UPDATED_BY="SURESHK" CREATED="01/30/2026 13:16:06" CREATED_BY="SURESHK">
				</TASK_STEP_CONTEXT>
