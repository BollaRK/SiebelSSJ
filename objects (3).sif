			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCallPrepayWF"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCallPrepayWF(Inputs, Outputs) {
    var svcWF = null;
    var psInputs = null;
    var psOutputs = null;
    var boOrder = null; 
    var bcOrder = null;
    var sApp = TheApplication();

    try {
        
        var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        
        if (!sOrderId) {
            throw (&quot;OrderId input is missing.&quot;);
        }

        
        boOrder = sApp.GetBusObject(&quot;Order Entry (Sales)&quot;);
        bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);

        with (bcOrder) {
            SetViewMode(AllView);
            ClearToQuery();
            
            SetSearchSpec(&quot;Id&quot;, sOrderId);
            ExecuteQuery(ForwardOnly); 

            if (FirstRecord()) {
                svcWF = sApp.GetService(&quot;Workflow Process Manager&quot;);
                psInputs = sApp.NewPropertySet();
                psOutputs = sApp.NewPropertySet();

                psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Prepayment Processing WF&quot;);
                
                
                psInputs.SetProperty(&quot;Object Id&quot;, sOrderId);
                psInputs.SetProperty(&quot;OrderId&quot;, sOrderId);

                svcWF.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);

                
                var sErrCode = psOutputs.GetProperty(&quot;Error Code&quot;);
                if (sErrCode !== &quot;&quot; &amp;&amp; sErrCode !== null &amp;&amp; sErrCode !== &quot;0&quot;) {
                    var sErrM = psOutputs.GetProperty(&quot;Error Message&quot;);
                    throw (&quot;Workflow Error: &quot; + sErrM);
                }
            } else {
                throw (&quot;Order Record not found for Id: &quot; + sOrderId);
            }
        }
    } catch (e) {
        throw (e.toString());
    } finally {
        
        psOutputs = null;
        psInputs = null;
        svcWF = null;
        bcOrder = null;
        boOrder = null;
    }
}"
			   SEQUENCE="22"
