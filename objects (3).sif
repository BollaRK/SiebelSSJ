			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCreditCheckDetail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCreditCheckDetail(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateCreditCheckDetail
	* Method Name           : 	
	* Component Information : 	This function validates Credit Check 
	*
	* Modification History  :
	* Date				Author			Config #	Description
	* ============ ===========	===========	================================
	* 04/06/2014		Neel				Initial Version - cloned from VF Wizard Utilities
	*/
	var boCurrent;
	var bcComFinProfile;
	var bcAccount;
	var bcContact;
	var sErrMsg =&quot;&quot;;
	var Status1 = &quot;APPROVED&quot;;
	var Status2 = &quot;APPROVE&quot;;
	var Status3 = &quot;CONDAPPRVE&quot;;
	var Status4 = &quot;ACCEPT&quot;;
	var Status5 = &quot;New&quot;
	var Status6 = &quot;Pending&quot;
	var sRaiseError = &quot;N&quot;;
	var psIn = TheApplication().NewPropertySet();
	var psOut = TheApplication().NewPropertySet();
		
	var sWarning = &quot;&lt;img src=&apos;images/icon_warning.gif&apos; ALIGN=&apos;ABSMIDDLE&apos; /&gt;&quot;;
	var sColorStart = &quot;&lt;font color = red&gt;&quot;;
	var sColorEnd = &quot;&lt;/font&gt;&quot;;	
	
	try
	{
		boCurrent = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		bcComFinProfile= boCurrent.GetBusComp(&quot;VF Com Financial Profile&quot;);
		bcAccount = boCurrent.GetBusComp(&quot;Account&quot;);
		bcContact = boCurrent.GetBusComp(&quot;Contact&quot;);
		
		var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var sScenario = Inputs.GetProperty(&quot;Scenario&quot;);
		with(bcAccount)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Customer Type&quot;); //VHA 19.4/PKE/NIRMAL/06SEP2019/Added for PKE000000076227
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardOnly); 
			if(FirstRecord())
			{ 
				var strCustType = GetFieldValue(&quot;VF Customer Type&quot;); //VHA 19.4/PKE/NIRMAL/06SEP2019/Added for PKE000000076227
				with (bcComFinProfile)
				{
					var dtCCExpiryDate = new Date(GetFieldValue(&quot;VF Credit Check Expiry Date&quot;));
					var strCCExpiryDateToSys = 	dtCCExpiryDate.toSystem(); 
					var strCredtCheckStatus = GetFieldValue(&quot;VF Credit Check Status&quot;);
					var bConditionsAcceptedFlag = GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);
					var strCurrentSysDate = Clib.time();
					
					ActivateField(&quot;ABN ACN Number&quot;);
					ActivateField(&quot;Trading As&quot;);
					ActivateField(&quot;Work Phone&quot;);
								
					var strABNACN = GetFieldValue(&quot;ABN ACN Number&quot;);
					var strTradingAs = GetFieldValue(&quot;Trading As&quot;);
					var strWorkPhone = GetFieldValue(&quot;Work Phone&quot;);
						
					if (strCredtCheckStatus == Status5 || strCredtCheckStatus == &quot;&quot;)
					{						
						Outputs.SetProperty(&quot;sErrMsg&quot;,  &quot;Please Submit the Credit Check Successfully to Proceed with...&quot;);
						sRaiseError = &quot;Y&quot;
						//sErrMsg = sWarning + sColorStart +  &quot; Please Submit the Credit Check Successfully to Proceed with...&quot; + sColorEnd;
						//return (sErrMsg);
					}
					
					if (strABNACN != &quot;&quot; &amp;&amp; strCustType != &quot;Person&quot;) //VHA 19.4/PKE/NIRMAL/06SEP2019/strCustType condition added for PKE000000076227
					{
						bcAccount.ActivateField(&quot;Tax Exempt Number&quot;);
						bcAccount.SetFieldValue(&quot;Tax Exempt Number&quot;, strABNACN);
						bcAccount.WriteRecord();
					}
					
					if (strTradingAs != &quot;&quot;)
					{
						bcAccount.ActivateField(&quot;Alias&quot;);
						bcAccount.SetFieldValue(&quot;Alias&quot;, strTradingAs);
						bcAccount.WriteRecord();
					}
					
					if (strWorkPhone != &quot;&quot;)
					{
						bcContact.ActivateField(&quot;Work Phone #&quot;);
						bcContact.SetFieldValue(&quot;Work Phone #&quot;, strWorkPhone);
						bcContact.WriteRecord();
					}
			
					if (strCredtCheckStatus == &quot;Failed&quot;)
					{		
						Outputs.SetProperty(&quot;sErrMsg&quot;,  &quot;Credit Check Failed, Please Resubmit the Credit Check to proceed with...&quot;);
						sRaiseError = &quot;Y&quot;
						//sErrMsg = sWarning + sColorStart + &quot; Credit Check Failed, Please Resubmit the Credit Check to proceed with... &quot; + sColorEnd;
						//return (sErrMsg);		
					}
		
					if (sRaiseError == &quot;N&quot; &amp;&amp; sScenario == &quot;Pre2Post&quot;)
					{
						//psIn.SetProperty(&quot;AccountId&quot;, sAccountId);
						//psIn.SetProperty(&quot;sScenario&quot;, sScenario);
						//mSetBillSegment(boCurrent);				
						with(bcAccount)
						{
							bcAccount.ActivateField(&quot;Customer Bill Segment&quot;);
							SetFieldValue(&quot;Customer Bill Segment&quot;, &quot;105&quot;);									
							WriteRecord();				
						}
					}
				}//with (bcComFinProfile)
			}//end if(FirstRecord())
 		}//end with(bcAccount)
 		
		if (sRaiseError == &quot;N&quot;)
		{
			Outputs.SetProperty(&quot;sErrMsg&quot;, &quot;NoError&quot;);
		}
	}//end of try	
	catch (e)
	{
		Outputs.SetProperty(&quot;sErrMsg&quot;, e);
	}
	finally
	{		
		bcComFinProfile = null;
		bcContact = null;
		bcAccount = null;
		boCurrent = null;
	/* This variable is nullified by Sharukh on 18/03/2019*/
		psIn = null;
		psOut = null;

	}
}"
			   SEQUENCE="37"
			   UPDATED="04/22/2026 01:45:57"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="06/10/2014 00:41:59"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCustomerAccount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCustomerAccount(Inputs, Outputs)
{

	var sRaiseError=&quot;N&quot;;
	var sCustomerSegment=&quot;&quot;;
	var sCustomerType=&quot;&quot;;
	var sABNACN=&quot;&quot;;	
	var sCustomerSegmentNew=&quot;&quot;;
	var sCustomerTypeNew=&quot;&quot;;
	var sABNACNNew=&quot;&quot;;
	var sAddNewActProfFlg=&quot;&quot;;
	var sConId = &quot;&quot;;
	var isRec1 =&quot;&quot;;var isRec=&quot;&quot;;
	var searchst=&quot;&quot;;
	var sCnt =0;

	var sCustomer   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUSTOMER_SEGMENT&quot;, &quot;Consumer&quot;);
	var sBusiness   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUSTOMER_SEGMENT&quot;, &quot;Business&quot;);
	var sPerson   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUST_TYPE&quot;, &quot;Person&quot;);
	var sCorporate   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUST_TYPE&quot;, &quot;Corporate&quot;);
	var sGovernment   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUST_TYPE&quot;, &quot;Government&quot;);
	var sLRC   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUST_TYPE&quot;, &quot;Local Registered Company&quot;);
	var sSoleTrader   = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CUST_TYPE&quot;, &quot;Sole Trader&quot;);
	try
	{  
			sConId = Inputs.GetProperty(&quot;ContactId&quot;);	     
			sAddNewActProfFlg =  Inputs.GetProperty(&quot;AddNewActProfFlg&quot;);
				
			sCustomerSegment = Inputs.GetProperty(&quot;CustomerSegment&quot;);
			sABNACN =  Inputs.GetProperty(&quot;ABNACN&quot;);
			sCustomerType = Inputs.GetProperty(&quot;Customer Type&quot;);					

			sCustomerTypeNew = Inputs.GetProperty(&quot;CustTypNew&quot;);
			sABNACNNew = Inputs.GetProperty(&quot;ABNACNNew&quot;);
		    sCustomerSegmentNew = Inputs.GetProperty(&quot;CustSegNew&quot;);			
			
			if (sConId!=&quot;&quot;)
			{				
				var sBO = TheApplication().GetBusObject(&quot;Contact&quot;);
 				var sBC = sBO.GetBusComp(&quot;Account Contact&quot;);			
				var sAcntBO = TheApplication().GetBusObject(&quot;Account&quot;);
		 		var sAcntBC = sAcntBO.GetBusComp(&quot;Account&quot;);					
				with(sBC)
		 		{	 	
					SetViewMode(AllView);
					ClearToQuery();			
					SetSearchSpec(&quot;Contact Id&quot;, sConId);									
					ExecuteQuery(ForwardOnly);					
					isRec = FirstRecord();				
					if (isRec) 	
					{						
					  	with(sAcntBC)
						{	
							if((sCustomerTypeNew == &quot;Person&quot;) || (sCustomerTypeNew == &quot;Sole Trader&quot;))
							{			
								searchst= &quot;[Primary Contact Id] = &apos;&quot; + sConId + &quot;&apos; AND [Account Type Code] = &apos;Customer&apos; AND [VF Customer Segment] = &apos;&quot; + sCustomerSegmentNew + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + sCustomerTypeNew + &quot;&apos;&quot;;
							}
							else //if (sCustomerTypeNew == &quot;Local Registered Company&quot;)
							{
								searchst= &quot;[Primary Contact Id] = &apos;&quot; + sConId + &quot;&apos; AND [Account Type Code] = &apos;Customer&apos; AND [Tax Exempt Number] = &apos;&quot; + sABNACNNew + &quot;&apos; AND [VF Customer Segment] = &apos;&quot; + sCustomerSegmentNew + &quot;&apos; AND [VF Customer Type] = &apos;&quot; + sCustomerTypeNew + &quot;&apos;&quot;;
							} 						
							SetViewMode(AllView);
							ClearToQuery();							
							SetSearchExpr(searchst);															
							ExecuteQuery(ForwardOnly);	
							sCnt = CountRecords();					
							if(sCnt &gt;= 1)
							{							
								sRaiseError = &quot;Y&quot;;
							//	TheApplication().RaiseErrorText(&quot;Duplicate customer account creation is not allowed. Please select different customer segment and customer type.&quot;);
							}												
						}			
					}	
				}			
			}		
					
		if(sRaiseError == &quot;N&quot;)
    	{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
		}
		else if((sRaiseError == &quot;Y&quot;) &amp;&amp; (sAddNewActProfFlg == &quot;Y&quot;))
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Duplicate customer account creation is not allowed. Please select different customer segment and customer type.&quot;);
		}
	}
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;, e);	
	}
	finally
	{
		sBO = null;
		sAcntBO = null;
		sBC = null;
		sAcntBC = null;
	}
}"
			   SEQUENCE="38"
			   UPDATED="04/22/2026 01:45:57"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="10/10/2024 21:55:31"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCustomerDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCustomerDetails(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateCustomerDetails
	* Method Name           : 	
	* Component Information : 	This function validates all fields entered
	*							correct
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 02/06/2014	Neel			Cloned from Existing Merlin and modified as per TBUI needs
	*/
	
	var bcAccount;
	//var sPIN;
	var sABNACN;
	var sValidateACN;
	var sValidateABN;
	var sSOHO;
	var sErrMsg =&quot;&quot;;
	var sType;
	var	sAlias;
	var sIndustryType;
	var sCompanyName;
	var sCustomerId;
	var sRaiseError = &quot;N&quot;;
	var sCoverageCheck;
	
	try
	{
		//bcAccount= boCurrent.GetBusComp(&quot;Account&quot;);
		

			//sPIN = GetFieldValue(&quot;Password&quot;);
			//sType = GetFieldValue(&quot;Type&quot;);
			//sSOHO = GetFieldValue(&quot;SOHO Customer&quot;);
			//sAlias = GetFieldValue(&quot;Alias&quot;);
			//sABNACN = GetFieldValue(&quot;Tax Exempt Number&quot;);
			//sIndustryType = GetFieldValue(&quot;Industry Type&quot;);
			//sCompanyName = GetFieldValue(&quot;Name&quot;);
			//sCustomerId =  GetFieldValue(&quot;Row Id&quot;);
			
			//sPIN = Inputs.GetProperty(&quot;CA PIN&quot;);
			sType = Inputs.GetProperty(&quot;Customer Type&quot;);
			sSOHO = Inputs.GetProperty(&quot;Sole Trader&quot;);
			sABNACN =  Inputs.GetProperty(&quot;ABN ACN&quot;);
			sIndustryType =  Inputs.GetProperty(&quot;Industry Type&quot;);
			sCompanyName = Inputs.GetProperty(&quot;Company Name&quot;);
			sCoverageCheck = Inputs.GetProperty(&quot;IsCoverageCheck&quot;); // Added for coverage check required flag
			var sAdNewActPrf = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);
			
			//Save CJ details - Profile attribute is set during CJ search BC &quot;VF Bulk Migrate Services Search&quot;
			if (TheApplication().GetProfileAttr(&quot;CJCustomerAccNum&quot;) != &quot;&quot;)
			{
				
				mSaveCJDetails();
			}
			
			// Check that the PIN is populated and the length is 4 char long
			//Muthushankari 30/3/2017 - Commented as part of R17.2 Service PIN Validation CIR
			/*if (sPIN== &quot;&quot; ||  sPIN == null)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;PIN is Required, Please enter 4 digit PIN to proceed with... &quot;);
				sRaiseError = &quot;Y&quot;;
			}																
			
			else if (sPIN.length &lt; 4 || sPIN.length &gt; 4)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;PIN must be 4 digit long, Please enter exactly 4 digits to proceed with... &quot; );
				sRaiseError = &quot;Y&quot;;
			}
			else if (isNaN(sPIN))//Sri - 06/08/2014
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;PIN should be 4 digit number.&quot; );
				sRaiseError = &quot;Y&quot;;
			}*/
			
			if (sType != &quot;Person&quot;)
			{
			
		         //21/09/2012 : ARPANS :SR 7083 :Start of Code
				if (sCompanyName == &quot;&quot; || sCompanyName == null) //|| sCompanyName == sCustomerId  )
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Company Name is not answered,It should not be blank or same as Customer Row Id, Please enter required fields to proceed with... &quot;);
					sRaiseError = &quot;Y&quot;;
				}
				//21/09/2012 : ARPANS :SR 7083 :End of Code
				
				if ((sABNACN == &quot;&quot; || sABNACN == null) || (sIndustryType == &quot;&quot; || sIndustryType == null))
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Industry Type or ABN/ACN is not answered, Please enter required fields to proceed with... &quot;);
					sRaiseError = &quot;Y&quot;;
				}
				
			}
			else if (sType == &quot;Person&quot; &amp;&amp; sSOHO == &quot;Y&quot;)
			{
				if (sABNACN == &quot;&quot; || sABNACN == null)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;ABN/ACN is not answered for SOHO Customers, Please enter required fields to proceed with... &quot;);
					sRaiseError = &quot;Y&quot;;
				}
			}
		//	else if (sType == &quot;Person&quot; &amp;&amp; (sSOHO == &quot;N&quot; || sSOHO ==&quot;&quot;)) 
			else if (sType == &quot;Person&quot; &amp;&amp; (sSOHO == &quot;N&quot; || sSOHO ==&quot;&quot;) &amp;&amp; (sAdNewActPrf != &quot;Y&quot;)) 
			{
				if (sABNACN != &quot;&quot; )
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;ABN/ACN is not Required without SOHO option, Please enter only the required fields to proceed with... &quot;);
					sRaiseError = &quot;Y&quot;;
				}
			}
					
			
			if (sABNACN.length == 9 || sABNACN.length == 11 || (sType == &quot;Person&quot; &amp;&amp; sSOHO != &quot;Y&quot;))
			{
			// Do Nothing
			}
			else
			{			
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ABN or ACN Number, ABN number must 11 digits long and ACN must be 9 digits long. Please enter the correct numbers to proceed with...&quot;);
				sRaiseError = &quot;Y&quot;;
			}
						
			
			// Validate ABN Number
			if	(sABNACN == &quot;00000000000&quot; || sABNACN == &quot;00000000001&quot;)// Neel 10/06 - Added as per requirement
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;00000000000 / 00000000001 is not a valid ABN/ACN number&quot;);
				sRaiseError = &quot;Y&quot;;
			}
			else if ((sABNACN.length == 11))// &amp;&amp; sType != &quot;Local Registered Company&quot;)//VHA Muthushankari - Commented for R19.02 ABN/ACN Validation CIR
			{
				sValidateABN = mValidateABN(sABNACN);			
				
				if (sValidateABN == false)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ABN Number Please Enter Valid 11 Digit ABN number to proceed with...&quot;);
					sRaiseError = &quot;Y&quot;;
				}		
			}
									
			// Validate ACN Number
									
			if(sABNACN.length == 9)
			{
				sValidateACN = mValidateACN(sABNACN);			
				
				if (sValidateACN == false)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ACN Number Please Enter Valid 9 Digit ACN Number to proceed with...&quot;);
					sRaiseError = &quot;Y&quot;;
				}			
			}
		
		/*	if (sCoverageCheck == &quot;&quot;)// Added for coverage check required flag
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Please enter data for all the required fields to proceed... &quot;);
				sRaiseError = &quot;Y&quot;;
			}*/// Included in DVM
			
		if(sRaiseError == &quot;N&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
		}
	}
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;, e);
		//throw e;
	}
	finally
	{
		
	}
}"
