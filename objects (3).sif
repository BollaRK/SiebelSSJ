			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	if(MethodName == &quot;InsertServiceAddr&quot;)
	{
		mInsertServiceAddr(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;FWATask&quot;)//vasavi added for Imagine COT
	{
		mFWATask(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;UpdateAddress&quot;)
	{
		mUpdateAddress(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;UpdateAddressDetials&quot;)
	{
		mUpdateAddressDetials(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;UpdateAssetId&quot;)
	{
		mUpdateAssetId(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;GetProdId&quot;)
	{
		mGetProdId(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;FWARCR&quot;)
	{
		mFWARCR(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;ValidateCustomer&quot;)
	{
		mValidateCustomer(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;GetCoverageDetails&quot;)
	{
		mGetCoverageDetails(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;CheckAddressExist&quot;)
	{
		mCheckAddressExist(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;UpdateAddressSQ&quot;)// Added for MOCN R1.2a digital api call
	{
		mUpdateAddressSQ(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;UpdateFWAOverrideValidation&quot;)//ADUTTA:SSJ
	{
		mUpdateFWAOverrideValidation(Inputs,Outputs);
		return (CancelOperation);
	}
	if(MethodName == &quot;CreateNewFWAAddress&quot;)//ADUTTA:SSJ
	{
		mCreateNewFWAAddress(Inputs,Outputs);
		return (CancelOperation);
	}
	
	return (ContinueOperation);
}"
			   SEQUENCE="15"
