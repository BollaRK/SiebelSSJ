			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mFWARCR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mFWARCR(Inputs, Outputs)
{
	try
	{
		var bRecords,sRecords;
		var boAddr = TheApplication().GetBusObject(&quot;CUT Address&quot;); 
		var bcAddr = boAddr.GetBusComp(&quot;CUT Address&quot;);

		//var boSerAddr = TheApplication().GetBusObject(&quot;VF Connection Showcase&quot;); 
		//var bcSerAddr = boSerAddr.GetBusComp(&quot;VF FWA Service Address&quot;);

		var sLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_FWA_PURGE&quot;,&quot;Years&quot;);
		var sTotal = sLOV * 365;
		
		var searchexpr =&quot;[Service Address Status] = &apos;Inactive&apos; AND [VHA Service Address Flag] = &apos;Y&apos; AND [Created] &lt;= Today() - &quot;+sTotal+&quot; &quot;;
		with(bcAddr)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Created&quot;);
			ActivateField(&quot;Service Address Status&quot;);
			ActivateField(&quot;VHA Service Address Flag&quot;);
			SetSearchExpr(searchexpr); 
			ExecuteQuery(ForwardOnly); 
			bRecords = FirstRecord();
			while(bRecords)
			{
				var sId = GetFieldValue(&quot;Id&quot;);
				DeleteRecord();
				 	
				/*with(bcSerAddr)
				{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Addr Per Id&quot;);
					SetSearchSpec(&quot;Addr Per Id&quot;,sId); 
					ExecuteQuery(ForwardOnly); 
					sRecords = FirstRecord();
					while(sRecords)
					{
						DeleteRecord();	
						sRecords = NextRecord();
					}
				}*/
				bRecords = NextRecord();
			}
		}		
		
	}
	catch(e)
	{
		if (defined(e.errText)) {
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else {
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		bcAddr = null;
		boAddr = null;

		//bcSerAddr = null;
		//boSerAddr = null;
	}
}"
