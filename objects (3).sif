			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateGeoTagExt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateGeoTagExt(Inputs,Outputs)
{
	try
	{
		var wfBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var wfInp = TheApplication().NewPropertySet();
		var wfOut = TheApplication().NewPropertySet();
		wfInp.SetProperty(&quot;ProcessName&quot;, &quot;VHA 3 Step Upgrade GeoTag Offer Wrapper WF&quot;);
		wfInp.SetProperty(&quot;OrdJourney&quot;, &quot;SalesCalculator&quot;);
	
	 	if(Inputs.GetChildCount() &gt; 1)
		{
			for(var i=0; i &lt; Inputs.GetChildCount(); i++)
			{
				
				if(Inputs.GetChild(i).GetType() == &quot;Context&quot;)
				{
					wfInp.SetProperty(&quot;BAId&quot;,Inputs.GetChild(i).GetChild(0).GetProperty(&quot;BillAccId&quot;));
					wfInp.SetProperty(&quot;CAId&quot;,Inputs.GetChild(i).GetChild(0).GetProperty(&quot;AccntId&quot;));
					wfInp.SetProperty(&quot;OrderId&quot;,Inputs.GetChild(i).GetChild(0).GetProperty(&quot;HeaderId&quot;));
				}
			}
			
			for(var k=0; k &lt; Inputs.GetChildCount(); k++)
			{
				if(Inputs.GetChild(k).GetType() == &quot;AvailableOfferRow&quot;)
				{
					for(var j=0; j &lt; Inputs.GetChild(k).GetChildCount(); j++)
					{
					
						if(Inputs.GetChild(k).GetChild(j).GetProperty(&quot;OfferStatus&quot;) == &quot;Valid&quot;)
						{
							wfInp.SetProperty(&quot;OfferId&quot;,Inputs.GetChild(k).GetChild(j).GetProperty(&quot;OfferId&quot;));
							wfBS.InvokeMethod(&quot;RunProcess&quot;, wfInp, wfOut);
		    
							if (wfOut.GetProperty(&quot;Valid&quot;) != &quot;Y&quot;) 
							{
							   Inputs.GetChild(k).GetChild(j).SetProperty(&quot;OfferStatus&quot;,&quot;Invalid&quot;);
							}//if
							
						}//if
					
					}//for
					
				}//if
				
			}//for
			
		}//if
		
		Outputs.AddChild(Inputs);
	 
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		wfOut = null;
		wfInp = null;
		wfBS = null;
	}
}
"
