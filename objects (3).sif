			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidatePromoCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidatePromoCode (Inputs, Outputs)
{
/*
 * Component Name        : 	VF Postpay Utilities Service
 * Method Name           : 	mValidatePromoCode
 * Component Information : 	Checks whether the Promo Code entered is active in Siebel.
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==========================================================
 * 15/04/2015   ROSELINE	R15.2		Initial Version - Plans and Offers CR
 * 17/04/2015 	YP			R15.2		Modified for SPS - Added conditional Serach Spec with OLI ID
 * 22/04/2015 	ROSELINE	R15.2		Modified for Defect#72 -  Modified Search Spec
 * 23/04/2015 	ROSELINE	R15.2		Modified for Defect#72 -  Changed the validation logic
 * 05/05/2015 	ROSELINE	R15.2		Defect#153 -  Added Tilt ~ in search spec for case insensitive query
 * 26/06/2015 	ROSELINE				Changed BO and BC - Performance Improvement
 */	
 	try
	{
		var sOrderLIBO,sOrderLIBC,sOfferBO,sOfferBC;
		var searchst;
		var searchst1;
		var isRecord;
		var isRec;
		var sPromoCode, sEndDate, sStatus;
		var sSharingAsset;
		var sToday , sFinalEndDate;
		var sErrMsg =&quot;&quot;;
		var sOrderId;
		var sOrderLineItemId = &quot;&quot;;//YP : added for SPS Validation
		 
     //	sOrderLIBO = TheApplication().GetBusObject(&quot;Order Entry - Line Items&quot;);
     //	sOrderLIBC = sOrderLIBO.GetBusComp(&quot;Order Entry - Line Items&quot;);

        sOrderLIBO = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;);
     	sOrderLIBC = sOrderLIBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sOrderLineItemId = Inputs.GetProperty(&quot;OrderLineItemId&quot;);
		
     	with(sOrderLIBC)
     	{
     		sOrderLIBC.SetViewMode(AllView);
			sOrderLIBC.ActivateField(&quot;Order Header Id&quot;);
			sOrderLIBC.ActivateField(&quot;Parent Order Item Id&quot;);	
			sOrderLIBC.ActivateField(&quot;Action Code&quot;);	
			sOrderLIBC.ActivateField(&quot;Promo Code&quot;);
			sOrderLIBC.ClearToQuery();
			searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;; 
			//YP : added below if condition to SPS to set validation specific to the Line Item
			if(sOrderLineItemId != &quot;&quot;)
			{
				searchst = searchst + &quot; AND [Id] = &apos;&quot;+sOrderLineItemId+&quot;&apos;&quot;;
			}
			
			sOrderLIBC.SetSearchExpr(searchst);
			sOrderLIBC.ExecuteQuery(ForwardOnly);	
			isRecord = sOrderLIBC.FirstRecord();
			Outputs.SetProperty(&quot;SPSErrMsg&quot;,&quot;&quot;);//Added this to ensure the output property set for SPS 
			while(isRecord) 
			{
				sPromoCode = sOrderLIBC.GetFieldValue(&quot;Promo Code&quot;);	
			//	if(sPromoCode != null || sPromoCode!= &quot;&quot;)Roseline 20/05/2015 - Removed for PT issue
				if(sPromoCode != &quot;&quot; &amp;&amp; sPromoCode != null) //Roseline 20/05/2015 - Added
				{
					sOfferBO = TheApplication().GetBusObject(&quot;VF Rewards Offer Matrix&quot;);
					sOfferBC = sOfferBO.GetBusComp(&quot;VF Published Rewards Offer Matrix-Thin&quot;);
					sOfferBC.SetViewMode(AllView);
					sOfferBC.ActivateField(&quot;Promo Code&quot;);
					sOfferBC.ActivateField(&quot;Status&quot;);
					sOfferBC.ActivateField(&quot;End Date&quot;);
					sOfferBC.ClearToQuery();
				//	searchst1 = &quot;[Promo Code] = &apos;&quot; + sPromoCode + &quot;&apos; AND [Status] = &apos;Active&apos;&quot;; //23/04/2015 ROSELINE - Removed
					searchst1 = &quot;[Promo Code] ~= &apos;&quot; + sPromoCode + &quot;&apos;&quot;;//23/04/2015 ROSELINE - Added
					sOfferBC.SetSearchExpr(searchst1);
					sOfferBC.ExecuteQuery(ForwardOnly);
					isRec = sOfferBC.FirstRecord(); 
					if(!isRec)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
						//Added this to ensure the output property is set for SPS
						Outputs.SetProperty(&quot;SPSErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
					}
					else
					{
						sEndDate = sOfferBC.GetFieldValue(&quot;End Date&quot;);
						sStatus = sOfferBC.GetFieldValue(&quot;Status&quot;);
						sToday = new Date();
						sFinalEndDate = new Date(sEndDate);
						if(sStatus != &apos;Active&apos;)
						{
							Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
							Outputs.SetProperty(&quot;SPSErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
						}
						else if(sFinalEndDate &lt; sToday)
						{
							Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered has expired. Please enter the correct Promo Code&quot;);
							Outputs.SetProperty(&quot;SPSErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered has expired. Please enter the correct Promo Code&quot;);
						}
					}//else
				} //if(sPromoCode != &quot;&quot; &amp;&amp; sPromoCode != null)
				isRecord = sOrderLIBC.NextRecord(); 
			} //while
		}//	with(sOrderBC)  
              return(CancelOperation);
	} //try
	catch (e)
	{
       throw(e);	
	}
	finally
	{
	    sOfferBC = null;
	    sOfferBO = null; 	
	  	sOrderLIBC = null;
      	sOrderLIBO = null;
	}	
	return(ContinueOperation);
}"
			   SEQUENCE="26"
