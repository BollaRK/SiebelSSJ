var gContAmt = &quot;&quot;;
var gContAmtOVRD = &quot;&quot;;
var gNonRefundPrepaymentAmt = &quot;&quot;;
var sIfPrepayment = &quot;&quot;;
var sRelOrdIdPP = &quot;&quot;;//Suresh G - Added for 19.3 Prepayments- Used to handle OOS scenarios for Accessories
var sPrepaymentsUpdSkip = &quot;N&quot;;
var sReservationId;
var ssItemName;							
