			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateAddressSQ"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
//Your public declarations go here...  
function mUpdateAddressSQ(Inputs, Outputs)
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sAddr = Inputs.GetProperty(&quot;PrimaryAddrId&quot;);
		var sFWAUserId = Inputs.GetProperty(&quot;FWAUserId&quot;);
		var sProdCoverageType = Inputs.GetProperty(&quot;ProdCoverageType&quot;);	
		var sGlobalCovSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_COV_TYPE&quot;, &quot;FWACoverageEnforcementSwitch&quot;);
		var signal = &quot;&quot;, sector = &quot;&quot;, frequency = &quot;&quot;, lat = &quot;&quot;, lon = &quot;&quot;,sFSerAddrId = &quot;&quot;, sFAddrId= &quot;&quot;,site=&quot;&quot;,bcCovXMRec=&quot;&quot;,tech=&quot;&quot;,angle=&quot;&quot;,dis=&quot;&quot;,fwasqid = &quot;&quot;,capacity = &quot;&quot;,serviceability = &quot;&quot;,network = &quot;&quot;,placeId  = &quot;&quot;,mode = &quot;&quot;,sqtimestamp = &quot;&quot;;	//Added for MCON: Sandesh;	
		var sCId =&quot;&quot;; 
		var bcCov = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;).GetBusComp(&quot;VF Coverage Check&quot;);
		var bcCovXM = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;).GetBusComp(&quot;VF Coverage Check Band&quot;);
		with(bcCov)
		{					 
	
			SetViewMode(AllView);
			ClearToQuery();						
	        ActivateField(&quot;Originator&quot;);
			ActivateField(&quot;NBN Address Id&quot;);
			ActivateField(&quot;VHA FWA Address Id&quot;);
			ActivateField(&quot;VHA FWA Service Address ID&quot;);
			ActivateField(&quot;VHA FWA Service Address Flag&quot;);
			ActivateField(&quot;Latitude&quot;);
			ActivateField(&quot;Longitude&quot;);
			ActivateField(&quot;Signal Strength&quot;);
			ActivateField(&quot;Frequency&quot;);
			ActivateField(&quot;Sector Name&quot;);
			ActivateField(&quot;Longitude&quot;);
			ActivateField(&quot;Latitude&quot;);
            ActivateField(&quot;Technology&quot;);
			ActivateField(&quot;DistanceToBestSite&quot;);
			ActivateField(&quot;AngleToBestSite&quot;);
			ActivateField(&quot;Coverage Checked&quot;);
            ActivateField(&quot;FWASQId&quot;);   //Start : Added for MCON2-2 : Sandesh
			ActivateField(&quot;SNetwork&quot;); 
			ActivateField(&quot;SQTimestamp&quot;);
			ActivateField(&quot;PlaceId&quot;); 
			ActivateField(&quot;Capacity&quot;); 
			ActivateField(&quot;Coverage Checked&quot;);
			ActivateField(&quot;Serviceability&quot;);
			SetSearchSpec(&quot;Originator&quot;,sOrderId);
			SetSearchSpec(&quot;Coverage Checked&quot;,&quot;Y_DIG&quot;);
			SetSortSpec(&quot;Created (DESCENDING)&quot;);										
		    ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{					
		    sCId = GetFieldValue(&quot;Id&quot;);	
				sFAddrId = GetFieldValue(&quot;VHA FWA Address Id&quot;);	
				//sFSerAddrId = GetFieldValue(&quot;VHA FWA Service Address ID&quot;);	
				lat = GetFieldValue(&quot;Latitude&quot;);	
				lon = GetFieldValue(&quot;Longitude&quot;);	
				with(bcCovXM)
				{
					if(sProdCoverageType == &quot;VFAUPostPayFWA5GNSA&quot;)
					{
						//site = &quot;tech5Gnsa&quot;;
						site = &quot;tech5G&quot;;
						//tech = &quot;5G&quot;;
						tech = &quot;5GNSA&quot;;
					}
					if(sProdCoverageType == &quot;VFAUPostPayFWA4G&quot;)
					{
						site = &quot;tech4G&quot;;	
						tech = &quot;4G&quot;;
					}
					var searchst = &quot;([Coverage Id] = &apos;&quot;+sCId+&quot;&apos; AND [Site] = &apos;&quot;+site+&quot;&apos;)&quot;;
					ClearToQuery();
					SetViewMode(AllView);					
					ActivateField(&quot;Coverage Id&quot;);
			        ActivateField(&quot;Planned Note&quot;);
					ActivateField(&quot;Coverage Type&quot;);
					ActivateField(&quot;Site&quot;);																					
					SetSearchExpr(searchst);											
			        ExecuteQuery(ForwardOnly);							
					bcCovXMRec = bcCovXM.FirstRecord();
					while(bcCovXMRec)
					{

						var type = GetFieldValue(&quot;Coverage Type&quot;);
						if(type == &quot;sectorName&quot;)
							sector = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;frequency&quot;)
							frequency = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;signalStrength&quot;)
							signal = GetFieldValue(&quot;Planned Note&quot;);
                        if(type == &quot;technology&quot;)
							tech = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;antennaDirection&quot;)
							angle = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;distanceMetres&quot;)
							dis = GetFieldValue(&quot;Planned Note&quot;);
                        if(type == &quot;fwaSqId&quot;)//Start : Added for MCON: Sandesh
							fwasqid = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;placeId&quot;)
							placeId = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;network&quot;)
							network = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;capacity&quot;)
							capacity = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;sqtimestamp&quot;)
							sqtimestamp = GetFieldValue(&quot;Planned Note&quot;);
						if(type == &quot;serviceability&quot;)
							serviceability = GetFieldValue(&quot;Planned Note&quot;);//End : Added for MCON: Sandesh
						
						bcCovXMRec = bcCovXM.NextRecord();					
			       	}																										
				}
				SetFieldValue(&quot;Signal Strength&quot;,signal);
				SetFieldValue(&quot;Frequency&quot;,frequency);
				SetFieldValue(&quot;Sector Name&quot;,sector);
                SetFieldValue(&quot;Technology&quot;,tech);
				SetFieldValue(&quot;Serviceability&quot;,serviceability);
				SetFieldValue(&quot;PlaceId&quot;,placeId);
				SetFieldValue(&quot;SNetwork&quot;,network);
				SetFieldValue(&quot;Capacity&quot;,capacity);
				SetFieldValue(&quot;FWASQId&quot;,fwasqid);
				SetFieldValue(&quot;SQTimestamp&quot;,sqtimestamp);
                SetFieldValue(&quot;AngleToBestSite&quot;,angle);
				SetFieldValue(&quot;DistanceToBestSite&quot;,dis);
				SetFieldValue(&quot;VHA FWA Service Address ID&quot;,sFWAUserId);
				SetFieldValue(&quot;VHA FWA Service Address Flag&quot;,sGlobalCovSwitch);
				/*if(sector != &quot;&quot; &amp;&amp; sector != null &amp;&amp; signal != &quot;&quot; &amp;&amp; signal != null &amp;&amp; frequency != &quot;&quot; &amp;&amp; frequency != null)
					SetFieldValue(&quot;Coverage Checked&quot;,&quot;Y&quot;);
				else
					SetFieldValue(&quot;Coverage Checked&quot;,&quot;N&quot;);	
				*/
				WriteRecord();
			}
		}

		
	}
	catch(e)
	{	
		
		throw(e);
	}
	finally
	{
		//sAddrBC = null;

	}
} 


  
"
			   SEQUENCE="10"
			   UPDATED="05/04/2026 15:12:14"
