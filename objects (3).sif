			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalculatePrepayments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalculatePrepayments(Inputs, Outputs) {
 
    //SureshG - 15/5/2019 Created for 19.3

    try {

        var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);

        var sOrderFunction = Inputs.GetProperty(&quot;sOrderFunction&quot;);

        TheApplication().SetProfileAttr(&quot;TotalDevRRPUpg1&quot;, sOrderId + sOrderFunction);

        var sBO1 = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);

        var sBO2 = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);

        var sOrderItemBC = sBO1.GetBusComp(&quot;Order Entry - Line Items&quot;);

        var boHM = TheApplication().GetBusObject(&quot;VF Handset Matrix&quot;);

        var sIMEIBC = sBO1.GetBusComp(&quot;VF Allocate IMEI&quot;);

        var sHSMBC = boHM.GetBusComp(&quot;VF Handset Matrix&quot;);

        var bcHMVer = boHM.GetBusComp(&quot;VF Handset Matrix Version&quot;);

        var sAccBC = &quot;&quot;;

        //VHA KT 25/02/26: Added below for defect CM-8479 for APP calculation in SSJ

        if (TheApplication().GetProfileAttr(&quot;SSJFlow&quot;) == &quot;Y&quot;) {

            sAccBC = sBO2.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);

        } else {

            sAccBC = sBO2.GetBusComp(&quot;VHA Accessory Items&quot;);

        }

        var sTotalDevRRP = 0,

        sRCC = 0,

        sTotalDevRRPUpg = 0;

        var sResId = &quot;&quot;,

        sStoreDevice = &quot;&quot;;

        var sParOrdItemId = &quot;&quot;;

        var searchst1 = &quot;&quot;;

        var searchst2 = &quot;&quot;;

        var sOLICount = &quot;&quot;;

        var sAccCount = &quot;&quot;;

        var sRRP = &quot;&quot;;

        var sAccRRP = &quot;&quot;;

        var sAccTotalRRP = 0;

        var sTotalRRP = 0;

        var sDollar = /($)/g;

        var sOrderItemId = &quot;&quot;;

        var isRecord = &quot;&quot;;

        var sInputs = TheApplication().NewPropertySet();

        var sOutputs = TheApplication().NewPropertySet();

        var psInputs = TheApplication().NewPropertySet();

        var psOutputs = TheApplication().NewPropertySet();

        var sOrdItemId,

        sStockInd,

        sIMEI,

        sDevCode,

        sPlan;

        var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);

        var sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);

        var sUpfCost = &quot;&quot;;

        var sUpgradeView = TheApplication().ActiveViewName();
 
        if (sUpgradeView == &quot;VF Eligibility and Offers View - TBUI&quot;) {

            mUpgradeCalculatePrepayments(sInputs, sOutputs);
 
            sTotalRRP = sOutputs.GetProperty(&quot;TotalRRP&quot;);

            sTotalDevRRP = sOutputs.GetProperty(&quot;MPPPrepayment&quot;);

            sAccTotalRRP = sOutputs.GetProperty(&quot;APPPrepayment&quot;);
 
        } else {
 
            with (sOrderItemBC) {

                ActivateField(&quot;VHA RRP&quot;);

                ActivateField(&quot;Id&quot;);

                ActivateField(&quot;VF Stock Indicator TBUI&quot;);

                ActivateField(&quot;VF IMEI TBUI&quot;);

                ActivateField(&quot;VF Handset Code TBUI&quot;);

                ActivateField(&quot;Reservation Id&quot;);

                ActivateField(&quot;Store Device Code&quot;);

                ClearToQuery();

                SetViewMode(AllView);

                searchst1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND ([Parent Order Item Id] = &apos;&quot; + sParOrdItemId + &quot;&apos; OR [Parent Order Item Id] IS NULL)&quot;;

                SetSearchExpr(searchst1);

                ExecuteQuery(ForwardOnly);

                isRecord = FirstRecord();

                while (isRecord) {

                    if (sOrderFunction == &quot;UPGRADE&quot;) //SBABU

                    {

                        sRRP = GetFieldValue(&quot;VHA RRP&quot;);

                        sRRP = ToNumber(sRRP.substring(1, sRRP.length));

                        sTotalDevRRPUpg = ToNumber(sTotalDevRRP + sRRP);

                        TheApplication().SetProfileAttr(&quot;TotalDevRRPUpg&quot;, sTotalDevRRPUpg);

                    }

                    /*isRecord = NextRecord();*/

                    sOrdItemId = GetFieldValue(&quot;Id&quot;);

                    sStockInd = GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);

                    sIMEI = GetFieldValue(&quot;VF IMEI TBUI&quot;);

                    sDevCode = GetFieldValue(&quot;VF Handset Code TBUI&quot;);

                    sResId = GetFieldValue(&quot;Reservation Id&quot;);

                    sStoreDevice = GetFieldValue(&quot;Store Device Code&quot;);

                    if (sOrderFunction != &quot;UPGRADE&quot;) {

                        if (sStockInd == sInStock &amp;&amp; (sResId == &quot;&quot; || sResId == null)) {

                            with (sIMEIBC) {

                                ActivateField(&quot;Id&quot;);

                                ActivateField(&quot;IMEI&quot;);

                                ActivateField(&quot;Upfront Cost&quot;);

                                ClearToQuery();

                                SetViewMode(AllView);

                                searchst2 = &quot;[IMEI] = &apos;&quot; + sIMEI + &quot;&apos;&quot;;

                                SetSearchExpr(searchst2);

                                ExecuteQuery(ForwardOnly);

                                if (FirstRecord()) {

                                    sUpfCost = ToNumber(GetFieldValue(&quot;Upfront Cost&quot;)); //VHA Prashanth 310719: Review Comment Incorporated

                                    if (sUpfCost != &quot;NaN&quot;) //VHA Prashanth 310719: Review Comment Incorporated

                                    {

                                        sTotalDevRRP = ToNumber(sTotalDevRRP) + ToNumber(GetFieldValue(&quot;Upfront Cost&quot;));

                                    }

                                }

                            }

                        } else if (sStockInd == sConnectLater || (sResId != &quot;&quot; &amp;&amp; sResId != null)) {

                            psInputs.SetProperty(&quot;LineId&quot;, sOrdItemId);

                            mGetPlanDetails(psInputs, psOutputs)

                            sPlan = psOutputs.GetProperty(&quot;Plan&quot;);

                            if (sPlan != null &amp;&amp; sPlan != &quot;&quot;) {

                                if ((sDevCode != null &amp;&amp; sDevCode != &quot;&quot;) || (sStoreDevice != &quot;&quot; &amp;&amp; sStoreDevice != null)) //ADUTTA:SSJ

                                {
 
                                    with (bcHMVer) {

                                        ActivateField(&quot;Version Status&quot;);

                                        ClearToQuery();

                                        SetViewMode(AllView);

                                        SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);

                                        ExecuteQuery();

                                        if (FirstRecord()) {

                                            with (sHSMBC) {

                                                ActivateField(&quot;Product Code&quot;);

                                                ActivateField(&quot;Plan Name&quot;);

                                                ActivateField(&quot;Id&quot;);

                                                ClearToQuery();

                                                SetViewMode(AllView);

                                                if (sResId != &quot;&quot; &amp;&amp; sResId != null &amp;&amp; sStoreDevice != &quot;&quot;)

                                                    SetSearchSpec(&quot;Product Code&quot;, sStoreDevice);

                                                else

                                                    SetSearchSpec(&quot;Product Code&quot;, sDevCode);

                                                SetSearchSpec(&quot;Plan Name&quot;, sPlan);
 
                                                ExecuteQuery(ForwardOnly);

                                                if (FirstRecord()) {

                                                    sTotalDevRRP = ToNumber(sTotalDevRRP) + ToNumber(GetFieldValue(&quot;Recommended Customer Contribution&quot;));

                                                }

                                            }

                                        }

                                    }

                                }

                            }

                        }

                    }

					isRecord = NextRecord();

                }

            }
 
            with (sAccBC) {

                ActivateField(&quot;VHA RRP inc GST&quot;);

                ActivateField(&quot;Order Id&quot;);

                ClearToQuery();

                SetViewMode(AllView);

                SetSearchSpec(&quot;Order Id&quot;, sOrderId);

                ExecuteQuery(ForwardBackward);

                isRecord = FirstRecord();

                while (isRecord) {

                    sAccRRP = ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;));

                    sAccTotalRRP = ToNumber(sAccTotalRRP + sAccRRP);

                    isRecord = NextRecord();

                }

            }
 
            sTotalRRP = sAccTotalRRP + sTotalDevRRP;

            TheApplication().SetProfileAttr(&quot;MethodInvokeBC&quot;, &quot;sTotalRRP&quot;);

        }
 
        Outputs.SetProperty(&quot;TotalRRP&quot;, sTotalRRP);

        Outputs.SetProperty(&quot;MPPPrepayment&quot;, sTotalDevRRP);

        Outputs.SetProperty(&quot;APPPrepayment&quot;, sAccTotalRRP);

        if (sOrderFunction == &quot;UPGRADE&quot;) //SBABU

        {

            sTotalRRP = sAccTotalRRP + sTotalDevRRPUpg;

            Outputs.SetProperty(&quot;TotalRRP&quot;, sTotalRRP);

            Outputs.SetProperty(&quot;MPPPrepayment&quot;, sTotalDevRRPUpg);

            Outputs.SetProperty(&quot;APPPrepayment&quot;, sAccTotalRRP);

        }

    } catch (e) {

        throw (e);

    } finally {

        sOrderId = &quot;&quot;;

        sBO1 = &quot;&quot;;

        sBO2 = &quot;&quot;;

        sOrderItemBC = &quot;&quot;;

        sAccBC = &quot;&quot;;

        sTotalDevRRP = &quot;&quot;;

        sParOrdItemId = &quot;&quot;;

        searchst1 = &quot;&quot;;

        searchst2 = &quot;&quot;;

        sOLICount = &quot;&quot;;

        sAccCount = &quot;&quot;;

        sRRP = &quot;&quot;;

        sAccRRP = &quot;&quot;;

        sAccTotalRRP = &quot;&quot;;

        sTotalRRP = &quot;&quot;;

        sDollar = &quot;&quot;;

        sOrderItemId = &quot;&quot;;

        isRecord = &quot;&quot;;

    }
 
}

"
