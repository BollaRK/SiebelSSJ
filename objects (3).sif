			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpgradeCalculatePrepayments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpgradeCalculatePrepayments(sInputs, sOutputs)
{
	try
	{
	
	
		var searchexpr = &quot;&quot;;
		var sDevRRP = 0;
		var sSDRRP = 0;
		var sAccRRP = 0;
		var sAPPRRP = 0;
		var sTotalRRP = 0;
		

		
		var sBO = TheApplication().ActiveBusObject();
		var sAssetBC = sBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		var sOfferBC = sBO.GetBusComp(&quot;VF Upgrade Offer&quot;);
		var sAssetId = &quot;&quot;;
		var isRecord1 = &quot;&quot;;
		var isRecord2 = &quot;&quot;;		
		with(sAssetBC)
		{
			ActivateField(&quot;Id&quot;);
			/*ClearToQuery(); 
			SetViewMode(AllView);
			SetSearchExpr(searchexpr);
			ExecuteQuery(ForwardOnly);*/				
			isRecord1 = FirstRecord();
			while(isRecord1)
			{
				sAssetId = GetFieldValue(&quot;Id&quot;);		
					
					with(sOfferBC)
					{
						ActivateField(&quot;Id&quot;);
						ActivateField(&quot;VHA Total App Accessory-Display&quot;);
						ActivateField(&quot;VHA Total App SD-Display&quot;);
						ActivateField(&quot;Total Offer RCC incl&quot;);
						ClearToQuery(); 
						SetViewMode(AllView);
						SetSearchExpr(&quot;[Root Asset Id] = &apos;&quot; +sAssetId+ &quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);				
						isRecord2 = FirstRecord();
						while(isRecord2)
						{
								sDevRRP = ToNumber(sDevRRP) + ToNumber(GetFieldValue(&quot;Total Offer RCC incl&quot;));
							    sSDRRP = ToNumber(sSDRRP) + ToNumber(GetFieldValue(&quot;VHA Total App SD-Display&quot;));
								sAccRRP = ToNumber(sAccRRP) + ToNumber(GetFieldValue(&quot;VHA Total App Accessory-Display&quot;));
						        sAPPRRP = ToNumber(sSDRRP) + ToNumber(sAccRRP);
						        isRecord2 = NextRecord();
						}
					} 
				
				
				
				
				isRecord1 = NextRecord();
			} 
			
			
			
			
		}
			sTotalRRP = ToNumber(sDevRRP) + ToNumber(sAPPRRP);
			sOutputs.SetProperty(&quot;TotalRRP&quot;, sTotalRRP);
			sOutputs.SetProperty(&quot;MPPPrepayment&quot;, sDevRRP);
			sOutputs.SetProperty(&quot;APPPrepayment&quot;, sAPPRRP);
			

	
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{

		searchexpr = null; 
		sDevRRP = null; 
		sSDRRP = null; 
		sAccRRP = null; 
		sAPPRRP = null; 
		sTotalRRP = null; 
		sBO = null; 
		sAssetBC = null;
		sOfferBC = null; 
		sAssetId = null; 
		isRecord1 = null; 
		isRecord2 = null; 

	}
}"
