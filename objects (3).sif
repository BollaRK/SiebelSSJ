			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSharServicesCount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSharServicesCount(Inputs, Outputs)
{
try
{
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
	var sBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
	var sAssetBC = sBO.GetBusComp(&quot;VHA Asset Mgmt - Asset - Header&quot;);
	var sAssetSimpleBC = sBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
	var sVoiceExists=&quot;N&quot;, sFBBAddMem=&quot;N&quot;, InstockVoiceExist = &quot;N&quot;, sVoiceinOrder = &quot;N&quot;; // VHA Suresh: Added for R17.3 Sharing: PIPE
	var sSearchExpr=&apos;&apos;, NoOfExistingServices=0,sEnableSharing= &quot;N&quot;,sAssetAcntProp=&quot;N&quot;,sAccntPropError=&quot;&quot;;
	TheApplication().SetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;,&quot;Y&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingOrderId&quot;,sOrderId);
	
	
	var psOutputs = TheApplication().NewPropertySet();
	
	fnDecideSharingAction(Inputs,psOutputs);
	var sSharingEnable = psOutputs.GetProperty(&quot;sSharingEnable&quot;);
    var sAddMember = psOutputs.GetProperty(&quot;sAddMember&quot;);
    var sAddMemberCount = psOutputs.GetProperty(&quot;sAddMemberCount&quot;);
    var sRemoveFlg = psOutputs.GetProperty(&quot;sRemoveFlg&quot;);
	var sExistingFlg = psOutputs.GetProperty(&quot;sExistingFlg&quot;);
	var sBillAcntId = psOutputs.GetProperty(&quot;sBillAcntId&quot;);
	var sAccntproposition = psOutputs.GetProperty(&quot;sAccntproposition&quot;);
	var sOrderType = psOutputs.GetProperty(&quot;sOrderType&quot;);
	sVoiceExists = psOutputs.GetProperty(&quot;VoicePropExist&quot;);	//VHA Suresh: Added for R17.3 Sharing: PIPE
	sVoiceinOrder = psOutputs.GetProperty(&quot;VoicePropExist&quot;);	
	sFBBAddMem	= psOutputs.GetProperty(&quot;FBBPropAddmemExist&quot;);
	InstockVoiceExist = psOutputs.GetProperty(&quot;InstockVoiceExist&quot;);
	var sVoiceNotRemMem = psOutputs.GetProperty(&quot;VoiceNotRemoveMemExist&quot;);
	//VHA KT 18032026 Start: Added Profile attributes for debugging SSJ Sharing flow, to be later removed
	TheApplication().SetProfileAttr(&quot;sSharingEnable&quot;,sSharingEnable);
	TheApplication().SetProfileAttr(&quot;sAddMember&quot;,sAddMember);
	TheApplication().SetProfileAttr(&quot;sAddMemberCount&quot;,sAddMemberCount);
	TheApplication().SetProfileAttr(&quot;sRemoveFlg&quot;,sRemoveFlg);
	TheApplication().SetProfileAttr(&quot;sExistingFlg&quot;,sExistingFlg);
	TheApplication().SetProfileAttr(&quot;sBillAcntId&quot;,sBillAcntId);
	TheApplication().SetProfileAttr(&quot;sAccntproposition&quot;,sAccntproposition);
	TheApplication().SetProfileAttr(&quot;sVoiceExists&quot;,sVoiceExists);
	TheApplication().SetProfileAttr(&quot;sVoiceinOrder&quot;,sVoiceinOrder);
	TheApplication().SetProfileAttr(&quot;sFBBAddMem&quot;,sFBBAddMem);
	TheApplication().SetProfileAttr(&quot;InstockVoiceExist&quot;,InstockVoiceExist);
	TheApplication().SetProfileAttr(&quot;sVoiceNotRemMem&quot;,sVoiceNotRemMem);
	//VHA KT 18032026 End : Added Profile attributes for debugging SSJ Sharing flow, to be later removed
	TheApplication().SetProfileAttr(&quot;VhaSharingSubType&quot;,sOrderType);
	
	if(psOutputs.GetProperty(&quot;IsDiffSharingGroup&quot;) == &quot;Y&quot;)
	{
		throw(&quot;VFErrorCode#  96006&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96006&quot;));

	}

	
	with(sAssetBC)
    	{
    		var sSearch= &quot;[Billing Account Id] = &apos;&quot; + sBillAcntId +&quot;&apos;&quot;;
    		ActivateField(&quot;VHA Siebel Product Type&quot;);
    		SetViewMode(AllView);
    		ClearToQuery();
    		if(sOrderType == &quot;Connect&quot; &amp;&amp; sBillAcntId != &apos;&apos; &amp;&amp; sBillAcntId != null)
    			SetSearchExpr(sSearch);
			ExecuteQuery(ForwardOnly);
			NoOfExistingServices = CountRecords();
			if(sVoiceExists != &quot;Y&quot; &amp;&amp; sFBBAddMem == &quot;Y&quot;)	//VHA Suresh: Added for R17.3 Sharing: PIPE
  			 {
				var irec = FirstRecord();
				while(irec)
				{
					if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VHA Siebel Product Type&quot;)) == &quot;&quot;)
						sVoiceExists = &quot;Y&quot;;
					irec = NextRecord();
				}
			}
    	}
    with(sAssetSimpleBC)
    {
    	sSearchExpr = &quot;[Billing Account Id] = &apos;&quot; + sBillAcntId +&quot;&apos; AND [Status] = &apos;Active&apos; AND [Product Type] = &apos;Account Proposition&apos;&quot;;
    	SetViewMode(AllView);
    	ActivateField(&quot;Billing Account Id&quot;);
    	ActivateField(&quot;Status&quot;);
    	ActivateField(&quot;Product Type&quot;);
    	ClearToQuery();
    	SetSearchExpr(sSearchExpr);
		ExecuteQuery(ForwardOnly);
		if(FirstRecord())
		{
			sAssetAcntProp = &quot;Y&quot;;	
		}
    }	
    	
    
    if(sSharingEnable == &quot;Y&quot;)
    {
   		if(sAddMember == &quot;Y&quot; &amp;&amp; sAddMemberCount == 1 &amp;&amp; NoOfExistingServices == 0)
    	{
    		sEnableSharing = &quot;N&quot;;
    		UpdateSSOSharingFlag(sOrderId);	
    	}
		else if(sVoiceExists != &quot;Y&quot; &amp;&amp; sFBBAddMem == &quot;Y&quot;)	// VHA Suresh: 20/04/2017: Added for PIPE: Sharing
		{
			sEnableSharing = &quot;N&quot;;
    		UpdateFBBServicesSharingFlag(sOrderId);
		}
    	else
    	{
    		sEnableSharing = &quot;Y&quot;;
    	}
    	if(sRemoveFlg == &quot;Y&quot; || sExistingFlg == &quot;Y&quot;)
    	{
    		Inputs.SetProperty(&quot;BillingAccountId&quot;,sBillAcntId);
    		mUpdateExistingSharingRecords(Inputs,Outputs);
    	}
    }
    if(sAccntproposition == &quot;Y&quot; || sAssetAcntProp == &quot;Y&quot;)
    {
    	sAccntPropError = &quot;VFErrorCode#  96001&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96001&quot;);
    }
    if(sOrderType == &quot;Connect&quot; &amp;&amp; sEnableSharing == &quot;Y&quot; &amp;&amp; sFBBAddMem == &quot;Y&quot; &amp;&amp; sVoiceinOrder == &quot;Y&quot; &amp;&amp; InstockVoiceExist != &quot;Y&quot;)
	{
		throw(&quot;VFErrorCode#  96020&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96020&quot;));		
	}
    
    Outputs.SetProperty(&quot;sEnableSharing&quot;,sEnableSharing);
	Outputs.SetProperty(&quot;NoOfExistingServices&quot;,NoOfExistingServices);
	Outputs.SetProperty(&quot;sBillAcntId&quot;,sBillAcntId);	
	Outputs.SetProperty(&quot;sAddMemberCount&quot;,sAddMemberCount);
	Outputs.SetProperty(&quot;sAccntPropError&quot;,sAccntPropError);	
}
catch (e)
{
	Outputs.SetProperty(&quot;ErrMessage&quot;,e);
}
finally
{
	sAssetBC=null;
	sAssetSimpleBC=null;
	sBO=null;
	TheApplication().SetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;,&quot;&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingOrderId&quot;,&quot;&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingSubType&quot;,&quot;&quot;);
}

}"
			   SEQUENCE="33"
			   UPDATED="03/19/2026 00:15:53"
			   UPDATED_BY="KOVIDT"
			   CREATED="08/17/2016 09:04:19"
