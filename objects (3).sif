			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCheckCustomised"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCheckCustomised (Inputs, Outputs)
{
 try
 {
 		var bcExists,strLineItemId,strMSISDN;
		var StrSharingOption,StrSharingAction;
		var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrderConnect = boOrderConnect.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);  
		var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		
		var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + strOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [VF Plan TBUI] IS NOT NULL AND [VF Configuration Status] = &apos;Not Customized&apos;&quot;;
		
		if(strOrderId != &quot;&quot;)
		{
			bcOrderConnect.SetViewMode(AllView);
			bcOrderLineItems.ActivateField(&quot;MSISDN&quot;);
			bcOrderConnect.ClearToQuery();
			bcOrderConnect.SetSearchSpec(&quot;Id&quot;, strOrderId);
			bcOrderLineItems.SetSearchExpr(sSearchspec);
			bcOrderConnect.ExecuteQuery(ForwardOnly);
			if(bcOrderConnect.FirstRecord() &amp;&amp; bcOrderLineItems.FirstRecord())
			{
			 	strMSISDN = bcOrderLineItems.GetFieldValue(&quot;MSISDN&quot;);
				TheApplication().RaiseErrorText(&quot;Please click the Customise button for MSISDN &quot; + strMSISDN);
			}
		}
  }
  catch(e)
	{
		throw(e);
	}
	finally
	{
		bcOrderLineItems = null;
		bcOrderConnect = null;
		boOrderConnect = null;
	}
}"
