			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SSJCheckTwoWaySMSEligibility"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function SSJCheckTwoWaySMSEligibility(Inputs, Outputs)
{
	var quoteId = &quot;&quot;, ovrRdFlg = &quot;N&quot;, twoWayBS = null,childOrdBC = null, chRec=null, inp= null, out=null;
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null)
		{
			childOrdBC = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;VHA Order Entry Parent Orders SSJ&quot;);
			twoWayBS = TheApplication().GetService(&quot;VHA Two Way SMS Service&quot;);
			inp = TheApplication().NewPropertySet();
			out = TheApplication().NewPropertySet();
			with(childOrdBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Quote Id&quot;);
				SetSearchSpec(&quot;Quote Id&quot;,quoteId);
				ExecuteQuery(ForwardOnly);
				chRec = FirstRecord();
				while(chRec)
				{
					inp.Reset();
					out.Reset();
					inp.SetProperty(&quot;Order Id&quot;, GetFieldValue(&quot;Id&quot;)); //pass child order record row-id
					twoWayBS.InvokeMethod(&quot;CheckTwoWaySMSEligibility&quot;, inp, out);
					
					chRec = NextRecord();
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		childOrdBC = null;
		twoWayBS = null;
		childOrdBC = null;
		chRec=null;
		inp= null;
		out=null;
	}
}"
