			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{	
				sConfirmationCode = GetFieldValue(&quot;VHA Confirmation Code&quot;);		
				if(sConfirmationCode == &quot;&quot; || sConfirmationCode == null)
				{
					/*var sCCode = Clib.rand();
