			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPPrepaymentAllocation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPPrepaymentAllocation(Inputs, Outputs)
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sTotalPPAmnt = Inputs.GetProperty(&quot;PrepaymentUpfront&quot;);
		var sTotalAccAmt = Inputs.GetProperty(&quot;PrepaymentAccessoryAmount&quot;);
		var sDeviceTotalPPAmt = ToNumber(sTotalPPAmnt) - ToNumber(sTotalAccAmt);
		var sLineItemCount = 0;
		var sDeviceRCC = 0;
		var sAllocatedAmt = 0;
		var sRemPPAmt = sDeviceTotalPPAmt;
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var bsInputs = TheApplication().NewPropertySet();
		var bsOutputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Prepayments MPP IO&quot;);
		bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[Order Entry - Orders.OrderId] = &apos;&quot;+sOrderId+&quot;&apos; AND [Order Entry - Line Items.ParentItemId] IS NULL&quot;);
		bsInputs.SetProperty(&quot;SortSpec&quot;,&quot;Order Entry - Line Items.VF Line Number(ASCENDING)&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs);
		var sId,temp,temp1,jm,im,lt;
		var sArrDevId = new Array;
		var sArrDevId1 = new Array;	
		if(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount())
		{
			sLineItemCount = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount();
			for(var i = 0; i &lt; sLineItemCount; i++)//SureshG - Added for sorting in 19.3 Prepayments
			{
				if(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount())//SureshG - 19.3 Added if condition
				{	
				sArrDevId[i]=bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;MPP RCC F&quot;);
				sArrDevId1[i]=bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;Id&quot;);
				}
			}
			
			lt = sArrDevId.length;
			for(im=0;im&lt;lt;im++)
			{
			for(jm=0;jm&lt;lt;jm++)
			{
			if(ToNumber(sArrDevId[im]) &lt; ToNumber(sArrDevId[jm]))
			{
				
			temp = sArrDevId[jm];
			sArrDevId[jm] = sArrDevId[im];
			sArrDevId[im]=temp;

			temp1 = sArrDevId1[jm];
			sArrDevId1[jm] = sArrDevId1[im];
			sArrDevId1[im]=temp1;
			temp=0;
			temp1=&quot;&quot;;
			}			
			}
			}

			for (var z=0;z&lt;lt;z++)
			{
			
			for(var i = 0; i &lt; sLineItemCount; i++)
			{
				if(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount())//SureshG - 19.3 Added if condition
				{
				sId = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;Id&quot;);
				
				if(sArrDevId1[z] == sId)
				{		
				
				sDeviceRCC = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;MPP RCC F&quot;);
				
				
				
				if(sDeviceRCC &gt; 0)
				{
					if(sRemPPAmt &gt; 0)
					{
						if((sRemPPAmt - sDeviceRCC) &gt;= 0)
						{
							sAllocatedAmt = sDeviceRCC;
							bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).SetProperty(&quot;MPP Pay To Dealer&quot;,sAllocatedAmt);
							sRemPPAmt = sRemPPAmt - sDeviceRCC;
						}
						else
						{
							bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).SetProperty(&quot;MPP Pay To Dealer&quot;,sRemPPAmt);
							sRemPPAmt = sRemPPAmt - sDeviceRCC;
						}
					}
					else
					{
						bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).SetProperty(&quot;MPP Pay To Dealer&quot;,0);
						sRemPPAmt = 0;
					}
				}
				}
				}
			}
			}
		}
		bsEAIService.InvokeMethod(&quot;Upsert&quot;, bsOutputs, psOutputs);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	}
}"
