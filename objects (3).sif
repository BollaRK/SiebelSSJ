			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetParentOrderSubType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetParentOrderSubType (sOrderId)
{
try
{
var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
var bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
var searchexpr = &quot;&quot;;
var sOrderType = &quot;&quot;;
if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
	{
		with(bcOrder)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Order Sub Type&quot;);
			ActivateField(&quot;Id&quot;);					               
			ClearToQuery();
			searchexpr = &quot;[Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			SetSearchExpr(searchexpr);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
			   		sOrderType 	= GetFieldValue(&quot;Order Sub Type&quot;);
			}
		}
	}
}

catch(e)
{
	
	throw(e);
}

finally{
	boOrder = null;
	bcOrder = null;
	
}
return(sOrderType);
}"
