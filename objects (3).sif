			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="AddSFJOfferHistory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function AddSFJOfferHistory(Inputs, Outputs) 
{
var aAssetIntegId = &quot;&quot;,boOrder = null,aRootOrderItmId = &quot;&quot;,sStatus = &quot;&quot;, bcOrder = null, TBUIBC= null,OfferBC=null, bIsLineItm=&quot;&quot;;
	try 
	{
       var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
        bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
        //bsOfferManagement = TheApplication().GetService(&quot;VF Offer Management&quot;);
		TBUIBC = boOrder.GetBusComp(&quot;VF Order Entry - Line Items - Primary Product - TBUI&quot;);
		OfferBC = boOrder.GetBusComp(&quot;VF Available Offers TBUI&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
        if (sOrderId != &quot;&quot; &amp;&amp; sOrderId != null) 
		{
            with (bcOrder) 
			{
                ActivateField(&quot;Id&quot;);
                ClearToQuery();
                SetViewMode(AllView);
                SetSearchExpr(&quot;[Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
                ExecuteQuery(ForwardOnly);
                if (FirstRecord()) 
				{
					with (TBUIBC)
					{
					ClearToQuery();
					SetViewMode(AllView);
					ExecuteQuery(ForwardOnly);
					bIsLineItm = FirstRecord();
                    while (bIsLineItm) 
					{
						TheApplication().SetProfileAttr(&quot;VFAvailableOfferLoadApplet&quot;,&quot;Y&quot;);
                        with (OfferBC)
						{
							ClearToQuery();
							SetViewMode(AllView);
							ExecuteQuery(ForwardBackward);
						}
						bIsLineItm = NextRecord();	   
                    }
					
					}
                }
            }
        }
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        TBUIBC = null;
        boOrder = null;
    }
} 
"
			   SEQUENCE="1"
			   UPDATED="03/17/2026 01:37:02"
