			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrimaryMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrimaryMSISDN (Inputs, Outputs)
{
	try 
	{
		
		var psErrorInput, psErrorOutput, sErrorMessage, bsError;


	// Variable declaration
	
	
	//Customer Account BusObj &amp; BusComp &amp; vars
		var oAccountBO, oAccountBC;
		var sCA_AccountId, sCA_AccountType, sCA_BusinessName, sCA_TradingName,
			sCA_Password, sCA_PhoneNumber, sCA_FaxNumber, sCA_EmailAddress,
			sCA_ReceiveInfo, sCA_PrimaryContactId;		
	
	//Contact
		var oContactBO, oContactBC,sCA_AccountId;
		var sCO_Title, sCO_FirstName, sCO_MiddleName, sCO_LastName, sCO_Gender,
			sCO_BirthDate, sCO_Email, sCO_HomePhone, sCO_WorkPhone, sCO_FaxPhone,
			sCO_LegalEntityFlag,sCO_HomePhone1;
		
	
	
		var intret = ContinueOperation;

					
		// Retrieve Input Parameters
		sCA_AccountId = Inputs.GetProperty(&quot;Account Id&quot;); 
		
	
	//start CA	
		//get account object*/	
		oAccountBO = TheApplication().GetBusObject(&quot;Account&quot;);
		oAccountBC = oAccountBO.GetBusComp(&quot;Account&quot;);
			
		with(oAccountBC)
		{
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Business Name&quot;);
			ActivateField(&quot;Alias&quot;);
			ActivateField(&quot;Password&quot;);
			ActivateField(&quot;Main Phone Number&quot;);
			ActivateField(&quot;Main Fax Number&quot;);
			ActivateField(&quot;Main Email Address&quot;);
			ActivateField(&quot;Receive Info on Special Offers&quot;);
			ActivateField(&quot;Primary Contact Id&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;,sCA_AccountId);
			ExecuteQuery(ForwardBackward);
		}
			
		if (oAccountBC.FirstRecord())
		{
			sCA_AccountType = oAccountBC.GetFieldValue(&quot;Type&quot;);
			sCA_BusinessName = oAccountBC.GetFieldValue(&quot;Business Name&quot;);
			sCA_TradingName = oAccountBC.GetFieldValue(&quot;Alias&quot;);
			sCA_Password = oAccountBC.GetFieldValue(&quot;Password&quot;);
			sCA_PhoneNumber = oAccountBC.GetFieldValue(&quot;Main Phone Number&quot;);
			sCA_FaxNumber = oAccountBC.GetFieldValue(&quot;Main Fax Number&quot;);
			sCA_EmailAddress = oAccountBC.GetFieldValue(&quot;Main Email Address&quot;);
			sCA_ReceiveInfo = oAccountBC.GetFieldValue(&quot;Receive Info on Special Offers&quot;);	
			
			sCA_PrimaryContactId = oAccountBC.GetFieldValue(&quot;Primary Contact Id&quot;);
		}
	//end CA
	
	
	//start CO	
		//get contact object	
		oContactBO = TheApplication().GetBusObject(&quot;Contact&quot;);
		oContactBC = oContactBO.GetBusComp(&quot;Contact&quot;);
			
		with(oContactBC)
		{
			ActivateField(&quot;M/M&quot;);
			ActivateField(&quot;First Name&quot;);
			ActivateField(&quot;Middle Name&quot;);
			ActivateField(&quot;Last Name&quot;);
			ActivateField(&quot;M/F&quot;);
			ActivateField(&quot;Birth Date&quot;);
			ActivateField(&quot;Email Address&quot;);
			ActivateField(&quot;Home Phone #&quot;);
			ActivateField(&quot;Work Phone #&quot;);
			ActivateField(&quot;Fax Phone #&quot;);
			ActivateField(&quot;VF Account Primary Contact Calc&quot;);
						
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;,sCA_PrimaryContactId);
			ExecuteQuery(ForwardBackward);
		}
			
		if (oContactBC.FirstRecord())
		{
			sCO_Title = oContactBC.GetFieldValue(&quot;M/M&quot;);
			sCO_FirstName = oContactBC.GetFieldValue(&quot;First Name&quot;);
			sCO_MiddleName = oContactBC.GetFieldValue(&quot;Middle Name&quot;);
			sCO_LastName = oContactBC.GetFieldValue(&quot;Last Name&quot;);
			sCO_Gender = oContactBC.GetFieldValue(&quot;M/F&quot;);
			sCO_BirthDate = oContactBC.GetFieldValue(&quot;Birth Date&quot;);
			sCO_Email = oContactBC.GetFieldValue(&quot;Email Address&quot;);
			sCO_HomePhone = oContactBC.GetFieldValue(&quot;Home Phone #&quot;);
			sCO_WorkPhone = oContactBC.GetFieldValue(&quot;Work Phone #&quot;);
			sCO_FaxPhone = oContactBC.GetFieldValue(&quot;Fax Phone #&quot;);
			
			sCO_LegalEntityFlag = oContactBC.GetFieldValue(&quot;VF Account Primary Contact Calc&quot;);
		}
	//end CO	
	
			if((sCO_HomePhone.substring(0,3) == &quot;614&quot;) &amp;&amp; (sCO_HomePhone.length == &quot;11&quot;))
			{
			sCO_HomePhone1 = sCO_HomePhone;
			}
			else if((sCO_HomePhone.substring(0,2) == &quot;04&quot;) &amp;&amp; (sCO_HomePhone.length == &quot;10&quot;))
			{
			var sPh = sCO_HomePhone.substr(0,2);
			sCO_HomePhone1 = sCO_HomePhone.replace(sPh,&quot;614&quot;);
			}
			else 
			{
			sCO_HomePhone1 = &quot;&quot;;
			}	

	Outputs.SetProperty(&quot;Home Phone&quot;, sCO_HomePhone1);
	Outputs.SetProperty(&quot;FirstName&quot;, sCO_FirstName);
	Outputs.SetProperty(&quot;ContactEmailAddress&quot;, sCO_Email);
	Outputs.SetProperty(&quot;ContactPhoneNo&quot;, sCO_HomePhone);

		intret = CancelOperation;
		
	}
	
	catch (e)
	{
			
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;NBN Send SMS&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;GetPrimaryMSISDN&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);

		

		//throw (sErrorMessage);
	}
	finally
	{
		
		/*oOrdEntBO = null;
		oOrdEntOrdsBC = null;
		oOrdEntLineItemsBC = null;
		oBillAccountBC = null;  /* This variable is nullified by JAGJIT on 29/03/2019*/
		/*oBillProfileBC = null;  /* This variable is nullified by JAGJIT on 29/03/2019*/
		/*oContactBC = null;/* This variable is nullified by JAGJIT on 29/03/2019*/
		/*oAccountBC = null;
		/*oAccountBO = null;
		oBillAccountBO = null;  /* This variable is nullified by JAGJIT on 29/03/2019*/
		/*oContactBO = null;  /* This variable is nullified by JAGJIT on 29/03/2019*/
		// destroy std vars
		/*sErrorMessage = null;
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;*/
	}
}"
