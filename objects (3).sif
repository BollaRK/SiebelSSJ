			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetFWAFlowName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetFWAFlowName(sOrderId,bcOrd)
{
try
{
            bcOrd.SetViewMode(AllView);
			bcOrd.ClearToQuery();
			bcOrd.ActivateField(&quot;Id&quot;);
			bcOrd.ActivateField(&quot;Order Sub Type&quot;);
			bcOrd.ActivateField(&quot;VHA FWA Indentifier&quot;);
			bcOrd.SetSearchSpec(&quot;Id&quot;,sOrderId);
			bcOrd.SetSearchSpec(&quot;Order Sub Type&quot;,&quot;Connect&quot;);
			bcOrd.ExecuteQuery(ForwardOnly);
			if(bcOrd.FirstRecord())
			{
			var sFWAFlow = bcOrd.GetFieldValue(&quot;VHA FWA Indentifier&quot;);
			}
			return(sFWAFlow);
}//try
catch(e)
	{
	throw e;
	}
	finally
	{
		
	}
}"
