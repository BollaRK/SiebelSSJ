			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateShippingDetail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateShippingDetail(Inputs, Outputs)
{
//Aarthi-06/11/2015: Added for T&amp;T2
	try{
		
		var sEmailAdd = Inputs.GetProperty(&quot;ShipEmailId&quot;);
		var sNotificationMSISDN = Inputs.GetProperty(&quot;ShipNotificationMSISDN&quot;);
		var emailAddress = Inputs.GetProperty(&quot;ShipEmailId&quot;);
		var sNotificationMethod = Inputs.GetProperty(&quot;ShipNotificationMethod&quot;);
		
		switch(sNotificationMethod)
		{
		case &quot;TXT&quot;:
				if (sNotificationMSISDN == &quot;&quot; || sNotificationMSISDN == null)
				{
					throw(&quot;Notification MSISDN is a required field&quot;);
				}						
			break;
		case &quot;Email and TXT&quot;:
				if (sEmailAdd == &quot;&quot; || sNotificationMSISDN == &quot;&quot;)
				{
					throw(&quot;Tracking Email and Notification MSISDN are required fields&quot;);
				}					
			break;
		case &quot;Email&quot;:
				if (sEmailAdd == &quot;&quot; || sEmailAdd == null)
				{
					throw(&quot;Tracking Email is a required field&quot;);
				}	
			break;			
		default:
			break;
		}	
			
			var errorMsg1 = &quot;93000&quot;;
			var errorMsg2 = &quot;93001&quot;;
			var errorMsg3 = &quot;93002&quot;;
			var errorMsg4 = &quot;93003&quot;;
			var errorMsg5 = &quot;93004&quot;;
			var errorMsg6 = &quot;93005&quot;;
			var sErrorMessage;
				
			var indexNo = emailAddress.indexOf(&apos;@&apos;);
			var subStr=&quot;&quot;;
			var firstChar =emailAddress.charAt(0);
			var lastChar =emailAddress.charAt(emailAddress.length - 1);
		if(sNotificationMethod != &quot;None&quot;)
		{
			if(emailAddress.length &gt; 0)
			{
				if(emailAddress.length &gt; indexNo+1)
				{		
					subStr = emailAddress.substring(indexNo+1);
				}
	
				if( indexNo &lt; 0 || subStr.indexOf(&apos;@&apos;) &gt;= 0)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg1);
					throw (&quot;VFErrorCode#&quot; +	errorMsg1 + &quot;-&quot; + sErrorMessage);				
				}
	
				if( emailAddress.indexOf(&apos;.&apos;) &lt; 0)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg2);
					throw (&quot;VFErrorCode#&quot; +	errorMsg2 + &quot;-&quot; + sErrorMessage);
				}
	
				if( emailAddress.indexOf(&apos; &apos;) &gt;= 0)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg3);
					throw (&quot;VFErrorCode#&quot; +	errorMsg3 + &quot;-&quot; + sErrorMessage);
				}
	
				//checking for consecutive &apos;.&apos; characters
					var i = emailAddress.indexOf(&apos;..&apos;);
				
				if( i != -1)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg4);
					throw (&quot;VFErrorCode#&quot; +	errorMsg4 + &quot;-&quot; + sErrorMessage);
				}
				if( firstChar == &quot;.&quot;)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg5);
					throw (&quot;VFErrorCode#&quot; +	errorMsg5 + &quot;-&quot; + sErrorMessage);
				}
				if( lastChar == &quot;.&quot;)
				{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg6);
					throw (&quot;VFErrorCode#&quot; +	errorMsg6 + &quot;-&quot; + sErrorMessage);
				}
		
				
			}
			if(sNotificationMSISDN != &quot;&quot;)
				{
					if (sNotificationMSISDN.indexOf(&quot; &quot;) &gt; 0)
					{				
							throw(&quot;Notification MSISDN must be entered with no spaces.&quot;);
					}
		
					// Check there are no brackets
					if ((sNotificationMSISDN.indexOf(&quot;(&quot;) &gt; 0) || (sNotificationMSISDN.indexOf(&quot;)&quot;) &gt; 0))
					{
							throw(&quot;Notification MSISDN must be entered with no brackets.&quot;);
		
					}
					if (isNaN(sNotificationMSISDN))
					{
							throw(&quot;Notification MSISDN  must be numeric&quot;);
					}
						
		            if( sNotificationMSISDN.indexOf(&quot;614&quot;) != 0)
		            { 
							throw(&quot;Notification MSISDN must be starting with digits 614&quot;); 
				    }
		
					if (sNotificationMSISDN != &quot;&quot; &amp;&amp; sNotificationMSISDN.length != 11)
					{	
							throw(&quot;Notification MSISDN  must be 11 characters long.&quot;);
					}		
				}	
		}
			
		}catch(e)
		{
			TheApplication().RaiseErrorText(e);
		}
		    

}"
			   SEQUENCE="47"
