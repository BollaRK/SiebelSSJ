			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetDealerCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SetDealerCode(Inputs, Outputs)
{
	try
	{
		var boEmp = TheApplication().GetBusObject(&quot;Employee&quot;);
		var bcEmpPer = boEmp.GetBusComp(&quot;Employee&quot;);
		var bcEmp = boEmp.GetBusComp(&quot;Employee&quot;);
		var sLoginId = TheApplication().LoginId();
		var strDealerCode = &quot;&quot;;
		
		var boLOV;
		var bcLOV;
		var VCSDealer = &quot;&quot;;
		var EnableApp = &quot;&quot;;


		with(bcEmpPer)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Dealer Code&quot;);
			ActivateField(&quot;First Name&quot;);
			ActivateField(&quot;Last Name&quot;);
			SetSearchSpec(&quot;Id&quot;,sLoginId);
			ExecuteQuery(ForwardOnly);

			if (FirstRecord())
			{
				strDealerCode = GetFieldValue(&quot;VF Dealer Code&quot;);
	
				var test1 = GetFieldValue(&quot;Last Name&quot;);
				var test2 = GetFieldValue(&quot;First Name&quot;);					
				var StrLastName = GetFieldValue(&quot;Last Name&quot;);
				var StrInitial = StrLastName.substring(0,1);

				//TheApplication().SetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;, GetFieldValue(&quot;First Name&quot;) +&quot;\r\r&quot;+ StrInitial);
				//Subramanian 25.11.14: Commented the above code as part of BFX17 retrofit.
				TheApplication().SetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;, GetFieldValue(&quot;First Name&quot;) +&quot; &quot;+ StrInitial);				
				var test3 = TheApplication().GetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;);
			}
		}

		if(strDealerCode != &quot;&quot;)
		{
			TheApplication().SetProfileAttr(&quot;VF Dealer Code Attr&quot;, strDealerCode);
			
			//Pavani: 14/08/2019 Added for SIT select APP issue - Set Dealer Profile attributes
				boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
				bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);

				with(bcLOV)
				{
					SetViewMode(AllView);
					ClearToQuery();			
					ActivateField(&quot;Low&quot;);
					ActivateField(&quot;VHA Dealer APP Enable&quot;);					
					SetSearchSpec(&quot;Type&quot;, &quot;VF_DEALER_CODE&quot;);
					SetSearchSpec(&quot;Value&quot;, strDealerCode );
					ExecuteQuery(ForwardOnly);

					if (FirstRecord())
					{
						VCSDealer = GetFieldValue(&quot;Low&quot;);
						EnableApp = GetFieldValue(&quot;VHA Dealer APP Enable&quot;);
						if(VCSDealer == &quot;VCS&quot;){
							TheApplication().SetProfileAttr(&quot;VHADealerSalesChannel&quot;,&quot;Y&quot;);//Enable APP
						}else{
							TheApplication().SetProfileAttr(&quot;VHADealerSalesChannel&quot;,&quot;N&quot;);//Check Filter Enable APP
							if(EnableApp == &quot;Y&quot;){								
								TheApplication().SetProfileAttr(&quot;VHADealerFilterAPP&quot;,&quot;Y&quot;);//FilterAPP
							}						
						}
						//Pallavi.25/11/19.Added to set profile attributes during application Channel change
						Outputs.SetProperty(&quot;SalesChannel&quot;,TheApplication().GetProfileAttr(&quot;VHADealerSalesChannel&quot;));
						Outputs.SetProperty(&quot;FilterApp&quot;,TheApplication().GetProfileAttr(&quot;VHADealerFilterAPP&quot;));
					}
				}//bcParam
				//Pavani: 14/08/2019 Added for SIT select APP issue - Code End
		}
		else
		{
			TheApplication().SetProfileAttr(&quot;VF Dealer Code Attr&quot;, &quot;No Match Row Id&quot;);
		}
		
		//Pavani:08/11/2019 Moved below code from Power Comm App Start to here
		
			if (mGetSysPref(&quot;VFDealerFB&quot;)==&quot;TRUE&quot;) {
				TheApplication().SetProfileAttr(&quot;VF Dealer FB&quot;, &quot;Y&quot;);
			} else {
				TheApplication().SetProfileAttr(&quot;VF Dealer FB&quot;, &quot;N&quot;);
			}
			Outputs.SetProperty(&quot;VFDealer&quot;,TheApplication().GetProfileAttr(&quot;VF Dealer FB&quot;));

			var	psOutputs = TheApplication().NewPropertySet(); // added by Sanjeev
			TheApplication().SetProfileAttr(&quot;CustomerId&quot;,&quot;XA1&quot;);
			TheApplication().SetProfileAttr(&quot;VFContactId&quot;,&quot;XB2&quot;);
			TheApplication().SetProfileAttr(&quot;VFAssetId&quot;,&quot;XC3&quot;);
			TheApplication().SetProfileAttr(&quot;VFBillingAccountId&quot;,&quot;XD4&quot;);
			
			// VML 18/05/05:  Add profile attribute for Connection view
			TheApplication().SetProfileAttr(&quot;VFConnectionAccountId&quot;,&quot;XE5&quot;);
	
			// RNZ 24/05/05:  Add profile attribute for Disconnection button
			// VHA NandhiniG 21/02/20202 : Added If condition for Discconect button enable issue for Care users
			if (TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Retail&quot;))
				TheApplication().SetProfileAttr(&quot;VFPartnerApplUser&quot;,&quot;Y&quot;);
			else
				TheApplication().SetProfileAttr(&quot;VFPartnerApplUser&quot;,&quot;N&quot;);
			//ENDS HERE
		
			var sId = TheApplication().LoginId();
			// set the PAS profile from master dealer
	
			bcEmp.SetViewMode(AllView);			
			bcEmp.ClearToQuery();
			bcEmp.ActivateField(&quot;VF Port Initiation User Id&quot;);
			bcEmp.ActivateField(&quot;VF Sales Channel Code&quot;);			
			bcEmp.ActivateField(&quot;VF Business Group Code&quot;);
			bcEmp.ActivateField(&quot;VF Dealer Row Id&quot;);
			bcEmp.SetSearchSpec(&quot;Id&quot;, sId);			
			bcEmp.ExecuteQuery(ForwardOnly);
			
			if (bcEmp.FirstRecord())
			{
					// check if master dealer
					var sDealerRowID = bcEmp.GetFieldValue(&quot;VF Dealer Row Id&quot;);		
					if ( sId != sDealerRowID )
					{
						// get the PAS profile from master dealer
						mGetMasterPASProfile(sDealerRowID,psOutputs)
						var sPort = psOutputs.GetProperty(&quot;PortInitiation&quot;);
						var sSales = psOutputs.GetProperty(&quot;SalesChannel&quot;);
						var sBusiness = psOutputs.GetProperty(&quot;BusinessGroup&quot;);
						
						bcEmp.SetFieldValue(&quot;VF Port Initiation User Id&quot;,sPort);
						bcEmp.SetFieldValue(&quot;VF Sales Channel Code&quot;,sSales);			
						bcEmp.SetFieldValue(&quot;VF Business Group Code&quot;,sBusiness);
						bcEmp.WriteRecord();
					}
				}
			//Pavani:08/11/2019 Moved below code from Power Comm App Start to here -- Code End
			
		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcEmpPer = null;
		bcEmp = null;
      	boEmp = null;
		bcLOV = null;
		boLOV = null;
	}
}"
			   SEQUENCE="30"
			   UPDATED="12/22/2025 22:23:09"
			   UPDATED_BY="GANESHR"
			   CREATED="07/12/2014 00:14:38"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetDealerProfAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SetDealerProfAttr()
{
/************************************************************************
/* Component Name        : 	Siebel Power Communications
/* Method Name           : 	SetDealerProfAttr
/* Component Information : 	This function is used to set profile attributes
/*							for the dealer
/* Project Name			 : 	Paperless In Stores / CVM
/* Modification History  :
/* Date			Author		Config #	Description
/* ============ ===========	===========	================================
/* 14/06/2011   VIJAY                 Initial Version
/* 05/07/2011	XA			CR09	  URL based on Dealer/Retailer
/* 26/03/2012	EW					  Renamed function from &apos;IsDealerEligibleForIDScan&apos;, updated for CVM, and cleaned up
/* 22/11/2019	Christy				  Moved this code from Application Start through RTE

/************************************************************************/

	var boEmp, boLOV;
	var bcEmp, bcLOV;
	
	var sLogInName, sDealerCode;	
	var sIdScanType = &quot;&quot;;
	var VCSDealer = &quot;&quot;;
	var EnableApp = &quot;&quot;;
	try
	{
		TheApplication().SetProfileAttr(&quot;IsDealerEnableForIdScan&quot;, &quot;FALSE&quot;);
				
		sLogInName = TheApplication().LoginName();
				
		if (sLogInName != &quot;&quot;)
		{
			boEmp = TheApplication().GetBusObject(&quot;Employee&quot;);
			bcEmp = boEmp.GetBusComp(&quot;Employee&quot;);
			
			with (bcEmp)
			{
				SetViewMode(AllView);
				ClearToQuery();
					ActivateField(&quot;VF Dealer Code&quot;);
					SetSearchSpec(&quot;Login Name&quot;, sLogInName);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						sDealerCode = GetFieldValue(&quot;VF Dealer Code&quot;);
					}
			}//bcEmp
	
			if (sDealerCode != &quot;&quot;)
			{
				boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
				bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);

				with(bcLOV)
				{
					SetViewMode(AllView);
					ClearToQuery();

					ActivateField(&quot;VF Scanner Enable Type&quot;);
					ActivateField(&quot;Type&quot;);
					ActivateField(&quot;Value&quot;);
					ActivateField(&quot;Low&quot;);
					ActivateField(&quot;VHA Dealer APP Enable&quot;);
					SetSearchSpec(&quot;Type&quot;, &quot;VF_DEALER_CODE&quot;);
					SetSearchSpec(&quot;Value&quot;, sDealerCode );
					ExecuteQuery(ForwardOnly);

					if (FirstRecord())
					{
						sIdScanType = GetFieldValue(&quot;VF Scanner Enable Type&quot;);

						if (TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Retail&quot;))
						{
							VCSDealer = GetFieldValue(&quot;Low&quot;);
							EnableApp = GetFieldValue(&quot;VHA Dealer APP Enable&quot;);
							if(VCSDealer == &quot;VCS&quot;)
							{
								TheApplication().SetProfileAttr(&quot;VHADealerSalesChannel&quot;,&quot;Y&quot;);//Enable APP
								
							}
							else
							{
								TheApplication().SetProfileAttr(&quot;VHADealerSalesChannel&quot;,&quot;N&quot;);//Check Filter Enable APP
								if(EnableApp == &quot;Y&quot;)
								{								
								TheApplication().SetProfileAttr(&quot;VHADealerFilterAPP&quot;,&quot;Y&quot;);//FilterAPP
								
								}
							}

						}								
						
					}
				}//bcParam
			}//sDealerCode
					
			if(sIdScanType != &quot;Disabled&quot; &amp;&amp; sIdScanType != &quot;&quot; )
			{
				TheApplication().SetProfileAttr(&quot;IsDealerEnableForIdScan&quot;,&quot;TRUE&quot;);
			}
					
			TheApplication().SetProfileAttr(&quot;DealerCodeForIDScan&quot;,sDealerCode);
		}

	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcLOV	=	null;
		boLOV	=	null;
		bcEmp	=	null;
		boEmp	=	null;
	}
}"
