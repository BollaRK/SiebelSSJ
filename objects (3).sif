			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDigitalEmailCheck"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDigitalEmailCheck(Inputs,Outputs)
{
try
{
	var sBO = TheApplication().GetBusObject(&quot;Contact&quot;);
	var sBC = sBO.GetBusComp(&quot;Contact&quot;);
	var emailAddress = Inputs.GetProperty(&quot;sEmail&quot;);	
	if(emailAddress != &quot;&quot; &amp;&amp; emailAddress != null)
	{
		with(sBC)
		{
			ActivateField(&quot;Digital Username&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Digital Username&quot;,emailAddress);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				//TheApplication().SetProfileAttr(&quot;DigUNameCheck&quot;,&quot;Y&quot;);
				throw(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_DigitalName_Check&quot;));
			}
		}
	}
}	
catch(e)
{
	TheApplication().RaiseErrorText(e);
}
finally
	{
		sBC = null;
		sBO = null;
	}

}"
