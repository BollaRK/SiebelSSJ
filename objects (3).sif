function mDeletePrepaymentContracts(Inputs, Outputs)
{
		
	
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sPrepayment = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sContract = sBO.GetBusComp(&quot;VHA Prepayment Contract Summary&quot;);
		var sPrepayId = &quot;&quot;;
		var isrec = &quot;&quot;;
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{
			
			with(sPrepayment)
			{			                 
               ActivateField(&quot;Id&quot;);
               ActivateField(&quot;Order Id&quot;);               
               SetViewMode(AllView);
		       ClearToQuery();
               SetSearchSpec(&quot;Order Id&quot;, sOrderId);
               ExecuteQuery(ForwardOnly);               
				if (FirstRecord())
				{
					sPrepayId = GetFieldValue(&quot;Id&quot;);
					
				}
			
			}
			if(sPrepayId != null &amp;&amp; sPrepayId != &quot;&quot;)
			{
				with(sContract)
				{
				   ActivateField(&quot;Id&quot;);
	               ActivateField(&quot;Prepayment Id&quot;);               
	               SetViewMode(AllView);
			       ClearToQuery();
	               SetSearchSpec(&quot;Prepayment Id&quot;, sPrepayId);
	               ExecuteQuery();
				   isrec = FirstRecord()   
				   
					while(isrec)
					{
						DeleteRecord();
						isrec = FirstRecord();
					}
					
				}
			}
		}				
		
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderId = null;
		sBO = null;
		isrec = null;
		sPrepayment = null;
		sContract = null;
		sPrepayId = null;
	
	}
}
