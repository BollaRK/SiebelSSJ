			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateBillingDetail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateBillingDetail(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateBillingDetail
	* Method Name           : 	
	* Component Information : 	Validates billing details are correct
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 04/06/2014		Neel						Initial Version - Cloned from VF Wizard Utilities
	*/
	var bcWizSession, bcBillingProfile, bcAccount, bcFinanProf,boCurrent;
	var sCustomerType;
	var sWizType;
	var sAccountType;
	var sIntendedUsage;
	var sOrderId;
	var sAccountId;
	var sRaiseError = &quot;N&quot;;
	var StrPaymentMethod;
	var StrPaymentType;
	var pBankBranch;
	var pBankAcctNum;
	var pBankAcctName;
	var sBillinMSISDN;
	var sConnectFBB;
	var DummyMSISDN;
	var DOMOverrideResp = &quot;N&quot;; //Rinu - 19/0/2018 - Added for 18.3 CR
	
	try
	{
		//boCurrent = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		//bcAccount = boCurrent.GetBusComp(&quot;Account&quot;);
		//bcFinanProf = boCurrent.GetBusComp(&quot;VF Com Financial Profile&quot;);
		//bcBillingProfile = boCurrent.GetBusComp(&quot;Com Invoice Profile&quot;);
		
		sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		sCustomerType = Inputs.GetProperty(&quot;CustomerType&quot;);//New or Existing
		//sOrderId =Inputs.GetProperty(&quot;OrderId&quot;); //Added to check if order exists -- sibi
		sWizType =  Inputs.GetProperty(&quot;Scenario&quot;);
		sAccountType = Inputs.GetProperty(&quot;AccountType&quot;);//this is out customer type
		sIntendedUsage = Inputs.GetProperty(&quot;VF Intended Usage&quot;);
		StrPaymentType = Inputs.GetProperty(&quot;Payment Type&quot;);
		StrPaymentMethod = Inputs.GetProperty(&quot;Payment Method&quot;);
		pBankBranch = Inputs.GetProperty(&quot;BankBranch&quot;);
		pBankAcctNum = Inputs.GetProperty(&quot;BankAcctNum&quot;);
		pBankAcctName = Inputs.GetProperty(&quot;BankAcctName&quot;);
		sBillinMSISDN = Inputs.GetProperty(&quot;BillingNotiMSISDN&quot;);
		sConnectFBB = Inputs.GetProperty(&quot;ConnectFBB&quot;);
		DummyMSISDN = Inputs.GetProperty(&quot;DummyMSISDN&quot;);
		DOMOverrideResp = Inputs.GetProperty(&quot;DOMOverrideResp&quot;); // VHA Aruns 8/Aug/2018 : Added for PKE000000060904
		
	//	with(bcAccount)
	//	{
		//	ClearToQuery();
		//	SetViewMode(AllView);
		//	SetSearchSpec(&quot;Id&quot;, sAccountId);
		//	ExecuteQuery(ForwardOnly); 
		//	if(FirstRecord())
		//	{
			//	sIntendedUsage = Inputs.GetProperty(&quot;VF Intended Usage&quot;);
				// If the customer is new
				if (sCustomerType == &quot;New&quot; &amp;&amp; sAccountType == &quot;Person&quot; &amp;&amp; sIntendedUsage == &quot;Private&quot; &amp;&amp; DOMOverrideResp != &quot;Y&quot;)
				{			
					// bcBillingProfile = boCurrent.GetBusComp(&quot;Com Invoice Profile&quot;);
				
					// If a billing payment type of &apos;Other&apos; is selected			
					if (StrPaymentType == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PAY_TYPE&quot;, &quot;Other&quot;)) //Rinu - 19/0/2018 - Added &apos;AND&apos; for 18.3 CR
					{
 						//Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;New customers are not permitted to have a payment type of &apos;Other&apos;. Please modify before proceeding.&quot;);
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;New customers are not allowed to have a payment type of &apos;Other&apos;. Please modify the payment type field&quot;);
						sRaiseError = &quot;Y&quot;;
						//return (&quot;New customers are not allowed to have a payment type of &apos;Other&apos;.  Please modify the payment type field.&quot;);
					}
				}	
				if(sBillinMSISDN == DummyMSISDN &amp;&amp; sConnectFBB == &quot;Y&quot;)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;Enter a Valid Notification MSISDN&quot;);
					sRaiseError = &quot;Y&quot;;
				}
				//Added for Direct Debit required fields check
				if(StrPaymentType == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PAY_TYPE&quot;, &quot;Direct Debit&quot;))
				{
					if(pBankBranch == &quot;&quot; || pBankBranch == null)
						{
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;Bank Branch is Required Field. Please enter the value to Proceed...&quot;);
						sRaiseError = &quot;Y&quot;;
						}
					if(pBankAcctNum == &quot;&quot; || pBankAcctNum == null)
						{
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;Bank Account Number is Required Field. Please enter the value to Proceed...&quot;);
						sRaiseError = &quot;Y&quot;;
						}
					if(pBankAcctName == &quot;&quot; || pBankAcctName == null)
						{
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;Bank Account Name is Required Field. Please enter the value to Proceed...&quot;);
						sRaiseError = &quot;Y&quot;;
						}		
				}
				//End - Direct Debit required fields check
				
				//HR: 27/07/2011 If the Wizard type is Pre to Post transfer								
				//if ((sWizType == &quot;Pre to Post transfer&quot; || sCustomerType == &quot;New&quot; ) &amp;&amp; sAccountType == &quot;Person&quot; &amp;&amp; sIntendedUsage == &quot;Private&quot;)
				if (sWizType == &quot;Pre to Post transfer&quot; &amp;&amp; sAccountType == &quot;Person&quot; &amp;&amp; sIntendedUsage == &quot;Private&quot;)
				{			
				//	bcBillingProfile = boCurrent.GetBusComp(&quot;Com Invoice Profile&quot;);
					
					if (StrPaymentMethod != &quot;Postpay&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;Postpay Billing Account is Required. Please Select or Create a New Postpay Billing Account to Proceed...&quot;);
						sRaiseError = &quot;Y&quot;;
						//return (&quot;Postpay Billing Account is Required. Please Select or Create a New Postpay Billing Account to Proceed.&quot;);			
					}		
							
					// If a billing payment type of &apos;Other&apos; is selected			
					if (StrPaymentType == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PAY_TYPE&quot;, &quot;Other&quot;))
					{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;New customers are not permitted to have a payment type of &apos;Other&apos;. Please modify before proceeding.&quot;);
						// VF:Roseline 20/08/2014 - Modified the error message for QC Defect#1875
						Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;New customers are not allowed to have a payment type of &apos;Other&apos;. Please modify the payment type field.&quot;); 
						sRaiseError = &quot;Y&quot;;
						//return (&quot;New customers are not allowed to have a payment type of &apos;Other&apos;.  Please modify the payment type field.&quot;);
					}		
				}
		//	}//end if(FirstRecord())
	//	}// end of with(bcAccount)
				
		
		// WOW CIR 14.0			
		//if (sOrderId == &quot;&quot;)
		//{ 
		//	//skip this call if order is created and billing account is already associated
		//	mDefaultValuesToSelectPlanScreen(boCurrent);
		//}		
		
		if(sRaiseError == &quot;N&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;,  &quot;&quot;);
			//return (&quot;&quot;);
		}
	}
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;,  e);
	}
	finally
	{
		bcAccount = null;
		bcFinanProf = null;
	 	bcBillingProfile = null;
 		bcWizSession = null;
	}
}"
