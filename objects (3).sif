			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fUpdateRtActCd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fUpdateRtActCd(Inputs, Outputs) 
{
    var sOrderId = &quot;&quot;,boOrder = null,sBCOrder = null,bcOrderLineIt = null,rootId = &quot;&quot;,sActionCd = &quot;&quot;;
    try 
	{
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        rootId = Inputs.GetProperty(&quot;RootItemId&quot;);
		boOrder = TheApplication().GetBusObject(&quot;Order Item&quot;);
        bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		if( sOrderId != &quot;&quot; &amp;&amp; sOrderId != null &amp;&amp; rootId != null &amp;&amp; rootId != &quot;&quot;)
		{
			with (bcOrderLineIt) 
			{
	            
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + rootId + &quot;&apos;AND ([Action Code] = &apos;-&apos;)&quot;);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sActionCd = &quot;Existing&quot;;
					SetFieldValue(&quot;Action Code&quot;,&quot;Update&quot;);
					WriteRecord();
				}
	            else
					sActionCd = &quot;Update&quot;;//Added to fix CM-3838
	        }
        }          
		Outputs.SetProperty(&quot;sActionCd&quot;,sActionCd);
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		sOrderId = null;
	    boOrder = null;
	    sBCOrder = null;
	    bcOrderLineIt = null;
	    rootId = null;
	}
}"
