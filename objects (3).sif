			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidatePromoCodeOfferHist"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidatePromoCodeOfferHist(Inputs, Outputs)
{
/*
 * Component Name        : Order Entry - Orders
 * Method Name           : mValidatePromoCodeOfferHist()
 * Component Information : To check if promo code added in offer history.
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 08-04-2019	SK						To check if promo code added in offer history			
 */

 	try
	{
		var sOrderLIBO,sOrderLIBC,sOfferBO,sOfferBC;
		var searchst;
		var searchst1;
		var isRecord;
		var isRec;
		var sPromoCode,sEndDate,sStatus,sToday,sFinalEndDate,sCustAssetIntegId;
		var sSharingAsset;
		var sErrMessage=&quot;&quot;;
		var sBSErrorFlg=&quot;&quot;;
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;); 
     	sOrderLIBO = TheApplication().GetBusObject(&quot;Order Entry - Line Items&quot;);
     	sOrderLIBC = sOrderLIBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
		
		if (sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
	     	with(sOrderLIBC)
	     	{
	     		sOrderLIBC.SetViewMode(AllView);
				sOrderLIBC.ActivateField(&quot;Order Header Id&quot;);
				sOrderLIBC.ActivateField(&quot;Custom Asset Integration Id&quot;);
				sOrderLIBC.ActivateField(&quot;Parent Order Item Id&quot;);	
				sOrderLIBC.ActivateField(&quot;Action Code&quot;);	
				sOrderLIBC.ActivateField(&quot;Promo Code&quot;);
				sOrderLIBC.ClearToQuery();
				searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;; 
				sOrderLIBC.SetSearchExpr(searchst);
				sOrderLIBC.ExecuteQuery(ForwardOnly);	
				isRecord = sOrderLIBC.FirstRecord(); 
				while(isRecord) 
				{
					sPromoCode = sOrderLIBC.GetFieldValue(&quot;Promo Code&quot;);
					sCustAssetIntegId = sOrderLIBC.GetFieldValue(&quot;Custom Asset Integration Id&quot;);
					if(sPromoCode != &quot;&quot; &amp;&amp; sPromoCode != null) //Roseline 20/05/2015 - Added
					{
						sOfferBO = TheApplication().GetBusObject(&quot;VHA Hat Cat BO&quot;);
						sOfferBC = sOfferBO.GetBusComp(&quot;VF Offer History&quot;);
						sOfferBC.SetViewMode(AllView);
						sOfferBC.ActivateField(&quot;Promo Code&quot;);
						sOfferBC.ActivateField(&quot;Asset Integration Id&quot;);
						sOfferBC.ClearToQuery();
						searchst1 = &quot;[Promo Code] ~= &apos;&quot; + sPromoCode + &quot;&apos; AND [Asset Integration Id] = &apos;&quot;+sCustAssetIntegId+&quot;&apos;&quot;;
						sOfferBC.SetSearchExpr(searchst1);
						sOfferBC.ExecuteQuery(ForwardOnly);
						isRec = sOfferBC.FirstRecord(); 
					
						if(isRec)
						{	
							Outputs.SetProperty(&quot;Error Message&quot;,&quot;&quot;);
							Outputs.SetProperty(&quot;BSErrorFlg&quot;,&quot;&quot;);
						}
						else {
							sErrMessage = &quot;VFOrderValidation#00223&quot;;
							// + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;00222&quot;);
							Outputs.SetProperty(&quot;Error Message&quot;,sErrMessage);
							Outputs.SetProperty(&quot;BSErrorFlg&quot;,&quot;Y&quot;);
						}
					} //if(sPromoCode != null || sPromoCode!= &quot;&quot;)
					isRecord = sOrderLIBC.NextRecord(); 
					
				} //while
			}//	with(sOrderBC)  
			if (sBSErrorFlg == &quot;Y&quot;)
			{
				
			}
			else {
				
			}			
		}
              return(CancelOperation);
	} //try
	catch (e)
	{
     throw(e);	
	}
	finally
	{
	    sOfferBC = null;
	    sOfferBO = null; 	
	  	sOrderLIBC = null;
      	sOrderLIBO = null;
	}	
	return(ContinueOperation);
}"
