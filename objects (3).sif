			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckForOpenOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckForOpenOrder(Inputs, Outputs)
{
	var boOrderEntry;
	var bcOrderLineItemAsset;
	var sSearchExpr;
	var strAssetIntId;
	var strOrderExists = &quot;N&quot;;
	
	try
	{		
		// Get the integration id
		strAssetIntId = Inputs.GetProperty(&quot;AssetIntegId&quot;);

		sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +strAssetIntId+ &quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Status] &lt;&gt; &apos;Cancelled&apos;&quot;;
		
		
		// Setup business object and component
		boOrderEntry = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		bcOrderLineItemAsset = boOrderEntry.GetBusComp(&quot;Order Entry - Line Item (Asset Based)&quot;);
		
		bcOrderLineItemAsset.ClearToQuery();
		bcOrderLineItemAsset.ActivateField(&quot;Asset Integration Id&quot;);
		bcOrderLineItemAsset.ActivateField(&quot;Status&quot;);
		bcOrderLineItemAsset.SetSearchExpr(sSearchExpr);	

		bcOrderLineItemAsset.ExecuteQuery(ForwardOnly);
		
		// If a record is found, set the Order Exists Flag to true
		if (bcOrderLineItemAsset.FirstRecord())
		{
			strOrderExists = &quot;Y&quot;;
		}

		else
		{
            strOrderExists = &quot;N&quot;;
		}
		
	
		
		
		Outputs.SetProperty(&quot;OpenOrderExist&quot;, strOrderExists);
	}
	catch(e)
	{
		
		throw (e);
	}
	finally
	{
		bcOrderLineItemAsset = null;
		boOrderEntry = null;
		
				
	}
}"
			   SEQUENCE="27"
