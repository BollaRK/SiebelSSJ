			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF String Utilities.Service_PreInvokeMethod.MethodName=&quot; + MethodName);
		}	
	
		switch(MethodName)
		{
		
		
			case &quot;CallPrepayWF&quot;:		
				mCallPrepayWF(Inputs,Outputs);		
				break;
			

			default:
				throw (&quot;Unexpected MethodName. No processing logic present. Unknown MethodName = &quot; + MethodName);
		}
	
		return (CancelOperation);
	}
	catch(e)
	{
		// Any exceptions in this business service are raised as error text
		// but they are also set in a property, so that if it is called by 
		// another business service, it can access the actual error.
		Outputs.SetProperty(&quot;BusinessServiceError&quot;, this.Name() + &quot;: &quot; + ToString(e));
		TheApplication().RaiseErrorText(this.Name() + &quot;: &quot; + ToString(e));		
	}
	finally
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF String Utilities.Service_PreInvokeMethod.MethodName=&quot; + MethodName);
		}	
	}
}"
