			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateAsset"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateAsset(Inputs,Outputs)
{
	try
	{
		var sRatePlanValidMs = Inputs.GetProperty(&quot;ValRtPlnMinSpend&quot;);
		var sMinimumAccessFee = Inputs.GetProperty(&quot;MinAccFeeTrig&quot;);
		var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
	    var sOrdFunction1 = Inputs.GetProperty(&quot;OrderFunction&quot;);
		var offerType = Inputs.GetProperty(&quot;UpgOfferType&quot;);
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sAssetintegrationId = Inputs.GetProperty(&quot;AstIntId&quot;);
		var sOfferId = Inputs.GetProperty(&quot;OfferId&quot;);
		var sDeviceCodeTri = Inputs.GetProperty(&quot;AstDevCdTrig&quot;);
		var sMPPContractTri = Inputs.GetProperty(&quot;AstMppTermTrig&quot;);
		var RelConId = Inputs.GetProperty(&quot;RelConId&quot;);
		var sAccCode = Inputs.GetProperty(&quot;AstAccCode&quot;);
		var sRatePlan = Inputs.GetProperty(&quot;AstRatePlanTrig&quot;);
		var sSource = Inputs.GetProperty(&quot;OfferSrc&quot;);
		var promocode = Inputs.GetProperty(&quot;AstPromoCdTrig&quot;);
		var sOrderTypeTBUI = Inputs.GetProperty(&quot;OrderTypeTBUI&quot;);	
		var IsTOT=&quot;&quot;,sRewardType1=&quot;&quot;,sReturn=&quot;Valid&quot;;
		
		Outputs.SetProperty(&quot;OfferStatus&quot;, sReturn);

		if (sOrderType == &quot;Connect&quot;)
            IsTOT = mCheckTOT(sOrderId);

		sRewardType1 = mGetRewardType(sOfferId);

		if (sMinimumAccessFee != &quot;&quot; &amp;&amp; sMinimumAccessFee != null) 
		{
		    if (sRatePlanValidMs != &quot;&quot; &amp;&amp; sRatePlanValidMs != null)
		    {
		
		        if (sOrderType == &quot;Modify&quot; || sOrderType == &quot;Change Proposition&quot; || IsTOT == &quot;Y&quot;) 
				{
		            sReturn = mValidateMinimumAccessFee(sMinimumAccessFee, Inputs);
					if (sReturn == &quot;Invalid&quot; &amp;&amp; sSource!=&quot;Pega&quot;) 
					{
		                sReturn = &quot;Invalid&quot;;
		               
		            }
		        }
		    }
		}//if minaccessfee
		else if ((sMinimumAccessFee == &quot;&quot; || sMinimumAccessFee == null) &amp;&amp; ((sDeviceCodeTri != &quot;&quot; &amp;&amp; sDeviceCodeTri != null) || (sMPPContractTri != &quot;&quot; &amp;&amp; sMPPContractTri != null)) &amp;&amp; (sRewardType1 == &quot;Loyalty Discount&quot;)) 
		{
                       
	        if (sOrdFunction1 == &quot;UPGRADE&quot;) 
			{  
	            sReturn = mValidateDeviceDiscounts(sOfferId, Inputs);
	            if (sReturn == &quot;Invalid&quot; &amp;&amp; sSource!=&quot;Pega&quot;) 
					{
		                sReturn= &quot;Invalid&quot;;
		               
		            }
	        }
			else if (sOrderType == &quot;Modify&quot; || sOrderType == &quot;Change Proposition&quot;)
			{
	            sReturn= &quot;Valid&quot;;
	        }
	    }//else if
		Outputs.SetProperty(&quot;OfferStatus&quot;, sReturn);
	
		

	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
	
	}
}
"
