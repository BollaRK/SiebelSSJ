			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetUpdateStockInd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function GetUpdateStockInd(Inputs, Outputs) 
{
    var ChildOrderId = &quot;&quot;, bcOrder = null, QuoteId = &quot;&quot;, bcAttr = null, srootOLIId = &quot;&quot;,sServiceType=&quot;&quot;,Isrecord = &quot;&quot;, sValue = &quot;&quot;, sTermValue = &quot;&quot;, srootLIId = &quot;&quot;, lovSwitch = &quot;N&quot;, bcName = null, bcDFAName = null, vConnType = &quot;SIM Only&quot;, Frecord = null, oBCPick = null;
    try 
	{
        QuoteId = Inputs.GetProperty(&quot;OrderId&quot;);
        bcOrder = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
        bcName = TheApplication().GetBusObject(&quot;Order Item&quot;).GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
        bcAttr = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Item XA (No Link)&quot;);
        bcDFAName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VFDfa Order Entry Line Items Thin BC&quot;);
        with (bcOrder)
		{
            SetViewMode(AllView);
            ActivateField(&quot;Quote Id&quot;);
            ActivateField(&quot;Parent Order Id&quot;);
            ActivateField(&quot;Order Sub Type&quot;);
            ClearToQuery();
            SetSearchExpr(&quot;[Quote Id] = &apos;&quot; + QuoteId + &quot;&apos; OR [Parent Order Id] = &apos;&quot; + QuoteId + &quot;&apos;&quot;);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) 
			{
                ChildOrderId = GetFieldValue(&quot;Id&quot;); // connect order row-id
                with (bcDFAName) 
				{
                    //query for root line items
                    SetViewMode(AllView);
                    ActivateField(&quot;Order Header Id&quot;);
                    ActivateField(&quot;Action Code&quot;);
                    ActivateField(&quot;Root Order Item Id&quot;);
                    ActivateField(&quot;Parent Order Item Id&quot;);
                    ActivateField(&quot;VF Device TBUI&quot;);
                    ActivateField(&quot;VF ConnectionType&quot;);
					ActivateField(&quot;VHASSJ Payment Term&quot;);
					ActivateField(&quot;VF Stock Indicator TBUI&quot;);
					ActivateField(&quot;VF Service Type&quot;);
                    ClearToQuery();
                    SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
                    ExecuteQuery(ForwardOnly);
                    Frecord = FirstRecord();
                    while (Frecord) 
					{
                        srootOLIId = GetFieldValue(&quot;Id&quot;); //root line item row-id
						sServiceType = GetFieldValue(&quot;VF Service Type&quot;);
						if(sServiceType == &quot;Postpay&quot;)
						{
		                    with (bcName) 
							{
		                        //query for gpp child line item under the current root
		                        SetViewMode(AllView);
		                        ActivateField(&quot;Parent Order Id&quot;);
		                        ActivateField(&quot;Order Header Id&quot;);
		                        ActivateField(&quot;Product&quot;);
		                        ActivateField(&quot;Action Code&quot;);
		                        ActivateField(&quot;Root Order Item Id&quot;);
								ActivateField(&quot;VF ConnectionType&quot;);
								ActivateField(&quot;VF Stock Indicator TBUI&quot;);
		                        ClearToQuery();
		                        SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND ([Product] =&apos;GPP Device Contract&apos; AND [Action Code] =&apos;Add&apos;) AND [Root Order Item Id]=&apos;&quot; + srootOLIId + &quot;&apos;&quot;);
		                        ExecuteQuery(ForwardOnly);
		                        if (FirstRecord()) 
								{
		                   
		                            srootLIId = GetFieldValue(&quot;Id&quot;); // GPP device line item id
											
		                        } 
								
		                    }
							if((srootLIId != null &amp;&amp; srootLIId != &quot;&quot;) &amp;&amp; GetFieldValue(&quot;VF Stock Indicator TBUI&quot;)== &quot;&quot;|| GetFieldValue(&quot;VF Stock Indicator TBUI&quot;)== null)//Added
							{
								SetFieldValue(&quot;VF ConnectionType&quot;,&quot;Plan and Device&quot;);
								SetFieldValue(&quot;VF Stock Indicator TBUI&quot;,&quot;Out of Stock - Connect Later&quot;);
								//SetFieldValue(&quot;VF ConnectionType&quot;,&quot;Plan and Device&quot;);
								WriteRecord();
							}
						}
                        Frecord = NextRecord();
                    }
                }
            }
        }
        //TheApplication().SetProfileAttr(&quot;SKUCode&quot;, sValue);
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        ChildOrderId = null;
        lovSwitch = null;
        bcName = null;
        Frecord = null;
        bcDFAName = null;
        oBCPick = null;
        bcAttr = null;
    }
}"
