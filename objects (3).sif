			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Soumalya:CM-9903:Added new BS to check the SMS override eligibility check for child orders
function ChckSSJPaperLessBypassRO(Inputs, Outputs)
{
	var quoteId = &quot;&quot;, ovrRdFlg = &quot;Y&quot;, childOrdBC = null,chRec=null;
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null)
		{
			childOrdBC = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;VHA Order Entry Parent Orders SSJ&quot;);
			with(childOrdBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Quote Id&quot;);
				ActivateField(&quot;Paperless Bypass ReadOnly Flag&quot;);
				SetSearchSpec(&quot;Quote Id&quot;,quoteId);
				ExecuteQuery(ForwardOnly);
				chRec = FirstRecord();
				while(chRec)
				{
					if(GetFieldValue(&quot;Paperless Bypass ReadOnly Flag&quot;) == &quot;N&quot;)
					{
						ovrRdFlg = &quot;N&quot;;
						break;	
					}
					chRec = NextRecord();
				}
			}
		}
	}
	catch(e)
	{
		//do nothing
	}
	finally
	{
		childOrdBC = null;
	}
	Outputs.SetProperty(&quot;PaperLessBypass&quot;, ovrRdFlg);
}"
