			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPostComplete"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPostComplete(Inputs, Outputs)
{

	/************************************************************************
	/* Component Name        : 	Siebel Power Communications
	/* Method Name           : 	Finish Button in Post Pay TBUI flow
	/* Component Information : 	This button is scripted to navigate back to the Sales Home page view
	/*
	/* Modification History  :
	/* Date			Author		Config #	Description
	/* ============ ===========	===========	================================
	/* 23/07/2014	Sri					Initial Version
	/* 09/05/2019	Pallavi		UnifiedApp	Commented and modified profile attr
	/************************************************************************/
	var strPropName = &quot;&quot;, strPropValue = &quot;&quot;; //Subramanian: Clears the profile attribute.
	strPropName = Inputs.GetFirstProperty();
	
	while (strPropName != &quot;&quot;)
	{
		strPropValue = Inputs.GetProperty(strPropName);
		TheApplication().SetProfileAttr(strPropName, strPropValue);
		strPropName = Inputs.GetNextProperty();
	}
	/*Subramanian 3.12.14: Navigates to next view*/
	try
	{
	
		/*if(MethodName == &quot;FinishTask&quot; || MethodName == &quot;NavigateNext&quot;)
		{*/
			//var sAccId = TheApplication().ActiveBusObject().GetBusComp(&quot;Order Entry - Orders&quot;).GetFieldValue(&quot;Service Account Id&quot;);
			var sAccId = Inputs.GetProperty(&quot;ServiceAccId&quot;);
			//var sIsOpenUI = TheApplication().GetProfileAttr(&quot;IsOpenUI&quot;);
			var sIsOpenUI = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;); //Pallavi.9/5/19.Commented and added for unified app
			var boActive = TheApplication().GetBusObject(&quot;VF Sales Home Page&quot;);
			var bcAccount = boActive.GetBusComp(&quot;Account&quot;);
			var sAcctId = TheApplication().GetProfileAttr(&quot;VFCustRowIdTBUI&quot;); 
		//	if(sIsOpenUI &gt; 0)//Pallavi.9/5/19.Commented and added for unified app
			if(sIsOpenUI == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Retail&quot;))
			{
				with (bcAccount)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Id&quot;, sAcctId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
						TheApplication().GotoView(&quot;VF Sales Home Page View&quot;, boActive);
					else
						TheApplication().GotoView(&quot;VF Sales Home Page View&quot;);
				}
			} // For Core application,Click on submit will not navigate to home page view 
			else
			{
				//VF Account Summary View
				var oBS = TheApplication().GetService(&quot;VF Wizard Utilities&quot;);
				var psInputs = TheApplication().NewPropertySet();
				var psOutputs = TheApplication().NewPropertySet();
				psInputs.SetProperty(&quot;ViewName&quot;, &quot;VF Account Summary View&quot;);
				psInputs.SetProperty(&quot;BusObjectName&quot;, &quot;Account&quot;);
				psInputs.SetProperty(&quot;BusCompName&quot;, &quot;Account&quot;);
				psInputs.SetProperty(&quot;Id&quot;, sAccId);
				oBS.InvokeMethod(&quot;GotoView&quot;, psInputs, psOutputs);
			}
	
	//	}//if
	}
	catch(e)
	{
		if (!defined(e.errText))
		{
			TheApplication().RaiseErrorText(e.toString());
		}
		else
		{
			TheApplication().RaiseErrorText(e.errText);
		}
	}
	finally
	{
		//bcAccount = null;
		//	boActive = null
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		bcAccount = null;
		boActive = null;
		oBS = null;
		psInputs = null;
		psOutputs = null;
		psInputs = null;
		psOutputs = null;
		psInputs = null;
		psOutputs = null;

	}
}"
