			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateSIMTypeConnectNative"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateSIMTypeConnectNative(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oLineItemBC = oBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var oIMEIListBC = oBO.GetBusComp(&quot;VF IMEI List&quot;);
		var oUniqueHandsetBC =  oBO.GetBusComp(&quot;VF Unique Handset&quot;); 
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sRecExist = &quot;&quot;, sIMEI = &quot;&quot;, sProdRecExist = &quot;&quot;, sLineNum = &quot;&quot;, sSiebelProdType = &quot;&quot;, sIMEICode = &quot;&quot;;
		var sRootOrderLineItemId = &quot;&quot;, sIMEISIMType = &quot;&quot;, sLineSIMType = &quot;&quot;, sUniqHandExist = &quot;&quot;, sErrMsg = &quot;&quot;;
		var sVoice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Voice&quot;);
		var sMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;MBB&quot;);
		var sIMEISIMTypeeSIM  = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HANDSET_SIM_TYPE&quot;,&quot;eSIM&quot;);
		
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			with(oLineItemBC)
			{
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Shipping&quot;);
				ActivateField(&quot;VHA IMEI&quot;);
				ActivateField(&quot;VF Root Siebel Product Type&quot;);
				ActivateField(&quot;VF Line Number&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
				SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
				ExecuteQuery(ForwardOnly);
				sRecExist = FirstRecord();
				while(sRecExist)
				{
					sIMEICode = &quot;&quot;;
					sIMEISIMType = &quot;&quot;;					
					sRootOrderLineItemId = GetFieldValue(&quot;Id&quot;);
					sIMEI = GetFieldValue(&quot;VHA IMEI&quot;);
					sLineSIMType = GetFieldValue(&quot;Shipping&quot;);
					sLineNum = GetFieldValue(&quot;VF Line Number&quot;);
					sSiebelProdType = GetFieldValue(&quot;VF Root Siebel Product Type&quot;);				
			
					if((sSiebelProdType == sVoice) || (sSiebelProdType == sMBB))
					{
						if(sIMEI != null &amp;&amp; sIMEI != &quot;&quot;)
						{
							with(oIMEIListBC)
							{
								ActivateField(&quot;Product Code&quot;);
								ActivateField(&quot;IMEI&quot;);
								ClearToQuery();
								SetSearchSpec(&quot;IMEI&quot;, sIMEI);
								ExecuteQuery(ForwardOnly);
								sProdRecExist = FirstRecord();
								if(sProdRecExist)
								{
									sIMEICode = GetFieldValue(&quot;Product Code&quot;);					
								}
							}
						}
							
						if(sIMEICode != &quot;&quot; &amp;&amp; sIMEICode != null)
						{
							with(oUniqueHandsetBC)
							{
								ActivateField(&quot;SIMType&quot;);
								ActivateField(&quot;Product Code&quot;);
								ActivateField(&quot;Version Status&quot;);
								ClearToQuery();
								SetSearchSpec(&quot;Product Code&quot;, sIMEICode);
								SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
								ExecuteQuery(ForwardOnly)
								sUniqHandExist = FirstRecord();
								if(sUniqHandExist)
								{
									sIMEISIMType = GetFieldValue(&quot;SIMType&quot;);							
								}
							}
						}
					
						if(((sLineSIMType != &quot;&quot; &amp;&amp; sLineSIMType != null) &amp;&amp; (sIMEISIMType != &quot;&quot; &amp;&amp; sIMEISIMType != null) &amp;&amp; (sIMEICode != &quot;&quot; &amp;&amp; sIMEICode != null)) || ((sLineSIMType != &quot;&quot; &amp;&amp; sLineSIMType != null) &amp;&amp; (sIMEISIMType == &quot;&quot; || sIMEISIMType == null) &amp;&amp; (sIMEICode != &quot;&quot; &amp;&amp; sIMEICode != null)))
						{
							if(sIMEISIMType == &quot;Physical&quot; &amp;&amp; (sIMEISIMType != sLineSIMType))
							{
								sErrMsg = &quot;Line Number:&quot; + sLineNum + &quot; - The Device IMEI provided does not support eSIM. Please provide a eSIM compatible device IMEI or select Physical SIM&quot;;
							}
							else if(sIMEISIMType == &quot;eSIM&quot; &amp;&amp; (sIMEISIMType != sLineSIMType))
							{
								sErrMsg = &quot;Line Number:&quot; + sLineNum + &quot; - The Device IMEI provided does not support Physical SIM. Please provide a Physical SIM compatible device IMEI or select eSIM&quot;;
							}
							else if((sIMEISIMType == &quot;&quot; || sIMEISIMType == null) &amp;&amp; (sLineSIMType == sIMEISIMTypeeSIM))
							{
								sErrMsg = &quot;Line Number:&quot; + sLineNum + &quot; - The Device IMEI provided does not support eSIM. Please provide a eSIM compatible device IMEI or select Physical SIM&quot;;
							}
						}					
						
						if (sErrMsg != &quot;&quot;) 
						{	 
							Outputs.SetProperty(&quot;IMEIDeviceError&quot;, sErrMsg);
						}
						else
						{
							Outputs.SetProperty(&quot;IMEIDeviceError&quot;, &quot;&quot;);
						}
										
					}
					sRecExist = NextRecord();
				}
				
			}
		}
	}
	catch(e)
	{
		
	}
	finally
	{
		oUniqueHandsetBC = null;
		oIMEIListBC = null;
		oLineItemBC = null;
		oBO = null;	
	}
}"
			   SEQUENCE="32"
