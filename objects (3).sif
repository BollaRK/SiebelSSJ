			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateDefaultNotifMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateDefaultNotifMSISDN(Inputs, Outputs)
{
	var quoteId = &quot;&quot;, lineItemBC = null,childOrdBC = null, chRec=null, linerec= null, 
	childOrdId = &quot;&quot;, baStatus=&quot;&quot;,updateRequired=&quot;Y&quot;, updRecId=&quot;&quot;;
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null)
		{
			childOrdBC = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;VHA Order Entry Parent Orders SSJ&quot;);
			with(childOrdBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Quote Id&quot;);
				ActivateField(&quot;Order Sub Type&quot;);
				ActivateField(&quot;Billing Account Status&quot;);
				SetSearchSpec(&quot;Quote Id&quot;,quoteId);
				ExecuteQuery(ForwardOnly);
				chRec = FirstRecord();
				while(chRec)
				{
					if(GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Connect&quot;)
					{
						
						childOrdId = GetFieldValue(&quot;Id&quot;);
						baStatus = GetFieldValue(&quot;Billing Account Status&quot;);
						if(baStatus == &quot;Open&quot; &amp;&amp; childOrdId != &quot;&quot; &amp;&amp; childOrdId != null)
						{
							updateRequired = &quot;Y&quot;;
							updRecId=&quot;&quot;;
							lineItemBC = TheApplication().GetBusObject(&quot;VF SSJ Order Item Task Simple BO&quot;).GetBusComp(&quot;VF SSJ Order Item Task Simple&quot;);
							with(lineItemBC)
							{
								ClearToQuery();
								SetViewMode(AllView);
								ActivateField(&quot;Order Header Id&quot;);
								//ActivateField(&quot;Parent Order Item Id&quot;);
								ActivateField(&quot;Notification MSISDN&quot;);
								SetSearchExpr(&quot;[Order Header Id]=&apos;&quot;+childOrdId+&quot;&apos;&quot;);
								SetSortSpec(&quot;Created (ASCENDING)&quot;);
								ExecuteQuery(ForwardOnly);
								linerec = FirstRecord();
								while(linerec)
								{
									if(updRecId == &quot;&quot;)
										updRecId = GetFieldValue(&quot;Id&quot;);
										
									if(GetFieldValue(&quot;Notification MSISDN&quot;) == &quot;Y&quot;)
									{
										updateRequired = &quot;N&quot;;
										break;
									}
									linerec = NextRecord();
								}
							}
							if(updateRequired == &quot;Y&quot; &amp;&amp; updRecId != &quot;&quot; &amp;&amp; updRecId != null)
							{
								with(lineItemBC)
								{
									ClearToQuery();
									SetViewMode(AllView);
									//ActivateField(&quot;Order Id&quot;);
									//ActivateField(&quot;Parent Order Item Id&quot;);
									ActivateField(&quot;Notification MSISDN&quot;);
									SetSearchExpr(&quot;[Id]=&apos;&quot;+updRecId+&quot;&apos;&quot;);
									ExecuteQuery(ForwardOnly);
									if(FirstRecord())
									{
										SetFieldValue(&quot;Notification MSISDN&quot;,&quot;Y&quot;);
										WriteRecord();
									}
								}
							}
						}
						break;
					}
					chRec = NextRecord();
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		quoteId = null;
		lineItemBC = null;
		childOrdBC = null;
		chRec=null;
		linerec= null;
		childOrdId = null;
		baStatus=null;
	}
}"
