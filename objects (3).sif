			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnFormatPrice"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnFormatPrice(sPrice, Type, System)
//Soumalya:Reused for SSJ Query OLI
//Saravanan J: Created for Sales Calculator
{
	try
	{
		var sLast2digit =&quot;&quot;;
		var sCalcMeth = &quot;&quot;;
		var arrNum = new Array();
		sPrice = ToString(sPrice);
		if(Type != &quot;&quot;)
			sCalcMeth = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_PRICE_CALC&quot;, Type);
		else
			sCalcMeth = &quot;TRUNCATE&quot;;
		
		if(sCalcMeth != &quot;&quot;)
		{
			switch(sCalcMeth)
			{
				case &quot;TRUNCATE&quot;:
					sPrice = ToString(sPrice);
					if(sPrice.indexOf(&quot;.&quot;) &gt; 0) 
						sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
					else if(sPrice != &quot;&quot;)
						sPrice = sPrice+&quot;.00&quot;;
				break;
				
				case &quot;ROUNDOFF&quot;:
					if(System == &quot;BRM&quot;)
					{
						if(sPrice.indexOf(&quot;.&quot;) &gt; 0)
						{
							sLast2digit = sPrice.substring(sPrice.indexOf(&quot;.&quot;)+1, sPrice.indexOf(&quot;.&quot;)+3); 
							if(sLast2digit == &quot;99&quot;)
								sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
							else
							{
								sPrice = ToNumber(sPrice);	
								sPrice = sPrice.toFixed(2);
							}
						}
						else
						{
							sPrice = ToNumber(sPrice);	
							sPrice = sPrice.toFixed(2);
						}
					}
					else
					{
						sPrice = ToNumber(sPrice);	
						sPrice = sPrice.toFixed(2);
					}
				break;
				
			}
		}		
		sPrice = ToString(sPrice);
		arrNum = sPrice.split(&quot;.&quot;);
		
		if(arrNum.length &gt; 1)
			sLast2digit = arrNum[1];
		
		if(sLast2digit.length == 1 &amp;&amp; ToNumber(sLast2digit) &lt; 10 &amp;&amp; ToNumber(sLast2digit) != 0)
			sPrice = ToString(sPrice)+&quot;0&quot;;
		
		sPrice = sPrice.replace(/(\d)(?=(\d\d\d)+(?!\d))/g, &quot;$1,&quot;); //add comma between three numbers
		
		if(ToNumber(sPrice) == 0)
			return &quot;0.00&quot;;
		else
			return sPrice;
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
			   SEQUENCE="9"
			   UPDATED="04/25/2026 15:45:10"
			   UPDATED_BY="SOUMALYAM"
			   CREATED="04/07/2026 23:26:47"
			   CREATED_BY="SOUMALYAM">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateAttrPrepayAmt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateAttrPrepayAmt(Inputs, Outputs)
{
	var quoteId=&quot;&quot;,prepayAmount=&quot;&quot;, xaBC=null,rootItemId=&quot;&quot;,itemId=&quot;&quot;,prepAmt=0,category=&quot;&quot;,srchexpr=&quot;&quot;,sChildItemId=&quot;&quot;;
	var wfBS=null,wfInp=null,wfOut=null,rowSet=null;
	var AppConRowSet = null,Prepayment=&quot;&quot;,RelatedAssetIntegId=&quot;&quot;,Ssrchexpr=&quot;&quot;;
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		prepayAmount = Inputs.GetProperty(&quot;PrepaymentAmount&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null &amp;&amp; prepayAmount != &quot;&quot; &amp;&amp; prepayAmount != null)
		{
			wfInp = TheApplication().NewPropertySet();
			wfOut = TheApplication().NewPropertySet();
			wfBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			wfInp.SetProperty(&quot;ProcessName&quot;,&quot;VHA SSJ Create Payment Plan WF&quot;);
			wfInp.SetProperty(&quot;Object Id&quot;,quoteId);
			wfInp.SetProperty(&quot;PrepaymentAmount&quot;,prepayAmount);
			wfBS.InvokeMethod(&quot;RunProcess&quot;, wfInp, wfOut);
			if(wfOut.GetChildCount()&gt;0)
			{
				rowSet = wfOut.GetChild(0);
				xaBC = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;Order Item XA (Simple)&quot;);
				for(var jk=0;jk&lt;rowSet.GetChildCount();jk++)
				{
					rootItemId=&quot;&quot;;
					itemId=&quot;&quot;;
					category=&quot;&quot;;
					prepAmt=0;
					srchexpr=&quot;&quot;;
					rootItemId = rowSet.GetChild(jk).GetProperty(&quot;RootOrderItemId&quot;);
					prepAmt = rowSet.GetChild(jk).GetProperty(&quot;Prepayment&quot;);
					itemId = rowSet.GetChild(jk).GetProperty(&quot;OrderItemId&quot;);
					category = rowSet.GetChild(jk).GetProperty(&quot;Category&quot;);
					if(category == &quot;GPP&quot; &amp;&amp; rootItemId != &quot;&quot; &amp;&amp; rootItemId != null)
						srchexpr=&quot;[Product Type]=&apos;Billing - GPP&apos; AND [Parent Action Code] = &apos;Add&apos; AND [Root Object Id]=&apos;&quot;+rootItemId+&quot;&apos; AND [Name]=&apos;Prepayment Amount&apos;&quot;;
					else
						srchexpr=&quot;[Object Id]=&apos;&quot;+itemId+&quot;&apos; AND [Name]=&apos;Prepayment Amount&apos;&quot;;
					with(xaBC)
					{
						ClearToQuery();
						SetViewMode(AllView);
						ActivateField(&quot;Product Type&quot;);
						ActivateField(&quot;Parent Action Code&quot;);
						ActivateField(&quot;Text Value&quot;);
						ActivateField(&quot;Object Id&quot;);
						ActivateField(&quot;Root Object Id&quot;);
						SetSearchExpr(srchexpr);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							SetFieldValue(&quot;Text Value&quot;, prepAmt);
							WriteRecord();
						}
					}
				}//for
				var svc = TheApplication().GetService(&quot;Row Set Transformation Toolkit&quot;);
				var inputs = TheApplication().NewPropertySet();
				var outputs = TheApplication().NewPropertySet();
				var outrowset = TheApplication().NewPropertySet();

				inputs.SetProperty(&quot;Aggregate Type&quot;, &quot;Sum&quot;); // Options: Sum, Avg, Min, Max, Count
				inputs.SetProperty(&quot;Group By&quot;, &quot;RelatedAssetIntegId&quot;); // Field to group by
				inputs.SetProperty(&quot;Aggregate Field&quot;, &quot;Prepayment&quot;); // Field to sum
				rowSet.SetType(&quot;Row Set&quot;);
				outrowset.SetType(&quot;Output Row Set&quot;);
				inputs.SetProperty(&quot;Process Condition&quot;, &quot;{Row.Category} &lt;&gt; &apos;GPP&apos;&quot;); // Field to sum
				inputs.AddChild(rowSet.Copy());
				inputs.AddChild(outrowset.Copy());
				svc.InvokeMethod(&quot;Aggregate Transform&quot;, inputs, outputs);
				if(outputs.GetChildCount()&gt;0)
				{
					for (var ju=0;ju&lt;outputs.GetChildCount();ju++)
					{
						if(outputs.GetChild(ju).GetType() == &quot;Output Row Set&quot;)
						{
							AppConRowSet = outputs.GetChild(ju);
							break;
						}
					}
				}//if
				if(AppConRowSet.GetChildCount()&gt;0)
				{
					for(var i=0;i&lt;AppConRowSet.GetChildCount();i++)
					{
						Prepayment= 0;
						RelatedAssetIntegId=&quot;&quot;;
						Ssrchexpr=&quot;&quot;;
						Prepayment = AppConRowSet.GetChild(i).GetProperty(&quot;Prepayment&quot;);
						RelatedAssetIntegId = AppConRowSet.GetChild(i).GetProperty(&quot;RelatedAssetIntegId&quot;);
						var bcDFAName = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
						with(bcDFAName)
						{
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;Order Quote Id&quot;);
							ActivateField(&quot;Related Asset Integration Id&quot;);
							ActivateField(&quot;Action Code&quot;);
							ActivateField(&quot;Product Type&quot;);
							SetSearchExpr(&quot;[Product Type]=&apos;Billing - APP&apos; AND [Order Quote Id] = &apos;&quot;+quoteId+&quot;&apos; AND [Related Asset Integration Id] =&apos;&quot;+RelatedAssetIntegId+&quot;&apos; AND [Action Code]=&apos;Add&apos;&quot;);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{
								sChildItemId = GetFieldValue(&quot;Id&quot;);
								Ssrchexpr=&quot;[Object Id]=&apos;&quot;+sChildItemId+&quot;&apos; AND [Name]=&apos;Prepayment Amount&apos;&quot;;
								with(xaBC)
								{
									ClearToQuery();
									SetViewMode(AllView);
									ActivateField(&quot;Product Type&quot;);
									ActivateField(&quot;Parent Action Code&quot;);
									ActivateField(&quot;Text Value&quot;);
									ActivateField(&quot;Object Id&quot;);
									ActivateField(&quot;Root Object Id&quot;);
									SetSearchExpr(Ssrchexpr);
									ExecuteQuery(ForwardOnly);
									if(FirstRecord())
									{
										SetFieldValue(&quot;Text Value&quot;, Prepayment);
										WriteRecord();
									}
								}//with
							}
						}
					}//for
					
				}//if
			}//if
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		wfBS=null;
		wfInp=null;
		wfOut=null;
		rowSet=null;
		quoteId=null;
		prepayAmount=null;
		xaBC=null;
		rootItemId=null;
		itemId=null;
		prepAmt=null;
		category=null;
		srchexpr=null;
	}
}  

