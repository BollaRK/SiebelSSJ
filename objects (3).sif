			<BUSINESS_SERVICE_METHOD
			   HIDDEN="N"
			   INACTIVE="N"
			   NAME="CalcRemainMonth"
			   UPDATED="01/09/2026 15:43:04"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:04"
			   CREATED_BY="SADMIN">
				<BUSINESS_SERVICE_METHOD_ARG
				   DATA_TYPE="Date"
