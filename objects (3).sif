			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="RemoveConnectService"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function RemoveConnectService(Inputs, Outputs) 
{
    var strOrderId = &quot;&quot;, RootOrderLineItemId = &quot;&quot;, strVFTNRId = &quot;&quot;, flflmntItemBC = null, psInput = null, psOutput = null, svc = null, lineItemBC = null, OrdDeleteDone=null;
    try 
	{
        strOrderId = Inputs.GetProperty(&quot;ChildOrderId&quot;);
        RootOrderLineItemId = Inputs.GetProperty(&quot;RootOrderLineItemId&quot;);
        strVFTNRId = Inputs.GetProperty(&quot;VFTNRId&quot;);
        //strVFTNRId = this.BusComp().GetFieldValue(&quot;VF TNR Id&quot;);

        //Delete fulfilment Item
        flflmntItemBC = TheApplication().GetBusObject(&quot;VF Task Fulfilment Items&quot;).GetBusComp(&quot;VF Task Fulfilment Items&quot;);
        with (flflmntItemBC) 
		{
            ClearToQuery();
            SetViewMode(AllView);
            SetSearchSpec(&quot;Order Id&quot;, strOrderId);
            SetSearchSpec(&quot;VF Line Item Id&quot;, RootOrderLineItemId);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) 
			{
                DeleteRecord();
            }
        }
		
        //call cancel order WF
        svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
        psInput = TheApplication().NewPropertySet();
        psOutput = TheApplication().NewPropertySet();
        psInput.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Cancel Order&quot;);
        psInput.SetProperty(&quot;TNRId&quot;, strVFTNRId);
        psInput.SetProperty(&quot;RemoveService&quot;, &quot;Y&quot;);
        psInput.SetProperty(&quot;Object Id&quot;, strOrderId);
        psInput.SetProperty(&quot;RootLineItemId&quot;, RootOrderLineItemId);
        svc.InvokeMethod(&quot;RunProcess&quot;, psInput, psOutput);		
        
		//Line Item Cascade Delete
		lineItemBC = TheApplication().GetBusObject(&quot;Order Entry - Line Items&quot;).GetBusComp(&quot;Order Entry - Line Items&quot;);
		with (lineItemBC) 
		{
            ClearToQuery();
            SetViewMode(AllView);
            SetSearchSpec(&quot;Id&quot;, RootOrderLineItemId);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) 
			{
                DeleteRecord();
				OrdDeleteDone =	CleanUpChildOrder(strOrderId);
            }
        }
        if(OrdDeleteDone == &quot;N&quot;)
		{
		psInput.Reset();
        psOutput.Reset();
        psInput.SetProperty(&quot;OrderId&quot;, strOrderId);
		svc = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
        svc.InvokeMethod(&quot;UpdateLineNumber&quot;, psInput, psOutput);
        
		psInput.Reset();
        psOutput.Reset();
        psInput.SetProperty(&quot;Connect Order Id&quot;, strOrderId);
		svc = TheApplication().GetService(&quot;VF Order Comments and Validation Msg Concatenation&quot;);
        svc.InvokeMethod(&quot;UpdateMessageAndComments&quot;, psInput, psOutput);
		}
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		psInput = null;
        psOutput = null;
        svc = null;
        flflmntItemBC = null;
		strOrderId = null;
		RootOrderLineItemId = null;
		strVFTNRId = null;
    }
}"
			   SEQUENCE="17"
