			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetAvailableBillCycleAndSegment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetAvailableBillCycleAndSegment(Inputs, Outputs)
{
	/*
	* Component Name        :	TBUI Utilities
	* Method Name          	  :		TBUI Scripts
	* Component Information :	Set the Customer Bill Segment depending on the Organization.
	*
	* Modification History  :
	* Date				Author		Config #	Description
	* ============ ===========	===========	================================
	* 06/06/2014	Neel			Scripts Cloned from BC Account New Record for setting Bill Segment and Cycle
 	*/
 	
 	var iClibTime = Clib.time();
	var dtToday = Date.fromSystem(iClibTime);
	var intToday = dtToday.getDate();
	var blnRecordExists = false;
	var blnRecordFound = false;
	var strSegmentSearchSpec = &quot;&quot;;
	var boLOV;
	var bcLOV;
	
	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START: BS: VF TBUI Utilities.SetCustomerBillCycleAndSegment&quot;);
		}
		
		var strSegmentSearchSpec = Inputs.GetProperty(&quot;BillSegment&quot;);		
		if(strSegmentSearchSpec == &quot;&quot;)// Neel - removed == null condition
		{
			var sOrg = TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;);//[Nagesh][R1.0][Added for DFA]
			if(sOrg == &quot;TPG&quot;)
			strSegmentSearchSpec = &quot;201&quot;;
			else if(sOrg == &quot;iiNet&quot;)
			strSegmentSearchSpec = &quot;301&quot;;//[Nagesh]
			else
			strSegmentSearchSpec = &quot;&lt;&gt; &apos;301&apos; AND [Parent] &lt;&gt; &apos;201&apos; AND [Parent] &lt;&gt; &apos;307&apos; AND [Parent] &lt;&gt; &apos;305&apos; AND [Parent] &lt;&gt; &apos;302&apos;&quot;;
			
		}		
		boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
		bcLOV.ActivateField(&quot;Active&quot;); // MADHUR::7-OCT-22::Added for PKE000000103092 - DOM
		bcLOV.ActivateField(&quot;Parent&quot;);
		bcLOV.ActivateField(&quot;Value&quot;);
		bcLOV.SetSearchSpec(&quot;Type&quot;, &quot;BILL_CYCLE&quot;);
		bcLOV.SetSearchSpec(&quot;Parent&quot;, strSegmentSearchSpec);//strSegmentSearchSpec);
		bcLOV.SetSearchSpec(&quot;Active&quot;, &quot;Y&quot;); // MADHUR::7-OCT-22::Added for PKE000000103092 - DOM
		bcLOV.SetSearchSpec(&quot;High&quot;, &quot;Open&quot;);
		bcLOV.SetSortSpec(&quot;Name(ASCENDING)&quot;);
		bcLOV.ExecuteQuery(ForwardBackward);
		blnRecordExists = bcLOV.FirstRecord();			
		if (!blnRecordExists)
			throw(&quot;There are no available DOMs please contact your administrator&quot;);

		// Loop to find the next available DOM
		while (blnRecordExists &amp;&amp; blnRecordFound == false)
		{
			if (ToInteger(bcLOV.GetFieldValue(&quot;Value&quot;)) &gt; intToday)
				blnRecordFound = true;
			else
				blnRecordExists = bcLOV.NextRecord();
		}
		
		// If there are no records then check in case the DOM is in a new month
		if (blnRecordFound == false)
		{
			bcLOV.FirstRecord();
			if (ToInteger(bcLOV.GetFieldValue(&quot;Value&quot;)) &lt;= intToday)
				blnRecordFound = true;
		}
		
		if (blnRecordFound)
		{			
			Outputs.SetProperty(&quot;BillSegment&quot;, bcLOV.GetFieldValue(&quot;Parent&quot;));
			Outputs.SetProperty(&quot;BillCycle&quot;, bcLOV.GetFieldValue(&quot;Value&quot;));			
		}
		else
			throw(&quot;There are no available DOMs please contact your administrator&quot;);
			
	}
	catch (e)
	{
		var sError;
		if (defined(e.errText))
		{
			sError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
			Outputs.SetProperty(&quot;ErrMsg&quot;, sError);
		}
		else
		{
			sError = arguments.callee + ToString(e); 
			Outputs.SetProperty(&quot;ErrMsg&quot;, sError);
		}
		
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR: BS: VF TBUI Utilities.SetCustomerBillCycleAndSegment.sError= &quot; + e.toString());
		}
		throw (sError);
	}
	finally
	{
		// Destroy variables
		bcLOV = null;
		boLOV = null;

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END: BS: VF TBUI Utilities.SetCustomerBillCycleAndSegment&quot;);
		}
	}
}"
