			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateSTCCForBulkChangeSIM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateSTCCForBulkChangeSIM(Inputs,Outputs)
{
	try
	{
	    var sOrderItemBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	    var sOrderItemBC = sOrderItemBO.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
	    var sOrderEntBO = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
	    var sOrderEntBC = sOrderEntBO.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
	    var eSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;eSIM&quot;)
	    var sConfirmationCode = Inputs.GetProperty(&quot;ConfirmationCode&quot;);
	    var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	    var sOLISIMType = Inputs.GetProperty(&quot;SIMType&quot;);
	    var sExistConfirCode = &quot;&quot;;
			
	        if((sOrderId != &quot;&quot; &amp;&amp; sOrderId != null) &amp;&amp; (sOLISIMType != &quot;&quot; &amp;&amp; sOLISIMType != null &amp;&amp; sOLISIMType == eSIMType))
			{
					with(sOrderItemBC)
					{
						ClearToQuery();
						SetViewMode(AllView);
		                ActivateField(&quot;Shipping&quot;);
		                ActivateField(&quot;Order Header Id&quot;);
		                ActivateField(&quot;VHA Confirmation Code&quot;);
		                ActivateField(&quot;Parent Order Item Id&quot;);
						SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
		                SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
		                   sExistConfirCode = GetFieldValue(&quot;VHA Confirmation Code&quot;);
						   SetFieldValue(&quot;Shipping&quot;, eSIMType);
		                   WriteRecord();
		                }				
					}
			}
			if((sExistConfirCode == &quot;&quot; || sExistConfirCode == null) &amp;&amp; (sConfirmationCode != &quot;&quot; &amp;&amp; sConfirmationCode != null))
	        {
	           with(sOrderEntBC)
	           {
	           		ClearToQuery();
					SetViewMode(AllView);
			        ActivateField(&quot;VHA Confirmation Code&quot;);
					SetSearchSpec(&quot;Id&quot;, sOrderId);
	                ExecuteQuery(ForwardOnly);
	                if(FirstRecord())
	                {
	                	SetFieldValue(&quot;VHA Confirmation Code&quot;, sConfirmationCode);
	                    WriteRecord();
	                }  
	            }
	         }
			
	}
	catch(e)
	{
 		throw(e);
	}
	finally
	{
		 sOrderItemBC = null;
		 sOrderEntBC = null;
		 sOrderItemBO = null;
		 sOrderEntBO = null;
	}
}"
