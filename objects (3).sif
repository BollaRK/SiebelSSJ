			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSpeedUpdateOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSpeedUpdateOrder(Inputs, Outputs)
{
	//Cretaed by SBABU for Imagine project,setting confirmed network and speed
try
{
var sOrderBO,sOrderBC,sSiteQBC;
var iRecord,sOrderId,sSqId,sConfirmedNetwork,sMAS,sConfirmedNetworkServices,sServiceId,sNoAvcId,sBundledFlag,sAccessTech;
	//PRASANTH:25/08/2025: Added Below code for Estimated MAS CR 3.0
	var sNextMASCap = &quot;&quot;;
	var sFTTB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Building&quot;);
	var sFTTN = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Node&quot;);
	var sFTTC = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Curb&quot;);
	var sLOVBO = TheApplication().GetBusObject(&quot;VHA List Of Values&quot;);
	var sLOVBC = sLOVBO.GetBusComp(&quot;List Of Values&quot;);
	//PRASANTH: Code End
	sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);		
	sSiteQBC = sOrderBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);		
	sOrderId = Inputs.GetProperty(&quot;OrderNumber&quot;);
	sSqId = Inputs.GetProperty(&quot;SQRowId&quot;);
	var MAS=&quot;&quot;;
	if(sOrderId !=&quot;&quot; &amp;&amp; sSqId!=&quot;&quot;)
	{
	with(sSiteQBC)
	{
	sSiteQBC.SetViewMode(AllView);
	sSiteQBC.ClearToQuery();
	sSiteQBC.ActivateField(&quot;Customer Bundled Flag&quot;);
	sSiteQBC.ActivateField(&quot;OneSQConfirmedNetwork&quot;);
	sSiteQBC.ActivateField(&quot;ConfirmedNetworkServices&quot;);
	sSiteQBC.ActivateField(&quot;Service Id&quot;);
	sSiteQBC.ActivateField(&quot;VHA No Service Id&quot;);
	sSiteQBC.ActivateField(&quot;OneSQMAS&quot;);	
	sSiteQBC.ActivateField(&quot;Access Technology&quot;);
	sSiteQBC.ActivateField(&quot;Order Line Item Id&quot;);
	sSiteQBC.SetSearchSpec(&quot;Id&quot;, sSqId);
	sSiteQBC.ExecuteQuery(ForwardOnly);	
	iRecord = sSiteQBC.FirstRecord();
	if(iRecord) 
	{
		sConfirmedNetwork = sSiteQBC.GetFieldValue(&quot;OneSQConfirmedNetwork&quot;);
		sBundledFlag = sSiteQBC.GetFieldValue(&quot;Customer Bundled Flag&quot;);//18/06/2025: Monit Dua added for Speed Boost Changes
		sConfirmedNetworkServices = sSiteQBC.GetFieldValue(&quot;ConfirmedNetworkServices&quot;);
		sServiceId = sSiteQBC.GetFieldValue(&quot;Service Id&quot;);
		sNoAvcId = sSiteQBC.GetFieldValue(&quot;VHA No Service Id&quot;);
		sMAS = sSiteQBC.GetFieldValue(&quot;OneSQMAS&quot;);
		sAccessTech = sSiteQBC.GetFieldValue(&quot;Access Technology&quot;);	
		if((sSiteQBC.GetFieldValue(&quot;Order Line Item Id&quot;) == &quot;&quot; || sSiteQBC.GetFieldValue(&quot;Order Line Item Id&quot;) == null) &amp;&amp; Inputs.GetProperty(&quot;RootOrderItemId&quot;) != &quot;&quot;) //Prasanth added for SSJ
		{
			sSiteQBC.SetFieldValue(&quot;Order Line Item Id&quot;,Inputs.GetProperty(&quot;RootOrderItemId&quot;));
			sSiteQBC.WriteRecord();
		}
		MAS = sMAS.split(&quot;/&quot;);
		with(sOrderBC)
		{
		sOrderBC.SetViewMode(AllView);
		sOrderBC.ClearToQuery();
		sOrderBC.ActivateField(&quot;Customer Bundled Flag&quot;);
		sOrderBC.ActivateField(&quot;NetworkProviderName&quot;);
		sOrderBC.ActivateField(&quot;ConfirmedServiceNetwork&quot;);
		sOrderBC.ActivateField(&quot;Service Id To Transfer&quot;);
		sOrderBC.ActivateField(&quot;VHA No Service Id To Transfer&quot;);
		sOrderBC.ActivateField(&quot;MaxAttainableSpeed&quot;);
		sOrderBC.ActivateField(&quot;Order Number&quot;);
		sOrderBC.ActivateField(&quot;MAS Range&quot;);
		sOrderBC.ActivateField(&quot;MAS Range Flag&quot;);
		sOrderBC.SetSearchSpec(&quot;Order Number&quot;, sOrderId);
		sOrderBC.ExecuteQuery(ForwardOnly);	
		iRecord = sOrderBC.FirstRecord();
		if(iRecord) 
		{
			//PRASANTH:25/08/2025: Added Below code for Estimated MAS CR 3.0
			var sNBN = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;NETWRK_IDENTI_LIST&quot;,&quot;NBN&quot;);
			var sMASRangeSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_RELEASE_SWITCH&quot;,&quot;ESTIMATED_MAS&quot;);
			if(sMASRangeSwitch == &quot;Y&quot; &amp;&amp; sConfirmedNetwork == sNBN &amp;&amp; (sAccessTech == sFTTB || sAccessTech == sFTTC || sAccessTech == sFTTN) &amp;&amp; MAS[0].indexOf(&quot;-&quot;)&gt;0)
			{
				sOrderBC.SetFieldValue(&quot;MAS Range Flag&quot;,&quot;Y&quot;);
				sOrderBC.SetFieldValue(&quot;MAS Range&quot;,sMAS);
				var MASRange = MAS[0].split(&quot;-&quot;);
				with(sLOVBC)
				{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Type&quot;);
					ActivateField(&quot;Target Low&quot;);
					ActivateField(&quot;Target High&quot;);
					ActivateField(&quot;Name&quot;);
					var sExpr = &quot;[Type]= &apos;VHA_EST_MAS_RANGE_MATRIX&apos; AND [Active]=&apos;Y&apos; AND [Target Low] &lt;= &quot;+ MASRange[1] +&quot; AND [Target High]&gt;=&quot;+MASRange[1];
					SetSearchExpr(sExpr);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
						sNextMASCap = GetFieldValue(&quot;Name&quot;);
				}
			}
			else
			{
				sOrderBC.SetFieldValue(&quot;MAS Range Flag&quot;,&quot;N&quot;);
				sOrderBC.SetFieldValue(&quot;MAS Range&quot;,&quot;&quot;);
			}
			//PRASANTH: Code End
			sOrderBC.SetFieldValue(&quot;NetworkProviderName&quot;, sConfirmedNetwork);
			sOrderBC.SetFieldValue(&quot;Customer Bundled Flag&quot;, sBundledFlag);	//18/06/2025: Monit Dua added for Speed Boost Changes		
			sOrderBC.SetFieldValue(&quot;VHA No Service Id To Transfer&quot;, sNoAvcId);//9/05/2025: Indumathi added for #13179-NATC BFX
			if(sNoAvcId == &quot;Y&quot;)
			{
			}
			else
			{
			    sOrderBC.SetFieldValue(&quot;Service Id To Transfer&quot;, sServiceId); //26/01/2025: Monit Dua added for #13179-NATC Changes
			}
			sOrderBC.SetFieldValue(&quot;ConfirmedServiceNetwork&quot;, sConfirmedNetwork);
			if(sNextMASCap != &quot;&quot;)
				sOrderBC.SetFieldValue(&quot;MaxAttainableSpeed&quot;, sNextMASCap);
			else
				sOrderBC.SetFieldValue(&quot;MaxAttainableSpeed&quot;, MAS[0]);
			sOrderBC.SetFieldValue(&quot;VHA Retrieve NBN Plans&quot;, TheApplication().GetProfileAttr(&quot;NBNRetrievePlans&quot;));
			sOrderBC.WriteRecord();			
		}
		}
	}
	}
	}
	Outputs.SetProperty(&quot;NetworkProvider&quot;,sConfirmedNetwork);
}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sOrderBO = null;
		sOrderBC = null;
		sSiteQBC = null;
	}
}	"
