			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetProdEntData"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnGetProdEntData(Inputs,Outputs)
{
	try
	{
		var sProdEntBO,sProdEntBC,sGigaByte = 0,sByte = 0,sKiloByte = 0 ,sValue = 0,sMetric = &quot;&quot;,IDDZone = 0,IDDMetric = &quot;&quot;;
		var sSrchSpec = &quot;&quot;;
		sProdEntBO = TheApplication().GetBusObject(&quot;VHA Sharing Entitlement BO&quot;);
		sProdEntBC = sProdEntBO.GetBusComp(&quot;VHA Entitlements Matrix BC&quot;);
		var sGlobalProdIdent = Inputs.GetProperty(&quot;GPI&quot;);
		var sProductSAMId = Inputs.GetProperty(&quot;ProdId&quot;);
		var FVal = &quot;&quot;;
	//	TheApplication().SetProfileAttr(&quot;PRDCD&quot;,sProductSAMId);
		if((sGlobalProdIdent != &quot;&quot; &amp;&amp; sGlobalProdIdent != &quot;&quot; ) &amp;&amp; (sProductSAMId != &quot;&quot; &amp;&amp; sProductSAMId != &quot;&quot;))
		{
			if(sGlobalProdIdent == &quot;Bonus Data&quot;)
				sSrchSpec = &quot;[SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND ([Metric] = &apos;GB&apos; OR [Metric] = &apos;MB&apos; OR [Metric] = &apos;KB&apos; OR [Metric] = &apos;B&apos;)&quot;;
			if(sGlobalProdIdent == &quot;Base Data&quot;)
				sSrchSpec = &quot;[Rate Plan SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND ([Metric] = &apos;GB&apos; OR [Metric] = &apos;MB&apos; OR [Metric] = &apos;KB&apos; OR [Metric] = &apos;B&apos;)&quot;;
			else if (sGlobalProdIdent == &quot;IDDZone1&quot;)
			 	sSrchSpec = &quot;[Rate Plan SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND [Entitlement Type] = &apos;IDD Zone 1&apos;&quot;
			else if (sGlobalProdIdent == &quot;IDDZone2&quot;)
				sSrchSpec = &quot;[Rate Plan SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND [Entitlement Type] = &apos;IDD Zone 2&apos;&quot;
			else if (sGlobalProdIdent == &quot;Bonus IDD&quot;)
				sSrchSpec = &quot;[SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND [Metric] = &apos;Minutes&apos;&quot;

			with(sProdEntBC)
			{
				ActivateField(&quot;Metric&quot;);
				ActivateField(&quot;Value&quot;);
				ClearToQuery();   
				SetViewMode(AllView); 
				SetSearchExpr(sSrchSpec);
				ExecuteQuery(ForwardOnly); 
				var isrec = FirstRecord();
				while(isrec)  
				{
					sMetric = GetFieldValue(&quot;Metric&quot;);
					sValue = GetFieldValue(&quot;Value&quot;);
					if(sGlobalProdIdent == &quot;Base Data&quot; || sGlobalProdIdent == &quot;Bonus Data&quot;)
					{
						 if(sMetric == &quot;MB&quot;)
						 	sGigaByte = ToNumber(sGigaByte) + (1048576*ToNumber(sValue));
						 else if (sMetric == &quot;KB&quot;)
						 	sKiloByte = ToNumber(sKiloByte) + ToNumber(sValue);
						 else if (sMetric == &quot;B&quot;)
						 	sByte = ToNumber(sByte) + ToNumber(sValue);
						 else if(sMetric == &quot;GB&quot;)
						 	sGigaByte = (1073741824*ToNumber(sValue)) + ToNumber(sGigaByte);
					}
					else if(sGlobalProdIdent == &quot;IDDZone1&quot; || sGlobalProdIdent == &quot;IDDZone2&quot; || sGlobalProdIdent == &quot;Bonus IDD&quot;)
					{
						IDDZone = ToNumber(IDDZone) + ToNumber(sValue); 
						IDDMetric = sMetric;
					}
						                                        
					isrec = NextRecord();
				}
			}
		}

		if(sGlobalProdIdent == &quot;Base Data&quot; || sGlobalProdIdent == &quot;Bonus Data&quot;)
		{
			Outputs.SetProperty(&quot;KB&quot;,sKiloByte);
			Outputs.SetProperty(&quot;B&quot;,sByte);
			Outputs.SetProperty(&quot;GB&quot;,ToNumber(sGigaByte)/1073741824);

			if(sKiloByte != null &amp;&amp; sKiloByte != &quot;&quot; &amp;&amp; ToNumber(sKiloByte) != 0)
				FVal = FVal + &quot;|KB:&quot;+sKiloByte; 
			if(sByte != null &amp;&amp; sByte != &quot;&quot; &amp;&amp; ToNumber(sByte) != 0)
				FVal = FVal+ &quot;|B:&quot;+sByte; 
			if(sGigaByte != null &amp;&amp; sGigaByte != &quot;&quot; &amp;&amp; ToNumber(sGigaByte) != 0)
				FVal = FVal+ &quot;|GB:&quot;+ToNumber(sGigaByte)/1073741824; 
			

		}
		else if(sGlobalProdIdent == &quot;IDDZone1&quot; || sGlobalProdIdent == &quot;IDDZone2&quot; || sGlobalProdIdent == &quot;Bonus IDD&quot;)
		{
			Outputs.SetProperty(&quot;IDDZone&quot;,IDDZone); 
			Outputs.SetProperty(&quot;IDDMetric&quot;,IDDMetric); 
			
			if(IDDZone != null &amp;&amp; IDDZone != &quot;&quot; &amp;&amp; ToNumber(IDDZone) != 0)  
			{
				FVal = &quot;|IDDZone:&quot;+IDDZone +&quot;|IDDMetric:&quot;+IDDMetric; 
			} 
		}  
		Outputs.SetProperty(&quot;EntData&quot;,FVal); 
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sProdEntBC = null;
		sProdEntBO = null;
	}
}
"
