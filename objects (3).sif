			   CREATED="09/04/2024 22:53:49"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetBillingAccountId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SetBillingAccountId (Inputs,Outputs)
{
	try
	{
		var sbo = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);
		var sbc = sbo.GetBusComp(&quot;VF Billing Account&quot;);

		var sAccntId = Inputs.GetProperty(&quot;BillingAccountId&quot;);
		var AddressId = Inputs.GetProperty(&quot;NewAddressId&quot;);
	
		with (sbc)
		{

			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Id&quot;,sAccntId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{

				SetFieldValue(&quot;Primary Address Id&quot;,AddressId);
				
				WriteRecord();
			}
		}								
			
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sbc = null;
		sbo = null;
	}

}"
			   SEQUENCE="14"
			   UPDATED="05/04/2026 15:12:13"
			   UPDATED_BY="ANGANAD"
			   CREATED="09/04/2024 22:53:49"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckAddressExist"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckAddressExist(Inputs, Outputs)
{
	var sAccountId =&quot;&quot;,FWAAddrId =&quot;&quot;,FWAAddr = &quot;&quot;,sPrimaryId = &quot;&quot;;
	Outputs.SetProperty(&quot;FWAAddress Id&quot;,&quot;&quot;);
	try
	{
		var boActive = TheApplication().GetBusObject(&quot;Account&quot;);
		var bcAccount = boActive.GetBusComp(&quot;Account&quot;);
		var oAddrInterBC = boActive.GetBusComp(&quot;Com Account Address Intersection&quot;);
		var bcCUTAddress = boActive.GetBusComp(&quot;CUT Address&quot;);
		sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		FWAAddr = Inputs.GetProperty(&quot;FWAAddress&quot;);
		var FWAAddrId = &quot;&quot;, sServiceFlg = &quot;&quot;,sServiceStatus = &quot;&quot;;
		
		with (bcAccount)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				sPrimaryId = GetFieldValue(&quot;Primary Address Id&quot;);
				with (bcCUTAddress)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Freeform address line 1&quot;);
					ActivateField(&quot;VHA Service Address Flag&quot;);
					ActivateField(&quot;Service Address Status&quot;);
					//SetSearchSpec(&quot;VHA Service Address Flag&quot;,&quot;Y&quot;);
					SetSearchSpec(&quot;Freeform address line 1&quot;,FWAAddr);
					//SetSearchSpec(&quot;Address Status&quot;,&quot;Active&quot;);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						
						sServiceFlg = GetFieldValue(&quot;VHA Service Address Flag&quot;);
						sServiceStatus = GetFieldValue(&quot;Service Address Status&quot;);
						if(sServiceFlg == &quot;Y&quot; &amp;&amp; sServiceStatus == &quot;Active&quot;)
						{
							FWAAddrId=GetFieldValue(&quot;Id&quot;);
							TheApplication().SetProfileAttr(&quot;Testi&quot;,FWAAddrId);
							Outputs.SetProperty(&quot;FWAAddress Id&quot;,FWAAddrId);
						}
						else	
						{
							NewRecord(3); // 3 = NewAfterCopy
							SetFieldValue(&quot;VHA Service Address Flag&quot;,&quot;Y&quot;);
							SetFieldValue(&quot;Latitude&quot;,TheApplication().GetProfileAttr(&quot;Latitude&quot;));
							SetFieldValue(&quot;Longitude&quot;,TheApplication().GetProfileAttr(&quot;Longitude&quot;));
							SetUserProperty(&quot;SyncSubscription&quot;, &quot;N&quot;);
							TheApplication().SetProfileAttr(&quot;AddrCopyRecordFlag&quot;,&quot;Y&quot;);
							WriteRecord();
							var sNewAddrId = GetFieldValue(&quot;Id&quot;);
							Outputs.SetProperty(&quot;FWAAddress Id&quot;,sNewAddrId);
							TheApplication().SetProfileAttr(&quot;Longitude&quot;,&quot;&quot;);
							TheApplication().SetProfileAttr(&quot;Latitude&quot;,&quot;&quot;);
							/*with(oAddrInterBC)
							{
								// update the new address intersection record
								
								ClearToQuery();
								SetSearchSpec(&quot;Address Id&quot;, sNewAddrId);
								SetSearchSpec(&quot;Account Id&quot;, sAccountId);
								ExecuteQuery(ForwardOnly);
					
								if (FirstRecord())
								{				
									// all fields are force active
									SetFieldValue(&quot;Account Id&quot;, sAccountId); 
									SetFieldValue(&quot;Address Id&quot;, sNewAddrId); 
									SetFieldValue(&quot;Attention to&quot;, &quot;&quot;);
									//SetFieldValue(&quot;Start Date&quot;, dStartDate);
									SetFieldValue(&quot;End Date&quot;, &quot;&quot;);					
									WriteRecord();
								}	
							}*/
						}
					}
					
				}

			}
		}
	}		
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcCUTAddress = null;
		oAddrInterBC = null;
		bcAccount = null;
		boActive = null;
	}
}  
"
