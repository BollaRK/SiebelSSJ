			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateComments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateComments(sOrderId)
{
 //balajiM added for atom phase2 13FEB2018
   try
   {
            var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var sAttBC = sOrderBO.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);
			var sOrderBC = sOrderBO.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
            var sComment = &quot;&quot;; 
		    with(sAttBC)
		    {
		        ActivateField(&quot;SourceOrderId&quot;);
		        ActivateField(&quot;Number of Imports&quot;);
				ActivateField(&quot;Comment&quot;);
				ActivateField(&quot;SourceFileName&quot;);
                ClearToQuery();
				SetViewMode(AllView);
	 		    SetSearchSpec(&quot;SourceOrderId&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				var irec = FirstRecord();
				while(irec)
				 {
					  var Email  = GetFieldValue(&quot;Comment&quot;);
					  var QRFile = GetFieldValue(&quot;SourceFileName&quot;);
					  var ServiceOrderId = GetFieldValue(&quot;Source Id&quot;);
					  var sFileExt = GetFieldValue(&quot;SourceFileExt&quot;);
					  var Comment = &quot;Email: &quot;+Email+&quot;, FileName:&quot;+QRFile;
					  with(sOrderBC)
					  {
						  ActivateField(&quot;Parent Order Item Id&quot;);
						  ActivateField(&quot;VF Comments&quot;);
						  ClearToQuery();
				          SetViewMode(AllView);
	 		              SetSearchSpec(&quot;Id&quot;, ServiceOrderId);
						  SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
						  ExecuteQuery(ForwardOnly);
				          if(FirstRecord())
						  {
						      var sOrderComm = GetFieldValue(&quot;VF Comments&quot;);
						      sComment = sOrderComm+&quot;: &quot;+Comment;
							  SetFieldValue(&quot;VF Comments&quot;, sComment);
                              WriteRecord();
						  }
				     }
					 irec = NextRecord();
				}
                
              }
   }
   catch(e)
   {
    throw(e);
   }
   finally
   {
      sOrderBO = null;
      sAttBC = null;
      sOrderBC = null;
   } 
}"
