			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPlanDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPlanDetails(Inputs, Outputs)
{
	try
	{
		var sPlanBO = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;)
		var sPlanBC = sPlanBO.GetBusComp(&quot;VF MPP Line Item Primary Product&quot;);
		var strPlan = &quot;&quot;;
		var sLineId = Inputs.GetProperty(&quot;LineId&quot;);
		with (sPlanBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;Product&quot;);
			SetSearchSpec(&quot;Root Order Item Id&quot;, sLineId);
			ExecuteQuery();
			if (FirstRecord())
			{
				strPlan = GetFieldValue(&quot;Product&quot;);
			}
		}
		
		Outputs.SetProperty(&quot;Plan&quot;, strPlan);
		
	}
	catch(e)
	{
	throw(e);
	}
	
	finally
	{
		sPlanBO = &quot;&quot;;
		sPlanBC = &quot;&quot;;
		strPlan = &quot;&quot;;
		sLineId = &quot;&quot;;
	}
}"
