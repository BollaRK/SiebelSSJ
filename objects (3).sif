			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdatePIN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdatePIN (Inputs, Outputs)
{
/*
* Date                                   Author  Description
* ----------   ------               -------------------------------------------------------
* 23/06/2014      Neel                      Cloned from VF Wizard Utilities
*/

try
{
var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var boOrders = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
var bcOrders = boOrders.GetBusComp(&quot;Order Entry - Orders&quot;);
var bcOrderLineItems = boOrders.GetBusComp(&quot;Order Entry - Line Items&quot;);
var searchst = &quot;&quot;;
var strServiceAccntPIN = &quot;&quot;;
with(bcOrders)
{
	ClearToQuery();
	SetViewMode(AllView);
	SetSearchSpec(&quot;Id&quot;, sOrderId);
	ExecuteQuery(ForwardBackward);
	if(FirstRecord())
	{
		with(bcOrderLineItems)
		{
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;Service PIN&quot;);
			ActivateField(&quot;Service Account Id&quot;);
			ActivateField(&quot;Service Acount PIN&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId  + &quot;&apos; AND [Parent Order Item Id] IS NULL &quot;;
			SetSearchExpr(searchst);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
				strServiceAccntPIN = GetFieldValue(&quot;Service Acount PIN&quot;);
				SetFieldValue(&quot;Service PIN&quot;, strServiceAccntPIN);           
				WriteRecord();
			}
		}//with
	}//if
}
}
catch(e)
{
throw(e)
}
finally
{
bcOrderLineItems = null;
bcOrders = null;
boOrders = null;
}
}"
