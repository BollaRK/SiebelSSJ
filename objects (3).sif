			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateFutureDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateFutureDate(Inputs, Outputs){
var sOrderTypeTBUI = Inputs.GetProperty(&quot;OrderTypeTBUI&quot;);
var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
var sSessionId = Inputs.GetProperty(&quot;SessionId&quot;);
var sFutureDate=&quot;&quot;;
TheApplication().SetProfileAttr(&quot;112&quot;,sOrderTypeTBUI + &quot; &quot; +sOrderId+&quot; &quot; + sSessionId);
if(sOrderTypeTBUI = &quot;NBN to 5G transfer&quot;)
{
	var oBC = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;VHA NBN to 5G Migration&quot;);
	with (oBC)
	{
		ClearToQuery();
		ActivateField(&quot;5G Connection Date&quot;);
		SetSearchSpec(&quot;Wizard Session Id&quot;, sSessionId);
		ExecuteQuery();
		if(FirstRecord())
		{
			sFutureDate = GetFieldValue(&quot;5G Connection Date&quot;);
		}
	}
	TheApplication().SetProfileAttr(&quot;211&quot;,sFutureDate); 
	if(sFutureDate!=&quot;&quot;)
	{
		var oBC = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
		with (oBC)
		{
			ClearToQuery();
			SetViewMode(&quot;AllView&quot;);
			ActivateField(&quot;Future Submit Date&quot;);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if(FirstRecord())
			{
				SetFieldValue(&quot;Future Submit Date&quot;, sFutureDate);
				WriteRecord();
			}
		}
	}

}
}"
			   SEQUENCE="8"
			   UPDATED="08/17/2021 21:36:32"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2021 21:36:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateTBCDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateTBCDetails (Inputs, Outputs)
{
	var sSKIPWriteFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SWITCH&quot;, &quot;SKIP_Write&quot;);
	if(sSKIPWriteFlg == &quot;Y&quot;)
	{
		var sBO = TheApplication().ActiveBusObject();
		var sCaptureTBC = sBO.GetBusComp(&quot;VF Capture Customer Details TBC&quot;);
		TheApplication().SetProfileAttr(&quot;BS Triggered&quot;, &quot;Yes&quot;);
		var sABNStatus = sCaptureTBC.GetFieldValue(&quot;VF ABN Status&quot;);
		if(sABNStatus != &quot;Active&quot; &amp;&amp; sABNStatus != &quot;&quot; &amp;&amp; sABNStatus != null)
		{
			TheApplication().RaiseErrorText(&quot;ABN Status is Invalid.Ineligible Customer will not be permitted to create a Customer Account &quot;);
		}
		var sValidatePostFlg = sCaptureTBC.GetFieldValue(&quot;VF Postcode Validate Flag&quot;);
		var sManualAddrFlg 	= sCaptureTBC.GetFieldValue(&quot;Manual Address Entry&quot;);
		if(sManualAddrFlg == &quot;Y&quot;)
		{
			if(sValidatePostFlg == &quot;N&quot;)
			{
				TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query AusPost atleast once before saving an unvalidated address.&quot;);	
			}
		}
		try
		{
			if(sCaptureTBC.GetFieldValue(&quot;Customer Type&quot;) == &quot;Person&quot; &amp;&amp; sCaptureTBC.GetFieldValue(&quot;Sole Trader&quot;) == &quot;N&quot;)
			{
				sCaptureTBC.SetFieldValue(&quot;ABN/ACN&quot;,&quot;&quot;);
				sCaptureTBC.SetFieldValue(&quot;Industry Type&quot;,&quot;&quot;);
				sCaptureTBC.SetFieldValue(&quot;Trading As&quot;,&quot;&quot;);
				sCaptureTBC.SetFieldValue(&quot;Company Name&quot;,&quot;&quot;);
				sCaptureTBC.WriteRecord();
			}
		}
		catch (e)
		{
			TheApplication().RaiseErrorText(e.toString());
		}
		finally
		{
	
		}

	}
}
"
