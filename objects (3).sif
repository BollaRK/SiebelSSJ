			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateNewGroupLeadMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Kailash/R17.2/PKE000000040904 &amp; PKE000000050073/created this function to check for lead MSISDN exists for Billing Account Id
function mValidateNewGroupLeadMSISDN(Inputs,Outputs)
{
	try
	{	
		var BO = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var BC = BO.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var sBillAcntId = Inputs.GetProperty(&quot;sBillAcntId&quot;);
		var sMSISDN = Inputs.GetProperty(&quot;sMSISDN&quot;);
		
		var sSearchExp = &quot;[Billing Account Id] = &apos;&quot; + sBillAcntId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Order Status]&lt;&gt; &apos;Cancelled&apos; AND [Order Status] &lt;&gt; &apos;Complete&apos; AND [Sharing Lead MSISDN] = &apos;&quot; + sMSISDN + &quot;&apos;&quot;;
		var sErr=&quot;&quot;;
		
		with(BC)
		{
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;Sharing Lead MSISDN&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ClearToQuery();
			SetSearchExpr(sSearchExp);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sErr =  &quot;You are attempting to make changes to a Sharing Group which has an order against it that has not yet completed. Please carry out one of the following actions:\n\r1) Complete other order then re-submit this TBUI session; OR\n\r2) Remove Sharing changes from this order and re-submit \n(Please ensure Sharing changes are made later per customer request)&quot;;
			}	
		}
		Outputs.SetProperty(&quot;sErr&quot;,sErr);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		BC = null;
		BO = null;
	}
}"
