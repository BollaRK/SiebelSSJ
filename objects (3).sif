			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPOTSValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPOTSValidation(Inputs, Outputs)
{
try{
	var ERR_FBB_POTS = &quot;9021&quot;;
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
	var bcSQ = boOrder.GetBusComp(&quot;VHA Site Qualification Service List&quot;);
	var SQRowId = Inputs.GetProperty(&quot;SQRowId&quot;);
		with(bcSQ) 
		{ 
			var searchspec = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos; AND [POTS Interconnect Match] = &apos;No&apos;&quot;; 
			SetViewMode(AllView); 
			ClearToQuery();
			SetSearchExpr(searchspec);
			ExecuteQuery(ForwardOnly); 
			if(FirstRecord()) 
			{ 
				//TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_FBB_POTS));
				TheApplication().RaiseErrorText(&quot;VFErrorCode#9021&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_FBB_POTS));
			} 
		}
	} 
	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcSQ = null;
		boOrder = null;
	}
	
	return (ContinueOperation);	
}"
