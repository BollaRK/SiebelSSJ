			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	switch(MethodName)
		{
			case &quot;SQValidations&quot;:
				mLeadValidation(Inputs, Outputs);
				
			//	mSelectService(Inputs, Outputs);//Roseline:27/04/2017  - Removed the validation as it is not required.	
				
				//mTransferType(Inputs, Outputs);//Roseline:27/04/2017  - Removed the validation as it is not required.			
				
			//	mTransferOption(Inputs, Outputs); //Suresh G 7/19/2017 - Removed this validation as it has been captured in DVM.
				
			//	mPOTSValidation(Inputs,Outputs); //Roseline:30/05/2017  - Removed the validation as it is not required.
				
				return(CancelOperation);
				break;	
			
			case &quot;LineItemValidations&quot;:
				
				mValidateConnType(Inputs, Outputs);
				
				mValidateLineItem(Inputs, Outputs);	
				Outputs.SetProperty(&quot;OrderItemId&quot;,Outputs.GetProperty(&quot;OrderItemId&quot;));
				Outputs.SetProperty(&quot;IMEIValidFlg&quot;,Outputs.GetProperty(&quot;IMEIValidFlg&quot;));
				//mValidateAccesTechnology(Inputs, Outputs); //Roseline:27/04/2017  - Removed the validation as it is not required.
				
				mValidateNBNOrderContact(Inputs, Outputs);
				
				return(CancelOperation);
				break;
			case &quot;ValidateConnectionType&quot;:
				mValidateConnType(Inputs, Outputs);
				return(CancelOperation);
				break;		
			default:
				break;
		}		
	return (ContinueOperation);	
}"
