			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCancelOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCancelOrder(Inputs, Outputs)
{
	try
	{
	
		var sOrderId= Inputs.GetProperty(&quot;OrderId&quot;);
		var sAccId = Inputs.GetProperty(&quot;AccountId&quot;);  // Sachi - 22/05/2019 - Added for MR02 ACMA Fixes
		var sOrderTypeTBUI = Inputs.GetProperty(&quot;OrderTypeTBUI&quot;);  // Sachi - 22/05/2019 - Added for MR02 ACMA Fixes
		TheApplication().Trace(&quot;mCancelOrder : sOrderId :: &quot; + sOrderId);
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Relationships&quot;);
		var sBCOrder = boOrder.GetBusComp(&quot;VF Order Header&quot;);
		var bcOrderLineIt = boOrder.GetBusComp(&quot;VF Order Line Items - Delete&quot;);
		//Roseline:10/08/2015 - Added for UNISIM defect#930
		//Nullify the profile attribute while cancelling/pausing the UNISIM order.
		TheApplication().SetProfileAttr(&quot;TBUIUNISIMUPCCode&quot;,&quot;N&quot;);
		TheApplication().SetProfileAttr(&quot;SkipCaptureShipAddr&quot;,&quot;N&quot;); //Sachi:19/03/2020 - added for capture delivery address in R20.1
		TheApplication().SetProfileAttr(&quot;DISABLE_PREVIOUS&quot;,&quot;N&quot;);//Roseline:15/09/2015 - Added for UNISIM - Offers Page Nullify issue
		TheApplication().SetProfileAttr(&quot;SecMSISDNFlg&quot;,&quot;&quot;);
		//Indumathi: Added below code for R19.1 PKE#68462
		var sOrderType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
		if((sOrderId == &quot;&quot; || sOrderId == null) &amp;&amp; (sOrderType == &quot;NBN Reactivate&quot; || sOrderType == &quot;NBN Transfer Reversal&quot;))
		sOrderId = TheApplication().GetProfileAttr(&quot;FBBReactivateOrderId&quot;);			
		/*var sPPBS = TheApplication().GetService(&quot;VHA Prepayments BS&quot;);
		var sPPInputs  = TheApplication().NewPropertySet();
		var sPPOutputs = TheApplication().NewPropertySet();*/
		
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			/*sPPInputs.SetProperty(&quot;OrderId&quot;, sOrderId);			
			sPPBS.InvokeMethod(&quot;DeleteCCDetails&quot;, sPPInputs, sPPOutputs);*/
		
			
		   var sHeaderOnly = &quot;Y&quot;;
		   with(sBCOrder)
		   {
		   		sBCOrder.ActivateField(&quot;Status&quot;);
		   		sBCOrder.ActivateField(&quot;Active&quot;);
		   		sBCOrder.ClearToQuery();
				sBCOrder.SetViewMode(AllView);
				sBCOrder.SetSearchSpec(&quot;Id&quot;,sOrderId);
				sBCOrder.SetSearchSpec(&quot;Status&quot;,TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Pending&quot;)); //Indumathi: Searchspec added for 18.2 PKE fix 59554
				sBCOrder.ExecuteQuery(ForwardOnly);
				if(sBCOrder.FirstRecord())
				{
					var sOrderNum = GetFieldValue(&quot;Order Number&quot;);
					TheApplication().Trace(&quot;mCancelOrder : sOrderNum :: &quot; + sOrderNum);
					var boTask = TheApplication().GetBusObject(&quot;UInbox Item Task&quot;);
					var bcTask = boTask.GetBusComp(&quot;UInbox Item Task&quot;);
					with(bcTask)
					{
						bcTask.ClearToQuery();
						bcTask.SetViewMode(AllView);
						bcTask.ActivateField(&quot;VF Order Number TBUI&quot;);
						bcTask.SetSearchSpec(&quot;VF Order Number TBUI&quot;, sOrderNum);
						bcTask.ExecuteQuery();
						if(bcTask.FirstRecord())
						{
							//Do Nothing
						}
						else
						{
			  
							with(bcOrderLineIt)
							{
								bcOrderLineIt.ActivateField(&quot;Order Header Id&quot;);     
								bcOrderLineIt.ClearToQuery();
								bcOrderLineIt.SetViewMode(AllView);
								bcOrderLineIt.SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId +&quot;&apos;&quot;);
								bcOrderLineIt.ExecuteQuery(ForwardOnly);
								var iRecord = bcOrderLineIt.FirstRecord();
								if(iRecord)
								{
									TheApplication().Trace(&quot;mCancelOrder : Run Cancel Workflow Start &quot; + sOrderId);       
									sHeaderOnly = &quot;N&quot;;
									Inputs.SetProperty(&quot;HeaderOnly&quot;,sHeaderOnly);
									var bsWFProcMgr = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
									var psInputs = TheApplication().NewPropertySet();
									var psOutputs = TheApplication().NewPropertySet();
									psInputs.SetProperty(&quot;Object Id&quot;,sOrderId);
									psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Cancel Order&quot;); 
									bsWFProcMgr.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs); 
									TheApplication().Trace(&quot;mCancelOrder : Run Cancel Workflow End &quot; + sOrderId);     
								}
								else
									sHeaderOnly = &quot;Y&quot;;
							
							}//end of with
							if(sHeaderOnly ==&quot;Y&quot;)
							{
								TheApplication().Trace(&quot;mCancelOrder : Run Cancel Workflow Header Only Start &quot; + sOrderId);       
								Inputs.SetProperty(&quot;HeaderOnly&quot;,sHeaderOnly);
								sBCOrder.SetFieldValue(&quot;Status&quot;,&quot;Cancelled&quot;);
								sBCOrder.SetFieldValue(&quot;Active&quot;,&quot;N&quot;);
								sBCOrder.WriteRecord();
								TheApplication().Trace(&quot;mCancelOrder : Run Cancel Workflow Header Only End &quot; + sOrderId);       
								
								if(sOrderTypeTBUI != &quot;&quot; &amp;&amp; sOrderTypeTBUI != null &amp;&amp; sOrderTypeTBUI == &quot;Pre to Post transfer&quot;)   //Sachi - 22/05/2019 - Added for MR02 ACMA Fixes - Start
								{
									if(sAccId != &quot;&quot; &amp;&amp; sAccId != null)
									{
										var sServ = TheApplication().GetService(&quot;VHA Prepay Unbar Validation&quot;);
									 	var psInputs =TheApplication().NewPropertySet();
									 	var psOutputs = TheApplication().NewPropertySet();
									 	psInputs.SetProperty(&quot;OrderId&quot;, sOrderId);
									 	psInputs.SetProperty(&quot;AccountId&quot;, sAccId);
									 	sServ.InvokeMethod(&quot;RemoveIdDetails_Delete&quot;, psInputs, psOutputs);
								 	}
								}		//Sachi - 22/05/2019 - Added for MR02 ACMA Fixes - End
							}
							//23/05/2016  NIRMAL Added for PKE000000037212	  
							var psIn = TheApplication().NewPropertySet();
							var psOut = TheApplication().NewPropertySet();
							var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
							psIn.SetProperty(&quot;Object Id&quot;,sOrderId);
							psIn.SetProperty(&quot;ProcessName&quot;, &quot;VHA Cancel Fulfilment Order&quot;);
							svc.InvokeMethod(&quot;RunProcess&quot;, psIn, psOut);
							//End. PKE000000037212
						}
					}//end of with(bcTask)			
			  }//end of  if(FirstRecord())
			}// end of with(sBCOrder)
		}// end of if(sOrderId != &quot;&quot;)
		var sApp = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
		var sAppLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SPS_LOV&quot;,&quot;AppName&quot;);
		var sHomepage = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SPS_LOV&quot;,&quot;HomePage&quot;);
		
		
		//TheApplication().Trace(sApp+&quot;_1_ &quot;+sAppLov+&quot;_1_ &quot;+sHomepage);
		//TheApplication().RaiseErrorText(sApp+&quot;_1_ &quot;+sAppLov+&quot;_1_ &quot;+sHomepage);
		
		if(Clib.stricmp(sApp,sAppLov) == 0)
		{
			TheApplication().Trace(sApp+&quot;_1_ &quot;+sAppLov+&quot;_1_ &quot;+sHomepage);
			//TheApplication().RaiseErrorText(sApp+&quot;_1_ &quot;+sAppLov+&quot;_1_ &quot;+sHomepage);
			var vBO = TheApplication().GetBusObject(&quot;VF SPS Home Page BO&quot;);
			var vBC = vBO.GetBusComp(&quot;VF SPS Flow Select VBC&quot;); 			
			TheApplication().GotoView(sHomepage,&quot;VF SPS Home Page BO&quot;);
			with (vBC)
			{
					SetViewMode(3);
					ActivateField(&quot;Business Type&quot;);
					ClearToQuery();
					SetSearchSpec(&quot;Business Type&quot;, &quot;&quot;);
					ExecuteQuery();		
			
			}			
						
		}

		if(TheApplication().GetProfileAttr(&quot;VHADashboardAssetId&quot;) != &quot;&quot;)
		{
			TheApplication().SetProfileAttr(&quot;Hi&quot;,&quot;Helloo&quot;);
			TheApplication().GotoView(&quot;CUT Home Page View (CME)&quot;,&quot;WebCallCenter Home&quot;);	
		}
			

	}// end of try
	
	catch(e)
	{
		TheApplication().Trace(&quot;mCancelOrder : Error &quot; + e);       
		throw(e);   
	}
	finally
	{
		/*Below variables are nullified by JAGJIT on 22/03/2019*/
		/*psIn = null;
		psInputs = null;
		psOut = null;
		psOutputs = null;
		svc = null;
		vBC = null;
		vBO = null;
		bsWFProcMgr = null;*/
		//end 22/03/2019

		/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
		if(defined(psIn)) { psIn = null; }
		if(defined(psInputs)) { psInputs = null; }
		if(defined(psOut)) { psOut = null; }
		if(defined(psOutputs)) { psOutputs = null; }
		if(defined(svc)) { svc = null; }
		if(defined(vBC)) { vBC = null; }
		if(defined(vBO)) { vBO = null; }
		if(defined(bsWFProcMgr)) { bsWFProcMgr = null; }

		bcTask = null;
		boTask = null;
		bcOrderLineIt = null;
		sBCOrder = null;
		boOrder = null;
		TheApplication().SetProfileAttr(&quot;CancelUpgradeOrderId&quot;, &quot;&quot;);
		TheApplication().SetProfileAttr(&quot;mCancelSessionId&quot;, &quot;&quot;);
	 	TheApplication().SetProfileAttr(&quot;DeleteSessionId&quot;, &quot;&quot;);
 		TheApplication().SetProfileAttr(&quot;CancelUpgradeOrderId&quot;, &quot;&quot;);
 		//Indumathi: Added for R19.1 PKE#68462
 		TheApplication().SetProfileAttr(&quot;ChangeLocationAccessTechnology&quot;, &quot;&quot;);
 		TheApplication().SetProfileAttr(&quot;FBBReactivateOrderId&quot;, &quot;&quot;);
 		TheApplication().SetProfileAttr(&quot;ManageServicesSubType&quot;, &quot;&quot;);
 		TheApplication().TraceOff();
		//psCurrentProduct = null; 
		//psCurrentPort = null; 
	}
}"
			   SEQUENCE="7"
			   UPDATED="05/23/2025 19:38:37"
			   UPDATED_BY="RAVINDRAK"
			   CREATED="10/24/2014 23:15:43"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateOrder (Inputs, Outputs)
{
	try
	{
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		with (bcOrder)
		{
			ClearToQuery(); 
			SetViewMode(AllView); 
			//ExecuteQuery(ForwardOnly); NEEL 01SEP2014 - Removed as part of PT phase
			NewRecord(NewBefore);
			SetFieldValue(&quot;Currency Code&quot;,&quot;AUD&quot;);
			SetFieldValue(&quot;Order Type&quot;,Inputs.GetProperty(&quot;Order Type&quot;));
			SetFieldValue(&quot;Order Sub Type&quot;,Inputs.GetProperty(&quot;Order Sub Type&quot;));
			SetFieldValue(&quot;VF Submit Method&quot;, &quot;TBUI&quot;);//NEEL 24.02.2014 - Added to Identify TBUI raised order.
			WriteRecord();
			Outputs.SetProperty(&quot;Object Id&quot;, GetFieldValue(&quot;Id&quot;));
			Outputs.SetProperty(&quot;Order Number&quot;, GetFieldValue(&quot;Order Number&quot;));
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcOrder = null;
		boOrder = null;
	}
}"
			   SEQUENCE="11"
			   UPDATED="05/23/2025 19:38:37"
			   UPDATED_BY="RAVINDRAK"
			   CREATED="08/14/2014 00:38:40"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteOrderHeader"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteOrderHeader(Inputs, Outputs)
{
	try
	{
		var strOrderId= Inputs.GetProperty(&quot;OrderId&quot;);
		var strDeleteOrder= Inputs.GetProperty(&quot;DeleteHeader&quot;);
		var strHeaderOnly= Inputs.GetProperty(&quot;HeaderOnly&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Relationships&quot;);
		var sBCOrder = boOrder.GetBusComp(&quot;VF Order Header&quot;);		
		if(strOrderId != &quot;&quot; &amp;&amp; strDeleteOrder == &quot;Y&quot; &amp;&amp; strHeaderOnly == &quot;Y&quot;)
		{
		   with(sBCOrder)
		   {
				sBCOrder.ClearToQuery();
				sBCOrder.SetViewMode(AllView);
				sBCOrder.SetSearchSpec(&quot;Id&quot;,strOrderId);
				sBCOrder.ExecuteQuery(ForwardOnly);
				if(sBCOrder.FirstRecord())
				{
					sBCOrder.DeleteRecord();
				}
			}
		}
	}// end of try
	
	catch(e)
	{      
		throw(e);   
	}
	finally
	{
		sBCOrder = null;
		boOrder = null;
	}
}"
			   SEQUENCE="12"
			   UPDATED="05/23/2025 19:38:37"
			   UPDATED_BY="RAVINDRAK"
			   CREATED="10/23/2016 16:06:05"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGeoSiteAPINewCall"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGeoSiteAPINewCall(Inputs, Outputs)
{
	try
	{
		var sBO = &quot;&quot;,sBC = &quot;&quot;;
		var psErrorInput = &quot;&quot;, psErrorOutput = &quot;&quot;, bsError = &quot;&quot;;
		var sWFProcMgrBS = &quot;&quot;,psOutputs = &quot;&quot;, psInputs = &quot;&quot;, sErrorMessage = &quot;&quot;, sRestAPIErrMsg = &quot;&quot;;
		var iRecord = &quot;&quot;;
		var sGeoAPICalled = &quot;&quot;;
		var sSQId = &quot;&quot;;
		var sCSAId = &quot;&quot;;
		var sOSAId = &quot;&quot;;
		var sNBNSpeed = &quot;&quot;;
		var sNetwork = &quot;&quot;;
		var sGeoAPIFlg = &quot;N&quot;;
		
		sSQId = TheApplication().GetProfileAttr(&quot;GeoSQId&quot;);
		sGeoAPICalled = TheApplication().GetProfileAttr(&quot;GeoAPICalled&quot;);
		sNetwork = TheApplication().GetProfileAttr(&quot;GeoNetwork&quot;);
		//TheApplication().SetProfileAttr(&quot;GeoSQId&quot;, &quot;&quot;);
		TheApplication().SetProfileAttr(&quot;GeoAPICalled&quot;, &quot;&quot;);
		//TheApplication().SetProfileAttr(&quot;GeoNetwork&quot;, &quot;&quot;);
			// sindhu : added below code for Coveragecheck SSJ requirement.
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		if(sSQId ==&quot;&quot; || sSQId == null)
			sSQId = Inputs.GetProperty(&quot;SQId&quot;); 
		
		if (sNetwork ==&quot;&quot; || sNetwork ==null) 
			sNetwork = Inputs.GetProperty(&quot;Network&quot;); 

		if (sGeoAPICalled ==&quot;&quot; || sGeoAPICalled == null) 
			sGeoAPICalled = Inputs.GetProperty(&quot;GeoAPICall&quot;);	
			
			//sindhu.//
		
		sBO = TheApplication().GetBusObject(&quot;VHA Site Qualification BO&quot;);
		sBC = sBO.GetBusComp(&quot;VHA Site Qualification BC&quot;);		

		if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableNewGeoSiteAPI&quot;) == &quot;Y&quot; &amp;&amp; sGeoAPICalled == &quot;Y&quot;)
		{
			TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;N&quot;);
			if(sSQId !=&quot;&quot;)
			{					
				with(sBC)
				{
					sBC.SetViewMode(AllView);
					sBC.ClearToQuery();
					sBC.ActivateField(&quot;Id&quot;);
					sBC.ActivateField(&quot;CSA Id&quot;);
					sBC.ActivateField(&quot;OSA Id&quot;);
					sBC.ActivateField(&quot;VHAHighSpeedAttribute&quot;);
					sBC.SetSearchSpec(&quot;Id&quot;, sSQId);
					sBC.ExecuteQuery(ForwardOnly);	
					iRecord = sBC.FirstRecord();
					if(iRecord) 
					{
						sCSAId = GetFieldValue(&quot;CSA Id&quot;);
						sOSAId = GetFieldValue(&quot;OSA Id&quot;);
						sNBNSpeed = GetFieldValue(&quot;VHAHighSpeedAttribute&quot;);
						sNBNSpeed = sNBNSpeed.replace(/[^0-9]/g, &apos;&apos;);			
					}
				}
				sWFProcMgrBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				psOutputs = TheApplication().NewPropertySet();
				psInputs = TheApplication().NewPropertySet();
			
				if(sNetwork.toUpperCase() == &quot;OPTICOMM&quot;)
				{
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Opticomm OVC WF&quot;);
					psInputs.SetProperty(&quot;OSAId&quot;, sOSAId); 
					if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
						psInputs.SetProperty(&quot;ConnectOrderId&quot;, sOrderId); 
				}
				else
				{
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VHA Geographic Site API Process&quot;);
					psInputs.SetProperty(&quot;Transaction Name&quot;, &quot;VHAGeographicSiteAPI&quot;); 
					psInputs.SetProperty(&quot;MapName&quot;, &quot;VHA Geographic Site Map&quot;); 
					psInputs.SetProperty(&quot;CVCId&quot;, sCSAId); 
					psInputs.SetProperty(&quot;serviceName&quot;, &quot;NBN&quot;);
					psInputs.SetProperty(&quot;bandwidth&quot;,sNBNSpeed);
				}
				psInputs.SetProperty(&quot;SQId&quot;, sSQId); 
				psInputs.SetProperty(&quot;FlowName&quot;, &quot;SQ&quot;);
				sWFProcMgrBS.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				sErrorMessage = psOutputs.GetProperty(&quot;Error Message&quot;);
				sRestAPIErrMsg = psOutputs.GetProperty(&quot;RestAPIErrMsg&quot;);
				if(sErrorMessage !=&quot;&quot;)
				{
					sGeoAPIFlg = &quot;Y&quot;	
					TheApplication().RaiseErrorText(sErrorMessage);
				}
				else if(sRestAPIErrMsg !=&quot;&quot;)
				{
					sGeoAPIFlg = &quot;Y&quot;
					TheApplication().RaiseErrorText(sRestAPIErrMsg);
				}
				else
				{
					TheApplication().SetProfileAttr(&quot;BRECallExecuted&quot;, &quot;Y&quot;); // Used for validation in VHA SQ Sub Task 
				}
			}
			if (TheApplication().ActiveViewName() != &quot;VF Coverage Check Details - Postpay - SSJ&quot; &amp;&amp; TheApplication().ActiveViewName() !=&quot;VHA Connection Wizard View - Billing Detail - TBUI - SSJ&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VHA Connection Wizard View - Exist Billing Detail - TBUI - SSJ&quot;)
			{
				var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
				var psIn = TheApplication().NewPropertySet();
				var psOut = TheApplication().NewPropertySet();
				psIn.SetProperty(&quot;Refresh All&quot;,&quot;Y&quot;);
				svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;,psIn,psOut);
			}
		}
	}
	catch(e)
	{
		//TheApplication().SetProfileAttr(&quot;GeoSQId&quot;, &quot;&quot;);
		TheApplication().SetProfileAttr(&quot;GeoAPICalled&quot;, &quot;Y&quot;);
		//TheApplication().SetProfileAttr(&quot;GeoNetwork&quot;, &quot;&quot;);
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;GeoSiteAPINewCall&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;mGeoSiteAPINewCall&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage);
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		if(sGeoAPIFlg == &quot;Y&quot;)
		{
			throw(e);
		}
	}
	finally
	{
		sBO = null;
		sBC = null;
		bsError = null;
		sWFProcMgrBS = null;
		svcUI = null;
		psInputs = null;
		psOutputs = null;
		psIn = null;
		psOut = null;
		psErrorInput = null;
		psErrorOutput = null;
	}
}	"
			   SEQUENCE="13"
