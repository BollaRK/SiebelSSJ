			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	var iReturn = ContinueOperation;
	try
	{
		if(MethodName == &quot;UpdateBuscom&quot;)
		{
			mUpdateBuscomp(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;InsertBuscomp&quot;)
		{
			mInsertBuscomp(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;UpdateSeqNdDiscount&quot;)
		{
			fUpdateSeqNdDiscount(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;UpdatePriceVal&quot;)
		{
			fUpdatePriceVal(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;GetDiscountAmnt&quot;)
		{
			mGetDiscountAmnt(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;QueryBusComp&quot;)
		{
			fQueryBusComp(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;ResetBanChngPrimFlg&quot;)
		{
			fResetBanChngPrimFlg(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;UpdateRtActCd&quot;)
		{
			fUpdateRtActCd(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		if(MethodName == &quot;UpdateBundleSaveActCd&quot;)
		{
			fUpdateBundleSaveActCd(Inputs,Outputs);
			iReturn = CancelOperation;
		}
		
	}
	catch(e)
	{
		throw(e);
	}
	return (iReturn);
}"
