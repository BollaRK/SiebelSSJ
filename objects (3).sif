			   SCRIPT="function UpdateSSOSharingFlag(strOrderId)
{
	try
	{
		var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		
		
		with(bcOrderLineItems)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;VF Sharing Order&quot;);
			//SetSearchSpec(&quot;Order Header Id&quot;, strOrderId);
			//SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
			var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + strOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;; // PKE000000045550 //Karthika - 12/06/2017 - Added as part of Retrofit
			SetSearchExpr(sSearchspec); //Karthika - 12/06/2017 - Added as part of Retrofit
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				SetFieldValue(&quot;VF Sharing Order&quot;,&quot;N&quot;);
				WriteRecord();
				
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{/*Below variables are nullified by GURUPRASAD on 23/10/2019*/
