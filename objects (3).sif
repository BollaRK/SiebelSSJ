			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetDeviceRCC"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetDeviceRCC(sOrderId)
{
	/* Component Name        : 	TBUI - mGetDeviceRCC
	* Component Information : 	This method is to Get the RCC Value for the Device
	* Modification History  :
	* Date	          Author		Config #	Description
	* ============ ===========	===========	================================
	* 30/05/2014	Neel 		Initial Draft Version - Cloned from VF Wizard Utilities
	*/

 	try
	{
 		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START: BS: VF TBUI Utilities - mGetDeviceRCC&quot;);
		}

		var bContinue = false;
		var strAttrVal=0;
		var strError=&quot;&quot;;	

		// Get order Id	
		var idOrder = sOrderId;	
	
		if (idOrder != &quot;&quot;)
		{
			var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		    var bcOrderLineItems = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);   
    
		    bcOrder.ClearToQuery();
			bcOrder.SetSearchSpec(&quot;Id&quot;, idOrder);
			bcOrder.SetViewMode(AllView);
			bcOrder.ExecuteQuery(ForwardOnly);
		
			if (bcOrder.FirstRecord())
			{				
 
	    		with(bcOrderLineItems)
				{		
					bcOrderLineItems.ClearToQuery();
					bcOrderLineItems.ActivateField(&quot;Product&quot;);
					bcOrderLineItems.ActivateField(&quot;Action Code&quot;);
		
					// Anoop Changed the Search Expr for another product for R 11 D, IPhone 5(Project Johny)
				    bcOrderLineItems.SetSearchExpr(&quot;([Product] = &apos;Device&apos; OR [Product] = &apos;Device-Siebel Only&apos;) AND [Action Code] = &apos;Add&apos;&quot;); 
					bcOrderLineItems.ExecuteQuery(ForwardOnly);
			
					bContinue = bcOrderLineItems.FirstRecord();
			
					if(bContinue)
					{	
		                var bcOrderLineItemsXA = boOrder.GetBusComp(&quot;Order Item XA&quot;);  
		                bcOrderLineItemsXA.ActivateField(&quot;Value&quot;);				
						bcOrderLineItemsXA.ClearToQuery();
						bcOrderLineItemsXA.SetViewMode(AllView);
						bcOrderLineItemsXA.SetSearchSpec(&quot;Display Name&quot;, &quot;Device RCC Inc GST&quot;);
						bcOrderLineItemsXA.ExecuteQuery(ForwardOnly);
		
						if (bcOrderLineItemsXA.FirstRecord())
						{
							strAttrVal = bcOrderLineItemsXA.GetFieldValue(&quot;Value&quot;);
						}
					} // End if
				} // End With		
			}// End if
		}	// End Main if 
	
		return(strAttrVal);
		
	 } // End Try
	catch(e)
	{
		if (defined(e.errText))
		{
			strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			strError = arguments.callee + ToString(e); 
		}

	    //Trace
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;Error:BS: VF TBUI Utilities - mGetDeviceRCC&quot;+strError);
		}
		throw (strError);
	}
 	finally
 	{
 		// kill objects in order (bottom up)
		bcOrderLineItemsXA = null;
		bcOrderLineItems = null;
		bcOrder = null;	
		boOrder = null;	
 	}
}"
			   SEQUENCE="19"
			   UPDATED="02/13/2025 09:04:45"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2014 00:41:59"
