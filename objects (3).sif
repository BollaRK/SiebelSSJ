			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateLeadSharingDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
* Component Name        : 	VHA Sharing Simplification
* Method Name           : 	fnValidateLeadSharingDetails
* Component Information : 	This method is to check any Open order for Lead MSISDN to remove sharing lead
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 19/11/2018	Indumathi					Initial Version
*/
function fnValidateLeadSharingDetails(Inputs, Outputs)
{
 try
 {
    var sGroupId = Inputs.GetProperty(&quot;Group Id&quot;);
	var sBillingAcntId = Inputs.GetProperty(&quot;BillingAcntId&quot;);
	var sLeadMSISDN = Inputs.GetProperty(&quot;Lead MSISDN&quot;);
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sBO = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
	var sBC = sBO.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
	var sErrormessage = &quot;&quot;, sOrderStatus = &quot;&quot;, sOrderNo = &quot;&quot;, sAssetId = &quot;&quot;, sOrderType=&quot;&quot;, sActionCode = &quot;&quot;, str = &quot;&quot;;
	Outputs.SetProperty(&quot;LeadOrderStatus&quot;, &quot;&quot;);
    Outputs.SetProperty(&quot;LeadOrderNo&quot;, &quot;&quot;);
    Outputs.SetProperty(&quot;LeadAssetId&quot;, &quot;&quot;);
	Outputs.SetProperty(&quot;LeadMSISDNOrderLstUpdDate&quot;, &quot;&quot;);//MadhuR::20-09-22::Added for PKE92191
	if(sGroupId != &quot;&quot; &amp;&amp; sGroupId != null &amp;&amp; sBillingAcntId != &quot;&quot; &amp;&amp; sBillingAcntId != null  &amp;&amp; sLeadMSISDN != &quot;&quot; &amp;&amp; sLeadMSISDN != null &amp;&amp; sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
	{
		with (sBC)
		{
			ClearToQuery();			
			SetViewMode(AllView);
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;MSISDN&quot;);
			ActivateField(&quot;Sharing Action&quot;);
			ActivateField(&quot;Sharing Group Id&quot;);
			ActivateField(&quot;Order Number&quot;);
			ActivateField(&quot;Order Status&quot;);
			ActivateField(&quot;Order Sub Type&quot;);
			ActivateField(&quot;Action Code&quot;);
			ActivateField(&quot;Custom Asset Integration Id&quot;);		
			//ActivateField(&quot;Updated Non UTC&quot;);	//MadhuR::20-09-22::Added for PKE92191
			ActivateField(&quot;Updated&quot;);		//MadhuR::20-09-22::Added for PKE92191			
			str = &quot;[Order Header Id] &lt;&gt; &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [Sharing Action Calc] = &apos;Remove Member&apos; AND [Billing Account Id] = &apos;&quot; + sBillingAcntId + &quot;&apos; AND [MSISDN] = &apos;&quot; + sLeadMSISDN + &quot;&apos; AND [Sharing Group Id] = &apos;&quot; + sGroupId + &quot;&apos;&quot;;
	        Outputs.SetProperty(&quot;LeadOrderStatus&quot;, &quot;&quot;);
	        Outputs.SetProperty(&quot;LeadOrderNo&quot;, &quot;&quot;);
	        Outputs.SetProperty(&quot;LeadAssetId&quot;, &quot;&quot;);
			SetSearchExpr(str);
			SetSortSpec(&quot;Created (DESC)&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sOrderStatus = GetFieldValue(&quot;Order Status&quot;);
				sOrderNo = GetFieldValue(&quot;Order Number&quot;);
				sAssetId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
				sOrderType = GetFieldValue(&quot;Order Sub Type&quot;);
				sActionCode = GetFieldValue(&quot;Action Code&quot;);	
				//var sLeadOrdLastUpdDate = GetFieldValue(&quot;Updated Non UTC&quot;);	//MadhuR::20-09-22::Added for PKE92191
				var sLeadOrdLastUpdDate = GetFieldValue(&quot;Updated&quot;);	//MadhuR::20-09-22::Added for PKE92191
				if(sOrderType == &quot;Change Proposition&quot; &amp;&amp; sActionCode == &quot;Delete&quot;){
					ClearToQuery();
                    SetViewMode(AllView);
                    str = &quot;[Order Number] = &apos;&quot; + sOrderNo + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [Action Code] = &apos;Add&apos; AND [Sharing Action Calc] = &apos;Remove Member&apos; AND [Billing Account Id] = &apos;&quot; + sBillingAcntId + &quot;&apos; AND [MSISDN] = &apos;&quot; + sLeadMSISDN + &quot;&apos; AND [Sharing Group Id] = &apos;&quot; + sGroupId + &quot;&apos;&quot;;
                    SetSearchExpr(str);
                    ExecuteQuery(ForwardOnly);
                    if (FirstRecord()) {
                  		if(sOrderStatus == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Submitted&quot;)){
							sErrormessage = &quot;VFOrderValidation#00221: An Open Order # &quot; + sOrderNo + &quot; currently exists to remove Lead MSISDN &quot; + sLeadMSISDN + &quot; on this sharing group. Please submit your new order when this Open Order is complete.&quot;;	
						}
						if(sOrderStatus == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Complete&quot;)){
							Outputs.SetProperty(&quot;LeadOrderStatus&quot;,sOrderStatus);
				   			Outputs.SetProperty(&quot;LeadOrderNo&quot;,sOrderNo);
					    	Outputs.SetProperty(&quot;LeadAssetId&quot;, GetFieldValue(&quot;Custom Asset Integration Id&quot;));
							//Outputs.SetProperty(&quot;LeadMSISDNOrderLstUpdDate&quot;, GetFieldValue(&quot;Updated Non UTC&quot;));//MadhuR::20-09-22::Added for PKE92191
							Outputs.SetProperty(&quot;LeadMSISDNOrderLstUpdDate&quot;, GetFieldValue(&quot;Updated&quot;));//MadhuR::20-09-22::Added for PKE92191
						}
                    }
				} else {
				    if(sOrderStatus == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Submitted&quot;)){
						sErrormessage = &quot;VFOrderValidation#00221: An Open Order # &quot; + sOrderNo + &quot; currently exists to remove Lead MSISDN &quot; + sLeadMSISDN + &quot; on this sharing group. Please submit your new order when this Open Order is complete.&quot;;	
					}
					if(sOrderStatus == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Complete&quot;)){
						Outputs.SetProperty(&quot;LeadOrderStatus&quot;,sOrderStatus);
			   			Outputs.SetProperty(&quot;LeadOrderNo&quot;,sOrderNo);
				    	Outputs.SetProperty(&quot;LeadAssetId&quot;, GetFieldValue(&quot;Custom Asset Integration Id&quot;));
						//Outputs.SetProperty(&quot;LeadMSISDNOrderLstUpdDate&quot;, GetFieldValue(&quot;Updated Non UTC&quot;));//MadhuR::20-09-22::Added for PKE92191
						Outputs.SetProperty(&quot;LeadMSISDNOrderLstUpdDate&quot;, GetFieldValue(&quot;Updated&quot;));//MadhuR::20-09-22::Added for PKE92191
					}
				}							
             }
		}		
	}
	Outputs.SetProperty(&quot;ErrorMessage&quot;,sErrormessage);
}
catch(e)
{
 	Outputs.SetProperty(&quot;ErrorMessage&quot;,e);
}
finally
{
	sBC= null;
	sBO = null;
}
}"
			   SEQUENCE="20"
			   UPDATED="06/28/2024 18:49:05"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 18:35:34"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateSharingCompatibility"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnValidateSharingCompatibility(Inputs, Outputs)
{
	try
	{
	
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sSharingCompatibilty,sSearchspec = &quot;&quot;,sSearchspec1 = &quot;&quot;, sErrormessage = &quot;&quot;;
		if (sOrderId != &quot;&quot; || sOrderId != null)
		{
			sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [VF Sharing Order] = &apos;Y&apos;&quot;;
			var sOrderBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
			var sOrderLIBC = sOrderBO.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
			
			//Running the search spec to get theline items with VF Sharing order as Y
			sOrderLIBC.ClearToQuery();
			sOrderLIBC.ActivateField(&quot;Sharing Compatibility&quot;);
			sOrderLIBC.SetSearchExpr(sSearchspec);
			sOrderLIBC.ExecuteQuery(ForwardOnly);
			var isRec = sOrderLIBC.FirstRecord();
				
			if (isRec)	
			{

				var sSharingCompatibilty =  sOrderLIBC.GetFieldValue(&quot;Sharing Compatibility&quot;);
				sSearchspec1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND EXISTS([Sharing Compatibility] &lt;&gt; &apos;&quot; + sSharingCompatibilty + &quot;&apos;) AND [VF Sharing Order] = &apos;Y&apos;&quot;;
				//&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [VF Sharing Order] = &apos;Y&apos; AND EXISTS([Sharing Compatibility] &lt;&gt;&quot;+sSharingCompatibilty+&quot;&apos;)&quot;;
				sOrderLIBC.ClearToQuery();
				sOrderLIBC.SetSearchExpr(sSearchspec1);
				sOrderLIBC.ExecuteQuery(ForwardOnly);
				// if atleast one record is not matching the sharing compatibility throw error
				if (sOrderLIBC.FirstRecord())
				{

						sErrormessage = &quot;VFErrorCode#  96006&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96006&quot;);
						throw(sErrormessage);
				}//if ends here

			}//if for one root proposition record found in line item
		}//if check for order id not null ends here
	}//try ends
	
	catch(e)
	{
		Outputs.SetProperty(&quot;sErrormessage&quot;,e);
	}
	finally
	{
		sOrderLIBC = null;
		sOrderBO = null;
	}
}"
			   SEQUENCE="21"
			   UPDATED="06/28/2024 18:49:19"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateSharingDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnValidateSharingDetails(Inputs, Outputs)
{
 try
 {
    //Chitra Added for Sharing Simplification
    var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sBillingAcntId = Inputs.GetProperty(&quot;BillingAcntId&quot;);
	var sPreAssetCount = ToNumber(Inputs.GetProperty(&quot;NoOfExistingServices&quot;));
	var psInputs = TheApplication().NewPropertySet();
	var psOutputs = TheApplication().NewPropertySet();
	var sOutputs = TheApplication().NewPropertySet();
	var Input = TheApplication().NewPropertySet();
	var Output = TheApplication().NewPropertySet();
	var sErrormessage = &quot;&quot;;
	var sVoiceAvail =&quot;N&quot;, sFBBAddMember=&quot;N&quot;;	// VHA Suresh: Added for R17.3 Sharing: PIPE
	//Set Sharing Rules
	psInputs.SetProperty(&quot;OrderId&quot;,sOrderId);
	fnDecideSharingAction(psInputs,psOutputs);
	
	//GetDetails from asset
	psOutputs.SetProperty(&quot;sBillingAcntId&quot;,sBillingAcntId);
	fnCheckExistingAsset(psOutputs,sOutputs);
	
	var sAddMember = psOutputs.GetProperty(&quot;sAddMember&quot;);
	var sAddMemberCount = psOutputs.GetProperty(&quot;sAddMemberCount&quot;);
	var sAddRemoveMember = psOutputs.GetProperty(&quot;sAddRemoveMember&quot;);
	var sRemoveMember = psOutputs.GetProperty(&quot;sRemoveMember&quot;);
	var sAddRemoveExistingMember = psOutputs.GetProperty(&quot;sAddRemoveExistingMember&quot;);
	var sAddExistingMember = psOutputs.GetProperty(&quot;sAddExistingMember&quot;);
	var sAddSharingCompat = psOutputs.GetProperty(&quot;sAddSharingCompat&quot;);
	var sAssetSharingComp = sOutputs.GetProperty(&quot;sAssetSharingComp&quot;);TheApplication().SetProfileAttr(&quot;sAssetSharingComp&quot;,sAssetSharingComp);
	var sSelectAssetCount = sOutputs.GetProperty(&quot;sSelectAssetCount&quot;);TheApplication().SetProfileAttr(&quot;sSelectAssetCount&quot;,sSelectAssetCount);
	var sSharingCount = sOutputs.GetProperty(&quot;sSharingCount&quot;);TheApplication().SetProfileAttr(&quot;sSharingCount&quot;,sSharingCount);
	var sSharingName = sOutputs.GetProperty(&quot;sSharingName&quot;);TheApplication().SetProfileAttr(&quot;sSharingName&quot;,sSharingName);
	var sGroupId = sOutputs.GetProperty(&quot;sSharingGroupId&quot;);TheApplication().SetProfileAttr(&quot;sSharingGroupId&quot;,sSharingGroupId);
	var sSharingEnable = psOutputs.GetProperty(&quot;sSharingEnable&quot;);TheApplication().SetProfileAttr(&quot;sSharingEnable&quot;,sSharingEnable);
	var sLeadmem = psOutputs.GetProperty(&quot;sLeadmem&quot;);
	TheApplication().SetProfileAttr(&quot;sLeadmem&quot;,sLeadmem);
	var sSharingLeadId = sOutputs.GetProperty(&quot;sSharingLeadId&quot;);
	TheApplication().SetProfileAttr(&quot;sSharingLeadId&quot;,sSharingLeadId);
	var sLeadError =  psOutputs.GetProperty(&quot;sError&quot;); //Karthika - 12/06/2017 -Added as part of Retrofit
	
	sVoiceAvail = psOutputs.GetProperty(&quot;VoiceNotRemoveMemExist&quot;);	// VHA Suresh: Added for R17.3 Sharing: PIPE
	sFBBAddMember =	psOutputs.GetProperty(&quot;FBBPropAddmemExist&quot;);
	if(sFBBAddMember == &quot;Y&quot; &amp;&amp; sVoiceAvail != &quot;Y&quot;)	
		sVoiceAvail = sOutputs.GetProperty(&quot;VoiceServiceExist&quot;);
	var sLOVCount = ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SHARING_COUNT&quot;,&quot;Sharing&quot;));
	
	
	if (sAddMember == &quot;Y&quot;)
	{
		//Open Order Check
		/*Input.SetProperty(&quot;Asset Integration Id&quot;,sSharingLeadId);
		mCheckOpenOrder(Input, Output);
		sErrormessage = Output.GetProperty(&quot;sErrormessage&quot;);
		if(sErrormessage != &quot;&quot;)
		{
			throw(sErrormessage);
		}*/
		//Karthika - 12/06/2017 -Added as part of Retrofit
		if(sLeadError != &quot;&quot;)
		{
			sErrormessage = sLeadError;
			throw(sErrormessage);
		}	
		if(sSelectAssetCount == 0 &amp;&amp; sAddMemberCount == 1)
		{
			//SSO Add Member Existing Asset mandatory
			sErrormessage = &quot;VFErrorCode#  96013&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96013&quot;);
			throw(sErrormessage);
		}
		if(sAssetSharingComp != sAddSharingCompat &amp;&amp; sSelectAssetCount &gt;= 1)
		{
			//Asset order Compatibility Check
			sErrormessage = &quot;VFErrorCode#  96006&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96007&quot;);	
			throw(sErrormessage);
		}
		if (sAddMemberCount == 1 &amp;&amp; sPreAssetCount == 0)
		{
			//New Connect - Single service from sharing page
			sErrormessage = &quot;VFErrorCode#  96013&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96015&quot;);	
			throw(sErrormessage);	
		}
		if(sSharingCount &gt; sLOVCount)
		{
			//Group Count Check
			sErrormessage = &quot;VFErrorCode#  96002&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96002&quot;);	
			throw(sErrormessage);
		}
		
	}
	else if(sAddRemoveMember == &quot;Y&quot; &amp;&amp; sPreAssetCount == 0)
	{
			sErrormessage = &quot;VFErrorCode#  96013&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96013&quot;);	
			throw(sErrormessage);
	}
		// VHA Suresh: Added for R17.3 Sharing: PIPE
	if(sFBBAddMember == &quot;Y&quot; &amp;&amp; sVoiceAvail != &quot;Y&quot;)
	{
		if(sGroupId == &quot;&quot; || sGroupId == null || fnCheckNonFBBFrmGroup(sGroupId) != &quot;Y&quot;)
		{
		sErrormessage = &quot;Atleast one Consumer Service is mandatory to form a Sharing Group. Please choose atleast one Consumer Service/ un-select the sharing formation&quot;;
		throw(sErrormessage);	
		}
	}
	
		//Group TBC Validations
		if(sSharingEnable == &quot;Y&quot;)
		{
			
			var BO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
			var ActiveBO = TheApplication().ActiveBusObject();
			var oGroupTBC = ActiveBO.GetBusComp(&quot;VHA Sharing Group TBC&quot;);
			var oGroupBC = BO.GetBusComp(&quot;VHA Sharing Group&quot;);
			
			var sGroupName = oGroupTBC.GetFieldValue(&quot;Sharing Group Name&quot;);
			TheApplication().SetProfileAttr(&quot;sGroupName&quot;,sGroupName);
			var sGroupSelect = oGroupTBC.GetFieldValue(&quot;Sharing Selection&quot;);
			var sGroupReadOnly = oGroupTBC.GetFieldValue(&quot;Select Flag&quot;);
			var sharLeadIntId = oGroupTBC.GetFieldValue(&quot;Sharing Lead Integ Id&quot;);
			TheApplication().SetProfileAttr(&quot;sharLeadIntId&quot;,sharLeadIntId);
			var sharLeadMSISDN = oGroupTBC.GetFieldValue(&quot;Sharing Lead MSISDN&quot;);
			TheApplication().SetProfileAttr(&quot;sharLeadMSISDN&quot;,sharLeadMSISDN);
						
			//Added for R16.4 Sharing Simplification Defect# 907
			if((sAddRemoveMember == &quot;Y&quot; || sAddRemoveExistingMember == &quot;Y&quot; || sAddExistingMember == &quot;Y&quot;) &amp;&amp; sPreAssetCount &gt;= 1 &amp;&amp; sGroupReadOnly != &quot;Y&quot;)
			{
				sErrormessage = &quot;VFErrorCode#  96019 &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96019&quot;);
				throw(sErrormessage);
			}//end of code
			
			if(sGroupName == &quot;&quot;)
			{
				sErrormessage = &quot;VFErrorCode#  96004&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96004&quot;);
				throw(sErrormessage);	
			}
			else if (sGroupSelect != &quot;Y&quot;)
			{
				sErrormessage = &quot;VFErrorCode#  96014&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96014&quot;);
				throw(sErrormessage);
			}
			
			else if (sGroupId == &quot;&quot; || (sGroupId != &quot;&quot; &amp;&amp; sGroupName != sSharingName))
			{
					TheApplication().SetProfileAttr(&quot;VFErrorCode#  96003&quot;,sGroupId);
					oGroupBC.SetViewMode(AllView);
					oGroupBC.ActivateField(&quot;Billing Account Id&quot;);
					oGroupBC.ActivateField(&quot;Shraing Group Name&quot;);
					oGroupBC.ClearToQuery();
					oGroupBC.SetSearchSpec(&quot;Billing Account Id&quot;,sBillingAcntId);
					oGroupBC.SetSearchSpec(&quot;Shraing Group Name&quot;,sGroupName);
					oGroupBC.SetSearchSpec(&quot;Sharing Status&quot;, &quot;Active&quot;);//Added by Kailash for PKE45037
					oGroupBC.ExecuteQuery(ForwardOnly);
					if(oGroupBC.FirstRecord())
					{
						sErrormessage = &quot;VFErrorCode#  96003&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96003&quot;);
						throw(sErrormessage);
					}
					else
					{
						oGroupTBC.WriteRecord();
					}
			}
		}
   fnUpdateLineitems(sOrderId,sGroupId,sGroupName,sharLeadIntId,sharLeadMSISDN);		
}
catch(e)
{
 Outputs.SetProperty(&quot;sErrormessage&quot;,sErrormessage);
}
finally
{
	oGroupTBC = null;
	oGroupBC = null;
	ActiveBO = null;
	BO = null;
}
	
}"
			   SEQUENCE="22"
			   UPDATED="04/18/2026 22:07:03"
			   UPDATED_BY="ADITIK"
			   CREATED="08/17/2016 09:04:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateSharingDetails_old"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnValidateSharingDetails_old(Inputs, Outputs)
{
try
{
	//Chitra Added for Sharing Simplification - 29/05/2016
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sBillingAcntId = Inputs.GetProperty(&quot;BillingAcntId&quot;);
	var sAssetCount = ToNumber(Inputs.GetProperty(&quot;NoOfExistingServices&quot;));
	var NoOfNewServices = ToNumber(Inputs.GetProperty(&quot;NoOfNewServices&quot;));
	var sErrormessage = &quot;&quot;,sNoAsset=&quot;&quot;;
	var sGroupId = &quot;&quot;,sGroupCount,sGroupStatus;
	var sOLICount = 0,sLOVCount;
	var sSharingCompatibilty,sSearchspec,sLeadMSISDN,sNewLeadMSISDN,sPrimaryIntId,sExistGroupName;

	sLOVCount = ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SHARING_COUNT&quot;,&quot;Sharing&quot;));

	var BO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	var oActiveBO = TheApplication().ActiveBusObject();
	
	var oOLIBC = BO.GetBusComp(&quot;VHA Order Entry - Line Items&quot;);
	var oAssetBC = BO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
	var oGroupTBC = oActiveBO.GetBusComp(&quot;VHA Sharing Group TBC&quot;);
	var oGroupBC = BO.GetBusComp(&quot;VHA Sharing Group&quot;);
	
	if (sAssetCount &gt; 0)
	{
			with (oAssetBC)
			{
				SetViewMode(AllView);
				ActivateField(&quot;VF Share Flag&quot;);
				ActivateField(&quot;MSISDN&quot;);
				ActivateField(&quot;Integration Id&quot;);
				ActivateField(&quot;Sharing Group Count&quot;);
				ActivateField(&quot;Sharing Group Id&quot;);
				ActivateField(&quot;Sharing Lead Id&quot;);
				ActivateField(&quot;Sharing Group Status&quot;);
				ActivateField(&quot;Sharing Group Name&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;Billing Account Id&quot;, sBillingAcntId);
				SetSearchSpec(&quot;Sharing Select&quot;, &quot;Y&quot;);
				ExecuteQuery(ForwardOnly);
				if(!FirstRecord())
				{
					sErrormessage = &quot;VFErrorCode#  96013&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96013&quot;);
					
				}
				else
				{
					sSharingCompatibilty = GetFieldValue(&quot;VF Share Flag&quot;);
					sGroupCount = ToNumber(GetFieldValue(&quot;Sharing Group Count&quot;));
					sGroupId = GetFieldValue(&quot;Sharing Group Id&quot;);
					sExistGroupName = GetFieldValue(&quot;Sharing Group Name&quot;);
					
					sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND EXISTS([Sharing Compatibility] &lt;&gt; &apos;&quot; + sSharingCompatibilty + &quot;&apos;) AND [VF Sharing Order] = &apos;Y&apos;&quot;;
					with (oOLIBC)
					{
				
							SetViewMode(AllView);
							ClearToQuery();
							SetSearchExpr(sSearchspec);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{
								sErrormessage = &quot;VFErrorCode#  96007&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96007&quot;);	
								throw(sErrormessage);
							}
							else
							{
								var sSearchspex = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [VF Sharing Order] = &apos;Y&apos;&quot;;
								SetViewMode(AllView);
								ActivateField(&quot;Sharing Action&quot;)
								ClearToQuery();
								SetSearchExpr(sSearchspex);
								ExecuteQuery(ForwardOnly);
								sOLICount = CountRecords();
								sGroupCount = sGroupCount + sOLICount;
								if(sGroupCount == 1 &amp;&amp; GetFieldValue(&quot;Sharing Action&quot;) == &quot;Add Memeber&quot;)
								{
									throw(sErrormessage);
								}
								else if(sGroupCount &gt; sLOVCount)
								{
									sErrormessage = &quot;VFErrorCode#  96002&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96002&quot;);	
									throw(sErrormessage);
								}
							}
						
					}
				}
				
		}
	}
	else
	{
		sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL  AND [VF Sharing Order] = &apos;Y&apos;&quot;;
		with (oOLIBC)
		{
			
					SetViewMode(AllView);
					ActivateField(&quot;MSISDN TBUI&quot;);
					ActivateField(&quot;Asset Integration Id&quot;);
					ActivateField(&quot;Sharing Group Id&quot;);
					ActivateField(&quot;Sharing Lead Integ Id&quot;);
					ActivateField(&quot;Sharing Group Status&quot;);
					ActivateField(&quot;Sharing Compatibility&quot;);
					ClearToQuery();
					SetSearchExpr(sSearchspec);
					ExecuteQuery(ForwardOnly);
					sOLICount = CountRecords();
					if(FirstRecord())
					{
						sGroupId = GetFieldValue(&quot;Sharing Group Id&quot;);
						sSharingCompatibilty = GetFieldValue(&quot;Sharing Compatibility&quot;);
						if(sOLICount == 1)
						{
							sErrormessage = &quot;VFErrorCode#  96015&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96015&quot;);	
							throw(sErrormessage);
						}
						if(sOLICount &gt; sLOVCount)
							{
								sErrormessage = &quot;VFErrorCode#  96002&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96002&quot;);
								throw(sErrormessage);	
							}	
					}
		}
	}
	
			
			var sGroupName = oGroupTBC.GetFieldValue(&quot;Sharing Group Name&quot;);
			sGroupName = sGroupName.toUpperCase();
			sExistGroupName = sExistGroupName.toUpperCase();
			var sGroupSelect = oGroupTBC.GetFieldValue(&quot;Sharing Selection&quot;);
			if(sGroupName == &quot;&quot;)
			{
				sErrormessage = &quot;VFErrorCode#  96004&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96004&quot;);
				throw(sErrormessage);	
			}
			else if (sGroupSelect == &quot;&quot;)
			{
				sErrormessage = &quot;VFErrorCode#  96014&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96014&quot;);
				throw(sErrormessage);
			}
			
			else if (sGroupId == &quot;&quot; || (sGroupId != &quot;&quot; &amp;&amp; sGroupName != sExistGroupName))
			{
					oGroupBC.SetViewMode(AllView);
					oGroupBC.ActivateField(&quot;Billing Account Id&quot;);
					oGroupBC.ActivateField(&quot;Shraing Group Name&quot;);
					oGroupBC.ClearToQuery();
					oGroupBC.SetSearchSpec(&quot;Billing Account Id&quot;,sBillingAcntId);
					oGroupBC.SetSearchSpec(&quot;Shraing Group Name&quot;,sGroupName);
					oGroupBC.ExecuteQuery(ForwardOnly);
					if(oGroupBC.FirstRecord())
					{
						sErrormessage = &quot;VFErrorCode#  96003&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96003&quot;);
						throw(sErrormessage);
					}
					else
					{
						oGroupTBC.WriteRecord();
					}
			}
			fnUpdateLineitems(sOrderId,sGroupId,sGroupName);		
}
catch(e)
{
	Outputs.SetProperty(&quot;sErrormessage&quot;,sErrormessage);					
}
finally
{
	oGroupBC = null;
	oGroupTBC = null;
	oAssetBC = null;
	oOLIBC = null;
	oActiveBO = null;
	BO = null;
}
}"
