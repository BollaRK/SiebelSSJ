			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetRootlineItemId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetRootlineItemId(Inputs, Outputs)
{
	try
	{
		   // balajiM added for getting rootlineitem id - 1/10/2019
			var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var OrderLineBC = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
            var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
            
            if(strOrderId != &quot;&quot;)
            {
			with(OrderLineBC)
			{
			        ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Order Header Id&quot;);
					ActivateField(&quot;Parent Order Item Id&quot;);
					SetSearchSpec(&quot;Order Header Id&quot;, strOrderId);
					SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
					  var sRootLineId = GetFieldValue(&quot;Id&quot;);
					}
			}
			}
			
			Outputs.SetProperty(&quot;RootLineItemId&quot;, sRootLineId);
			return(CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		OrderLineBC = null;
		boOrder = null;
	}
}"
