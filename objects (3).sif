			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateNBNDisconnect"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateNBNDisconnect(Inputs, Outputs)
{
	var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
	var sNBNMSISDN = &quot;&quot;,sNBNDisConOrderId=&quot;&quot;, sFutureDate=&quot;&quot;;
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
	var psIn,psOut, oBS;
	oBS=TheApplication().GetService(&quot;VF OM Invoke Order Workflows&quot;);
	
	var oBC = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;VHA NBN to 5G Migration&quot;);
	with (oBC)
	{
		ClearToQuery();
		ActivateField(&quot;Account Id&quot;);
		ActivateField(&quot;Connect Order Id&quot;);
		ActivateField(&quot;NBN MSISDN&quot;);
		ActivateField(&quot;Disconnect Order Id&quot;);
		ActivateField(&quot;Fulfilment Order Id&quot;);
		ActivateField(&quot;NBN Disconnection Date&quot;);
		SetSearchSpec(&quot;Account Id&quot;, sAccountId);
		if(sOrderType==&quot;Fulfilment&quot;)
			SetSearchSpec(&quot;Fulfilment Order Id&quot;, sOrderId);
		else
			SetSearchSpec(&quot;Connect Order Id&quot;, sOrderId);
		ExecuteQuery();
		if(FirstRecord())
		{
			sFutureDate=GetFieldValue(&quot;NBN Disconnection Date&quot;);
			if(GetFieldValue(&quot;Disconnect Order Id&quot;)==&quot;&quot;)
			{
				try
				{
					sNBNMSISDN = GetFieldValue(&quot;NBN MSISDN&quot;);
					psIn= TheApplication().NewPropertySet();
					psOut= TheApplication().NewPropertySet();
					psIn.SetProperty(&quot;MSISDN&quot;, sNBNMSISDN);
					psIn.SetProperty(&quot;FutureSubmitDate&quot;, sFutureDate);
					psIn.SetProperty(&quot;SubmitFlag&quot;,&quot;N&quot;);
					//psIn.SetProperty(&quot;NBNDisconnectFlag&quot;,&quot;Y&quot;);
					psIn.SetProperty(&quot;DisplayReasonCode&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_REASON_CODE&quot;, &quot;Transfer - NBN To 5GFWA&quot;));
					oBS.InvokeMethod(&quot;CreateDisconnectOrder&quot;,psIn,psOut);
					sNBNDisConOrderId = psOut.GetProperty(&quot;OrderId&quot;);
					SetFieldValue(&quot;Disconnect Order Id&quot;,sNBNDisConOrderId);
					WriteRecord();
					var svc = TheApplication().GetService(&quot;Server Requests&quot;);
					psIn.Reset();
					var child = TheApplication().NewPropertySet();
					psOut.Reset();
					psIn.SetProperty(&quot;Mode&quot;, &quot;DirectDb&quot;);
					psIn.SetProperty(&quot;NumRetries&quot;, &quot;0&quot;);
					psIn.SetProperty(&quot;Component&quot;, &quot;WfProcMgr&quot;);
					psIn.SetProperty(&quot;Method&quot;, &quot;RunProcess&quot;);
					child.SetProperty(&quot;Object Id&quot;, sNBNDisConOrderId);
					child.SetProperty(&quot;Skip SMS&quot;, &quot;Y&quot;);
					child.SetProperty(&quot;ProcessName&quot;, &quot;VHA OM Submit Order Framework&quot;);
					psIn.AddChild(child);
					
					svc.InvokeMethod(&quot;SubmitRequest&quot;, psIn, psOut);
				}
				catch(e)	
				{
					sNBNDisConOrderId = psOut.GetProperty(&quot;OrderId&quot;);
					SetFieldValue(&quot;Disconnect Order Id&quot;,sNBNDisConOrderId);
					WriteRecord();
					
				}
			}
		}
	}
}"
