			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateSharingEntry"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateSharingEntry(Inputs, Outputs)
{
	try
	{
	 
	 
	 var strOrderId = Inputs.GetProperty(&quot;OrderIdCurrent&quot;);
	 var psInput1 = TheApplication().NewPropertySet();
	 var psOutput1 = TheApplication().NewPropertySet();
	 var bsWfProcMgr1;
	 
	 var strSwitch1 = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;SharingProgChkFlg&quot;);
	  
	  if(strOrderId != &quot;&quot; &amp;&amp; strOrderId != null)
	  {
			bsWfProcMgr1 = TheApplication().GetService(&quot;VF OM Order Pre Validation BS&quot;);
			psInput1.SetProperty(&quot;OrderId&quot;, strOrderId);
			bsWfProcMgr1.InvokeMethod(&quot;CancelOrder&quot;, psInput1, psOutput1);

	  }
		
	}
	catch(e)
	{
	 throw (e);
	}
	finally
	{
		strOrderId = null;
		psInput1 = null;
		psOutput1 = null;
		bsWfProcMgr1 = null;
	}
}	"
