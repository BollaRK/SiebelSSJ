			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckValidSharingOrderRCR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckValidSharingOrderRCR(Inputs, Outputs)
{
	

	
	var sSearchExpr;
	var strAssetIntId,strGroupId,strOrderId,strOrderDate,strSharingCompatibility,strOrderType;
	var strOrderExist = &quot;N&quot;;
	var isRecord;
	
	try
	{		
		// Get the integration id
		strAssetIntId = Inputs.GetProperty(&quot;AssetIntegId&quot;);
		strGroupId = Inputs.GetProperty(&quot;SharingGroupId&quot;);
		strOrderId = Inputs.GetProperty(&quot;Object Id&quot;);
		strOrderDate = Inputs.GetProperty(&quot;OrderDate&quot;);
		strSharingCompatibility = Inputs.GetProperty(&quot;SharingCompatibility&quot;);
		strOrderType = Inputs.GetProperty(&quot;OrderType&quot;);

		var dt = new Date(Inputs.GetProperty(&quot;OrderDate&quot;));

	var sOrdDate = (dt.getMonth() + 1) + &quot;/&quot; + (dt.getDate()) + &quot;/&quot; + dt.getFullYear();

	var timeForm = sOrdDate + &quot; &quot; + dt.getHours() + &quot;:&quot; + dt.getMinutes() + &quot;:&quot; + dt.getSeconds();

		

		sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +strAssetIntId+ &quot;&apos; AND [Status] = &apos;Complete&apos; AND [Order Header Id] &lt;&gt; &apos;&quot; +strOrderId+ &quot;&apos; AND [Order Date] &gt;=&apos;&quot;+timeForm+&quot;&apos;&quot; ;
		
		Outputs.SetProperty(&quot;Test&quot;,timeForm);
		// Setup business object and component
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcLineItem = boOrder.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		
		bcLineItem.ClearToQuery();
		//bcOrderLineItemAsset.ActivateField(&quot;Asset Integration Id&quot;);
		bcLineItem.ActivateField(&quot;Order Header Id&quot;);
		bcLineItem.SetSearchExpr(sSearchExpr);	

		bcLineItem.ExecuteQuery(ForwardOnly);
		
		// If a record is found, set the Order Exists Flag to true
		isRecord=bcLineItem.FirstRecord();
		while (isRecord)
		{

			var sOrderId=bcLineItem.GetFieldValue(&quot;Order Header Id&quot;);
			var sBO = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
			var sBC = sBO.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
			var sSharingSearchExpr= &quot;[Order Header Id]=&apos;&quot; +sOrderId+ &quot;&apos; AND [Sharing Action] &lt;&gt; &apos;Remove Member&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos; AND [Sharing Group Id] = &apos;&quot; +strGroupId+ &quot;&apos; AND [Asset Integration Id]=&apos;&quot; +strAssetIntId+&quot;&apos; AND [Sharing Group Compatibility] =&apos;&quot; +strSharingCompatibility+&quot;&apos;&quot;;
			
			sBC.ClearToQuery();
		
			sBC.SetSearchExpr(sSharingSearchExpr);	
			sBC.ExecuteQuery(ForwardOnly);
			if(sBC.FirstRecord())
			{
			strOrderExist = &quot;Y&quot;;
			break;
			}
			isRecord=NextRecord();
		}
		
	
		
		
		Outputs.SetProperty(&quot;OrderExist&quot;, strOrderExist);
	}
	catch(e)
	{
		
		throw (e);
	}
	finally
	{
		sBO = null;
		sBC = null;
		boOrder=null;
		bcLineItem=null;
		
				
	}
}"
			   SEQUENCE="30"
