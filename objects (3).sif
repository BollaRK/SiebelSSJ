			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="DeleteFulfilmentOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function DeleteFulfilmentOrder(Inputs, Outputs)
{
	try
	{
		var sFulOrderId = Inputs.GetProperty(&quot;FulfilmentOrderId&quot;);
		var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		with (sOrderBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sFulOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				DeleteRecord();
			}
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sOrderBC = null;
		sOrderBO = null;
	}
}"
