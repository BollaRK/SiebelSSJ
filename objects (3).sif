			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnDecideSharingAction"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnDecideSharingAction(psInputs,psOutputs)
{
try
{
	 var sOrderId = psInputs.GetProperty(&quot;OrderId&quot;);
	 var sAddFlg = &quot;N&quot;;
	 var sRemoveFlg = &quot;N&quot;;
	 var sExistingFlg = &quot;N&quot;;
	 var sAddMember = &quot;N&quot;
	 var sRemoveMember = &quot;N&quot;
	 var sExistingMember = &quot;N&quot;
	 var sAddRemoveMember = &quot;N&quot;;
	 var sAddExistingMember = &quot;N&quot;;
	 var sRemoveExistingMember = &quot;N&quot;;
	 var sAddRemoveExistingMember = &quot;N&quot;;
	 var sAddMemberCount = 0;
	 var sRemoveMemberCount = 0;
	 var sAddSharingCompat = &quot;&quot;;
	 var sSharingEnable = &quot;N&quot;;
	 var sLeadmem = &quot;N&quot;;
	 var sAccntproposition = &quot;N&quot;;
	 var sOrderType = &quot;&quot;;
	 var sSharingComp = new Array;
	 var sIsDiffSharingGroup = &quot;N&quot;, i=0;
	 var sVoiceExists = &quot;N&quot;,sVoiceNotRemMem = &quot;N&quot;, sFBBAddMem=&quot;N&quot;, sVoiceInstockExists = &quot;N&quot;; // VHA Suresh: Added for R17.3 Sharing: PIPE
	 var sError=&quot;&quot;; //Karthika - 12/06/2017 - Added as part of Retrofit
	 var sInputs = TheApplication().NewPropertySet(); //Karthika - 12/06/2017 - Added as part of Retrofit
	 var sOutputs = TheApplication().NewPropertySet(); //Karthika - 12/06/2017 - Added as part of Retrofit
	 var sSharingBO = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
	 var sSharingBC = sSharingBO.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
	 with(sSharingBC)
	 {
				   sSharingBC.SetViewMode(AllView);
				   sSharingBC.ActivateField(&quot;Order Header Id&quot;);
				   sSharingBC.ActivateField(&quot;Parent Order Item Id&quot;);
				   sSharingBC.ActivateField(&quot;Sharing Action Calc&quot;);
				   sSharingBC.ActivateField(&quot;Sharing Group Id&quot;);
				   sSharingBC.ActivateField(&quot;Sharing Compatibility&quot;);
				   sSharingBC.ActivateField(&quot;Is Lead&quot;);
				   sSharingBC.ActivateField(&quot;Billing Account Id&quot;);
				   sSharingBC.ActivateField(&quot;Product Type&quot;);
				   sSharingBC.ActivateField(&quot;VF Service Order Sub Type&quot;);
				   sSharingBC.ActivateField(&quot;Sharing Group Compatibility&quot;);
				   sSharingBC.ActivateField(&quot;VF Siebel Product Type&quot;); // VHA Suresh: Added for R17.3 Sharing: PIPE
   				   sSharingBC.ActivateField(&quot;VF OutofStock Flg TBUI&quot;);
   				   sSharingBC.ActivateField(&quot;MSISDN Calc&quot;); //Karthika - 12/06/2017 - Added as part of Retrofit
				   sSharingBC.ClearToQuery();
				   var sSearchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
				   sSharingBC.SetSearchExpr(sSearchst);
				   sSharingBC.ExecuteQuery(ForwardOnly);
				   var isRec = sSharingBC.FirstRecord();
				   var sCount = sSharingBC.CountRecords();
				   while(isRec)
				   {
								  sOrderType = sSharingBC.GetFieldValue(&quot;VF Service Order Sub Type&quot;);
								  var sSharingAction = sSharingBC.GetFieldValue(&quot;Sharing Action Calc&quot;);
								  TheApplication().SetProfileAttr(&quot;sSharingAction&quot;,sSharingAction);//VHA KT 18032026 Start: Added Profile attributes for debugging SSJ Sharing flow, to be later removed
								  var sBillAcntId = sSharingBC.GetFieldValue(&quot;Billing Account Id&quot;);
								  var isLead = sSharingBC.GetFieldValue(&quot;Is Lead&quot;);
								  var sProdType = sSharingBC.GetFieldValue(&quot;Product Type&quot;);
								  var sMSISDN = sSharingBC.GetFieldValue(&quot;MSISDN Calc&quot;); //Karthika - 12/06/2017 - Added as part of Retrofit
								  
								  if(sSharingAction == &quot;Add Member&quot; || sSharingAction == &quot;Remove Member&quot; || sSharingAction == &quot;Existing Member&quot;)
								  {
								  		if(sSharingAction == &quot;Remove Member&quot;)
								  		  sSharingComp[i] = sSharingBC.GetFieldValue(&quot;Sharing Group Compatibility&quot;);
								  		else
										  sSharingComp[i] = sSharingBC.GetFieldValue(&quot;Sharing Compatibility&quot;);
									  i++;
								  }
								  
								  if(sProdType == &quot;Account Proposition&quot;)
								  {
									sAccntproposition = &quot;Y&quot;;
								  }
								  if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VF Siebel Product Type&quot;)) == &quot;&quot;)	// VHA Suresh: Added for R17.3 Sharing: PIPE
								  {
									  sVoiceExists = &quot;Y&quot;;
									// if(sSharingAction != &quot;Remove Member&quot;)
										if(sSharingAction == &quot;Add Member&quot; || sSharingAction == &quot;Existing Member&quot;)
										{
										sVoiceNotRemMem = &quot;Y&quot;;
										if(sSharingBC.GetFieldValue(&quot;VF OutofStock Flg TBUI&quot;) != &quot;Y&quot;)	
									 	sVoiceInstockExists = &quot;Y&quot;;
										}									
										  
								  }
								  if(sSharingAction == &quot;Add Member&quot;)
								  {
												sAddFlg = &quot;Y&quot;;
												sAddMemberCount = sAddMemberCount + 1;
												sAddSharingCompat = sSharingBC.GetFieldValue(&quot;Sharing Compatibility&quot;);
												sSharingEnable = &quot;Y&quot;;
												//Karthika - 12/06/2017 - Added as part of Retrofit
												sInputs.SetProperty(&quot;sBillAcntId&quot;,sBillAcntId);
												sInputs.SetProperty(&quot;sMSISDN&quot;,sMSISDN);
												mValidateNewGroupLeadMSISDN(sInputs,sOutputs);
												if(sOutputs.GetProperty(&quot;sErr&quot;) != &quot;&quot;)
												{
													sError = sOutputs.GetProperty(&quot;sErr&quot;);
												}
											//	if(GetFieldValue(&quot;VF Siebel Product Type&quot;) != &quot;Voice&quot;)	// VHA Suresh: Added for R17.3 Sharing: PIPE
												if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VF Siebel Product Type&quot;)) != &quot;&quot;)
													sFBBAddMem = &quot;Y&quot;;
								 }             
								  else if (sSharingAction == &quot;Remove Member&quot;)
								  {
												if(isLead == &quot;Y&quot;)
												{
													sLeadmem == &quot;Y&quot;;
												}
												sRemoveFlg = &quot;Y&quot;;
												sRemoveMemberCount = sRemoveMemberCount + 1;
												sSharingEnable = &quot;Y&quot;;
								  }
								  else if (sSharingAction == &quot;Existing Member&quot;)
								  {
												sExistingFlg = &quot;Y&quot;;
												sSharingEnable = &quot;Y&quot;;
												if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VF Siebel Product Type&quot;)) != &quot;&quot;)
													sFBBAddMem = &quot;Y&quot;;
								  }
								  isRec =  sSharingBC.NextRecord();
				   }//while

				   if(sAddFlg == &quot;Y&quot; &amp;&amp; sRemoveFlg == &quot;N&quot; &amp;&amp; sExistingFlg == &quot;N&quot;)
				   {
								  sAddMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;N&quot; &amp;&amp; sRemoveFlg == &quot;Y&quot; &amp;&amp; sExistingFlg == &quot;N&quot;)
				   {
								  sRemoveMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;N&quot; &amp;&amp; sRemoveFlg == &quot;N&quot; &amp;&amp; sExistingFlg == &quot;Y&quot;)
				   {
								  sExistingMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;Y&quot; &amp;&amp; sRemoveFlg == &quot;Y&quot; &amp;&amp; sExistingFlg == &quot;N&quot;)
				   {
								  sAddRemoveMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;Y&quot; &amp;&amp; sRemoveFlg == &quot;N&quot; &amp;&amp; sExistingFlg == &quot;Y&quot;)
				   {
								  sAddExistingMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;N&quot; &amp;&amp; sRemoveFlg == &quot;Y&quot; &amp;&amp; sExistingFlg == &quot;Y&quot;)
				   {
								  sRemoveExistingMember = &quot;Y&quot;;
				   }
				   if(sAddFlg == &quot;Y&quot; &amp;&amp; sRemoveFlg == &quot;Y&quot; &amp;&amp; sExistingFlg == &quot;Y&quot;)
				   {
								  sAddRemoveExistingMember = &quot;Y&quot;;
				   }
				   
				   if(sAddFlg == &quot;Y&quot;)
				   {
					   for(var j=0; j&lt;i;j++)
					   {
						   if(sAddSharingCompat != sSharingComp[j])
						   {
							sIsDiffSharingGroup = &apos;Y&apos;;   
							break;
						   }
					   }
				   }
				   
				   
	 }//with sharingbc 
	psOutputs.SetProperty(&quot;sAccntproposition&quot;,sAccntproposition);
	psOutputs.SetProperty(&quot;sAddMember&quot;,sAddMember);
	psOutputs.SetProperty(&quot;sSharingEnable&quot;,sSharingEnable);
	psOutputs.SetProperty(&quot;sRemoveMember&quot;,sRemoveMember);
	psOutputs.SetProperty(&quot;sExistingMember&quot;,sExistingMember);
	psOutputs.SetProperty(&quot;sAddRemoveMember&quot;,sAddRemoveMember);
	psOutputs.SetProperty(&quot;sAddExistingMember&quot;,sAddExistingMember);
	psOutputs.SetProperty(&quot;sRemoveExistingMember&quot;,sRemoveExistingMember);
	psOutputs.SetProperty(&quot;sAddRemoveExistingMember&quot;,sAddRemoveExistingMember);
	psOutputs.SetProperty(&quot;sAddMemberCount&quot;,sAddMemberCount);
	psOutputs.SetProperty(&quot;sRemoveMemberCount&quot;,sRemoveMemberCount);
	psOutputs.SetProperty(&quot;sAddSharingCompat&quot;,sAddSharingCompat);
	psOutputs.SetProperty(&quot;sLeadmem&quot;,sLeadmem);
	psOutputs.SetProperty(&quot;sRemoveFlg&quot;,sRemoveFlg);
	psOutputs.SetProperty(&quot;sExistingFlg&quot;,sExistingFlg);	
	psOutputs.SetProperty(&quot;sBillAcntId&quot;,sBillAcntId);
	psOutputs.SetProperty(&quot;sOrderType&quot;,sOrderType);	
	psOutputs.SetProperty(&quot;IsDiffSharingGroup&quot;,sIsDiffSharingGroup);
	psOutputs.SetProperty(&quot;VoicePropExist&quot;,sVoiceExists);	// VHA Suresh: Added for R17.3 Sharing: PIPE
	psOutputs.SetProperty(&quot;VoiceNotRemoveMemExist&quot;,sVoiceNotRemMem);
	psOutputs.SetProperty(&quot;FBBPropAddmemExist&quot;,sFBBAddMem);
	psOutputs.SetProperty(&quot;InstockVoiceExist&quot;,sVoiceInstockExists);
	psOutputs.SetProperty(&quot;sError&quot;,sError); //Karthika - 12/06/2017 - Added as part of Retrofit
}

catch(e)
{
	 throw e;
}
finally
{
	 sSharingBC = null;
	 sSharingBO = null;
								
}
}"
			   SEQUENCE="9"
			   UPDATED="03/19/2026 00:15:53"
			   UPDATED_BY="KOVIDT"
			   CREATED="08/17/2016 09:04:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnDecideSharingNewLead"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnDecideSharingNewLead(sGroupId,sAssetIntgId,sSharingAction,sOrderId,sOrderType,sLeadMSISDNId,Outputs)
{
try
{
	var BO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
	var oAssetBC = BO.GetBusComp(&quot;VHA Asset Mgmt - Asset - Header&quot;);
	TheApplication().SetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;,&quot;Y&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingOrderId&quot;,sOrderId);
	TheApplication().SetProfileAttr(&quot;VhaSharingSubType&quot;,sOrderType);
	TheApplication().SetProfileAttr(&quot;VhaSharingSubmitCall&quot;,&quot;Y&quot;);
	//var sSearchspec = &quot;[Sharing Group Id] = &apos;&quot; + sGroupId + &quot;&apos; AND [Integration Id] &lt;&gt; &apos;&quot; + sAssetIntgId + &quot;&apos;&quot;;
	var sLeadMSISDN = &quot;&quot;,sSharingGroupLeadId = &quot;&quot;;
	var  Inputs = TheApplication().NewPropertySet();
	var  cInputs = TheApplication().NewPropertySet();
	if (sGroupId != &quot;&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;) != &quot;&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VhaSharingOrderId&quot;) !=&quot;&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VhaSharingSubType&quot;) != &quot;&quot; &amp;&amp; TheApplication().SetProfileAttr(&quot;VhaSharingSubmitCall&quot;) != &quot;&quot;)
	{
		with(oAssetBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;VF Share Flag&quot;);
			ActivateField(&quot;MSISDN&quot;);
			ActivateField(&quot;Integration Id&quot;);
			ActivateField(&quot;Sharing Group Count&quot;);
			ActivateField(&quot;Sharing Group Id&quot;);
			ActivateField(&quot;Sharing Lead Id&quot;);
			ActivateField(&quot;Sharing Group Status&quot;);
			ActivateField(&quot;VHA Lead MSISDN&quot;);
			ActivateField(&quot;VHA Siebel Product Type&quot;);
			ActivateField(&quot;VHA Siebel Prod Type-LOV&quot;);
			ClearToQuery();
			SetSortSpec(&quot;VHA Siebel Prod Type-LOV&quot;);
			ExecuteQuery(ForwardOnly);
			var sAssetCount = CountRecords();
			var stempCount = 1;
			var isRec = FirstRecord();
			if(FirstRecord())
			{	
				 sSharingGroupLeadId = GetFieldValue(&quot;Sharing Lead Id&quot;);
			
				if(sSharingAction == &quot;Remove Member&quot; &amp;&amp; sSharingGroupLeadId == sAssetIntgId)
				{
						while (isRec)
							{
								var AssetIntId = GetFieldValue(&quot;Integration Id&quot;);
								Inputs.SetProperty(&quot;Asset Integration Id&quot;,AssetIntId);
								if(sOrderType == &quot;Change Proposition&quot;)
									{
										var sChangeLeadExist = mCheckChangeLeadExists(sOrderId,sAssetIntgId);
										if(sChangeLeadExist != &quot;N&quot;)
										{
												mCheckOpenOrder(Inputs, Outputs);
										}
									}
								else
								{
									mCheckOpenOrder(Inputs, Outputs);
								}
								var sError = Outputs.GetProperty(&quot;sErrormessage&quot;);
								if(sError == &quot;&quot;)
								{
									Outputs.SetProperty(&quot;SharingAction&quot;,&quot;Remove Member&quot;);
									Outputs.SetProperty(&quot;LeadMSISDN&quot;,GetFieldValue(&quot;VHA Lead MSISDN&quot;));
									if(sAssetCount &gt; 1)
									{
										sLeadMSISDN = GetFieldValue(&quot;MSISDN&quot;);
										gAddmem = mCheckAddMember(sOrderId,sLeadMSISDN,sAssetCount,sAssetIntgId,sGroupId);
										if(gAddmem ==&quot;&quot;)
										{
											gAddmem = sLeadMSISDN;
										}
										if(sOrderType == &quot;Change Proposition&quot;)
											{
												if(mCheckChangeLeadExists(sOrderId,sAssetIntgId) != &quot;N&quot;)
													Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,GetFieldValue(&quot;MSISDN&quot;));
												else
												    gAddmem = &quot;&quot;;
											}
											else
												Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,GetFieldValue(&quot;MSISDN&quot;));
												
									
									}
									else if(sAssetCount == 1 )
									{
										sLeadMSISDN = GetFieldValue(&quot;MSISDN&quot;);
										gAddmem = mCheckAddMember(sOrderId,sLeadMSISDN,sAssetCount,sAssetIntgId,sGroupId);
										if(gAddmem != &quot;&quot;)
										{
											if(sOrderType == &quot;Change Proposition&quot;)
											{
												if(mCheckChangeLeadExists(sOrderId,sAssetIntgId) != &quot;N&quot;)
													Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,GetFieldValue(&quot;MSISDN&quot;));
												else
												 gAddmem = &quot;&quot;;
											}
											else
												Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,GetFieldValue(&quot;MSISDN&quot;));
										}	
									}
									break;
								}
								else if(sError != &quot;&quot; &amp;&amp; (stempCount == sAssetCount) &amp;&amp; ((sOrderType == &quot;Disconnect&quot; &amp;&amp; sExistingFlag == &quot;Y&quot;) || sOrderType != &quot;Disconnect&quot;))
								{
									throw(sError);
								}
								stempCount++;
								isRec = NextRecord();
							}
						
							
				}
				else if(sSharingAction == &quot;Remove Member&quot; &amp;&amp; sSharingGroupLeadId != sAssetIntgId)
				{
						Outputs.SetProperty(&quot;SharingAction&quot;,&quot;Remove Member&quot;);
						Outputs.SetProperty(&quot;LeadMSISDN&quot;,GetFieldValue(&quot;VHA Lead MSISDN&quot;));
						Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,&quot;&quot;);
				}
				else if(sSharingAction == &quot;Add Member&quot;)
				{
						Outputs.SetProperty(&quot;SharingAction&quot;,&quot;Add Member&quot;);
						Outputs.SetProperty(&quot;LeadMSISDN&quot;,GetFieldValue(&quot;VHA Lead MSISDN&quot;));
						Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,&quot;&quot;);
				}
				else if(sSharingAction == &quot;Existing Member&quot;)
				{
						Outputs.SetProperty(&quot;SharingAction&quot;,&quot;Existing Member&quot;);
						Outputs.SetProperty(&quot;LeadMSISDN&quot;,GetFieldValue(&quot;VHA Lead MSISDN&quot;));
						Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,&quot;&quot;);
				}
						
			}
			else
			{
				if(sSharingAction == &quot;Remove Member&quot; &amp;&amp; sLeadMSISDNId == sAssetIntgId)
				{
					sAssetCount = 0;
					sLeadMSISDN = &quot;&quot;;
					gAddmem = mCheckAddMember(sOrderId,sLeadMSISDN,sAssetCount,sAssetIntgId,sGroupId);
					if(gAddmem != &quot;&quot;)
						{
							if(sOrderType == &quot;Change Proposition&quot;)
								{
									if(mCheckChangeLeadExists(sOrderId,sAssetIntgId) != &quot;N&quot;)
											Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,gAddmem);
									else
									 gAddmem = &quot;&quot;;
								}
							else
								Outputs.SetProperty(&quot;NewLeadMSISDN&quot;,gAddmem);
					   }	
				}	
			}	
		
		}
		
	}
	
}
	catch (e)
	{
		throw e;
	}
	finally
	{
		oAssetBC = null;
		BO = null;
	TheApplication().SetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;,&quot;&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingOrderId&quot;,&quot;&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingSubType&quot;,&quot;&quot;);
	TheApplication().SetProfileAttr(&quot;VhaSharingSubmitCall&quot;,&quot;&quot;);
	}
}"
			   SEQUENCE="10"
