			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCancelUpgradeSIMSwap"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCancelUpgradeSIMSwap(Inputs, Outputs)
{
	try
	{
		var psInputs,psOutputs,bsInvokeWorkflow,psInputsChild;
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sSIMTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
		var sComponent = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Component&quot;);
		var sMode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Mode&quot;);
		var boSIMSwap = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items&quot;);
		var bcSIMSwap = boSIMSwap.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
		bcSIMSwap.ActivateField(&quot;VF SIM Number TBUI&quot;);
		bcSIMSwap.ActivateField(&quot;VHA Confirmation Code&quot;);
		bcSIMSwap.ClearToQuery();
		bcSIMSwap.SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+ sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Shipping] = &apos;&quot;+sSIMTypeLOV+&quot;&apos; AND [VF SIM Number TBUI] IS NOT NULL AND [VF SIM Swap Request Pending] IS NULL&quot;);
		bcSIMSwap.ExecuteQuery();
		var sIsRecord = bcSIMSwap.FirstRecord();
		while(sIsRecord)
		{
			psInputs = TheApplication().NewPropertySet();
			psInputsChild = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;Component&quot;, sComponent);
			psInputs.SetProperty(&quot;Mode&quot;, sMode);
			psInputsChild.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
			psInputsChild.SetProperty(&quot;SuppressError&quot;,&quot;Y&quot;);
			psInputsChild.SetProperty(&quot;RequestId&quot;, bcSIMSwap.GetFieldValue(&quot;Id&quot;));
			psInputsChild.SetProperty(&quot;Action Code&quot;, &quot;Deallocate&quot;);
			psInputsChild.SetProperty(&quot;OrderSubType&quot;, &quot;UPGRADE&quot;);
			psInputsChild.SetProperty(&quot;Confirmation Code&quot;,bcSIMSwap.GetFieldValue(&quot;VHA Confirmation Code&quot;));
			psInputsChild.SetProperty(&quot;ICCID&quot;,bcSIMSwap.GetFieldValue(&quot;VF SIM Number TBUI&quot;));
			psInputs.AddChild(psInputsChild);
			bsInvokeWorkflow = TheApplication().GetService(&quot;Server Requests&quot;);
			bsInvokeWorkflow.InvokeMethod(&quot;SubmitRequest&quot;, psInputs, psOutputs);
			sIsRecord = bcSIMSwap.NextRecord();
		}
	}
	catch(e)
	{
		//throw(e);
	}
	finally
	{
		bcSIMSwap = null;
		boSIMSwap = null;
	}
}"
