			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRefreshCreditCadrdDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mRefreshCreditCadrdDetails(Inputs,Outputs)
{
	try
	{
		var sBO = TheApplication().ActiveBusObject();
		var sBC;
		if(sBO.Name() != &quot;&quot;)
		{
			sBC = sBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
			sBC.ClearToQuery();
			sBC.ExecuteQuery();
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
