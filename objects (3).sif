			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSysPref"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSysPref (strName)
{
/************************************************************************
/* Component Name        : 	Siebel eChannel for CME
/* Method Name           : 	mGetSysPref
/* Component Information : 	This function is used to get the system preference.
/*
/* Modification History  :
/* Date			Author		Config #	Description
/* ============ ===========	===========	================================
/* 08/11/2019	Pavani 		            Initial Version
  08/11/2019	Pavani		UPG IP19	Added from Power Comm Application
/************************************************************************/

try {
 var strValue=&quot;&quot;;
 var boSystemPref = TheApplication().GetBusObject(&quot;System Preferences&quot;);  
 var bcSystemPref = boSystemPref.GetBusComp(&quot;System Preferences&quot;);

 with (bcSystemPref)
 {
  ActivateField(&quot;Value&quot;);
  ClearToQuery();
  SetSearchSpec(&quot;Name&quot;, strName);
  ExecuteQuery(ForwardOnly);
  if(!FirstRecord())
  {
   strValue=&quot;NAN&quot;;
  }
  else
  {
   strValue = GetFieldValue(&quot;Value&quot;);
  }
 }

}
catch(e){
 throw(e);}
finally{
 bcSystemPref = null;
 boSystemPref = null;
}
return (strValue);
}
"
			   SEQUENCE="17"
			   UPDATED="05/23/2025 19:38:37"
