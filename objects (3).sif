			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetMasterPASProfile"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetMasterPASProfile(sDealerRowID, psOutputs)
{
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 	
* 08/11/2019	Pavani		UPG IP19 Added from Power Comm Application
 *					
 * 
*/

	var sDealerId=null;

	try 
	{ 
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Application.mGetMasterPASProfile&quot;);
		}	
		
		//Declare objects
		var boEmployee = TheApplication().GetBusObject(&quot;Employee&quot;);
		var bcEmployee = boEmployee.GetBusComp(&quot;Employee&quot;);
					
		//Find the Employee record associated to the dealer.
		with (bcEmployee)
	 	{
			ClearToQuery();	 	
			SetViewMode(AllView);
			ActivateField(&quot;VF Port Initiation User Id&quot;);
			ActivateField(&quot;VF Sales Channel Code&quot;);			
			ActivateField(&quot;VF Business Group Code&quot;);

			SetSearchSpec(&quot;Id&quot;, sDealerRowID);
			ExecuteQuery();	
			if (FirstRecord())
			{	
					var sPort = GetFieldValue(&quot;VF Port Initiation User Id&quot;);
					var sSales = GetFieldValue(&quot;VF Sales Channel Code&quot;);
					var sBusiness = GetFieldValue(&quot;VF Business Group Code&quot;);				
			}
			psOutputs.SetProperty(&quot;PortInitiation&quot;,sPort);
			psOutputs.SetProperty(&quot;SalesChannel&quot;,sSales);
			psOutputs.SetProperty(&quot;BusinessGroup&quot;,sBusiness);						
		} // end with
		
	} // end try
	
	catch(e) 
	{ 
		if (defined(e.errText))
		{
			var	sErrorMessage = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var sErrorMessage = arguments.callee + ToString(e); 
		}
		throw (sErrorMessage);
	} 
	
	finally 
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Application.mGetMasterPASProfile&quot;);
		}	
		
		//Destroy objects
		bcEmployee = null;
		boEmployee = null;

		
	}
}"
