			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckOpenOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckOpenOrder(Inputs, Outputs)
{
	try
	{	
		var sSearchExpr =&apos;&apos;;
		var sPendingOrderId = &quot;&quot;; //VHA NandhiniG 7\6\19 : Added for MR03  Resubmiting Pending Connects
		var sAssetIntId = Inputs.GetProperty(&quot;Asset Integration Id&quot;);
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var OrderType = Inputs.GetProperty(&quot;sOrderType&quot;);
		var IsUICall = Inputs.GetProperty(&quot;IsCallFromUI&quot;);
		var sBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Sharing Asset Order History&quot;);
		var sLstBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		var sLstBC = sLstBO.GetBusComp(&quot;List Of Values&quot;);
		var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sOrderBC = sOrderBO.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var sExisFlag = &quot;Y&quot;,sOrdersubtype = &quot;&quot;;
		
		with(sOrderBC)
		{
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Active&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sOrdersubtype = GetFieldValue(&quot;Order Sub Type&quot;);
			}
		}
		
		if(sOrdersubtype == &quot;Quote Order&quot;)
		{
			if(IsUICall == &quot;Y&quot;)
			sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +sAssetIntId+ &quot;&apos; AND [Quote Id] &lt;&gt; &apos;&quot; +sOrderId+ &quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Status] &lt;&gt; &apos;Cancelled&apos;&quot;;
	 
			else	
			sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +sAssetIntId+ &quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Status] &lt;&gt; &apos;Cancelled&apos;&quot;;
		}
		else
		{
			if(IsUICall == &quot;Y&quot;)
			sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +sAssetIntId+ &quot;&apos; AND [Order Header Id] &lt;&gt; &apos;&quot; +sOrderId+ &quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Status] &lt;&gt; &apos;Cancelled&apos;&quot;;
	 
			else	
			sSearchExpr = &quot;[Asset Integration Id]=&apos;&quot; +sAssetIntId+ &quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Status] &lt;&gt; &apos;Cancelled&apos;&quot;;
		}
		var sOrderTypes = &apos;&apos;, sErrormessage=&apos;&apos;;
		with(sLstBC)
		{
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Active&quot;);
			ActivateField(&quot;Value&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Type&quot;,&quot;VHA_SHARING_ORDER_SUBTYPE&quot;);
			ExecuteQuery(ForwardOnly);
			var irec = FirstRecord();
			var count =0;
			if(irec)
			while(irec)
			{
				var sValue = GetFieldValue(&quot;Value&quot;);
				if(count == 0)
					sOrderTypes = &quot;[Order Sub Type]=&apos;&quot; +sValue+ &quot;&apos;&quot;;
				else
					sOrderTypes = sOrderTypes +&quot; OR [Order Sub Type]=&apos;&quot; +sValue+ &quot;&apos;&quot;;
				count++;
				irec=NextRecord();
			}
		}
		if(sOrderTypes != null &amp;&amp; sOrderTypes !=&apos;&apos;)
			sSearchExpr = &quot;&quot; +sSearchExpr+ &quot; AND (&quot; +sOrderTypes+ &quot;)&quot;;
			
		with(sBC)
		{
			ActivateField(&quot;Asset Integration Id&quot;);
			ActivateField(&quot;Order Status&quot;);
			ActivateField(&quot;Order Sub Type&quot;);//Quote Id
			ActivateField(&quot;Status&quot;);
			ActivateField(&quot;Sharing Action Calc&quot;);
			ActivateField(&quot;VF Service Order Sub Type&quot;);
			ActivateField(&quot;Custom Asset Integration Id&quot;);
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;Quote Id&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchExpr(sSearchExpr);   
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				var sOrderHeaderStatus = GetFieldValue(&quot;Order Status&quot;);
				var sSharingAction = GetFieldValue(&quot;Sharing Action Calc&quot;);
				var sOpenOrderType = GetFieldValue(&quot;VF Service Order Sub Type&quot;);
				var sCustomAssIntId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
				var OrderId = GetFieldValue(&quot;Order Id&quot;);
				if(sOrderHeaderStatus != &quot;Cancelled&quot;)
				{
					if(sOpenOrderType == &quot;Change Proposition&quot;)
						{
							sExisFlag = mCheckChangeLeadExists(OrderId,sCustomAssIntId);
						}
					sErrormessage = &quot;VFErrorCode#96012&quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;96012&quot;);
					sPendingOrderId = GetFieldValue(&quot;Order Id&quot;); //VHA NandhiniG 7\6\19 : Added for MR03  Resubmiting Pending Connects
				}
				if(sSharingAction == &quot;Existing Member&quot; || sExisFlag != &quot;Y&quot;)
				{
					sExistingFlag = &quot;Y&quot;;	
				}
			}	
		}
		Outputs.SetProperty(&quot;sErrormessage&quot;,sErrormessage);
		Outputs.SetProperty(&quot;PendingOrderId&quot;,sPendingOrderId); //VHA NandhiniG 7\6\19 : Added for MR03  Resubmiting Pending Connects
		
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VHA Sharing Simplification BS.mCheckOpenOrder - &quot; + strError);
		}		
		throw (strError);
	}
	finally
	{/*Below variables are nullified by GURUPRASAD on 23/10/2019*/
		sLstBC = null;
		sLstBO = null;	
		sBC = null;
		sBO = null;
		sOrderBO = null;
		sOrderBC = null;
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VHA Sharing Simplification BS.mCheckOpenOrder&quot;);
		}		
	}
}"
