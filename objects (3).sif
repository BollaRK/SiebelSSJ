			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mReuseModemAsset"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mReuseModemAsset(Inputs, Outputs)
{
	//SakthiR Created For Resue Modem
	try
	{
		var sOrderBO,sOrderBC;
		var psErrorInput, psErrorOutput, sErrorMessage, bsError;
		var iRecord = &quot;&quot;;
		var sOrderId = &quot;&quot;;
		var sAssetId = &quot;&quot;;
		var sChangeInfo = &quot;&quot;;
		var sMSISDN = &quot;&quot;;
		var sAssetInfo = &quot;&quot;;
		var sConnectFWA = &quot;&quot;;
		sAssetId = TheApplication().GetProfileAttr(&quot;AssetRowId&quot;);
		sChangeInfo = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
		if(sChangeInfo == &quot;Change NBN Address&quot; || sChangeInfo == &quot;Change Location FWA&quot;)
		{
			sMSISDN = TheApplication().GetProfileAttr(&quot;VF Authenticated MSISDN&quot;);
		}
		else
		{
			sMSISDN = TheApplication().GetProfileAttr(&quot;CoTOldMSISDN&quot;);
		}			
		sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);			
		sOrderId = Inputs.GetProperty(&quot;OrderNumber&quot;);
		sConnectFWA = Inputs.GetProperty(&quot;ConnectFWA&quot;);
		if(sOrderId !=&quot;&quot;)
		{					
			with(sOrderBC)
			{
				sOrderBC.SetViewMode(AllView);
				sOrderBC.ClearToQuery();
				sOrderBC.ActivateField(&quot;VF COL COT Asset Info&quot;);
				sOrderBC.ActivateField(&quot;VHA FWA Indentifier&quot;);
				sOrderBC.ActivateField(&quot;Order Number&quot;);
				sOrderBC.SetSearchSpec(&quot;Order Number&quot;, sOrderId);
				sOrderBC.ExecuteQuery(ForwardOnly);	
				iRecord = sOrderBC.FirstRecord();
				if(iRecord) 
				{
					sAssetInfo = sChangeInfo + &quot;|&quot; + sAssetId + &quot;|&quot; + sMSISDN;
					sOrderBC.SetFieldValue(&quot;VF COL COT Asset Info&quot;, sAssetInfo);
					if(sConnectFWA == &quot;Y&quot;)
					{
						sOrderBC.SetFieldValue(&quot;VHA FWA Indentifier&quot;, &quot;ConnectFWA&quot;);	
					}
					sOrderBC.WriteRecord();			
				}
			}

		}

	}
	catch(e)
	{
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;ReuseModem&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;mReuseModemAsset&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	finally
	{
		sOrderBO = null;
		sOrderBC = null;
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
	}
}	"
			   SEQUENCE="22"
			   UPDATED="12/22/2025 22:23:10"
			   UPDATED_BY="GANESHR"
			   CREATED="11/04/2024 15:08:16"
			   CREATED_BY="SAKTHIR">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetSMSFlg"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetSMSFlg(Inputs,Outputs){
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sSiebProdType;
	var boOrders = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	var bcOrderLineItems = boOrders.GetBusComp(&quot;VF Order Line Item - Light&quot;);
	with(bcOrderLineItems)
	{		
		SetViewMode(AllView);
		ActivateField(&quot;VF Siebel Product Type&quot;);
		ClearToQuery();
		var searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Siebel Product Type]=&apos;Voice&apos; AND [Parent Order Item Id] IS NULL AND [Action Code]&lt;&gt;&apos;Delete&apos;&quot;;
		SetSearchExpr(searchst);
		ExecuteQuery(ForwardOnly);
		if(FirstRecord())
		{
			var bcOrder = boOrders.GetBusComp(&quot;VF Order Entry - Orders&quot;);
			with(bcOrder)
			{		
				SetViewMode(AllView);
				ActivateField(&quot;VF Opt In SMS&quot;);
				ClearToQuery();
				var searchst = &quot;[Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
				SetSearchExpr(searchst);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					SetFieldValue(&quot;VF Opt In SMS&quot;,&quot;Y&quot;);
					WriteRecord();
				}
			}//with
		}
	}//with
}"
			   SEQUENCE="23"
			   UPDATED="12/22/2025 22:23:10"
