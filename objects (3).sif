			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnClearAssetFlag"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnClearAssetFlag(Inputs,Outputs)
{
try
	{
		var sAccountID = Inputs.GetProperty(&quot;AccountId&quot;);
		var sAssetBO = TheApplication().GetBusObject(&quot;VF Prepaid Thin TBUI&quot;);
		var sAssetBC = sAssetBO.GetBusComp(&quot;VF Asset Update&quot;);
		with(sAssetBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Sharing Select&quot;);
			ActivateField(&quot;Service Account Id&quot;);
			ClearToQuery();
			var searchst1 = &quot;[Service Account Id] = &apos;&quot; + sAccountID + &quot;&apos; AND  [Sharing Select] = &apos;Y&apos;&quot;;
			SetSearchExpr(searchst1);
			ExecuteQuery(ForwardOnly);	
			var isRecord = FirstRecord(); 
			while(isRecord)
			{
				SetFieldValue(&quot;Sharing Select&quot;, &quot;&quot;);
				WriteRecord();
				isRecord = NextRecord();
			}
		}//with
	}
	catch(e)
	{
		throw(e)
	}
	finally
	{
		sAssetBC=null;
		sAssetBO=null;
	}
}"
