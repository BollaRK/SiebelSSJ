			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateBulkeSIMDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateBulkeSIMDetails(Inputs,Outputs)
{
try
{
	var sSIMType = Inputs.GetProperty(&quot;SIM Type&quot;);
	var sConfirmationCode = Inputs.GetProperty(&quot;ConfimationCode&quot;);
	var sSMDPAddress = Inputs.GetProperty(&quot;SMDP+ Address&quot;);
	var sActivationCode = Inputs.GetProperty(&quot;Activation Code&quot;);
	var sBulkType = Inputs.GetProperty(&quot;Type&quot;);
	var sSIM = Inputs.GetProperty(&quot;SIM&quot;);
	
	if(((sConfirmationCode != null &amp;&amp; sConfirmationCode != &quot;&quot;) || (sSMDPAddress != null &amp;&amp; sSMDPAddress != &quot;&quot;) || (sActivationCode != null &amp;&amp; sActivationCode != &quot;&quot;)) &amp;&amp; (sSIMType == null || sSIMType == &quot;&quot;))
	{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;SIM Type is mandatory for eSIM&quot;);
	}
	else if(((sConfirmationCode != null &amp;&amp; sConfirmationCode != &quot;&quot;) || (sSMDPAddress != null &amp;&amp; sSMDPAddress != &quot;&quot;) || (sActivationCode != null &amp;&amp; sActivationCode != &quot;&quot;)) &amp;&amp; (sSIMType !=TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;)))
	{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;Confirmation Code, SMDPPLUSAddress and ActivationCode are applicable only for eSIM&quot;);
	}
	
	else if(sSIMType == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;))
	{
		if((sBulkType == &quot;Transfer of Title&quot;) &amp;&amp; (sSIM == &quot;&quot; || sSIM == null))
		{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;SIM is mandatory for eSIM&quot;);
		}
		else if(sConfirmationCode == &quot;&quot; || sSMDPAddress == &quot;&quot; || sActivationCode == &quot;&quot;)
		{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;SIM Type, Confirmation Code, SMDPPLUSAddress, and ActivationCode are mandatory for eSIM&quot;);
		}
		else if(sConfirmationCode.length != 4)
		{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;Invalid Confirmation Code. Please provide a valid four digit confirmation code&quot;);
		}
		else if (sConfirmationCode &lt; 0)
		{
		Outputs.SetProperty(&quot;Error Message&quot;,&quot;Invalid Confirmation Code. Please provide a valid four digit confirmation code&quot;);
		}
		else
		{//Do nothing
		}
	}
}
catch(e)
{
	throw(e);
}
finally
{
}
}"
