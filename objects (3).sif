			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs) 
{
	switch (MethodName)
	{
		/*Subramanian - Checks if notification flag is checked for MSO orders*/
		case &quot;InvokePostConfiguration&quot;:
			mInvokePostConfiguration(Inputs, Outputs);
			return(CancelOperation);
			break;
		
		/*Subramanian 3.5.15 - Script to set flag if notification method is Email*/	
		case &quot;SetNotificationRO&quot; :
			    mSetNotificationRO (Inputs, Outputs);
			    break;
		case &quot;UpdateTBCDetails&quot;:
			mUpdateTBCDetails (Inputs, Outputs);
		break;

		case &quot;CheckExistingCA&quot;:
			mCheckForExistingCustomer (Inputs,Outputs);
			break;
      
	  	case &quot;CheckCustActiveVoiceService&quot;://VHA Balamurugan -17/03/2020 - Added for R20.1 -ShipmentAddressCR
			mCheckCustActiveVoiceService (Inputs,Outputs);
			break;  //END HERE
		case &quot;CreateNBNto5GXM&quot;:
			mCreateNBNto5GXM(Inputs, Outputs);
			break;
		case &quot;CreateNBNDisconnect&quot;:
			mCreateNBNDisconnect(Inputs, Outputs);
			break;
		case &quot;UpdateFutureDate&quot;:
			mUpdateFutureDate(Inputs, Outputs);
			break;
		default:
			break;
	}
	return (CancelOperation); //ContinueOperation is commented and CancelOperation used
}"
