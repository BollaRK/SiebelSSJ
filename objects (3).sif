			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSSJSetProfileAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="
function mSSJSetProfileAttr (Inputs, Outputs)
{
	var strSSJPropName = &quot;&quot;, strSSJPropValue = &quot;&quot;;
	strSSJPropName = Inputs.GetFirstProperty();
	
	while (strSSJPropName != &quot;&quot;)
	{
		strSSJPropValue = Inputs.GetProperty(strSSJPropName);
		TheApplication().SetProfileAttr(strSSJPropName, strSSJPropValue);
		strSSJPropName = Inputs.GetNextProperty();
	}
	var sSSJOrderId= Inputs.GetProperty(&quot;OrderId&quot;);
		var sSSJPPBS = TheApplication().GetService(&quot;VHA Prepayments BS&quot;);
		var sSSJPPInputs  = TheApplication().NewPropertySet();
		var sSSJPPOutputs = TheApplication().NewPropertySet();
		sSSJPPInputs.SetProperty(&quot;OrderId&quot;, sSSJOrderId);			
		sSSJPPBS.InvokeMethod(&quot;DeleteCCDetails&quot;, sSSJPPInputs, sSSJPPOutputs);
	
	TheApplication().SetProfileAttr(&quot;SSJSubmitPostComplete&quot;, &quot;Y&quot;);
	
	/*
	//Soumalya:Deactivated below code as it was breaking Back to Cart / Edit in cart &amp; Resume from Credit check SFJ
	//var QuoteId = Inputs.GetProperty(&quot;TBUIQuoteId&quot;);
	var taskUIsvc = TheApplication().GetService(&quot;Shopping Service&quot;);
	var inputPropSet = TheApplication().NewPropertySet();
	var outputPropSet = TheApplication().NewPropertySet();
	inputPropSet.SetProperty(&quot;View&quot;, &quot;VHA SSJ Sales Calculator Search View&quot;);
	//inputPropSet.SetProperty(&quot;Business Component&quot;, &quot;Order Entry - Orders&quot;);
	inputPropSet.SetProperty(&quot;Row Id&quot;, sOrderId);
	taskUIsvc.InvokeMethod(&quot;GotoView&quot;, inputPropSet, outputPropSet);
				
	*/
}"
