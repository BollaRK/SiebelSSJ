			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetESIMPlanName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetESIMPlanName(Inputs,Outputs)
{
   		var orderLIBusObj = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var orderLIBusComp 	= orderLIBusObj.GetBusComp(&quot;Order Entry - Line Items&quot;);
        var bo = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
        var bc = bo.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var OrderId =&quot;&quot;,rateplanname = &quot;&quot;;
		var OrderItemId =&quot;&quot;;
		var sPlanName=&quot;&quot;;
		
		OrderId = Inputs.GetProperty(&quot;OrderId&quot;) ;  
		with (orderLIBusComp)
		{ 
			SetViewMode(AllView);
			ClearToQuery();
            ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Related Asset Integration Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
            SetSearchExpr(&quot;[Parent Order Item Id] IS NULL  AND [Order Header Id] = &apos;&quot;+OrderId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			var isRecord = FirstRecord();
			if (isRecord)	
			{
				var rootid  = GetFieldValue (&quot;Root Order Item Id&quot;);
				with(bc)
				{
					ActivateField(&quot;Product&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Root Order Item Id] = &apos;&quot;+rootid+&quot;&apos; AND [Primary Product Flag] = &apos;Y&apos; AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
					ExecuteQuery();
					if(FirstRecord())
						 sPlanName = GetFieldValue(&quot;Product&quot;);
				}
			}
		}
		Outputs.SetProperty(&quot;PlanName&quot;,sPlanName);
}

"
