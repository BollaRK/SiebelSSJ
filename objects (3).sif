			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	var iReturn = ContinueOperation;
	try
	{		
		if(MethodName == &quot;ValidatePropositionAccountSegment&quot;)
		{
			ValidatePropositionAccountSegment(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;CheckOrdSubmtdTwoWaySMSSent&quot;)
		{
		    CheckOrdSubmtdTwoWaySMSSent(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;GeneratePaymentPlan&quot;)
		{
		    GeneratePaymentPlan(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		
		if (MethodName == &quot;Prepare Line Item RowSet&quot;)
		{
		    prepLnItmDtlsFrPrePmnt(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		
		if (MethodName == &quot;ChckSSJPaperLessBypassRO&quot;)
		{
		    ChckSSJPaperLessBypassRO(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;SSJCheckTwoWaySMSEligibility&quot;)
		{
		    SSJCheckTwoWaySMSEligibility(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;ChckSSJSMSOvrdRO&quot;)
		{
		    ChckSSJSMSOvrdRO(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;CreateSFJOfferHistory&quot;)
		{
		    createSFJOfferHistory(Inputs, Outputs);
			iReturn =  CancelOperation;
		}	
		if (MethodName == &quot;SSJQuoteEmailAddress&quot;)
		{
		    SSJQuoteEmailAddress(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;AddSFJOfferHistory&quot;)
		{
		    AddSFJOfferHistory(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;RemoveConnectService&quot;)
		{
			RemoveConnectService(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;ClearRootLineItem&quot;)
		{
			ClearRootLineItem(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;UpdateDevice&quot;) //MJ:Added for SSJ Device Details
        {
			GetUpdateStockInd(Inputs, Outputs);
            GetUpdateDeviceDetail(Inputs, Outputs);
            iReturn = CancelOperation;
        }
		if (MethodName == &quot;UpdateRLIGPPTerm&quot;) //MJ:Added for SSJ GPP Term Details
        {
            GetUpdateGPPTerm(Inputs, Outputs);
            iReturn = CancelOperation;
        }
		if (MethodName == &quot;UpdateAttrPrepayAmt&quot;)
        {
            mUpdateAttrPrepayAmt(Inputs, Outputs);
            iReturn = CancelOperation;
        }
		if(MethodName == &quot;CallCalculateChargeForQuoteChild&quot;)
		{
			CallCalculateChargeForQuoteChild(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if (MethodName == &quot;ValidateConsumerProp&quot;) //MJ:Added for validate Consumer/Business Details
        {
            mValidateConsumerProp(Inputs, Outputs);
            iReturn = CancelOperation;
        }
		if(MethodName == &quot;UpdateDefaultNotifMSISDN&quot;)//02042026:RAJUD:Added for CM-8754 
		{
			UpdateDefaultNotifMSISDN(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if(MethodName == &quot;SSJCancelQuote&quot;)//02042026:RAJUD:Added for CM-8754 
		{
			SSJCancelQuote(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
		if(MethodName == &quot;SSJUpdateBusinessFlag&quot;)
		{
			SSJUpdateBusinessFlag(Inputs, Outputs);
			iReturn =  CancelOperation;
		}
	}
	catch(e)
	{
		throw(e);
	}
	return (iReturn);
}"
