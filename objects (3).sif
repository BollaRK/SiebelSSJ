			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInsertServiceAddr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInsertServiceAddr (Inputs,Outputs)
{
	try
	{
		var sbo = TheApplication().GetBusObject(&quot;VF FWA Service Address&quot;);
		var sbc = sbo.GetBusComp(&quot;VF FWA Service Address&quot;);

		var sAddrId = Inputs.GetProperty(&quot;Address Id&quot;);
	
		with (sbc)
		{

			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Addr Per Id&quot;);
			NewRecord(NewAfter);
			SetFieldValue(&quot;Addr Per Id&quot;,sAddrId);
			WriteRecord();
		
			Outputs.SetProperty(&quot;ServiceAddressId&quot;, GetFieldValue(&quot;Id&quot;));
					
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sbc = null;
		sbo = null;
	}

}"
			   SEQUENCE="7"
			   UPDATED="05/04/2026 15:12:14"
