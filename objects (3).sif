			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mNullifySIM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mNullifySIM(Inputs, Outputs)
{
try
{
	var sOLId = Inputs.GetProperty(&quot;OrderLineItemId&quot;);
	//	var boOrders = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	//var bcOrderLineItems = boOrders.GetBusComp(&quot;Order Entry - Line Items&quot;); SUBRAMANIAN 17Oct2014: Changed BC to VF Order Line Items - Thin
	var boOrders = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;);
	var bcOrderLineItems = boOrders.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
		with(bcOrderLineItems)
		{		
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF SIM TBUI&quot;);
			ActivateField(&quot;Shipping&quot;);
			SetSearchSpec(&quot;Id&quot;, sOLId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				SetFieldValue(&quot;VF SIM TBUI&quot;,&quot;&quot;);   
				if(TheApplication().ActiveViewName() == &quot;VF R&amp;C Order Fulfillment View&quot;)
				SetFieldValue(&quot;Shipping&quot;,&quot;&quot;);       
				WriteRecord();
			}
		}//with
}
catch(e)
{
throw(e)
}
finally
{
bcOrderLineItems = null;
boOrders = null;
}
}"
