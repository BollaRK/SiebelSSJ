			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetProdId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetProdId (Inputs,Outputs)
{
	try
	{
		var SessionId = Inputs.GetProperty(&quot;Session Id&quot;);
		var OrderNum = Inputs.GetProperty(&quot;Order Num&quot;);
		var bc = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
		var sProdbc = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VF Internal Product TBUI&quot;);
		var sSerAddrId = &quot;&quot; , sProdId  = &quot;&quot;;
		with(bc)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Service Address ID&quot;);
			ActivateField(&quot;Order Number&quot;);
			SetSearchSpec(&quot;Order Number&quot;,OrderNum);
			ExecuteQuery();				
			if(FirstRecord())
			{
				sSerAddrId = GetFieldValue(&quot;Service Address ID&quot;);
			}
		
		}
		TheApplication().SetProfileAttr(&quot;FWAS&quot;,sSerAddrId);
		if(sSerAddrId != null &amp;&amp; sSerAddrId != &quot;&quot;)
		{
			var oBC = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;).GetBusComp(&quot;VF Coverage Check&quot;);
			with(oBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;StreetType&quot;);
				ActivateField(&quot;Asset Id&quot;);
				SetSearchSpec(&quot;Asset Id&quot;,SessionId);
				ExecuteQuery();				
				if(FirstRecord())
				{
					sProdId = GetFieldValue(&quot;StreetType&quot;);	
				}	
			}
			if(sProdId != &quot;&quot; &amp;&amp; sProdId != null)
			{
				sProdbc.SetViewMode(AllView);
				sProdbc.ClearToQuery();
				sProdbc.SetSearchSpec(&quot;Id&quot;,sProdId);
				sProdbc.ExecuteQuery();
			}
		}
		TheApplication().SetProfileAttr(&quot;FWAP&quot;,sSerAddrId);
		Outputs.SetProperty(&quot;ProdId&quot;,sProdId);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	}
}	
	 
"
