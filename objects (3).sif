			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateMinimumAccessFee"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function mValidateMinimumAccessFee(sMinimumAccessFee,psInputsTriggerValue)
{
	try{	
		
		//variable declare
		var sReturn = &quot;Valid&quot;;
		var sOrderFunction  = psInputsTriggerValue.GetProperty(&quot;OrderFunction&quot;);
		var sOrderTypeTBUI = psInputsTriggerValue.GetProperty(&quot;OrderTypeTBUI&quot;);			
		var sRatePlanValidating = psInputsTriggerValue.GetProperty(&quot;ValRtPlnMinSpend&quot;);
		var sUpgradeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_FUNCTION&quot;,&quot;UPGRADE&quot;);
		var sRetOffers = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORDER_TYPE_TBUI&quot;,&quot;Retention Offers&quot;);
		if(sOrderTypeTBUI == sRetOffers)
		{
			sReturn = &quot;Invalid&quot;;
			return(sReturn);				
		}
		if(sRatePlanValidating != &quot;&quot; &amp;&amp; sRatePlanValidating != null)
		{
			if(sOrderFunction != sUpgradeLOV &amp;&amp; ToNumber(sRatePlanValidating) &gt;= ToNumber(sMinimumAccessFee))
			{
				sReturn = &quot;Valid&quot;;
				return(sReturn);				
			}
			if(sOrderFunction != sUpgradeLOV &amp;&amp; ToNumber(sRatePlanValidating) &lt; ToNumber(sMinimumAccessFee))
			{
				sReturn = &quot;Invalid&quot;;
				return(sReturn);				
			}
		}
		var sUpgradeOfferType = psInputsTriggerValue.GetProperty(&quot;UpgOfferType&quot;);
				
		if(sOrderFunction == sUpgradeLOV &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_INVALIDATE_OFFER&quot;,sUpgradeOfferType) != &quot;N&quot;)
		{
			sReturn = &quot;Invalid&quot;;
			return(sReturn);				
		}
		
		return(sReturn);		
	}//end try	
	catch(e)
	{
		throw (e);
	}//end catch

}
"
