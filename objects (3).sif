			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CleanUpChildOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CleanUpChildOrder(strOrderId) 
{
	var OrderBC=null, LineItemBO=null, LineItemBC=null,OrderBO=null,orderDeleteDone=&quot;N&quot;;
	try
	{
	OrderBO=TheApplication().GetBusObject(&quot;PDS Simplified Order&quot;);
	OrderBC=OrderBO.GetBusComp(&quot;PDS Simplified Order Entry - Orders&quot;);
	LineItemBO=TheApplication().GetBusObject(&quot;Order Entry - Line Items&quot;);
	LineItemBC=LineItemBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
	if(strOrderId != &quot;&quot; &amp;&amp; strOrderId != null)
	{
		with(LineItemBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Order Header Id&quot;);
                SetSearchSpec(&quot;Order Header Id&quot;,strOrderId);
                ExecuteQuery(ForwardOnly);
				if(!FirstRecord())
				{
					with(OrderBC)
					{
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Id&quot;,strOrderId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						DeleteRecord();
						orderDeleteDone = &quot;Y&quot;;
					}
					}
				}
			}
	}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		OrderBC = null;
		LineItemBO = null;
		LineItemBC=null;
		OrderBO=null;
	}
	return(orderDeleteDone);
}				"
