			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckOrderStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckOrderStatus(Inputs,Outputs)
{
	try{
	
		var OrderReference = Inputs.GetProperty(&quot;OrderReference&quot;);
		var BillingAccntId = Inputs.GetProperty(&quot;BillingAccntId&quot;);
		
		var SearchSpec = &quot;[VHA External Order Id] = &apos;&quot;+OrderReference+&quot;&apos; AND [Status] &lt;&gt; &apos;Complete&apos; AND [Order Status] &lt;&gt; &apos;Complete&apos;&quot;;
		
		var OrderBO = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;);
		var OrderBC = OrderBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		with(OrderBC){
				SetViewMode(AllView);
				ActivateField(&quot;VHA External Order Id&quot;);
				ActivateField(&quot;VHA External Service Id&quot;);
				ActivateField(&quot;VHA Order Head BA Id&quot;);
				ActivateField(&quot;Order Status&quot;);
				ActivateField(&quot;Status&quot;);
				ClearToQuery();
				SetSearchExpr(SearchSpec);
				ExecuteQuery();
				if(FirstRecord()){
					Outputs.SetProperty(&quot;Valid&quot;, &quot;FALSE&quot;);
				}else{
					Outputs.SetProperty(&quot;Valid&quot;, &quot;TRUE&quot;);
				}
		}
	}
	catch(e){
		throw(e);
	}
	finally{
		OrderBC = null;
		OrderBO = null;
	}
}"
