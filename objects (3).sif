			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateAssetId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateAssetId(Inputs, Outputs)
{
	try
	{
		var sRowId = Inputs.GetProperty(&quot;ServiceId&quot;);
		var sAssetId = Inputs.GetProperty(&quot;AssetId&quot;);
		var sFWAUserId = Inputs.GetProperty(&quot;FWAUserId&quot;);
		var sFWAOldAddrId = Inputs.GetProperty(&quot;FWAOldAddrId&quot;);
		var sFWAChngLoc = Inputs.GetProperty(&quot;FWAChangeLoc&quot;);
		
		
		var sAddrBC = TheApplication().GetBusObject(&quot;VHA Account BO&quot;).GetBusComp(&quot;VHA CUT Address&quot;);
		var sbc = TheApplication().GetBusObject(&quot;VF Address Thin&quot;).GetBusComp(&quot;VF Address Thin&quot;);
		/*with(sAddrBC)
		{	
				 
			
			SetViewMode(AllView);
			ClearToQuery();						
	        ActivateField(&quot;VHA Asset Id&quot;);
			ActivateField(&quot;VHA FWA Over UserId&quot;);
			ActivateField(&quot;Address Status&quot;);
			SetSearchSpec(&quot;Id&quot;,sRowId);										
		    ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{

				SetFieldValue(&quot;VHA Asset Id&quot;,sAssetId);
				SetFieldValue(&quot;VHA FWA Over UserId&quot;,sFWAUserId);
				SetFieldValue(&quot;Address Status&quot;,&quot;Active&quot;);
				WriteRecord();
			}
		}*/
		with(sbc)
		{	
				 
			SetViewMode(AllView);
			ClearToQuery();						
	        ActivateField(&quot;Address Id&quot;);
			ActivateField(&quot;Asset Integration Id&quot;);
			ActivateField(&quot;Address Account Id&quot;);
			ActivateField(&quot;Coverage Id&quot;);
			ActivateField(&quot;Organisation&quot;);
			ActivateField(&quot;Status&quot;);
			ActivateField(&quot;Start Date&quot;);
			SetSearchSpec(&quot;Address Id&quot;,sRowId);										
		    ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				var sAssetIntId = GetFieldValue(&quot;Asset Integration Id&quot;);
				if(sAssetIntId == null || sAssetIntId == &quot;&quot;)
				{
					SetFieldValue(&quot;Asset Integration Id&quot;,sAssetId);
					WriteRecord();
				}
				else
				{
					var sAccntId = GetFieldValue(&quot;Address Account Id&quot;);
					var sCovId = GetFieldValue(&quot;Coverage Id&quot;);
					var sBUId = GetFieldValue(&quot;Organisation&quot;);
					var sStatus = GetFieldValue(&quot;Status&quot;);
					//var sStartDt = GetFieldValue(&quot;Start Date&quot;);
					var sCurrentDt = new Date();
					var sStartDt = new Date(sCurrentDt.getTime());
					var strMonth =	sStartDt.getMonth() + 1;
					var strDay = sStartDt.getDate();
					var strYear = sStartDt.getFullYear();
					var strHours = sStartDt.getHours();
					var strMins = sStartDt.getMinutes();
					var strSecs = sStartDt.getSeconds();
					var dt1ful = strMonth + &quot;/&quot; + strDay + &quot;/&quot; + strYear + &quot; &quot; + strHours + &quot;:&quot; + strMins + &quot;:&quot; + strSecs;
			
					NewRecord(NewAfter);
					SetFieldValue(&quot;Asset Integration Id&quot;,sAssetId);
					SetFieldValue(&quot;Address Account Id&quot;,sAccntId);
					SetFieldValue(&quot;Coverage Id&quot;,sCovId);
					SetFieldValue(&quot;Organisation&quot;,sBUId);
					SetFieldValue(&quot;Address Id&quot;,sRowId);
					SetFieldValue(&quot;Status&quot;,sStatus);
					SetFieldValue(&quot;Start Date&quot;,dt1ful);
					WriteRecord();

				}
			}
		}
		
		if(sFWAChngLoc == &quot;Y&quot;)
		{
			var sCurrentDt = new Date();
			var sExpiryDt = new Date(sCurrentDt.getTime());
			var strMonth =	sExpiryDt.getMonth() + 1;
			var strDay = sExpiryDt.getDate();
			var strYear = sExpiryDt.getFullYear();
			var strHours = sExpiryDt.getHours();
			var strMins = sExpiryDt.getMinutes();
			var strSecs = sExpiryDt.getSeconds();
			var dt1ful = strMonth + &quot;/&quot; + strDay + &quot;/&quot; + strYear + &quot; &quot; + strHours + &quot;:&quot; + strMins + &quot;:&quot; + strSecs;
			with(sbc)
			{	
					 
				SetViewMode(AllView);
				ClearToQuery();						
		        ActivateField(&quot;Address Id&quot;);
				ActivateField(&quot;End Date&quot;);
				SetSearchSpec(&quot;Address Id&quot;,sFWAOldAddrId);										
			    ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
	
					SetFieldValue(&quot;End Date&quot;,dt1ful);
					WriteRecord();
				}
			}
		}								
	}
	catch(e)
	{	
		
		throw(e);
	}
	finally
	{
		sAddrBC = null;
		sbc = null;
	}
} 



  
