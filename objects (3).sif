			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateNBNto5GXM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateNBNto5GXM(Inputs, outputs){
	var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
	var sNBNMSISDN = Inputs.GetProperty(&quot;NBNMSISDN&quot;);
	var sMSISDN = Inputs.GetProperty(&quot;NewMSISDN&quot;);
	var sConOrderId = Inputs.GetProperty(&quot;ConnOrderId&quot;);
	var sSessionId = Inputs.GetProperty(&quot;SessionId&quot;);
	var sFulOrderId = Inputs.GetProperty(&quot;FulOrderId&quot;);
	
	var oBC = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;VHA NBN to 5G Migration&quot;);
	with (oBC)
	{
		ClearToQuery();
		ActivateField(&quot;Account Id&quot;);
		ActivateField(&quot;Connect Order Id&quot;);
		ActivateField(&quot;NBN MSISDN&quot;);
		ActivateField(&quot;New MSISDN&quot;);
		ActivateField(&quot;Wizard Session Id&quot;);
		ActivateField(&quot;Fulfilment Order Id&quot;);
		SetSearchSpec(&quot;Account Id&quot;, sAccountId);
		SetSearchSpec(&quot;Wizard Session Id&quot;, sSessionId);
		ExecuteQuery();
		if(FirstRecord())
		{
			SetFieldValue(&quot;NBN MSISDN&quot;, sNBNMSISDN);
			SetFieldValue(&quot;New MSISDN&quot;, sMSISDN);
			SetFieldValue(&quot;Connect Order Id&quot;, sConOrderId);
			SetFieldValue(&quot;Fulfilment Order Id&quot;, sFulOrderId);
			WriteRecord();
		}
		else
		{
			NewRecord(NewAfter);
			SetFieldValue(&quot;Account Id&quot;, sAccountId);
			SetFieldValue(&quot;Wizard Session Id&quot;, sSessionId);
			SetFieldValue(&quot;NBN MSISDN&quot;, sNBNMSISDN);
			SetFieldValue(&quot;New MSISDN&quot;, sMSISDN);
			SetFieldValue(&quot;Connect Order Id&quot;, sConOrderId);
			SetFieldValue(&quot;Fulfilment Order Id&quot;, sFulOrderId);
			WriteRecord();
		}
	}
}
"
			   SEQUENCE="5"
			   UPDATED="08/17/2021 21:36:32"
