			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTransferType_old"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTransferType_old(Inputs, Outputs)
{
try{
	var gAvailFT = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SQ_ORDER_AVAILABILITY&quot;,&quot;Available for Transfer&quot;);
	var gAvailFTN = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SQ_ORDER_AVAILABILITY&quot;,&quot;Available for Transition&quot;);
	var gAvailFNC = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SQ_ORDER_AVAILABILITY&quot;,&quot;Available for New Connect&quot;);
	var gSerTrnsfr = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_TRANSFER_TYPE&quot;,&quot;Service Transfer&quot;);
	var gSerTrn = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_TRANSFER_TYPE&quot;,&quot;Service Transition&quot;);
	var gConOut = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_TRANSFER_TYPE&quot;,&quot;Connect Outstanding&quot;);
	var gNew = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_TRANSFER_TYPE&quot;,&quot;New&quot;);
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	var bcSQService = boOrder.GetBusComp(&quot;VHA Site Qualification Service List&quot;); 
	var SQRowId = Inputs.GetProperty(&quot;SQRowId&quot;);
	var TransferType = Inputs.GetProperty(&quot;TransferType&quot;);
	bcSQService.ActivateField(&quot;Order Availability&quot;);
	bcSQService.ActivateField(&quot;Order Availability Calc&quot;);
	bcSQService.ActivateField(&quot;Parent Activity Id&quot;);
	
	with(bcSQService) 
	{ 
		var searchspec = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos; AND [Select] = &apos;Y&apos; &quot;; 
		SetViewMode(AllView); 
		ClearToQuery(); 
		SetSearchExpr(searchspec); 
		ExecuteQuery(ForwardOnly); 
		if(FirstRecord())
		{
			
			var sOrderAvail = bcSQService.GetFieldValue(&quot;Order Availability&quot;);
			var sOrderAvailCalc = bcSQService.GetFieldValue(&quot;Order Availability Calc&quot;);
			
			if(TransferType == &quot;&quot; || TransferType == null)
			TheApplication().RaiseErrorText(&quot;Please select a Transfer Type&quot;);
			
			if((sOrderAvail == gAvailFT) &amp;&amp; !(TransferType == gSerTrnsfr  || TransferType == gConOut))
				{
					TheApplication().RaiseErrorText(&quot;Please select Transfer Type as &apos;Service Transfer&apos; for Order Availability &apos;Available to Transfer&apos;.&quot;);
				}
			else if((sOrderAvailCalc == gAvailFTN) &amp;&amp;(TransferType != gSerTrn))
				{ 
					TheApplication().RaiseErrorText(&quot;Please select Transfer Type as &apos;Service Transition&apos; for Order Availability &apos;Available to Transition&apos;.&quot;);
				}
			else if((sOrderAvail == gAvailFNC) &amp;&amp; (TransferType != gNew))
				{ 
					TheApplication().RaiseErrorText(&quot;Please select Transfer Type as &apos;New&apos; for Order Availability &apos;Available for New Connection&apos;.&quot;);
				}
			
			
		}
	} 
	return (ContinueOperation);
	} 

	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcSQService = null;
		boOrder = null;
	}
	
	
}"
