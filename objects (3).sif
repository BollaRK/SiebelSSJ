			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="TruncateAmount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function TruncateAmount(sAmount)
{
 
	try
	{ 

		var sAmountString = sAmount.toString();
		if (sAmountString.indexOf(&quot;.&quot;)==-1)
		{

		}
		else
		{
			var sAmountArray = sAmountString.split(&quot;.&quot;);	
						
			//var sAmountDot = sAmountArray[1].substring(0,sAmountArray[1].length-2);
			var sAmountDot = sAmountArray[1].substring(0,2);
	
			sAmount = sAmountArray[0]+&quot;.&quot;+sAmountDot;
		}
		return sAmount;		 
	}
	catch(e)
	{
		throw e;		
	}
	finally
	{
		
	}
}"
