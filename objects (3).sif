			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fGetLastMonthlyBill"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fGetLastMonthlyBill(Inputs, Outputs)
{
	try
	{
		var BillingAccountId= Inputs.GetProperty(&quot;BillingAccountId&quot;);			

		var BillingAccountBO = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);	
		var BillingAccountBC = BillingAccountBO.GetBusComp(&quot;VF Billing Account&quot;);
		
		var psRow		= TheApplication().NewPropertySet();
		var psWFOutputs = TheApplication().NewPropertySet();
		var psWFInputs 	= TheApplication().NewPropertySet();
		var psRow		= TheApplication().NewPropertySet();
		var psTemp		= TheApplication().NewPropertySet();
		var psSiebMsg	= TheApplication().NewPropertySet();
		var bsVBC 		= TheApplication().GetService(&quot;VF Generic VBC Service&quot;);
		var MaxPaymentDueDatevar=0;		
		var sGSTInclusiveAmount=&quot;&quot;;
		var strTotalCost=&quot;&quot;;
		
		with(BillingAccountBC)
		{
			SetViewMode(AllView);
			ClearToQuery();		
			ActivateField(&quot;ARII&quot;);
			ActivateField(&quot;Organization&quot;);					
			SetSearchSpec(&quot;Id&quot;, BillingAccountId);	
			ExecuteQuery(ForwardOnly);						
			if(FirstRecord())
			{
				var strARII 			= GetFieldValue(&quot;ARII&quot;);				
				var strServiceProvider	= GetFieldValue(&quot;Organization&quot;);				
				
				psRow.SetProperty(&quot;ARII&quot;, strARII);
				psRow.SetProperty(&quot;User Key Country&quot;, strARII);
				psRow.SetProperty(&quot;Account Id&quot;, BillingAccountId);
				psRow.SetProperty(&quot;Account Organization Name&quot;, strServiceProvider);
				psWFInputs.AddChild(psRow);				
				
				psWFInputs.SetProperty(&quot;Transaction Name&quot;, &quot;VF Invoice Header Sync&quot;);
				psWFInputs.SetProperty(&quot;Transaction Type&quot;, &quot;VBC_QUERY&quot;);			
				bsVBC.InvokeMethod(&quot;RequestResponse&quot;, psWFInputs, psWFOutputs);
					
				for(var i=0; i &lt; psWFOutputs.GetChildCount(); i++)
				{    	    	
					psSiebMsg = psWFOutputs.GetChild(i);
					
					if(psSiebMsg.GetType() == &quot;SiebelMessage&quot;)
					{			    		
							var  ListOfVFInvoiceHeaderSync = psSiebMsg.GetChild(0);
							var sType = ListOfVFInvoiceHeaderSync.GetType();
							
							if (sType == &quot;ListOfVF Invoice Header Sync&quot;)
							{
								for(var j=0; j &lt; ListOfVFInvoiceHeaderSync.GetChildCount(); j++)
								{    	    	
									var FSInvoice = ListOfVFInvoiceHeaderSync.GetChild(j);
									var sType = FSInvoice.GetType();
									if (sType == &quot;FS Invoice&quot;)
									{
										var PaymentDueDate = FSInvoice.GetProperty(&quot;Payment Due Date&quot;);
										
										if(j==0)
										{
											sGSTInclusiveAmount = FSInvoice.GetProperty(&quot;GST Inclusive Amount&quot;);
											sGSTInclusiveAmount = TruncateAmount(sGSTInclusiveAmount);
											strTotalCost = sGSTInclusiveAmount.toString();
											if (strTotalCost.indexOf(&quot;.&quot;)==-1)
											{
												strTotalCost =&quot;$&quot;+strTotalCost+&quot;.00&quot;
											}
											else
											{											
												strTotalCost =&quot;$&quot;+strTotalCost;
											}
										}
										
										//throw(PaymentDueDate);
										if(PaymentDueDate!=null &amp;&amp; PaymentDueDate!=&quot;&quot;)
										{											
											var aDate = new Date(PaymentDueDate);
											var PaymentDueDateTS =aDate.getTime();
											if(ToNumber(PaymentDueDateTS)&gt;ToNumber(MaxPaymentDueDatevar))
											{
												MaxPaymentDueDatevar=PaymentDueDateTS;
												sGSTInclusiveAmount = FSInvoice.GetProperty(&quot;GST Inclusive Amount&quot;);
												sGSTInclusiveAmount = TruncateAmount(sGSTInclusiveAmount);
												strTotalCost = sGSTInclusiveAmount.toString();
												if (strTotalCost.indexOf(&quot;.&quot;)==-1)
												{
													strTotalCost =&quot;$&quot;+strTotalCost+&quot;.00&quot;;
												}
												else
												{											
													var strTotalCostArr = strTotalCost.split(&quot;.&quot;);
													if(strTotalCostArr[1].length==1)
													{
														strTotalCost =&quot;$&quot;+strTotalCost+&quot;0&quot;;
													}
													else
													{
														strTotalCost =&quot;$&quot;+strTotalCost;
													}
												}
												
											}
										}																		
										
									}					 
									 
									
								}					
								
								
							}					
						
					}    		
				}
				
			}
		}		
		
		Outputs.SetProperty(&quot;TotalCost&quot;,strTotalCost);
	}
	catch(e)
	{
		var sErrorMessage = e.toString();
		LogException(sErrorMessage,&quot;fGetLastMonthlyBill&quot;, BillingAccountId);
		//throw(e);			
	}
	finally
	{
		BillingAccountBC = null;		
		BillingAccountBO = null;	
				
	}
	return (CancelOperation);
}
"
			   SEQUENCE="1"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="04/29/2026 01:04:25"
			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fGetRewardValWithGST"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fGetRewardValWithGST(Inputs, Outputs)
{
	try
	{
		var RewardValue= Inputs.GetProperty(&quot;RewardValue&quot;);	
		var RewardValWithGST;
		
		RewardValWithGST = RewardValue*1.1;
		RewardValWithGST = RewardValWithGST.toFixed(2);

		Outputs.SetProperty(&quot;RewardValWithGST&quot;,RewardValWithGST);
	}
	catch(e)
	{
		var sErrorMessage = e.toString();
		LogException(sErrorMessage,&quot;fGetRewardValWithGST&quot;, RewardValue);
		//throw(e);			
	}
	finally
	{
				
	}
	return (CancelOperation);
}
"
			   SEQUENCE="2"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
