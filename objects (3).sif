			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidatePropositionAccountSegment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function ValidatePropositionAccountSegment(Inputs, Outputs)
{
	var sBO=null, sCatalogBC = null, sCategoryBC = null, sCategProductBC = null, bcLineItem = null, Frecord = null;
	var quoteId=&quot;&quot;, currSegment = &quot;&quot;, sPropoSAMId = &quot;&quot;, sPropoProdId = &quot;&quot;, searchst= &quot;&quot;, catlgRecord = null, AllowFlag=&quot;N&quot;;
	
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		currSegment = Inputs.GetProperty(&quot;Segment&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null &amp;&amp; currSegment != &quot;&quot; &amp;&amp; currSegment != null)
		{
			bcLineItem = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA MSP Order Line Item BC&quot;);
			with (bcLineItem)
			{
				SetViewMode(AllView);
				ActivateField(&quot;OrderQuoteId&quot;);
				ActivateField(&quot;ParOrdItemId&quot;);
				ActivateField(&quot;ActionCd&quot;);
				ActivateField(&quot;ProdSamId&quot;);
				ActivateField(&quot;ProdId&quot;);
				ClearToQuery();
				//Excluding Delete, - and Update. Change of segment for exst cust not allowed in SSJ sales.
				SetSearchExpr(&quot;[OrderQuoteId] = &apos;&quot; + quoteId + &quot;&apos; AND [ParOrdItemId] IS NULL AND [ActionCd] = &apos;Add&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				Frecord = FirstRecord();
				if(Frecord)
				{
					sBO = TheApplication().GetBusObject(&quot;VHA SSJ Catalog Admin&quot;);
					sCatalogBC = sBO.GetBusComp(&quot;Product Catalog Thin&quot;);
					sCategoryBC = sBO.GetBusComp(&quot;Catalog Category Admin Thin&quot;);
					sCategProductBC = sBO.GetBusComp(&quot;Internal Product Thin&quot;);
					while (Frecord)
					{
						sPropoProdId = GetFieldValue(&quot;ProdId&quot;);
						if(sPropoProdId != &quot;&quot; &amp;&amp; sPropoProdId != null)
						{
							with (sCatalogBC) 
							{
							    ClearToQuery();
							    SetViewMode(AllView);
							    ActivateField(&quot;Name&quot;);
							    SetSearchSpec(&quot;Name&quot;, &quot;VFAU Product Catalog&quot;);
							    ExecuteQuery(ForwardOnly);
							    if (FirstRecord()) 
								{
							        with (sCategoryBC) 
									{
							            ClearToQuery();
							            SetViewMode(AllView);
							            ActivateField(&quot;Name&quot;);
										if(currSegment == &quot;Consumer&quot;)
											searchst = &quot;[Name] = &apos;VFAU SSJ Consumer&apos;&quot;;
										else
											searchst = &quot;[Name] = &apos;VFAU SSJ Business&apos;&quot;;
							            SetSearchSpec(&quot;Name&quot;, searchst);
							            ExecuteQuery(ForwardOnly);
							            if (FirstRecord()) 
										{
							                with (sCategProductBC) 
											{
							                    ClearToQuery();
							                    SetViewMode(AllView);
							                    SetSearchSpec(&quot;Id&quot;, sPropoProdId);
							                    ExecuteQuery(ForwardOnly);
							                    if (FirstRecord()) 
												{
							                        AllowFlag = &quot;Y&quot;;
							                    }
												else
												{
													AllowFlag = &quot;N&quot;;
													break;
												}
							                } //with(sCategProductBC)
							            }
							        } //with(sCategoryBC)
							    }
							} //with(sCatalogBC)
						}
						Frecord = NextRecord();
					}//end of while root line item record
				}//end if root line item
			}//end of with (bcLineItem)
		}
		Outputs.SetProperty(&quot;AllowFlag&quot;, AllowFlag);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		quoteId=null;
		currSegment = null;
		sPropoSAMId = null;
		sPropoProdId = null;
		searchst= null;
		catlgRecord = null;
		AllowFlag=null;
		Frecord = null;
		sCategProductBC = null;
		sCategoryBC = null;
		sCatalogBC = null;
		bcLineItem = null;
		sBO=null;
	}
}"
			   SEQUENCE="23"
