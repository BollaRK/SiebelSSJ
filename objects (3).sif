			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateMPPContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateMPPContract(Inputs, Outputs)
{
	/* Component Name        : 	TBUI - mValidateMPPContract
	 * Component Information : 	This method is to validate whether the &quot;MPP Product&quot; is added to an order
	 * Modification History  :
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 30/05/2014	Neel 		Initial Draft Version - Cloned from VF Wizard Utilities with necessary changes to remove Wizard BO reference
	 */
	try
	{
	
		//Trace
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START: BS: VF TBUI Utilities. mValidateMPPContract&quot;);
		}
						
		//Declare Variable	
		var isRecord;
		var isOrderRecord;			
		var strError;
		var strRaiseError = &quot;N&quot;;
		
		var strFulfillmentOrderId = Inputs.GetProperty(&quot;FulfillmentOrderId&quot;);
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var strIsUpgrade = Inputs.GetProperty(&quot;IsUpgrade&quot;);
		//Added by Balaji for MPP validation
		var vfpMPPTot = Inputs.GetProperty(&quot;ContractAmount&quot;);
		var vCA = Inputs.GetProperty(&quot;MPPContractAmt&quot;);
		var vPreMPPAmt = Inputs.GetProperty(&quot;PrevMPPAmt&quot;);
		var vApprovedCLA = Inputs.GetProperty(&quot;ApproveContAmt&quot;);
		var vCompAmt = ToNumber(vfpMPPTot) + ToNumber(vCA) - ToNumber(vPreMPPAmt);
		Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;&quot;);
		//commented as part of Retrofit. Author: NEEL	
	/*	if (ToNumber(vCompAmt) &gt; ToNumber(vApprovedCLA))
			{
			vCompAmt = 0;
			Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;&lt;Total MPP Amount&gt; cannot exceed the &lt;Approved MPP Limit&gt;&quot;);
			}
	*/
	
		if (ToNumber(vCA) &gt; ToNumber(vApprovedCLA))
			{
			Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;Contract amount cannot exceed approved contract limit&quot;);
			}
		if (ToNumber(vCA) &lt; 0)
			{
			Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;The MPP Contract Amount cannot be less than or equal to Zero.&quot;);
			}
		
		//End Mpp Validation	
		//var sWarning = &quot;&lt;img src=&apos;images/icon_warning.gif&apos; ALIGN=&apos;ABSMIDDLE&apos; /&gt;&quot;;
		//var sColorStart = &quot;&lt;font color = red&gt;&quot;;
		//var sColorEnd = &quot;&lt;/font&gt;&quot;;
	
		//var bcSession = boCurrent.GetBusComp(&quot;VF Wizard Session&quot;);
		//var	bcDevice = boCurrent.GetBusComp(&quot;VF Device Details - Wizard&quot;);
		//var bcShipment = boCurrent.GetBusComp(&quot;FS Shipment&quot;);
			
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);			
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLineItems = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcDevice = boOrder.GetBusComp(&quot;VF Device Details - Wizard&quot;);
		var bcShipment = boOrder.GetBusComp(&quot;FS Shipment&quot;);
		var bcOrderItemXA;	
		
		var sShipTitle, sShipFirstName, sShipLastName, sShipEmail, sShipAddress;
							
		
		var sRCC = &quot;0&quot;;
		var nRCC = 0;

		// EW 11.D - Validate shipping details
		if (strFulfillmentOrderId != &quot;&quot;)
		{
			with (bcShipment)
			{
				sShipTitle = GetFieldValue(&quot;VF Ship To Contact Title&quot;);
				sShipFirstName = GetFieldValue(&quot;VF Ship To Contact First Name&quot;);
				sShipLastName = GetFieldValue(&quot;VF Ship To Contact Last Name&quot;);
				sShipEmail = GetFieldValue(&quot;VF Email Address&quot;);
				sShipAddress = GetFieldValue(&quot;Cal Full Address&quot;);
					
				if (sShipTitle == &quot;&quot; || sShipFirstName == &quot;&quot; || sShipLastName == &quot;&quot; || sShipEmail == &quot;&quot; || sShipAddress == &quot;&quot;)
				{
					return (&quot;All shipping fields are required.  Please enter a value for each of these fields&quot;);
				}
			}
		}
				
		if (bcDevice.FirstRecord())
		{
			sRCC = bcDevice.GetFieldValue(&quot;Upfront Cost&quot;);
		}
		else
		{
			//Added for IPhone 5 (Project Johny)
			sRCC = mGetDeviceRCC(strOrderId);
		}
		if (sRCC == &quot;N/A&quot;)
		{
			Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
			//return(&quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
		}
		else
		{
			nRCC = ToNumber(sRCC);
		}
		
		var sUpfrontPayment;
			
		if(strOrderId != &quot;&quot; &amp;&amp; (sRCC &gt; 0))
		{						
			
		//   var sPaymentOptions = strOrderId + &quot;Y&quot;;
      	//   var sIsDevicePrice = mGetDeviceRCC(strOrderId);
        //   var sIsUpfrontCost = mGetDeviceUpfrontCost(strOrderId);
						
			with (bcOrder)
			{
				ActivateField(&quot;VF Upfront Payment&quot;);
			    ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, strOrderId);
				SetViewMode(AllView);
				ExecuteQuery(ForwardOnly);
			
				isOrderRecord = bcOrder.FirstRecord();
			
				if (isOrderRecord)
				{
					sUpfrontPayment = GetFieldValue(&quot;VF Upfront Payment&quot;);	
				}
				
			}//End with									
			
			with(bcOrderLineItems)
			{
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Product&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+strOrderId+&quot;&apos; AND [Product] = &apos;MPP Contract&apos; AND [Action Code] = &apos;Add&apos; &quot;);
				ExecuteQuery(ForwardOnly);
			}//End with	
		
			isRecord = bcOrderLineItems.FirstRecord();			
			
			/* To determine in an MPP has been created we need to check whether
			1) An MPP line item exists on the order with an action code of Add 
			OR
			2) If a value exists VF Upfront Payment field (value = RCC)
			*/			
			
			if((isRecord) || (sUpfrontPayment == sRCC) || (sUpfrontPayment &gt; 0))
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;&quot;);
				//return (&quot;&quot;);
			}
			else
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;A MPP Contract is required.  Please process the payment options before continuing&quot;);
				//return (sWarning + sColorStart + &quot;A MPP Contract is required.  Please process the payment options before continuing.&quot; + sColorEnd);
			}
		} // End if
					
		
	} //End try
	catch(e)
	{
		throw e;
	}
	finally
	{ 
		bcOrderItemXA = null;
		bcOrder = null;
		bcOrderLineItems = null;
		bcDevice = null;
		bcShipment = null;
		boOrder = null;
	}
}"
			   SEQUENCE="43"
			   UPDATED="04/22/2026 01:45:57"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="06/10/2014 00:41:59"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateOrder(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateOrder
	* Method Name           : 	
	* Component Information : 	Validates Order specific logic
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 14/07/2011	Neel					Initial Version - Clone from VF Wizard Utitlies
	* 02/04/2019	Christy					Added for Unified Application
	*/
	
	var boOrder, bcOrder, bcOrderAttach, bcUpgradeOffer;
	
	var sOrderId, sOrderType, sMicroSIMConfirm, sMicroSIMRequired, sStockIndicator, sSubOrderType;
	var nDevicePrice, nMPPContractAmt;
	var sDevicePrice;
	var sFulfillmentOrder;
	
	try
	{
		// Initialise objects
		boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;)
		//bcWizardSession = boCurrent.GetBusComp(&quot;VF Wizard Session&quot;);
		bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		bcOrderAttach = boOrder.GetBusComp(&quot;Order Entry Attachment&quot;);
		
		sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);// Fetch Type of Order
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sFulfillmentOrder = Inputs.GetProperty(&quot;FulfillmentOrderId&quot;);
		
		// Check for upgrade orders that the Micro SIM confirmation has been ticked
		
		//if (bcWizardSession.GetFieldValue(&quot;Upgrade Fulfillment Order Exists?&quot;) == &quot;Y&quot;)
		//Uma:17/jul/2014:Commenting below code as it should be called for Postpay upgrade 
		/*if(sFulfillmentOrder != &quot;&quot; &amp;&amp; sFulfillmentOrder != null)
		{
			bcUpgradeOffer = boOrder.GetBusComp(&quot;VF Upgrade Offer&quot;);
			sMicroSIMConfirm = bcUpgradeOffer.GetFieldValue(&quot;Micro SIM Issued Confirmation&quot;);
			sMicroSIMRequired = bcUpgradeOffer.GetFieldValue(&quot;Micro SIM Required?&quot;);
			
			if (sMicroSIMRequired == &quot;Y&quot; &amp;&amp; (sMicroSIMConfirm == &quot;N&quot; || sMicroSIMConfirm == &quot;&quot;))
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;Please confirm that you have provided the customer with a blank micro SIM (if required)&quot;);
			}
		}*/
		
		
		with(bcOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if(FirstRecord())
			{
				
				//NEEL 12/09/2014 - Added for Application Check - Generate Contract Not Required for Core. QC2465
				//var sAppName = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
				//if(sAppName == &quot;Siebel Power Communications&quot;)
				//02/04/2019: Christy :Modified for unified application
				var sAppName = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
				//if(sAppName == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
				var sAllowFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ALLOW_GEN_CONTRACT&quot;, sAppName);
				if(sAllowFlg == &quot;Y&quot;)
				{
					//Do Nothing
				}
				else
				{
				
					// Check that the contract has been generated and opened
					with (bcOrderAttach)
					{
						ClearToQuery();
						ActivateField(&quot;OrderComments&quot;);
						SetSortSpec(&quot;Created (DESC)&quot;);
						//if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PDF_GENERATION&quot;,&quot;Enable&quot;) == &quot;Y&quot;) // Author NEEL, added for breakfix
						//SetSearchSpec(&quot;OrderFileExt&quot;,&quot;pdf&quot;);
						ExecuteQuery(ForwardOnly);
			
						if (FirstRecord())
						{
							TheApplication().Trace(&quot;Utility BS : Sort First Record&quot;);
							if (GetFieldValue(&quot;OrderComments&quot;) == &quot;&quot;)
							{
								if (sOrderType == &quot;Upgrade&quot;)
								{
									Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have generated the upgrade letter, but not opened the file.  Please click the link below the &apos;Generate Upgrade Letter&apos; button first.&quot;);
									//return (&quot;You have generated the upgrade letter, but not opened the file.  Please click the link below the &apos;Generate Upgrade Letter&apos; button first.&quot;);
								}
								else
								{
									TheApplication().Trace(&quot;Utility BS : Above Error MSG Record&quot;);
									Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have generated the contract, but not opened the file.  Please click the link below the &apos;Generate Contract&apos; button first&quot;);
									//return (&quot;You have generated the contract, but not opened the file.  Please click the link below the &apos;Generate Contract&apos; button first.&quot;);
								}				
							}
						}
						else
						{
							if (sOrderType == &quot;Upgrade&quot;)
							{
								Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have not generated the upgrade letter.  Please click the &apos;Generate Upgrade Letter&apos; button first.&quot;);
								//return (&quot;You have not generated the upgrade letter.  Please click the &apos;Generate Upgrade Letter&apos; button first. &quot;);
							}
							else
							{
								Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have not generated the contract.  Please click the &apos;Generate Contract&apos; button first.&quot;);
								//return (&quot;You have not generated the contract.  Please click the &apos;Generate Contract&apos; button first. &quot;);
							}
						}
					}
				}// End of Application Check
				
				
						
				// For out of stock, check that the RCC is the same as the device price for non-Fulfilment Orders - JW R14.1 SIT QC442
				sStockIndicator = GetFieldValue(&quot;VF Out of Stock Indicator&quot;);
				sSubOrderType = GetFieldValue(&quot;Order Sub Type&quot;);		
				if((sStockIndicator == &quot;Out of Stock - Connect Later&quot; || sStockIndicator == &quot;Out of Stock - Connect Now&quot;) &amp;&amp; (sSubOrderType != &quot;Fulfilment&quot;))
				{
					sDevicePrice = bcOrder.mGetDeviceRCC(sOrderId);
					
					if (sDevicePrice == &quot;N/A&quot;)
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
						//return (&quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
					}
					else
					{
						nDevicePrice = ToNumber(sDevicePrice); 	//JW note this could return NaN;
					}			
					nMPPContractAmt = bcOrder.mGetMPPContractAmount(sOrderId);
		        			
					// throw error if MPP Contract is not matching the Device RCC value
					if(nDevicePrice != nMPPContractAmt)
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;MPP Contract amount is not matching the Device RCC amount. Please revisit the Order configuration&quot;);
						//return (&quot;MPP Contract amount is not matching the Device RCC amount. Please revisit the Order configuration&quot;);
					}
				}
			}
			else
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;Order Not Present in system&quot;);
			}
		}//End of if(FirstRecord())
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcOrderAttach = null;
		bcOrder = null;	
		boOrder = null;
		
	}
}"
			   SEQUENCE="44"
			   UPDATED="04/22/2026 01:45:57"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="06/10/2014 00:41:59"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidatePhoneNumber"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidatePhoneNumber(strNumber,strFieldName,sUniSIMFlg)
{
	/*
	 * Component Name        : 	mValidateContactDetail
	 * Method Name           : 	
	 * Component Information : 	This function validates all fields entered
	 *							correct 
	 *
	 * Modification History  :
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 10/06/2014	Neel					Validating Phone Number
	 * 02/06/2015	Nirmal					PKE000000023434 : Phone number can only start with 
	 *										612, 613, 614, 617 or 618 and number of digits must be 11
	 */
	try
	{
			if(gCustType == &quot;Person&quot;)
			{
				if(strNumber.length != 11)
					TheApplication().RaiseErrorText(&quot;Contact Number should be 11 digits&quot;);
				if (isNaN(strNumber))
					TheApplication().RaiseErrorText(&quot;Contact Number  must be numeric&quot;);
				//if(strNumber.indexOf(&quot;614&quot;) != 0)
					//TheApplication().RaiseErrorText(&quot;Contact Number must start with 614&quot;);
			}
            // Check there are no spaces
			if (strNumber.indexOf(&quot; &quot;) &gt; 0)
			{
				
				if(strFieldName == &quot;Home Phone&quot;)
					throw (&quot;Contact Number must be entered with no spaces.&quot;);
				else				
				  throw (strFieldName + &quot; must be entered with no spaces.&quot;);
			}

			// Check there are no brackets
			if ((strNumber.indexOf(&quot;(&quot;) &gt; 0) || (strNumber.indexOf(&quot;)&quot;) &gt; 0))
			{
				if(strFieldName == &quot;Home Phone&quot;)
					throw (&quot;Contact Number must be entered with no brackets.&quot;);
				else
					throw (strFieldName + &quot; must be entered with no brackets.&quot;);
			}

			// Check the total length is 11  : 02/06/2015 Nirmal PKE000000023434
			if (sUniSIMFlg == &quot;Y&quot;) // Added for SIT defect 1043
			{
				if (strNumber != &quot;&quot; &amp;&amp; strNumber.length != 11)
				{
				if(strFieldName == &quot;Home Phone&quot;)
				throw (&quot;Contact Number  must be 11 characters long.&quot;); //02/06/2015 Nirmal Edited for PKE000000023434
				else
				throw (strFieldName + &quot; must be 11 characters long.&quot;); //02/06/2015 Nirmal Edited for PKE000000023434
				}
			}
			else
			{
				if (strNumber.length != 11)
				{
					if(strFieldName == &quot;Home Phone&quot;)
						throw (&quot;Contact Number  must be 11 characters long.&quot;); //02/06/2015 Nirmal Edited for PKE000000023434
					else
						throw (strFieldName + &quot; must be 11 characters long.&quot;); //02/06/2015 Nirmal Edited for PKE000000023434
				}
			}
			
			// Check phone number is numeric
			if (isNaN(strNumber))
			{
				if(strFieldName == &quot;Home Phone&quot;)
					throw (&quot;Contact Number  must be numeric&quot;);
				else
					throw (strFieldName + &quot; must be numeric&quot;);
			}
			
			
			//Now validate to see if it&apos;s correct
			//Subramanian 10.11.2014 - Added &quot;02&quot; Validation
			//01/12/2014 RR: SPS: Changed the error message from Home Phone Number to Contact Number.
			var sPrepaySkipNum = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_PREPAY_NUM_SKIP&quot;, &quot;PREPAY_NUM_SKIP&quot;);
			if((sUniSIMFlg == &quot;Y&quot; &amp;&amp; strNumber != sPrepaySkipNum) || (sUniSIMFlg != &quot;Y&quot;))
			 {				
					if (strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;Home Phone&quot;)
		           	{	                      
			           if( strNumber.indexOf(&quot;612&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;613&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;614&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;617&quot;) != 0 &amp;&amp;
			                                               strNumber.indexOf(&quot;618&quot;) != 0 ) /*&amp;&amp; strNumber.indexOf(&quot;04&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;02&quot;) != 0 &amp;&amp; 
			                                               strNumber.indexOf(&quot;6118&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;6113&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;1800&quot;) != 0 &amp;&amp;  
			                                               strNumber.indexOf(&quot;13&quot;) != 0)*/ //02/06/2015 Nirmal Commented unnecessary checks for PKE000000023434
			           { 
								throw(&quot;Contact Number must be starting with digits 612, 613, 614, 617 or 618&quot;); //02/06/2015 Nirmal Edited for PKE000000023434
					   }
		                         
		           	}//end of if (strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;HomePhone&quot;)
		           	//Subramanian 10.11.2014 - Added &quot;02&quot; Validation
		           	else if(strNumber != &quot;&quot; &amp;&amp; strFieldName == &quot;Work Phone&quot;)
		           	{
		           		if( strNumber.indexOf(&quot;612&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;613&quot;) != 0 &amp;&amp;   strNumber.indexOf(&quot;614&quot;) != 0  &amp;&amp;  strNumber.indexOf(&quot;617&quot;) != 0 &amp;&amp;
			                                                strNumber.indexOf(&quot;618&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;6118&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;6113&quot;) != 0 &amp;&amp;
			                                                strNumber.indexOf(&quot;1800&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;13&quot;) != 0 &amp;&amp;  strNumber.indexOf(&quot;04&quot;) != 0 &amp;&amp; strNumber.indexOf(&quot;02&quot;) != 0)
						{ 
							throw(strFieldName + &quot; must be starting with digits 1800, 13, 02, 04, 612, 613, 614, 617, 618 , 6118 or 6113 for Work phone&quot;);
						}
		          	}
			 }//Nagesh
    }
	catch(e)
    {
     	throw(e);
    }
}"
			   SEQUENCE="45"
			   UPDATED="04/22/2026 01:45:57"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="06/11/2014 00:56:09"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateServiceDetails (Inputs, Outputs)
{
try
{
	/* Component Name        : 	TBUI - mValidateServiceDetails
		* Component Information : 	This method is to validate whether the &quot;MPP Product&quot; is added to an order
		* Modification History  :
		* Date			Author		Config #	Description
		* ============ ===========	===========	================================
		* 08/05/2014	MuralidharanK 		Initial Draft Version - For Validate Service Details
		* 20/8/2014     Muralidharank       Added for Service Details for DeAllocate IMEI
		* 21/08/2014    MuralidharanK		Removed Customize Logic validation for Account Level Proposition
		* 12/11/2014 	Neel				Inavlid combination of OOS/ConnectionType/PortIn
		*/
	var strmsisdn,strsim,strportin,strstockindicator,strimei,strPortindob,strportinserno,strportinserac,strorderid,strstockindicator,strAccId,strhandsetcode,strhandsetid,strhandset,strbillingact,strconnectiontype,strordersubtype,strProposition,strErrorMsg,blnValidCJPortinMSISDN,strHandset,strvalidcustomized,vOLICustomised,strvROrderId;
	var strReservationId;
	var sINVALID_COMBI;
	var sPROP_ERR_MSG    = &quot;A Proposition is required. Please enter a value for this field.&quot;
	var sMSISDN_ERR_MSG  = &quot;A MSISDN is required. Please enter a value for this field.&quot;
	var sIMEI_ERR_MSG    = &quot;An IMEI is required. Please enter a value for this field.&quot;
	var sSIM_ERR_MSG     = &quot;A SIM is required. Please enter a value for this field.&quot;
	var sBA_ERR_MSG      = &quot;A Billing Account is required. Please enter a value for this field.&quot;
	var sACC_NUM_ERR_MSG = &quot;An Account Reference # is required. Please enter a value for this field.&quot;
	var sDOB_ERR_MSG     = &quot;A Date of Birth is required. Please enter a value for this field.&quot;	
	var sHANDSET_ERR_MSG = &quot;A Handset Make and Model is required. Please enter a value for this field.&quot;;
	var sPLAN_CHECK_MSG  = &quot;Please make sure you have clicked on the Customize button&quot;;
	var sCONN_TYPE_ERR_MSG    = &quot;Please Select the Connection Type&quot;;
	var sSTOCK_IND_ERR_MSG    = &quot;Please Select the Stock Indicator&quot;;
	var sMSISDN_SOURCE_ERR_MSG = &quot;Please Select the MSISDN Source&quot;;
	var sDEALLOCATE_IMEI =	&quot;Please Deallocate IMEI to proceed with order.&quot;;
	var sCONN_TYPE_ERR_MSG_DEVICE    = &quot;Please Select the Connection Type as Plan and Device&quot;;
	var sINVALID_COMBI    = &quot;Port In options are not available for Out Of Stock - Connect Later&quot;;//Neel 30.10.2014 - PortIn / Out Of Stock
	strvROrderId = Inputs.GetProperty(&quot;RootOrderItemId&quot;);
	strconnectiontype = Inputs.GetProperty(&quot;VF ConnectionType&quot;)
	strmsisdn = Inputs.GetProperty(&quot;MSISDN&quot;);
	strsim = 	Inputs.GetProperty(&quot;SIM&quot;);
	strReservationId = Inputs.GetProperty(&quot;Reservation Id&quot;);
	strportin = Inputs.GetProperty(&quot;VF Port In TBUI&quot;);
	strimei = Inputs.GetProperty(&quot;VF IMEI TBUI&quot;);
	strPortindob = 	Inputs.GetProperty(&quot;VF Port In DOB&quot;);
	strportinserno = Inputs.GetProperty(&quot;VF Port In MSISDN&quot;);
	strportinserac = Inputs.GetProperty(&quot;VF Port In ServiceAccount&quot;);
	strorderid = Inputs.GetProperty(&quot;Order Header Id&quot;);
	strAccId = Inputs.GetProperty(&quot;Account Id&quot;);
	strstockindicator = Inputs.GetProperty(&quot;VF Stock Indicator TBUI&quot;);
	strbillingact=Inputs.GetProperty(&quot;BillAccId&quot;);
	strProposition=Inputs.GetProperty(&quot;Product&quot;);
	strordersubtype = Inputs.GetProperty(&quot;OrderTypeTBUI&quot;);
	strHandset = Inputs.GetProperty(&quot;VF Device TBUI&quot;);
	var strPortInPrepay = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;Port In - Prepay&quot;);
	var strPortInPostpay = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;Port In - Postpay&quot;);
	var strNewNumber = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;New&quot;);
	var sCJ_SERVICE_NOT_FOUND = &quot;The MSISDN entered to be ported in does not exist in the CJ MSISDN List. Please check and re-enter the correct CJ&apos;s MSISDN.&quot;;
	var sErrMsg =&quot;&quot;;
	var sRaiseError=&quot;N&quot;;
	
	if(((strconnectiontype == &quot;&quot;) || (strconnectiontype == null)))
	
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;,sCONN_TYPE_ERR_MSG);
		TheApplication().RaiseErrorText(sCONN_TYPE_ERR_MSG);
	}
	
	
	if(((strstockindicator == &quot;&quot;) || (strstockindicator == null)))
	
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;,sSTOCK_IND_ERR_MSG);
		TheApplication().RaiseErrorText(sSTOCK_IND_ERR_MSG);
	}
	
	if(((strportin == &quot;&quot;) || (strportin == null)))
	
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_SOURCE_ERR_MSG);
		TheApplication().RaiseErrorText(sMSISDN_SOURCE_ERR_MSG);
	}
	
	if(strstockindicator != &quot;In Stock&quot;)//Neel 06.11.2014 Check for Invalid Combination
		if(strportin != &quot;No&quot;)
			{
				sINVALID_COMBI = strportin+&quot; AND &quot;+ strstockindicator+&quot; is not a valid combination.&quot;;
				Outputs.SetProperty(&quot;ErrMsg&quot;,sINVALID_COMBI);
				TheApplication().RaiseErrorText(sINVALID_COMBI);
			}
			
	if(strconnectiontype == &quot;Account Level Proposition&quot;)// Neel 12.11.2104 - Check for Invalid Combination
		if(strportin != &quot;No&quot;)
			{
				sINVALID_COMBI = strportin+&quot; is not allowed with &quot;+ strconnectiontype+&quot; .&quot;;
				Outputs.SetProperty(&quot;ErrMsg&quot;,sINVALID_COMBI);
				TheApplication().RaiseErrorText(sINVALID_COMBI);
			}
	
	
	switch (strconnectiontype)
		{			
			//Check for required fields based on the Connection Type.
			case &quot;Plan and Device&quot;:	
				if (strstockindicator == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;In Stock&quot;))
				{
					if (strimei == &quot;&quot; &amp;&amp; strReservationId==&quot;&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sIMEI_ERR_MSG);
						TheApplication().RaiseErrorText(sIMEI_ERR_MSG);
	
					}
				}
				else
				{
					if (strHandset == &quot;&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sHANDSET_ERR_MSG);
						TheApplication().RaiseErrorText(sHANDSET_ERR_MSG);
						sRaiseError = &quot;Y&quot;;
					}
				}
				
				if (strbillingact == &quot;&quot;)
				{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sBA_ERR_MSG);
						TheApplication().RaiseErrorText(sBA_ERR_MSG);
						sRaiseError = &quot;Y&quot;;
				}
				
				if (strstockindicator != TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;))
				{
					if (strsim == &quot;&quot; &amp;&amp; strReservationId==&quot;&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sSIM_ERR_MSG);
						TheApplication().RaiseErrorText(sSIM_ERR_MSG);
						sRaiseError = &quot;Y&quot;;	
					}
				}
				if(strNewNumber == strportin)
				{
						if ((strmsisdn == &quot;&quot;) || (strmsisdn == null))
						{
						   Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   TheApplication().RaiseErrorText(sMSISDN_ERR_MSG);
						   sRaiseError = &quot;Y&quot;;
						}
				
				}	
				else
				{
						if ((strportinserno == &quot;&quot;) || (strportinserno == null))
						{
						   Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   TheApplication().RaiseErrorText(sMSISDN_ERR_MSG);
						   sRaiseError = &quot;Y&quot;;
						}
				}
					
				break;
				
				
			case &quot;SIM Only&quot;:
				if (strbillingact == &quot;&quot;)
				{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sBA_ERR_MSG);
						TheApplication().RaiseErrorText(sBA_ERR_MSG);
						sRaiseError = &quot;Y&quot;;
				}
				
				if((strimei != &quot;&quot;) &amp;&amp; (strimei != null))
				{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sDEALLOCATE_IMEI);
						TheApplication().RaiseErrorText(sDEALLOCATE_IMEI);
						sRaiseError = &quot;Y&quot;;
				
				}
				/*if (strstockindicator != TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;In Stock&quot;))  // 9/9/2014:Added for CR TBUI
				{
				if (strHandset == &quot;&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sHANDSET_ERR_MSG);
						TheApplication().RaiseErrorText(sHANDSET_ERR_MSG);
						sRaiseError = &quot;Y&quot;;
					}
				}*/
				
				if (strstockindicator != TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;))
				{
					if (strsim == &quot;&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,sSIM_ERR_MSG);
						TheApplication().RaiseErrorText(sSIM_ERR_MSG);
						sRaiseError = &quot;Y&quot;;	
		
					}
				}
				if(strNewNumber == strportin)
				{
						if ((strmsisdn == &quot;&quot;) || (strmsisdn == null))
						{
						   Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   TheApplication().RaiseErrorText(sMSISDN_ERR_MSG);
						   sRaiseError = &quot;Y&quot;;
						}
				
				}	
				else
				{
						if ((strportinserno == &quot;&quot;) || (strportinserno == null))
						{
						   Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   TheApplication().RaiseErrorText(sMSISDN_ERR_MSG);
						   sRaiseError = &quot;Y&quot;;
						}
				}
				
											
				break;	
		}
		
				//A Proposition is always requried
		if (strProposition == &quot;&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;,sPROP_ERR_MSG);
			TheApplication().RaiseErrorText(sPROP_ERR_MSG);
			sRaiseError = &quot;Y&quot;;
		}	
		
		
		//If a Port In check required fields
		if (strordersubtype == &quot;New Connection&quot; &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;New&quot;) != strportin)
		{
			//Prepay
			if(strPortInPrepay == strportin &amp;&amp; strPortindob == &quot;&quot;)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,sDOB_ERR_MSG);
				TheApplication().RaiseErrorText(sDOB_ERR_MSG);
				sRaiseError = &quot;Y&quot;;
			}
			//Postpay
			else if(strPortInPostpay == strportin &amp;&amp; strportinserac == &quot;&quot;)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,sACC_NUM_ERR_MSG);
				TheApplication().RaiseErrorText(sACC_NUM_ERR_MSG);
				sRaiseError = &quot;Y&quot;;

			}
		}
		

	if (((strProposition != &quot;&quot;) &amp;&amp; (strProposition != null)) &amp;&amp; (strconnectiontype != &quot;Account Level Proposition&quot;))
		{
			var psInputs = TheApplication().NewPropertySet();
			var psOutputs = TheApplication().NewPropertySet();
			var bscustomize = TheApplication().GetService(&quot;VHA Interactive Service&quot;);
		
		
				psInputs.SetProperty(&quot;Order Id&quot;, strorderid);
				bscustomize.InvokeMethod(&quot;CheckInitialisedAttribute&quot;,psInputs, psOutputs);
				vOLICustomised = psOutputs.GetProperty(&quot;Initialised&quot;);
		
			/*	psInputs.SetProperty(&quot;vOrderId&quot;, strorderid);
				psInputs.SetProperty(&quot;vROrderId&quot;, strvROrderId);
				bscustomize.InvokeMethod(&quot;CheckOLICustomised&quot;, psInputs, psOutputs);
				vOLICustomised = psOutputs.GetProperty(&quot;vOLICustomised&quot;);*/ // Commented for 2415
			
			if(vOLICustomised == &quot;N&quot;)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,sPLAN_CHECK_MSG);
				TheApplication().RaiseErrorText(sPLAN_CHECK_MSG);
				sRaiseError = &quot;Y&quot;;
			}
			
			
			//MURALIDHARANK 28/10/2014 INC000010663275 To Check Connection Type for IMEI Mandatory Check 
				
		if(strconnectiontype == &quot;SIM Only&quot;)
		{
			var bcRootLineItembo = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var bcorder = bcRootLineItembo.GetBusComp(&quot;Order Entry - Orders&quot;);
			var bcRootLineItem = bcRootLineItembo.GetBusComp(&quot;VF Order Entry - Line Items - Primary Product - TBUI&quot;);
			var strIMEIReqFlg = &quot;&quot;;
			with(bcorder)
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;,strorderid);
				ExecuteQuery();					
				if (FirstRecord())
				{	
					with(bcRootLineItem)
					{
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;VF IMEI Mandatory Flg&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Order Header Id&quot;,strorderid);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							strIMEIReqFlg=GetFieldValue(&quot;VF IMEI Mandatory Flg&quot;);
						}
					}	
					if(strIMEIReqFlg ==&quot;Y&quot;)
					{
								Outputs.SetProperty(&quot;ErrMsg&quot;,sCONN_TYPE_ERR_MSG_DEVICE);
								TheApplication().RaiseErrorText(sCONN_TYPE_ERR_MSG_DEVICE);
								sRaiseError = &quot;Y&quot;;
					}	
				}
				
			}	
		  }		
			//MURALIDHARANK 28/10/2014 INC000010663275 To Check Connection Type for IMEI Mandatory Check	
			
		}
	psInputs=null;
	psOutputs=null;
	bscustomize=null;
		
		
	//Perform Credit Check Validation
	var psInputs = TheApplication().NewPropertySet();
	var psOutputs = TheApplication().NewPropertySet();
	var bscustomize = TheApplication().GetService(&quot;VF OM Order Validation&quot;);
	psInputs.SetProperty(&quot;OrderId&quot;, strorderid);
	psInputs.SetProperty(&quot;CustomerAcountId&quot;, strAccId);
	bscustomize.InvokeMethod(&quot;CheckCreditCheckStatus&quot;,psInputs, psOutputs);
	
	psInputs=null;
	psOutputs=null;
	bscustomize=null;
	//END	

}	
	catch (e)
	{
		throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
		
		/*bcorder = null;
		bcRootLineItem = null;
		bcRootLineItembo = null;*/

	/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
		if(defined(bcorder)) { bcorder = null; }
		if(defined(bcRootLineItem)) { bcRootLineItem = null; }
		if(defined(bcRootLineItembo)) { bcRootLineItembo = null; }

	}
}"
