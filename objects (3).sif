			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckProductRatePlan"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckProductRatePlan(Inputs,Outputs)
{
   try {
	var sErrorMsg = &quot;&quot;;
	var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
	var psInputs = TheApplication().NewPropertySet();
	var psOutputs = TheApplication().NewPropertySet();
	var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;); 
	//var sExistingCustomer = Inputs.GetProperty(&quot;ExistingCustomer&quot;);//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
	var sAppVcherLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Voucher Plan Check&quot;);//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
	var sAppleVoucher = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Plan&quot;);//ADUTTA:Apple Fraud Strategic Solution Issue
	var sTransType = Inputs.GetProperty(&quot;TransactionType&quot;);//Visa
	var aAccId = Inputs.GetProperty(&quot;CustId&quot;);//Visa
	var VisaSkipResp = Inputs.GetProperty(&quot;VisaCheckResp&quot;);//Visa
	var i = 0;
	var propostionName;
	var planSAMId = &quot;&quot;;//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
	var sAppleErrorMsg = &quot;&quot;;//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
	psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Order Entry - Line Items Thin - PCRF.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Order Entry - Line Items Thin - PCRF.Parent Order Item Id] IS NULL&quot;);
	psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Entry - Line Items Thin - Primary Product&quot;);
	bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
	var sParentType = psOutputs.GetChild(0).GetChild(0).GetType();
	if (sParentType == &quot;ListOfVF Order Entry - Line Items Thin - Primary Product&quot;) {
		var iNoOfParent = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		while (i &lt; iNoOfParent) {
			var NoOfChild = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount();
			var ProductType = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product Type&quot;);
			var strLineNumber = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Line Number&quot;); //VHA 17.3/PKE/NIRMAL/27APR2017/Added for PKE000000043605.
			var strActionCode = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Action Code&quot;); //VHA 17.3/PKE/NIRMAL/27APR2017/Added for PKE000000043605. Also added the check for the variable in condition below
			//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
			if(sAppVcherLOV == &quot;Y&quot;)
			{
				planSAMId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;Sam Id&quot;); 
				var sSAMLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPLE_VOUCR_PLN_ID&quot;,planSAMId);
				if(sSAMLOV == &quot;Y&quot;)
				{
				   Outputs.SetProperty(&quot;AppleVoucher&quot;,&quot;Y&quot;);//ANGANA Apple Fraud issue Strategic Solution
					mCheckCreditClass(Inputs,Outputs);
					if(Outputs.GetProperty(&quot;AppleVcherVal&quot;)==&quot;FraudCClass&quot;)
					{
						sAppleErrorMsg = &quot;Line#&quot;+strLineNumber+&quot;-&quot;+TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_APPLE_VOUCHER_FRAUD&quot;);
					}
				}
			}
			//TULASIY:05-07-2023::Code Ends

			//ADUTTA Apple Fraud Issue Strategic Solution
			if(sAppleVoucher == &quot;Y&quot;)
			{
			planSAMId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(0).GetProperty(&quot;Sam Id&quot;); 
				var sSAMLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPLE_VOUCR_PLN_ID&quot;,planSAMId);
				if(sSAMLOV == &quot;Y&quot;)
				{
				   Outputs.SetProperty(&quot;AppleVoucher&quot;,&quot;Y&quot;);//ANGANA Apple Fraud issue Strategic Solution
				}

			}
				  	//ADUTTA Apple Fraud Issue Strategic Solution: Code Ends
			if (NoOfChild == 0 &amp;&amp; ProductType != &quot;Account Proposition&quot; &amp;&amp; ProductType != &quot;Promotion&quot; &amp;&amp; strActionCode!= &quot;Delete&quot;) {//Kailash Added promotion validation - PKE38339
				propostionName = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;);
					//var k=i+1;  //VHA 17.3/PKE/NIRMAL/27APR2017/Commented for PKE000000043605. Repalce this variable with strLineNumber in code below 
					if (sErrorMsg == &quot;&quot;)				
					sErrorMsg = &quot;Line#&quot;+strLineNumber+&quot; &quot;+propostionName;				
					else					
					sErrorMsg = sErrorMsg + &quot; , Line#&quot;+strLineNumber+&quot; &quot;+propostionName;
			}		
			i++;
		}
	}
	if (sErrorMsg != &quot;&quot;) {	 
	Outputs.SetProperty(&quot;ProductErrMsg&quot;,&quot;Please Select Customise and choose a rate plan for the following proposition(s) &quot; + sErrorMsg + &quot; to proceed further.&quot;)
	}
	//TULASIY:05-07-2023::Apple Voucher-Fraud Issue
	else if(sAppleErrorMsg != &quot;&quot;)
	{
	Outputs.SetProperty(&quot;ProductErrMsg&quot;,sAppleErrorMsg);
	}//Apple Voucher Ends
	//Proj:Visa Changes-03April2023-Start
	else if(VisaSkipResp != &quot;Y&quot;)
	{
		var psIn = TheApplication().NewPropertySet();			
		var psOut = TheApplication().NewPropertySet();
		var sBS = TheApplication().GetService(&quot;VHA Store Pickup Reservation Service&quot;);			
		psIn.SetProperty(&quot;Order Id&quot;,sOrderId);	
		//psIn.SetProperty(&quot;Term&quot;,sTerm);	
		psIn.SetProperty(&quot;TransactionType&quot;,sTransType);							
		psIn.SetProperty(&quot;CustId&quot;,aAccId);
		sBS.InvokeMethod(&quot;GetVisaExpiryDate&quot;,psIn,psOut);				
		sErrMsg = psOut.GetProperty(&quot;Error Message&quot;);
		Outputs.SetProperty(&quot;ProductErrMsg&quot;, sErrMsg);																
	}
	//Proj:Visa Changes-03April2023-Start			
	else
	{
    	Outputs.SetProperty(&quot;ProductErrMsg&quot;, &quot;&quot;);

	}
}
catch (e) {
	//Outputs.SetProperty(&quot;ProductErrMsg&quot;, e);
}
 finally{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	 bsEAIService = null;
	 psInputs = null;
	 psOutputs = null;

 }
 }"
