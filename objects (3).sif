			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeletePrepayment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Kalidas:18/07/2019:Code added to delete prepayment record in case of prepayment amount is zero
function mDeletePrepayment(Inputs,Outputs)
{
 	var sUpfrontAmt = Inputs.GetProperty(&quot;Prepayment Amount&quot;);
	var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
	if(ToNumber(sUpfrontAmt) &lt; 1)
	{
		var sBO = TheApplication().GetBusObject(&quot;VHA Prepayment Processing BO&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		with(sBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
			DeleteRecord();
			} 
		}
	}
}  
"
