			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetLOVDesc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetLOVDesc(Inputs, Outputs)
{
	try
	{	    	
		        var Type = Inputs.GetProperty(&quot;Type&quot;);
				var Desc = Inputs.GetProperty(&quot;Desc&quot;);
				
				var DisplayName = &quot;&quot;;
				var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
				var  bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
				with(bcLOV)
				{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;Value&quot;);			
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Description&quot;);
				SetSearchSpec(&quot;Type&quot;,Type);	
				SetSearchSpec(&quot;Description&quot;,Desc);	
				ExecuteQuery(ForwardOnly)
			
					if(FirstRecord())
					{
			
					DisplayName = GetFieldValue(&quot;Value&quot;);
					}
				}//with bcLOV
				
				Outputs.SetProperty(&quot;Value&quot;,DisplayName);
	}

	catch (e)
	{
		throw (e);
	}

	finally
	{
		bcLOV = boLOV = null;
	}
}"
			   SEQUENCE="2"
			   UPDATED="05/19/2019 20:19:56"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 20:19:56"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	try
	{	 
		switch(MethodName)
		{
			case &quot;DeleteeSIM&quot;:
			mDeleteeSIM(Inputs,Outputs);
			break;
			
			case &quot;AttachQRCode&quot;:
			mAttachQRCode(Inputs,Outputs);
			break;
			
			case &quot;PurgeQRCodes&quot;:  //Sachi - 12/12/2018 - Added for R19.1 for Atom Phase 2
			mPurgeQRCodes(Inputs,Outputs);
			break;
			
			case &quot;PurgeQRCodes_ConnectNative&quot;:  //Sachi - 12/12/2018 - Added for R19.1 for Atom Phase 2
			mPurgeQRCodes_ConnectNative(Inputs,Outputs);
			break;
			
			case &quot;DeallocateeSIM&quot;:
			mDeallocateeSIM(Inputs,Outputs);
			break;
			
			case &quot;CheckNoOfImports&quot;: //Sachi - 16/12/2018 - Added for R19.1 for Atom Phase 2
			mCheckNoOfImports(Inputs,Outputs);
			break;
			
			case &quot;DeleteQRCode&quot;:
			mDeleteQRCode(Inputs,Outputs);
			break;
			
			case &quot;GetESIMPlanName&quot;:
			mGetESIMPlanName(Inputs,Outputs);
			break;
			case &quot;eSIMValidation&quot;: //Sachi - 01/03/2019-Added for R19.1 Atom Phase2
			meSIMValidation(Inputs,Outputs);
			break;
			
			case &quot;ClearSIMDetails&quot;: //Sachi - 01/03/2019-Added for R19.1 Atom Phase2
			mClearSIMDetails(Inputs,Outputs);
			break;
			
			case &quot;CancelUpgradeSIMSwap&quot;:
			mCancelUpgradeSIMSwap(Inputs,Outputs);
			break;
			
			//Vinodhini-24/12/2018-Added for Atom Phase2
			case &quot;GetLOVDesc&quot;:
			GetLOVDesc(Inputs, Outputs);
			break;
			
			//Vinodhini-28/12/2018-Added for Atom Phase2
			case &quot;SetConfirmationCode&quot;:
			mSetConfirmationCode(Inputs,Outputs);
			break;
			
			case &quot;GetSIMAttributes&quot;:
			mGetSIMAttributes(Inputs,Outputs);
			break;
			
			case &quot;ValidateBulkeSIMDetails&quot;:
			mValidateBulkeSIMDetails(Inputs,Outputs);
			break;
			
			case &quot;CancelSIMSwap&quot;:
			mCancelSIMSwap(Inputs,Outputs);
			break;
			
			case &quot;GetRootlineItemId&quot;:
			mGetRootlineItemId(Inputs,Outputs);
			break;
			
			case &quot;CreateAttachments&quot;:
			mCreateAttachments(Inputs,Outputs);
			break;
			
			case &quot;MoveFile&quot;:
			mMoveFile(Inputs,Outputs);
			break;
			
			case &quot;GetFileName&quot;:
			mGetFileName(Inputs,Outputs);
			break;
			
			case &quot;SyncSimTypeForHandsetMatrix&quot;:  //Sachi - 22/01/2019 - Added for R19.1 for Atom Phase 2
			mSyncSimTypeForHandsetMatrix(Inputs,Outputs);
			break;
			
			case &quot;SyncSimTypeForHandsetImport&quot;:  //Sachi - 22/01/2019 - Added for R19.1 for Atom Phase 2
			mSyncSimTypeForHandsetImport(Inputs,Outputs);
			break;
			
			case &quot;GetPlanName&quot;:
			mGetPlanName(Inputs,Outputs);
			break;
			
			case &quot;CreateBulkExportData&quot;:
			mCreateBulkExport(Inputs,Outputs);
			break;
        
            case &quot;UpdateCommentsSIMSWap&quot;:
			mUpdateCommentsSIMSWap(Inputs,Outputs);
			break;
     
            case &quot;UpdateSIMTypeandConfirCode&quot;:
			mUpdateSIMTypeandConfirCode(Inputs,Outputs);
			break;
			
			case &quot;UpdateSTCCForBulkChangeSIM&quot;:		//Sachi - 12/03/2019 - Added for R19.1 for Atom Phase 2
			mUpdateSTCCForBulkChangeSIM(Inputs,Outputs);
			break;
			
			case &quot;ValidateSIMTypeConnectNative&quot;: //Sachi - 06/Apr/2019 - Added for R19.1 FallOut for Atom Phase 2
			mValidateSIMTypeConnectNative(Inputs,Outputs);
			break;
			
			case &quot;GenerateRandomCode&quot;: //VHA 19.3/PKE/NIRMAL/20JUN2019/Added for PKE000000076341
			Outputs.SetProperty(&quot;Code&quot;,mGenerateRandomCode(Inputs.GetProperty(&quot;Seed&quot;)));
			break;
			
			default:
			break;
		}
		return (CancelOperation);
	}
	catch(e)
	{
		var sErrorMessage = &quot;&quot;;
		if(defined(e.errText))
			sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString();
		else  
			sErrorMessage = e.toString();
		throw(sErrorMessage);
	}
	finally
	{		
	
	}
}"
