			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCOLOrderDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCOLOrderDetails(Inputs, Outputs)
{
	//SakthiR Created For Get COL Details
	try
	{
		var sOrderBO,sOrderBC,sOrderLineBC;
		var psErrorInput, psErrorOutput, sErrorMessage, bsError;
		var iRecord = &quot;&quot;;
		var iRecordLine = &quot;&quot;;
		var sOrderId = &quot;&quot;;
		var sRootAssetId = &quot;&quot;;
		var sRootOrderItemId = &quot;&quot;;
		var sMSISDN = &quot;&quot;;
		var sNewMSISDN = &quot;&quot;;
		var sSpecialSiebelType = &quot;&quot;;
		var sVFContactId = &quot;&quot;;
		var sSearchspec = &quot;&quot;;

			
		sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);	
		sOrderLineBC = sOrderBO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);		
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		if(sOrderId !=&quot;&quot;)
		{					
			with(sOrderBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;VF Order Acct Contact Id&quot;);
				ActivateField(&quot;Id&quot;);
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);	
				iRecord = FirstRecord();
				if(iRecord) 
				{
					sVFContactId = sOrderBC.GetFieldValue(&quot;VF Order Acct Contact Id&quot;);
					sSearchspec = &quot;[Order Header Id]= &apos;&quot;+ sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code]&lt;&gt;&apos;Delete&apos; AND [Root Order Item Id]=[Id]&quot;;
					with(sOrderLineBC)
					{
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;Id&quot;);
						ActivateField(&quot;Parent Order Item Id&quot;);
						ActivateField(&quot;Action Code&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
						ActivateField(&quot;Special Rating List Type&quot;);
						ActivateField(&quot;MSISDN&quot;);
						ActivateField(&quot;New MSISDN&quot;);
						ActivateField(&quot;Root Asset Id&quot;);
						SetSearchExpr(sSearchspec);;
						ExecuteQuery(ForwardOnly);	
						iRecordLine = FirstRecord();
						if(iRecordLine)
						{
							sRootOrderItemId = GetFieldValue(&quot;Root Order Item Id&quot;);
							sSpecialSiebelType = GetFieldValue(&quot;Special Rating List Type&quot;);
							sMSISDN = GetFieldValue(&quot;MSISDN&quot;);
							sNewMSISDN = GetFieldValue(&quot;New MSISDN&quot;);
							sRootAssetId = GetFieldValue(&quot;Root Asset Id&quot;);
						}	
					}		
				}
			}
		}
		Outputs.SetProperty(&quot;VFContactId&quot;, sVFContactId);
		Outputs.SetProperty(&quot;RootOrderItemId&quot;, sRootOrderItemId);
		Outputs.SetProperty(&quot;MSISDN&quot;, sMSISDN);
		Outputs.SetProperty(&quot;NewMSISDN&quot;, sNewMSISDN);
		Outputs.SetProperty(&quot;RootAssetId&quot;, sRootAssetId);
		Outputs.SetProperty(&quot;SpecialSiebelType&quot;, sSpecialSiebelType);
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;COLOrderDetails&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;mCOLOrderDetailst&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	finally
	{
		sOrderBO = null;
		sOrderBC = null;
		sOrderLineBC = null;
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
	}
}	"
