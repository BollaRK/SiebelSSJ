			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateAccesTechnology"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateAccesTechnology(Inputs, Outputs)
{
	try{
			var sSiebProdType = &quot;&quot;;
			var sErr = &quot;&quot;;
			var sErrCode = &quot;9019&quot;;
			var sAccessTech = Inputs.GetProperty(&quot;AccessTechnology&quot;);
			var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
			var sLineItemBC = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;); 
			var searchspec = &quot;[Root Order Item Id] = &apos;&quot;+sOrderItemId+&quot;&apos; AND [Action Code] =&apos;Add&apos; AND ([Product Sub Type Code] = &apos;Product Specification&apos; OR [Product Sub Type Code] = &apos;Resource Specification&apos; OR [Product Sub Type Code] = &apos;Service Specification&apos;)&quot;;
		with(sLineItemBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Action Code&quot;);
			ActivateField(&quot;VF Siebel Product Type&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;Product Sub Type Code&quot;);
			ClearToQuery();			
			SetSearchExpr(searchspec);
			ExecuteQuery(ForwardOnly);
			var iRec = FirstRecord();
			while (iRec)
			{
				sSiebProdType = GetFieldValue(&quot;VF Siebel Product Type&quot;);
				if(sAccessTech == TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Building&quot;))
				sAccessTech = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Node&quot;);
				if(sSiebProdType != TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,sAccessTech))
				{
				/*	sErr = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, sErrCode,sAccessTech);
					TheApplication().RaiseErrorText(sErr);*/
					TheApplication().RaiseErrorText(&quot;VFErrorCode#9019&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, sErrCode,sAccessTech));
					
				}
				iRec = NextRecord();
			}
		}	
		
	
	
	}
	
	catch(e){
		throw(e);
	
	}
	finally{
		sLineItemBC = &quot;&quot;;
		boOrder = &quot;&quot;;
	
	}
}"
			   SEQUENCE="8"
			   UPDATED="08/06/2017 23:45:16"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:45:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateConnType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateConnType(Inputs, Outputs)
{
try{
	var ERR1 = &quot;9030&quot;;
	var ERR2 = &quot;9031&quot;;
	var sERRMsg1 = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR1);
	var sERRMsg2 = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR2);
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
	var sFBB_MBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;);
//	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);  
	var boOrder = TheApplication().GetBusObject(&quot;VHA Order Entry Thin BO&quot;); //Roseline:11/07/2017 - Changed to thin BO
	var sLineItemBC = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;); 
	var sBC = boOrder.GetBusComp(&quot;FS Shipment&quot;);
	var searchspec = &quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
	var sLineNumber = 0, FBBItemExists=&quot;N&quot;, sOutOfStockExists = &quot;N&quot;;
	with(sLineItemBC)
	{
		ActivateField(&quot;Siebel Product Type&quot;);
		ActivateField(&quot;VF ConnectionType&quot;);
		ActivateField(&quot;VF OutofStock Flg TBUI&quot;);
		SetViewMode(AllView);
		ClearToQuery();			
		SetSearchExpr(searchspec);
		ExecuteQuery(ForwardOnly);
		var NumOfRec = CountRecords();	// VHA Suresh: Added fir SIT Defect #171
		var iRec = FirstRecord();
		while (iRec)
		{
			sLineNumber++;
			var sProductType = sLineItemBC.GetFieldValue(&quot;Siebel Product Type&quot;);
			var sConnectionType = sLineItemBC.GetFieldValue(&quot;VF ConnectionType&quot;);
			if((sConnectionType == &quot;Bring Your Device&quot;) &amp;&amp; (sProductType != sFBBOnly))//Modifying this as BYO is applicable only for NBN Only
				TheApplication().RaiseErrorText(&quot;VFErrorCode#9030&quot; + &quot; - &quot; + &quot;Line# &quot; + sLineNumber +sERRMsg1);
			if(sConnectionType == &quot;SIM Only&quot; &amp;&amp; (sProductType == sFBBOnly || sProductType == sFBB_MBB))
				TheApplication().RaiseErrorText(&quot;VFErrorCode#9031&quot; + &quot; - &quot; + &quot;Line# &quot; + sLineNumber + sERRMsg2);
			if((sProductType == sFBB_MBB) || (sProductType == sFBBOnly))
			{
			FBBItemExists = &quot;Y&quot;;
			if(GetFieldValue(&quot;VF OutofStock Flg TBUI&quot;) == &quot;Y&quot;)
				sOutOfStockExists = &quot;Y&quot;;
			}
			
			iRec = NextRecord();
		}
	}
	if(NumOfRec &gt; 1 &amp;&amp; FBBItemExists == &quot;Y&quot; &amp;&amp; sOutOfStockExists == &quot;Y&quot;)	// VHA Suresh P: Added fir SIT Defect #171
	{
		with(sBC)
		{
			ActivateField(&quot;Primary Order Id&quot;);
			ActivateField(&quot;VHA Shipment Preference Calc&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Primary Order Id&quot;,sOrderId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord());			
			{
				if(GetFieldValue(&quot;VHA Shipment Preference Calc&quot;) == &quot;Full&quot;)
					TheApplication().RaiseErrorText(&quot;VFErrorCode#9040&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;9040&quot;));
			}
		}
	}
	}
	catch(e)
	{
		throw (e);
	}
	finally 
	{
		sBC = null;/*This variable is nullified by GURUPRASAD on 29/10/2019*/
		sLineItemBC = null;
		boOrder = null;
	}
	return (ContinueOperation);	
}"
			   SEQUENCE="9"
