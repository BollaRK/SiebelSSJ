			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSelectAssetForSharing"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="
function mSelectAssetForSharing(Inputs, Outputs)
{
	try{
		var OrderReference = Inputs.GetProperty(&quot;OrderReference&quot;);
		var BillingAccntId = Inputs.GetProperty(&quot;BillingAccntId&quot;);
		
		var SharingReferenceBO = TheApplication().GetBusObject(&quot;VHA Online Sharing Reference&quot;);
		var SharingReferenceBC = SharingReferenceBO.GetBusComp(&quot;VHA Sharing Online Reference&quot;);
		var SharingReferenceChildBC = SharingReferenceBO.GetBusComp(&quot;VHA Sharing Online Reference Child&quot;);
		var OrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var OrderBC = OrderBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		var AssetBC = OrderBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
		var ServiceCount = 0 ;
		with(SharingReferenceBC){
			SetViewMode(AllView);
			ActivateField(&quot;Order Reference&quot;);			
			ClearToQuery();
			SetSearchSpec(&quot;Order Reference&quot;,OrderReference );
			ExecuteQuery();
			var isParRec = FirstRecord();
			SharingReferenceChildBC.ActivateField(&quot;External Service Id&quot;);
			SharingReferenceChildBC.ActivateField(&quot;Existing MSISDN&quot;);
			SharingReferenceChildBC.ClearToQuery();
			SharingReferenceChildBC.ExecuteQuery();
			
			var isRec = SharingReferenceChildBC.FirstRecord();
			//var count1 = SharingReferenceChildBC.CountRecords();
			while(isRec){
				
				var ExtServiceId = SharingReferenceChildBC.GetFieldValue(&quot;External Service Id&quot;);
				var ExtServiceMSISDN = SharingReferenceChildBC.GetFieldValue(&quot;Existing MSISDN&quot;);
			if(ExtServiceMSISDN == &quot;N&quot;){
				with(OrderBC){
					OrderBC.SetViewMode(AllView);
					OrderBC.ActivateField(&quot;VHA External Order Id&quot;);
					OrderBC.ActivateField(&quot;VHA External Service Id&quot;);
					OrderBC.ActivateField(&quot;VHA Order Head BA Id&quot;);
					OrderBC.ActivateField(&quot;Billing Account Id&quot;);
					OrderBC.ActivateField(&quot;Order Status&quot;);
					OrderBC.ActivateField(&quot;Status&quot;);
					OrderBC.ActivateField(&quot;Root Asset Id&quot;);
					OrderBC.ClearToQuery();
					OrderBC.SetSearchSpec(&quot;VHA External Order Id&quot;,OrderReference);
					OrderBC.SetSearchSpec(&quot;VHA External Service Id&quot;,ExtServiceId);
					OrderBC.SetSearchSpec(&quot;VHA Order Head BA Id&quot;,BillingAccntId);//Added to improve the performance of the query
					OrderBC.SetSearchSpec(&quot;Billing Account Id&quot;,BillingAccntId);//Added to improve the performance of the query
					OrderBC.SetSearchSpec(&quot;Parent Order Item Id&quot;,&quot;IS NULL&quot;);
					OrderBC.ExecuteQuery();
					//var count2 = OrderBC.CountRecords();
					var OrderRecExists = OrderBC.FirstRecord();
					while(OrderRecExists){
						var AssetId = OrderBC.GetFieldValue(&quot;Root Asset Id&quot;);
												
						with(AssetBC){
							AssetBC.SetViewMode(AllView);
							AssetBC.ActivateField(&quot;Select For Upgrade&quot;);
							AssetBC.ClearToQuery();
							AssetBC.SetSearchSpec(&quot;Id&quot;,AssetId);
							AssetBC.ExecuteQuery();
							//var count3 = AssetBC.CountRecords();
							if(AssetBC.FirstRecord()){
								AssetBC.SetFieldValue(&quot;Select For Upgrade&quot;,&quot;Y&quot;);
								AssetBC.WriteRecord();
								ServiceCount++;
							}
						}
						
						OrderRecExists = OrderBC.NextRecord();
					}
						
				}
			}else if(ExtServiceMSISDN == &quot;Y&quot;){
				with(AssetBC){
					AssetBC.SetViewMode(AllView);
					AssetBC.ActivateField(&quot;Select For Upgrade&quot;);
					AssetBC.ActivateField(&quot;MSISDN&quot;);
					AssetBC.ClearToQuery();
					AssetBC.SetSearchSpec(&quot;MSISDN&quot;,ExtServiceId);
					AssetBC.ExecuteQuery();
					//var count3 = AssetBC.CountRecords();
					if(AssetBC.FirstRecord()){
						AssetBC.SetFieldValue(&quot;Select For Upgrade&quot;,&quot;Y&quot;);
						AssetBC.WriteRecord();
						ServiceCount++;
					}
				}
			}
				
				isRec = SharingReferenceChildBC.NextRecord();
			}
		}
		Outputs.SetProperty(&quot;ServiceCount&quot;,ServiceCount);
		
	}catch(e){
		throw(e);
	}finally{
		AssetBC = null;
		OrderBC = null;
		OrderBO = null;
		SharingReferenceChildBC = null;
		SharingReferenceBC = null;
		SharingReferenceBO = null;
		
	}
}"
