			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateFBBServicesSharingFlag"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateFBBServicesSharingFlag(strOrderId)
{
try
{
	/**********************************************************************
	VHA Suresh: 20/04/2017 Added for R17.3 PIPE: Sharing
	**********************************************************************/
	var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
	var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
	with(bcOrderLineItems)
	{
		SetViewMode(AllView);
		ClearToQuery();
		ActivateField(&quot;VF Sharing Order&quot;);
		ActivateField(&quot;Sharing Group Id&quot;);
		ActivateField(&quot;Sharing Group Name&quot;);
		ActivateField(&quot;VHA Sharing  Group Name&quot;);
		var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + strOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;; // PKE000000045550
		SetSearchExpr(sSearchspec);
		ExecuteQuery(ForwardOnly);
		var irec = FirstRecord();
		while(irec)
		{
			if(GetFieldValue(&quot;Sharing Group Id&quot;) == &quot;&quot; || GetFieldValue(&quot;Sharing Group Id&quot;) == null)
				SetFieldValue(&quot;VF Sharing Order&quot;,&quot;N&quot;);
			else
			{
				if(GetFieldValue(&quot;Sharing Group Name&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;Sharing Group Name&quot;) != null)
					SetFieldValue(&quot;VHA Sharing  Group Name&quot;,GetFieldValue(&quot;Sharing Group Name&quot;));
			}
			irec = NextRecord();				
		}
		WriteRecord();
	}
}
catch(e)
{
	throw(e);
}
finally
{
	bcOrderLineItems = null;
	boOrderConnect = null;
}
}"
