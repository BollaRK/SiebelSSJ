			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateAppOffer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateAppOffer(Inputs,Outputs)
{
	try
	{
		var boOrder, bcOrderLineItems;
		boOrder = TheApplication().GetBusObject(&quot;VHA ATOM Order Entry - Line Items Thin BO&quot;);
	    bcOrderLineItems = boOrder.GetBusComp(&quot;VHA ATOM Order Entry - Line Items Thin&quot;);
		var RelConId = Inputs.GetProperty(&quot;RelConId&quot;);
		var sOrderId =Inputs.GetProperty(&quot;OrderId&quot;);
		var sActCd =Inputs.GetProperty(&quot;ActCd&quot;);
		Outputs.SetProperty(&quot;OfferStatus&quot;,&quot;Valid&quot;);
		var sSrcExp = &quot;&quot;;
		if(sActCd == &quot;DEL&quot;)
			sSrcExp = &quot;([Asset Integration Id] = &apos;&quot; + RelConId + &quot;&apos; OR [Related Asset Integration Id] = &apos;&quot; + RelConId + &quot;&apos;) AND [Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Action Code] = &apos;Delete&apos; AND [Product Type] = &apos;Billing - APP&apos;&quot;;
		else
			sSrcExp = &quot;([Asset Integration Id] = &apos;&quot; + RelConId + &quot;&apos; OR [Related Asset Integration Id] = &apos;&quot; + RelConId + &quot;&apos;) AND [Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Action Code] &lt;&gt; &apos;Add&apos; AND [Product Type] = &apos;Billing - APP&apos;&quot;;
	    
		with(bcOrderLineItems)
	    {
	      
		   ClearToQuery();
	       SetViewMode(AllView);
	       SetSearchExpr(sSrcExp);
	       ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{	
				Outputs.SetProperty(&quot;OfferStatus&quot;,&quot;Invalid&quot;);
			}
		}
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcOrderLineItems = null;
		boOrder = null;
	}
}
"
