			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mIgnCancelOrd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mIgnCancelOrd(Inputs,Outputs)
{ 
 
 try
 {  
  var sOrderId = TheApplication().GetProfileAttr(&quot;PegaOrdId&quot;);;
  //var sAction = Inputs.GetProperty(&quot;Action&quot;);
  var boRec = TheApplication().GetBusObject(&quot;VHA Pega Recommendations BO&quot;);
  var bcRec = boRec.GetBusComp(&quot;VHA Pega Quote Order BC&quot;);
  var bcRecChild = boRec.GetBusComp(&quot;VHA Pega Accepted Recommendation Details&quot;);
  
      //var bcCD = boCD.GetBusComp(&quot;Account&quot;);    
  
  with(bcRec)
  {
   SetViewMode(AllView);
   ClearToQuery();
   ActivateField(&quot;Account Id&quot;);
   ActivateField(&quot;Status Cd&quot;);
   SetSearchSpec(&quot;Id&quot;, sOrderId);
   ExecuteQuery(ForwardOnly);   
   if(FirstRecord()) 
   {
   // if(sAction==&quot;Express Fulfilment&quot;)
   // {
	 var sQuotOrdstat = GetFieldValue(&quot;Status Cd&quot;);
	 if(sQuotOrdstat == &quot;Order Created&quot;)
	 {
		SetFieldValue(&quot;Status Cd&quot;,&quot;Recommendation Submitted&quot;);
		WriteRecord();
	 }
     with(bcRecChild)
     {
      SetViewMode(AllView);
      ClearToQuery();
      ActivateField(&quot;Par Row Id&quot;);
      ActivateField(&quot;Status&quot;);
      SetSearchSpec(&quot;Par Row Id&quot;, sOrderId);
	  SetSearchSpec(&quot;Status&quot;, &quot;Order Created&quot;);
      ExecuteQuery(ForwardOnly);   
      var rec = FirstRecord();
      while(rec) 
      {
       SetFieldValue(&quot;Status&quot;,&quot;Recommendation Submitted&quot;);
       WriteRecord();
       rec = NextRecord();
      }
     }    
     
     //TheApplication().GotoView(&quot;VHA Pega Recommendations View&quot;, boRec);
   // }
    

   } 
  } 
   
 }
 catch(e)
 {  
  throw(e);
 }
 finally
 {  
  bcRecChild = null;
  bcRec = null;
  boRec = null;
  //bcCD  = null;
  //boCD  = null;    
 }
}"
			   SEQUENCE="18"
			   UPDATED="12/22/2025 22:23:10"
