			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateTerminateMPPGPP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateTerminateMPPGPP(Inputs, Outputs)
{
	try
	{
		
		var sSessionId = Inputs.GetProperty(&quot;Session Id&quot;);
		var sBillAccntId = Inputs.GetProperty(&quot;Billing Account Id&quot;);
		var bsInputs = TheApplication().NewPropertySet();
		var bsOutputs = TheApplication().NewPropertySet(); 
		var sMppGPPRecCount = 0, sMSISDN = &quot;&quot;, sErrMsg = &quot;&quot;;
		
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA MHI MPP GPP Upgrade IO&quot;);
		bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[Asset Mgmt - Asset - Header.Billing Account Id] = &apos;&quot; +sBillAccntId+ &quot;&apos; AND [Asset Mgmt - Asset - Header.Select For Upgrade] = &apos;Y&apos; AND [VHA GPP Upgrade History BC.Session Id] = &apos;&quot; +sSessionId+ &quot;&apos; AND [VHA GPP Upgrade History BC.Invoke API Flag] = &apos;N&apos; AND [VHA GPP Upgrade History BC.Action code] = &apos;Y&apos;&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs); 
		
		var sSiebelMsg = bsOutputs.GetChild(0)
		
		var sAssetRecCount = sSiebelMsg.GetChild(0).GetChildCount();

		
		for(var i = 0; i &lt; sAssetRecCount; i++)
		{	
			sMSISDN = &quot;&quot;;		
			sMppGPPRecCount = sSiebelMsg.GetChild(0).GetChild(i).GetChild(0).GetChildCount();
			if(sMppGPPRecCount &gt; 0)
			{
				sMSISDN = sSiebelMsg.GetChild(0).GetChild(i).GetProperty(&quot;Primary MSISDN&quot;);
				sErrMsg = &quot;&quot; + sMSISDN +&quot;:&quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_MHI_05&quot;);
				break;
			}
			
		}
		//Outputs.SetProperty(&quot;Error Output&quot;, sErrMsg);
		if(sErrMsg != &quot;&quot; &amp;&amp; sErrMsg != null)
		{
			TheApplication().RaiseErrorText(sErrMsg);
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bsInputs = null;
		bsInputs = null;
		bsEAIService = null;	
	}
	
}"
			   SEQUENCE="35"
