			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateNBNOrderContact"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateNBNOrderContact(Inputs, Outputs)
{
 try{
   var sErr = &quot;&quot;;
   var sContactNum = &quot;&quot;;
   var sContactName = &quot;&quot;;
   var sContactMail = &quot;&quot;;
   var sErrCode = &quot;9020&quot;;
   var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
  // var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
   var boOrder = TheApplication().GetBusObject(&quot;VHA NBN Order&quot;); //Roseline:11/07/2017 - Changed to thin BO 
   var bcNBNOrder = boOrder.GetBusComp(&quot;VHA NBN Order Details&quot;);
   with(bcNBNOrder)
   {
    SetViewMode(AllView);
    ActivateField(&quot;Order Contact #&quot;);
    ActivateField(&quot;Order Contact Name&quot;);
    ActivateField(&quot;Order Contact Email Id&quot;);
    ActivateField(&quot;Root Order Item Id&quot;);
    ActivateField(&quot;Product Sub Type Code&quot;);
    ActivateField(&quot;Order Id&quot;);
    ClearToQuery();   
    SetSearchSpec(&quot;Order Id&quot;, sOrderId);
    ExecuteQuery(ForwardOnly);
    var iRec = FirstRecord();
    if (iRec)
    {
     sContactNum = GetFieldValue(&quot;Order Contact #&quot;);
     sContactName = GetFieldValue(&quot;Order Contact Name&quot;);
     sContactMail = GetFieldValue(&quot;Order Contact Email Id&quot;);
     if(sContactNum == null || sContactNum == &quot;&quot; || sContactName == null || sContactName == &quot;&quot; || sContactMail == null || sContactMail == &quot;&quot;)
     {
     /* sErr = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, sErrCode);
      TheApplication().RaiseErrorText(sErr);*/
      TheApplication().RaiseErrorText(&quot;VFErrorCode#9020&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, sErrCode));
     }
     
    }
   }   
 
 }
 
 
 catch(e){
  throw(e);
 }
 
 finally{
  bcNBNOrder = &quot;&quot;;
  boOrder = &quot;&quot;;
 }
 
}"
