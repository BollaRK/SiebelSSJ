			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGenerateRandomCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGenerateRandomCode(seed)
//VHA 19.3/PKE/NIRMAL/20JUN2019/Added for PKE000000076341
{
    var j, temp;
    var len, seedLen;
    var code;
    var randNum;
    var svc, input, output;
    var validCode = 0;

    seedLen = seed.length;

	if(seedLen&lt;4){
		seed = Clib.rand() + seed;
		seedLen = seed.length;
	}

    while (validCode == 0) {
        code = &quot;&quot;;
        randNum = ToString(Clib.rand());
        len = randNum.length;
        for (j = 0; j &lt; 4; j++) {
			temp = seed.charCodeAt(seedLen-j-1) % len;
			code = code + randNum.charAt(temp);
        }
        try { //Validate the code using existing PIN validation logic
            svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
            input = TheApplication().NewPropertySet();
            output = TheApplication().NewPropertySet();
            input.SetProperty(&quot;ProcessName&quot;, &quot;VHA PIN Validation Process&quot;);
            input.SetProperty(&quot;PIN&quot;, code);
            svc.InvokeMethod(&quot;RunProcess&quot;, input, output);
            validCode = 1;
        } catch (e) {
            validCode = 0;
        }
    }
	return(code);
}"
