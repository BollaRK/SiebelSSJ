			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mChkChangePropRCR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mChkChangePropRCR(Inputs, Outputs)
{
	

	
	var sSrchExpr;
	var strOrderType,strOrderId;
	var strValidChProp = &quot;N&quot;;
	var count;
	
	try
	{		
		// Get the integration id
		
		strOrderId = Inputs.GetProperty(&quot;Object Id&quot;);
		
		
		strOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
      
        if(strOrderType==&quot;Change Proposition&quot;)
		{
		sSrchExpr =&quot;[Order Header Id]=&apos;&quot;+strOrderId+&quot;&apos; AND [Action Code]=&apos;Add&apos; AND [Sharing Action]=&apos;Remove Member&apos; AND [Parent Order Item Id] IS NULL&quot;;
		
	
		// Setup business object and component
		var boOrd = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOli = boOrd.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
		
		bcOli.ClearToQuery();
		//bcOrderLineItemAsset.ActivateField(&quot;Asset Integration Id&quot;);
		bcOli.ActivateField(&quot;Order Header Id&quot;);
		bcOli.SetSearchExpr(sSrchExpr);	

		bcOli.ExecuteQuery(ForwardOnly);
		
		// If a record is found, set the Order Exists Flag to true
		count=bcOli.CountRecords();

		if ( count &gt; 0)
		{
            strValidChProp= &quot;Y&quot;;
		}

		else
		{
             strValidChProp= &quot;N&quot;;
		}
	
		
	    }
		
		
		Outputs.SetProperty(&quot;Validchangeprop&quot;, strValidChProp);
	}
	catch(e)
	{
		
		throw (e);
	}
	finally
	{
		boOrd = null;
		bcOli = null;
		
		
				
	}
}"
			   SEQUENCE="31"
