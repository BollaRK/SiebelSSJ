			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="errorMessage"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function errorMessage(e)
{
	try
	{
		var sErrorMessage = &quot;&quot;;
		var psErrorInput, psErrorOutput;
		var bsError;
		if(!defined(e.errText))
		{
			sErrorMessage = e.toString();
		}
		else
		{
			sErrorMessage = e.errText;
		}
	
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF TBUI MSO Utilities&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;Proposition Next&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		return(sErrorMessage);  
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
	}
	
}"
			   SEQUENCE="17"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
