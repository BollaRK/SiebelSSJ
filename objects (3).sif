			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTrim"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*Bharat  28/05/2014    Added for retrofit QC 1756
 * Component Name        : 	VF String Utilities
 * Method Name           : 	mTrim
 * Component Information : 	This function is used to trim both leading and trailing spaces
 *							
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 28/03/2014	GREGB		QC1756		Initial Version
 * 19/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages.
 */
function mTrim(Inputs, Outputs)
{

	//***************************************
	//* Constants and Variables
	//***************************************
	var strText;	

	try
	{
		strText   = Inputs.GetProperty(&quot;Text&quot;);	

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF String Utilities.mTrim =&quot; + strText);
		}
		
		if (strText != &quot;&quot;)
		{
			//Convert into Upper Case
			Outputs.SetProperty(&quot;TrimmedText&quot;, strText.replace (/^\s+/, &quot;&quot;).replace (/\s+$/, &quot;&quot;));
		}
				
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);		
	}
	finally
	{
 		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF String Utilities.mTrim =&quot; + strText);
		}
	}	
}"
			   SEQUENCE="29"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="04/29/2026 01:04:25"
			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTrimSpaces"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTrimSpaces(Inputs, Outputs)
{
/*
 * Component Name        : 	VF String Utilities
 * Method Name           : 	mTrimSpaces
 * * Modification History  :
 * Date			Author		Config #	Description      Comments
 * ============ ===========	===========	================================
 * 26/03/2018   Vinodhini    Rel 18.2    Initial Version  To Remove all the spaces in string.
 */
	//***************************************
	//* Constants and Variables
	//***************************************
	var strText;
	var UpperCase;
	var IsNumber = &quot;N&quot;;
	try
	{
		strText = Inputs.GetProperty(&quot;Text&quot;);
		UpperCase = Inputs.GetProperty(&quot;UpperCase&quot;);

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF String Utilities.mTrim =&quot; + strText);
		}
		
		if (strText != &quot;&quot;)
		{
			
		for(var i =0; i &lt; strText.length; i++)
		 {
		 	//Removes all special characters
			 strText= strText.replace(/[^A-Z^0-9^a-z]/,&quot;&quot;);
			 
			 //Removes the Text before the Numbers
			if(!isNaN(strText.charAt(i)) &amp;&amp; IsNumber == &quot;N&quot;)
            {
            	strText = strText.substring(i);
				IsNumber = &quot;Y&quot;
		    }
			 
		 }
        Outputs.SetProperty(&quot;TrimmedText&quot;,strText);
		
		//Convert to Upper case
		if(UpperCase == &quot;Y&quot;)
		{
			Outputs.SetProperty(&quot;TextUpperCase&quot;, strText.toUpperCase());
		}
		
	    }
				
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);		
	}
	finally
	{
 		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF String Utilities.mTrim =&quot; + strText);
		}
	}	
}"
