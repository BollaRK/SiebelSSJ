			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteeSIM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteeSIM(Inputs, Outputs)
{
	try
	{
		var sActiveView = TheApplication().ActiveViewName();
		if(sActiveView != &quot;VF Order Entry - SIM Allocation View&quot;)
		{
			var sRootItemId = Inputs.GetProperty(&quot;RequestId&quot;);
			var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry - SIM Relationship TBUI&quot;);//Cloned from Order Entry - Line Items BC - mDealloacateSIM()
			var strORDERLISIMREL	= &quot;VF Order Entry - SIM Relationship&quot;;
			var strORDERLIIMSIREL	= &quot;VF Order Entry - IMSI Relationship&quot;;
			deleteResourceRelationship(boOrder, strORDERLISIMREL, sRootItemId)
			deleteResourceRelationship(boOrder, strORDERLIIMSIREL, sRootItemId)
			
			var psInputs,psOutputs,bsInvokeBS;
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;OrderLineItemId&quot;, sRootItemId);
			bsInvokeBS = TheApplication().GetService(&quot;VF Postpay Utilities TBUI&quot;);
			bsInvokeBS.InvokeMethod(&quot;NullifySIM&quot;, psInputs, psOutputs);
		}	
		return (CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		boOrder = null;
		psInputs = psOutputs = bsInvokeBS = null;
	}
}"
