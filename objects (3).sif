			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCOLSetOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCOLSetOrder(Inputs, Outputs)
{
	 //SakthiR Created For Get COL Details
	try
	{
		var sOrderBO,sOrderBC,sOrderLineBC;
		var psErrorInput, psErrorOutput, sErrorMessage, bsError;
		var iRecord = &quot;&quot;;
		var iRecordLine = &quot;&quot;;
		var sOrderId = &quot;&quot;;
		var sCOLCOTOrderSubFunc = &quot;&quot;;
		var sCOLNBNStartdate  = &quot;&quot;;
		var sCOLStartdate = &quot;&quot;;
		var sSearchspec = &quot;&quot;;

			
		sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);	
		sOrderLineBC = sOrderBO.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);		
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sCOLCOTOrderSubFunc = Inputs.GetProperty(&quot;COLCOTOrderSubFunc&quot;);
		sCOLNBNStartdate = Inputs.GetProperty(&quot;COLNBNStartdate&quot;);
		sCOLStartdate = Inputs.GetProperty(&quot;COLStartdate&quot;);
		if(sOrderId !=&quot;&quot;)
		{					
			with(sOrderBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Future Submit Date&quot;);
				ActivateField(&quot;Status&quot;);
				ActivateField(&quot;Id&quot;);
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);	
				iRecord = FirstRecord();
				if(iRecord) 
				{
					if(sCOLCOTOrderSubFunc == &quot;Change Location Across NW&quot; || sCOLCOTOrderSubFunc == &quot;Change Location Within NW&quot;)
					{
						if(sCOLStartdate == null || sCOLStartdate ==&quot;&quot;)
						{
							SetFieldValue(&quot;Future Submit Date&quot;,sCOLNBNStartdate);
							WriteRecord();
						}
						else
						{
							SetFieldValue(&quot;Future Submit Date&quot;,sCOLStartdate);
							WriteRecord();
						}							
						sSearchspec = &quot;[Order Header Id]= &apos;&quot;+ sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL&quot;
						with(sOrderLineBC)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;Order Header Id&quot;);
							ActivateField(&quot;Id&quot;);
							ActivateField(&quot;Parent Order Item Id&quot;);
							ActivateField(&quot;Service Order Future Submit Date&quot;);
							SetSearchExpr(sSearchspec);;
							ExecuteQuery(ForwardOnly);	
							iRecordLine = FirstRecord();
							if(iRecordLine)
							{
								if(sCOLStartdate == null || sCOLStartdate ==&quot;&quot;)
								{
									SetFieldValue(&quot;Service Order Future Submit Date&quot;,sCOLNBNStartdate);
									WriteRecord();
								}
								else
								{
									SetFieldValue(&quot;Service Order Future Submit Date&quot;,sCOLStartdate);
									WriteRecord();
								}
							}
						}
					}
										
				}
			}
		}
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;mCOLSetOrder&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;mCOLSetOrder&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	finally
	{
		sOrderBO = null;
		sOrderBC = null;
		sOrderLineBC = null;
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
	}
}	"
