			   UPDATED_BY="KRISHNAS"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateAPPContractTerm"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateAPPContractTerm(Inputs, Outputs)
{
	try
	{
		var sAppId = Inputs.GetProperty(&quot;APP Id&quot;);
		var sContractMnths = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_APP_CONTRACT_MONTHS&quot;,&quot;0&quot;);
		var sTerm = &quot;&quot;;
		var sBO = TheApplication().GetBusObject(&quot;VHA APP Accessories BO&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
		var sErrMsg = &quot;&quot;;
		with(sBC)
		{
			ActivateField(&quot;VHA Manage APP Contract Term&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Asset Integration Id&quot;,sAppId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sTerm = ToNumber(GetFieldValue(&quot;VHA Manage APP Contract Term&quot;));
				if(sTerm == ToNumber(sContractMnths))
					sErrMsg = &quot;Y&quot;;
			}
		}
		Outputs.SetProperty(&quot;ErrMsg&quot;,sErrMsg);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
