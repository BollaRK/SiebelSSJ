			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateMinMaxAge"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateMinMaxAge(Inputs,Outputs)
{
	try
	{
		
		var sReturn = &quot;Valid&quot;;
		
		var sDoB = Inputs.GetProperty(&quot;DOB&quot;);
		var sMinAgeTrigger = Inputs.GetProperty(&quot;sMinAgeTrigger&quot;);
		var sMaxAgeTrigger = Inputs.GetProperty(&quot;sMaxAgeTrigger&quot;);
		var sHours = &quot;23&quot;;
		var sMins = &quot;59&quot;;
		var sSecs = &quot;59&quot;;

		
		if(sDoB == &quot;&quot; || sDoB == null)
		{
			sReturn = &quot;Invalid&quot;;
			//Outputs.SetProperty(&quot;Status&quot;,&quot;Invalid&quot;);			
		}
		else
		{
			sDoB = sDoB + &quot; &quot; + sHours + &quot;:&quot; + sMins + &quot;:&quot; + sSecs;
			var	dtDoB = new Date(sDoB);
			var dtMin = new Date();
			var dtMax = new Date();		
			var iMinTrigger = ToNumber(sMinAgeTrigger);
			var iMaxTrigger = ToNumber(sMaxAgeTrigger);

			dtMin.setFullYear(dtMin.getFullYear()-iMinTrigger);
			dtMax.setFullYear(dtMax.getFullYear()-iMaxTrigger);		
			
	
			if(!(dtDoB.getTime() &gt;= dtMax.getTime() &amp;&amp; dtDoB.getTime() &lt;= dtMin.getTime()))
			{
					sReturn = &quot;Invalid&quot;;
					//Outputs.SetProperty(&quot;Status&quot;,&quot;Invalid&quot;);
			
			}
		}
			
		Outputs.SetProperty(&quot;Status&quot;,sReturn);
		//TheApplication().SetProfileAttr(&quot;Status&quot;,sReturn);
	}//End of Try
	
	catch(e)
	{
		throw(e);
	}
}
"
			   SEQUENCE="18"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="04/29/2026 01:04:25"
			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateSIMDevcOffer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateSIMDevcOffer(Inputs,Outputs)
{
    var orderPlanConstruct = &quot;&quot;,
    orderDeviceCode = &quot;&quot;,
    bcName = null,
    sReturn = &quot;Valid&quot;;
	Outputs.SetProperty(&quot;Status&quot;,sReturn);
	var sTriggerCheck = &quot;Validating&quot;;
    try {
       
		var SimOnlyFlag = Inputs.GetProperty(&quot;SimOnlyFlag&quot;);
		var DeviceOnlyFlag = Inputs.GetProperty(&quot;DeviceOnlyFlag&quot;);
		var sRatePlanTrigger = Inputs.GetProperty(&quot;sRatePlanTrigger&quot;);
		var sDeviceCodeTrigger = Inputs.GetProperty(&quot;sDeviceCodeTrigger&quot;);
		var sBoltOnTrigger = Inputs.GetProperty(&quot;sBoltOnTrigger&quot;);
        //check for old/new contruct
        orderPlanConstruct = Inputs.GetProperty(&quot;RatePlanNewConstruct&quot;);
        orderDeviceCode = Inputs.GetProperty(&quot;DeviceCode&quot;);
        if (orderPlanConstruct == &quot;N&quot;) {
            //Old Construct Plan- Device Only and SIMO Only flags both should be N for these cases
            sReturn = &quot;Valid&quot;;
        } else {
            if (orderPlanConstruct == &quot;Y&quot;) {
                //New Construct Plan
                if (sTriggerCheck == &quot;Validating&quot;) {
                    if (sRatePlanTrigger != &quot;&quot; &amp;&amp; sRatePlanTrigger != null) {
                        //rate plan trigger code is mentioned in the offer record and is not null
                        if (sDeviceCodeTrigger == &quot;&quot; || sDeviceCodeTrigger == null) {
                            //device code trigger in offer record is null or blank
                            if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                sReturn = &quot;Invalid&quot;;
                            else if (SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;)
                                sReturn = &quot;Valid&quot;;
                            else if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;) {
                                //SIMO Order with plan will get offer.Order should not contain any device
                                if (orderDeviceCode != &quot;&quot; &amp;&amp; orderDeviceCode != null)
                                    sReturn = &quot;Invalid&quot;;
                                else
                                    sReturn = &quot;Valid&quot;;
                            } else {
                                //(SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                if (orderDeviceCode != &quot;&quot; &amp;&amp; orderDeviceCode != null)
                                    sReturn = &quot;Valid&quot;;
                                else
                                    sReturn = &quot;Invalid&quot;;
                            }
                        } else {
                            //device code trigger in offer record is not null or not blank
                            if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                sReturn = &quot;Invalid&quot;;
                            else if (SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;)
                                sReturn = &quot;Valid&quot;;
                            else if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;) {
                                sReturn = &quot;Invalid&quot;;
                            } else {
                                //(SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                sReturn = &quot;Valid&quot;;
                            }
                        }
                    } else {
                        //rate plan trigger code is null for the offer record
                        if (sBoltOnTrigger != &quot;&quot; &amp;&amp; sBoltOnTrigger != null) {
                            //if bolt on trigger code is of plan then consider flags else dont
                            bcName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA MSP Product Struct Details&quot;);
                            with (bcName) {
                                ClearToQuery();
                                ActivateField(&quot;Primary Product Flag&quot;);
                                ActivateField(&quot;Child Vendor Part Num&quot;);
                                SetViewMode(AllView);
                                SetSearchExpr(&quot;[Primary Product Flag] = &apos;Y&apos; AND [Child Vendor Part Num]=&apos;&quot;+sBoltOnTrigger+&quot;&apos;&quot;);
                                ExecuteQuery(ForwardOnly);
                                if (FirstRecord()) {
                                    if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                        sReturn = &quot;Invalid&quot;;
                                    else if (SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;)
                                        sReturn = &quot;Valid&quot;;
                                    else if (SimOnlyFlag == &quot;Y&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;) {
                                        //SIMO Order with plan will get offer.Order should not contain any device
                                        if (orderDeviceCode != &quot;&quot; &amp;&amp; orderDeviceCode != null)
                                            sReturn = &quot;Invalid&quot;;
                                        else
                                            sReturn = &quot;Valid&quot;;
                                    } else {
                                        //(SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;Y&quot;)
                                        if (orderDeviceCode != &quot;&quot; &amp;&amp; orderDeviceCode != null)
                                            sReturn = &quot;Valid&quot;;
                                        else
                                            sReturn = &quot;Invalid&quot;;
                                    }
                                } else {
                                    sReturn = &quot;Valid&quot;;
                                }
                            }
                        } else {
                            //plan code is null and bolton is null
                            sReturn = &quot;Valid&quot;;
                        }
                    }
                }
            } else {
                if (SimOnlyFlag == &quot;N&quot; &amp;&amp; DeviceOnlyFlag == &quot;N&quot;)
                    sReturn = &quot;Valid&quot;;
            }
        }
        Outputs.SetProperty(&quot;Status&quot;,sReturn);
    } //end try
    catch (e) {
        
        throw (e);
    } //end catch
    finally {
       
        orderPlanConstruct = null;
        orderDeviceCode = null;
        bcName = null;
    }
}
"
			   SEQUENCE="19"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="04/29/2026 01:04:25"
			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fntoCamelCase"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fntoCamelCase(Inputs, Outputs)
{
	try
	{
		var str = Inputs.GetProperty(&quot;String&quot;);
		var aStr = str.split(&quot; &quot;);
		var sResult = &quot;&quot;;
		Outputs.SetProperty(&quot;Result&quot;, &quot;&quot;);
		
		for(var i = 0; i &lt; aStr.length; i++)
		{
			if(i == 0)
				sResult = aStr[i][0].toUpperCase() + aStr[i].substring(1).toLowerCase();
			else
				sResult = sResult + &quot; &quot; + aStr[i][0].toUpperCase() + aStr[i].substring(1).toLowerCase();
		} 
		Outputs.SetProperty(&quot;Result&quot;, sResult);
	}
	catch(e)
	{
		throw e;
	}
}"
