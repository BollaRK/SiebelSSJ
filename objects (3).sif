			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckCustActiveVoiceService"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckCustActiveVoiceService (Inputs,Outputs)//VHA Balamurugan -17/03/2020 - Added for R20.1 -ShipmentAddressCR
{
	try
	{
		var sAccountId = Inputs.GetProperty(&quot;Account Id&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Resource Mgmt Active MSISDN BC&quot;);
		var sActiveServiceExist = &quot;N&quot;;
		if(sAccountId != &quot;&quot;)
		{
			with(sBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Service Accnt Id&quot;);
				var SerachExpr = &quot;[Service Accnt Id] = &apos;&quot;+sAccountId+&quot;&apos;&quot;;
				SetSearchExpr(SerachExpr);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sActiveServiceExist = &quot;Y&quot;;							
				}
			}
		}
		Outputs.SetProperty(&quot;ActiveServiceExist&quot;,sActiveServiceExist);
	}	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
