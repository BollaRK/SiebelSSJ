			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSIMAttributes"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSIMAttributes(Inputs, Outputs)
{
	try
	{
		var sSMDPLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ESIM_ATTRIB_NAME&quot;,&quot;SMDPPLUSAddress&quot;);
		var sActCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ESIM_ATTRIB_NAME&quot;,&quot;ActivationCode&quot;);
		var sAssetId = Inputs.GetProperty(&quot;Asset Id&quot;);
		var sSMDPServer, sActivationCode;
		
		var boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var bcAssetXA = boAsset.GetBusComp(&quot;VF Resource Mgmt - SIM XA&quot;);
		bcAssetXA.ActivateField(&quot;Text Value&quot;);
		bcAssetXA.ActivateField(&quot;Name&quot;);
		bcAssetXA.ClearToQuery();
		bcAssetXA.SetSearchExpr(&quot;[Object Id] = &apos;&quot;+sAssetId+&quot;&apos;&quot;);
		bcAssetXA.ExecuteQuery();
		var IsRecord = bcAssetXA.FirstRecord();
		while(IsRecord)
		{
			if(bcAssetXA.GetFieldValue(&quot;Name&quot;) == sSMDPLOV)
			{
				sSMDPServer = bcAssetXA.GetFieldValue(&quot;Text Value&quot;);
			}	
			else if(bcAssetXA.GetFieldValue(&quot;Name&quot;) == sActCode)
			{
				sActivationCode = bcAssetXA.GetFieldValue(&quot;Text Value&quot;);
			}
			IsRecord = bcAssetXA.NextRecord();
		}
		Outputs.SetProperty(&quot;ActivationCode&quot;,sActivationCode);
		Outputs.SetProperty(&quot;SMDPPLUSAddress&quot;,sSMDPServer);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcAssetXA = null;
		boAsset = null;
	}
}"
