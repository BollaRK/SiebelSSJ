			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetSIMOFlg"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnGetSIMOFlg(Inputs,Outputs)
{
	var ratePlanCode = Inputs.GetProperty(&quot;RatePlanCd&quot;);
	Outputs.SetProperty(&quot;SIMOFlg&quot;,&quot;N&quot;);
	var sBC=null,prodLineName=&quot;&quot;,isRecord=null;
	try
	{
		sBC = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;FINS ISS Products&quot;);
		prodLineName = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_RELEASE_SWITCH&quot;, &quot;NEWCONSTRUCTProdLine&quot;);
		if(ratePlanCode != null &amp;&amp; ratePlanCode != &quot;&quot;)
		{
			with(sBC)
			{
				ActivateField(&quot;Product Line Name&quot;);
				ActivateField(&quot;Product SAM Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Product SAM Id&quot;, ratePlanCode);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					isRecord = FirstRecord();
					while(isRecord)
					{
						if(GetFieldValue(&quot;Product Line Name&quot;) == prodLineName)
						{
							Outputs.SetProperty(&quot;SIMOFlg&quot;,&quot;Y&quot;);
							break;
						}
						isRecord = NextRecord();
					}
				}

			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBC = null;
		prodLineName = null;
		isRecord=null;
	}

}
"
