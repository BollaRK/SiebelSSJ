			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateSIMTypeandConfirCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateSIMTypeandConfirCode(Inputs, Outputs)
{
 //balajiM added for updating the simtype and confirmation code in LineItem Level for all order types
try
{
    var sOrderItemBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
    var sOrderItemBC = sOrderItemBO.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
    var sOrderEntBO = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
    var sOrderEntBC = sOrderEntBO.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
    var eSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;eSIM&quot;);
    var sRootItemId = Inputs.GetProperty(&quot;RootItemId&quot;);
    var sConfirCode = Inputs.GetProperty(&quot;ConfirCode&quot;);
    var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
    var sExistConfirCode = &quot;&quot;;
		
        if(sRootItemId != &quot;&quot; &amp;&amp; sRootItemId != null)
		{
				with(sOrderItemBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
	                ActivateField(&quot;Shipping&quot;);
	                ActivateField(&quot;VHA Confirmation Code&quot;);
	                ActivateField(&quot;Parent Order Item Id&quot;);
					SetSearchSpec(&quot;Id&quot;, sRootItemId);
	                SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
	                   sExistConfirCode = GetFieldValue(&quot;VHA Confirmation Code&quot;);
					   SetFieldValue(&quot;Shipping&quot;, eSIMType);
	                   WriteRecord();
	                }				
				}
		}
		if((sExistConfirCode == &quot;&quot; || sExistConfirCode == null) &amp;&amp; (sConfirCode != &quot;&quot; &amp;&amp; sConfirCode != null))
        {
           with(sOrderEntBC)
           {
           		ClearToQuery();
				SetViewMode(AllView);
		        ActivateField(&quot;VHA Confirmation Code&quot;);
				SetSearchSpec(&quot;Id&quot;, sOrderId);
                ExecuteQuery(ForwardOnly);
                if(FirstRecord())
                {
                	SetFieldValue(&quot;VHA Confirmation Code&quot;, sConfirCode);
                    WriteRecord();
                }  
            }
         }
		
}
catch(e)
{
 throw(e);
}
finally
{
 sOrderItemBC = null;
 sOrderEntBC = null;
 sOrderItemBO = null;
 sOrderEntBO = null;
}
}"
