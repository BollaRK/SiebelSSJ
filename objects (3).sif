			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fUpdateSeqNdDiscount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fUpdateSeqNdDiscount(Inputs, Outputs) 
{
    var sOrderId = &quot;&quot;,sDiscountId = &quot;&quot;,dTempDate=null,strTimeStamp=&quot;&quot;,iRecord = null,boOrder = null,sBCOrder = null,bcOrderLineIt = null,rtAct=&quot;&quot;,itmAct=&quot;&quot;,rtItemAct=&quot;&quot;,vRequestAction=&quot;&quot;,rootId = &quot;&quot;,itemIntegId = &quot;&quot;,newSeq = &quot;&quot;,assetPrice = 0,newPrice = &quot;&quot;;
    try 
	{
		dTempDate = new Date;
		strTimeStamp = ToString(dTempDate.getMonth() + 1);
		strTimeStamp = strTimeStamp + &quot;/&quot; + ToString(dTempDate.getDate());
		strTimeStamp = strTimeStamp + &quot;/&quot; + ToString(dTempDate.getFullYear());
		strTimeStamp = strTimeStamp + &quot; &quot; + ToString(dTempDate.getHours());
		strTimeStamp = strTimeStamp + &quot;:&quot; + ToString(dTempDate.getMinutes());
		strTimeStamp = strTimeStamp + &quot;:&quot; + ToString(dTempDate.getSeconds());
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        rootId = Inputs.GetProperty(&quot;RootItemId&quot;);
        itemIntegId = Inputs.GetProperty(&quot;ItemIntegId&quot;);
        newSeq = Inputs.GetProperty(&quot;NewSequence&quot;);
        newPrice = Inputs.GetProperty(&quot;NewPrice&quot;);
		vRequestAction = Inputs.GetProperty(&quot;RequestAction&quot;);
		boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
        sBCOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
        bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
        with (sBCOrder) 
		{
			ClearToQuery();
            SetViewMode(AllView);
            SetSearchSpec(&quot;Id&quot;, sOrderId);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) 
			{
				with (bcOrderLineIt) 
				{
                    if (newSeq != null) 
					{
                        ActivateField(&quot;Order Header Id&quot;);
                        ActivateField(&quot;VHA Sequence&quot;);
						ActivateField(&quot;Action Code&quot;);
						ActivateField(&quot;VHA MSP Applied Date&quot;);
                        ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + rootId + &quot;&apos;&quot;);
                        ExecuteQuery(ForwardOnly);
                        if (FirstRecord()) 
						{
							rtAct = GetFieldValue(&quot;Action Code&quot;);
							if(rtAct == &quot;Update&quot; || rtAct == &quot;-&quot; || rtAct == &quot;Existing&quot;)
								SetFieldValue(&quot;Action Code&quot;, &quot;Update&quot;);
                            SetFieldValue(&quot;VHA Sequence&quot;, newSeq);
							if(newSeq)
								SetFieldValue(&quot;VHA MSP Applied Date&quot;,strTimeStamp);
							else
								SetFieldValue(&quot;VHA MSP Applied Date&quot;,&quot;&quot;);
                            WriteRecord();
                        }
                    }
                    if (vRequestAction != &quot;Delete&quot;) 
					{
                        ActivateField(&quot;Order Header Id&quot;);
                        ActivateField(&quot;Integration Id&quot;);
                        ActivateField(&quot;Net Price&quot;);
						ActivateField(&quot;Adjusted List Price&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
                        ActivateField(&quot;Base Price&quot;);
						ActivateField(&quot;Action Code&quot;);
						ActivateField(&quot;VHA Siebel Product Type&quot;);
						ActivateField(&quot;Root Item Action Code&quot;);
						ActivateField(&quot;Cfg State Code&quot;);
						ActivateField(&quot;Asset Base Price&quot;);//07052025:Soumalya:CM-3515:Added new join field to pull the asset price details
                        ClearToQuery();
                        SetViewMode(AllView);
						if(itemIntegId != &quot;&quot; &amp;&amp; itemIntegId != null)
							SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Integration Id] = &apos;&quot; + itemIntegId + &quot;&apos;&quot;);
						else
							SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + rootId + &quot;&apos; AND [VHA Siebel Product Type] = &apos;MSP Discount&apos;&quot;);
                        ExecuteQuery(ForwardOnly);
                        if (FirstRecord()) 
						{
							itmAct = GetFieldValue(&quot;Action Code&quot;);
							rtItemAct = GetFieldValue(&quot;Root Item Action Code&quot;);
							assetPrice = GetFieldValue(&quot;Asset Base Price&quot;);//07052025:Soumalya:CM-3515:Added new join field to pull the asset price details
							if(vRequestAction != &quot;Add&quot;)
							{
								if((rtItemAct == &quot;Update&quot; || rtItemAct == &quot;-&quot; || rtItemAct == &quot;Existing&quot;) &amp;&amp; (itmAct != &quot;Add&quot; &amp;&amp; itmAct != &quot;New&quot;))
								{
									if(ToNumber(assetPrice) != ToNumber(newPrice))
									{
										SetFieldValue(&quot;Action Code&quot;, &quot;Update&quot;);
									}
								}
							}
                            SetFieldValue(&quot;Net Price&quot;, newPrice);
                            SetFieldValue(&quot;Base Price&quot;, newPrice);
							SetFieldValue(&quot;Adjusted List Price&quot;, newPrice);
							SetFieldValue(&quot;Cfg State Code&quot;,&quot;Engine Picked Item&quot;);
                            WriteRecord();
                        }
                    }
                }
            }
        }
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		sOrderId = null;
	    sDiscountId = null;
	    iRecord = null;
	    boOrder = null;
	    sBCOrder = null;
	    bcOrderLineIt = null;
	    rootId = null;
	    itemIntegId = null;
	    newSeq = null;
	    newPrice = null;
		dTempDate=null;
		strTimeStamp=null;
		rtItemAct=null;
		vRequestAction = null;
		assetPrice = null;
	}
}"
			   SEQUENCE="7"
