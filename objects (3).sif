			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncSimTypeForHandsetImport"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSyncSimTypeForHandsetImport(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VF Handset Matrix&quot;);
		var oUniqueHandsetBC = oBO.GetBusComp(&quot;VF Unique Handset&quot;);
		var sUniqueRecExist = &quot;&quot;, sSIMType = &quot;&quot;, sProductCode = &quot;&quot;;
		var sVersionId = Inputs.GetProperty(&quot;VersionId&quot;);
		with(oUniqueHandsetBC)
		{
			ActivateField(&quot;Product Code&quot;);
			ActivateField(&quot;SIMType&quot;);
			ActivateField(&quot;Version Status&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Version Status] = &apos;Live&apos; AND [SIMType] IS NOT NULL&quot;);
			ExecuteQuery(ForwardOnly);
			sUniqueRecExist = FirstRecord();
			while(sUniqueRecExist)
			{
				sProductCode = GetFieldValue(&quot;Product Code&quot;);
				sSIMType = GetFieldValue(&quot;SIMType&quot;);
				
				if((sSIMType != &quot;&quot; &amp;&amp; sSIMType != null) &amp;&amp; (sProductCode != &quot;&quot; &amp;&amp; sProductCode != null) &amp;&amp; (sVersionId != &quot;&quot; &amp;&amp; sVersionId != null))
				{
					var sSIMTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HANDSET_SIM_TYPE&quot;, sSIMType);
					if(sSIMType == sSIMTypeLOV)
					{
						mUpdateSIMTypeinUniqueHandsetDraftVersion(sProductCode, sSIMType, sVersionId);
					}
				}		
				sUniqueRecExist = NextRecord();
			}
		}			
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oUniqueHandsetBC = null;
		oBO = null;
	}
}"
			   SEQUENCE="25"
			   UPDATED="06/28/2024 18:49:05"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 20:19:57"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncSimTypeForHandsetMatrix"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSyncSimTypeForHandsetMatrix(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oLiveBC = oBO.GetBusComp(&quot;VF Handset Matrix Version&quot;);
		var oUniqueHandsetBC = oBO.GetBusComp(&quot;VF Unique Handset&quot;);
		var oHandsetBC = oBO.GetBusComp(&quot;VF Handset Matrix&quot;);
		var sLiveRecExist = &quot;&quot;, sVersionId = &quot;&quot;, sUniqueRecExist = &quot;&quot;, sSIMType = &quot;&quot;, sProductCode = &quot;&quot;, sHandsetRecExist = &quot;&quot;;
		sVersionId = Inputs.GetProperty(&quot;Record Id&quot;);
		
		if(sVersionId != &quot;&quot; &amp;&amp; sVersionId != null)
		{
		with(oUniqueHandsetBC)
		{
			ActivateField(&quot;Product Code&quot;);
			ActivateField(&quot;SIMType&quot;);
			ActivateField(&quot;Version Id&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[SIMType] IS NOT NULL AND [Version Id] = &apos;&quot;+sVersionId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			sUniqueRecExist = FirstRecord();
			while(sUniqueRecExist)
			{
				sProductCode = GetFieldValue(&quot;Product Code&quot;);
				sSIMType = GetFieldValue(&quot;SIMType&quot;);
			
				with(oHandsetBC)
				{
					ActivateField(&quot;Product Code&quot;);
					ActivateField(&quot;SIMType&quot;);
					ActivateField(&quot;Parent Row Id&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Product Code] = &apos;&quot;+sProductCode+&quot;&apos; AND [Parent Row Id] = &apos;&quot;+sVersionId+&quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					sHandsetRecExist = FirstRecord();
					while(sHandsetRecExist)
					{						
						SetFieldValue(&quot;SIMType&quot;, sSIMType);
						sHandsetRecExist = NextRecord();						
					}
					WriteRecord();
				}
				sUniqueRecExist = NextRecord();
			}
		}
		}		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oHandsetBC = null;
		oUniqueHandsetBC = null;
		oLiveBC = null;
		oBO = null;
	}
}"
			   SEQUENCE="26"
			   UPDATED="06/28/2024 18:49:05"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 20:19:57"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateCommentsSIMSWap"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateCommentsSIMSWap(Inputs,Outputs)
{
try
{
	        var SIMSWapId = Inputs.GetProperty(&quot;VF SIMSwap TBC Id&quot;); //SIMSwap TBCID 
			var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
            var ServiceOrderId = Inputs.GetProperty(&quot;OrderItemId&quot;); //Upgrade SIMSwap Modify Service OrderId 
            var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var sAttBC = sOrderBO.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);
			var sOrderBC = sOrderBO.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
            var sComment = &quot;&quot;; 
            if(SIMSWapId != &quot;&quot; &amp;&amp; sOrderId != &quot;&quot;) //updating Comments for SIMSwap 
            { 
			    with(sAttBC)
			    {
			        ActivateField(&quot;SourceOrderId&quot;);
					ActivateField(&quot;Comment&quot;);
					ActivateField(&quot;SourceFileName&quot;);
	                ClearToQuery();
					SetViewMode(AllView);
		 		    SetSearchSpec(&quot;SourceOrderId&quot;, SIMSWapId);
					ExecuteQuery(ForwardOnly);
					var irec = FirstRecord();
					while(irec)
					 {
						  var Email  = GetFieldValue(&quot;Comment&quot;);
						  var QRFile = GetFieldValue(&quot;SourceFileName&quot;);
						  var sFileExt = GetFieldValue(&quot;SourceFileExt&quot;);
						  var Comment = &quot;Email: &quot;+Email+&quot;, FileName:&quot;+QRFile;
						  with(sOrderBC)
						  {
							  ActivateField(&quot;Parent Order Item Id&quot;);
							  ActivateField(&quot;VF Comments&quot;);
							  ClearToQuery();
					          SetViewMode(AllView);
		 		              SetSearchSpec(&quot;Order Id&quot;, sOrderId);
							  SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
							  ExecuteQuery(ForwardOnly);
					          if(FirstRecord())
							  {
							      var sOrderComm = GetFieldValue(&quot;VF Comments&quot;);
							      sComment = sOrderComm+&quot;: &quot;+Comment;
								  SetFieldValue(&quot;VF Comments&quot;, sComment);
	                              WriteRecord();
							  }
					     }
	                   irec = NextRecord();
	                 }
                  }
               }
			   
			   if(ServiceOrderId != &quot;&quot; &amp;&amp; sOrderId != &quot;&quot;) //updating comments for upgrade SIMSwap 
			   {
				    with(sAttBC)
			        {
			        ActivateField(&quot;Source Id&quot;);
					ActivateField(&quot;SourceOrderId&quot;);
					ActivateField(&quot;Comment&quot;);
					ActivateField(&quot;SourceFileName&quot;);
	                ClearToQuery();
					SetViewMode(AllView);
		 		    SetSearchSpec(&quot;Source Id&quot;, ServiceOrderId);
					ExecuteQuery(ForwardOnly);
					var irec = FirstRecord();
					while(irec)
					 {
						  var Email  = GetFieldValue(&quot;Comment&quot;);
						  var QRFile = GetFieldValue(&quot;SourceFileName&quot;);
						  var sFileExt = GetFieldValue(&quot;SourceFileExt&quot;);
						  var ModifyOrderId = GetFieldValue(&quot;SourceOrderId&quot;);
						  var Comment = &quot;Email: &quot;+Email+&quot;, FileName:&quot;+QRFile;
						  with(sOrderBC)
						  {
							  ActivateField(&quot;Parent Order Item Id&quot;);
							  ActivateField(&quot;VF Comments&quot;);
                              ActivateField(&quot;VF SIM Swap Request Pending&quot;);
							  ClearToQuery();
					          SetViewMode(AllView);
		 		              SetSearchSpec(&quot;Order Id&quot;, sOrderId);
							  SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;&quot;);
							  ExecuteQuery(ForwardOnly);
					          if(FirstRecord())
							  {
							      var sOrderComm = GetFieldValue(&quot;VF Comments&quot;);
							      sComment = sOrderComm+&quot;: &quot;+Comment;
								  SetFieldValue(&quot;VF Comments&quot;, sComment);
	                              WriteRecord();
							  }
					     }
	                   irec = NextRecord();
	                 }
				   
			   }
			   }
}
catch(e)
{
throw(e);
}
finally
{
	 sOrderBO = null;
	 sAttBC  = null;
	 sOrderBC = null;
}
}"
