			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="PretoPostDefault"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function PretoPostDefault(Inputs, Outputs)
{
	var boResourceMgmtRel;
	var bcAssetMgmtMSISDNRel;
	var bcAssetMgmtSIMRel;
	var strAccountId;
	var strMSISDN,strpretopostMSISDN;
	var strSIM;
	var strAssetId;
	var strMsisdnAssetId = &quot;&quot;;
	
	try
	{		
		//*****************************
		//* Get Account Id off Session
		//*****************************		
		strAccountId = Inputs.GetProperty(&quot;Account Id&quot;);
		strpretopostMSISDN = Inputs.GetProperty(&quot;PretoPostMSISDN&quot;);

		
		if (strAccountId != &quot;&quot;)
		{
			//**************************
			//* Get MSISDN
			//MURALIDHARANK 26/09/2014 Defect 2856 Added to Change the BO and BC for Query
			//**************************			
			boResourceMgmtRel    = TheApplication().GetBusObject(&quot;VF Generic TBUI BO&quot;);
			bcAssetMgmtMSISDNRel = boResourceMgmtRel.GetBusComp(&quot;VF Resource Mgmt MSISDN Search TBUI&quot;);

			// Query for an Active Relationship
			with(bcAssetMgmtMSISDNRel)
			{
				ClearToQuery();
				ActivateField(&quot;Payment Method&quot;);
				ActivateField(&quot;Installed Asset Id&quot;);
				ActivateField(&quot;Resource Id&quot;);
				ActivateField(&quot;Service Account Id&quot;);
				ActivateField(&quot;Relationship Status&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Relationship Status&quot;, &quot;Active&quot;);
				SetSearchSpec(&quot;Asset Number&quot;, strpretopostMSISDN);
				SetSearchSpec(&quot;Service Account Id&quot;, strAccountId);
				ExecuteQuery(ForwardOnly);

				if(FirstRecord())
				{
					strMSISDN  = GetFieldValue(&quot;Asset Number&quot;);
					strAssetId = GetFieldValue(&quot;Installed Asset Id&quot;);
					strMsisdnAssetId = GetFieldValue(&quot;Resource Id&quot;);
				}
			}
			
			//**************************
			//* Get SIM	
			//**************************
			bcAssetMgmtSIMRel = boResourceMgmtRel.GetBusComp(&quot;VF Resource Mgmt SIM Search TBUI&quot;);

			// Query for an Active Relationship
			with(bcAssetMgmtSIMRel)
			{			
				ClearToQuery();
				ActivateField(&quot;Installed Asset Id&quot;);
				ActivateField(&quot;Relationship Status&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Installed Asset Id&quot;, strAssetId);
				SetSearchSpec(&quot;Relationship Status&quot;, &quot;Active&quot;);
				ExecuteQuery(ForwardOnly);

				if (FirstRecord())
					strSIM = bcAssetMgmtSIMRel.GetFieldValue(&quot;Asset Number&quot;);
			}
				Outputs.SetProperty(&quot;MSISDN&quot;,strMSISDN);
				Outputs.SetProperty(&quot;SIM&quot;,strSIM);
				Outputs.SetProperty(&quot;AssetId&quot;,strAssetId);
				Outputs.SetProperty(&quot;MSISDNAssetId&quot;,strMsisdnAssetId);
		}		
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	//	bcSession = null;
		bcAssetMgmtMSISDNRel = null;
		bcAssetMgmtSIMRel = null;
		boResourceMgmtRel = null;
	//	boSession = null;
	}
}"
			   SEQUENCE="29"
