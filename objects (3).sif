			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckPostPayBillingExists"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckPostPayBillingExists(Inputs, Outputs)
{
	try
	{  
			var sAcntId = Inputs.GetProperty(&quot;AccountId&quot;);	
			var sRecFound = &quot;N&quot;;var isRec =&quot;&quot;;			
			if (sAcntId !=&quot;&quot;)
			{				
				var sAcntBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		 		var sAcntBC = sAcntBO.GetBusComp(&quot;VF Billing Account TBUI&quot;);					
				with(sAcntBC)
		 		{	 	
					SetViewMode(AllView);
					ClearToQuery();								
					SetSearchSpec(&quot;Master Account Id&quot;, sAcntId);
					SetSearchSpec(&quot;Account Type Code&quot;,&quot;Billing&quot;);
					SetSearchSpec(&quot;Payment Method&quot;, &quot;Postpay&quot;);									
					ExecuteQuery(ForwardOnly);					
					isRec = FirstRecord();				
					if (isRec) 	
					{	
					  sRecFound = &quot;Y&quot;;			  			
					}	
				}			
			}			
			Outputs.SetProperty(&quot;sRecFound&quot;, sRecFound);			
	
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sAcntBO = null;
		sAcntBC = null;

	}
}"
