			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateServiceOrderId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//29/05/2021: Added as part of P3 Tallyman issue:updating the service orderId before sendind xml.
function mUpdateServiceOrderId(Inputs, Outputs) {

	try {
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var bcOrder = sBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var boOrderItem = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;);
		var bcOrderItem = boOrderItem.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		var sServOrderRoot1, searchexpr,sServOrderRoot2, searchexpr1, searchexpr2, sServOrderRoot3;
		var sEqual = &quot;N&quot;;
		var sServOrderId;
		var sOrderType, sOrderFunct, sOrderTBUI, sFulOrderId;
		if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;) {
			with (sBC) {
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Service Order Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Order Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				var srec = FirstRecord();
				if (FirstRecord()) {
					sServOrderId = GetFieldValue(&quot;Service Order Id&quot;);

				}
			}
		}
		if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;) {
			with (bcOrder) {
				ActivateField(&quot;Id&quot;);
				ActivateField(&quot;Order Sub Type&quot;);
				ActivateField(&quot;VF Order Function&quot;);
				ActivateField(&quot;VF Order Type TBUI&quot;);
				ActivateField(&quot;VF Fulfilment Order Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				var srec = FirstRecord();
				if (FirstRecord()) {
					sOrderType = GetFieldValue(&quot;Order Sub Type&quot;);
					sOrderFunct = GetFieldValue(&quot;VF Order Function&quot;);
					sOrderTBUI = GetFieldValue(&quot;VF Order Type TBUI&quot;);
					sFulOrderId = GetFieldValue(&quot;VF Fulfilment Order Id&quot;);
				}

			}
		}
		if (sOrderFunct == &quot;Upgrade&quot; || sOrderFunct == &quot;UPGRADE&quot; || sOrderTBUI == &quot;New APP&quot;) {
			with (bcOrderItem) {
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				searchexpr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id]  IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
				SetSearchExpr(searchexpr);
				ExecuteQuery(ForwardOnly);
				var srec = FirstRecord();
				while (srec) {
					sServOrderRoot1 = GetFieldValue(&quot;Id&quot;);
					if (sServOrderId == sServOrderRoot1) {
						sEqual = &quot;Y&quot;;
						break;
					}
					srec = NextRecord();
				}
				if (sEqual == &quot;N&quot;) {
					with (sBC) {
						ActivateField(&quot;Order Id&quot;);
						ActivateField(&quot;Service Order Id&quot;);
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchSpec(&quot;Order Id&quot;, sOrderId);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord()) {
							SetFieldValue(&quot;Service Order Id&quot;, sServOrderRoot1);
							WriteRecord();

						}
					}
				}
			}
		}
		if (sOrderType == &apos;Connect&apos;) {
			with (bcOrderItem) {
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				searchexpr1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
				SetSearchExpr(searchexpr1);
				ExecuteQuery(ForwardOnly);
				var srec1 = FirstRecord();
				while (srec1) {
					sServOrderRoot2 = GetFieldValue(&quot;Id&quot;);
					if (sServOrderId == sServOrderRoot2) {
						sEqual = &quot;Y&quot;;
						break;
					}
					srec1 = NextRecord();
				}
			}
			if (sEqual == &quot;N&quot; &amp;&amp; (sFulOrderId != null &amp;&amp; sFulOrderId != &quot;&quot;)) {
				with (bcOrderItem) {
					ActivateField(&quot;Order Header Id&quot;);
					ActivateField(&quot;Parent Order Item Id&quot;);
					ActivateField(&quot;Action Code&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					searchexpr2 = &quot;[Order Header Id] = &apos;&quot; + sFulOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
					SetSearchExpr(searchexpr2);
					ExecuteQuery(ForwardOnly);
					var srec2 = FirstRecord();
					while (srec2) {
						sServOrderRoot3 = GetFieldValue(&quot;Id&quot;);
						if (sServOrderId == sServOrderRoot3) {
							sEqual = &quot;Y&quot;;
							break;
						}
						srec2 = NextRecord();
					}
					if (sEqual == &quot;N&quot;) {
						with (sBC) {
							ActivateField(&quot;Order Id&quot;);
							ActivateField(&quot;Service Order Id&quot;);
							SetViewMode(AllView);
							ClearToQuery();
							SetSearchSpec(&quot;Order Id&quot;, sOrderId);
							ExecuteQuery(ForwardOnly);
							if (FirstRecord()) {
								SetFieldValue(&quot;Service Order Id&quot;, sServOrderRoot3);
								WriteRecord();
							}
						}
					}
				}
			}
			else if(sEqual == &quot;N&quot;){
				with (sBC) {
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;Service Order Id&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Order Id&quot;, sOrderId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord()) {
						SetFieldValue(&quot;Service Order Id&quot;, sServOrderRoot2);
						WriteRecord();
					}
				}
			}
		}
		Outputs.SetProperty(&quot;sServOrderId&quot;, sServOrderId);
		Outputs.SetProperty(&quot;sServOrderUpg&quot;, sServOrderRoot1);
		Outputs.SetProperty(&quot;sServOrderConnect&quot;, sServOrderRoot2);
		Outputs.SetProperty(&quot;sServOrderConnectFul&quot;, sServOrderRoot3);
	}

	catch (e) {
		throw (e);
	}

	finally {
		sOrderId = null;
		sOrderType = null;
		sOrderFunct = null;
		sOrderTBUI = null;
		sFulOrderId = null;
		sServOrderRoot1= null;
		searchexpr = null;
		sServOrderRoot2 = null;
		searchexpr1 = null;
		searchexpr2 = null;
		sServOrderRoot3 = null;
		sEqual = null;
		bcOrderItem = null;
		bcOrder = null;
		sBC = null;
		boOrderItem = null;
		sBO = null;
		

	}


}"
			   SEQUENCE="26"
			   UPDATED="06/18/2021 18:35:59"
			   UPDATED_BY="SADMIN"
			   CREATED="06/18/2021 18:35:59"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateTotalDevicePP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateTotalDevicePP (Inputs,Outputs)//VHA Muthushankari - 22/5/2019 - Added for R19.3 Prepayments to update Total Device Prepayment
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sMPPBC = sBO.GetBusComp(&quot;VF MPP Order Smartscript Support - TBUI&quot;);
		var sPrepaymentsBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sTotalDevicePP = 0;
		var sTerm;
		var sContractAmt = 0;
		var sOrderFunction = Inputs.GetProperty(&quot;sOrderFunction&quot;);
		var SSJFlag = Inputs.GetProperty(&quot;SSJFlag&quot;);
		var sTotalPPAmt = Inputs.GetProperty(&quot;PrepaymentUpfront&quot;);//ToNumber(sPrepaymentsTBC.GetFieldValue(&quot;Ready To Pay Upfront&quot;));
		var sAccessoryPP = Inputs.GetProperty(&quot;PrepaymentAccessoryAmount&quot;);//ToNumber(sPrepaymentsTBC.GetFieldValue(&quot;Total APP Prepayment&quot;));
		var sRemPPAmt = sTotalPPAmt - sAccessoryPP;
		var sAPPAmt = &quot;&quot;;
		var sMPPActiveFlag = &quot;Y&quot;;
		var ssjFlow = TheApplication().GetProfileAttr(&quot;SSJFlow&quot;);//Update for Defect cm-8035,Krishna	
		var sMinConAmt = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Minimum GPP Contract Amount&quot;);
		if(sTotalPPAmt &gt; 0)
		{
			if(sOrderFunction == &quot;UPGRADE&quot; &amp;&amp; SSJFlag == &quot;Y&quot;)
			{
				/*with(sPrepaymentsBC)
				{
					ActivateField(&quot;Total Prepayment&quot;);
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;PP Amount Paid Upfront&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);// SureshG -  Added MPP Active condition for 19.3 to handle NBN scenarios
					//SetSortSpec();
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sTotalDevicePP = ToNumber(GetFieldValue(&quot;Total Prepayment&quot;));
						sRemPPAmt = ToNumber(GetFieldValue(&quot;PP Amount Paid Upfront&quot;));
					}
					
				}*/
				sTotalDevicePP= sRemPPAmt;
			}
			else
			{
				with(sMPPBC)
				{
					ActivateField(&quot;MPP Pay To Dealer&quot;);
					ActivateField(&quot;MPP Contract Amount&quot;);
					ActivateField(&quot;MPP Contract Months&quot;);
					ActivateField(&quot;MPP Active&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [MPP Active] = &apos;&quot;+sMPPActiveFlag+&quot;&apos;&quot;);// SureshG -  Added MPP Active condition for 19.3 to handle NBN scenarios
					ExecuteQuery(ForwardOnly);
					var sIsRecord = FirstRecord();
					while(sIsRecord)
					{
						if(ToNumber(GetFieldValue(&quot;MPP Contract Amount&quot;)) &lt; ToNumber(sMinConAmt) &amp;&amp; ToNumber(GetFieldValue(&quot;MPP Contract Amount&quot;)) &gt; 0)// Modified the condition for SIT Defect Prepayments - SureshG
							TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_010&quot;));
						if(ToNumber(GetFieldValue(&quot;MPP Contract Amount&quot;)) != 0 &amp;&amp; (ToNumber(GetFieldValue(&quot;MPP Contract Months&quot;)) == 0 &amp;&amp; GetFieldValue(&quot;MPP Contract Months&quot;) != &quot;&quot;)) //Changed by balajiM for rel19.3 SIT defect#
							TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_008&quot;));
						if(ToNumber(GetFieldValue(&quot;MPP Contract Amount&quot;)) == 0 &amp;&amp; ToNumber(GetFieldValue(&quot;MPP Contract Months&quot;)) != 0)
						{
							if(SSJFlag==&quot;Y&quot;){}
							else{
							TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_009&quot;));
							}
						}
						if(ToNumber(sTotalPPAmt) &lt; ToNumber(GetFieldValue(&quot;MPP Pay To Dealer&quot;)))
							TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_011&quot;));
						sTotalDevicePP = ToNumber(sTotalDevicePP) + ToNumber(GetFieldValue(&quot;MPP Pay To Dealer&quot;));
						sIsRecord = NextRecord();
					}
				}
			}
			sTotalDevicePP = sTotalDevicePP.toFixed(2);
			sRemPPAmt = sRemPPAmt.toFixed(2);
				TheApplication().SetProfileAttr(&quot;Amnt3&quot;,sTotalDevicePP+sRemPPAmt);
			//TheApplication().SetProfileAttr(&quot;Amnt4&quot;,GetFieldValue(&quot;MPP Pay To Dealer&quot;));
			if(ToNumber(sTotalDevicePP) &lt; ToNumber(sRemPPAmt))
			{
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_004&quot;,sRemPPAmt));
			}
					
			with(sPrepaymentsBC)
			{
				ActivateField(&quot;Total Device PP Amount Paid Upfront&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					SetFieldValue(&quot;Total Device PP Amount Paid Upfront&quot;,sTotalDevicePP);
					WriteRecord();
				}
			}
		}
		
		else // Added this block for 19.3 SIT Defect - SureshG
		{
			with(sMPPBC)
			{
				ActivateField(&quot;MPP Pay To Dealer&quot;);
				ActivateField(&quot;MPP Contract Amount&quot;);
				ActivateField(&quot;MPP Contract Months&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				var sIsRecord1 = FirstRecord();
				while(sIsRecord1)
				{
                     if(GetFieldValue(&quot;MPP Contract Amount&quot;) != 0 &amp;&amp; (GetFieldValue(&quot;MPP Contract Months&quot;) == 0 &amp;&amp; GetFieldValue(&quot;MPP Contract Months&quot;) != &quot;&quot;))
						TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_008&quot;)); //Added by BalajiM for Defect#76
					if(ToNumber(GetFieldValue(&quot;MPP Pay To Dealer&quot;)) &gt; 0 &amp;&amp;  ToNumber(GetFieldValue(&quot;MPP Pay To Dealer&quot;)) != &quot;&quot; &amp;&amp; ToNumber(GetFieldValue(&quot;MPP Pay To Dealer&quot;)) != null)
					{
						TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_011&quot;));
					}
					
					sIsRecord1 = NextRecord();
				}
		
			}
		}
			
		
		Outputs.SetProperty(&quot;DevicePPAmtAllocated&quot;, sTotalDevicePP);
		
		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sMPPBC = null;
		sPrepaymentsBC = null;
		sBO = null;
		sAPPAmt = null;
		sMPPActiveFlag = null;
		ssjFlow = null;
	}
}"
			   SEQUENCE="27"
