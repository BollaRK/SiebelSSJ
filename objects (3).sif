			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fQueryBusComp"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fQueryBusComp(Inputs,Outputs)
{
	var sBuscomp=&quot;&quot;,sBusobject=&quot;&quot;,boActive=null,bcActive=null,delimiter = &quot;&quot;,fieldNameList=&quot;&quot;,fieldNameArr=null,searchExp=&quot;&quot;;
	try
	{
		sBuscomp = Inputs.GetProperty(&quot;BusCompName&quot;);
		sBusobject = Inputs.GetProperty(&quot;BusObjectName&quot;);
		delimiter=Inputs.GetProperty(&quot;Delimeter&quot;);
		if(delimiter == &quot;&quot; || delimiter == null)
			delimiter = &quot;;&quot;;
		fieldNameList = Inputs.GetProperty(&quot;FieldName&quot;);
		searchExp = Inputs.GetProperty(&quot;SearchExp&quot;);
		boActive = TheApplication().GetBusObject(sBusobject);
		bcActive = boActive.GetBusComp(sBuscomp);	
		fieldNameArr = fieldNameList.split(delimiter);
		with (bcActive)
		{
			ClearToQuery();
			SetViewMode(AllView);
			for (var m=0;m&lt;fieldNameArr.length;m++)
			{
				ActivateField(fieldNameArr[m]);
			}
			SetSearchExpr(searchExp);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
				for(var k=0;k&lt;fieldNameArr.length;k++)
				{ 
					Outputs.SetProperty(fieldNameArr[k],GetFieldValue(fieldNameArr[k]));
				}
			}
			Outputs.SetProperty(&quot;NumAffRows&quot;,CountRecords());
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBuscomp=null;
		sBusobject=null;
		boActive=null;
		bcActive=null;
		delimiter = null;
		fieldNameList=null;
		fieldNameArr=null;
		searchExp=null;
	}
}







"
