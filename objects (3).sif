			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="createSFJOfferHistory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*************
09042026:Soumalya:Created BS to create offer history record for child orders. This method needs to be invoked for each
child order under a single parent quote.
*************/
function createSFJOfferHistory(Inputs, Outputs) 
{
    var sOrderId = &quot;&quot;, searchstr = &quot;&quot;, sAssetIntegrationId = &quot;&quot;, sLineId = &quot;&quot;, lineRec=null, 
	bsOfferManagement = null, psOffersIn = null, psOffersOut = null, bcOrderItem = null, 
	serviceCount =0, z=0, CreateBundleSave = &quot;No&quot;;
	var sCheckCalcCharges = &quot;Y&quot;, bsCheckCalcCharges = null, psInputs = null, psOutputs = null,sOrderBC = null;
	try 
	{
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			bcOrderItem = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;).GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
			with (bcOrderItem) 
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Custom Asset Integration Id&quot;);
				searchstr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
				SetSearchExpr(searchstr);
				ExecuteQuery(ForwardOnly);
				serviceCount = CountRecords();
				if (FirstRecord()) 
				{
					
					psOffersIn = TheApplication().NewPropertySet();
					psOffersOut = TheApplication().NewPropertySet();
					lineRec = FirstRecord();
					
					z = 0;
					while(lineRec)
					{
						z++;
						sLineId = GetFieldValue(&quot;Id&quot;);
						sAssetIntegrationId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
						if (z == serviceCount)
						{
							CreateBundleSave = &quot;Yes&quot;; 
						}
						psOffersIn.Reset();
						psOffersOut.Reset();
						psOffersIn.SetProperty(&quot;OrderId&quot;, sOrderId);
						psOffersIn.SetProperty(&quot;AssetIntegrationId&quot;, sAssetIntegrationId);
						psOffersIn.SetProperty(&quot;Mandatory Offer Flag&quot;, &quot;Y&quot;);
						psOffersIn.SetProperty(&quot;RootOrderItemId&quot;, sLineId);
						psOffersIn.SetProperty(&quot;CreateBundleSave&quot;, CreateBundleSave);
						bsOfferManagement = TheApplication().GetService(&quot;VF Offer Management&quot;);
						bsOfferManagement.InvokeMethod(&quot;Find Available And Invalid Offers&quot;, psOffersIn, psOffersOut);
						lineRec = NextRecord();
						bsOfferManagement = null;
					}
				}
            }
			bsCheckCalcCharges = TheApplication().GetService(&quot;VF Calculate Charges Service MSO&quot;);
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
			psOutputs.SetProperty(&quot;Run Calculate Charges&quot;, &quot;Y&quot;);
			bsCheckCalcCharges.InvokeMethod(&quot;CheckIfCalcChargesValid&quot;, psInputs, psOutputs);
        
			if (psOutputs.GetProperty(&quot;Run Calculate Charges&quot;) == &quot;N&quot;)
				sCheckCalcCharges = &quot;N&quot;;
			sOrderBC = TheApplication().GetBusObject(&quot;VF Order Header&quot;).GetBusComp(&quot;VF Order Header&quot;);
			with (sOrderBC) 
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;OfferVisitedFlag&quot;);
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery();
				if (FirstRecord()) 
				{
					SetFieldValue(&quot;OfferVisitedFlag&quot;, &quot;Y&quot;);
					WriteRecord();
				}
			}
			if (sCheckCalcCharges == &quot;N&quot;)
                bsCheckCalcCharges.InvokeMethod(&quot;UpdateCalcDateTime&quot;, psInputs, psOutputs);
		}
    } 
	catch (e) 
	{
       throw (e);
    } 
	finally 
	{
        sOrderId = null;
		searchstr = null;
		sAssetIntegrationId = null;
		sLineId = null;
		lineRec=null;
		bsOfferManagement = null;
		psOffersIn = null;
		psOffersOut = null;
		bcOrderItem = null;
		sCheckCalcCharges = null;
		bsCheckCalcCharges = null;
		psInputs = null;
		psOutputs = null;
		sOrderBC = null;
    }
}
"
			   SEQUENCE="8"
