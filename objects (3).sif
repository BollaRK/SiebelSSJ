			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="FindQuotePromoCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function FindQuotePromoCode(sRootQuoteItemId)
{

	try
	{
		
		var oQuoteItemBO = TheApplication().GetBusObject(&quot;Quote&quot;);
		var oQuoteItemBC = oQuoteItemBO.GetBusComp(&quot;Quote Item&quot;);
		//var oQuoteItemAttrBC = oQuoteItemBO.GetBusComp(&quot;Quote Item XA&quot;);
		var sQuotePromo= &quot;&quot;;
		with(oQuoteItemBC)
			{
				ClearToQuery();												
				ActivateField(&quot;Note&quot;);
				ActivateField(&quot;Id&quot;);	
				ActivateField(&quot;VF Promo Code&quot;);				
				SetViewMode(AllView);
				//SetSearchSpec(&quot;Quote Id&quot;, sQuoteId);
				SetSearchSpec(&quot;Id&quot;, sRootQuoteItemId);
				//SetSearchSpec(&quot;Note&quot;, &quot;Add&quot;);			
				ExecuteQuery(ForwardOnly);			
				if (FirstRecord())
				{								
					sQuotePromo = GetFieldValue(&quot;VF Promo Code&quot;);						
					TheApplication().SetProfileAttr(&quot;QuotePromo&quot;, sQuotePromo);
				}				
			}
		
		return (sQuotePromo);
		
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		//sLineBC = null;
		oQuoteItemBC = null; 
		//oQuoteItemAttrBC = null;
		oQuoteItemBO = null;
	}
}"
			   SEQUENCE="2"
			   UPDATED="06/28/2024 18:49:35"
			   UPDATED_BY="SADMIN"
			   CREATED="06/28/2024 18:49:35"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetInstockLineDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetInstockLineDetails( sOrderId, sRootItemId, &amp;sMSISDN, &amp;sAssetIntegId )
{

 
 try
 {
 	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VHA Sharing Simplification BS:GetInstockLineDetails&quot;);
	}
	var sBO = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
	var sBC = sBO.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
	var sProdTypeExpr = fnGetSearchExpr(&quot;VF Siebel Product Type&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;, &quot;AND&quot;);
	var sSearchExpr = &quot;[Order Header Id]=&apos;&quot; +sOrderId+&quot;&apos; AND [VF Out of Stock Indicator]=&apos;In Stock&apos; AND [Sharing Action] = &apos;Add Member&apos; AND [Parent Order Item Id] IS NULL&quot;;
	if(sProdTypeExpr != &quot;&quot;)
		sSearchExpr = sSearchExpr + &quot; AND &quot; +sProdTypeExpr;
	with(sBC)
	{
		ActivateField(&quot;MSISDN Calc&quot;);
		ActivateField(&quot;Asset Integration Id&quot;);
		ActivateField(&quot;VF Out of Stock Indicator&quot;);
		ActivateField(&quot;Custom Asset Integration Id&quot;);
		ActivateField(&quot;VF Service Order Sub Type&quot;);
		ActivateField(&quot;VF Siebel Product Type&quot;);
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchExpr(sSearchExpr);
		ExecuteQuery(ForwardOnly);
		if(FirstRecord())
		{
		sMSISDN = GetFieldValue(&quot;MSISDN Calc&quot;);
		if(GetFieldValue(&quot;VF Service Order Sub Type&quot;) == &quot;Change Proposition&quot;)
		{
			sAssetIntegId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
		}
		else
		{
			sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
		}
		}
		else
		{
			if(sRootItemId != &apos;&apos; &amp;&amp; sRootItemId != null)
			{
			sSearchExpr = &quot;[Order Header Id]=&apos;&quot; +sOrderId+&quot;&apos; AND [Root Order Item Id]=&apos;&quot; +sRootItemId+ &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
			if(sProdTypeExpr != &quot;&quot;)
			sSearchExpr = sSearchExpr + &quot; AND &quot; +sProdTypeExpr;
			ActivateField(&quot;MSISDN Calc&quot;);
			ActivateField(&quot;Asset Integration Id&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;Custom Asset Integration Id&quot;);
			ActivateField(&quot;VF Service Order Sub Type&quot;);
			ActivateField(&quot;VF Siebel Product Type&quot;);			
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchExpr(sSearchExpr);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
			sMSISDN = GetFieldValue(&quot;MSISDN Calc&quot;);
			if(GetFieldValue(&quot;VF Service Order Sub Type&quot;) == &quot;Change Proposition&quot;)
			{
				sAssetIntegId = GetFieldValue(&quot;Custom Asset Integration Id&quot;);
			}
			else
			{
				sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
			}
			}
			}	
		
		}
		
	}
	
	
 }
	catch (e)
	{
		throw e;
	}
	finally
	{
		sBC = null;
		sBO = null;
	
	}	
}"
