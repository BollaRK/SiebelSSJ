			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpfrontPrepayment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpfrontPrepayment(Inputs, Outputs)
{

	try
	{
		
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sTotalRRP = Inputs.GetProperty(&quot;TotalRRP&quot;);
		var sRemEL = ToNumber(Inputs.GetProperty(&quot;RemainingEL&quot;));
		var sUpfrontPay = &quot;&quot;;
		var sPrepayOption = &quot;&quot;;
		
		
		if(sRemEL &gt;= sTotalRRP)
		{
			
			sUpfrontPay =  &quot;0&quot;;
			sPrepayOption = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;, &quot;Voluntary&quot;);
		}
		else
		{
			sUpfrontPay = sTotalRRP - sRemEL;
			sUpfrontPay = ToNumber(sUpfrontPay);
			sPrepayOption = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;, &quot;Involuntary&quot;);
		}
		
		Outputs.SetProperty(&quot;UpfrontPay&quot;, sUpfrontPay);
		Outputs.SetProperty(&quot;PrepayOption&quot;, sPrepayOption);
		
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderId = &quot;&quot;;
		sTotalRRP = &quot;&quot;;
		sRemEL = &quot;&quot;;
		sUpfrontPay = &quot;&quot;;
		sPrepayOption = &quot;&quot;;
		
	}
}"
