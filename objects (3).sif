			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GeneratePaymentPlan"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//SSJ:CM-10085:Soumalya:Created new BS for Payment plan generation 
function GeneratePaymentPlan(Inputs, Outputs) 
{
    var CustomerPropSet = null,appObj = null,sPrep = 0, sCurrPrep =0;
    var sDTerm=0,ContractAmt=0, sAppOrigMonthlyAmt=0,sNewMonthlyAmt=0,dispPrepAmt=0,i=0;
    try 
	{
        appObj = TheApplication();
        sPrep = ToNumber(Inputs.GetProperty(&quot;Prepayment&quot;));
		sCurrPrep = ToNumber(Inputs.GetProperty(&quot;Prepayment&quot;));
		CustomerPropSet = Inputs.GetChild(0);
        CustomerPropSet.SetProperty(&quot;InputPrepayment&quot;, sCurrPrep);
		CustomerPropSet.SetType(&quot;SiebelMessage&quot;);		
        //For Accessories
		for (i = 0; i &lt; CustomerPropSet.GetChildCount(); i++) 
		{
			if (CustomerPropSet.GetChild(i).GetProperty(&quot;Category&quot;) == &quot;Accessory&quot;)
			{
				sDTerm = &quot;&quot;;
				ContractAmt = 0;
				sAppOrigMonthlyAmt = 0;
				sNewMonthlyAmt = 0;
				dispPrepAmt = 0;
				sDTerm = CustomerPropSet.GetChild(i).GetProperty(&quot;ProductTerm&quot;);
				ContractAmt = CustomerPropSet.GetChild(i).GetProperty(&quot;Price&quot;);
				if(sDTerm == &quot;&quot; || sDTerm == null)
				sAppOrigMonthlyAmt = 0;
				else
				sAppOrigMonthlyAmt = ToNumber(ContractAmt) / sDTerm;
				if (ToNumber(sCurrPrep) == 0)
					sNewMonthlyAmt = ToNumber(sAppOrigMonthlyAmt);
				else 
				{
					if (ToNumber(ContractAmt) &lt;= ToNumber(sCurrPrep)) 
					{
						sNewMonthlyAmt = 0;
						dispPrepAmt = ToNumber(ContractAmt);
						sCurrPrep = ToNumber(sCurrPrep) - ToNumber(ContractAmt);
					} 
					else 
					{
						dispPrepAmt = ToNumber(sCurrPrep);
						if(sDTerm == &quot;&quot; || sDTerm == null)
				         sNewMonthlyAmt = 0;
						 else
						sNewMonthlyAmt = (ToNumber(ContractAmt) - ToNumber(sCurrPrep)) / sDTerm;
						sCurrPrep = 0;
					}
				}
				CustomerPropSet.GetChild(i).SetProperty(&quot;RecurringCharge&quot;, fnFormatPrice(sAppOrigMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;NewMonthlyAmt&quot;, fnFormatPrice(sNewMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;Prepayment&quot;, fnFormatPrice(dispPrepAmt, &quot;&quot;, &quot;&quot;));
			}
		}
		CustomerPropSet.SetProperty(&quot;AfterAccPrepayment&quot;, sCurrPrep);
		//For Secondary Device
		for (i = 0; i &lt; CustomerPropSet.GetChildCount(); i++) 
		{
			if (CustomerPropSet.GetChild(i).GetProperty(&quot;Category&quot;) == &quot;Secondary Device&quot;)
			{
				sDTerm = &quot;&quot;;
				ContractAmt = 0;
				sAppOrigMonthlyAmt = 0;
				sNewMonthlyAmt = 0;
				dispPrepAmt = 0;
				sDTerm = CustomerPropSet.GetChild(i).GetProperty(&quot;ProductTerm&quot;);
				ContractAmt = CustomerPropSet.GetChild(i).GetProperty(&quot;Price&quot;);
				if(sDTerm == &quot;&quot; || sDTerm == null)
				sAppOrigMonthlyAmt = 0;
				else
				sAppOrigMonthlyAmt = ToNumber(ContractAmt) / sDTerm;
				if (ToNumber(sCurrPrep) == 0)
					sNewMonthlyAmt = ToNumber(sAppOrigMonthlyAmt);
				else 
				{
					if (ToNumber(ContractAmt) &lt;= ToNumber(sCurrPrep)) 
					{
						sNewMonthlyAmt = 0;
						dispPrepAmt = ToNumber(ContractAmt);
						sCurrPrep = ToNumber(sCurrPrep) - ToNumber(ContractAmt);
					} 
					else 
					{
						dispPrepAmt = ToNumber(sCurrPrep);
						if(sDTerm == &quot;&quot; || sDTerm == null)
				         sNewMonthlyAmt = 0;
						 else
						sNewMonthlyAmt = (ToNumber(ContractAmt) - ToNumber(sCurrPrep)) / sDTerm;
						sCurrPrep = 0;
					}
				}
				CustomerPropSet.GetChild(i).SetProperty(&quot;RecurringCharge&quot;, fnFormatPrice(sAppOrigMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;NewMonthlyAmt&quot;, fnFormatPrice(sNewMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;Prepayment&quot;, fnFormatPrice(dispPrepAmt, &quot;&quot;, &quot;&quot;));
			}
		}
		CustomerPropSet.SetProperty(&quot;AfterSDPrepayment&quot;, sCurrPrep);
		//For GPP
		for (i = 0; i &lt; CustomerPropSet.GetChildCount(); i++) {
			if (CustomerPropSet.GetChild(i).GetProperty(&quot;Category&quot;) == &quot;GPP&quot;)
			{
				sDTerm = &quot;&quot;;
				ContractAmt = 0;
				sAppOrigMonthlyAmt = 0;
				sNewMonthlyAmt = 0;
				dispPrepAmt = 0;
				sDTerm = CustomerPropSet.GetChild(i).GetProperty(&quot;ProductTerm&quot;);
				ContractAmt = CustomerPropSet.GetChild(i).GetProperty(&quot;Price&quot;);
				if(sDTerm == &quot;&quot; || sDTerm == null)
				sAppOrigMonthlyAmt = 0;
				else
				sAppOrigMonthlyAmt = ToNumber(ContractAmt) / sDTerm;
				if (ToNumber(sCurrPrep) == 0)
					sNewMonthlyAmt = ToNumber(sAppOrigMonthlyAmt);
				else 
				{
					if (ToNumber(ContractAmt) &lt;= ToNumber(sCurrPrep)) 
					{
						sNewMonthlyAmt = 0;
						dispPrepAmt = ToNumber(ContractAmt);
						sCurrPrep = ToNumber(sCurrPrep) - ToNumber(ContractAmt);
					} 
					else 
					{
						dispPrepAmt = ToNumber(sCurrPrep);
						if(sDTerm == &quot;&quot; || sDTerm == null)
				         sNewMonthlyAmt = 0;
						 else
						sNewMonthlyAmt = (ToNumber(ContractAmt) - ToNumber(sCurrPrep)) / sDTerm;
						sCurrPrep = 0;
					}
				}
				CustomerPropSet.GetChild(i).SetProperty(&quot;RecurringCharge&quot;, fnFormatPrice(sAppOrigMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;NewMonthlyAmt&quot;, fnFormatPrice(sNewMonthlyAmt, &quot;&quot;, &quot;&quot;));
				CustomerPropSet.GetChild(i).SetProperty(&quot;Prepayment&quot;, fnFormatPrice(dispPrepAmt, &quot;&quot;, &quot;&quot;));
			}
		}
		CustomerPropSet.SetProperty(&quot;AfterGPPPrepayment&quot;, sCurrPrep);
		Outputs.AddChild(CustomerPropSet.Copy());
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		CustomerPropSet = null;	
		sPrep = null;
		sCurrPrep =null;
		appObj = null;
    }
}
"
