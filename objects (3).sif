			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSharingFlgSubmitUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSharingFlgSubmitUpdate (Inputs, Outputs)
{
 try
 {
 		var bcExists,sLead;
		var StrSharingOption=&apos;&apos;,StrSharingAction=&apos;&apos;, sSharingAction=&apos;&apos;, sStkIndicator=&apos;&apos;;
		var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrderConnect = boOrderConnect.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);  
		var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;OrderSubType&quot;);
		var sBulkOrder = Inputs.GetProperty(&quot;IsBulkOrder&quot;);
		var sCount = &quot;&quot;;
		var sOLINewLeadMSISDN = &quot;&quot;;
		var sGroupId = &quot;&quot;;
		var sServiceOrderType = &quot;&quot;;
		var sServiceOrderFunction = &quot;&quot;;
		if(strOrderId != &quot;&quot;)
		{
			with(bcOrderConnect)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, strOrderId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					with(bcOrderLineItems)
					{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Sharing Option Submit Calc&quot;);
					ActivateField(&quot;Sharing Action Calc&quot;);
					ActivateField(&quot;VF Sharing Order&quot;);
					ActivateField(&quot;Sharing Action&quot;);
					ActivateField(&quot;VF Out of Stock Indicator&quot;);
					ActivateField(&quot;Sharing Group Id&quot;);
					ActivateField(&quot;Is Lead&quot;);
					ActivateField(&quot;Sharing New Lead MSISDN&quot;);
					ActivateField(&quot;VF Service Order Sub Type&quot;);
					ActivateField(&quot;Service Order Sub Function&quot;);
					SetSearchSpec(&quot;Order Header Id&quot;, strOrderId);
					SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
					ExecuteQuery(ForwardOnly);
					sCount = CountRecords();
					bcExists = FirstRecord();
					 while(bcExists)
					 {
						 sStkIndicator = GetFieldValue(&quot;VF Out of Stock Indicator&quot;);
						 sSharingAction = GetFieldValue(&quot;Sharing Action&quot;);
						 sGroupId = GetFieldValue(&quot;Sharing Group Id&quot;);
						 sLead = GetFieldValue(&quot;Is Lead&quot;);
						 sOLINewLeadMSISDN = GetFieldValue(&quot;Sharing New Lead MSISDN&quot;);
						 sServiceOrderType = GetFieldValue(&quot;VF Service Order Sub Type&quot;);
						 sServiceOrderFunction = GetFieldValue(&quot;Service Order Sub Function&quot;);
						 if(sStkIndicator != &quot;Out of Stock&quot; &amp;&amp; sStkIndicator != &quot;Out of Stock - Connect Now&quot; &amp;&amp; sStkIndicator != &quot;Out of Stock - Connect Later&quot;)
						 {
							 StrSharingOption = GetFieldValue(&quot;Sharing Option Submit Calc&quot;);
							 if((TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel Sales Enterprise&quot; &amp;&amp; sServiceOrderFunction != &quot;Change Location Connect&quot;) || sBulkOrder == &quot;Y&quot; || sOrderSubType == &quot;Change MSISDN&quot;)
							 {
								if(TheApplication().GetProfileAttr(&quot;Sharing_Comp_Transfer&quot;) == &quot;Yes&quot;)
								 {
								 }
								 else
									SetFieldValue(&quot;VF Sharing Order&quot;,StrSharingOption);
							 }
							 
							 StrSharingAction = GetFieldValue(&quot;Sharing Action Calc&quot;);
							 if((sCount == 1 || (sCount == 2 &amp;&amp; sServiceOrderType == &quot;Change Proposition&quot;)) &amp;&amp; sGroupId == &quot;&quot; &amp;&amp; sOLINewLeadMSISDN == &quot;&quot; &amp;&amp; StrSharingAction == &quot;Add Member&quot;)
							 {
							 	//do nothing, added for PKE000000040427
							 }
							 else
							 {
							 if(StrSharingAction != &apos;&apos; &amp;&amp; StrSharingAction != null &amp;&amp; (sSharingAction == null || sSharingAction ==&apos;&apos;))
								 if(sLead == &quot;Y&quot; &amp;&amp; StrSharingAction == &quot;Remove Member&quot;)
								 {
								 	SetFieldValue(&quot;Sharing Action&quot;,&quot;Sharing Remove Lead&quot;);
								 }
								 else
								 {
								 	SetFieldValue(&quot;Sharing Action&quot;,StrSharingAction);
								 }					 
							 }
						 }
						 bcExists = NextRecord();
					 }
					 WriteRecord();

					}
				}
			}
		}
  }
  catch(e)
	{
		throw(e);
	}
	finally
	{
		bcOrderLineItems = null;
		bcOrderConnect = null;
		boOrderConnect = null;
	}
}"
