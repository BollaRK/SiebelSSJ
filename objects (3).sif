			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetFailureAttempts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetFailureAttempts(IdType,sContactId) 
{
	var sBO = TheApplication().GetBusObject(&quot;Contact&quot;);
	var sBC = sBO.GetBusComp(&quot;VF USIM Contact Id Failure&quot;);
	var sFailAtt = 0;
	
	if(IdType != &quot;&quot; &amp;&amp; sContactId != &quot;&quot; &amp;&amp; sContactId != null)
	{
	with(sBC)
	{
		ActivateField(&quot;Id Type&quot;);
		ActivateField(&quot;VF No. Of Failed Attempts&quot;);
		SetViewMode(AllView);
		SetSearchExpr(&apos;[Id Type] = &quot;&apos; +IdType+ &apos;&quot; AND [Contact Id] = &quot;&apos; +sContactId+ &apos;&quot;&apos;);
		ExecuteQuery(ForwardOnly);
		if(FirstRecord())
			sFailAtt = GetFieldValue(&quot;VF No. Of Failed Attempts&quot;);

		sFailAtt = ToNumber(sFailAtt);
	}
	}
	
	
return(sFailAtt);
}"
