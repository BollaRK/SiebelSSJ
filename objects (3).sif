			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpdateSharingOption"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnUpdateSharingOption (Inputs, Outputs)
{
 try
 {
 		var bcExists;
		var StrSharingOption,StrSharingAction;
		var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrderConnect = boOrderConnect.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);  
		var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		if(strOrderId != &quot;&quot;)
		{
			bcOrderConnect.SetViewMode(AllView);
			bcOrderConnect.ClearToQuery();
			bcOrderConnect.ActivateField(&quot;VF Order Function&quot;);
			bcOrderConnect.SetSearchSpec(&quot;Id&quot;, strOrderId);
			bcOrderConnect.ExecuteQuery(ForwardOnly);
			if(bcOrderConnect.FirstRecord())
			{
			 	bcOrderConnect.SetFieldValue(&quot;VF Order Function&quot;,&quot;&quot;);
			 	bcOrderConnect.WriteRecord();
			 	bcOrderLineItems.SetViewMode(AllView);
				bcOrderLineItems.ClearToQuery();
				bcOrderLineItems.ActivateField(&quot;VF Order Function&quot;);
				bcOrderLineItems.ActivateField(&quot;Sharing Option Calc&quot;);
				bcOrderLineItems.ActivateField(&quot;Sharing Action&quot;);
				bcOrderLineItems.ActivateField(&quot;VF Sharing Order&quot;);
			    bcOrderLineItems.SetSearchSpec(&quot;Order Header Id&quot;, strOrderId);
			    bcOrderLineItems.SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
				bcOrderLineItems.ExecuteQuery(ForwardOnly);
				bcExists = bcOrderLineItems.FirstRecord();
				
				 while(bcExists)
				 {
					 StrSharingOption = bcOrderLineItems.GetFieldValue(&quot;Sharing Option Calc&quot;);
					 //bcOrderLineItems.SetFieldValue(&quot;Sharing Action&quot;,StrSharingAction);
					 bcOrderLineItems.SetFieldValue(&quot;VF Sharing Order&quot;,StrSharingOption);
					 bcOrderLineItems.SetFieldValue(&quot;VF Order Function&quot;,&quot;&quot;);
					 bcOrderLineItems.WriteRecord();
					 bcExists = bcOrderLineItems.NextRecord();
				 }
				
			}
		}
  }
  catch(e)
	{
		throw(e);
	}
	finally
	{
		bcOrderLineItems = null;
		bcOrderConnect = null;
		boOrderConnect = null;
	}
}"
