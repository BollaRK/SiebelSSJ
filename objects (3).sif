			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SSJQuoteEmailAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SSJQuoteEmailAddress(Inputs, Outputs) 
{
	var OrderNum = &quot;&quot;,sEmailAddress = &quot;&quot;,sSSJOrdBC = &quot;&quot;,sExistingEmailAddress = &quot;&quot;;
    try 
	{
		OrderNum = Inputs.GetProperty(&quot;Order Number&quot;);
		sEmailAddress = Inputs.GetProperty(&quot;Email Address&quot;);
		sSSJOrdBC = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;VHA Order Entry Parent Orders SSJ&quot;);
      	if(OrderNum != null &amp;&amp; OrderNum != &quot;&quot;)
		{
			if (sEmailAddress != null &amp;&amp; sEmailAddress != &quot;&quot;)
			{
				with(sSSJOrdBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Order Number&quot;);
					ActivateField(&quot;VHASSJNewCustEmail&quot;);
					ActivateField(&quot;SSJDisplayEmailAddr&quot;);
					SetSearchSpec(&quot;Order Number&quot;, OrderNum);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						SetFieldValue(&quot;VHASSJNewCustEmail&quot;, sEmailAddress);
						WriteRecord();
						Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;Success&quot;);
						/*
						var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
						var psIn = TheApplication().NewPropertySet();
						var psOut = TheApplication().NewPropertySet();
						psIn.SetProperty(&quot;Refresh All&quot;, &quot;Y&quot;);
						svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;, psIn, psOut);
						*/
					}
					else
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;No record found for the provided quote number.&quot;);
					}

					var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
					var psIn = TheApplication().NewPropertySet();
					var psOut = TheApplication().NewPropertySet();
					psIn.SetProperty(&quot;Refresh All&quot;, &quot;Y&quot;);
					svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;, psIn, psOut);
				}//end with								
			}
			else
				Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;Email address is mandatory and can&apos;t be updated as blank.&quot;);
		}
		else
			Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;Quote Number is mandatory and can&apos;t be blank.&quot;);
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		OrderNum = null;
		sEmailAddress = null;
		sSSJOrdBC = null;
		sExistingEmailAddress = null;
    }
}
"
