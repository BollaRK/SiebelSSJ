			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepayAmtOOS"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepayAmtOOS(Inputs,Outputs)
{
	try
	{
		
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var oOrderBO=TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var oOrderBC=oOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var oOrderItemBC=oOrderBO.GetBusComp(&quot;Order Entry - Line Items&quot;);		
		var searchst1 = &quot;&quot;;
		var sOrdId = &quot;&quot;;
		var sAction = &quot;Add&quot;;
		var sPrepAmt = 0;
		var isRec = &quot;&quot;;
		with(oOrderBC)
		{	
			ActivateField(&quot;VF Fulfilment Order Id&quot;);
			ActivateField(&quot;Id&quot;);	
			ClearToQuery(); 
			SetViewMode(AllView);			
			searchst1 = &quot;[VF Fulfilment Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			SetSearchExpr(searchst1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sOrdId = GetFieldValue(&quot;Id&quot;);
			}
					
		}
		if(sOrdId != &quot;&quot; &amp;&amp; sOrdId != null)
		{
			with(oOrderItemBC)
			{
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;VF Siebel Product Type&quot;);					
				ClearToQuery(); 
				SetViewMode(AllView);			
				SetSearchExpr(&quot;(([Product Type] = &apos;Billing - GPP&apos; AND [VF Siebel Product Type] = &apos;Device&apos;) OR [Product Type] = &apos;Billing - APP&apos;) AND [Order Header Id] = &apos;&quot; + sOrdId +&quot;&apos; AND [Action Code] = &apos;&quot;+ sAction +&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				isRec = FirstRecord();
				while(isRec)
				{												
					sPrepAmt = ToNumber(sPrepAmt) + ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Prepayment Amount&apos;&quot;));								
					isRec = NextRecord();
				}
			
			}
		
		}
		Outputs.SetProperty(&quot;TotalPrepayAmt&quot;, sPrepAmt);	
	}
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderId = null;
		oOrderBO = null;
		oOrderBC = null;
		oOrderItemBC = null;
		searchst1 = null;
		sOrdId = null;
		sAction = null;
		sPrepAmt = null;
		isRec = null;
	
	
	}

}"
			   SEQUENCE="72"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepaymentOption"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepaymentOption(sOrderId)//VHA Muthushankari - 4/6/2019 - Added for R19.3 Prepayments
{
	try
	{

		var sInvoluntory = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;,&quot;Involuntary&quot;);
		var sVoluntory = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;,&quot;Voluntary&quot;);
		var sPrepaymentOption = &quot;&quot;;
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sPrepaymentsBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		with(sPrepaymentsBC)
		{
			ActivateField(&quot;PP Amount Paid Upfront&quot;);
			ActivateField(&quot;Prepayment Option Type&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; &quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				if(ToNumber(GetFieldValue(&quot;PP Amount Paid Upfront&quot;)) &gt; 0)
				{
					if(GetFieldValue(&quot;Prepayment Option Type&quot;) == &quot;Y&quot;)
						sPrepaymentOption = sInvoluntory;
					else
						sPrepaymentOption = sVoluntory;
				}
			}
		}
		return (sPrepaymentOption);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sPrepaymentsBC = null;
		sBO = null;
	}
}"
