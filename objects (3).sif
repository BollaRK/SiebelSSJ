			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSharingId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSharingId(Input,Outputs)
{
      try
      {
      var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
      var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
      var bcOrderItem = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items&quot;);
                 bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
		         bcOrderItem.ActivateField(&quot;Sharing Group Id&quot;);
		         bcOrderItem.ClearToQuery();
	             bcOrderItem.SetViewMode(AllView);
		         bcOrderItem.SetSearchExpr( &quot;[Order Header Id]=&apos;&quot;+sOrderId+&quot;&apos;&quot;);
	             bcOrderItem.ExecuteQuery(ForwardOnly);
				 if(bcOrderItem.FirstRecord())
				 {
				   var sSharingGroupId = bcOrderItem.GetFieldValue(&quot;Sharing Group Id&quot;);
				   
				 }
				 Outputs.SetProperty(&quot;Group Id&quot; , sSharingGroupId);
		}
		catch(e)
		{
		}
		finally
		{
			bcOrderItem = null;
			boOrder = null;	
		}
}"
