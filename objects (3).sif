			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetUpdateGPPTerm"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function GetUpdateGPPTerm(Inputs, Outputs) 
{
    var ChildOrderId = &quot;&quot;, bcMPP = null,srootOLIId = &quot;&quot;,sTermValue = &quot;&quot;, srootLIId = &quot;&quot;,bcDFAName = null, Frecord = null;
    try 
	{
        ChildOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        bcMPP = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VF MPP Order Smartscript Support - TBUI&quot;);
        bcDFAName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VFDfa Order Entry Line Items Thin BC&quot;);
        with (bcDFAName) 
		{
			//query for root line items
			SetViewMode(AllView);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;VHASSJ Payment Term&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;);
			ExecuteQuery(ForwardOnly);
			Frecord = FirstRecord();
			while (Frecord) 
			{
				srootOLIId = GetFieldValue(&quot;Id&quot;); //root line item row-id
				sTermValue = GetFieldValue(&quot;VHASSJ Payment Term&quot;);
				with(bcMPP)
				{
					SetViewMode(AllView);
					ActivateField(&quot;MPP Contract Months TBUI&quot;);
					ActivateField(&quot;Order Line Id&quot;);
					ActivateField(&quot;Order Id&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Order Line Id] = &apos;&quot; + srootOLIId + &quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						SetFieldValue(&quot;MPP Contract Months TBUI&quot;,sTermValue);
						WriteRecord();
					}
				}
				Frecord = NextRecord();
			}
		}

		Outputs.SetProperty(&quot;DeviceTerm&quot;,sTermValue);
        
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        ChildOrderId = null;
        Frecord = null;
        bcDFAName = null;
        bcMPP = null;

    }
}"
