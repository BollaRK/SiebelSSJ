			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateApproveMPPLimit"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateApproveMPPLimit(Inputs, Outputs) {
	/* Component Name        : 	TBUI - mValidateMPPContract
	 * Component Information : 	This method is to validate whether the Total MPP exceeds approved MPP
	 * Modification History  :
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 21/07/2014	Balaji
	 */
	try {
		//Trace
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) {
			TheApplication().Trace(&quot;START: BS: VF TBUI Utilities. mValidateApproveMPPLimit&quot;);
		}
		var vPreMPPAmt;
		var sCustomerAccountId = Inputs.GetProperty(&quot;CustAccountId&quot;);
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var vCA = Inputs.GetProperty(&quot;ContractAmount&quot;); ;
		var vfpMPPTot;
		var vApprovedCLA;

		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLI = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcOrderItemXA = boOrder.GetBusComp(&quot;Order Item XA&quot;);
		var vMPPExists = &quot;N&quot;;
		var vActionCode = &quot;&quot;;
		var strProduct = &quot;&quot;;
		var strServiceType = &quot;&quot;;
		var strPrevMPPAmt = &quot;0&quot;;
		var strRootAssetIntId;
		var strMPPContractId;
		bcOrderLI.ActivateField(&quot;Product Type&quot;);
		bcOrderLI.ActivateField(&quot;Root Order Item Id&quot;);
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Id&quot;, strOrderId);
		bcOrder.ExecuteQuery(ForwardBackward);
		if (bcOrder.FirstRecord()) {
			strServiceType = bcOrderLI.GetFieldValue(&quot;Service Type&quot;);
			strRootAssetIntId = bcOrderLI.GetFieldValue(&quot;Root Asset Integration Id&quot;);
			bcOrderLI.ClearToQuery();
			bcOrderLI.ActivateField(&quot;Product&quot;);
			bcOrderLI.ActivateField(&quot;Action Code&quot;);
			bcOrderLI.SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - MPP&quot;);
			bcOrderLI.ExecuteQuery();
			if (bcOrderLI.FirstRecord()) {
				//vMPPExists = &quot;Y&quot;;
				//vActionCode = bcOrderLI.GetFieldValue(&quot;Action Code&quot;);
				//strProduct = bcOrderLI.GetFieldValue(&quot;Product&quot;);
				strMPPContractId = bcOrderLI.GetFieldValue(&quot;Id&quot;);

				bcOrderItemXA.SetViewMode(AllView);
				bcOrderItemXA.ClearToQuery();
				bcOrderItemXA.ActivateField(&quot;Action Code&quot;);
				bcOrderItemXA.ActivateField(&quot;Text Value&quot;);
				bcOrderItemXA.SetSearchSpec(&quot;Object Id&quot;, strMPPContractId);
				bcOrderItemXA.SetSearchSpec(&quot;Name&quot;, &quot;Contract Amount&quot;);
				bcOrderItemXA.ExecuteQuery(ForwardOnly);

				if (bcOrderItemXA.FirstRecord()) {
					vPreMPPAmt = bcOrderItemXA.GetFieldValue(&quot;Text Value&quot;);
				}
			}
			//Query Account and Fin Profile
			var bcAccount = boOrder.GetBusComp(&quot;Account&quot;);
			var bcFinProfile = bcAccount.GetBusComp(&quot;Com Financial Profile&quot;);
			bcAccount.SetViewMode(AllView);
			bcAccount.ClearToQuery();
			bcAccount.SetSearchSpec(&quot;Id&quot;, sCustomerAccountId);
			bcAccount.ExecuteQuery();
			if (bcAccount.FirstRecord()) {
				bcFinProfile.ClearToQuery();
				bcFinProfile.ActivateField(&quot;VF MPP Contract Approved Amount&quot;);
				bcFinProfile.ActivateField(&quot;VF MPP Contract Amount&quot;);
				bcFinProfile.SetSearchSpec(&quot;Account Id&quot;, sCustomerAccountId);
				if (bcAccount.FirstRecord()) {
					vApprovedCLA = bcFinProfile.GetFieldValue(&quot;VF MPP Contract Approved Amount&quot;);
					vfpMPPTot = bcFinProfile.GetFieldValue(&quot;VF MPP Contract Amount&quot;);
				}
			}
		}
		var vCompAmt = ToNumber(vfpMPPTot) + ToNumber(vCA) - ToNumber(vPreMPPAmt);
		/*if (ToNumber(vCompAmt) &gt; ToNumber(vApprovedCLA)) {
			vCompAmt = 0;
			TheApplication().RaiseErrorText(&quot;&lt;Total MPP Amount&gt; cannot exceed the &lt;Approved MPP Limit&gt;&quot;);
		}*/
		//NEEL 19.01.2015
	} catch (e) {
		throw e;
	}
	finally {
	bcOrder = null;
	bcOrderLI = null;
	bcOrderItemXA = null;
	bcAccount = null;
	bcFinProfile = null;
	boOrder = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
	
	}

}"
