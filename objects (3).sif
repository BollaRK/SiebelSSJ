			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpsertSharingGroup"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnUpsertSharingGroup(sGroupId,Inputs)
{
try
{
	var BO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
	var oGroupBC = BO.GetBusComp(&quot;VHA Sharing Group&quot;);
	var sMSISDN = Inputs.GetProperty(&quot;sMSISDN&quot;);
	var sGroupStatus = Inputs.GetProperty(&quot;sGroupStatus&quot;);
	var sBillAccountId = Inputs.GetProperty(&quot;sBillAccountId&quot;);
	var sAccountId = Inputs.GetProperty(&quot;sAccountId&quot;);
	var sSharingCompatability =	Inputs.GetProperty(&quot;sSharingCompatability&quot;);
	var LeadId = Inputs.GetProperty(&quot;LeadId&quot;);
	var sGroupName = Inputs.GetProperty(&quot;sGroupName&quot;);
	var sNewGroupId = &quot;&quot;;
	
	with (oGroupBC)
	{
	
			SetViewMode(AllView);
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;Shraing Group Name&quot;);
			ActivateField(&quot;Sharing Status&quot;);
			ActivateField(&quot;Lead Integeration Id&quot;);
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Sharing Comptability&quot;);
		if(sGroupId != &quot;&quot;)
		{
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;,sGroupId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				SetFieldValue(&quot;Shraing Group Name&quot;,sGroupName);
				WriteRecord();
			}
		}
		else
		{
			NewRecord(NewAfter);
			SetFieldValue(&quot;Account Id&quot;,sAccountId);
			SetFieldValue(&quot;Billing Account Id&quot;,sBillAccountId);
			SetFieldValue(&quot;Lead Integeration Id&quot;,LeadId);
			SetFieldValue(&quot;Type&quot;,&quot;Sharing Group&quot;);
			SetFieldValue(&quot;Sharing Status&quot;,&quot;New&quot;);
			SetFieldValue(&quot;Shraing Group Name&quot;,sGroupName);
			SetFieldValue(&quot;Sharing Comptability&quot;,sSharingCompatability);
			WriteRecord();
			sNewGroupId = GetFieldValue(&quot;Id&quot;);
		}
		
	}
	return(sNewGroupId);
}
catch(e)
{
throw(e);
}
finally
{
oGroupBC = null;
BO = null;
}
}"
