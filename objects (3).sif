			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetDiscountAmnt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetDiscountAmnt(Inputs,Outputs)
{
	/*
	MonishaJ:Added code to retrieve discount amount and action code for MSP - Change Primary Flow.
	17022025:Soumalya:Change the code to skip addition of discount product if discount amount is 0.
	*/
	var sBusObj=null,sBusComp=null,splanId=&quot;&quot;,sSequence=&quot;&quot;,sCurAssetDiscItemId=&quot;&quot;,sMSPSequence=&quot;&quot;,sDiscountAmnt=&quot;0&quot;,sActioncd=&quot;Update&quot;;
	try
	{
		sBusObj = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;);
		sBusComp = sBusObj.GetBusComp(&quot;VHA MSP Eligibilty Matrix Active Item BC&quot;);
		splanId = Inputs.GetProperty(&quot;PlanId&quot;);
		sSequence = Inputs.GetProperty(&quot;NewSeq&quot;);
		sCurAssetDiscItemId = Inputs.GetProperty(&quot;CurAssetDiscItemId&quot;);
		with(sBusComp)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;MSP Sequence&quot;);
			SetSearchSpec(&quot;PlanProdId&quot;,splanId);
			SetSearchSpec(&quot;Type&quot;,&quot;Plan&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sMSPSequence = GetFieldValue(&quot;MSP Sequence&quot;);
				ClearToQuery();
				ActivateField(&quot;Discount Amount&quot;);
				SetSearchSpec(&quot;MSP Sequence&quot;,sMSPSequence);
				SetSearchSpec(&quot;Type&quot;,&quot;Sequence&quot;);
				SetSearchSpec(&quot;Order Sequence&quot;,sSequence);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sDiscountAmnt = GetFieldValue(&quot;Discount Amount&quot;);
					if(sCurAssetDiscItemId != &quot;&quot; &amp;&amp; sCurAssetDiscItemId != null)
					{
						if(ToNumber(sDiscountAmnt)==0)
							sActioncd =&quot;Delete&quot;;
						else
							sActioncd =&quot;Update&quot;;
					}
					else
					{
						if(ToNumber(sDiscountAmnt)==0)
							sActioncd =&quot;Skip&quot;;
						else
							sActioncd =&quot;Add&quot;;
					}
				}
			}					
		}
		Outputs.SetProperty(&quot;NewDiscountAmnt&quot;,sDiscountAmnt);
		Outputs.SetProperty(&quot;ActionCd&quot;,sActioncd);
	}
	catch(e)
	{
	  throw e;
	}
	finally
	{
		sBusComp=null;
		sBusObj=null;
		splanId=null;
		sSequence=null;
		sCurAssetDiscItemId=null;
		sMSPSequence=null;
		sDiscountAmnt=null;
		sActioncd=null;
	}
}"
