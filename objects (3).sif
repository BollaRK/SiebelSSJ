			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateNewFWAAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateNewFWAAddress(Inputs,Outputs)
{
try
{
var strCustomerAccountId = &quot;&quot;,addressId = &quot;&quot;,adrFloor = &quot;&quot;,adrFloorType = &quot;&quot;,POBox = &quot;&quot;,
adrFormat = &quot;&quot;,adrSteetType = &quot;&quot;,city = &quot;&quot;,country = &quot;&quot;,dpid = &quot;&quot;,state = &quot;&quot;,sServiceFlg = &quot;&quot;,validStatus = &quot;&quot;,adrBuild = &quot;&quot;,privateBag = &quot;&quot;, 
streetAdr = &quot;&quot;,streetAdr2 = &quot;&quot;,freeAdr = &quot;&quot;,adrbuild = &quot;&quot;,streettype = &quot;&quot;,poCode = &quot;&quot;,lat = &quot;&quot;,longt = &quot;&quot;,fwaaddressId = &quot;&quot;;

strCustomerAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
addressId = Inputs.GetProperty(&quot;AddressId&quot;);
var sbo = TheApplication().GetBusObject(&quot;Account&quot;);
    var sbc = sbo.GetBusComp(&quot;Account&quot;);
	var bcCUTAddress = sbo.GetBusComp(&quot;CUT Address&quot;);
	with (sbc)
		{

			SetViewMode(AllView);
			ClearToQuery();
            ActivateField(&quot;Id&quot;);
			SetSearchSpec(&quot;Id&quot;,strCustomerAccountId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{

	     with (bcCUTAddress)			
	    {	
	    	ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Address Format&quot;);
			ActivateField(&quot;Address Floor Type&quot;);
			ActivateField(&quot;Address Floor&quot;);
			ActivateField(&quot;Address Building&quot;);
			ActivateField(&quot;Street Address 2&quot;);
			ActivateField(&quot;Address Street Type - AU&quot;);
			ActivateField(&quot;Street Address&quot;);
			ActivateField(&quot;City AU&quot;);
			ActivateField(&quot;State&quot;);
			ActivateField(&quot;Postal Code AU&quot;);
		
			ActivateField(&quot;Country&quot;);
			ActivateField(&quot;Latitude&quot;);
			ActivateField(&quot;Longitude&quot;);
			ActivateField(&quot;DPID&quot;);
			ActivateField(&quot;POBox&quot;);
			ActivateField(&quot;Private Bag&quot;);
			ActivateField(&quot;Validation Status&quot;);
			ActivateField(&quot;Freeform address line 1&quot;);
			SetSearchSpec(&quot;Id&quot;, addressId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
			 adrFormat = GetFieldValue(&quot;Address Format&quot;);
			 adrFloorType = GetFieldValue(&quot;Address Floor Type&quot;);
			 adrFloor = GetFieldValue(&quot;Address Floor&quot;);
			 adrbuild = GetFieldValue(&quot;Address Building&quot;);
			 streetAdr2 = GetFieldValue(&quot;Street Address 2&quot;);
			 streettype = GetFieldValue(&quot;Address Street Type - AU&quot;);
			 streetAdr = GetFieldValue(&quot;Street Address&quot;);
			 city = GetFieldValue(&quot;City AU&quot;);
			 state = GetFieldValue(&quot;State&quot;);
             privateBag = GetFieldValue(&quot;Private Bag&quot;);
			 poCode = GetFieldValue(&quot;Postal Code AU&quot;);
			 country = GetFieldValue(&quot;Country&quot;);
			 lat = GetFieldValue(&quot;Latitude&quot;);
			 longt = GetFieldValue(&quot;Longitude&quot;);
             POBox = GetFieldValue(&quot;POBox&quot;);;
			 dpid = GetFieldValue(&quot;DPID&quot;);
             freeAdr = GetFieldValue(&quot;Freeform address line 1&quot;);
			 sServiceFlg = GetFieldValue(&quot;VHA Service Address Flag&quot;);
			}
            if(sServiceFlg == &quot;&quot; || sServiceFlg == null)
			{
			 NewRecord(NewAfter);
		
			SetFieldValue(&quot;VHA Service Address Flag&quot;,&quot;Y&quot;);
			SetFieldValue(&quot;Address Floor&quot;,adrFloor);
			SetFieldValue(&quot;Address Format&quot;,adrFormat);
			SetFieldValue(&quot;Address Floor Type&quot;,adrFloorType);				
			SetFieldValue(&quot;Address Building&quot;,adrBuild);
			SetFieldValue(&quot;Street Address 2&quot;,streetAdr2);
			SetFieldValue(&quot;Street Address&quot;,streetAdr);
			SetFieldValue(&quot;Freeform address line 1&quot;,freeAdr);
			SetFieldValue(&quot;POBox&quot;,POBox);
			SetFieldValue(&quot;Private Bag&quot;,privateBag);
			SetFieldValue(&quot;Latitude&quot;,lat);
			SetFieldValue(&quot;Longitude&quot;,longt);
			SetFieldValue(&quot;City AU&quot;,city);
			SetFieldValue(&quot;Postal Code AU&quot;,poCode);
			SetFieldValue(&quot;State&quot;,state);
			SetFieldValue(&quot;Address Street Type - AU&quot;,streettype);
			SetFieldValue(&quot;DPID&quot;,dpid);
			SetFieldValue(&quot;Validation Status&quot;,&quot;1&quot;);
			WriteRecord();
			fwaaddressId = GetFieldValue(&quot;Id&quot;);
			}
		}
	}
		}

}
catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
	   bcCUTAddress = null;
	   sbc = null;
	   sbo = null; 
														
	}
}"
			   SEQUENCE="2"
