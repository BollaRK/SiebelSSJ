			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnDeleteLineItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnDeleteLineItems(Inputs, Outputs)
{
		try
		{
			var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			var boOrder,bcOrderItem;
			if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
			{
				boOrder = TheApplication().GetBusObject(&quot;VF Order Relationships&quot;);
				bcOrderItem = boOrder.GetBusComp(&quot;VF Order Line Items - Simple&quot;);
				bcOrderItem.ClearToQuery();
				bcOrderItem.SetViewMode(AllView);
				bcOrderItem.ActivateField(&quot;Order Id&quot;);
				bcOrderItem.SetSearchSpec(&quot;Order Id&quot;, sOrderId);
				bcOrderItem.ExecuteQuery(ForwardOnly);
				while(bcOrderItem.FirstRecord())
				{
					bcOrderItem.DeleteRecord();
				}
			}
		}
		catch (e)
		{
			TheApplication().RaiseErrorText(e);
		}
		finally
		{
			bcOrderItem = null;
			boOrder  = null;
		}
}"
			   SEQUENCE="11"
			   UPDATED="06/28/2024 18:49:19"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetSearchExpr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetSearchExpr(FieldName, Type, Operator)
{
try
{
/******************************************************************************
VHA Suresh: 12/04/2017: Added for R17.3 PIPE: Sharing
******************************************************************************/
	var sLstBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
	var sLstBC = sLstBO.GetBusComp(&quot;List Of Values&quot;);
	var sSearchExpr =&quot;&quot;;
	with(sLstBC)
	{
		ActivateField(&quot;Type&quot;);
		ActivateField(&quot;Active&quot;);
		ActivateField(&quot;Value&quot;);
		SetViewMode(AllView);
		SetSearchSpec(&quot;Type&quot;,Type);
		ExecuteQuery(ForwardOnly);
		var irec = FirstRecord();
		var count =0;
		if(irec)
		while(irec)
		{
			var sValue = GetFieldValue(&quot;Value&quot;);
			if(count == 0)
				if(Operator == &quot;OR&quot;)
				sSearchExpr = &quot;[&quot; +FieldName+ &quot;] = &apos;&quot; +sValue+ &quot;&apos;&quot;;
				else
				sSearchExpr = &quot;[&quot; +FieldName+ &quot;] &lt;&gt; &apos;&quot; +sValue+ &quot;&apos;&quot;;
			else
			{
				if(Operator == &quot;OR&quot;)
				sSearchExpr = sSearchExpr + &quot; &quot; +Operator + &quot; [&quot; +FieldName+ &quot;] = &apos;&quot; +sValue+ &quot;&apos;&quot;;
				else
				sSearchExpr = sSearchExpr + &quot; &quot; +Operator +&quot; [&quot; +FieldName+ &quot;] &lt;&gt; &apos;&quot; +sValue+ &quot;&apos;&quot;;
			}
			count++;
			irec=NextRecord();
		}
	}
	return(sSearchExpr);
}
catch(e)
{
	throw(e);
}
finally
{
	sLstBC = null;
	sLstBO = null;
}
}"
