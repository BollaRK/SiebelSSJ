			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGenPop"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGenPop(Inputs, Outputs)
{ 
 
var boAsset;
 var bcAsset;
 var bcAssetRel;
 var isRecordAssetRel;
 var isRecordAsset;
 var parAssetId = &quot;&quot;;
 var assetIntegId = &quot;&quot;;
 var msisdn = &quot;&quot;;
 var servAccId = &quot;&quot;;
 var GenPOPRowId = &quot;&quot;;

try
{

	  GenPOPRowId = Inputs.GetProperty(&quot;GenPOPRowId&quot;);
	  // Query to see if Asset Id has the row id passed from IMEI history
	  boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
	  bcAssetRel = boAsset.GetBusComp(&quot;VF IMEI History&quot;);
	  bcAssetRel.ActivateField(&quot;Parent Asset Id&quot;);
	  bcAssetRel.SetSearchSpec(&quot;Id&quot;,GenPOPRowId);
	  bcAssetRel.ExecuteQuery(ForwardOnly);
	  isRecordAssetRel = bcAssetRel.FirstRecord();
	  //Checking in Asset Rel table with the row id and retrieving the Asset Id
	  if (isRecordAssetRel)
	  {

		 parAssetId = bcAssetRel.GetFieldValue(&quot;Parent Asset Id&quot;);
		 bcAsset = boAsset.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
		 bcAsset.ActivateField(&quot;Integration Id&quot;);
		 bcAsset.ActivateField(&quot;MSISDN&quot;);
		 bcAsset.ActivateField(&quot;Service Account Id&quot;);
		 bcAsset.SetSearchSpec(&quot;Id&quot;,parAssetId);
		 bcAsset.ExecuteQuery(ForwardOnly);
		 isRecordAsset = bcAsset.FirstRecord();
		 //Checking in Asset table and retrieving the integration id and mobile number
		 if (isRecordAsset)
		 {
			 assetIntegId = bcAsset.GetFieldValue(&quot;Integration Id&quot;);
			 msisdn = bcAsset.GetFieldValue(&quot;MSISDN&quot;);
			 servAccId = bcAsset.GetFieldValue(&quot;Service Account Id&quot;);
		 }
	  }
	  Outputs.SetProperty(&quot;Asset Integration Id&quot;,assetIntegId); 
	  Outputs.SetProperty(&quot;Mobile Number&quot;,msisdn); 
	  Outputs.SetProperty(&quot;Service Account Id&quot;,servAccId); 
	  Outputs.SetProperty(&quot;Parent Asset Id&quot;,parAssetId); // Subramanian 27/4/16 - Created property of Parent Asset id to take the correct customer and BA
}
catch (e)
{
   throw (e);
}
	finally
	{
		bcAssetRel = null;
		bcAsset = null;
		boAsset = null;
	}
 
}"
			   SEQUENCE="18"
			   UPDATED="02/13/2025 09:04:42"
			   UPDATED_BY="SADMIN"
			   CREATED="10/28/2015 12:49:27"
