			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SSJUpdateBusinessFlag"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SSJUpdateBusinessFlag(Inputs, Outputs) //250426:Suma:Added for CM9491 
{
	var boOrder = null,bcQuote = null,sQuoteId = null, NBNFlag =&quot;&quot;;
	try
	{
		bcQuote = TheApplication().GetBusObject(&quot;VF Order Header&quot;).GetBusComp(&quot;VF Order Header&quot;);
		sQuoteId = Inputs.GetProperty(&quot;Quote Id&quot;);
		NBNFlag = Inputs.GetProperty(&quot;NBN Flag&quot;);
		if(sQuoteId != null &amp;&amp; sQuoteId != &quot;&quot; &amp;&amp; NBNFlag!= null &amp;&amp; NBNFlag != &quot;&quot;)
		{
			with (bcQuote) 
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;NBN Business Flag&quot;);
				SetSearchSpec(&quot;Id&quot;, sQuoteId);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					if(NBNFlag == &quot;Y&quot; || NBNFlag == &quot;N&quot;)
					{
						SetFieldValue(&quot;NBN Business Flag&quot;, NBNFlag);
						WriteRecord();
					}
				}
			}
		}
	}
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        boOrder = null;
        sQuoteId = null;
		NBNFlag = null;
		bcQuote = null;
    }
}"
