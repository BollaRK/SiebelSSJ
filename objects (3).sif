			   CREATED="01/09/2025 01:59:08"
			   CREATED_BY="SOUMALYAM">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fUpdateBundleSaveActCd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fUpdateBundleSaveActCd(Inputs, Outputs) 
{
    var sOrderId = &quot;&quot;,boOrder = null,sBCOrder = null,bcOrderLineIt = null,rootId = &quot;&quot;,sActionCd = &quot;&quot;, AssetPrice =&quot;&quot;,NetPrice=&quot;&quot;;
    try 
	{
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        rootId = Inputs.GetProperty(&quot;RootItemId&quot;);
		boOrder = TheApplication().GetBusObject(&quot;Order Item&quot;);
        bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		if( sOrderId != &quot;&quot; &amp;&amp; sOrderId != null &amp;&amp; rootId != null &amp;&amp; rootId != &quot;&quot;)
		{
			with (bcOrderLineIt) 
			{
	            
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ActivateField(&quot;VHA Siebel Product Type&quot;);
				ActivateField(&quot;Asset Base Price&quot;);
				ActivateField(&quot;Net Price&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VHA Siebel Product Type] = &apos;MSP Discount&apos; AND [Root Order Item Id] = &apos;&quot;+rootId+&quot;&apos; AND ([Action Code] = &apos;-&apos;)&quot;);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					AssetPrice = GetFieldValue(&quot;Asset Base Price&quot;);
					NetPrice = GetFieldValue(&quot;Net Price&quot;);
					if(AssetPrice != &quot;&quot; &amp;&amp; AssetPrice != null &amp;&amp; NetPrice != &quot;&quot; &amp;&amp; NetPrice != null)
					{
						if(AssetPrice != NetPrice )
						{
							SetFieldValue(&quot;Action Code&quot;,&quot;Update&quot;);
							WriteRecord();
						}
					}
					
				}
	        }
        }          
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		sOrderId = null;
	    boOrder = null;
	    sBCOrder = null;
	    bcOrderLineIt = null;
	    rootId = null;
	}
}"
			   SEQUENCE="4"
			   UPDATED="06/18/2025 17:20:09"
			   UPDATED_BY="MONISHAJ"
			   CREATED="06/18/2025 17:20:09"
