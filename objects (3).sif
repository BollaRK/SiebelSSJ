			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetProfileAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetProfileAttr (Inputs, Outputs)
{
	var strPropName = &quot;&quot;, strPropValue = &quot;&quot;;
	strPropName = Inputs.GetFirstProperty();
	
	while (strPropName != &quot;&quot;)
	{
		strPropValue = Inputs.GetProperty(strPropName);
		TheApplication().SetProfileAttr(strPropName, strPropValue);
		strPropName = Inputs.GetNextProperty();
	}
	var sOrderId= Inputs.GetProperty(&quot;OrderId&quot;);
		var sPPBS = TheApplication().GetService(&quot;VHA Prepayments BS&quot;);
		var sPPInputs  = TheApplication().NewPropertySet();
		var sPPOutputs = TheApplication().NewPropertySet();
		sPPInputs.SetProperty(&quot;OrderId&quot;, sOrderId);			
		sPPBS.InvokeMethod(&quot;DeleteCCDetails&quot;, sPPInputs, sPPOutputs);
	/*
	//Soumalya:Deactivated below code as it was breaking Back to Cart / Edit in cart &amp; Resume from Credit check SFJ
	//var QuoteId = Inputs.GetProperty(&quot;TBUIQuoteId&quot;);
	var taskUIsvc = TheApplication().GetService(&quot;Shopping Service&quot;);
	var inputPropSet = TheApplication().NewPropertySet();
	var outputPropSet = TheApplication().NewPropertySet();
	inputPropSet.SetProperty(&quot;View&quot;, &quot;VHA SSJ Sales Calculator Search View&quot;);
	//inputPropSet.SetProperty(&quot;Business Component&quot;, &quot;Order Entry - Orders&quot;);
	inputPropSet.SetProperty(&quot;Row Id&quot;, sOrderId);
	taskUIsvc.InvokeMethod(&quot;GotoView&quot;, inputPropSet, outputPropSet);
				
	*/
	
}"
