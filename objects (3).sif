			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetOrderItemAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetOrderItemAttr(oLineXA,sSearchExpr,sCharVal)
{

		try
		{
				var oBCLitemItemXA;		
		
				oBCLitemItemXA = oLineXA.GetBusComp(&quot;Order Item XA (Simple)&quot;);
				with(oBCLitemItemXA)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Text Value&quot;);
					ActivateField(&quot;Name&quot;);
					//searchst3 = &quot;[Name]=&apos;Prepayment Amount&apos; AND [Object Id] = &apos;&quot; + sGPPId + &quot;&apos;&quot;
					SetSearchExpr(sSearchExpr);
					ExecuteQuery(ForwardOnly);					
					if (FirstRecord())
					{
						SetFieldValue(&quot;Text Value&quot;, sCharVal);
						WriteRecord();
					}
				}
		}
		
		catch(e)
		{
			throw(e);
		}
		
		finally
		{
			oBCLitemItemXA = null;
		}

}"
