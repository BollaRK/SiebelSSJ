			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fGetTotalCosPerMonth"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fGetTotalCosPerMonth(Inputs, Outputs)
{
	try
	{
		var BillingAccountId= Inputs.GetProperty(&quot;BillingAccountId&quot;);
		var AccountBO = TheApplication().GetBusObject(&quot;Account&quot;);	
		var AccountBC = AccountBO.GetBusComp(&quot;Account&quot;);		

		var BillingAccountBO = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);	
		var BillingAccountBC = BillingAccountBO.GetBusComp(&quot;VF Billing Account&quot;);
		var AssetBC = BillingAccountBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);

		var VFAssetBO = TheApplication().GetBusObject(&quot;VF Asset Mgmt - Asset Header (Order Mgmt)&quot;);	
		var AssetOrderBC = VFAssetBO.GetBusComp(&quot;Asset Mgmt - Asset (Order Mgmt)&quot;);
		var AssetXAbc = VFAssetBO.GetBusComp(&quot;Asset Mgmt - Asset XA&quot;);

		var PriceListBO = TheApplication().GetBusObject(&quot;Admin Price List&quot;);
		var PriceListBC = PriceListBO.GetBusComp(&quot;Price List&quot;);
		var PriceListItemBC = PriceListBO.GetBusComp(&quot;Price List Item&quot;);
		
		var	oProductBO = TheApplication().GetBusObject(&quot;Admin ISS Product Definition&quot;);
		var	oProductBC = oProductBO.GetBusComp(&quot;Internal Product - ISS Admin&quot;);
		
		var BillingAccountBO1 = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);	
		var BillingAccountBC1 = BillingAccountBO1.GetBusComp(&quot;VF Billing Account&quot;);
		
		var PriceListId=&quot;&quot;;
		var sAssetId=&quot;&quot;;		
		var RatePlanMaxPriceGST=0;
		var sGPPProductId=&quot;&quot;;
		var sAPPProductId=&quot;&quot;;
		var sGPPMonthlyRepayment=0;
		var sAPPMonthlyRepayment=0;
		var RatePlanMaxPrice=0;
		var sAddOnProductId=&quot;&quot;;
		var sAddOnProductName=&quot;&quot;;
		var AddOnMaxPriceGST=0;
		var CreditMaxPriceGST=0;
		var sRDAmount=0;
		var sDiscountTen=0;
		var sDiscountFive=0;
		var sOverAmount=0;
		var sPegaAmount=0;
		var LDMaxPriceGST=0;
		var MSPMaxPriceGST=0;
		var TotalCost=0;
		var CustAccountId=&quot;&quot;;
		
		with(BillingAccountBC1)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Master Account Id&quot;);
			SetSearchSpec(&quot;Id&quot;, BillingAccountId);	
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				CustAccountId = GetFieldValue(&quot;Master Account Id&quot;);
			}
		}
		
		with(oProductBC)
		{
			ClearToQuery();								
			ActivateField(&quot;Name&quot;); 						
			SetViewMode(AllView);
			SetSearchSpec(&quot;Name&quot;, &quot;GPP Device Contract&quot;);								
			ExecuteQuery(ForwardOnly);			
			if (FirstRecord())			
			{										
				sGPPProductId = GetFieldValue(&quot;Id&quot;);
			}
		}
		
		with(oProductBC)
		{
			ClearToQuery();								
			ActivateField(&quot;Name&quot;); 						
			SetViewMode(AllView);
			SetSearchSpec(&quot;Name&quot;, &quot;APP Contract&quot;);								
			ExecuteQuery(ForwardOnly);			
			if (FirstRecord())			
			{										
				sAPPProductId = GetFieldValue(&quot;Id&quot;);
			}
		}		
			
		with(AccountBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Price List Id&quot;);
			SetSearchSpec(&quot;Id&quot;, CustAccountId);	
			ExecuteQuery(ForwardOnly);		 	
			if(FirstRecord())
			{				 							
				PriceListId = GetFieldValue(&quot;Price List Id&quot;);
				
				
				with(PriceListBC)
				{
					SetViewMode(AllView);
					ClearToQuery();					
					SetSearchSpec(&quot;Id&quot;, PriceListId);	
					ExecuteQuery(ForwardOnly);		 	
					if(FirstRecord())
					{				
						with(BillingAccountBC)
						{
							SetViewMode(AllView);
							ClearToQuery();							
							SetSearchSpec(&quot;Id&quot;, BillingAccountId);	
							ExecuteQuery(ForwardOnly);						
							if(FirstRecord())
							{	
								with(AssetBC)
								{
									SetViewMode(AllView);
									ClearToQuery();
									ActivateField(&quot;VF Rate Plan&quot;);
									ActivateField(&quot;Status&quot;);
									ActivateField(&quot;Primary MSISDN&quot;);
									ActivateField(&quot;Billing Account Id&quot;);							
									SetSearchSpec(&quot;Billing Account Id&quot;, BillingAccountId);	
									ExecuteQuery(ForwardOnly);		 	
									var isrec1 = FirstRecord();
									while(isrec1)
									{				 							
										var AssetStatus = GetFieldValue(&quot;Status&quot;);
										var MSISDN = GetFieldValue(&quot;Primary MSISDN&quot;);
										var RatePlan = GetFieldValue(&quot;VF Rate Plan&quot;);
										sAssetId = GetFieldValue(&quot;Id&quot;);
										

										with(PriceListItemBC)
										{
											SetViewMode(AllView);
											ClearToQuery();
											ActivateField(&quot;Price List Id&quot;);
											ActivateField(&quot;Product Name&quot;);
											ActivateField(&quot;Max Sale Price&quot;);
											//SetSearchSpec(&quot;Price List Id&quot;, PriceListId);
											SetSearchSpec(&quot;Product Name&quot;, RatePlan);
											ExecuteQuery(ForwardOnly);		 	
											if(FirstRecord())
											{				 							
												RatePlanMaxPrice = GetFieldValue(&quot;Max Sale Price&quot;);
												
												RatePlanMaxPriceGST= RatePlanMaxPrice*1.1;
												
												RatePlanMaxPriceGST = TruncateAmount(RatePlanMaxPriceGST);
															
												
												with(AssetOrderBC)
												{
													ClearToQuery();
													SetViewMode(AllView);
													ActivateField(&quot;Root Asset Id&quot;);
													ActivateField(&quot;VHA Siebel Product Type&quot;);
													ActivateField(&quot;Product Name&quot;);		
													SetSearchExpr(&quot;[Root Asset Id]=&apos;&quot;+ sAssetId + &quot;&apos; AND [Product Id]= &apos;&quot;+ sGPPProductId + &quot;&apos; AND [Status] = &apos;Active&apos;&quot;);
													ExecuteQuery(ForwardOnly);	
													var isrec2= FirstRecord();
													while(isrec2)
													{
														var sGPPAssetId = GetFieldValue(&quot;Id&quot;);
														
														with(AssetXAbc)
														{
														ClearToQuery();
														SetViewMode(AllView);
														ActivateField(&quot;Object Id&quot;);	
														ActivateField(&quot;Display Name&quot;);
														ActivateField(&quot;Value&quot;);
														SetSearchSpec(&quot;Object Id&quot;, sGPPAssetId);
														SetSearchSpec(&quot;Display Name&quot;, &quot;Monthly Repayment&quot;);
														ExecuteQuery(ForwardOnly);
															if(FirstRecord())
															{
																sGPPMonthlyRepayment = GetFieldValue(&quot;Value&quot;);
																	
