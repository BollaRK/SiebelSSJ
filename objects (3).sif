			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateBulkConnectPortInPromoCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateBulkConnectPortInPromoCode (Inputs, Outputs)
{
/*
 * Component Name        : 	VF Postpay Utilities Service
 * Method Name           : 	mValidateBulkConnectPortInPromoCode
 * Modification History  :
 * Date			Author		Config #	   			Description
 * ============ ===========	=====================	==================================================================
 * 11/06/2019	NandhiniG 	MR03 - Bulk Tool Update  Checks whether the Promo Code given in Bulk Connect &amp; Port In template is active in Siebel.
 */	
 	try
	{
		var sOfferBO,sOfferBC;
		var sSearchExpr;
		var sPromoCode = Inputs.GetProperty(&quot;Promo Code&quot;);
		var sToday , sFinalEndDate;
		var sEndDate, sStatus;
		var sErrMsg =&quot;&quot;;		
		if(sPromoCode != &quot;&quot; &amp;&amp; sPromoCode != null)
		{
			sOfferBO = TheApplication().GetBusObject(&quot;VF Rewards Offer Matrix&quot;);
			sOfferBC = sOfferBO.GetBusComp(&quot;VF Published Rewards Offer Matrix-Thin&quot;);
			with(sOfferBC)
			{
				SetViewMode(AllView);
				ActivateField(&quot;Promo Code&quot;);
				ActivateField(&quot;Status&quot;);
				ActivateField(&quot;End Date&quot;);
				ClearToQuery();
				sSearchExpr = &quot;[Promo Code] ~= &apos;&quot; + sPromoCode + &quot;&apos;&quot;;
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sEndDate = GetFieldValue(&quot;End Date&quot;);
					sStatus = GetFieldValue(&quot;Status&quot;);
					sToday = new Date();
					sFinalEndDate = new Date(sEndDate);
					if(sStatus != &quot;Active&quot;)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
					}
					else if(sFinalEndDate &lt; sToday)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered has expired. Please enter the correct Promo Code&quot;);
					}	
				}
				else
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Promo Code &quot; + sPromoCode + &quot; entered is invalid. Please enter the correct Promo Code&quot;);
				}
			}
		}
    return(CancelOperation);
	}
	catch (e)
	{
       throw(e);	
	}
	finally
	{
	    sOfferBC = null;
	    sOfferBO = null;
	}
}"
			   SEQUENCE="25"
