			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateUNISIMCustomerDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateUNISIMCustomerDetails(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateCustomerDetails
	* Method Name           : 	
	* Component Information : 	This function validates all fields entered
	*							correct
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 10/09/2015	Roseline	UNISIM		Cloned from Existing Merlin and modified as per TBUI needs
	*/
	
	var bcAccount;
	//var sPIN;
	var sABNACN;
	var sValidateACN;
	var sValidateABN;
	var sSOHO;
	var sErrMsg =&quot;&quot;;
	var sType;
	var	sAlias;
	var sIndustryType;
	var sCompanyName;
	var sCustomerId;
	var sRaiseError = &quot;N&quot;;
	var sCoverageCheck;
	var sARBN;
	
	try
	{			
		//sPIN = Inputs.GetProperty(&quot;CA PIN&quot;);
		sType = Inputs.GetProperty(&quot;Customer Type&quot;);
		sSOHO = Inputs.GetProperty(&quot;Sole Trader&quot;);
		sABNACN =  Inputs.GetProperty(&quot;ABN ACN&quot;);
		sIndustryType =  Inputs.GetProperty(&quot;Industry Type&quot;);
		sCompanyName = Inputs.GetProperty(&quot;Company Name&quot;);
		sCoverageCheck = Inputs.GetProperty(&quot;IsCoverageCheck&quot;); 
		sARBN = Inputs.GetProperty(&quot;ARBN&quot;);
		
		//Save CJ details - Profile attribute is set during CJ search BC &quot;VF Bulk Migrate Services Search&quot;
		if (TheApplication().GetProfileAttr(&quot;CJCustomerAccNum&quot;) != &quot;&quot;)
		{	
			mSaveCJDetails();
		}															
		//Muthushankari 30/3/2017 - Commented as part of R17.2 Service PIN Validation CIR
		/*else if (sPIN.length &lt; 4 || sPIN.length &gt; 4)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;PIN must be 4 digit long, Please enter exactly 4 digits.&quot; );
			sRaiseError = &quot;Y&quot;;
		}
		else if (isNaN(sPIN))
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;PIN should be 4 digit number.&quot; );
			sRaiseError = &quot;Y&quot;;
		}*/	
		if (sType != &quot;Person&quot;)
		{
			if (sCompanyName == &quot;&quot; || sCompanyName == null)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Company Name is required Field. Please enter a value for the field.&quot;);
				sRaiseError = &quot;Y&quot;;
			}		
			else if (sIndustryType == &quot;&quot; || sIndustryType == null)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Industry Type is required Field. Please enter a value for the field.&quot;);
				sRaiseError = &quot;Y&quot;;
			}				
			else if(sABNACN != &quot;&quot; &amp;&amp; sABNACN != null)
			{						
				if(sABNACN.length != 9 &amp;&amp; sABNACN.length != 11)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ABN or ACN Number, ABN number must 11 digits long and ACN must be 9 digits long. Please enter the correct numbers.&quot;);
					sRaiseError = &quot;Y&quot;;
				}
				// Validate ABN Number
				else if	(sABNACN == &quot;00000000000&quot; || sABNACN == &quot;00000000001&quot;)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;00000000000 / 00000000001 is not a valid ABN/ACN number&quot;);
					sRaiseError = &quot;Y&quot;;
				}
				else if ((sABNACN.length == 11) &amp;&amp; sType != &quot;Local Registered Company&quot;)
				{
					sValidateABN = mValidateABN(sABNACN);			
					
					if (sValidateABN == false)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ABN Number Please Enter Valid 11 Digit ABN number.&quot;);
						sRaiseError = &quot;Y&quot;;
					}		
				}	
				// Validate ACN Number						
				if(sABNACN.length == 9)
				{
					sValidateACN = mValidateACN(sABNACN);			
					if (sValidateACN == false)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ACN Number Please Enter Valid 9 Digit ACN Number.&quot;);
						sRaiseError = &quot;Y&quot;;
					}			
				}//	if(sABNACN.length == 9)
			}//else if(sABNACN != &quot;&quot; &amp;&amp; sABNACN != null)
			
			//Roseline:23/09/2015 - Added for ARBN Validation
			else if(sARBN != &quot;&quot; &amp;&amp; sARBN != null)
			{						
				if(sARBN.length != 9)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ARBN Number, ARBN number must 9 digits long. Please enter the correct numbers.&quot;);
					sRaiseError = &quot;Y&quot;;
				}
				// Validate ABN Number
				else if	(sARBN == &quot;000000000&quot; || sARBN == &quot;000000001&quot;)
				{
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;000000000 / 000000001 is not a valid ARBN number&quot;);
					sRaiseError = &quot;Y&quot;;
				}
				else if(sARBN.length == 9)
				{
					sValidateACN = mValidateACN(sARBN);			
					if (sValidateACN == false)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Invalid ARBN Number.Please Enter Valid 9 Digit ARBN Number.&quot;);
						sRaiseError = &quot;Y&quot;;
					}			
				}//	if(sABNACN.length == 9)
			}//else if(sARBN != &quot;&quot; &amp;&amp; sARBN != null)	
			//end of code
		} //if (sType != &quot;Person&quot;)
		if(sRaiseError == &quot;N&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
		}
	}//try
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;, e);
		//throw e;
	}
	finally
	{
		
	}
}"
