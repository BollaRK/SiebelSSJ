			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateSIMTypeinUniqueHandsetDraftVersion"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateSIMTypeinUniqueHandsetDraftVersion(sProductCode, sSIMType, sVersionId)
{ //Sachi - 26/01/2019 - Added for R19.1 Atom Phase 2 to update SIM type from Live to Draft version during handset import
	try
	{
		var oBusObj = TheApplication().GetBusObject(&quot;VF Handset Matrix&quot;);
		var oUHBC = oBusObj.GetBusComp(&quot;VF Unique Handset&quot;);
		var sDraftRecExist = &quot;&quot;;
		
		with(oUHBC)
		{
			ActivateField(&quot;Product Code&quot;);
			ActivateField(&quot;SIMType&quot;);
			ActivateField(&quot;Version Id&quot;);
			ActivateField(&quot;Version Status&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Product Code] = &apos;&quot;+sProductCode+&quot;&apos; AND [Version Status] = &apos;Draft&apos; AND [Version Id] = &apos;&quot;+sVersionId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			sDraftRecExist = FirstRecord();			
			if(sDraftRecExist)
			{
				SetFieldValue(&quot;SIMType&quot;, sSIMType);						
				WriteRecord();
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oUHBC = null;
		oBusObj = null;
	}
}"
