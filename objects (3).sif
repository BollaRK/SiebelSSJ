			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetUpdateDeviceDetail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function GetUpdateDeviceDetail(Inputs, Outputs) 
{
    var ChildOrderId = &quot;&quot;,
    childOrderSubType = &quot;&quot;,
    childOrderFunc = &quot;&quot;,
    bcOrder = null,
    bsProdModel = null,
    bsProdInp = null,
    bsProdOut = null,
    QuoteId = &quot;&quot;,
    bcAttr = null,
    srootOLIId = &quot;&quot;,
    Isrecord = &quot;&quot;,
    sValue = &quot;&quot;,
    sTermValue = &quot;&quot;,
    srootLIId = &quot;&quot;,
    srootLIActionCd = &quot;&quot;,
    lovSwitch = &quot;N&quot;,
    bcName = null,
    bcDFAName = null,
    vConnType = &quot;SIM Only&quot;,
    Frecord = null,
    chldOrdrecord = null,
    oBCPick = null,
    sOrderSubTypeTBUI = &quot;&quot;,
    sOrderFunction = &quot;&quot;,
    sMSISDN = &quot;&quot;,
	sServiceType = &quot;&quot;,
	FwaNetwork = &quot;&quot;;
    try 
	{
        QuoteId = Inputs.GetProperty(&quot;OrderId&quot;);
        bsProdInp = TheApplication().NewPropertySet();
        bsProdOut = TheApplication().NewPropertySet();
        bcOrder = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
        bcName = TheApplication().GetBusObject(&quot;Order Item&quot;).GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
        bcAttr = TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Item XA (No Link)&quot;);
        bcDFAName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VFDfa Order Entry Line Items Thin BC&quot;);
        //bsProdModel = TheApplication().GetService(&quot;VF Product Modelling Service&quot;);
        with (bcOrder) 
		{
            SetViewMode(AllView);
            ActivateField(&quot;Quote Id&quot;);
            ActivateField(&quot;Parent Order Id&quot;);
            ActivateField(&quot;Order Sub Type&quot;);
            ActivateField(&quot;VF Order Function&quot;);
            ClearToQuery();
            SetSearchExpr(&quot;[Quote Id] = &apos;&quot; + QuoteId + &quot;&apos; OR [Parent Order Id] = &apos;&quot; + QuoteId + &quot;&apos;&quot;);
            ExecuteQuery(ForwardOnly);
            chldOrdrecord = FirstRecord();
            if (chldOrdrecord) 
			{
                while (chldOrdrecord) 
				{
                    ChildOrderId = GetFieldValue(&quot;Id&quot;); // connect order row-id
                    childOrderSubType = GetFieldValue(&quot;Order Sub Type&quot;);
                    childOrderFunc = GetFieldValue(&quot;VF Order Function&quot;);
                    with (bcDFAName) 
					{
                        //query for root line items
                        SetViewMode(AllView);
                        ActivateField(&quot;Order Header Id&quot;);
                        ActivateField(&quot;Action Code&quot;);
                        ActivateField(&quot;Root Order Item Id&quot;);
                        ActivateField(&quot;Parent Order Item Id&quot;);
                        ActivateField(&quot;VF Device TBUI&quot;);
                        ActivateField(&quot;VF ConnectionType&quot;);
                        ActivateField(&quot;VHASSJ Payment Term&quot;);
                        ActivateField(&quot;VF Order Type TBUI&quot;);
                        ActivateField(&quot;VF Order Function&quot;);
                        ActivateField(&quot;MSISDN&quot;);
						ActivateField(&quot;VF Service Type&quot;);
						ActivateField(&quot;Sharing Option Calc&quot;);
                        ActivateField(&quot;VF Sharing Order Updateable&quot;);
                        ActivateField(&quot;Sharing Compatibility&quot;);
						ActivateField(&quot;Sharing Group Compatibility&quot;);
						ActivateField(&quot;Special Rating List Type&quot;);
                        ClearToQuery();
                        SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
                        ExecuteQuery(ForwardOnly);
                        Frecord = FirstRecord();
                        while (Frecord) 
						{
                            srootOLIId = GetFieldValue(&quot;Id&quot;); //root line item row-id
                            srootLIActionCd = GetFieldValue(&quot;Action Code&quot;); //root line item row-id
                            sOrderSubTypeTBUI = GetFieldValue(&quot;VF Order Type TBUI&quot;);
                            sOrderFunction = GetFieldValue(&quot;VF Order Function&quot;);
                            sMSISDN = GetFieldValue(&quot;MSISDN&quot;);
							sServiceType = GetFieldValue(&quot;VF Service Type&quot;);
							FwaNetwork = GetFieldValue(&quot;Special Rating List Type&quot;);
                            TheApplication().SetProfileAttr(&quot;VF Authenticated MSISDN&quot;, GetFieldValue(&quot;MSISDN&quot;));
							if(sServiceType == &quot;Postpay&quot;)
							{
	                            with (bcName) 
								{
	                                //query for gpp child line item under the current root
	                                SetViewMode(AllView);
	                                ActivateField(&quot;Parent Order Id&quot;);
	                                ActivateField(&quot;Order Header Id&quot;);
	                                ActivateField(&quot;Product&quot;);
	                                ActivateField(&quot;Action Code&quot;);
	                                ActivateField(&quot;Root Order Item Id&quot;);
	                                ClearToQuery();
	                                SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND ([Product] =&apos;GPP Device Contract&apos; AND [Action Code] =&apos;Add&apos;) AND [Root Order Item Id]=&apos;&quot; + srootOLIId + &quot;&apos;&quot;);
	                                ExecuteQuery(ForwardOnly);
	                                if (FirstRecord()) 
									{
	                                    vConnType = &quot;Plan and Device&quot;;
	                                    srootLIId = GetFieldValue(&quot;Id&quot;); // GPP device line item id
	                                    with (bcAttr) 
										{
	                                        SetViewMode(AllView);
	                                        ActivateField(&quot;Object Id&quot;);
	                                        ActivateField(&quot;Name&quot;);
	                                        ActivateField(&quot;Text Value&quot;);
	                                        ClearToQuery();
	                                        SetSearchExpr(&quot;[Object Id] = &apos;&quot; + srootLIId + &quot;&apos; AND [Name]=&apos;Item Code&apos;&quot;);
	                                        ExecuteQuery(ForwardOnly);
	                                        if (FirstRecord()) 
											{
	                                            sValue = GetFieldValue(&quot;Text Value&quot;);
	                                            TheApplication().SetProfileAttr(&quot;SKUCode&quot;, sValue);
	                                        }
	                                        SetViewMode(AllView);
	                                        ActivateField(&quot;Object Id&quot;);
	                                        ActivateField(&quot;Name&quot;);
	                                        ActivateField(&quot;Text Value&quot;);
	                                        ClearToQuery();
	                                        SetSearchExpr(&quot;[Object Id] = &apos;&quot; + srootLIId + &quot;&apos; AND [Name]=&apos;Term&apos;&quot;);
	                                        ExecuteQuery(ForwardOnly);
	                                        if (FirstRecord()) 
											{
	                                            sTermValue = GetFieldValue(&quot;Text Value&quot;);
	                                        }
	                                    }
	                                } 
									else 
									{
	                                    if ((sOrderSubTypeTBUI == &quot;Modify&quot; || sOrderSubTypeTBUI == &quot;Change Proposition&quot;) &amp;&amp; (sOrderFunction == &quot;&quot; || sOrderFunction == null)) 
										{
	                                        //do nothing
	                                        vConnType = &quot;&quot;;
	                                    } 
										else
	                                        vConnType = &quot;SIM Only&quot;;
	                                }
	                            }
	                            if (sTermValue != &quot;&quot; &amp;&amp; sTermValue != null)
	                                SetFieldValue(&quot;VHASSJ Payment Term&quot;, sTermValue);
	                            if (sValue != &quot;&quot; &amp;&amp; sValue != null) 
								{
	                                oBCPick = bcDFAName.GetPicklistBusComp(&quot;VF Device TBUI&quot;);
	                                with (oBCPick) 
									{
	                                    ClearToQuery();
	                                    ActivateField(&quot;Product Code&quot;);
	                                    SetSearchSpec(&quot;Product Code&quot;, sValue);
	                                    ExecuteQuery(ForwardOnly);
	                                    if (FirstRecord()) 
										{
	                                        Pick();
	                                    }
	                                }
	                            }
	                            SetFieldValue(&quot;VF ConnectionType&quot;, vConnType);
	                            //SetFieldValue(&quot;VF MSISDN TBUI&quot;, sMSISDN);
	                            WriteRecord();
	                            //Added block for Post Config Steps
	                         // try 
							//	{
	                         /*        if (childOrderSubType == &quot;Connect&quot;) 
									{
	                                    //For Voice Only
										bsProdModel = TheApplication().GetService(&quot;VF Product Modelling Service&quot;);
	                                    bsProdInp.Reset();
	                                    bsProdInp.SetProperty(&quot;Order Id&quot;, ChildOrderId);
	                                    bsProdInp.SetProperty(&quot;Root Line Item Id&quot;, srootOLIId);
	                                    bsProdInp.SetProperty(&quot;AccessTechnology&quot;, &quot;&quot;);
	                                    bsProdInp.SetProperty(&quot;IsSharingUpdateReq&quot;, &quot;Y&quot;);
	                                    bsProdInp.SetProperty(&quot;VHANPEYStatus&quot;, &quot;&quot;);
	                                    bsProdModel.InvokeMethod(&quot;All Post Configurator Steps Optimization&quot;, bsProdInp, bsProdOut);
										bsProdModel = null;
	                                }  */
									
									if (childOrderSubType == &quot;Connect&quot;)
									{	//added this to set data sharing flag
										SetFieldValue(&quot;VF Sharing Order Updateable&quot;, GetFieldValue(&quot;Sharing Option Calc&quot;));
										TheApplication().SetProfileAttr(&quot;SharingOptionCalc&quot;, GetFieldValue(&quot;Sharing Option Calc&quot;));
										TheApplication().SetProfileAttr(&quot;SharingCompatibility&quot;, GetFieldValue(&quot;Sharing Compatibility&quot;));
										TheApplication().SetProfileAttr(&quot;SharingGroupCompatibility&quot;, GetFieldValue(&quot;Sharing Group Compatibility&quot;));
									}
									
									else if (childOrderFunc == &quot;UPGRADE&quot;) 
									{
	                                    //Upgrade - Both Modify and Change prop to be handled
	                                    //Do nothing
	                                    bsProdInp.Reset();
	                                } 
									else 
									{
	                                    //RPC - Both Modify and Change prop to be handled
	                                    //Do nothing
	                                    bsProdInp.Reset();
	                                }
	                        
							}
							else if(sServiceType == &quot;FWA&quot;) //Murugan:Added:CM-10772
							{
								if (sServiceType != &quot;Postpay&quot;)
								{
									if (FwaNetwork == &quot;VFAUPostPayFWA4G&quot; || FwaNetwork == &quot;VFAUPostPayFWA5GNSA&quot;)
									{
										SetFieldValue(&quot;VF ConnectionType&quot;, &quot;Plan and Device&quot;);
										WriteRecord();
									}
								}
							}
                            sValue = &quot;&quot;;
                            sTermValue = &quot;&quot;;
                            vConnType = &quot;&quot;;
                            Frecord = NextRecord();
                        }
                    }
                    chldOrdrecord = NextRecord();
                }
            }
        }
       
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        ChildOrderId = null;
        lovSwitch = null;
        bcName = null;
        Frecord = null;
        bcDFAName = null;
        oBCPick = null;
        bcAttr = null;
    }
}
"
			   SEQUENCE="11"
