			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetRewardProduct"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetRewardProduct(Inputs,Outputs)
{
 
	try
	{ 

		var sSAM_Product_ID = Inputs.GetProperty(&quot;SAM_Product_ID&quot;);
		var RewardProduct =&quot;&quot;;
		var sProdBC = TheApplication().GetBusObject(&quot;Admin ISS Product Definition&quot;).GetBusComp(&quot;Internal Product - ISS Admin&quot;);	

		with(sProdBC)
		{
			ClearToQuery();
			ActivateField(&quot;Vendor Part Number&quot;);
			ActivateField(&quot;Cfg Released Flag&quot;);                            
			ActivateField(&quot;Name&quot;);                 
			SetViewMode(AllView);
			SetSearchSpec(&quot;Vendor Part Number&quot;,sSAM_Product_ID); 
			SetSearchSpec(&quot;Cfg Released Flag&quot;,&quot;N&quot;); 
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{   
				RewardProduct=  GetFieldValue(&quot;Name&quot;);
			}
		}
		Outputs.SetProperty(&quot;RewardProduct&quot;,RewardProduct);	
			
	}
	catch(e)
	{
		throw e;		
	}
	finally
	{
		sProdBC = null;		
	}
}"
