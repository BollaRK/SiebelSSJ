			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPAttribUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPAttribUpdate(Inputs, Outputs)
{

	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);		
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sOrderItemBC = sBO.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
		var sOLIXA = sBO.GetBusComp(&quot;Order Item XA&quot;);
		var sAccBC = sBO.GetBusComp(&quot;VHA Accessory Item TBUI&quot;);
		var sAccPrepayAmt = new Array;
		var sAccId = new Array;
		var sOLIId = new Array;
		var searchst1;
		var searchst2;
		var searchst3;
		var i = 0;
		var j = 0;
		var z = 0;
		var k = 0;
		var sAccCount = 0;
		var sOrderItemId = new Array;
		var sAttribName = &quot;Prepayment Amount&quot;;
		var isRecord;
		with (sAccBC)
		{
			ActivateField(&quot;Id&quot;);
			ActivateField(&quot;Hardware Code&quot;);
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;VHA Accessory Prepayment Amount&quot;);			
			ActivateField(&quot;Related Service Order Id&quot;);			
			ClearToQuery(); 
			SetViewMode(AllView);			
			searchst1 = &quot;[Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			SetSearchExpr(searchst1);
			SetSortSpec(&quot;Related Service Order Id(ASCENDING), Hardware Code(ASCENDING)&quot;);
			ExecuteQuery(ForwardOnly);
			sAccCount = CountRecords();			
			isRecord = FirstRecord();
			while(isRecord)
			{
				sAccId[i] = GetFieldValue(&quot;Hardware Code&quot;);
				sAccPrepayAmt[i] = GetFieldValue(&quot;VHA Accessory Prepayment Amount&quot;);
				sOLIId[i] = GetFieldValue(&quot;Related Service Order Id&quot;);
				i = i+1;				
				isRecord = NextRecord();
			}
			
		}
	
		with(sOrderItemBC)
		{
			
			for(j=0;j&lt;sAccCount;j++)
			{
				k=0;
				//if(ToNumber(sAccPrepayAmt[j]) &gt; 0)
				//{
					ActivateField(&quot;Id&quot;);
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;Contract Type&quot;);
					ClearToQuery(); 
					SetViewMode(AllView);			
					searchst2 = &quot;[Order Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sOLIId[j] + &quot;&apos; AND [Contract Type] = &apos;&quot; + sAccId[j] + &quot;&apos;&quot;;
					SetSearchExpr(searchst2);
					ExecuteQuery(ForwardOnly);
                    var isrec = FirstRecord(); // added by balajiM for MR04 Fallout - 28/8/2019
					var sCount = CountRecords();
					while(isrec)
					{
						 k = k + 1;
						sOrderItemId[j] = GetFieldValue(&quot;Id&quot;);
						if (k &lt;= ToNumber(sCount)-1)
						{
							j = j + 1;
						}
					
						/*with(sOLIXA)
						{
							ActivateField(&quot;Order Header Id&quot;);
							ActivateField(&quot;Object Id&quot;);
							ActivateField(&quot;Name&quot;);
							ActivateField(&quot;Text Value&quot;);
							ClearToQuery(); 
							SetViewMode(AllView);			
							searchst3 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Object Id] = &apos;&quot; + sOrderItemId + &quot;&apos; AND [Name] = &apos;&quot; + sAttribName + &quot;&apos;&quot;;
							SetSearchExpr(searchst3);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{
								SetFieldValue(&quot;Text Value&quot;, sAccPrepayAmt[j]);
								WriteRecord();
							}
						}*/
                      isrec = NextRecord(); //added by balajiM for MR04 Fallout - 28/8/2019
					}
				}
				
			//}
		
		}
		for(z=0;z&lt;sAccCount;z++)
		{
			with(sOLIXA)
			{
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Object Id&quot;);
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Text Value&quot;);
				ClearToQuery(); 
				SetViewMode(AllView);			
				searchst3 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Object Id] = &apos;&quot; + sOrderItemId[z] + &quot;&apos; AND [Name] = &apos;&quot; + sAttribName + &quot;&apos;&quot;;
				SetSearchExpr(searchst3);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					if(ToNumber(sAccPrepayAmt[z]) == 0)
						SetFieldValue(&quot;Text Value&quot;, &quot;&quot;);
					else
						SetFieldValue(&quot;Text Value&quot;, sAccPrepayAmt[z]);
					WriteRecord();
				}
			}
		}
		
	
	
	
	
	
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderId = null; 
		sBO = null; 
		sOrderItemBC = null;
		sOLIXA = null; 
		sAccBC = null; 
		sAccPrepayAmt = null;
		sAccId = null; 
		searchst1 = null;
		searchst2 = null;
		searchst3 = null;
		i = null; 
		j = null; 
		sAccCount = null; 
		sOrderItemId = null;
		sAttribName = null; 
		isRecord = null;
	
	}

}"
			   SEQUENCE="2"
			   UPDATED="11/19/2019 19:38:06"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPCalculate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPCalculate (Inputs,Outputs)
{

//VHA Prashanth 200519: On update of Prepayment Amount, parent VHA APP Accessory TBUI BC Prepamyment amount/Contract amount is updated
//Called from WriteRecord of VHA Accessory Item TBUI - BC
 var oBO = TheApplication().ActiveBusObject();
 var oParBC = oBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
 var oChildBC = oBO.GetBusComp(&quot;VHA Accessory Item TBUI&quot;);
 var sUpg = Inputs.GetProperty(&quot;Upgrade&quot;);
 if(sUpg == &quot;Y&quot;){
 oParBC = oBO.GetBusComp(&quot;VHA APP Accessory TBUI Thin BC&quot;);
 oChildBC = oBO.GetBusComp(&quot;VHA Accessory Item - Upgrade TBUI&quot;);
 }
 var oTBC = oBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
 var sTotalAPP=0; 
 var sBfr=0; 
 var sBfAPPr=0;
 var sRem=0;
 var sRem1=0;
 var sCont=0;
  try{
   with (oChildBC)
   {
   ActivateField(&quot;VHA RRP inc GST&quot;);
   ActivateField(&quot;VHA Accessory Prepayment Amount&quot;);
   ClearToQuery();
   ExecuteQuery(ForwardOnly);
   var sIsRecord = FirstRecord();
	   while(sIsRecord)
	   {
	   sTotalAPP= ToNumber(sTotalAPP) + ToNumber(GetFieldValue(&quot;VHA Accessory Prepayment Amount&quot;));
	   sIsRecord = NextRecord();
	   }//while
	}//with

   with (oParBC)
   {
   ActivateField(&quot;VHA APP Prepayment Amount&quot;);
   ActivateField(&quot;VHA RRP inc GST&quot;);
   sBfr=ToNumber(GetFieldValue(&quot;VHA APP Prepayment Amount&quot;));
   if (sTotalAPP &lt; sBfr){
   sRem = ToNumber(sBfr) - ToNumber(sTotalAPP);
   sCont=ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;)) + sRem;
   SetFieldValue(&quot;VHA RRP inc GST&quot;, sCont);
   WriteRecord();
   }
   else if (sTotalAPP &gt; sBfr){
   sRem = ToNumber(sTotalAPP) - ToNumber(sBfr);
   sCont=ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;)) - sRem;
   SetFieldValue(&quot;VHA RRP inc GST&quot;, sCont);
   WriteRecord();
   }
   
   SetFieldValue(&quot;VHA APP Prepayment Amount&quot;, sTotalAPP);
   WriteRecord();
   }//with

   with (oTBC)
   {
   ActivateField(&quot;Total APP yet to allocate&quot;);
   sBfAPPr=ToNumber(GetFieldValue(&quot;Total APP yet to allocate&quot;));
   if (sTotalAPP &lt; sBfr)
   sRem1 = ToNumber(sBfAPPr) + ToNumber(sRem);
   else if (sTotalAPP &gt; sBfr)
   sRem1 = ToNumber(sBfAPPr) - ToNumber(sRem);
	sRem1 = sRem1.toFixed(2);
	
   SetFieldValue(&quot;Total APP yet to allocate&quot;, sRem1);
   WriteRecord();
   }

  }//try
  catch(e)
  {
  throw e;
  }
  finally
  {
  sCont=null;
  sRem=null;
  sRem1=null;
  sBfr=null;
  sBfAPPr=null;
  sTotalAPP=null;
  oChildBC=null;
  oParBC=null;
  oTBC=null;
  oBO=null;
  }
}"
			   SEQUENCE="3"
			   UPDATED="11/06/2019 14:56:28"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPNextValidations"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPNextValidations (Inputs,Outputs)

{
	//VHA Prashanth 300519: Next button validation on APP page
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sAPPBC = sBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
		var sUpg = Inputs.GetProperty(&quot;Upgrade&quot;);
		if(sUpg == &quot;Y&quot;){		
		sAPPBC = sBO.GetBusComp(&quot;VHA APP Accessory TBUI Thin BC&quot;);		
		}
		//var sPrepaymentsBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sTotalAPP = 0;
		var sTotalPPAmt = Inputs.GetProperty(&quot;PrepaymentUpfront&quot;);
		var sAccessoryPP = Inputs.GetProperty(&quot;DevicePPAllocated&quot;);
		var sRemPPAmt = ToNumber(sTotalPPAmt) - ToNumber(sAccessoryPP);
		var iCont=0, iTerm=0, iTermOvr = &quot;&quot;;
		var sAPPAmt = &quot;&quot;;
		var ssjFlow = TheApplication().GetProfileAttr(&quot;SSJFlow&quot;);//VHA KT 31032026: Added to Bbypass validation for Term for SSJ flow	
		var sMinConAmt = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Minimum APP Contract Amount&quot;);
		with(sAPPBC)
		{
			ActivateField(&quot;VHA APP Prepayment Amount&quot;);
			ActivateField(&quot;Contract Term Override&quot;);
			ActivateField(&quot;VHA RRP inc GST&quot;);
			ActivateField(&quot;Contract Term&quot;);			
			ClearToQuery();
			SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			var sIsRecord = FirstRecord();
			while(sIsRecord)
			{
				iTerm = ToNumber(GetFieldValue(&quot;Contract Term&quot;));
				iCont = ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;));
				iTermOvr = GetFieldValue(&quot;Contract Term Override&quot;);
				iCont = iCont.toFixed(2); 
				
				if(ToNumber(iCont) &lt; ToNumber(sMinConAmt) &amp;&amp; ToNumber(iCont) &gt; 0)
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_010&quot;));
				if(iTermOvr == &quot;&quot; || iTermOvr == null)
				{
					if (ToNumber(iCont) != 0 &amp;&amp; ToNumber(iTerm) == 0)
					TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_PREPAYMENT_10&quot;));
					else if (ToNumber(iCont) == 0 &amp;&amp; ToNumber(iTerm) != 0 &amp;&amp; ssjFlow!=&quot;Y&quot;)
					TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_PREPAYMENT_11&quot;));
				}
				
				
				
				sTotalAPP = ToNumber(sTotalAPP) + ToNumber(GetFieldValue(&quot;VHA APP Prepayment Amount&quot;));
				sIsRecord = NextRecord();
				
			}
			ExecuteQuery(ForwardOnly); // to show all the records in UI
		}
		
		sTotalAPP = sTotalAPP.toFixed(2);
		sRemPPAmt = sRemPPAmt.toFixed(2);
		
		if(ToNumber(sTotalAPP) != ToNumber(sRemPPAmt))
		{
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_PREPAYMENT_06&quot;));
		}
		/*else if (sTotalAPP &gt; sRemPPAmt)
		{
			TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_PREPAYMENT_07&quot;));
		}
				
		with(sPrepaymentsBC)
		{
			ActivateField(&quot;Total Accessory PP Amount Paid Upfront&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
			ExecuteQuery();
			if(FirstRecord())
			{
				SetFieldValue(&quot;Total Accessory PP Amount Paid Upfront&quot;,sTotalAPP);
				WriteRecord();
			}
		}*/	
		
		Outputs.SetProperty(&quot;PrepaymentUpAPP&quot;, sTotalAPP);		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderId = null;
		sTotalAPP = null;
		sTotalPPAmt = null;
		sRemPPAmt = null;
		sAPPBC = null;
		//sPrepaymentsBC = null;		
		sBO = null;
	}
}"
			   SEQUENCE="4"
			   UPDATED="03/31/2026 20:22:10"
			   UPDATED_BY="KOVIDT"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPNullifyAmt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPNullifyAmt(sOrderId)
{
	
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	//	var sOrderBC = sBO.GetBusComp(&quot;Order Entry - Orders&quot;);
	//	var sLineItemBC = sBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var sAPPBC = sBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
		var sAccessoryBC = sBO.GetBusComp(&quot;VHA Accessory Item TBUI&quot;);
		var sIsRec1 = &quot;&quot;;
		var sIsRec2 = &quot;&quot;;
		var sNull = &quot;0&quot;;
		var sPrepayAmt = &quot;&quot;;
		var sConAmt = &quot;&quot;;
		
		with(sAPPBC)
					{
						ActivateField(&quot;VHA APP Prepayment Amount&quot;);
						ActivateField(&quot;VHA RRP inc GST&quot;);
						ActivateField(&quot;Order Id&quot;);
						ClearToQuery();
						SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						sIsRec1 = FirstRecord();
						while(sIsRec1)
						{

						
								with(sAccessoryBC)
								{
									InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
									ActivateField(&quot;VHA Accessory Prepayment Amount&quot;);
									ActivateField(&quot;Order Id&quot;);
									ClearToQuery();
									SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
									ExecuteQuery(ForwardOnly);
											
									sIsRec2 = FirstRecord();
									while(sIsRec2)
									{						
										SetFieldValue(&quot;VHA Accessory Prepayment Amount&quot;, ToNumber(sNull));
										WriteRecord();
										sIsRec2 = NextRecord();
										
									}
								
								}
							sPrepayAmt = ToNumber(GetFieldValue(&quot;VHA APP Prepayment Amount&quot;));
							sConAmt = ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;));
							sConAmt = ToNumber(sPrepayAmt) + ToNumber(sConAmt);
							SetFieldValue(&quot;VHA APP Prepayment Amount&quot;, sNull);
							SetFieldValue(&quot;VHA RRP inc GST&quot;, sConAmt);
							WriteRecord();
							sPrepayAmt = &quot;&quot;;
							sConAmt = &quot;&quot;;
							sIsRec1 = NextRecord();
						
						
						}
					}
				
		
		
	}

	catch(e)
	{
		throw(e);
	}
	finally
	{
	
		sBO = null;
		sAPPBC = null;
		sAccessoryBC = null;
		sIsRec1 = null;
		sIsRec2 = null;
		sNull = null;
		sPrepayAmt = null;
		sConAmt = null;
		
	}	
	
	
}"
			   SEQUENCE="5"
			   UPDATED="11/06/2019 14:56:28"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPPrepayAmtAllocation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPPrepayAmtAllocation(Inputs, Outputs)
{
//Created for 19.3 Prepayments to allocate Prepayment amount for Accessories and Secondary Device
try
{

var bsInputs = TheApplication().NewPropertySet();
var bsOutputs = TheApplication().NewPropertySet();  
var psOutputs = TheApplication().NewPropertySet();
var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
mAPPNullifyAmt(sOrderId);
var sTotalPrepayAmt = Inputs.GetProperty(&quot;Total Prepay Amt&quot;);
var sDevPPAmtAllocated = Inputs.GetProperty(&quot;DevicePPAmtAllocated&quot;);
var sAPPPrepayAmt = ToNumber(sTotalPrepayAmt) - ToNumber(sDevPPAmtAllocated);
//var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
//bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Prepayments APP IO&quot;);
//bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[Order Entry - Orders.OrderId] = &apos;&quot; +sOrderId+ &quot;&apos; AND [Order Entry - Line Items.ParentItemId] IS NULL&quot;);
//bsInputs.SetProperty(&quot;SortSpec&quot;,&quot;VHA Accessory Item TBUI.VHA RRP inc GST(ASCENDING), Category&quot;);
//bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs); 
var sOLICount = &quot;&quot;;
var sAccCount = &quot;&quot;;
var sAPPCount = &quot;&quot;;
var i = 0;
var j = 0;
var k = 0;
var sConAmt = &quot;&quot;;
var sDefPPAmt = &quot;&quot;;
var sNewConAmt = &quot;&quot;;
var sAPPDef = &quot;&quot;;
var sAccRRPAmt = &quot;&quot;;
var sAPPAccDef = &quot;&quot;;
var sDefAccPPAmt = &quot;&quot;;
var sAccDef = &quot;&quot;;
var sAccTot = &quot;&quot;;
var sAccAmtExt = &quot;&quot;;
var sArrAmtId = new Array;
var sArrAmtId1 = new Array;
var sArrAccId = new Array;
var sArrAccId1 = new Array;
var sId=&quot;&quot;, sIdChild=&quot;&quot;;
var sRRP=&quot;&quot;;
var sCat = &quot;&quot;;
var temp2= &quot;&quot;, temp=0, temp1=&quot;&quot;;
var lt=0, lt1=0;
var im=0, jm=0, z=0, l=0, km=0,a=0;
var sCateg1 = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ACCESSORY_TYPE&quot;,&quot;Accessory&quot;);
var sCateg2 = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ACCESSORY_TYPE&quot;,&quot;Secondary Device&quot;);

if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot; &amp;&amp; ToNumber(sAPPPrepayAmt) &gt; 0)
{
for(a=0; a&lt;2; a++)
{

var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Prepayments APP IO&quot;);
bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[Order Entry - Orders.OrderId] = &apos;&quot; +sOrderId+ &quot;&apos; AND [VHA APP Accessory TBUI IC.Order Id] = &apos;&quot; +sOrderId+ &quot;&apos; AND [VHA Accessory Item TBUI.Order Id] = &apos;&quot; +sOrderId+ &quot;&apos; AND [VHA APP Accessory TBUI IC.Category] = &apos;&quot; +sCateg1+ &quot;&apos;&quot;);
//bsInputs.SetProperty(&quot;SortSpec&quot;,&quot;VHA Accessory Item TBUI.VHA RRP inc GST(ASCENDING), Category&quot;);
bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs); 

//if(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount())
//{

//sOLICount = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount();

//if(sOLICount &gt;= 1)
//{
//for(i=0; i&lt;sOLICount; i++)
//{
sAccCount = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount();
//throw(sAccCount);
//TheApplication().Trace(&quot;sAPPPrepayAmtStart&quot;+i+sAPPPrepayAmt);

if(sAccCount &gt;= 1)
{
for(j=0; j&lt;sAccCount; j++)
{
// VHA Prashanth 110619: Sorting
sId = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Id&quot;);
sCat = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Category&quot;);
sRRP = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;VHA RRP inc GST&quot;);


//if(sCat == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ACCESSORY_TYPE&quot;,&quot;Accessory&quot;))
{
sArrAmtId[j] = ToNumber(sRRP);
sArrAmtId1[j] = sId;
}
/*else
{
sArrAmtId[j+1] = ToNumber(sRRP);
sArrAmtId1[j+1] = sId;
}*/
}
lt = sArrAmtId1.length;
for(im=0;im&lt;lt;im++)
{

for(jm=0;jm&lt;lt; jm++)
{
if(sArrAmtId[im] &lt; sArrAmtId[jm])
{
temp = sArrAmtId[jm];
sArrAmtId[jm] = sArrAmtId[im];
sArrAmtId[im]=temp;

temp1 = sArrAmtId1[jm];
sArrAmtId1[jm] = sArrAmtId1[im];
sArrAmtId1[im]=temp1;
temp=0;
temp1=&quot;&quot;;
}
}
}//VHA Prashanth : End
//TheApplication().RaiseErrorText(sArrAmtId.join());

for(z=0; z&lt;lt; z++){//Added this loop for accessories and secondary device
for(j=0; j&lt;sAccCount; j++)
{
sId = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Id&quot;);            
if(sArrAmtId1[z] != &quot;&quot; &amp;&amp; sId == sArrAmtId1[z]){
sConAmt = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;VHA RRP inc GST&quot;);       
sAPPDef = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;VHA APP Prepayment Amount&quot;);
sDefPPAmt = sConAmt;


if(sDefPPAmt &gt;= sAPPPrepayAmt)
{
sDefPPAmt = sAPPPrepayAmt;
}

if((sDefPPAmt &lt;= sAPPPrepayAmt) &amp;&amp; (sAPPPrepayAmt &gt; 0))// &amp;&amp; ((sAPPDef == &quot;&quot;) || (sAPPDef = null)))
{

bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).SetProperty(&quot;VHA APP Prepayment Amount&quot;, sDefPPAmt);
sNewConAmt = ToNumber(sConAmt) - ToNumber(sDefPPAmt);
sNewConAmt = sNewConAmt.toFixed(2);
bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).SetProperty(&quot;VHA RRP inc GST&quot;, sNewConAmt);

sAPPCount = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChildCount();
	
sDefAccPPAmt = ToNumber(sDefPPAmt);

if(sAPPCount &gt;= 1)
{

for(km=0; km&lt;sAPPCount; km++)
{
// VHA Prashanth 110619: Sorting
sIdChild = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(km).GetProperty(&quot;Id&quot;);
sRRP = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(km).GetProperty(&quot;VHA RRP inc GST&quot;);
sArrAccId[km] = ToNumber(sRRP);
sArrAccId1[km] = sIdChild;
}
//TheApplication().RaiseErrorText(sArrAccId.join());
lt1 = sArrAccId.length;

for(im=0;im&lt;lt1;im++)
{

for(jm=0;jm&lt;lt1; jm++)
{
if(sArrAccId[im] &lt; sArrAccId[jm])
{
temp = sArrAccId[jm];
sArrAccId[jm] = sArrAccId[im];
sArrAccId[im]=temp;

temp1 = sArrAccId1[jm];
sArrAccId1[jm] = sArrAccId1[im];
sArrAccId1[im]=temp1;
temp=0;
temp1=&quot;&quot;;
}
}
}//VHA Prashanth : End


for(l=0; l&lt;lt1; l++){//Accessories loop
for(k=0; k&lt;sAPPCount; k++)
{
sIdChild = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(k).GetProperty(&quot;Id&quot;);
if(sArrAccId1[l] == sIdChild){
sAccRRPAmt = ToNumber(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(k).GetProperty(&quot;VHA RRP inc GST&quot;)); 

sAccDef = ToNumber(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(k).GetProperty(&quot;VHA Accessory Prepayment Amount&quot;));
	

if((sAccRRPAmt &lt;= sDefAccPPAmt) &amp;&amp; (sDefAccPPAmt &gt; 0))// &amp;&amp; ((sAccDef == &quot;&quot;) || (sAccDef == null)))
{

bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(k).SetProperty(&quot;VHA Accessory Prepayment Amount&quot;, sAccRRPAmt);

sDefAccPPAmt = ToNumber(sDefAccPPAmt) - ToNumber(sAccRRPAmt);
sDefAccPPAmt = sDefAccPPAmt.toFixed(2);
}

else if((sAccRRPAmt &gt;= sDefAccPPAmt) &amp;&amp; (sDefAccPPAmt &gt; 0))// &amp;&amp; ((sAccDef == &quot;&quot;) || (sAccDef == null)))

{

bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(0).GetChild(k).SetProperty(&quot;VHA Accessory Prepayment Amount&quot;, sDefAccPPAmt);

sDefAccPPAmt = ToNumber(sDefAccPPAmt) - ToNumber(sAccRRPAmt);
sDefAccPPAmt = sDefAccPPAmt.toFixed(2);
}      
}//if(sArrAccId1[l] == sIdChild)    
}//for(k=0; k&lt;sAPPCount; k++)
}//for(l=0; l&lt;lt1; l++)

}//if(sAPPCount &gt;= 1)
	
}//if((sDefPPAmt &lt;= sAPPPrepayAmt) &amp;&amp; (sAPPPrepayAmt &gt; 0))
sAPPPrepayAmt = sAPPPrepayAmt - sDefPPAmt;


}//if(sArrAmtId1[z] != &quot;&quot; &amp;&amp; sId == sArrAmtId1[z]){)
} //for(j=0; j&lt;sAccCount; j++)
} //for(z loop)
}//if(sAccCount &gt;= 1)
//}//for(i=0; i&lt;sOLICount; i++)
//}//if(sOLICount &gt;= 1)
//}//if(bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount())


bsEAIService.InvokeMethod(&quot;Upsert&quot;, bsOutputs, psOutputs);
sCateg1 = sCateg2;
//bsOutputs = null;
//psOutputs = null;
bsOutputs.Reset();
psOutputs.Reset();
}
//Outputs.AddChild(bsOutputs);

}
}//try

catch(e)
{
throw(e);
}

finally
{

bsInputs = &quot;&quot;;
bsOutputs=&quot;&quot;;
psOutputs = &quot;&quot;;
sOrderId = &quot;&quot;;
sAPPPrepayAmt = &quot;&quot;;
bsEAIService =&quot;&quot;;
sDevPPAmtAllocated = &quot;&quot;;
sAccCount = &quot;&quot;;
sAPPCount = &quot;&quot;;
sOLICount = &quot;&quot;;
i = &quot;&quot;;
j = &quot;&quot;;
k = &quot;&quot;;
sConAmt = &quot;&quot;;
sDefPPAmt = &quot;&quot;;
sNewConAmt = &quot;&quot;;
sAPPDef = &quot;&quot;;
sAccTot = &quot;&quot;;
sAccAmtExt = &quot;&quot;;
}
}"
			   SEQUENCE="6"
			   UPDATED="01/11/2020 01:43:29"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalcRemEL"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalcRemEL(Inputs, Outputs)
{
	try
	{
		var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var sSessionId = Inputs.GetProperty(&quot;SessionId&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);		
		var sBO1 = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var sEquipBC = sBO1.GetBusComp(&quot;VHA Equipment Account&quot;);
		var sFinProfBC = sBO.GetBusComp(&quot;VF Com Financial Profile TBUI&quot;);
		var sUpgOfferBC	= sBO.GetBusComp(&quot;VF Upgrade Offer&quot;);	
		var sGPPHistory	= sBO.GetBusComp(&quot;VHA GPP Upgrade History BC&quot;);
		var sBMPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;, &quot;Billing - MPP&quot;);
		var sBGPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;, &quot;Billing - GPP&quot;);
		var	searchst1 = &quot;&quot;;
		var sRemEL = &quot;&quot;;
		var searchst2 = &quot;&quot;;		
		var sAssetId = &quot;&quot;;
		var searchst3 = &quot;&quot;;	
		var isFirstRecord = &quot;&quot;;
		var isFirRec = &quot;&quot;;
		var sProdType = &quot;&quot;;
		var searchst4 = &quot;&quot;;
		var sConBal = 0;
		var searchst5 = &quot;&quot;;
		var sRecId = &quot;&quot;;
	
		with(sFinProfBC)
		{
			ActivateField(&quot;Account Id&quot;);
			ActivateField(&quot;VHA Remaining Equipment Limit&quot;);	
			ClearToQuery(); 
			SetViewMode(AllView);			
			searchst1 = &quot;[Account Id] = &apos;&quot; + sAccountId + &quot;&apos;&quot;;
			SetSearchExpr(searchst1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sRemEL = ToNumber(GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;));
				sRemEL = sRemEL.toFixed(2);
				
			}
		}
		if(sSessionId != &quot;&quot; &amp;&amp; sSessionId != null)
		{
			with(sUpgOfferBC)
			{
				ActivateField(&quot;Wizard Session Id&quot;);
				ActivateField(&quot;Root Asset Id&quot;);	
				ClearToQuery(); 
				SetViewMode(AllView);			
				searchst2 = &quot;[Wizard Session Id] = &apos;&quot; + sSessionId + &quot;&apos;&quot;;
				SetSearchExpr(searchst2);
				ExecuteQuery(ForwardOnly);
				var sAssetRec = FirstRecord();
				while(sAssetRec)
				{
					sAssetId = GetFieldValue(&quot;Root Asset Id&quot;);
					with(sGPPHistory)
					{
						ActivateField(&quot;Action code&quot;);
						ActivateField(&quot;Record Id&quot;);
						ActivateField(&quot;Product Type&quot;);		
						ClearToQuery(); 
						SetViewMode(AllView);			
						searchst3 = &quot;[Action code] = &apos;Y&apos; AND [ParRowId] = &apos;&quot;+sAssetId+&quot;&apos; AND [Session Id] = &apos;&quot;+sSessionId+&quot;&apos;&quot;;
						SetSearchExpr(searchst3);
						ExecuteQuery(ForwardOnly);
						isFirstRecord = FirstRecord();
						while(isFirstRecord)
						{
							sProdType = GetFieldValue(&quot;Product Type&quot;);
							sRecId = GetFieldValue(&quot;Record Id&quot;);
							if(sProdType ==  sBMPP)
							{
								with(sEquipBC)
								{
									ActivateField(&quot;Consumed Balance&quot;);
									ActivateField(&quot;Type&quot;);									
									ClearToQuery(); 
									SetViewMode(AllView);
									searchst4 = &quot;[Type] = &apos;Equipment Limit&apos; AND [Asset Id] = &apos;&quot;+sAssetId+&quot;&apos;&quot;;
									SetSearchExpr(searchst4);
									ExecuteQuery(ForwardOnly);	
									isFirRec = FirstRecord();	
									while(isFirRec)
									{									
										sConBal = sConBal + ToNumber(GetFieldValue(&quot;Consumed Balance&quot;));
										isFirRec = NextRecord();
									}		
								}
							}
							else if(sProdType ==  sBGPP)
							{
								with(sEquipBC)
								{
									ActivateField(&quot;Consumed Balance&quot;);
									ActivateField(&quot;Type&quot;);									
									ClearToQuery(); 
									SetViewMode(AllView);
									searchst5 = &quot;[Type] =  &apos;Device Equipment Limit&apos; AND [Asset Integeration Id] = &apos;&quot;+sRecId+&quot;&apos; AND [Asset Id] = &apos;&quot;+sAssetId+&quot;&apos;&quot;;
									SetSearchExpr(searchst5);
									ExecuteQuery(ForwardOnly);		
									isFirRec = FirstRecord();	
									while(isFirRec)
									{									
										sConBal = sConBal + ToNumber(GetFieldValue(&quot;Consumed Balance&quot;));
										isFirRec = NextRecord();
									}		
								}
							}
							isFirstRecord = NextRecord();
						}
					}
					sAssetRec = NextRecord();
				}
			}					
		}
		sRemEL = ToNumber(sRemEL) + ToNumber(sConBal);
		sRemEL = sRemEL.toFixed(2);
		Outputs.SetProperty(&quot;RemEL&quot;, sRemEL);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sAccountId = null;
		sBO = null;
		
		sFinProfBC = null;
		searchst1 = null;
		sRemEL = null;
	}
}"
