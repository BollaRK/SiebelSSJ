			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fResetBanChngPrimFlg"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fResetBanChngPrimFlg(Inputs,Outputs)
{
	var vFlgUpdDtInp=&quot;&quot;,vFlagUpdDate = &quot;&quot;, vDOM = &quot;&quot;,vOutResetFlag = &quot;&quot;,nextBillCycle=&quot;&quot;,nextBillCycleDt=null,prevBillCycle=&quot;&quot;,prevBillCycleDt=null;
	var curdate=null, DD=0,MM=0,YYYY=0, tempCurDate = null, flag = &quot;&quot;;
	try
	{
		vFlgUpdDtInp = Inputs.GetProperty(&quot;FlagUpdateDate&quot;);
		vFlagUpdDate = new Date(vFlgUpdDtInp);
		vDOM = Inputs.GetProperty(&quot;DateOfMonth&quot;);
		curdate = new Date();
		DD = ToNumber(curdate.getDate());//05
		MM = ToNumber(curdate.getMonth())+1;//12
		YYYY = ToNumber(curdate.getFullYear());//2024
		tempCurDate = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY);
		curdate = new Date(tempCurDate);

		if(DD&lt;=ToNumber(vDOM))
		{
			nextBillCycle = ToNumber(MM) + &quot;/&quot; + ToNumber(vDOM) + &quot;/&quot; + ToNumber(YYYY);
			nextBillCycleDt = new Date(nextBillCycle);
			if(MM == 1)
			{
				MM = &quot;12&quot;;
				YYYY = ToNumber(YYYY) -1;
			}
			else
				MM = ToNumber(MM)-1;
			prevBillCycle = ToNumber(MM) + &quot;/&quot; + ToNumber(vDOM) + &quot;/&quot; + ToNumber(YYYY);
			prevBillCycleDt = new Date(prevBillCycle);
		}
		else
		{
			prevBillCycle = ToNumber(MM) + &quot;/&quot; + ToNumber(vDOM) + &quot;/&quot; + ToNumber(YYYY);
			prevBillCycleDt = new Date(prevBillCycle);
			if(MM == 12)
			{
				MM = &quot;1&quot;;
				YYYY = ToNumber(YYYY) + 1;
			}
			else
				MM = ToNumber(MM)+1;
			nextBillCycle = ToNumber(MM) + &quot;/&quot; + ToNumber(vDOM) + &quot;/&quot; + ToNumber(YYYY);
			nextBillCycleDt = new Date(nextBillCycle);
		}
		if (nextBillCycleDt - curdate == 0)
		{
			flag = true;
		}
		else
		{
			flag = false;
		}
		if (((vFlagUpdDate &lt; prevBillCycleDt) &amp;&amp; (vFlagUpdDate &lt; nextBillCycleDt)) || flag) 
		{
		    vOutResetFlag = &quot;Y&quot;;
		}
		else
		{
			vOutResetFlag = &quot;N&quot;;
		}
		Outputs.SetProperty(&quot;ResetFlag&quot;, vOutResetFlag);
		//for testing
		Outputs.SetProperty(&quot;Flag Upd Date&quot;, vFlagUpdDate);
		Outputs.SetProperty(&quot;prevBillCycleDt&quot;, prevBillCycleDt);
		Outputs.SetProperty(&quot;vFlgUpdDtInp&quot;, vFlgUpdDtInp);
		Outputs.SetProperty(&quot;nextBillCycleDt&quot;, nextBillCycleDt);
		Outputs.SetProperty(&quot;curdate&quot;, curdate);
		//Outputs.SetProperty(&quot;Temp&quot;,flag);
		//Outputs.SetProperty(&quot;Temp&quot;, new Date(
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		vFlgUpdDtInp = null;
		vFlagUpdDate = null;
		vDOM = null;
		vOutResetFlag = null;
		nextBillCycle=null;
		nextBillCycleDt=null;
		prevBillCycle=null;
		prevBillCycleDt=null;
		curdate=null;
		DD=null;
		MM=null;
		YYYY=null;
		tempCurDate = null;
	}
}"
