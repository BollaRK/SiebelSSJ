			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SSJCancelQuote"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/********************************
18042026:Suma:Added code to update the quote status as cancelled in case child orders are cancelled.
******************************************/
function SSJCancelQuote(Inputs, Outputs) 
{
    var boOrder = null,bcQuote = null,sQuoteId = null,sChildOrderId = null,CancelQuote = &quot;N&quot;;
    try 
	{
        bcQuote = TheApplication().GetBusObject(&quot;VHA Order - 3 Step Upgrade&quot;).GetBusComp(&quot;VHA Order Header - 3 Step Header&quot;);
        sQuoteId = Inputs.GetProperty(&quot;Quote Id&quot;);
        sChildOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		if(sQuoteId != null &amp;&amp; sQuoteId != &quot;&quot; &amp;&amp; sChildOrderId != null &amp;&amp; sChildOrderId != &quot;&quot;)
		{
			with (bcQuote) 
			{
				SetViewMode(AllView);
				ActivateField(&quot;Order Status&quot;);
				ClearToQuery();
				//Search for child order except cuurent one with status not as cancelled
				SetSearchExpr(&quot;[Parent Order Id] = &apos;&quot; + sQuoteId + &quot;&apos; AND [Order Status] &lt;&gt; &apos;Cancelled&apos; AND [Id] &lt;&gt; &apos;&quot;+ sChildOrderId +&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				if (!FirstRecord()) 
				{
					CancelQuote = &quot;Y&quot;;
				}
				if (CancelQuote == &quot;Y&quot;) 
				{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Order Status&quot;);
					ActivateField(&quot;Active&quot;);
					SetSearchSpec(&quot;Id&quot;, sQuoteId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord()) 
					{
						SetFieldValue(&quot;Order Status&quot;, &quot;Cancelled&quot;);
						SetFieldValue(&quot;Active&quot;,&quot;N&quot;);
						WriteRecord();
					}
				}
			}
		}
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        boOrder = null;
        sQuoteId = null;
		sChildOrderId = null;
		CancelQuote = null;
		bcQuote = null;
    }
}"
