			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeletePrepayments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeletePrepayments(Inputs,Outputs)
{
	try
	{		
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sPrepaymentBC = sOrderBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sPPContractBC = sOrderBO.GetBusComp(&quot;VHA Prepayment Contract Summary&quot;);
		var sPPCreditCardBC = sOrderBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
		var sPrepaymentId = &quot;&quot;;
		var sNewLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;New&quot;);
		var sPaymentPendingLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;Payment Pending&quot;);
		var sContractRec, sCCRec;
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{
		with(sPrepaymentBC)
		{
			ActivateField(&quot;Id&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND ([Prepayment Status] = &apos;&quot;+sNewLOV+&quot;&apos; OR [Prepayment Status] = &apos;&quot;+sPaymentPendingLOV+&quot;&apos;)&quot;);
			ExecuteQuery();
			if(FirstRecord())
			{
				sPrepaymentId = GetFieldValue(&quot;Id&quot;);
				DeleteRecord();
			}
		}
		if(sPrepaymentId != &quot;&quot; &amp;&amp; sPrepaymentId != null)
		{
			with(sPPContractBC)
			{
				ClearToQuery();
				SetSearchExpr(&quot;[Prepayment Id] = &apos;&quot;+sPrepaymentId+&quot;&apos;&quot;);
				ExecuteQuery();
				sContractRec = FirstRecord();
				while(sContractRec)
				{
					DeleteRecord();
					sContractRec = FirstRecord();
				}
			}
			with(sPPCreditCardBC)
			{
				ClearToQuery();
				SetSearchExpr(&quot;[Prepayment Record Id] = &apos;&quot;+sPrepaymentId+&quot;&apos;&quot;);
				ExecuteQuery();
				sCCRec = FirstRecord();
				while(sCCRec)
				{
					DeleteRecord();
					sCCRec = FirstRecord();
				}
			}
		}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sPPCreditCardBC = null;
		sPPContractBC = null;
		sPrepaymentBC = null;
	}
}"
