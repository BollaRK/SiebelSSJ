			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetCustomerBillSegmentDefault"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetCustomerBillSegmentDefault(Inputs, Outputs)
{
	/*
	 * Component Name        :	TBUI Utilities
	 * Method Name          	  :		TBUI Scripts
	 * Component Information :	Set the Customer Bill Segment depending on the Organization.
	 *
	 * Modification History  :
	 * Date				Author		Config #	Description
	 * ============ ===========	===========	================================
	 * 06/06/2014	Neel			Scripts Cloned from BC Account New Record for setting Bill Segment and Cycle
	*/
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START: BS: VF TBUI Utilities.SetCustomerBillSegment&quot;);
		}
		
			/*******************************
			* Declare Objects / Variables
			*******************************/
			var strBillSegment = &quot;&quot;;
			var bcPickBillSegment;
			var strError;
			var strVF_AU 		= &quot;Vodafone AU&quot;;
			var strBillCycle;
			var strBillSegment;
			var strOrganization = Inputs.GetProperty(&quot;Organization&quot;);		
            var IsOrgVFOrKogan = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ORG_NAME&quot;, strOrganization);			   
			if(strOrganization == IsOrgVFOrKogan)
			{		
				mSetAvailableBillCycleAndSegment(Inputs, Outputs);
			}	
			else
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Unable to Recognize Logged in User Organization&quot;);
			}
		
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
			Outputs.SetProperty(&quot;ErrMsg&quot;, strError);
		}
		else
		{
			strError = arguments.callee + ToString(e);
			Outputs.SetProperty(&quot;ErrMsg&quot;, strError);
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR: BS: VF TBUI Utilities.SetCustomerBillSegmentDefault.strError= &quot; + strError);
		}
     	throw (strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END: BS: VF TBUI Utilities.SetCustomerBillSegmentDefault&quot;);
		}
		
		bcPickBillSegment = null;
	}
}"
			   SEQUENCE="25"
