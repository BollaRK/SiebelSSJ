			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateContactDetail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateContactDetail(Inputs, Outputs)
{
/*
 * Component Name        : 	mValidateContactDetail
 * Method Name           : 	
 * Component Information : 	This function validates all fields entered
 *							correct 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 02/06/2014	Neel					Cloned from Merlin VF Wizard Utilities
 */	

	var sErrMsg =&quot;&quot;;
	var sContactId;
	var ContactIdFound;
	var iTotalPoints =0;
	var sAddrProof=&quot;N&quot;;
	var sAddrFlg;
	var sRaiseError=&quot;N&quot;;

//	var sVHACCPolicy = &quot;&lt;a href=&apos;http://www.vodafonechannel.com.au/site/dcp/australia/enau/processes/policies/credit/l_credit.jsp/&apos; target=&apos;_blank&apos; style=&apos;text-decoration: none&apos;&gt;VHA Credit Check Policy Link &lt;/a&gt;&quot;; 


	try
	{
	
		var sTitle = Inputs.GetProperty(&quot;Title&quot;);
		var sFstName = Inputs.GetProperty(&quot;First Name&quot;);
		var sLstName = Inputs.GetProperty(&quot;Last Name&quot;);
		var sHmePhone = Inputs.GetProperty(&quot;Home Phone&quot;);
		var sWrkPhone = Inputs.GetProperty(&quot;Work Phone&quot;);
		var sCustType = Inputs.GetProperty(&quot;Customer Type&quot;);
		var sDOB = Inputs.GetProperty(&quot;DOB&quot;);
		var sGender = Inputs.GetProperty(&quot;Gender&quot;);
		var sEmailAddress = Inputs.GetProperty(&quot;Email Address&quot;);
		var sMartialStatus = Inputs.GetProperty(&quot;Marital Status&quot;);
		var sDOM = Inputs.GetProperty(&quot;DOM&quot;);
		var IsDigNameChk = Inputs.GetProperty(&quot;IsDigitalNameChk&quot;);
		var sBillSegment = Inputs.GetProperty(&quot;BillSegment&quot;);
		var sUniSIMFlg = Inputs.GetProperty(&quot;UniSIMFlag&quot;); // Added for UniSIM
		gCustType = sCustType;
		

	/*	if(sCustType == &quot;Person&quot;)
		{
			if(sWrkPhone != &quot;&quot; &amp;&amp; sBillSegment != &quot;&quot; &amp;&amp; sDOM != &quot;&quot; &amp;&amp; sTitle != &quot;&quot; &amp;&amp; sFstName != &quot;&quot; &amp;&amp; sLstName != &quot;&quot; &amp;&amp; sHmePhone != &quot;&quot; &amp;&amp; sDOB != &quot;&quot; &amp;&amp; sGender != &quot;&quot; &amp;&amp; sEmailAddress != &quot;&quot; &amp;&amp; sMartialStatus != &quot;&quot;)
			{
				// Valid Continue processing.
			}
			else
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Please enter data for all the required fields to proceed....&quot;);
				sRaiseError = &quot;Y&quot;;
			}
		}
		else
		{
			if(sWrkPhone != &quot;&quot; &amp;&amp; sBillSegment != &quot;&quot; &amp;&amp; sDOM != &quot;&quot; &amp;&amp; sTitle != &quot;&quot; &amp;&amp; sFstName != &quot;&quot; &amp;&amp; sLstName != &quot;&quot; &amp;&amp; sHmePhone != &quot;&quot; &amp;&amp; sDOB != &quot;&quot; &amp;&amp; sGender != &quot;&quot; &amp;&amp; sEmailAddress != &quot;&quot;)
			{
				// Valid Continue processing.
			}
			else
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Please enter data for all the required fields to proceed....&quot;);
				sRaiseError = &quot;Y&quot;;
			}
		}*/ // Moved to DVM
		
		//sValid = GetFieldValue(&quot;VF Wizard Calc3&quot;); 
		//sContactId = GetFieldValue(&quot;Id&quot;);

		//var sDOB = GetFieldValue(&quot;Birth Date&quot;);
		
		if(sRaiseError == &quot;N&quot;)
		{	
			var bValidCustomerAge = mCheckCustomerAge(sDOB);
			
			if (bValidCustomerAge == &quot;Yes&quot;)
			{
				//The customer age is valid for a credit check to occur.
				//Continue processing.
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
			}
			else if(sUniSIMFlg == &quot;Y&quot;)
			{
				var sDOBirth = new Date(sDOB);
				var sSysdate = new Date();
				var YYYY = sSysdate.getFullYear();
				var MM = sSysdate.getMonth() + 1;
				var DD = sSysdate.getDate();
				sSysdate = ToNumber(MM) + &quot;/&quot; + ToNumber(DD) + &quot;/&quot; + ToNumber(YYYY);
				sSysdate = new Date(sSysdate);
				if(sDOBirth &gt;= sSysdate)
				{
					throw &quot;Date of Birth should be less than today&apos;s date&quot;;
				}
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
			}
			else
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Customer is under 18. Please check date of birth or offer a prepaid service...&quot;);
				sRaiseError = &quot;Y&quot;;
			}		
			
			if(sRaiseError == &quot;N&quot;)
			{
			//	mValidatePhoneNumber(sWrkPhone,&quot;Work Phone&quot;); // VF:ROSELINE 10/09/2014 - Removed the Work Phone Validation - QC Defect# 2501
				//mValidatePhoneNumber(sHmePhone,&quot;Home Phone&quot;);
				mValidatePhoneNumber(sHmePhone,&quot;Home Phone&quot;,sUniSIMFlg);
				mValidateEmail(sEmailAddress); // Sri:6/8/2014: Added for Email Validation
				// Indumathi: Added for DigitalName Email Validation::CM#1099
				if(IsDigNameChk == &quot;Y&quot;)
				{
					mDigitalNameCheck(sEmailAddress); 
				}
			}
		}		
		//Primary to be made default always - check to be avoided - Neel
		//var sPrimary = GetFieldValue(&quot;SSA Primary Field&quot;);
		
		/*if (sPrimary == &quot;N&quot; || sPrimary == &quot;&quot;) 
		{
			SetFieldValue(&quot;SSA Primary Field&quot;, &quot;Y&quot;);
			WriteRecord();
			// Update Parent BC
			bcContact.ParentBusComp().WriteRecord();
		}

		if (GetFieldValue(&quot;SSA Primary Field&quot;) == &quot;N&quot; || GetFieldValue(&quot;SSA Primary Field&quot;) == &quot;&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Primary Contact is Required to Proceed....&quot;);
			sRaiseError = &quot;Y&quot;;
		}*/

	
		//check to see if everything has passed
		/*if(sRaiseError == &quot;N&quot;)
		{
			
		}*/

	}
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;, e);
	}
	finally
	{

	}
}"
