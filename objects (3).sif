			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInsertInLineItemBC"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInsertInLineItemBC(childInputs, Inputs, TNRId, NoOfServices, FulfilOrderId)
{//not used-TARIQ
	try
	{
	
		/*for (var i=0;i &lt; NoOfServices; i++)
		{
			childInputs.GetChild(i).SetProperty(&quot;VF TNR Id&quot;, TNRId);
			childInputs.GetChild(i).SetProperty(&quot;Fulfilment Id&quot;, FulfilOrderId);
		}*/
		/*var sService = TheApplication().GetService(&quot;EAI XML Write to File&quot;);
		var sInp = TheApplication().NewPropertySet();
		var sOut = TheApplication().NewPropertySet();
		sInp.SetProperty(&quot;FileName&quot;,&quot;D:\\SIEBEL_TARIQAK\\DEV01\\log\\PS1.xml&quot;);
		sInp.AddChild(Inputs);
		sService.InvokeMethod(&quot;WritePropSet&quot;, sInp, sOut);*/
		
		Inputs.GetChild(0).RemoveChild(0);
		Inputs.GetChild(0).AddChild(childInputs);
		
		
		var bsService = TheApplication().GetService(&quot;EAI Data Transformation Engine&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		
		//Map the data
		Inputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VF Order Item Task Insert&quot;);
		Inputs.SetProperty(&quot;MapName&quot;,&quot;VF Order Item Task Insert&quot;);
		bsService.InvokeMethod(&quot;Execute&quot;, Inputs, psOutputs);
		bsService = null;
		
		//Upsert the data
		bsService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		bsService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psInputs);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
		bsService = null;
	}
}"
