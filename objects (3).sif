			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGroupDismantle"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGroupDismantle (Inputs,Outputs)
{
 try
 {
		Inputs.SetProperty(&quot;DismantleGroup&quot;,&quot;Y&quot;);
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sGroupId = Inputs.GetProperty(&quot;GroupId&quot;);
		var boOrderConnect = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrderConnect = boOrderConnect.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var bcOrderLineItems = boOrderConnect.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		
		var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Sharing Group Id] = &apos;&quot; + sGroupId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Sharing Action] = &apos;Add Member&apos;&quot;;
		
		if(sOrderId != &quot;&quot; &amp;&amp; sGroupId != &quot;&quot;)
		{
			bcOrderConnect.SetViewMode(AllView);
			bcOrderConnect.ClearToQuery();
			bcOrderConnect.SetSearchSpec(&quot;Id&quot;, sOrderId);
			bcOrderLineItems.SetSearchExpr(sSearchspec);
			bcOrderConnect.ExecuteQuery(ForwardOnly);
			if(bcOrderConnect.FirstRecord() &amp;&amp; bcOrderLineItems.FirstRecord())
			{
				Inputs.SetProperty(&quot;DismantleGroup&quot;,&quot;N&quot;);
			}
		}
  }
  catch(e)
	{
		throw(e);
	}
	finally
	{
		bcOrderLineItems = null;
		bcOrderConnect = null;
		boOrderConnect = null;
	}
}"
			   SEQUENCE="13"
			   UPDATED="06/28/2024 18:49:20"
