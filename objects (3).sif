			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCheckExistingAsset"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCheckExistingAsset(sInputs,sOutputs)
{
try
{
	
	var AssetBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
	var AssetBC = AssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
	var ActiveBO = TheApplication().ActiveBusObject();
	var oGroupTBC = ActiveBO.GetBusComp(&quot;VHA Sharing Group TBC&quot;);
	var oGroupBC = AssetBO.GetBusComp(&quot;VHA Sharing Group&quot;);
	
	var sGroupId = oGroupTBC.GetFieldValue(&quot;Sharing Group Id&quot;);
	var sAssetSharingComp = &quot;&quot;,sSharingCount = 0,sSharingGroupId = &quot;&quot;,sSharingName=&quot;&quot;,sSelectAssetCount=&quot;&quot;;
	var sAddMember = sInputs.GetProperty(&quot;sAddMember&quot;);
	var sAddMemberCount = sInputs.GetProperty(&quot;sAddMemberCount&quot;);
	var sRemoveMemberCount = sInputs.GetProperty(&quot;sRemoveMemberCount&quot;);
	var sAddRemoveExistingMember = sInputs.GetProperty(&quot;sAddRemoveExistingMember&quot;);
	var sAddRemoveMember = sInputs.GetProperty(&quot;sAddRemoveMember&quot;);
	var sAddExistingMember = sInputs.GetProperty(&quot;sAddExistingMember&quot;);
	var sBillingAcntId = sInputs.GetProperty(&quot;sBillingAcntId&quot;);
	var sSharingLeadId = &quot;&quot;;
	var sVoiceServiceExists = &quot;N&quot;;	// VHA Suresh: Added for R17.3 Sharing: PIPE
	with(AssetBC)
	{
				
				SetViewMode(AllView);
				ActivateField(&quot;VF Share Flag&quot;);
				ActivateField(&quot;MSISDN&quot;);
				ActivateField(&quot;Integration Id&quot;);
				ActivateField(&quot;Sharing Group Count&quot;);
				ActivateField(&quot;Sharing Group Id&quot;);
				ActivateField(&quot;Sharing Lead Id&quot;);
				ActivateField(&quot;Sharing Group Status&quot;);
				ActivateField(&quot;Sharing Group Name&quot;);
				ActivateField(&quot;VF Siebel Product Type&quot;);
				ClearToQuery();
				if(sAddMember == &quot;Y&quot;)
				{
					SetSearchSpec(&quot;Billing Account Id&quot;, sBillingAcntId);
					SetSearchSpec(&quot;Sharing Select&quot;, &quot;Y&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sSelectAssetCount = 1;
						sAssetSharingComp = GetFieldValue(&quot;VF Share Flag&quot;);
						sSharingName = GetFieldValue(&quot;Sharing Group Name&quot;);
						sSharingGroupId = GetFieldValue(&quot;Sharing Group Id&quot;);
						if(sSharingGroupId != &quot;&quot;)
						{
						  sSharingCount = GetFieldValue(&quot;Sharing Group Count&quot;);
						  sSharingCount = ToNumber(sSharingCount) + ToNumber(sAddMemberCount);
						  sSharingLeadId = GetFieldValue(&quot;Sharing Lead Id&quot;);
						}
						else
						{
						 sSharingCount = 1 + ToNumber(sAddMemberCount);
						}
						// VHA Suresh: Added for R17.3 Sharing: PIPE
						if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VF Siebel Product Type&quot;)) == &quot;&quot;)
							sVoiceServiceExists = &quot;Y&quot;;
					}
					else
					{
						sSelectAssetCount = 0;
						sSharingCount =  ToNumber(sAddMemberCount);
					}
				}
				else if(sGroupId != &quot;&quot;)
				{
					
					SetSearchSpec(&quot;Sharing Group Id&quot;, sGroupId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sAssetSharingComp = GetFieldValue(&quot;VF Share Flag&quot;);
						sSharingName = GetFieldValue(&quot;Sharing Group Name&quot;);
						sSharingGroupId = GetFieldValue(&quot;Sharing Group Id&quot;);
						sSharingCount = GetFieldValue(&quot;Sharing Group Count&quot;);
						sSharingLeadId = GetFieldValue(&quot;Sharing Lead Id&quot;);
						if(sAddRemoveMember == &quot;Y&quot; || sAddRemoveExistingMember == &quot;Y&quot;)
						{
							sSharingCount = (ToNumber(sSharingCount) + ToNumber(sAddMemberCount)) - ToNumber(sRemoveMemberCount);
						}
						else if(sAddExistingMember == &quot;Y&quot;)
						{
							sSharingCount = ToNumber(sSharingCount) + ToNumber(sAddMemberCount);
						}
					}
				}
	}
	sOutputs.SetProperty(&quot;sSharingCount&quot;,sSharingCount);
	sOutputs.SetProperty(&quot;sSharingGroupId&quot;,sSharingGroupId);
	sOutputs.SetProperty(&quot;sSharingName&quot;,sSharingName);
	sOutputs.SetProperty(&quot;sAssetSharingComp&quot;,sAssetSharingComp);
	sOutputs.SetProperty(&quot;sSelectAssetCount&quot;,sSelectAssetCount);
	sOutputs.SetProperty(&quot;sSharingLeadId&quot;,sSharingLeadId);
	sOutputs.SetProperty(&quot;VoiceServiceExist&quot;,sVoiceServiceExists);
	
}
catch(e)
{
throw(e)
}
finally
{
	AssetBC = null;
	oGroupTBC = null;
	oGroupBC = null;
	AssetBO = null;
	ActiveBO = null;
}
}"
