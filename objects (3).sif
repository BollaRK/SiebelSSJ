			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetBillAccStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetBillAccStatus(Inputs, Outputs)
{

	try
	{
	
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);				
		var sBC = sBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var searchst1 = &quot;&quot;;
		var sBillStatus = &quot;&quot;;
		var sOverdue = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_BILL_ACCT_STATUS&quot;,&quot;Overdue&quot;);
		var sInvoke = &quot;Y&quot;;
		
		with(sBC)
		{
			
			ActivateField(&quot;Id&quot;);
			ActivateField(&quot;Billing Account Status&quot;);	
			ClearToQuery(); 
			SetViewMode(AllView);			
			searchst1 = &quot;[Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			SetSearchExpr(searchst1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sBillStatus = GetFieldValue(&quot;Billing Account Status&quot;);
				if(sBillStatus == sOverdue)
				{
					sInvoke = &quot;N&quot;;
				}
			}
		}
		
	Outputs.SetProperty(&quot;Invoke&quot;, sInvoke);			
	Outputs.SetProperty(&quot;BillStatus&quot;, sBillStatus);	
	}
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
	
	}
}"
