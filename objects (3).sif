			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mLeadValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mLeadValidation(Inputs, Outputs)
{
try{
	var ERR_POI = &quot;9022&quot;;
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
	var bcAction = boOrder.GetBusComp(&quot;VHA SQ Lead Capture&quot;); 
	var SQRowId = Inputs.GetProperty(&quot;SQRowId&quot;);
	var POIStatus = Inputs.GetProperty(&quot;POIStatus&quot;);
	if(POIStatus != &quot;Available&quot;)
	{ 
		with(bcAction) 
		{ 
			var searchspec = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos; AND [Type (Vanilla)] = &apos;NBN Lead Address&apos;&quot;; 
			SetViewMode(AllView); 
			ClearToQuery(); 
			SetSearchExpr(searchspec); 
			ExecuteQuery(ForwardOnly); 
			var iRec = FirstRecord(); 
			if(!FirstRecord()) 
			{ 
					//TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_POI));
					TheApplication().RaiseErrorText(&quot;VFErrorCode#9022&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_POI));
			} 
		} 
	} 
	}
	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcAction = null;
		boOrder = null;
	}
	
	return (ContinueOperation);	
}"
