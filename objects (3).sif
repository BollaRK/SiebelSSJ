			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPrepaymentsOLS"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPrepaymentsOLS(Inputs,Outputs)
{

	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sSerOrderId = Inputs.GetProperty(&quot;ServiceOrderId&quot;);
		var sPrepayAmt = Inputs.GetProperty(&quot;PrepaymentAmount&quot;);
		var sPaymentType = Inputs.GetProperty(&quot;PaymentType&quot;);
		var searchst1, searchst2, searchst3;
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sOrderItemBC = sBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);		
		var sOLIXA = sBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
		var sBGPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;, &quot;Billing - GPP&quot;);
		var sDevice = &quot;Device&quot;;
		var sAdd = &quot;Add&quot;;
		var sMSISDN = &quot;&quot;;
		var sGPPId = &quot;&quot;;
		var sAssetIntegId = &quot;&quot;;
		var sContractAmt = &quot;&quot;;
		var sDevCode = &quot;&quot;;
		var sDevName = &quot;&quot;;
		
		
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot; &amp;&amp; sSerOrderId != null &amp;&amp; sSerOrderId != &quot;&quot;)
		{
			with(sOrderItemBC)
			{
				ActivateField(&quot;Id&quot;);				
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;VHA MSISDN Calc&quot;);						
				ClearToQuery(); 
				SetViewMode(AllView);			
				searchst1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Id] = &apos;&quot; + sSerOrderId + &quot;&apos; &quot;;
				SetSearchExpr(searchst1);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sMSISDN = GetFieldValue(&quot;VHA MSISDN Calc&quot;);
					
				}
			}
			with(sOrderItemBC)
			{
				ActivateField(&quot;Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;VHA Siebel Product Type&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Asset Integration Id&quot;);						
				ClearToQuery();
				SetViewMode(AllView);			
				searchst2 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] = &apos;&quot; + sSerOrderId + &quot;&apos; AND [Product Type] = &apos;&quot; + sBGPP + &quot;&apos; AND [VHA Siebel Product Type] = &apos;&quot; + sDevice + &quot;&apos; AND [Action Code] = &apos;&quot; + sAdd + &quot;&apos; &quot;;
				SetSearchExpr(searchst2);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sGPPId = GetFieldValue(&quot;Id&quot;);
					sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
					if(sAssetIntegId == null || sAssetIntegId == &quot;&quot;)
					{
						sAssetIntegId = sGPPId;
					}
					
				}
				if(sGPPId != &quot;&quot; &amp;&amp; sGPPId != null)
				{							
					 sContractAmt = mGetOrderItemAttr(sBO ,&quot;[Name]=&apos;Contract Amount&apos; AND [Object Id]  = &apos;&quot; + sGPPId + &quot;&apos;&quot;);
					 sDevCode = mGetOrderItemAttr(sBO ,&quot;[Name]=&apos;Item Code&apos; AND [Object Id] = &apos;&quot; + sGPPId + &quot;&apos;&quot;);
					 sDevName = mGetOrderItemAttr(sBO ,&quot;[Name]=&apos;Item Name&apos; AND [Object Id] = &apos;&quot; + sGPPId + &quot;&apos;&quot;);
				}
				
				if(sGPPId != &quot;&quot; &amp;&amp; sGPPId != null)
				{
					mSetOrderItemAttr(sBO,&quot;[Name]=&apos;Prepayment Amount&apos; AND [Object Id]  = &apos;&quot; + sGPPId + &quot;&apos;&quot;,sPrepayAmt);
					mSetOrderItemAttr(sBO,&quot;[Name]=&apos;Additional Info&apos; AND [Object Id]  = &apos;&quot; + sGPPId + &quot;&apos;&quot;,sPaymentType);
				}				

			}
			
		}
		
		Outputs.SetProperty(&quot;DeviceCode&quot;, sDevCode);
		Outputs.SetProperty(&quot;DeviceName&quot;, sDevName);
		Outputs.SetProperty(&quot;ContractAmount&quot;, sContractAmt);
		Outputs.SetProperty(&quot;AssetIntegId&quot;, sAssetIntegId);
		Outputs.SetProperty(&quot;MSISDN&quot;, sMSISDN);
		

	}

	catch(e)
	{
		throw(e);
	}

	finally
	{
		sOrderId = null;
		sSerOrderId = null;
		sPrepayAmt = null;
		sPaymentType = null;		
		sBO = null;
		sOrderItemBC = null;
		sOLIXA = null;
		sBGPP = null;
		sDevice = null;
		sAdd = null;
		sMSISDN = null;
		sGPPId = null;
		sAssetIntegId = null;
		sContractAmt = null;
		sDevCode = null;
		sDevName = null;
	}
}"
			   SEQUENCE="19"
			   UPDATED="01/04/2020 00:15:09"
			   UPDATED_BY="SADMIN"
			   CREATED="11/06/2019 14:56:38"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPrepaymentsOrderUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPrepaymentsOrderUpdate(Inputs, Outputs)
{
	
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;OrderSubType&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);		
		var bcLineItems = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);	
		var sFulfilment = &quot;N&quot;;
		var sInstockAvailable = &quot;N&quot;;
		var sInstock = &quot;In Stock&quot;;
		var sDelete = &quot;Delete&quot;;
		var sOutstock = &quot;Out of Stock - Connect Later&quot;
		var searchexpr1 = &quot;&quot;, searchexpr2 = &quot;&quot;, searchexpr = &quot;&quot;, sServiceOrderId = &quot;&quot;, sPaymentOrderId = &quot;&quot;, sFulfilmentOrderId = &quot;&quot;, sParentOrderSubType = &quot;&quot;;
		
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{
			if(sOrderSubType == &quot;Fulfilment&quot;)
			{
				sFulfilment = &quot;Y&quot;;
				sFulfilmentOrderId = sOrderId;
				sOrderId = mGetParentOrderId(sOrderId);
			}
			if(sFulfilment == &quot;Y&quot;)
			{				
				sParentOrderSubType = mGetParentOrderSubType(sOrderId);
			}			
			if((sOrderSubType == &quot;Fulfilment&quot; &amp;&amp; sParentOrderSubType == &quot;Connect&quot;) || sOrderSubType == &quot;Connect&quot;)
			{
				with(bcLineItems)
				{
				   ActivateField(&quot;Order Header Id&quot;);
				   ActivateField(&quot;Parent Order Item Id&quot;);
				   ActivateField(&quot;VF Stock Indicator TBUI&quot;);
				   ActivateField(&quot;Action Code&quot;);			   
				   ActivateField(&quot;Id&quot;);               
				   SetViewMode(AllView);
				   ClearToQuery();
				   searchexpr1 = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id]  IS NULL AND [VF Stock Indicator TBUI] = &apos;&quot; + sInstock + &quot;&apos; AND [Action Code] &lt;&gt; &apos;&quot; + sDelete + &quot;&apos;&quot;;
				   SetSearchExpr(searchexpr1);               
				   ExecuteQuery(ForwardOnly);               
					if (FirstRecord())
					{
						sInstockAvailable = &quot;Y&quot;;
						sServiceOrderId = GetFieldValue(&quot;Id&quot;);
						sPaymentOrderId = GetFieldValue(&quot;Order Header Id&quot;);				

					}
					else if(sFulfilmentOrderId != null &amp;&amp; sFulfilmentOrderId != &quot;&quot; &amp;&amp; sInstockAvailable == &quot;N&quot;)
					{
						with(bcLineItems)
						{
						   ActivateField(&quot;Order Header Id&quot;);
						   ActivateField(&quot;Parent Order Item Id&quot;);
						   ActivateField(&quot;VF Stock Indicator TBUI&quot;);
						   ActivateField(&quot;Action Code&quot;);			   
						   ActivateField(&quot;Id&quot;);               
						   SetViewMode(AllView);
						   ClearToQuery();
						   searchexpr2 = &quot;[Order Header Id] = &apos;&quot; + sFulfilmentOrderId + &quot;&apos; AND [Parent Order Item Id]  IS NULL AND [Action Code] &lt;&gt; &apos;&quot; + sDelete + &quot;&apos;&quot;;
						   SetSearchExpr(searchexpr2);               
						   ExecuteQuery(ForwardOnly);               
							if (FirstRecord())
							{
								sServiceOrderId = GetFieldValue(&quot;Id&quot;);
								sPaymentOrderId = GetFieldValue(&quot;Order Header Id&quot;);
								

							}
						}
						
					}
					with(sBC)
						{
						   SetViewMode(AllView);					               
						   ClearToQuery();
						   ActivateField(&quot;Payment Order Id&quot;);
						   ActivateField(&quot;Service Order Id&quot;);
						   ActivateField(&quot;Fullfillment Order Id&quot;);
						   ActivateField(&quot;Order Id&quot;);
						   searchexpr = &quot;[Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;
						   SetSearchExpr(searchexpr);
						   ExecuteQuery(ForwardOnly);
						   if(FirstRecord())
						   {
								SetFieldValue(&quot;Payment Order Id&quot;, sPaymentOrderId);
								SetFieldValue(&quot;Service Order Id&quot;, sServiceOrderId);
								SetFieldValue(&quot;Fullfillment Order Id&quot;, sFulfilmentOrderId);
								WriteRecord();
						   }
					
				
						}
				}
		}
				
				
	}
}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderId = null;
		sBO = null;
		sBC = null;		
	}
	
	
}"
			   SEQUENCE="20"
			   UPDATED="01/04/2020 00:15:09"
			   UPDATED_BY="SADMIN"
			   CREATED="11/12/2019 03:50:45"
