			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	//Chitra Added for Sharing SImplification - 29/05/2016
	try
	{
		switch(MethodName)
		{
			case &quot;ValidateSharingDetails&quot;:
			fnValidateSharingDetails(Inputs, Outputs);
			break;
			//Indumathi: Added for R19.1 PKE#57944
			case &quot;ValidateLeadSharingDetails&quot;:
			fnValidateLeadSharingDetails(Inputs, Outputs);
			break;
			case &quot;UpdateSharingDetails&quot;:
			fnUpdateSharingDetails(Inputs, Outputs);
			break;
			case &quot;InsertSharingDetails&quot;:
			fnInsertSharingDetails(Inputs, Outputs);
			break;
			case &quot;ProcessModifyMSO&quot;:
			fnProcessModifyMSO(Inputs,Outputs);
			break;
			case &quot;UpdateSharingOption&quot;:
			fnUpdateSharingOption(Inputs,Outputs);
			break;
			case &quot;ValidateSharingCompatibility&quot;:
			fnValidateSharingCompatibility(Inputs,Outputs);
			break;
			case &quot;DeleteLineItems&quot;:
			fnDeleteLineItems(Inputs,Outputs);
			break;
			case &quot;GetSharingId&quot;:
			mGetSharingId(Inputs,Outputs);
			break;
			case &quot;ClearSharingFlag&quot;:
			fnClearAssetFlag(Inputs,Outputs);
			break;
			case &quot;CheckModifedLineItems&quot;:
			fnCheckModifedLineItems(Inputs,Outputs);
			break;
			case &quot;CheckCustomised&quot;:
			fnCheckCustomised(Inputs,Outputs);
			break;
			case &quot;SharingFlgSubmitUpdate&quot;:
			mSharingFlgSubmitUpdate(Inputs, Outputs);
			break;
			case &quot;GetSharServicesCount&quot;:
			mGetSharServicesCount(Inputs, Outputs);
			break;
			case &quot;CheckOpenOrder&quot;:
			mCheckOpenOrder(Inputs, Outputs);
			break;
			case &quot;UpdateExistingSharingRecords&quot;: //Roseline:07/07/2016 - Added for R16.3 Defect# 371
			mUpdateExistingSharingRecords(Inputs, Outputs);
			break;
			case &quot;UpdateUpgradeSharingFlag&quot;: 
			UpdateUpgradeSharingFlag(Inputs, Outputs);
			break;
			case &quot;ValidateNewGroupLeadMSISDN&quot;:////Added by Kailash for PKE000000040904 &amp; PKE000000050073
			mValidateNewGroupLeadMSISDN(Inputs, Outputs);
			break;
			case &quot;ValidateSharingDetailsOnlineSharing&quot;: //Added by YP for online sharing
			mValidateSharingDetailsOnlineSharing(Inputs, Outputs);
			break;
			case &quot;CheckOrderStatus&quot;: //Added by YP for online sharing
				mCheckOrderStatus(Inputs, Outputs);
			break;
			case &quot;CheckForOpenOrder&quot;: //Added by Divya for remove sharing RCR
				mCheckForOpenOrder(Inputs, Outputs);
			break;
			case &quot;CheckForValidSharingRCR&quot;: //Added by Divya for remove sharing RCR
				mCheckValidSharingOrderRCR(Inputs, Outputs);
			break;
			case &quot;ChkChangePropRCR&quot;: //Added by Divya for remove sharing RCR
				mChkChangePropRCR(Inputs, Outputs);
			break;
			case &quot;SelectAssetForSharing&quot;: //Added by YP for online sharing
				mSelectAssetForSharing(Inputs, Outputs);
			break;
			case &quot;ValidateSharingEntry&quot;:  //Added by Divya for PKE#92191
			ValidateSharingEntry(Inputs, Outputs);
			break;
			case &quot;SelectExistingSharingGroup&quot;: //Added by YP for online sharing
				mSelectExistingSharingGroup(Inputs, Outputs);
			break;
			case &quot;ValidateSharingExistingMSISDN&quot;: //Added by YP for online sharing
				mValidateSharingExistingMSISDN(Inputs, Outputs);
			break;	
			break;
			default:
			break;
		}
		return (CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	return (ContinueOperation);
}"
