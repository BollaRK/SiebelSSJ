			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPurgeQRCodes_ConnectNative"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPurgeQRCodes_ConnectNative(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;Order Sub Type&quot;);
		var sOrderSubTypeTBUI = Inputs.GetProperty(&quot;Order Sub Type TBUI&quot;);
		var sOrderChannel = Inputs.GetProperty(&quot;Order Channel&quot;);
		var sOrderBulkId = Inputs.GetProperty(&quot;Bulk Id&quot;);
		var sConfirmationCode = Inputs.GetProperty(&quot;Confirmation Code&quot;);
        var sCommentUpdate = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_COMMENT_UPDATE_SWITCH&quot;,&quot;Update&quot;);
        var sFileFullPath = &quot;&quot;, RetVal = &quot;&quot;;
        if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
        {
            if(sCommentUpdate == &quot;Y&quot; &amp;&amp; sOrderSubTypeTBUI != &quot;New Connection&quot;)
           {
	        	UpdateComments(sOrderId); // Skipping update comments for Connect TBUI 
           }
        }
		if((sOrderSubType == &quot;Connect&quot; || sOrderSubType == &quot;Change Ownership Connect&quot;) &amp;&amp; (sOrderSubTypeTBUI != &quot;New Connection&quot;) &amp;&amp; (sOrderChannel != &quot;VHA Online Store&quot;) &amp;&amp; (sOrderBulkId == &quot;&quot; || sOrderBulkId == null) &amp;&amp; (sOrderId != &quot;&quot; &amp;&amp; sOrderId != null) &amp;&amp; (sConfirmationCode != &quot;&quot; &amp;&amp; sConfirmationCode != null))
		{
			with(oBC)
			{
				ActivateField(&quot;SourceOrderId&quot;);
				ActivateField(&quot;SourceFileSrcPath&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;SourceOrderId&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				var sRecExist = FirstRecord();
				while(sRecExist)
				{
					sFileFullPath = GetFieldValue(&quot;SourceFileSrcPath&quot;);
					RetVal = InvokeMethod(&quot;DeleteFile&quot;,sFileFullPath);
					if(RetVal = &quot;Success&quot;)
					{
						DeleteRecord();	
					}	
					sRecExist = FirstRecord();		
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oBC = null;
		oBO = null;
	}
}"
