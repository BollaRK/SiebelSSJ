			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateBulkExport"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateBulkExport(Inputs, Outputs)
{
	try
	{
		var sBatchId = Inputs.GetProperty(&quot;BatchId&quot;);
		var sRegenerateQR = Inputs.GetProperty(&quot;IsRegenerateQR&quot;);
		var sSearchExpr;
		var sFileName = &quot;ESIM_EXPORT_&quot;+sBatchId+&quot;_&quot;;
		var strNEW_LINE = &quot;\r\n&quot;;
		var oToday = new Date();
		var sTimeString = &quot;&quot;;
		var sConfirmationCode,sICCID, sSMDPPLUSAddress, sActivationCode, sActivationCodeURL;
		var sSIMType = &quot;eSIM&quot;;
		var sOutputText = &quot;SIMType,ConfirmationCode,ICCID,SMDPPLUSAddress,ActivationCode&quot;+strNEW_LINE;
		
		if(sRegenerateQR == &quot;Y&quot;)
			sSearchExpr = &quot;[Batch Header Id] = &apos;&quot;+sBatchId+&quot;&apos; AND [Select eSIM] = &apos;Y&apos;&quot;;
		else
			sSearchExpr = &quot;[Batch Header Id] = &apos;&quot;+sBatchId+&quot;&apos;&quot;;

		var sBulkBO = TheApplication().GetBusObject(&quot;VHA Bulk eSIM Connection BO&quot;);
		var sBulkBC = sBulkBO.GetBusComp(&quot;VHA Bulk eSIM Connection&quot;);
		with(sBulkBC)
		{
			ActivateField(&quot;eSIM Serial Number&quot;);
			ActivateField(&quot;SMDPPLUSAddress&quot;);
			ActivateField(&quot;Activation Code&quot;);
			//ActivateField(&quot;ActivationCode URL&quot;);
			ActivateField(&quot;Confirmation Code&quot;);
			ClearToQuery();
			SetSearchExpr(sSearchExpr);
			ExecuteQuery();
			var IsRecord = FirstRecord();
			while(IsRecord)
			{
				sConfirmationCode = GetFieldValue(&quot;Confirmation Code&quot;);
				sICCID = GetFieldValue(&quot;eSIM Serial Number&quot;);
				sSMDPPLUSAddress = GetFieldValue(&quot;SMDPPLUSAddress&quot;);
				sActivationCode = GetFieldValue(&quot;Activation Code&quot;);
				//sActivationCodeURL = GetFieldValue(&quot;ActivationCode URL&quot;);
				sOutputText = sOutputText + sSIMType + &quot;,&quot; + sConfirmationCode + &quot;,&quot; + sICCID + &quot;,&quot; + sSMDPPLUSAddress + &quot;,&quot; + sActivationCode +strNEW_LINE;
				IsRecord = NextRecord();
			}
		}
		
		var sConfigBO = TheApplication().GetBusObject(&quot;VHA Configuration List&quot;);
		var sConfigBC = sConfigBO.GetBusComp(&quot;VHA Configuration List&quot;);
		var sExportDir;
		with(sConfigBC)
		{
			ActivateField(&quot;String 26&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Type]=&apos;VHA_BULK_ESIM_FILE_PATH&apos; AND [Active Flg]=&apos;Y&apos; &quot;);
			ExecuteQuery();
			if(FirstRecord())
			{
				sExportDir = GetFieldValue(&quot;String 26&quot;);
			}
		}
		
		sTimeString += oToday.getFullYear();
		if(oToday.getMonth()&gt;=9) 
			sTimeString += (oToday.getMonth() + 1);
		else
			sTimeString += &quot;0&quot; + (oToday.getMonth() + 1);
		if(oToday.getDate()&gt;9) 
			sTimeString += oToday.getDate();
		else
			sTimeString += &quot;0&quot; + oToday.getDate();
			
		if(oToday.getHours()&gt;9) 
			sTimeString += oToday.getHours();
		else
			sTimeString += &quot;0&quot; + oToday.getHours();
		if(oToday.getMinutes()&gt;9) 
			sTimeString += oToday.getMinutes();
		else
			sTimeString += &quot;0&quot; + oToday.getMinutes();
		if(oToday.getSeconds()&gt;9) 
			sTimeString += oToday.getSeconds() + 1;
		else
			sTimeString += &quot;0&quot; + oToday.getSeconds();
			
		sFileName += sTimeString;
		var sFilePath = sExportDir + &quot;/&quot; + sFileName + &quot;.csv&quot;;
		var file = Clib.fopen(sFilePath,&quot;w&quot;);
		Clib.fputs(sOutputText,file);
		Outputs.SetProperty(&quot;ExportFilePath&quot;, sExportDir);
		Outputs.SetProperty(&quot;ExportFileName&quot;, sFileName);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sConfigBC = sBulkBC = null;
		sConfigBO = sBulkBO = null;
		file = null;
	}
}"
