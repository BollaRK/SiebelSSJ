			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckAddMember"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckAddMember(sOrderId,sLeadMSISDN,sAssetCount,sAssetIntgId,sGroupId)
{
	try
	{
		var sOrderBO = TheApplication().GetBusObject(&quot;VHA Sharing Thin BO&quot;);
		var sOrderBC = sOrderBO.GetBusComp(&quot;VHA Order Entry - Line Items&quot;);
	//	var oAssetBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
		//var oAssetBC = oAssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
		//var sSearchspec = &quot;[Sharing Group Id] = &apos;&quot; + sGroupId + &quot;&apos; AND [Integration Id] &lt;&gt; &apos;&quot; + sAssetIntgId + &quot;&apos; AND [Status] = &apos;Active&apos;&quot;;
		var sAddmem = &quot;&quot;;
		with(sOrderBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;MSISDN Calc&quot;);
            ActivateField(&quot;Order Header Id&quot;);
            ActivateField(&quot;Parent Order Item Id&quot;);
            ActivateField(&quot;Sharing Action&quot;);
            ActivateField(&quot;Sharing Lead MSISDN Id&quot;);
			ActivateField(&quot;VHA Siebel Product Type&quot;);
			ActivateField(&quot;VHA Siebel Prod Type-LOV&quot;);
            ClearToQuery();
            var sSearchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL AND ([Sharing Action] = &apos;Add Member&apos; OR [Sharing Action] = &apos;Existing Member&apos;)&quot;;
            SetSearchExpr(sSearchst);
        	if(sAssetCount ==0)
			SetSortSpec(&quot;VHA Siebel Prod Type-LOV&quot;);
            ExecuteQuery(ForwardOnly);
			var sExistCount = CountRecords();
            var isRec = FirstRecord();
            while(isRec)
            {
				if(sExistCount &gt;1 &amp;&amp; sAssetCount == 0 &amp;&amp; sLeadMSISDN == &quot;&quot;)
				{
				   /* with(oAssetBC)
            			{
            				SetViewMode(AllView);
            				ActivateField(&quot;Integration Id&quot;);
            				ActivateField(&quot;Sharing Group Id&quot;);
            				ActivateField(&quot;MSISDN&quot;);
            				ActivateField(&quot;Status&quot;)
            				ClearToQuery();
							SetSearchExpr(sSearchspec);
							ExecuteQuery(ForwardOnly);
							if (FirstRecord())
							{
					sLeadMSISDN = GetFieldValue(&quot;MSISDN Calc&quot;);
					}
					}*/
					sLeadMSISDN = GetFieldValue(&quot;MSISDN Calc&quot;);
								
				}
				sAddmem = sLeadMSISDN;
				isRec = NextRecord();	
            }
		}
		return(sAddmem);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderBC = &quot;&quot;;
		//oAssetBC = &quot;&quot;;
		sOrderBO = &quot;&quot;;
		//oAssetBO = &quot;&quot;;
	}
}"
			   SEQUENCE="25"
			   UPDATED="06/28/2024 18:49:19"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckChangeLeadExists"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckChangeLeadExists(strOrderId, sAssetIntegId)
{
 try
 {
		var sRemMemExists=&apos;Y&apos;;
		var sBO = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var sBC = sBO.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var sSearchExpr = &quot;[Order Header Id]=&apos;&quot; +strOrderId+&quot;&apos; AND [Custom Asset Integration Id]=&apos;&quot;+sAssetIntegId+&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Sharing Action Calc] &lt;&gt; &apos;Remove Member&apos; AND [Sharing Action Calc] IS NOT NULL&quot;;
		
		if(strOrderId != &apos;&apos; &amp;&amp; sAssetIntegId !=&apos;&apos;)
		{
			with(sBC)
			{
				ActivateField(&quot;Custom Asset Integration Id&quot;);
				ActivateField(&quot;Sharing Action Calc&quot;);
			 	SetViewMode(AllView);
				ClearToQuery();
			    SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
					sRemMemExists = &apos;N&apos;;
			}				
		}
	return(sRemMemExists);
}
  catch(e)
{
	throw(e);
}
finally
{
	sBC = null;
	sBO = null;
}
}"
			   SEQUENCE="26"
			   UPDATED="06/28/2024 18:49:19"
