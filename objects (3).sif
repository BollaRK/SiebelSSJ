			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateIDDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateIDDetails(Inputs, Outputs)
{
/* Method Name           : 	
* Component Information : 	This function validates all fields entered correct also 100 points calculation and with one Address Proof ID validation
*
* Modification History  :
* Date			Author		Config #		Description
* ======		====== 		===========		================================
* 02/06/2014	Neel		Cloned/Modified from VF Wizard Utilities
* 03/07/2014	Neel		Added Validation for Prepay ID Details - Expiry Date Check. Points, Primary and Address Proof
* 17/06/2020	Suresh P 	Bypassed BAU Valdiations for existing customers.
*/
	 
	var bcContact;
	var bcAccount;
	var bcContactId;
	var bcIDScan;
	var boAccount;

	var sValid;
	var sErrMsg =&quot;&quot;;
	var sContactId;
	var ContactIdFound;
	var iTotalPoints =0;
	var iTotalPointsPrepay =0;// Neel 03/07 - Added
	var sAddrProof=&quot;N&quot;;
	var sPrimary = &quot;N&quot;; // Neel 03/07 - Added
	var sPrimaryFlag; // Neel 03/07 - Added
	var	sPrimaryProofFlg; // Neel 03/07 - Added
	var sAddrFlg;
	var strRaiseError = &quot;N&quot;;
	var sExpiryDate;
	var sIdRefNum1 = &quot;&quot;;
	var sIdRefNum2 = &quot;&quot;;
	var sIdErrorFlg = &quot;N&quot;;
	var sDateErrorFlg = &quot;&quot;;
	var dToday = new Date();
	var sRecNum = 0;
	var dtExpDt ;
	var sPrConId = &quot;&quot;; //Ravindra : Added for imagine project
	var sDVSValid = &quot;N&quot;, sIdUpdFlg= &quot;&quot;, sMaxAttReached = &quot;N&quot;;
	var sMaxLimit = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;DVS Postpay Limit&quot;);
	var sIPFlag = &quot;&quot;,sDVSErrMsg = &quot;&quot;,sLocalPassport = &quot;N&quot;;
	var sMaxAttmptIdType = &quot;&quot;,boLOV = &quot;&quot;,bcLOV = &quot;&quot;,sDesc = &quot;&quot;,ErrorMessageOut = &quot;&quot;,sErrorType = &quot;&quot;; //VHA NandhiniG 01/10/20 : Added to decide Max limit Waring/Error based on LOV

	//var sVHACCPolicy = &quot;&lt;a href=&apos;http://www.vodafonechannel.com.au/site/dcp/australia/enau/processes/policies/credit/l_credit.jsp/&apos; target=&apos;_blank&apos; style=&apos;text-decoration: none&apos;&gt;VHA Credit Check Policy Link &lt;/a&gt;&quot;; 
	try
	{			
		var sContactId = Inputs.GetProperty(&quot;ContactId&quot;);
		var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var sScenario = Inputs.GetProperty(&quot;Scenario&quot;);
		var sExisCust = Inputs.GetProperty(&quot;ExistingCustomer&quot;);			//Added for R18.3 CIR
		var sOrderTypeTBUI = Inputs.GetProperty(&quot;OrderTypeTBUI&quot;);       // Added by sachi 16th Apr 2019 for MR02
		var SkipBAUValidations = Inputs.GetProperty(&quot;SkipBAUValidations&quot;);
		var sEnforceDVSValidation = Inputs.GetProperty(&quot;EnforceDVSValidation&quot;);
		var sEnforceMaxAttValidation = Inputs.GetProperty(&quot;EnforceMaxAttempts&quot;);
		var sAccntType = Inputs.GetProperty(&quot;AccountType&quot;);
		var SSJFlag = Inputs.GetProperty(&quot;SSJFlag&quot;);
		var psIns = TheApplication().NewPropertySet();	// VHA Suresh P: Added to skip DVS based on switch/resp
		var psOuts = TheApplication().NewPropertySet();
		psIns.SetProperty(&quot;Type&quot;, &quot;VHA_FUNCTION_ACCESS_RESP&quot;);
		psIns.SetProperty(&quot;Value&quot;, &quot;DVS Validation Responsibility&quot;);
		fnQueryLOV(psIns,psOuts);
		var sDVSOverrideResp = psOuts.GetProperty(&quot;LIC&quot;);
		var sDVSSkipResp = checkResponsibility(sDVSOverrideResp);
		var sSkipDVSID = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Skip DVS ID Validation&quot;);
		var sDVSSwitch = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Enable Postpay DVS Validation&quot;);
		var sIPLOV = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_PP_ID_TYPE&quot;,&quot;International Passport&quot;);
		var sAddNewAccount = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);
TheApplication().SetProfileAttr(&quot;ACCNTID&quot;,sAccountId); //Ravindra: Added for Imagine Project

		boAccount = TheApplication().GetBusObject(&quot;VF Validate ID Details&quot;);
		//bcAccount = boAccount.GetBusComp(&quot;VF Account Thin&quot;);
		//bcContact= boAccount.GetBusComp(&quot;Contact-Thin&quot;);
		bcContactId = boAccount.GetBusComp(&quot;VF Contact Id Thin&quot;);
		bcIDScan = boAccount.GetBusComp(&quot;VF ID Scan Session - TBUI&quot;); 

	
		var boAcnt = TheApplication().GetBusObject(&quot;Account&quot;);
		var bcAcnt = boAcnt.GetBusComp(&quot;Account&quot;);
		with(bcAcnt)
		{
			ClearToQuery();
			SetViewMode(AllView);						
			ActivateField(&quot;Primary Contact Id&quot;);						
			SetSearchSpec(&quot;Id&quot;, sAccountId)
			ExecuteQuery(ForwardOnly)
			if(FirstRecord())
			{
				sPrConId=GetFieldValue(&quot;Primary Contact Id&quot;);
				TheApplication().SetProfileAttr(&quot;PRCONID&quot;,sPrConId);
			}		
		}
		
		with (bcContactId)
		{	 
			ClearToQuery();
			//ActivateField(&quot;Contact Id&quot;);
			ActivateField(&quot;VHA Postpay ID Type Calc&quot;);
			ActivateField(&quot;VHA Remove Existing Id&quot;);
			ActivateField(&quot;DVS Successful Time&quot;);
			ActivateField(&quot;VHA Primary ID Captured Ref&quot;);
			ActivateField(&quot;VHA IsVEVOSysdown&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Contact Id&quot;, sContactId);
			SetSearchSpec(&quot;Type&quot;, &quot;Identification&quot;); // Added for defect 1659 - To check only identification records.
			ExecuteQuery(); 

			ContactIdFound = FirstRecord();
			
			//PopUP Notification if No ID Detail Found
			if(!ContactIdFound)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;You should add Identification Details to proceed further.&quot;);
				strRaiseError = &quot;Y&quot;;
			}		
			
			while (ContactIdFound)
			{
				var sPoint = GetFieldValue(&quot;VF Points Postpay&quot;);
				var sExpiryDate  = GetFieldValue(&quot;Expiry Date&quot;);
				var sIDRefNum = GetFieldValue(&quot;Id Reference Number&quot;);
				var sIDType = GetFieldValue(&quot;Id Type&quot;);
				var sCountryOfIssue = GetFieldValue(&quot;Country of Issue&quot;);
				var sRemoveId = GetFieldValue(&quot;VHA Remove Existing Id&quot;);  
				var sDVSTransId = GetFieldValue(&quot;DVS Successful Time&quot;);
				var sIdUpd = GetFieldValue(&quot;VHA Primary ID Captured Ref&quot;);
				var sIDTypeCalc = GetFieldValue(&quot;VHA Postpay ID Type Calc&quot;);

				if(sIDTypeCalc == sIPLOV)
					sMaxAttmptIdType = sIPLOV;
				else
					sMaxAttmptIdType = sIDType;

				if(sIDRefNum == &quot;&quot;)
					TheApplication().RaiseErrorText(&quot;ID Reference Number cannot be Null.&quot;);
				
				if(sIDType == &quot;Passport&quot;)
				{
					if(sCountryOfIssue == &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Country of Issue cannot be null for ID Type Passport.&quot;);
					}			
					
				}	
				if(sIDType == &quot;Medicare Card&quot;)
				{
					if (sIDRefNum.length != 10)
					{
						TheApplication().RaiseErrorText(&quot;Please enter a valid 10 digit numeric for Medicare Card.&quot;);
					}
					else 
					{
						if (isNaN(sIDRefNum))
							TheApplication().RaiseErrorText(&quot;Please enter a valid 10 digit numeric for Medicare Card.&quot;);
					}
				}					

				if(sOrderTypeTBUI == &quot;Pre to Post transfer&quot; &amp;&amp; sRemoveId == &quot;Y&quot;) // Added by sachi 16th Apr 2019 for MR02
				{
					//Do Nothing
				}
				else
				{				
				iTotalPoints = iTotalPoints + ToNumber(GetFieldValue(&quot;VF Points Postpay&quot;));
				iTotalPointsPrepay = iTotalPointsPrepay + ToNumber(GetFieldValue(&quot;Id Points&quot;)); // Neel 03/07 - Added
				
				if((TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_POSTPAY_IDTYPE_PRIMARY&quot;,sIDType) == &quot;Y&quot;) &amp;&amp; sPrimaryProofFlg != &quot;Y&quot;)
				{
					sPrimaryProofFlg = &quot;Y&quot;;
					
				}
				
				if((TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_DVS_PP_TBUI&quot;,sIDType)) == &quot;Y&quot;)
				{
					if(sIdUpd != null &amp;&amp; sIdUpd != &quot;&quot;)
						sIdUpdFlg = &quot;Y&quot;;
					
					if((sDVSTransId != &quot;&quot; &amp;&amp; sDVSTransId != null) || (sIDTypeCalc == sIPLOV &amp;&amp; GetFieldValue(&quot;VHA IsVEVOSysdown&quot;) == &quot;1&quot;) &amp;&amp; sDVSValid != &quot;Y&quot;)
						sDVSValid = &quot;Y&quot;;
					
					if (sIdUpdFlg == &quot;Y&quot; &amp;&amp; sDVSValid != &quot;Y&quot; &amp;&amp; sDVSErrMsg == &quot;&quot;)
						sDVSErrMsg = &quot;Please validate the &quot;+sIDType+ &quot; before proceeding.&quot;
					
					if(sDVSValid != &quot;Y&quot; &amp;&amp; fnGetFailureAttempts(sMaxAttmptIdType,sContactId) &gt;= sMaxLimit)
					{
						if(sIDTypeCalc == sIPLOV &amp;&amp; GetFieldValue(&quot;VHA IsVEVOSysdown&quot;) != &quot;1&quot;)
							sIPFlag = &quot;Y&quot;;
						sMaxAttReached = &quot;Y&quot;;
					}
					
					if(sIDTypeCalc == &quot;Passport&quot;)
						sLocalPassport = &quot;Y&quot;;
				}
				
				}				
				sIdRefNum1 = GetFieldValue(&quot;Id Reference Number&quot;);
				
			
				
				if(sDateErrorFlg == &quot;&quot;)
				{
					sExpiryDate  = GetFieldValue(&quot;Expiry Date&quot;);
					dtExpDt = new Date(sExpiryDate);
					if(dToday &gt;= dtExpDt)
						sDateErrorFlg = &quot;The Id - &quot;+sIDType+ &quot; is expired. Please update/ recapture the Id to proceed with the order journey.&quot;;
				} 
								
				if(sIdErrorFlg == &quot;N&quot;)//added for Id validation for TBUI
				{
						var BO = TheApplication().GetBusObject(&quot;VF Validate ID Details&quot;);
						var BC = BO.GetBusComp(&quot;VF Contact Id Thin&quot;);
						var sRemoveID2 = &quot;&quot;;
						sRecNum = 0;
						BC.ActivateField(&quot;VHA Remove Existing Id&quot;); // Sachi - 31/05/2019 - Added for MR02 ACMA Fixes
						BC.ClearToQuery();
						BC.SetViewMode(AllView);
						BC.SetSearchSpec(&quot;Contact Id&quot;, sContactId);
						BC.SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;); //23/05/2016  NIRMAL Added for PKE000000036888
						BC.ExecuteQuery(); 
						var isRec = BC.FirstRecord();
						while(isRec)
						{
							sIdRefNum2 = BC.GetFieldValue(&quot;Id Reference Number&quot;);
							sRemoveID2 = BC.GetFieldValue(&quot;VHA Remove Existing Id&quot;); // Sachi - 31/05/2019 - Added for MR02 ACMA Fixes
							if(sOrderTypeTBUI == &quot;Pre to Post transfer&quot;)   // Sachi - 31/05/2019 - Added for MR02 ACMA Fixes - Start
							{
								if((ToString(sIdRefNum1) == ToString(sIdRefNum2)) &amp;&amp; (sRemoveID2 != &quot;Y&quot;))
								{
									sRecNum = sRecNum+1;
								}
							}   // Sachi - 31/05/2019 - Added for MR02 ACMA Fixes - end
							else if(ToString(sIdRefNum1) == ToString(sIdRefNum2))
							{
								sRecNum = sRecNum+1;
							}								
							if(sRecNum &gt;= 2)
							{
								sIdErrorFlg = &quot;Y&quot;;
							}
							isRec = BC.NextRecord();
						}//while
						
				}
				
				ContactIdFound = NextRecord();
			}

			//TheApplication().RaiseErrorText(iTotalPointsPrepay);
			
			//if (sExisCust != &quot;Y&quot; &amp;&amp; sDateErrorFlg != &quot;&quot;)
			if ((sExisCust != &quot;Y&quot; &amp;&amp; sDateErrorFlg != &quot;&quot;) || (SSJFlag == &quot;Y&quot; &amp;&amp; sDateErrorFlg != &quot;&quot; &amp;&amp; sExisCust == &quot;Y&quot;)) //Added for CM9336
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;,sDateErrorFlg);
				strRaiseError = &quot;Y&quot;;
			}
		    else if(sIdErrorFlg == &quot;Y&quot;)	
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Id Reference should be Unique.&quot;);
				strRaiseError = &quot;Y&quot;;
			}
			else if (iTotalPointsPrepay &lt; 100 &amp;&amp; sScenario == &quot;Prepay&quot;)// Neel 03/07 - Added
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Total 70 ID Points Required.&quot;);
				strRaiseError = &quot;Y&quot;;			
			}
		/*	else if (iTotalPoints &lt; 100 &amp;&amp; sScenario != &quot;Prepay&quot; &amp;&amp; SkipBAUValidations != &quot;Y&quot;)
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Total 100 ID Points or a Valid DVS Id combination is Required.&quot;);
				strRaiseError = &quot;Y&quot;;
				//sErrMsg = &quot; Total 100 ID Points Required. &quot;;
			}
			else if (sAddrFlg != &quot;Y&quot; &amp;&amp; sScenario != &quot;Prepay&quot;)// UAT Defect#2005 - NEEL - 19AUG2014
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;One of the ID must have Address Proof for Credit Check Process.&quot;);
				strRaiseError = &quot;Y&quot;;
				//sErrMsg = sErrMsg + &quot; One of the ID must have Address Proof for Credit Check Process.&quot;;
			}	VHA Suresh P: Aug Release:	Commented the code to remove the BAU Validation */
			else if (sPrimaryProofFlg != &quot;Y&quot; &amp;&amp; sScenario != &quot;Prepay&quot; &amp;&amp; SkipBAUValidations != &quot;Y&quot;)// UAT Defect#2005 - NEEL 26AUG2014
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;One of the ID should be Primary.&quot;);
				strRaiseError = &quot;Y&quot;;
			}
			else if (sPrimaryProofFlg != &quot;Y&quot; &amp;&amp; sScenario == &quot;New&quot; &amp;&amp; SkipBAUValidations != &quot;Y&quot;) //Sri 16/8 :Added for defect 1816
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;One of the ID should be Primary.&quot;);
				strRaiseError = &quot;Y&quot;;
			}
			else if (sDVSValid != &quot;Y&quot; &amp;&amp; sIdUpdFlg ==&quot;Y&quot; &amp;&amp; sMaxAttReached != &quot;Y&quot; &amp;&amp; sEnforceDVSValidation == &quot;Y&quot; &amp;&amp; sDVSErrMsg != &quot;&quot; &amp;&amp; sDVSSkipResp != &quot;Y&quot; &amp;&amp; sDVSSwitch == &quot;ON&quot; &amp;&amp; sSkipDVSID == &quot;N&quot;) 
			{
				Outputs.SetProperty(&quot;ErrMsg&quot;, sDVSErrMsg);
				strRaiseError = &quot;Y&quot;;
			}
			else if (sDVSValid != &quot;Y&quot; &amp;&amp; sIdUpdFlg ==&quot;Y&quot; &amp;&amp; sMaxAttReached == &quot;Y&quot; &amp;&amp; sDVSSkipResp != &quot;Y&quot; &amp;&amp; sDVSSwitch == &quot;ON&quot; &amp;&amp; sSkipDVSID == &quot;N&quot; &amp;&amp; sEnforceMaxAttValidation ==&quot;Y&quot;) 
			{
			//	Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;The customers identity information could not be verified. Please continue with the application. Please note: DEPENDING ON THE TYPE OF TRANSACTION, a biometric verification link may be sent to the customer’s contact number via SMS on submission to allow verification. Please instruct the customer to follow the on screen instructions.&quot;);
				if(sIPFlag == &quot;Y&quot; &amp;&amp; sLocalPassport == &quot;N&quot;)
				{
					Outputs.SetProperty(&quot;ErrorType&quot;, &quot;&quot;);
					Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Please validate the International Passport before proceeding.&quot;);
				}
				else
				{
					boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
					bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
					with(bcLOV)
					{
						ClearToQuery();
						SetViewMode(AllView);
						ActivateField(&quot;Type&quot;);
						ActivateField(&quot;Value&quot;);	
						ActivateField(&quot;Name&quot;);	
						ActivateField(&quot;Description&quot;);
						ActivateField(&quot;Order By&quot;);
						SetSearchExpr(&quot;[Type]=&apos;VHA_VEVO_MAX_ATTEMPT_ERR&apos; AND [Active]=&apos;Y&apos; AND [Name] = &apos;AllowMaxAttempt&apos;&quot;);
						SetSortSpec(&quot;Order By(ASCENDING)&quot;);
						ExecuteQuery(ForwardOnly)
						if(FirstRecord())
						{
						sErrorType = GetFieldValue(&quot;Value&quot;);
						var isrec = FirstRecord();
							while(isrec)
							{
							sDesc = GetFieldValue(&quot;Description&quot;);
							if(ErrorMessageOut == &quot;&quot;)
								ErrorMessageOut = sDesc;
							else 
								ErrorMessageOut = ErrorMessageOut + sDesc;
							isrec = NextRecord();
							}					
						}
						if(sErrorType == &quot;Error&quot;)
							sErrorType = &quot;&quot;;
					}
				Outputs.SetProperty(&quot;ErrMsg&quot;, ErrorMessageOut);
				Outputs.SetProperty(&quot;ErrorType&quot;, sErrorType);
				}
				strRaiseError = &quot;Y&quot;;
			}

	
		}// end of with (bcContactId)
	
	
		with (bcIDScan)
		{			
		/*	ClearToQuery();
			ActivateField(&quot;Customer Account Id&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Customer Account Id&quot;, sAccountId);*/
			ClearToQuery();
			ActivateField(&quot;Primary Contact Id&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Primary Contact Id&quot;, sPrConId);   		
			ExecuteQuery();	
			var x = FirstRecord();
			if(!FirstRecord())
			{		
				// Check if the dealer is enabled for Paperless ID Scanning
				if (TheApplication().GetProfileAttr(&quot;IsDealerEnableForIdScan&quot;) == &quot;TRUE&quot;)
				{
					if (sScenario == &quot;New&quot; &amp;&amp; strRaiseError == &quot;N&quot;)
					{		
					     TheApplication().SetProfileAttr(&quot;VFTBUIUtilities&quot;,&quot;VFTBUIUtilities&quot;);				
						Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;Please scan the customer&apos;s identification before proceeding.&quot;);
						strRaiseError = &quot;Y&quot;;
					} 
				}
			}
		}//end of with (bcIDScan)
		
		if(strRaiseError == &quot;N&quot;)
		{
			Outputs.SetProperty(&quot;ErrMsg&quot;, &quot;&quot;);
		}

	}//end of try
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;, e);
		//throw e;
	}
	finally
	{
		bcAccount = null;
		bcContact = null;
		bcContactId = null;
		bcIDScan = null;
		boAccount = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
			//BC = null;
			//BO = null;

		/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
			if(defined(BC)) { BC = null; }
			if(defined(BO)) { BO = null; }
	}
}"
			   SEQUENCE="41"
