			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateShipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateShipment(Inputs, Outputs)
{
try
{
var sOrderBO,sOrderBC,sOrderLIBC,sShipBC,oBC;
var searchst;
var iRecord;
var isRecord;
var isRec;
var sOrderId;
var sShipmentId;
var sPriAddressId;
var sCity;
var sPostcode;
var sVFStockIndicatorTBUI;
var sOutOfStockIndicator = &quot;N&quot;;
	sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);		
	sOrderLIBC = sOrderBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
	sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	sShipmentId = Inputs.GetProperty(&quot;ShipmentId&quot;);
	with(sOrderBC)
	{
	sOrderBC.SetViewMode(AllView);
	sOrderBC.ClearToQuery();
	sOrderBC.SetSearchSpec(&quot;Id&quot;, sOrderId);
	sOrderBC.ExecuteQuery(ForwardOnly);	
	iRecord = sOrderBC.FirstRecord();
		if(iRecord) 
		{
			with(sOrderLIBC)
			{
				sOrderLIBC.SetViewMode(AllView);
				sOrderLIBC.ActivateField(&quot;Order Header Id&quot;);
				sOrderLIBC.ActivateField(&quot;Parent Order Item Id&quot;);	
				sOrderLIBC.ActivateField(&quot;VF OutofStock Flg TBUI&quot;);	
				sOrderLIBC.ClearToQuery();
				searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;; 
				sOrderLIBC.SetSearchExpr(searchst);
				sOrderLIBC.ExecuteQuery(ForwardOnly);	
				isRecord = sOrderLIBC.FirstRecord();
				while(isRecord) 
				{
					sVFStockIndicatorTBUI = sOrderLIBC.GetFieldValue(&quot;VF OutofStock Flg TBUI&quot;);	
					if(sVFStockIndicatorTBUI == &quot;Y&quot;) 
					{
						sOutOfStockIndicator = &quot;Y&quot;;		
						break;
					} 
					isRecord = sOrderLIBC.NextRecord(); 
				}
				if(sOutOfStockIndicator != &quot;Y&quot;) 
					{
						sShipBC = sOrderBO.GetBusComp(&quot;FS Shipment&quot;);
						sShipBC.SetViewMode(AllView);		
						sShipBC.ActivateField(&quot;VF Default Contact First Name&quot;);
						sShipBC.ActivateField(&quot;VF Default Contact Last Name&quot;);
						sShipBC.ActivateField(&quot;VF Ship To Contact First Name&quot;);
						sShipBC.ActivateField(&quot;VF Ship To Contact Last Name&quot;);
						sShipBC.ActivateField(&quot;VF Shipment City&quot;);
						sShipBC.ActivateField(&quot;VF Shipment Zipcode&quot;);
						sShipBC.ClearToQuery();
						sShipBC.SetSearchSpec(&quot;Id&quot;, sShipmentId);
						sShipBC.ExecuteQuery(ForwardOnly);
						isRec = sShipBC.FirstRecord(); 
						if(isRec)
						{					
							if(sShipBC.GetFieldValue(&quot;VF Ship To Contact First Name&quot;)== &quot;&quot; || sShipBC.GetFieldValue(&quot;VF Ship To Contact First Name&quot;)== null)
							{sShipBC.SetFieldValue(&quot;VF Ship To Contact First Name&quot;, sShipBC.GetFieldValue(&quot;VF Default Contact First Name&quot;));
							}
							if(sShipBC.GetFieldValue(&quot;VF Ship To Contact Last Name&quot;)== &quot;&quot; || sShipBC.GetFieldValue(&quot;VF Ship To Contact Last Name&quot;)== null)
							{sShipBC.SetFieldValue(&quot;VF Ship To Contact Last Name&quot;, sShipBC.GetFieldValue(&quot;VF Default Contact Last Name&quot;));
							}
							if(sShipBC.GetFieldValue(&quot;VF Shipment City&quot;)== &quot;&quot; || sShipBC.GetFieldValue(&quot;VF Shipment City&quot;)== null || sShipBC.GetFieldValue(&quot;VF Shipment Zipcode&quot;)== &quot;&quot; || sShipBC.GetFieldValue(&quot;VF Shipment Zipcode&quot;)== null)
							{
							sShipBC.ParentBusComp().ActivateField(&quot;VF Order Acct Address Id&quot;);
							var sNewShipAddrId = sShipBC.ParentBusComp().GetFieldValue(&quot;VF Order Acct Address Id&quot;);
							TheApplication().Trace(&quot;sNewShipAddrId:&quot;+sNewShipAddrId);
								if(sNewShipAddrId != &quot;&quot;)
								{
									oBC = sShipBC.GetPicklistBusComp(&quot;VF Shipment Street Address&quot;); 
									with (oBC)
									{
										ClearToQuery();
										SetViewMode(AllView);	   		
										SetSearchSpec(&quot;Id&quot;, sNewShipAddrId);
										ExecuteQuery(ForwardOnly);
										if (FirstRecord())
											Pick();
									} 
								}
							}
						sShipBC.WriteRecord();
						}
					}
			}  
		iRecord = sOrderBC.NextRecord(); 
		} 
	}  
        return(CancelOperation);
	} //try
	catch (e)
	{
       throw(e);	
	}
	finally
	{
		oBC = null;
	    sShipBC = null;
	    sOrderLIBC = null;
		sOrderBC = null;
      	sOrderBO = null;
	}	
	return(ContinueOperation);
}"
