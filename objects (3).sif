			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckNoOfImports"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckNoOfImports(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VF SIM Swap BO - TBUI&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);
		var sTaskId = Inputs.GetProperty(&quot;TBC Id&quot;);
		var sRecExist = &quot;&quot;, sNoOfImports = &quot;&quot;;
		
		if(sTaskId != &quot;&quot; &amp;&amp; sTaskId != null)
		{
			with(oBC)
			{
				ActivateField(&quot;Number of Imports&quot;);
				ActivateField(&quot;Source Id&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;Source Id&quot;, sTaskId)
				ExecuteQuery(ForwardOnly)
				sRecExist = FirstRecord();
				if(sRecExist)
				{
					sNoOfImports = GetFieldValue(&quot;Number of Imports&quot;);
				}
			}
		}		
		Outputs.SetProperty(&quot;No Of Imports&quot;,sNoOfImports);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oBC = null;
		oBO = null;
	}
		
}"
