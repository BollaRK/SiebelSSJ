			   INACTIVE="N"
			   NAME="mTransferType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTransferType(Inputs, Outputs)
{
try{
	var ERR = &quot;9029&quot;;
	var TransferType = Inputs.GetProperty(&quot;TransferType&quot;);
	
			
			if(TransferType == &quot;&quot; || TransferType == null)
		//	TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR));
			TheApplication().RaiseErrorText(&quot;VFErrorCode#9029&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR));
			
	 
	return (ContinueOperation);
	} 

	catch(e)
	{
		throw (e);
	}
	finally 
	{
		//bcSQService = null;
		//boOrder = null;
	}
	
	
}"
			   SEQUENCE="6"
