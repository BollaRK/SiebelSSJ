			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckCustomerRole"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckCustomerRole(Inputs,Outputs)
{
  try
  { 
		 // 25/03/2015 : Saravanan : Added for customer segment validation
		var accountId = Inputs.GetProperty(&quot;Account Id&quot;);
		var sCustomerSegment = Inputs.GetProperty(&quot;CustomerSegment&quot;);
		var sConBO = TheApplication().GetBusObject(&quot;Account&quot;);
		var sAccountBC = sConBO.GetBusComp(&quot;Account&quot;);
		var sConBC = sConBO.GetBusComp(&quot;Account Contact&quot;);
		var sCustomerType = TheApplication().GetProfileAttr(&quot;VFCustType&quot;);//[Nagesh][To exclude Sole Trader from Validation][Drop3]
		if(sCustomerSegment == &quot;Business&quot; &amp;&amp; sCustomerType != &quot;Sole Trader&quot;)
		{
			with(sAccountBC)
			{
				SetViewMode(AllView);
				ActivateField(&quot;VF Customer Type&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, accountId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
				 //sAccountType=GetFieldValue(&quot;VF Customer Type&quot;)
				}
			}
			with(sConBC)
			{
				SetViewMode(AllView);
				ActivateField(&quot;Account Id&quot;);   
				ActivateField(&quot;VF Contact Role&quot;);
				ActivateField(&quot;Contact Id&quot;);
				SetSearchSpec(&quot;Account Id&quot;, accountId);
			//	SetSearchSpec(&quot;Contact Id&quot;, &quot;&lt;&gt;&apos;&quot;+ContactId+&quot;&apos;&quot;);
				SetSearchSpec(&quot;VF Contact Role&quot;, &quot;Decision Maker&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					//Do Nothing
				}
				else
				{				  
					TheApplication().RaiseErrorText(&quot;Business Customer requires a Contact to be the Decision Maker. Please ensure there is a Contact with the Contact Role set to Decision Maker.&quot;); //Saravanan : 29:05:2015 :Updated the Text message per UAT defect15.2
				  
				}
			}//with
		}//end if
	}
	catch(e)
	{
	    throw(e);
	}
	finally
	{
		sAccountBC = null;
		sConBC = null;
		sConBO = null;
	}
  
}"
