			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteCCDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteCCDetails(Inputs, Outputs)
{

	try
	{	
		
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sXMBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sCCBC = sBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
		var sPrepayId = &quot;&quot;;
		var sSuccess = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;Success&quot;);
		var sFail = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;Failed&quot;);
		var isRecord = &quot;&quot;;
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{
			with(sXMBC)
			{
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Id&quot;);				
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Order Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sPrepayId = GetFieldValue(&quot;Id&quot;);
				}	
			}
			if(sPrepayId != null &amp;&amp; sPrepayId != &quot;&quot;)
			{
				//VHA Muthushankari - 16/10/2020 - Added for 2 Way SMS Nov Rel
				var sOrderBC = sBO.GetBusComp(&quot;Order Entry - Orders&quot;);
				sOrderBC.SetViewMode(AllView);
				sOrderBC.ClearToQuery();
				sOrderBC.SetSearchExpr(&quot;[Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VHA2WaySMSEligibleFlag] = &apos;Y&apos; AND [VHA Override MSISDN] IS NOT NULL AND ([VHA Override SMS] = &apos;N&apos; OR [VHA Override SMS] IS NULL)&quot;);
				sOrderBC.ExecuteQuery(ForwardOnly);
				if (sOrderBC.FirstRecord())
				{
					//Do Nothing
				}	
				else
				{
					with(sCCBC)
					{
						ActivateField(&quot;Prepayment Record Id&quot;);
						ActivateField(&quot;Payment Status&quot;);
						SetViewMode(AllView);
						ClearToQuery();
						SetSearchExpr(&quot;[Prepayment Record Id] = &apos;&quot;+sPrepayId+&quot;&apos; AND [Payment Status] &lt;&gt; &apos;&quot;+sSuccess+&quot;&apos; AND [Payment Status] &lt;&gt; &apos;&quot;+sFail+&quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						isRecord = FirstRecord();
						while(isRecord)
						{
							DeleteRecord();
							isRecord = FirstRecord();
						}
					}
				}
			}
		}
		
	}
	
	catch(e)
	{
		throw(e);
	}	
	
	finally
	{
		sOrderBC = null;
		sOrderId = null;
		sBO = null;
		sXMBC = null;
		sCCBC = null;
		sPrepayId = null;
		sSuccess = null;
		sFail = null;
		isRecord = null;
	
	}
}"
