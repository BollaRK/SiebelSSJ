			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdAPPContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdAPPContract(Inputs, Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oLineItemBC = oBO.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
		var oPrepayBC = oBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var oOrderItemBC = oBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		var oContractBC = oBO.GetBusComp(&quot;VHA Prepayment Contract Summary&quot;);
		var oAccessoryBC = oBO.GetBusComp(&quot;VHA Accessory Items - Thin BC&quot;);
		var sAction = &quot;Add&quot;;
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sBAId = Inputs.GetProperty(&quot;Billing Account Id&quot;);
		var sPrepayId = Inputs.GetProperty(&quot;Prepayment Id&quot;);
		var sAPPContract = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP&quot;);
		var sGPPContract = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_GPP_DEVICE_CONTRACT&quot;,&quot;GPP Device Contract&quot;);
		var sOrderItemId = &quot;&quot;, sRecExist = &quot;&quot;, sLineRecExist = &quot;&quot;, sLineId = &quot;&quot;, sProductType = &quot;&quot;, sAssetIntegId = &quot;&quot;, sMSISDN = &quot;&quot;, sSecDeviceExist = &quot;&quot;;
		var sContractAmt = &quot;&quot;, sPrepayAmt = &quot;&quot;, sItemCode = &quot;&quot;, sItemName = &quot;&quot;, sSecDeviceName = &quot;&quot;, sSecDeviceCode = &quot;&quot;, sCategory = &quot;&quot;;
		
		if(sPrepayId != &quot;&quot; &amp;&amp; sPrepayId != null)
		{
		
		with(oAccessoryBC)
		{
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;VHA Category&quot;);
			ActivateField(&quot;Hardware Code&quot;);
			ActivateField(&quot;VHA Hardware Name&quot;);
			ActivateField(&quot;Type&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			SetSearchSpec(&quot;VHA Category&quot;, &quot;Secondary Device&quot;);
			SetSearchSpec(&quot;Type&quot;, &quot;Accessory&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sSecDeviceExist = &quot;Y&quot;;
				sSecDeviceCode = GetFieldValue(&quot;Hardware Code&quot;);
				sSecDeviceName = GetFieldValue(&quot;VHA Hardware Name&quot;);
			}
		}
		
		if((sOrderId != &quot;&quot; &amp;&amp; sOrderId != null) &amp;&amp; (sBAId != &quot;&quot; &amp;&amp; sBAId != null))
		{
			with(oPrepayBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sPrepayId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{					
					with(oContractBC)
					{
						ActivateField(&quot;Prepayment Id&quot;);
						ActivateField(&quot;MPP APP Contract&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Prepayment Id&quot;, sPrepayId);
						SetSearchSpec(&quot;MPP APP Contract&quot;, sAPPContract);
						ExecuteQuery(ForwardOnly);
						sLineRecExist = FirstRecord();
						while(sLineRecExist)
						{
							DeleteRecord();
							sLineRecExist = FirstRecord();
						}
					}					
				}
			}
			
			with(oLineItemBC)
			{         
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Asset Integration Id&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;([Product Type] = &apos;Billing - APP&apos;) AND [Order Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Action Code] = &apos;&quot;+ sAction +&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				sRecExist = FirstRecord();
				while(sRecExist)
				{   
					sLineId = GetFieldValue(&quot;Id&quot;);
					sOrderItemId = GetFieldValue(&quot;Root Order Item Id&quot;);
					sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
					
					with(oOrderItemBC)
					{
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;Parent Order Item Id&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
						ActivateField(&quot;VHA MSISDN Calc&quot;);
						ClearToQuery();						
						SetSearchExpr(&quot;[Parent Order Item Id] IS NULL AND [Order Header Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sOrderItemId +&quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sMSISDN = GetFieldValue(&quot;VHA MSISDN Calc&quot;);

						}
					}

					if(sOrderItemId != &quot;&quot; &amp;&amp; sOrderItemId != null)
					{
						if(sLineId != &quot;&quot; &amp;&amp; sLineId != null)
						{							
							 sContractAmt = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Contract Amount&apos; AND [Object Id]  = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 sPrepayAmt = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Prepayment Amount&apos; AND [Object Id] = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 sCategory = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Category&apos; AND [Object Id] = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 
							 if(sCategory != &quot;&quot; &amp;&amp; sCategory != null &amp;&amp; sCategory == &quot;Secondary Device&quot;)
							 {
								 sItemCode = sSecDeviceCode;
								 sItemName = sSecDeviceName;
							 }
							 else
							 {
								 sItemCode = &quot;&quot;;
								 sItemName = &quot;&quot;;
							 }				
						}						
						
						if(ToNumber(sPrepayAmt &gt; 0))//Added for 19.3 - SureshG
						{
						with(oContractBC)
						{
							ActivateField(&quot;Device Accessory Code&quot;);
							ActivateField(&quot;Device Accessory Name&quot;);
							ActivateField(&quot;Service Order Id&quot;);
							ActivateField(&quot;Asset Integeration Id&quot;);
							ActivateField(&quot;Prepayment Id&quot;);
							ActivateField(&quot;Prepayment Amount&quot;);
							ActivateField(&quot;Contract Amount&quot;);
							ActivateField(&quot;MPP APP Contract&quot;);
							ActivateField(&quot;Billing Account Id&quot;);
							ActivateField(&quot;Line Id&quot;);
							ActivateField(&quot;MSISDN&quot;);
							ClearToQuery();
							SetViewMode(AllView);							
							SetSearchExpr(&quot;[Line Id] = &apos;&quot; + sLineId + &quot;&apos; AND [MPP APP Contract] &lt;&gt; &apos;&quot;+sGPPContract+&quot;&apos;&quot; );
							ExecuteQuery(ForwardOnly);
							if(!FirstRecord())
							{	
								NewRecord(NewAfter);
								SetFieldValue(&quot;Prepayment Id&quot;, sPrepayId);
								SetFieldValue(&quot;Service Order Id&quot;, sOrderItemId);										
								SetFieldValue(&quot;Asset Integeration Id&quot;, sAssetIntegId);
								SetFieldValue(&quot;Device Accessory Name&quot;, sItemName);
								SetFieldValue(&quot;Device Accessory Code&quot;, sItemCode);
								SetFieldValue(&quot;Prepayment Amount&quot;, sPrepayAmt);
								SetFieldValue(&quot;Contract Amount&quot;, sContractAmt);
								SetFieldValue(&quot;Billing Account Id&quot;, sBAId);
								SetFieldValue(&quot;MSISDN&quot;, sMSISDN);						
								SetFieldValue(&quot;MPP APP Contract&quot;, sAPPContract);								
								WriteRecord();
							}
						}
						}
						
					}
					sRecExist = NextRecord();
				}
			}
		}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oContractBC = null;				
		oOrderItemBC  = null;
		oLineItemBC = null;
		oPrepayBC = null;
		oAccessoryBC = null;
		oBO = null;
	}
}"
			   SEQUENCE="25"
			   UPDATED="01/04/2020 00:15:09"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdCred"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdCred(Inputs,Outputs)
{
/*
 * Component Name        : 	VHA Prepayments BS
 * Function Name         : 	mUpdCred
 * Component Information : 	To insert credit card record in BC: VHA Prepayment Credit Card Details
 * Inputs				 : 	Order Id, Billing Account Id
 * Outputs				 :  
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/06/2019	Veera					Initial Version
 */
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sBAId = Inputs.GetProperty(&quot;Billing Account Id&quot;);
		var sPrepayId = &quot;&quot;;
		var sTransRef = &quot;&quot;;
		var sPreRespCode = &quot;&quot;;
		var ProcDt = &quot;&quot;;
		var PrepAmt = 0;
		var sCardName = &quot;&quot;;
		var ExpDt = &quot;&quot;;
		var sTokenNum = &quot;&quot;;
		var sRecExist = &quot;&quot;;
		var sExpDtMonth = &quot;&quot;;
		var sLast4 = &quot;&quot;;//BalajiM - Miami 07/04/2022
		var sFirst6 = &quot;&quot;;//BalajiM - Miami 07/04/2022
		var sPending = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;Payment Pending&quot;);
		var sNew = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;New&quot;);
		var sExpDtYear = &quot;&quot;, sFormattedYear = &quot;&quot;, sBrandType = &quot;&quot;, searchst = &quot;&quot;, isFirRec = &quot;&quot;;
		
		var sOrdBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sPrepayBC = sOrdBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sCredBC = sOrdBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
		with(sPrepayBC)
		{
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;Transaction Reference Number&quot;);
			ActivateField(&quot;Prepayment Response Code&quot;);
			ActivateField(&quot;PP Processed Date&quot;);
			ActivateField(&quot;PP Amount Paid Upfront&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				sPrepayId = GetFieldValue(&quot;Id&quot;);
				sTransRef = GetFieldValue(&quot;Transaction Reference Number&quot;);
				sPreRespCode = GetFieldValue(&quot;Prepayment Response Code&quot;);
				ProcDt = GetFieldValue(&quot;PP Processed Date&quot;);
				PrepAmt = GetFieldValue(&quot;PP Amount Paid Upfront&quot;);
			}
		} //end with sPrepayBC
		
	/*	with(sCredBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Prepayment Record Id&quot;, sPrepayId);
			ExecuteQuery(ForwardOnly);
			sRecExist = FirstRecord();
			while(sRecExist)
			{
				DeleteRecord();
				sRecExist = FirstRecord();
			}
		}*/		

		var sBO = TheApplication().GetBusObject(&quot;VF Com Invoice Profile&quot;);
		var sBPBC = sBO.GetBusComp(&quot;Com Invoice Profile&quot;);
			
		with(sBPBC)
		{
			ActivateField(&quot;Account Id&quot;);
			ActivateField(&quot;Credit Card Name&quot;);
			ActivateField(&quot;CC Number Token Not Enc&quot;);
			ActivateField(&quot;Expiration Month&quot;);
			ActivateField(&quot;Expiration Year&quot;);
			ActivateField(&quot;Credit Card Type&quot;);
			ActivateField(&quot;Credit Card Last 4&quot;);//BalajiM - Miami 07/04/2022
			ActivateField(&quot;Credit Card First 6&quot;);//BalajiM - Miami 07/04/2022
			ClearToQuery();
			SetSearchExpr(&quot;[Account Id] = &apos;&quot;+sBAId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			var sIsRecord = FirstRecord();
			if(sIsRecord)
			{
				sCardName = GetFieldValue(&quot;Credit Card Name&quot;);
				sTokenNum = GetFieldValue(&quot;CC Number Token Not Enc&quot;);
				sExpDtMonth = GetFieldValue(&quot;Expiration Month&quot;);
				sExpDtYear = GetFieldValue(&quot;Expiration Year&quot;);
				sBrandType = GetFieldValue(&quot;Credit Card Type&quot;);
				sLast4 = GetFieldValue(&quot;Credit Card Last 4&quot;);//BalajiM - Miami 07/04/2022
				sFirst6 = GetFieldValue(&quot;Credit Card First 6&quot;);//BalajiM - Miami 07/04/2022
			
				if((sExpDtMonth != &quot;&quot; &amp;&amp; sExpDtMonth != null) &amp;&amp; (sExpDtYear != &quot;&quot; &amp;&amp; sExpDtYear != null))
				{
					sFormattedYear = ToNumber(sExpDtYear.substring(2,4));
					ExpDt = sExpDtMonth+&quot;/&quot;+sFormattedYear;
				}
			}
		} //end with BC sBPBC
		
		//var sCredBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		
		
		with(sPrepayBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sPrepayId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{								
				with(sCredBC)
				{
					ActivateField(&quot;Prepayment Record Id&quot;);
					ActivateField(&quot;Credit Card Token Number&quot;);
					ActivateField(&quot;Brand Type&quot;);
					ActivateField(&quot;Expiry Date&quot;);
					ActivateField(&quot;Billing Account Id&quot;);
					ActivateField(&quot;Card Holder Name&quot;);
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;PP Processed Date&quot;);
					ActivateField(&quot;Prepayment Amount&quot;);
					ActivateField(&quot;Transaction Reference Number&quot;);
					ActivateField(&quot;Prepayment Response Code&quot;);
					ActivateField(&quot;Credit Card First 6&quot;);//BalajiM - Miami 07/04/2022
					ActivateField(&quot;Credit Card Last 4&quot;);//BalajiM - Miami 07/04/2022
					ActivateField(&quot;Device Data&quot;);//BalajiM - Miami 07/04/2022
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Prepayment Record Id&quot;, sPrepayId);
					SetSearchSpec(&quot;Credit Card Token Number&quot;, sTokenNum);
					SetSearchSpec(&quot;Billing Account Id&quot;, sBAId);
					ExecuteQuery(ForwardOnly);
					if(!FirstRecord())
					{
						if((sTokenNum != null &amp;&amp; sTokenNum != &quot;&quot;))
						{
							NewRecord(NewAfter);
							SetFieldValue(&quot;Prepayment Record Id&quot;, sPrepayId);
							SetFieldValue(&quot;Credit Card Token Number&quot;, sTokenNum);
							SetFieldValue(&quot;Expiry Date&quot;, ExpDt);
							SetFieldValue(&quot;Brand Type&quot;, sBrandType);
							SetFieldValue(&quot;Billing Account Id&quot;, sBAId);
							SetFieldValue(&quot;Card Holder Name&quot;, sCardName);
							SetFieldValue(&quot;Order Id&quot;, sOrderId);
							SetFieldValue(&quot;PP Processed Date&quot;, ProcDt);
							SetFieldValue(&quot;Prepayment Amount&quot;, PrepAmt);
							SetFieldValue(&quot;Prepayment Response Code&quot;, sPreRespCode);
							SetFieldValue(&quot;Transaction Reference Number&quot;, sTransRef);
							SetFieldValue(&quot;Credit Card First 6&quot;, sFirst6);//BalajiM - Miami 07/04/2022
							SetFieldValue(&quot;Credit Card Last 4&quot;, sLast4);//BalajiM - Miami 07/04/2022
							SetFieldValue(&quot;Device Data&quot;, TheApplication().GetProfileAttr(&quot;BTDeviceData&quot;));//BalajiM - Miami 07/04/2022
							WriteRecord();
						}						
					}
				} //end with sCredBC
				with(sCredBC)
				{
					InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;);
					ActivateField(&quot;Surcharge Percentage&quot;);
					ActivateField(&quot;Prepayment Amount&quot;);
					ActivateField(&quot;Payment Status&quot;);
					ActivateField(&quot;Surcharge Waive Reason&quot;);
					ActivateField(&quot;Prepayment Record Id&quot;);
					ActivateField(&quot;Billing Account Id&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					searchst = &quot;[Prepayment Record Id] =  &apos;&quot;+sPrepayId+&quot;&apos; AND ([Payment Status] = &apos;&quot;+sPending+&quot;&apos; OR [Payment Status] = &apos;&quot;+sNew+&quot;&apos;) AND [Billing Account Id] = &apos;&quot;+sBAId+&quot;&apos;&quot;;
					SetSearchExpr(searchst);
					ExecuteQuery(ForwardOnly);		
					isFirRec = FirstRecord();	
					while(isFirRec)
					{									
						SetFieldValue(&quot;Prepayment Amount&quot;, PrepAmt);
						SetFieldValue(&quot;Payment Status&quot;, &quot;New&quot;);
						SetFieldValue(&quot;Surcharge Waive Reason&quot;, &quot;&quot;);						
						SetFieldValue(&quot;Surcharge Percentage&quot;, &quot;&quot;);
						WriteRecord();
						isFirRec = NextRecord();
					}	
				}
			} //if sPrepayBC FS
		} //end with sPrepaybc	
	} //end try
	catch(e)
	{
		throw(e);
	}
	finally
	{	
		sPrepayBC = null;
		sBPBC = null;	
		sCredBC = null;
		//sCredBO = null;
		sBO = null;
		sOrdBO = null;
	}
}"
			   SEQUENCE="28"
			   UPDATED="07/19/2022 00:34:59"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdGPPContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdGPPContract(Inputs, Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oLineItemBC = oBO.GetBusComp(&quot;VF Order Line Items - Thin&quot;);
		var oPrepayBC = oBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var oContractBC = oBO.GetBusComp(&quot;VHA Prepayment Contract Summary&quot;);
		var oOrderItemBC = oBO.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
		var sAttribBC = oBO.GetBusComp(&quot;Order Item XA&quot;);
		var sAction = &quot;Add&quot;;
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sBAId = Inputs.GetProperty(&quot;Billing Account Id&quot;);
		var sPrepayId = Inputs.GetProperty(&quot;Prepayment Id&quot;);
		var sGPPContract = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_GPP_DEVICE_CONTRACT&quot;,&quot;GPP Device Contract&quot;);
		var sOrderItemId = &quot;&quot;, sRecExist = &quot;&quot;, sLineRecExist = &quot;&quot;, sLineId = &quot;&quot;, sProductType = &quot;&quot;, sAssetIntegId = &quot;&quot;, sMSISDN = &quot;&quot;;
		var sContractAmt = &quot;&quot;, sPrepayAmt = &quot;&quot;, sItemCode = &quot;&quot;, sItemName = &quot;&quot;;
		
		if((sOrderId != &quot;&quot; &amp;&amp; sOrderId != null) &amp;&amp; (sBAId != &quot;&quot; &amp;&amp; sBAId != null) &amp;&amp; (sPrepayId != &quot;&quot; &amp;&amp; sPrepayId != null))
		{
		
			with(oPrepayBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sPrepayId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{					
					with(oContractBC)
					{
						ActivateField(&quot;Prepayment Id&quot;);
						ActivateField(&quot;MPP APP Contract&quot;);
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Prepayment Id&quot;, sPrepayId);									
					//	SetSearchSpec(&quot;MPP APP Contract&quot;, &quot;GPP Contract&quot;);
						SetSearchSpec(&quot;MPP APP Contract&quot;, sGPPContract);
						ExecuteQuery();
						sLineRecExist = FirstRecord();
						while(sLineRecExist)
						{
							DeleteRecord();
							sLineRecExist = FirstRecord();
						}
					}					
				}
			}
			
			with(oLineItemBC)
			{            
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Siebel Product Type&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ActivateField(&quot;Asset Integration Id&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;([Product Type] = &apos;Billing - GPP&apos; AND [Siebel Product Type] = &apos;Device&apos;) AND [Order Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Action Code] = &apos;&quot;+ sAction +&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				sRecExist = FirstRecord();
				while(sRecExist)
				{
					sLineId = GetFieldValue(&quot;Id&quot;);
					sOrderItemId = GetFieldValue(&quot;Root Order Item Id&quot;);
					sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
					
					with(oOrderItemBC)
					{
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;Parent Order Item Id&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
						ActivateField(&quot;VHA MSISDN Calc&quot;);
						ClearToQuery();						
						SetSearchExpr(&quot;[Parent Order Item Id] IS NULL AND [Order Header Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sOrderItemId +&quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sMSISDN = GetFieldValue(&quot;VHA MSISDN Calc&quot;); 
						}
					}

					if(sOrderItemId != &quot;&quot; &amp;&amp; sOrderItemId != null)
					{

						if(sLineId != &quot;&quot; &amp;&amp; sLineId != null)
						{						
							
							 sContractAmt = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Contract Amount&apos; AND [Object Id]  = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 sPrepayAmt = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Prepayment Amount&apos; AND [Object Id] = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 sItemCode = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Item Code&apos; AND [Object Id] = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							 sItemName = mGetOrderItemAttr(oBO ,&quot;[Name]=&apos;Item Name&apos; AND [Object Id] = &apos;&quot; + sLineId + &quot;&apos;&quot;);
							
						}					
						if(ToNumber(sPrepayAmt &gt; 0))//Added for 19.3 - SureshG
						{
						with(oContractBC)
						{
							ActivateField(&quot;Device Accessory Code&quot;);
							ActivateField(&quot;Device Accessory Name&quot;);
							ActivateField(&quot;Service Order Id&quot;);
							ActivateField(&quot;Asset Integeration Id&quot;);
							ActivateField(&quot;Prepayment Id&quot;);
							ActivateField(&quot;Prepayment Amount&quot;);
							ActivateField(&quot;Contract Amount&quot;);
							ActivateField(&quot;MPP APP Contract&quot;);
							ActivateField(&quot;Billing Account Id&quot;);
							ActivateField(&quot;MSISDN&quot;);
							ClearToQuery();
							SetViewMode(AllView);
							SetSearchSpec(&quot;Service Order Id&quot;, sOrderItemId);
//							SetSearchSpec(&quot;Type&quot;, &quot;GPP Contract&quot;);
							SetSearchSpec(&quot;Type&quot;, sGPPContract);
							ExecuteQuery(ForwardOnly);
							if(!FirstRecord())
							{	
								NewRecord(NewAfter);
								SetFieldValue(&quot;Prepayment Id&quot;, sPrepayId);
								SetFieldValue(&quot;Service Order Id&quot;, sOrderItemId);
								if(sAssetIntegId == &quot;&quot; || sAssetIntegId == null)
								sAssetIntegId = sLineId;										
								SetFieldValue(&quot;Asset Integeration Id&quot;, sAssetIntegId);
								SetFieldValue(&quot;Device Accessory Name&quot;, sItemName);
								SetFieldValue(&quot;Device Accessory Code&quot;, sItemCode);
								SetFieldValue(&quot;Prepayment Amount&quot;, sPrepayAmt);
								SetFieldValue(&quot;Contract Amount&quot;, sContractAmt);
								SetFieldValue(&quot;Billing Account Id&quot;, sBAId);
								SetFieldValue(&quot;MSISDN&quot;, sMSISDN);						
							//	SetFieldValue(&quot;MPP APP Contract&quot;, &quot;GPP Contract&quot;);								
								SetFieldValue(&quot;MPP APP Contract&quot;, sGPPContract);								
								WriteRecord();
							}
						}
						
						}	
							
					}					
					sRecExist = NextRecord();
				}
					
			
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oContractBC = null;
		oOrderItemBC  = null;
		oLineItemBC = null;
		oPrepayBC = null;
		oBO = null;
	}	
}"
