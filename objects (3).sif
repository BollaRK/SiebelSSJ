			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpgradeAPPAttrUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpgradeAPPAttrUpdate(Inputs,Outputs)
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sOrderBO = TheApplication().GetBusObject(&quot;VHA Order Entry Orders Thin BO&quot;);
		var sOrderItemBC = sOrderBO.GetBusComp(&quot;VHA Order Entry Line Items Query Thin&quot;);
		var sOrderItemXABC = sOrderBO.GetBusComp(&quot;VF Order Item XA&quot;);
		var sAdditionalInfoAttr = &quot;&quot;;
		var sAPPContract = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP&quot;);
		var sAttribName = &quot;Additional Info&quot;;
		sOrderItemBC.ClearToQuery();
		sOrderItemXABC.ClearToQuery();
		sOrderItemXABC.ActivateField(&quot;Text Value&quot;);
		sOrderItemBC.SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Action Code] = &apos;Delete&apos; AND [Product] = &apos;&quot;+sAPPContract+&quot;&apos;&quot;);
		sOrderItemXABC.SetSearchExpr(&quot;[Name] = &apos;&quot; + sAttribName + &quot;&apos;&quot;);
		sOrderItemBC.ExecuteQuery(ForwardOnly);
		sOrderItemXABC.ExecuteQuery(ForwardOnly);
		if(sOrderItemBC.FirstRecord() &amp;&amp; sOrderItemXABC.FirstRecord())
		{
			sAdditionalInfoAttr = sOrderItemXABC.GetFieldValue(&quot;Text Value&quot;);
		}
		
		sOrderItemBC.ClearToQuery();
		sOrderItemXABC.ClearToQuery();
		sOrderItemXABC.ActivateField(&quot;Text Value&quot;);
		sOrderItemBC.SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Action Code] = &apos;Add&apos; AND [Product] = &apos;&quot;+sAPPContract+&quot;&apos;&quot;);
		sOrderItemXABC.SetSearchExpr(&quot;[Name] = &apos;&quot; + sAttribName + &quot;&apos;&quot;);
		sOrderItemBC.ExecuteQuery(ForwardOnly);
		sOrderItemXABC.ExecuteQuery(ForwardOnly);
		if(sOrderItemBC.FirstRecord() &amp;&amp; sOrderItemXABC.FirstRecord())
		{
			sOrderItemXABC.SetFieldValue(&quot;Text Value&quot;,sAdditionalInfoAttr);
			sOrderItemXABC.WriteRecord();
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderItemXABC = null;
		sOrderItemBC = null;
		sOrderBO = null;
	}
}"
			   SEQUENCE="31"
