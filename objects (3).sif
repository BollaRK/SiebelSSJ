			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateLineItem(Inputs, Outputs)
{
try{
	//var sOrderItemId = &quot;&quot;;
	var ERR = &quot;9033&quot;;
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
	var sFBB_MBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;);
//	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
	var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;); //Roseline:11/07/2017 - Changed to thin BO 
	var sLineItemBC = boOrder.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;); 
	var boVFIMEIList = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
	var bcVFIMEIList = boVFIMEIList.GetBusComp(&quot;VF IMEI List&quot;);
	var searchspec = &quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Parent Order Item Id] IS NULL AND ([Siebel Product Type] = &apos;&quot;+sFBBOnly+&quot;&apos; OR [Siebel Product Type] = &apos;&quot;+sFBB_MBB+&quot;&apos;)&quot;;
	var count = 0, sIMEIFlg = &apos;Y&apos;, sIMEI=&quot;&quot;;
	Outputs.SetProperty(&quot;ServiceOrderType&quot;,&quot;&quot;);
	Outputs.SetProperty(&quot;ActionCode&quot;,&quot;&quot;);
	with(sLineItemBC)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;Siebel Product Type&quot;);
			ActivateField(&quot;Action Code&quot;);
			ActivateField(&quot;VF Service Order Sub Type&quot;);
			ActivateField(&quot;VF IMEI TBUI&quot;);
			ActivateField(&quot;VF Handset Code TBUI&quot;);
			ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			ClearToQuery();			
			SetSearchExpr(searchspec);
			ExecuteQuery(ForwardOnly);
			var iRec = FirstRecord();
			while (iRec)
			{
				count++;
				sOrderItemId = GetFieldValue(&quot;Id&quot;);
				Outputs.SetProperty(&quot;ActionCode&quot;,GetFieldValue(&quot;Action Code&quot;));
				Outputs.SetProperty(&quot;ServiceOrderType&quot;,GetFieldValue(&quot;VF Service Order Sub Type&quot;));
				if(GetFieldValue(&quot;VF Stock Indicator TBUI&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;In Stock&quot;))
				{
					sIMEI=GetFieldValue(&quot;VF IMEI TBUI&quot;);
					if(GetFieldValue(&quot;VF Handset Code TBUI&quot;) ==&quot;&quot; &amp;&amp; sIMEI !=&quot;&quot;)
					{
						with(bcVFIMEIList)
						{
							SetViewMode(AllView)
							ClearToQuery();
							SetSearchSpec(&quot;IMEI&quot;, sIMEI);
							ExecuteQuery(ForwardOnly);	
							if (!FirstRecord())
							{
							var sIMEIProf = sIMEI+sOrderItemId;
							if(TheApplication().GetProfileAttr(sIMEIProf)!=&apos;Y&apos;)
							{
								sIMEIFlg =&apos;N&apos;;
								TheApplication().SetProfileAttr(sIMEIProf,&quot;Y&quot;);
							}
							}
						}
					}							
				}
				iRec = NextRecord();
			}
		}
		/*if (count &gt; 1)
		{
		TheApplication().RaiseErrorText(&quot;Select only one FBB Propostion&quot;);
		}*/
		if (count &lt; 1)
		{
			//TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR));
			TheApplication().RaiseErrorText(&quot;VFErrorCode#9033&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR));
		}
		Outputs.SetProperty(&quot;IMEIValidFlg&quot;, sIMEIFlg);
		Outputs.SetProperty(&quot;OrderItemId&quot;,sOrderItemId);
		
	}
	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcVFIMEIList = null;/*This variable is nullified by GURUPRASAD on 29/10/2019*/
		boVFIMEIList = null;/*This variable is nullified by GURUPRASAD on 29/10/2019*/
		sLineItemBC = null;
		boOrder = null;
	}
	return (ContinueOperation);	
}"
