			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateKoganIdDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateKoganIdDetails(Inputs, Outputs)
{
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;VF Contact Id&quot;);
		var sBC = sBO.GetBusComp(&quot;VF Contact Id&quot;);
		var sContactId = Inputs.GetProperty(&quot;ContactId&quot;);
		var dToday = new Date();
		Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;&quot;);
		
		if(sContactId != &quot;&quot;)
		{
			with(sBC)
			{
				
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;DVS Transaction Id&quot;);
				ActivateField(&quot;Expiry Date&quot;);
				//var SerachExpr = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos; AND [DVS Transaction Id] IS NOT NULL&quot;;
				var SerachExpr = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos;&quot;;
				SetSearchExpr(SerachExpr);
				ExecuteQuery(ForwardOnly);
				if(!FirstRecord())
				{
					//TheApplication().RaiseErrorText(&quot;You should add Identification Details to proceed further.&quot;);
					Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;You should add Identification Details to proceed further.&quot;);
				}
				else
				{
					var sExpiryDate  = GetFieldValue(&quot;Expiry Date&quot;);
					var dtExpDt = new Date(sExpiryDate);
					if(dToday &gt;= dtExpDt)
					{
						Outputs.SetProperty(&quot;ErrMsg&quot;,&quot;Expiry Date must be greater than today.&quot;);
					}
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
			   SEQUENCE="42"
			   UPDATED="04/22/2026 01:45:57"
