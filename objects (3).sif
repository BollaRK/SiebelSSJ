			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDOM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetDOM(input, output)//VHA Muthushankari 9/9/2017 - Added for R17.4B Freedom CIR
{
	try
	{
		var iClibTime = Clib.time();
		var dtToday = Date.fromSystem(iClibTime);
		var intToday = dtToday.getDate();
		var sBillSegment = input.GetProperty(&quot;Bill Segment&quot;);
		var sRespExists = input.GetProperty(&quot;Resp Exists&quot;);
		var blnRecordExists = false;
		var blnRecordFound = false;
		var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
		bcLOV.ActivateField(&quot;Parent&quot;);
		bcLOV.ActivateField(&quot;Value&quot;);
		bcLOV.SetSearchSpec(&quot;Type&quot;, &quot;BILL_CYCLE&quot;);
		bcLOV.SetSearchSpec(&quot;Parent&quot;, sBillSegment);
		if(sRespExists == &quot;N&quot;)
			bcLOV.SetSearchSpec(&quot;High&quot;, &quot;Open&quot;);
		bcLOV.SetSearchSpec(&quot;Active&quot;,&quot;Y&quot;);
		bcLOV.SetSortSpec(&quot;Name(ASCENDING)&quot;);
		bcLOV.ExecuteQuery(ForwardBackward);
		blnRecordExists = bcLOV.FirstRecord();
		
		if (!blnRecordExists)
			throw(&quot;There are no available DOMs please contact your administrator&quot;);

		while (blnRecordExists &amp;&amp; blnRecordFound == false)
		{
			if (ToInteger(bcLOV.GetFieldValue(&quot;Value&quot;)) &gt; intToday)
				blnRecordFound = true;
			else
				blnRecordExists = bcLOV.NextRecord();
		}
		
		if (blnRecordFound == false)
		{
			bcLOV.FirstRecord();
			if (ToInteger(bcLOV.GetFieldValue(&quot;Value&quot;)) &lt;= intToday)
				blnRecordFound = true;
		}
		
		if (blnRecordFound)
		{
			output.SetProperty(&quot;DOM&quot;, bcLOV.GetFieldValue(&quot;Value&quot;));
		}
		else
			throw(&quot;There are no available DOMs please contact your administrator&quot;);	
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{
		bcLOV = null;
		boLOV = null;
	}
}"
			   SEQUENCE="26"
			   UPDATED="02/13/2025 09:04:47"
			   UPDATED_BY="SADMIN"
			   CREATED="11/25/2017 13:22:17"
