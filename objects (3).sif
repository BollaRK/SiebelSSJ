			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckCreditClass"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckCreditClass(Inputs,Outputs)
{

	try 
	{
		var sCreditClass;
		var sAppleVcherCClassLOV;
		var CustAccountId = Inputs.GetProperty(&quot;CustId&quot;); 
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF TBUI Utilities.mCheckCreditClass &quot; + CustAccountId);
		}
		var boFinanProf = TheApplication().GetBusObject(&quot;Account&quot;);
		var bcFinanProf = boFinanProf.GetBusComp(&quot;VF Com Financial Profile&quot;);
		with(bcFinanProf) 
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Account Id&quot;);
			ActivateField(&quot;VF Credit Class&quot;);	
			SetSearchSpec(&quot;Account Id&quot;, CustAccountId);
			ExecuteQuery(ForwardOnly);
    		if(FirstRecord()) 
			{
				sCreditClass = GetFieldValue(&quot;VF Credit Class&quot;);
				sAppleVcherCClassLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FRAUD_CREDIT_CLS_CHK&quot;,sCreditClass);
				
	    	} 
			if(sAppleVcherCClassLOV == &quot;Y&quot;)
					Outputs.SetProperty(&quot;AppleVcherVal&quot;,&quot;FraudCClass&quot;);
	    }
	    

	} 
	catch (e) 
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF TBUI Utilities.mCheckCreditClass &quot; + e.toString());
		}
		throw (e);
		
	} finally 
	{
		sCreditClass = null;
		sAppleVcherCClassLOV = null;
		bcFinanProf = null;
		boFinanProf = null;
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF TBUI Utilities.mCheckCreditClass &quot; + CustAccountId);
		}
		
	}
}"
