		TotalCost = ToNumber(RatePlanMaxPriceGST)+ToNumber(sGPPMonthlyRepayment)+ToNumber(sAPPMonthlyRepayment)+ToNumber(AddOnMaxPriceGST)+ToNumber(CreditMaxPriceGST)-ToNumber(sRDAmount)-ToNumber(sDiscountTen)-ToNumber(sDiscountFive)-ToNumber(sOverAmount)-ToNumber(sPegaAmount)+ToNumber(LDMaxPriceGST)-ToNumber(MSPMaxPriceGST);
		TotalCost = TruncateAmount(TotalCost);
		var strTotalCost = TotalCost.toString();
		if (strTotalCost.indexOf(&quot;.&quot;)==-1)
		{
			strTotalCost =&quot;$&quot;+strTotalCost+&quot;.00&quot;
		}
		else
		{
			//strTotalCost =&quot;$&quot;+strTotalCost+&quot;00&quot;;
