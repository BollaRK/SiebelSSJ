			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetDiscPrice"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnGetDiscPrice(Inputs,Outputs)
{
	try
	{
		var sPriBO = TheApplication().GetBusObject(&quot;Price List&quot;);
		var sPriBC = sPriBO.GetBusComp(&quot;Price List&quot;);
		var sPriItemBC = sPriBO.GetBusComp(&quot;Price List Item&quot;);
		var MaxPri = &quot;&quot;;
		var sPriLstId = Inputs.GetProperty(&quot;PriceListId&quot;);
		var sProdId = Inputs.GetProperty(&quot;ProdId&quot;);
		//TheApplication().SetProfileAttr(&quot;PRDID&quot;,sProdId);
		with(sPriBC)
		{
			ClearToQuery();
			SetViewMode(AllView);

			if(sPriLstId != null &amp;&amp; sPriLstId != &quot;&quot;)
				SetSearchSpec(&quot;Id&quot;, sPriLstId);
			else 
				SetSearchSpec(&quot;Name&quot;, &quot;Vodafone AU Price List&quot;);

			ExecuteQuery(ForwardOnly)			
			if (FirstRecord())
			{
				with(sPriItemBC)
				{
					ActivateField(&quot;Max Sale Price&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Product Id&quot;, sProdId);
					ExecuteQuery(ForwardOnly)			
					if (FirstRecord())
					{
						MaxPri = Math.abs(GetFieldValue(&quot;Max Sale Price&quot;));
					}
				}//with item
			}//if rec
		}//with price
		Outputs.SetProperty(&quot;DiscPrice&quot;,MaxPri);
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sPriItemBC = null;
		sPriBC = null;
		sPriBO  = null;
	}
}
"
