			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSelectService"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSelectService(Inputs, Outputs)
{
try{
	var ERR_ONEFBB = &quot;9023&quot;;
	var ERR_NTD = &quot;9024&quot;;
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	var boOrder2 = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
	var bcSQService = boOrder.GetBusComp(&quot;VHA Site Qualification Service List&quot;); 
	var bcSQbc = boOrder2.GetBusComp(&quot;VHA Site Qualification BC&quot;);
	var SQRowId = Inputs.GetProperty(&quot;SQRowId&quot;);
	var TransferType = Inputs.GetProperty(&quot;TransferType&quot;);
	var NewNTD = Inputs.GetProperty(&quot;NewNTD&quot;);
	//Roseline:22/04/2017 - Added for PIPE SIT Defect# 115
	var sAccessTechnology = Inputs.GetProperty(&quot;AccessTechnology&quot;); 
	var sFTTN = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Node&quot;);
	var sFTTB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_ACCESS_TECHNOLOGY&quot;,&quot;Fibre To The Building&quot;);
	//end 
		with(bcSQService) 
		{ 
			var searchspec = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos; AND [Select] = &apos;Y&apos;&quot;; 
			SetViewMode(AllView); 
			ClearToQuery(); 
			SetSearchExpr(searchspec); 
			ExecuteQuery(ForwardOnly); 
			var iRec = FirstRecord(); 
			if(!FirstRecord()) 
			{ 
				if(!(TransferType == &quot;New&quot; &amp;&amp; NewNTD == &quot;Y&quot;))
			//	TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_ONEFBB));
				TheApplication().RaiseErrorText(&quot;VFErrorCode#9023&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_ONEFBB));
			}
			//Roseline:22/04/2017 - Added for PIPE SIT Defect# 115 - Added if condition to skip this validation for FTTN and FTTB
			if(sAccessTechnology != sFTTN &amp;&amp; sAccessTechnology != sFTTB)
			{
				var searchspec1 = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos;&quot;; 
				var searchspec2 = &quot;[Parent Activity Id] = &apos;&quot; + SQRowId + &quot;&apos; AND ([Status] &lt;&gt; &apos;Used&apos;)&quot;; 
				SetViewMode(AllView); 
				ClearToQuery(); 
				SetSearchExpr(searchspec1); 
				ExecuteQuery(ForwardOnly); 
				var count = CountRecords();	
				if(count &gt;= 1)
				{ 
					SetViewMode(AllView); 
					ClearToQuery(); 
					SetSearchExpr(searchspec2); 
					ExecuteQuery(ForwardOnly); 
					var iRec = FirstRecord(); 
					if(!FirstRecord()) 				
						if(NewNTD != &quot;Y&quot;)
					//	TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_NTD));
					TheApplication().RaiseErrorText(&quot;VFErrorCode#9024&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_NTD));
				}
			}//if sAccessTechnology
		} 
		
	
	} 

	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcSQbc = null;/*This variable is nullified by GURUPRASAD on 29/10/2019*/
	 	bcSQService = null;
		boOrder2 = null;/*This variable is nullified by GURUPRASAD on 29/10/2019*/
		boOrder = null;
	}
	
	return (ContinueOperation);		
}"
			   SEQUENCE="4"
			   UPDATED="11/06/2019 14:56:25"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:45:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTransferOption"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTransferOption(Inputs, Outputs)
{
try{
	var ERR_EXTFBB = &quot;9025&quot;;
	var sParentActId = Inputs.GetProperty(&quot;SQRowId&quot;);
	var sTransferType = Inputs.GetProperty(&quot;TransferType&quot;);
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;); 	
	var bcSQService = boOrder.GetBusComp(&quot;VHA Site Qualification Service List&quot;); 
	//var searchspec1 = &quot;[Parent Activity Id] = &apos;&quot;+sParentActId+&quot;&apos; AND ([Status] = &apos;Active&apos; OR [Status] = &apos;Used&apos;) AND [Select] = &apos;Y&apos;&quot;;
	var searchspec2 = &quot;[Id] = &apos;&quot;+sParentActId+&quot;&apos; AND [Discussed Transfer Option] = &apos;Y&apos;&quot;;
	if(sTransferType == &quot;New&quot;)
	{
		var searchspec3 = &quot;[Parent Activity Id] = &apos;&quot;+sParentActId+&quot;&apos; AND ((([Status] = &apos;Free&apos; OR [Status] = &apos;Line Not In Use&apos;) AND [Select] = &apos;Y&apos;) OR ([Select] = &apos;N&apos;))&quot;;
	}
	else
	{
		var searchspec3 = &quot;[Parent Activity Id] = &apos;&quot;+sParentActId+&quot;&apos; AND ((([Status] = &apos;Free&apos; OR [Status] = &apos;Line Not In Use&apos;) AND [Select] = &apos;Y&apos;))&quot;;
	}
	
	var searchspec4 = &quot;[Parent Activity Id] = &apos;&quot;+sParentActId+&quot;&apos; AND ([Status] = &apos;Used&apos; OR [Status] = &apos;Line In Use&apos;) AND [Select] = &apos;N&apos;&quot;;
	var iRec = &quot;N&quot;;

	var boOrder1 = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);   
	var SQServiceBC = boOrder1.GetBusComp(&quot;VHA Site Qualification BC&quot;);

	with(bcSQService)
	{
		SetViewMode(AllView);
		ClearToQuery();			
		SetSearchExpr(searchspec3);
		ExecuteQuery(ForwardOnly);
		if (FirstRecord())
		{
			SetViewMode(AllView);
			ClearToQuery();			
			SetSearchExpr(searchspec4);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				with(SQServiceBC)
				{
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchExpr(searchspec2);
					ExecuteQuery(ForwardOnly);
					if(!FirstRecord())
						//TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_EXTFBB));
						TheApplication().RaiseErrorText(&quot;VFErrorCode#9025&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERR_EXTFBB));
				}
			}
			
			
		}
	}
	return (ContinueOperation);	
	}
	catch(e)
	{
		throw (e);
	}
	finally 
	{
		bcSQService = null;
		SQServiceBC = null;
		boOrder = null;
		boOrder1 = null;
	}

}"
			   SEQUENCE="5"
			   UPDATED="08/06/2017 23:45:16"
			   UPDATED_BY="SADMIN"
			   CREATED="08/06/2017 23:45:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
