			   SEQUENCE="14"
			   UPDATED="04/25/2026 15:45:10"
			   UPDATED_BY="SOUMALYAM"
			   CREATED="04/09/2026 00:32:13"
			   CREATED_BY="MONISHAJ">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateConsumerProp"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateConsumerProp(Inputs, Outputs) 
{
    var ChildOrderId = &quot;&quot;, bcOrder = null,sErrMsg=&quot;&quot;, QuoteId = &quot;&quot;, bcProd = null, sSAMId = &quot;&quot;, sBusiness = &quot;&quot;, bcDFAName = null, oMvgBC = null,
	Frecord = null,sConsumer=&quot;&quot;,sSegment =&quot;&quot;;
    try 
	{
		
        QuoteId = Inputs.GetProperty(&quot;OrderId&quot;);
		sSegment = Inputs.GetProperty(&quot;Segment&quot;);
		if( sSegment == &quot;Consumer&quot;)
		{
			bcProd = TheApplication().GetBusObject(&quot;Internal Product&quot;).GetBusComp(&quot;Internal Product - ISS Admin&quot;);
			bcDFAName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA MSP Order Line Item BC&quot;);
			sConsumer = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SPS_PROD_CAT&quot;, &quot;Consumer&quot;);
			with (bcDFAName)
			{
				SetViewMode(AllView);
				ActivateField(&quot;OrderQuoteId&quot;);
				ActivateField(&quot;ParOrdItemId&quot;);
				ActivateField(&quot;ActionCd&quot;);
				ActivateField(&quot;ProdSamId&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[OrderQuoteId] = &apos;&quot; + QuoteId + &quot;&apos; AND [ParOrdItemId] IS NULL AND [ActionCd] &lt;&gt; &apos;Delete&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				Frecord = FirstRecord();
				while (Frecord)
				{
					sSAMId = GetFieldValue(&quot;ProdSamId&quot;);
					with(bcProd)
					{
						SetViewMode(AllView);
						ActivateField(&quot;Vendor Part Number&quot;);
						ActivateField(&quot;VF SPS Product Category&quot;);
						ClearToQuery();
						//SetSearchExpr(&quot;[Vendor Part Number] = &apos;&quot; + sSAMId + &quot;&apos; AND EXISTS ([VF SPS Product Category] = &apos;&quot; + sConsumer + &quot;&apos;)&quot;);
						SetSearchExpr(&quot;[Vendor Part Number] = &apos;&quot; + sSAMId + &quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							oMvgBC = GetMVGBusComp(&quot;VF SPS Product Category&quot;);
							with (oMvgBC)
							{	
								ClearToQuery()
								SetViewMode (AllView);
								SetSearchSpec (&quot;Name&quot;,sConsumer);	
								ExecuteQuery ();						
								if (!FirstRecord())
								{
									sBusiness = &quot;Y&quot;;
									break;						
								}										
							}
						}
						
					}
					Frecord = NextRecord();
				}
			}
			if( sBusiness == &quot;Y&quot;)
			{
				sErrMsg =&quot;You cannot proceed with Business Proposition.Please change consumer proposition to proceed.&quot;;
				TheApplication().SetProfileAttr(&quot;Prof4&quot;,sErrMsg);
				
				//TheApplication().RaiseErrorText(&quot;Business Proposition is not allowed for Consumer Segment&quot;);
			}
			Outputs.SetProperty(&quot;Error Message&quot;, sErrMsg);
		}
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        Frecord = null;
        bcDFAName = null;
        bcProd = null;
		oMvgBC = null;
		
    }
} 
 
"
			   SEQUENCE="15"
			   UPDATED="04/25/2026 15:45:10"
			   UPDATED_BY="SOUMALYAM"
			   CREATED="04/15/2026 18:44:14"
			   CREATED_BY="MONISHAJ">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="prepLnItmDtlsFrPrePmnt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//SSJ:CM-10085:Soumalya:Created new BS for Payment plan generation 
function prepLnItmDtlsFrPrePmnt(Inputs, Outputs) 
{
    var bcOrderItem = null,lineRec = null,oliRowSet = null,oliRow = null,appObj = null,xaBC = null,itemId=&quot;&quot;,rootItemId=&quot;&quot;,xaRec = null,
    quoteId = &quot;&quot;,lineitemProdType=&quot;&quot;,ordSubType=&quot;&quot;, errMsg = &quot;Success&quot;,rowFlag=&quot;N&quot;,prodTerm=&quot;&quot;,prodPrice=&quot;&quot;,prodName=&quot;&quot;, bcRootOrderItem=null,MSISDN=&quot;&quot;, rootTerm = &quot;&quot;;
    var sStockInd =&quot;&quot;, sIMEI = &quot;&quot;, sDevCode = &quot;&quot;, sResId = &quot;&quot;, sStoreDevice =&quot;&quot;, sOrderFunction = &quot;&quot;, sConnectLater=&quot;&quot;, sInStock = &quot;&quot;;
	var sIMEIBC = null;
	try 
	{
        appObj = TheApplication();
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		//VHA KT 240426: Declared oliRowSet, OiliRow here for CM-10731
		oliRowSet = appObj.NewPropertySet();
		oliRowSet.SetType(&quot;SiebelMessage&quot;);
		oliRow = appObj.NewPropertySet();
        if (quoteId != &quot;&quot; &amp;&amp; quoteId != null) 
		{
            sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
			sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);
			bcOrderItem = appObj.GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
            with (bcOrderItem) 
			{
                SetViewMode(AllView);
                ClearToQuery();
                ActivateField(&quot;Related Asset Integration Id&quot;);
                ActivateField(&quot;Root Order Item Id&quot;);
                ActivateField(&quot;VF Stock Indicator TBUI&quot;);
                ActivateField(&quot;Product&quot;);
                ActivateField(&quot;VHASSJ Payment Term&quot;);
                ActivateField(&quot;VHA MSISDN Calc&quot;);
                ActivateField(&quot;Order Sub Type&quot;);
                ActivateField(&quot;Product Type&quot;);
                ActivateField(&quot;Action Code&quot;);
                ActivateField(&quot;Parent Order Id&quot;);
                SetSearchExpr(&quot;[Parent Order Id] = &apos;&quot; + quoteId + &quot;&apos; AND [Action Code] = &apos;Add&apos; AND ([Product Type] = &apos;Billing - GPP&apos; OR [Product Type] = &apos;Accessory&apos; OR [Product Type] = &apos;Billing - APP&apos; OR [Product Type] = &apos;Hardware&apos;)&quot;);
                ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					xaBC = appObj.GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;Order Item XA (No Link)&quot;);
					bcRootOrderItem = appObj.GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;VFDfa Order Entry Line Items&quot;);
					lineRec = FirstRecord();
					while(lineRec)
					{
						rootItemId = GetFieldValue(&quot;Root Order Item Id&quot;);
						//Get Root Details
						if(rootItemId != &quot;&quot; &amp;&amp; rootItemId != null)
						{
							with(bcRootOrderItem)
							{
								SetViewMode(AllView);
								ClearToQuery();
								ActivateField(&quot;Id&quot;);
								ActivateField(&quot;VHASSJ Payment Term&quot;);
								ActivateField(&quot;VHA MSISDN Calc&quot;);
								ActivateField(&quot;VF Stock Indicator TBUI&quot;);
								SetSearchSpec(&quot;Id&quot;, rootItemId)
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									MSISDN = GetFieldValue(&quot;VHA MSISDN Calc&quot;);
									rootTerm = GetFieldValue(&quot;VHASSJ Payment Term&quot;);
									sStockInd = GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
								}
							}
						}
						oliRow.Reset();
						rowFlag=&quot;N&quot;;
						itemId = GetFieldValue(&quot;Id&quot;);
						ordSubType = GetFieldValue(&quot;Order Sub Type&quot;);
						lineitemProdType = GetFieldValue(&quot;Product Type&quot;);
						if(lineitemProdType == &quot;Accessory&quot; || lineitemProdType == &quot;Billing - APP&quot;)
						{
							rowFlag = &quot;Y&quot;;
							prodTerm=&quot;&quot;;
							prodName=&quot;&quot;;
							prodPrice =&quot;&quot;;
							oliRow.SetProperty(&quot;MSISDN&quot;, MSISDN);
							oliRow.SetProperty(&quot;RootOrderItemId&quot;, rootItemId);
							oliRow.SetProperty(&quot;OrderItemId&quot;, itemId);
							oliRow.SetProperty(&quot;RelatedAssetIntegId&quot;, GetFieldValue(&quot;Related Asset Integration Id&quot;));
							with(xaBC)
							{
								SetViewMode(AllView);
								ClearToQuery();
								ActivateField(&quot;Object Id&quot;);
								ActivateField(&quot;Name&quot;);
								ActivateField(&quot;Value&quot;);
								SetSearchSpec(&quot;Object Id&quot;, itemId)
								ExecuteQuery(ForwardOnly)
								{
									if(FirstRecord())
									{
										xaRec = FirstRecord();
										while(xaRec)
										{
											if(GetFieldValue(&quot;Name&quot;) == &quot;Accessory RRP Inc GST&quot;)
												prodPrice =  GetFieldValue(&quot;Value&quot;);
											if(GetFieldValue(&quot;Name&quot;) == &quot;Term&quot;)
												prodTerm = GetFieldValue(&quot;Value&quot;);
											if(GetFieldValue(&quot;Name&quot;) == &quot;Accessory Name&quot;)
												prodName = GetFieldValue(&quot;Value&quot;);
											if(GetFieldValue(&quot;Name&quot;) == &quot;Category&quot;)
											{
												if(GetFieldValue(&quot;Value&quot;) == &quot;Secondary Device&quot;)
													oliRow.SetProperty(&quot;Category&quot;, GetFieldValue(&quot;Value&quot;));
												else
													oliRow.SetProperty(&quot;Category&quot;, &quot;Accessory&quot;);
											}
											xaRec = NextRecord();
										}
									}
								}
							}
							if(lineitemProdType == &quot;Billing - APP&quot;)
								oliRow.SetProperty(&quot;Category&quot;, &quot;APP Contract&quot;);
							oliRow.SetProperty(&quot;ProductName&quot;, prodName);
							oliRow.SetProperty(&quot;ProductTerm&quot;, prodTerm);
							oliRow.SetProperty(&quot;Price&quot;, prodPrice);
						}
						if((lineitemProdType == &quot;Billing - GPP&quot; &amp;&amp; ordSubType != &quot;Connect&quot;) || (lineitemProdType == &apos;Hardware&apos; &amp;&amp; ordSubType == &quot;Connect&quot; &amp;&amp; sStockInd != sInStock))
						{
							rowFlag = &quot;Y&quot;;
							prodTerm=&quot;&quot;;
							prodName=&quot;&quot;;
							prodPrice =&quot;&quot;;
							oliRow.SetProperty(&quot;MSISDN&quot;, MSISDN);
							oliRow.SetProperty(&quot;RootOrderItemId&quot;, rootItemId);
							oliRow.SetProperty(&quot;OrderItemId&quot;, itemId);
							oliRow.SetProperty(&quot;RelatedAssetIntegId&quot;, GetFieldValue(&quot;Related Asset Integration Id&quot;));
							oliRow.SetProperty(&quot;Category&quot;, &quot;GPP&quot;);
							with(xaBC)
							{
								SetViewMode(AllView);
								ClearToQuery();
								ActivateField(&quot;Object Id&quot;);
								ActivateField(&quot;Name&quot;);
								ActivateField(&quot;Value&quot;);
								SetSearchSpec(&quot;Object Id&quot;, itemId)
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									xaRec = FirstRecord();
									while(xaRec)
									{
										if(GetFieldValue(&quot;Name&quot;) == &quot;Contract Amount&quot; || GetFieldValue(&quot;Name&quot;) == &quot;Device Price Inc GST&quot;)
											prodPrice = GetFieldValue(&quot;Value&quot;);
										if(GetFieldValue(&quot;Name&quot;) == &quot;Term&quot;)
											prodTerm = GetFieldValue(&quot;Value&quot;);
										if(GetFieldValue(&quot;Name&quot;) == &quot;Item Name&quot; || GetFieldValue(&quot;Name&quot;) == &quot;Device Name&quot;)
											prodName = GetFieldValue(&quot;Value&quot;);											
										xaRec = NextRecord();
									}
								}
							}
							if(GetFieldValue(&quot;Product Type&quot;) == &apos;Hardware&apos;)
							{
								prodTerm = rootTerm;
							}
							oliRow.SetProperty(&quot;ProductName&quot;, prodName);
							oliRow.SetProperty(&quot;ProductTerm&quot;, prodTerm);
							oliRow.SetProperty(&quot;Price&quot;, prodPrice);
						}
						if(rowFlag == &quot;Y&quot;)
							oliRowSet.AddChild(oliRow.Copy());						
						lineRec = NextRecord();
					}		
				}
				//Consider for Connect OOS records
				SetViewMode(AllView);
                ClearToQuery();
                ActivateField(&quot;Related Asset Integration Id&quot;);
                ActivateField(&quot;Root Order Item Id&quot;);
                ActivateField(&quot;VF IMEI TBUI&quot;);
                ActivateField(&quot;Product&quot;);
                ActivateField(&quot;Order Sub Type&quot;);
                ActivateField(&quot;VHASSJ Payment Term&quot;);
                ActivateField(&quot;VHA MSISDN Calc&quot;);
                ActivateField(&quot;Product Type&quot;);
                ActivateField(&quot;Action Code&quot;);
                ActivateField(&quot;Parent Order Id&quot;);
                SetSearchExpr(&quot;[Parent Order Id] = &apos;&quot; + quoteId + &quot;&apos; AND [Action Code] = &apos;Add&apos; AND [Order Sub Type] = &apos;Connect&apos; AND [Parent Order Item Id] IS NULL AND [VF Stock Indicator TBUI]=&apos;&quot;+sInStock+&quot;&apos;&quot;);
                ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sIMEIBC = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VF Allocate IMEI&quot;);
					lineRec = FirstRecord();
					while(lineRec)
					{
						oliRow.Reset();
						rowFlag = &quot;N&quot;;
						prodTerm=&quot;&quot;;
						prodName=&quot;&quot;;
						prodPrice =&quot;&quot;;
						rootItemId = &quot;&quot;;
						sIMEI = &quot;&quot;;
						MSISDN = &quot;&quot;
						prodTerm = GetFieldValue(&quot;VHASSJ Payment Term&quot;);
						sIMEI = GetFieldValue(&quot;VF IMEI TBUI&quot;);
						rootItemId = GetFieldValue(&quot;Id&quot;);
						MSISDN = GetFieldValue(&quot;VHA MSISDN Calc&quot;);
						if(sIMEI != &quot;&quot; &amp;&amp; sIMEI != null &amp;&amp; rootItemId != &quot;&quot; &amp;&amp; rootItemId != null)
						{
							with (sIMEIBC) 
							{
								ActivateField(&quot;Id&quot;);
								ActivateField(&quot;IMEI&quot;);
								ActivateField(&quot;Root Order Line Item&quot;);
								ActivateField(&quot;Upfront Cost&quot;);
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchExpr(&quot;[IMEI] = &apos;&quot; + sIMEI + &quot;&apos; AND [Root Order Line Item]=&apos;&quot;+rootItemId+&quot;&apos;&quot;);
								ExecuteQuery(ForwardOnly);
								if (FirstRecord()) {
									prodPrice = ToNumber(GetFieldValue(&quot;Upfront Cost&quot;));
									prodName = GetFieldValue(&quot;Device Name&quot;);
									rowFlag = &quot;Y&quot;;
								}
							}
							if(rowFlag == &quot;Y&quot;)
							{
								oliRow.SetProperty(&quot;MSISDN&quot;, MSISDN);
								oliRow.SetProperty(&quot;RootOrderItemId&quot;, rootItemId);
								oliRow.SetProperty(&quot;OrderItemId&quot;, &quot;&quot;);
								oliRow.SetProperty(&quot;RelatedAssetIntegId&quot;, &quot;&quot;);
								oliRow.SetProperty(&quot;Category&quot;, &quot;GPP&quot;);
								oliRow.SetProperty(&quot;ProductName&quot;, prodName);
								oliRow.SetProperty(&quot;ProductTerm&quot;, prodTerm);
								oliRow.SetProperty(&quot;Price&quot;, prodPrice);
								oliRowSet.AddChild(oliRow.Copy());
							}
						}
						lineRec = NextRecord();
					}
				}				
				Outputs.AddChild(oliRowSet.Copy());
            }
        }
		else
		{
			errMsg = &quot;QUOTE_ID_INVALID&quot;;
		}
		Outputs.SetProperty(&quot;ErrMsg&quot;, errMsg);
    }
	catch(e)
	{
		throw(e);
	}
	finally
	{	
		lineRec = null;
		oliRowSet = null;
		oliRow = null;
		xaBC = null;
		itemId=&quot;&quot;;
		xaRec = null;
		quoteId = &quot;&quot;;
		lineitemProdType=&quot;&quot;;
		ordSubType=&quot;&quot;;
		errMsg = &quot;Success&quot;;
		bcOrderItem = null;
		appObj = null;
	}
}"
