			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCustomer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCustomer(Inputs, Outputs)
{
	var Status1 = &quot;APPROVED&quot;;
	var Status2 = &quot;APPROVE&quot;;
	var Status3 = &quot;CONDAPPRVE&quot;;
	var Status4 = &quot;ACCEPT&quot;;
	var Status5 = &quot;New&quot;
	var Status6 = &quot;Pending&quot;
		
	var sAddrProof=&quot;N&quot;;
	var sAddrFlg,sAccountId,FWAOldAddrId;
		
	var boActive;
	var bcContact;
	var bcCUTAddress;
	var bcFinProf;
	var iTotalPoints =0;
		

	try
	{
		var boActive = TheApplication().GetBusObject(&quot;Account&quot;);
		var bcAccount = boActive.GetBusComp(&quot;Account&quot;);
		var bcContact = boActive.GetBusComp(&quot;Contact&quot;);
		var bcContactId = boActive.GetBusComp(&quot;VF Contact Id&quot;);
		var bcCUTAddress = boActive.GetBusComp(&quot;CUT Address&quot;);
		var bcFinProf = boActive.GetBusComp(&quot;VF Com Financial Profile&quot;);
		sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		FWAOldAddrId = Inputs.GetProperty(&quot;FWAOldAddrId&quot;);
		var sOrgLOVkogan = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ORG_NAME&quot;, &quot;Kogan&quot;);
		with (bcAccount)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;SOHO Customer&quot;);
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Tax Exempt Number&quot;);
			ActivateField(&quot;Industry Type&quot;);
			ActivateField(&quot;Name&quot;);
			ActivateField(&quot;VF ABN Status&quot;);
			ActivateField(&quot;VF Trading Date&quot;);
			ActivateField(&quot;Customer Company Established Date&quot;);
			ActivateField(&quot;Account Status&quot;);
			ActivateField(&quot;Customer Default Bill Cycle&quot;);
			ActivateField(&quot;CSN&quot;);
			SetSearchSpec(&quot;Id&quot;, sAccountId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				Outputs.SetProperty(&quot;Account Id&quot;, GetFieldValue(&quot;Id&quot;));
				Outputs.SetProperty(&quot;CA PIN&quot;, GetFieldValue(&quot;Password&quot;));
				Outputs.SetProperty(&quot;Sole Trader&quot;, GetFieldValue(&quot;SOHO Customer&quot;));
				Outputs.SetProperty(&quot;Customer Type&quot;, GetFieldValue(&quot;Type&quot;));
				Outputs.SetProperty(&quot;Customer Bill Segment&quot;, GetFieldValue(&quot;Customer Bill Segment&quot;));
				Outputs.SetProperty(&quot;DOM&quot;, GetFieldValue(&quot;Customer Default Bill Cycle&quot;));
				Outputs.SetProperty(&quot;CSN&quot;, GetFieldValue(&quot;CSN&quot;));
				Outputs.SetProperty(&quot;ABN ACN&quot;, GetFieldValue(&quot;Tax Exempt Number&quot;));//Added for defect#1075
				Outputs.SetProperty(&quot;Industry Type&quot;, GetFieldValue(&quot;Industry Type&quot;));
				Outputs.SetProperty(&quot;TradingAs&quot;, GetFieldValue(&quot;Alias&quot;));
				Outputs.SetProperty(&quot;Company Name&quot;, GetFieldValue(&quot;Name&quot;));//21/jul/2014
				Outputs.SetProperty(&quot;CustomerSegment&quot;, GetFieldValue(&quot;VF Customer Segment&quot;));
				Outputs.SetProperty(&quot;VFCustomerType&quot;, GetFieldValue(&quot;VF Customer Type&quot;));
				Outputs.SetProperty(&quot;EmployeeCountRange&quot;, GetFieldValue(&quot;Employee Count Range&quot;));
				Outputs.SetProperty(&quot;ABNStatus&quot;, GetFieldValue(&quot;VF ABN Status&quot;));
				Outputs.SetProperty(&quot;TradingDate&quot;, GetFieldValue(&quot;Customer Company Established Date&quot;));
				Outputs.SetProperty(&quot;AccountStatus&quot;, GetFieldValue(&quot;Account Status&quot;));
			}
		}
				
		
		// Search for Primary Contact
		
		with (bcContact)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Account Id&quot;);
			ActivateField(&quot;Date of Birth&quot;);
			ActivateField(&quot;Marital Status&quot;);
			ActivateField(&quot;Work Phone #&quot;);
			ActivateField(&quot;Home Phone #&quot;);
			ActivateField(&quot;M/F&quot;);
			ActivateField(&quot;M/M&quot;);
			ActivateField(&quot;VF IS Decision Maker&quot;);
			ActivateField(&quot;VF Contact Role&quot;);
			SetSearchSpec(&quot;SSA Primary Field&quot;, &quot;Y&quot;);
			ExecuteQuery(ForwardOnly);

			if (FirstRecord())
			{
				Outputs.SetProperty(&quot;Contact Id&quot;, GetFieldValue(&quot;Id&quot;));
				Outputs.SetProperty(&quot;Account ContactId&quot;, GetFieldValue(&quot;Account Id&quot;));
				Outputs.SetProperty(&quot;Date of Birth&quot;, GetFieldValue(&quot;Date of Birth&quot;));
				Outputs.SetProperty(&quot;Email Address&quot;, GetFieldValue(&quot;Email Address&quot;));
				Outputs.SetProperty(&quot;First Name&quot;, GetFieldValue(&quot;First Name&quot;));
				Outputs.SetProperty(&quot;Last Name&quot;, GetFieldValue(&quot;Last Name&quot;));
				Outputs.SetProperty(&quot;Marital Status&quot;, GetFieldValue(&quot;Marital Status&quot;));
				Outputs.SetProperty(&quot;Work Phone&quot;, GetFieldValue(&quot;Work Phone #&quot;));
				Outputs.SetProperty(&quot;Home Phone&quot;, GetFieldValue(&quot;Home Phone #&quot;));
				//Title 7900 change - 16Mar2023
				if(ParentBusComp().GetFieldValue(&quot;Organization&quot;) == sOrgLOVkogan){
					Outputs.SetProperty(&quot;Gender&quot;, GetFieldValue(&quot;M/F&quot;));
					Outputs.SetProperty(&quot;Title&quot;, GetFieldValue(&quot;M/M&quot;));
				}else{
					Outputs.SetProperty(&quot;Gender&quot;, &quot;&quot;);
					Outputs.SetProperty(&quot;Title&quot;, &quot;&quot;);
				}
				Outputs.SetProperty(&quot;Middle Name&quot;, GetFieldValue(&quot;Middle Name&quot;));// Neel - QC#1051
				Outputs.SetProperty(&quot;IsDecisionMaker&quot;, GetFieldValue(&quot;VF IS Decision Maker&quot;));
				Outputs.SetProperty(&quot;VFContactRole&quot;, GetFieldValue(&quot;VF Contact Role&quot;));
				
			}
		
		}
				
		// Validate Contact Id with 100 points and Primary ID
				
	/*	with (bcContactId)
		{ 

		ClearToQuery();
		SetViewMode(AllView);
		ExecuteQuery(ForwardOnly); 

			var ContactIdFound = FirstRecord();
		
			if (!FirstRecord())
			{
				return (sNavigateToView1);
			}
			
			while (ContactIdFound)
			{
				var sPoint = GetFieldValue(&quot;VF Points Postpay&quot;);
				iTotalPoints = iTotalPoints + ToNumber(GetFieldValue(&quot;VF Points Postpay&quot;));

					if (sAddrProof != &quot;Y&quot;)
					{	
					sAddrFlg = GetFieldValue(&quot;VF Proof of Address&quot;); 
					sAddrProof = sAddrFlg;
					} 
				ContactIdFound = NextRecord();
			}

			if (iTotalPoints &lt; 100)
			{
				return (sNavigateToView1);
			} 	
			
			if (sAddrFlg != &quot;Y&quot;)
			{
				return (sNavigateToView1);
			} 		
		
		}*/
			
			
		// Search for Primary Address
				
		with (bcCUTAddress)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Address Floor Type&quot;);
			ActivateField(&quot;Address Floor&quot;);
			ActivateField(&quot;Address Building&quot;);
			//SetSearchSpec(&quot;SSA Primary Field&quot;, &quot;Y&quot;);
			SetSearchSpec(&quot;Id&quot;,FWAOldAddrId);
			ExecuteQuery(ForwardOnly);

			if (FirstRecord())
			{
				
				var StrAddFloorType=GetFieldValue(&quot;Address Floor Type&quot;);
				var StrAddFloor=GetFieldValue(&quot;Address Floor&quot;);
				var StrAddFloorBuild=GetFieldValue(&quot;Address Building&quot;);
				var StrAddStAdd2=GetFieldValue(&quot;Street Address 2&quot;);
				var StrAddStType=GetFieldValue(&quot;Address Street Type - AU&quot;);
				var StrAddStAdd=GetFieldValue(&quot;Street Address&quot;);
				var StrAddCity=GetFieldValue(&quot;City AU&quot;);
				var StrAddstate=GetFieldValue(&quot;State&quot;);
				var StrAddPCode=GetFieldValue(&quot;Postal Code AU&quot;);
				var StrAddStatus=GetFieldValue(&quot;Validation Status&quot;);
				//StrAddStatus =&quot;1&quot;;
				var StrFinalAdd = StrAddFloorType + &quot; &quot; + StrAddFloor + &quot; &quot; + StrAddFloorBuild + &quot; &quot; + StrAddStAdd2 + &quot; &quot; + StrAddStAdd + &quot; &quot; + StrAddCity + &quot; &quot; + StrAddstate + &quot; &quot; + StrAddPCode ;
				Outputs.SetProperty(&quot;WSDL Address&quot;, StrFinalAdd);
				Outputs.SetProperty(&quot;WSDL Street Number&quot;, StrAddStAdd2);// Sathish QC2319
				Outputs.SetProperty(&quot;WSDL Street Type&quot;, StrAddStType);// QC2319
				Outputs.SetProperty(&quot;WSDL Street Name&quot;,StrAddStAdd );//QC2319
				Outputs.SetProperty(&quot;WSDL Suburb&quot;, StrAddCity);//QC2319
				Outputs.SetProperty(&quot;WSDL State&quot;, StrAddstate);//QC2319
				Outputs.SetProperty(&quot;WSDL Post Code&quot;, StrAddPCode);//QC2319
				Outputs.SetProperty(&quot;Address Selected&quot;, StrFinalAdd);
				Outputs.SetProperty(&quot;Address Status&quot;, StrAddStatus);
				Outputs.SetProperty(&quot;Address Id&quot;, GetFieldValue(&quot;Id&quot;));
			}
		

		}
		
		with (bcCUTAddress)
		{
			//Added below Query for MR01 - Capture Delivery Address Upfront CR - Suresh G - 8/3/2020	
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Id&quot;);
			ActivateField(&quot;End Date&quot;);
			ActivateField(&quot;Cleanse Verification Code&quot;);			
			SetSearchSpec(&quot;End Date&quot;, &quot;IS NULL&quot;);
			SetSearchSpec(&quot;Cleanse Verification Code&quot;, &quot;Shipment&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				var sShipmentAddrId = GetFieldValue(&quot;Id&quot;);
				Outputs.SetProperty(&quot;ShipmentAddressId&quot;, sShipmentAddrId);
			}
		}

		
		// Coverage Check Validation
			
			var CvgcheckboActive = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;);
			var Cvgcheckbc = CvgcheckboActive.GetBusComp(&quot;VF Coverage Check&quot;);
			sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
			with (Cvgcheckbc)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Accnt Id&quot;);
				ActivateField(&quot;Map URL&quot;);
				ActivateField(&quot;Status&quot;);
				SetSearchSpec(&quot;Accnt Id&quot;, sAccountId);
				SetSortSpec(&quot;Updated(DESCENDING)&quot;);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					Outputs.SetProperty(&quot;MapURL&quot;,GetFieldValue(&quot;Map URL&quot;)); 
					Outputs.SetProperty(&quot;CvgStatus&quot;,GetFieldValue(&quot;Status&quot;));
					Outputs.SetProperty(&quot;CvgRowId&quot;,GetFieldValue(&quot;Id&quot;));
				}
				else
				{
					var psInput,psOutput,bs;
					psInput  = TheApplication().NewPropertySet();
					psOutput = TheApplication().NewPropertySet();
					bs = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
					psInput.SetProperty(&quot;SourceName&quot;,&quot;VF Capture Existing Account Details&quot;);
					psInput.SetProperty(&quot;FunctionName&quot;,&quot;Coverage Check for Existing Customer&quot;);
					psInput.SetProperty(&quot;Error Msg&quot;, &quot;Coverge Check doesn&apos;t exists  for Account Id&quot; + sAccountId); 
					psInput.SetProperty(&quot;Show Error Msg&quot;,&quot;N&quot;);
					bs.InvokeMethod(&quot;LogException&quot;,psInput,psOutput);
				}
			}
		
		// Validated Credit Check for the Customer
		
	/*	with (bcFinProf)
		{
			var dtCCExpiryDate = new Date(GetFieldValue(&quot;VF Credit Check Expiry Date&quot;));
			var strCCExpiryDateToSys = 	dtCCExpiryDate.toSystem(); 
			var strCredtCheckStatus = GetFieldValue(&quot;VF Credit Check Status&quot;);
			var bConditionsAcceptedFlag = GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);
			var strCurrentSysDate = Clib.time();		
			
			// New Credit Check Status Vaidation
				
			if (strCredtCheckStatus == &quot;New&quot; || strCredtCheckStatus == &quot;Pending&quot; || strCredtCheckStatus == &quot;&quot;)
			{						
			return(sNavigateToView3);
			}
			
			// Expiry Date Validation
				
			if (strCredtCheckStatus != &quot;New&quot; || strCredtCheckStatus != &quot;Pending&quot;)
			{
			if(strCurrentSysDate &gt; strCCExpiryDateToSys)
			{
			return(sNavigateToView3);
			}
			}		
						
			// Existing Credit Check Validation
			
			if ((strCredtCheckStatus!= Status1) || (strCredtCheckStatus!= Status2) &amp;&amp;
			(strCredtCheckStatus!= Status3 || bConditionsAcceptedFlag != &quot;Y&quot;) &amp;&amp; (strCredtCheckStatus!= Status4))
			{						
			return(sNavigateToView3);
			}
						
 		}
 		
		return (sNavigateToView4);*/
	}		
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		Cvgcheckbc = null;
		CvgcheckboActive = null;
		bcAccount = null;
		//bs = null;
		psInput = null;
		psOutput = null;
		//end 18/03/2019
		bcContact = null;
		bcContactId = null;
		bcCUTAddress = null;
		bcFinProf = null;
		boActive = null;
		if(defined(bs)) { bs = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
	}
}"
