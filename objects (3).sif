			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidateGeoTagOffer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function fnValidateGeoTagOffer(Inputs,Outputs)
{
	Outputs.SetProperty(&quot;Status&quot;,&quot;Valid&quot;);
	var OGeoBC = null;
	var OfferId = Inputs.GetProperty(&quot;OfferId&quot;);
	try
	{
		OGeoBC = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA Offer GeoTag Details BC&quot;);
		with(OGeoBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;OfferId&quot;);
			ActivateField(&quot;Status&quot;);
			SetSearchSpec(&quot;OfferId&quot;, OfferId);
			SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				Outputs.SetProperty(&quot;Status&quot;,&quot;Invalid&quot;)
			}

		}
		
	}
	catch(e)
	{
		throw(e)
	}
	finally
	{
		OGeoBC = null;
	}
}"
