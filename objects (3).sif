			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fUpdatePriceVal"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fUpdatePriceVal(Inputs, Outputs) 
{
    var sOrderId = &quot;&quot;,boOrder = null,sBCOrder = null,bcOrderLineIt = null,rootId = &quot;&quot;,sNetPrice = &quot;&quot;;
    try 
	{
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        rootId = Inputs.GetProperty(&quot;RootItemId&quot;);
		boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
        sBCOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
        bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
        with (sBCOrder) 
		{
			ClearToQuery();
            SetViewMode(AllView);
            SetSearchSpec(&quot;Id&quot;, sOrderId);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) 
			{
				with (bcOrderLineIt) 
				{
                    
					ActivateField(&quot;Order Header Id&quot;);
					ActivateField(&quot;Action Code&quot;);
					ActivateField(&quot;VHA Siebel Product Type&quot;);
					ActivateField(&quot;Base Price&quot;);
					ActivateField(&quot;Net Price&quot;);
					ActivateField(&quot;Adjusted List Price&quot;);
					ActivateField(&quot;VF Siebel Price&quot;);
					ActivateField(&quot;Root Order Item Id&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + rootId + &quot;&apos; AND [VHA Siebel Product Type] = &apos;MSP Discount&apos; AND ([Action Code] = &apos;Add&apos; OR [Action Code] = &apos;Update&apos;)&quot;);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord()) 
					{
						sNetPrice = GetFieldValue(&quot;Net Price&quot;);
						SetFieldValue(&quot;Base Price&quot;, sNetPrice);
						SetFieldValue(&quot;Adjusted List Price&quot;, sNetPrice);
						SetFieldValue(&quot;VF Siebel Price&quot;,sNetPrice);
						WriteRecord();
					}
                    
                }
            }
        }
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
		sOrderId = null;
	    boOrder = null;
	    sBCOrder = null;
	    bcOrderLineIt = null;
	    rootId = null;
		sNetPrice = null;
	}
}"
