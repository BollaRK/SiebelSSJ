			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnInsertSharingDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnInsertSharingDetails(Inputs, Outputs)
{
try
{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var psOutputs1 = TheApplication().NewPropertySet();
		var sInputs = TheApplication().NewPropertySet();
		var sOutputs = TheApplication().NewPropertySet();
		var sSharingAction,sLead,sGroupId,sLeadMSISDNId;
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
		var IsBulkOrder = Inputs.GetProperty(&quot;IsBulkOrder&quot;);
		var sRootItemId = Inputs.GetProperty(&quot;RootItemId&quot;);
		
		var sInStkMSISDN=&apos;&apos;,sInStkAssetIntegId=&apos;&apos;;
		var sGroupStatus,sLeadMSISDN,sNewLeadMSISDN,sGroupName,sBillAccountId,sSharingCompatability,sAccountId,sExistingLeadMSISDN;
		var sMSISDN = &quot;&quot;,sNewGroupId,iNoOfParent,sLead,sGroupId,sLeadMSISDNId,LeadId,sAssetIntId,sOLILeadMSISDN,sOLINewLeadMSISDN,sOLIGroupName,sModifiedGroupName;
		
		psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VHA Order Line Items - Sharing Thin.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VHA Order Line Items - Sharing Thin.Parent Order Item Id] IS NULL AND [VHA Order Line Items - Sharing Thin.Sharing Action Calc] IS NOT NULL&quot;);
		
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Sharing Order Item IO&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		var sParentType = psOutputs.GetChild(0).GetChild(0).GetType();
		
					if(sParentType == &quot;ListOfVHA Sharing Order Item IO&quot;)
					{
						iNoOfParent = psOutputs.GetChild(0).GetChild(0).GetChildCount();

						if(iNoOfParent &gt; 0)
						{
							
							for (var i = 0; i &lt; iNoOfParent; i++) 
							{
								sInputs.Reset();
								sOutputs.Reset();	
								sSharingAction = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Action Calc&quot;);
								sLead = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Is Lead&quot;);
								sGroupId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Group Id&quot;);
								sLeadMSISDNId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Group Lead&quot;);
								sGroupName = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Group Name&quot;);
								sModifiedGroupName = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VHA Sharing  Group Name&quot;);
  								sOLILeadMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Lead MSISDN&quot;);
        						sOLINewLeadMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing New Lead MSISDN&quot;);
        						sOrderType = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Service Order Sub Type&quot;);
        						sExistingLeadMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VHA Lead MSISDN&quot;);
        					if(sOLILeadMSISDN != &quot;&quot; &amp;&amp; sGroupId != &quot;&quot;)
        						{
										// Do Nothing
								}
							else
							{
										if(sOrderType == &quot;Change Proposition&quot;)
											sAssetIntId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Custom Asset Integration Id&quot;);
										else
											sAssetIntId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Asset Integration Id&quot;);
											
										if(iNoOfParent == 1 &amp;&amp; sGroupId == &quot;&quot; &amp;&amp; sSharingAction == &quot;Add Member&quot; &amp;&amp; sOLINewLeadMSISDN == &quot;&quot;)
										{
											//Do nothing. Do not create group for SSO
										}
										else
										{
										if (sMSISDN == &quot;&quot; &amp;&amp; sGroupId == &quot;&quot;)
										{
											if(sOLILeadMSISDN == &quot;&quot; || sOLILeadMSISDN == null)	// VHA Suresh: Added for loop for PIPE: Sharing
											{
											for(var j=0; j&lt;iNoOfParent; j++)
											{
												var SiebProdType = psOutputs.GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;VF Siebel Product Type&quot;);
												if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,SiebProdType) == &quot;&quot;)
												{
												sMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;MSISDN Calc&quot;);
												if(sOrderType == &quot;Change Proposition&quot;)
													LeadId = psOutputs.GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Custom Asset Integration Id&quot;);
												else			
													LeadId = psOutputs.GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Asset Integration Id&quot;);
												
												break;
												}
											}
											}
											else
												sMSISDN = sOLILeadMSISDN;

											sBillAccountId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Billing Account Id&quot;);
											sAccountId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Account Id&quot;);
											sSharingCompatability = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Compatibility&quot;);
											sOLIGroupName = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VHA Sharing  Group Name&quot;);
											
											//replace with Instock MSISDN Id
											GetInstockLineDetails(sOrderId, sRootItemId, sInStkMSISDN, sInStkAssetIntegId);
											
											if(sInStkMSISDN !=&apos;&apos; &amp;&amp; sInStkMSISDN != null &amp;&amp; sInStkAssetIntegId != null &amp;&amp; sInStkAssetIntegId !=&apos;&apos;)
											{
												sMSISDN = sInStkMSISDN;
												LeadId	= sInStkAssetIntegId;
											}
											
											if(sOLILeadMSISDN == &quot;&quot;)
											 {
											  sInputs.SetProperty(&quot;sMSISDN&quot;,sMSISDN);
											  sInputs.SetProperty(&quot;LeadId&quot;,LeadId);
											 }
											 else
											 {
											  sInputs.SetProperty(&quot;sMSISDN&quot;,sLeadMSISDN);
											  sInputs.SetProperty(&quot;LeadId&quot;,sOLINewLeadMSISDN);
											 } 
											sInputs.SetProperty(&quot;sGroupStatus&quot;,&quot;&quot;);
											sInputs.SetProperty(&quot;sBillAccountId&quot;,sBillAccountId);
											sInputs.SetProperty(&quot;sAccountId&quot;,sAccountId);
											sInputs.SetProperty(&quot;sSharingCompatability&quot;,sSharingCompatability);
											
											sInputs.SetProperty(&quot;sGroupName&quot;,sOLIGroupName);
											sNewGroupId = fnUpsertSharingGroup(sGroupId,sInputs);
									
										}

										else
										{
											if(sGroupId != &quot;&quot;)
											{
											//fnDecideSharingNewLead(sGroupId,sAssetIntId,sSharingAction,sOrderId,sOutputs);
												fnDecideSharingNewLead(sGroupId,sAssetIntId,sSharingAction,sOrderId,sOrderType,sLeadMSISDNId,sOutputs);
												if (sModifiedGroupName == &quot;&quot;)
												{
													Inputs.SetProperty(&quot;sGroupName&quot;,sGroupName);
												}
												else
												{
													Inputs.SetProperty(&quot;sGroupName&quot;,sModifiedGroupName);
												}
												fnUpsertSharingGroup(sGroupId,Inputs);

												sLeadMSISDN = sOutputs.GetProperty(&quot;LeadMSISDN&quot;);
												
												if(sLeadMSISDN == &quot;&quot;)
												{
													sLeadMSISDN = sExistingLeadMSISDN;
												}
												sNewLeadMSISDN = sOutputs.GetProperty(&quot;NewLeadMSISDN&quot;);
											}
										}
								
									
								
									if (sSharingAction == &quot;Remove Member&quot; &amp;&amp; sLead == &quot;Y&quot;)
									{
										
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sLeadMSISDN);
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;, sNewLeadMSISDN);
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Remove Member&quot;);
										
									}
									else if (sSharingAction == &quot;Remove Member&quot; &amp;&amp; sLead == &quot;N&quot;)
									{
										if(gAddmem == &quot;&quot;)
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sLeadMSISDN);
											}
											else
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, gAddmem);
											}
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;, &quot;&quot;);
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Remove Member&quot;);
										
									}
									else if (sSharingAction == &quot;Existing Member&quot;)
									{
										
									/*	if(sOrderType == &quot;Change Proposition&quot;)
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Add Member&quot;);
										else*/
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Existing Member&quot;);


										if(gAddmem == &quot;&quot;)
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sLeadMSISDN);
											}
											else
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, gAddmem);
											}
										psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;, &quot;&quot;);
									}
									else if (sSharingAction == &quot;Add Member&quot;)
									{
										if(sGroupId != &quot;&quot;)
										{
											if(sOLILeadMSISDN == &quot;&quot;)
											{
												if(gAddmem == &quot;&quot;)
												{
													psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sLeadMSISDN);
												}
												else
												{
													psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, gAddmem);
												}
											}
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;, &quot;&quot;);
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Add Member&quot;);
										}	
										else
										{
											if(sOLILeadMSISDN != &quot;&quot;)
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sOLILeadMSISDN);
											}
											else
											{
												psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;, sMSISDN);
				 
											}
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;, &quot;&quot;);
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;, &quot;Add Member&quot;);
											psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Group Id&quot;, sNewGroupId);
										}
									}
								
								} //Else loop to trigeer sharing logic
						} //else(Lead MSISDN update check)
					}//For loop
					if(sOLILeadMSISDN != &quot;&quot; &amp;&amp; sGroupId != &quot;&quot;)
						{
										// Do Nothing
						}
					else
					{
						bsEAIService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psOutputs1);
					}
				}
			}
			
			
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bsEAIService = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		TheApplication().SetProfileAttr(&quot;VHARestrictMSISDNFromUI&quot;,&quot;&quot;);	
	
	}

}"
			   SEQUENCE="14"
			   UPDATED="06/28/2024 18:49:20"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnProcessModifyMSO"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnProcessModifyMSO(Inputs,Outputs)
{
	try
	{
		var oAssetBO = TheApplication().GetBusObject(&quot;VF Asset Mgmt - Asset Header&quot;);
		var oAssetBC = oAssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		var sSearchspec = &quot;&quot;;
		var sCount = &quot;&quot;;
		var irec = &quot;&quot;;
		var pInputs,pOutputs,svc,sPropId,sSharingPropId,psInputs,psOutputs,bsInvokeWorkflow,sSharingRatePlanName,pInputs1,pOutputs1,svc1;
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var strOrderNumber = Inputs.GetProperty(&quot;OrderNumber&quot;);
		var strBillingAccntId = Inputs.GetProperty(&quot;BillingAccntId&quot;);
		var sChangeLOC = Inputs.GetProperty(&quot;ChangeLocation&quot;);
		var sNewPriorityNetwork = Inputs.GetProperty(&quot;NewPriorityNetwork&quot;);
		var sOldPriorityNetwork = Inputs.GetProperty(&quot;OldPriorityNetwork&quot;);
		var sFCNBNFTTPInterim = Inputs.GetProperty(&quot;FCNBNFTTPInterim&quot;);
		var strSessionId = Inputs.GetProperty(&quot;SessionId&quot;);//CMID
		//var sSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Switch&quot;);//SBABU
		//SATHISH 23-02-24 Added below for FibreUpgrade drop 2
		/*var sFCInterimPropId  = Inputs.GetProperty(&quot;FCInterimPropositionId&quot;);
		var sFCInterimPlan = Inputs.GetProperty(&quot;FCInterimPlan&quot;);
		var sFCNBNFTTPInterim = Inputs.GetProperty(&quot;FCNBNFTTPInterim&quot;);*/

		var sFCInterimPropId  = TheApplication().GetProfileAttr(&quot;InterimPropositionId&quot;);
		var sFCInterimPlan = TheApplication().GetProfileAttr(&quot;InterimPlan&quot;);
		var sFCNBNFTTPInterim = TheApplication().GetProfileAttr(&quot;NBNFTTPInterim&quot;);
		
		sSearchspec = &quot;[Select For Upgrade] = &apos;Y&apos; AND [Billing Account Id] = &apos;&quot; + strBillingAccntId + &quot;&apos; AND [Parent Asset Id] IS NULL&quot;;

		
		
		if(strOrderId !=&quot;&quot;)
		{
			
			oAssetBC.SetViewMode(AllView);
			oAssetBC.ActivateField(&quot;Sharing Group Id&quot;);
			oAssetBC.ActivateField(&quot;Sharing Select&quot;);
			oAssetBC.ActivateField(&quot;MSISDN&quot;);
			oAssetBC.ActivateField(&quot;Integration Id&quot;);
			oAssetBC.ActivateField(&quot;VHA Sharing Proposition Id&quot;);
			oAssetBC.ActivateField(&quot;Product Id&quot;);
			oAssetBC.ActivateField(&quot;Billing Account Id&quot;);
			oAssetBC.ActivateField(&quot;Master Account Id&quot;);
			oAssetBC.ActivateField(&quot;Asset Currency Code&quot;);
			oAssetBC.ActivateField(&quot;Service Account Id&quot;);
			oAssetBC.ActivateField(&quot;Service Account&quot;);
			oAssetBC.ActivateField(&quot;Billing Account&quot;);
			oAssetBC.ActivateField(&quot;Service Account Price List&quot;);
			oAssetBC.ActivateField(&quot;Cfg Latest Released Flag&quot;);
			oAssetBC.ActivateField(&quot;Product Def Type Code&quot;);
			oAssetBC.ActivateField(&quot;VHA Sharing Rate Plan&quot;);
			oAssetBC.ActivateField(&quot;VF Rate Plan&quot;);
			oAssetBC.ClearToQuery();
			oAssetBC.SetSearchExpr(sSearchspec);
			oAssetBC.ExecuteQuery(ForwardOnly);
			if(oAssetBC.FirstRecord())
			{
				irec = oAssetBC.FirstRecord();
				while(irec)
				{
				sPropId = oAssetBC.GetFieldValue(&quot;Product Id&quot;);
				sSharingPropId = oAssetBC.GetFieldValue(&quot;VHA Sharing Proposition Id&quot;);
				sSharingRatePlanName = oAssetBC.GetFieldValue(&quot;VHA Sharing Rate Plan&quot;);				

				if((sPropId == sSharingPropId || sSharingPropId == &quot;&quot; || sChangeLOC == &quot;Y&quot;)&amp;&amp; sFCNBNFTTPInterim != &quot;Y&quot; &amp;&amp; sNewPriorityNetwork == sOldPriorityNetwork)
				{
					pInputs = TheApplication().NewPropertySet();
					pOutputs = TheApplication().NewPropertySet();
					svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					pInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Create Modify Order&quot;);
					pInputs.SetProperty(&quot;Order Sub Type&quot;, &quot;Modify&quot;);
					pInputs.SetProperty(&quot;Installed Asset Id&quot;, oAssetBC.GetFieldValue(&quot;Id&quot;));
					pInputs.SetProperty(&quot;BypassProductConfigurator&quot;, &quot;TRUE&quot;);
					pInputs.SetProperty(&quot;MSOFlag&quot;, &quot;Y&quot;);
					pInputs.SetProperty(&quot;ChangeLocation&quot;, sChangeLOC);
					pInputs.SetProperty(&quot;GoToView&quot;, &quot;FALSE&quot;);
					pInputs.SetProperty(&quot;Active Quote Id&quot;, strOrderId);
					pInputs.SetProperty(&quot;Order Number&quot;, strOrderNumber);
					pInputs.SetProperty(&quot;Asset Integration Id&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
					pInputs.SetProperty(&quot;Root Asset Id&quot;, oAssetBC.GetFieldValue(&quot;Id&quot;));
					pInputs.SetProperty(&quot;Cfg Latest Released Flag&quot;, &quot;Y&quot;);
					pInputs.SetProperty(&quot;Object Id&quot;, oAssetBC.GetFieldValue(&quot;Service Account Id&quot;));
					pInputs.SetProperty(&quot;Billing Account Id&quot;, oAssetBC.GetFieldValue(&quot;Billing Account Id&quot;));
					pInputs.SetProperty(&quot;Service Account Id&quot;, oAssetBC.GetFieldValue(&quot;Service Account Id&quot;));
					pInputs.SetProperty(&quot;Asset Currency Code&quot;, oAssetBC.GetFieldValue(&quot;Asset Currency Code&quot;));
					svc.InvokeMethod(&quot;RunProcess&quot;, pInputs, pOutputs);
					strOrderId = pOutputs.GetProperty(&quot;Active Quote Id&quot;);
					strOrderNumber = pOutputs.GetProperty(&quot;Order Number&quot;);
					if(sSharingRatePlanName != &quot;&quot; &amp;&amp; oAssetBC.GetFieldValue(&quot;VF Rate Plan&quot;) != sSharingRatePlanName &amp;&amp; sChangeLOC != &quot;Y&quot;)
					{
						pInputs1 = TheApplication().NewPropertySet();
						pOutputs1 = TheApplication().NewPropertySet();
						svc1 = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						pInputs1.SetProperty(&quot;ProcessName&quot;, &quot;VHA Sharing Modify Workflow&quot;);
						pInputs1.SetProperty(&quot;Object Id&quot;, strOrderId);
						pInputs1.SetProperty(&quot;SharingIntegId&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
						pInputs1.SetProperty(&quot;AddProductName&quot;, sSharingRatePlanName);
						pInputs1.SetProperty(&quot;DeleteProductName&quot;, oAssetBC.GetFieldValue(&quot;VF Rate Plan&quot;));
						svc1.InvokeMethod(&quot;RunProcess&quot;, pInputs1, pOutputs1);
					}
				}
				else if (sSharingPropId != &quot;&quot; &amp;&amp; sChangeLOC != &quot;Y&quot; &amp;&amp; sFCNBNFTTPInterim != &quot;Y&quot;)
				{
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					
					psInputs.SetProperty(&quot;Order Header Id&quot;, strOrderId);
					psInputs.SetProperty(&quot;Upgrade Flag&quot;, &quot;TRUE&quot;);
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;SIS OM Transplant Service to Order Line Item&quot;);
					psInputs.SetProperty(&quot;RowId&quot;, oAssetBC.GetFieldValue(&quot;Service Account Id&quot;));
					psInputs.SetProperty(&quot;Account&quot;, oAssetBC.GetFieldValue(&quot;Service Account&quot;));
					psInputs.SetProperty(&quot;Billing Account&quot;, oAssetBC.GetFieldValue(&quot;Billing Account&quot;));
					psInputs.SetProperty(&quot;Billing Account Id&quot;, oAssetBC.GetFieldValue(&quot;Billing Account Id&quot;));
					psInputs.SetProperty(&quot;Service Account&quot;, oAssetBC.GetFieldValue(&quot;Service Account&quot;));
					psInputs.SetProperty(&quot;Price List&quot;, oAssetBC.GetFieldValue(&quot;Service Account Price List&quot;));
					psInputs.SetProperty(&quot;Root Asset Id&quot;, oAssetBC.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;Asset Currency Code&quot;, oAssetBC.GetFieldValue(&quot;Asset Currency Code&quot;));
					psInputs.SetProperty(&quot;Asset Integration Id&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
					psInputs.SetProperty(&quot;Cfg Latest Released Flag&quot;, oAssetBC.GetFieldValue(&quot;Cfg Latest Released Flag&quot;));
					psInputs.SetProperty(&quot;Product Def Type Code&quot;, oAssetBC.GetFieldValue(&quot;Product Def Type Code&quot;));
					psInputs.SetProperty(&quot;Method Invoked&quot;, &quot;VFModify&quot;);
					psInputs.SetProperty(&quot;New Product Id&quot;, sSharingPropId);					
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
					if(sSharingRatePlanName != &quot;&quot;)
					{
						pInputs1 = TheApplication().NewPropertySet();
						pOutputs1 = TheApplication().NewPropertySet();
						svc1 = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						pInputs1.SetProperty(&quot;ProcessName&quot;, &quot;VHA Sharing Modify Workflow&quot;);
						pInputs1.SetProperty(&quot;Object Id&quot;, strOrderId);
						pInputs1.SetProperty(&quot;SharingIntegId&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
						pInputs1.SetProperty(&quot;AddProductName&quot;, sSharingRatePlanName);
						pInputs1.SetProperty(&quot;New Proposition&quot;, &quot;Y&quot;);
						svc1.InvokeMethod(&quot;RunProcess&quot;, pInputs1, pOutputs1);
					}
				}
				//SATHISH - 23-02-24 Added below for Fibre Upgrade Drop2 change loc flow
				else if (sFCNBNFTTPInterim == &quot;Y&quot; &amp;&amp; sFCInterimPropId != &quot;&quot;)
				{
					//throw(&quot;here&quot;+&quot;:&quot;+ sFCInterimPropId);
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					
					psInputs.SetProperty(&quot;Order Header Id&quot;, strOrderId);
					psInputs.SetProperty(&quot;Upgrade Flag&quot;, &quot;TRUE&quot;);
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;SIS OM Transplant Service to Order Line Item&quot;);
					psInputs.SetProperty(&quot;RowId&quot;, oAssetBC.GetFieldValue(&quot;Service Account Id&quot;));
					psInputs.SetProperty(&quot;Account&quot;, oAssetBC.GetFieldValue(&quot;Service Account&quot;));
					psInputs.SetProperty(&quot;Billing Account&quot;, oAssetBC.GetFieldValue(&quot;Billing Account&quot;));
					psInputs.SetProperty(&quot;Billing Account Id&quot;, oAssetBC.GetFieldValue(&quot;Billing Account Id&quot;));
					psInputs.SetProperty(&quot;Service Account&quot;, oAssetBC.GetFieldValue(&quot;Service Account&quot;));
					psInputs.SetProperty(&quot;Price List&quot;, oAssetBC.GetFieldValue(&quot;Service Account Price List&quot;));
					psInputs.SetProperty(&quot;Root Asset Id&quot;, oAssetBC.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;Asset Currency Code&quot;, oAssetBC.GetFieldValue(&quot;Asset Currency Code&quot;));
					psInputs.SetProperty(&quot;Asset Integration Id&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
					psInputs.SetProperty(&quot;Cfg Latest Released Flag&quot;, oAssetBC.GetFieldValue(&quot;Cfg Latest Released Flag&quot;));
					psInputs.SetProperty(&quot;Product Def Type Code&quot;, oAssetBC.GetFieldValue(&quot;Product Def Type Code&quot;));
					psInputs.SetProperty(&quot;Method Invoked&quot;, &quot;VFModify&quot;);
					psInputs.SetProperty(&quot;New Product Id&quot;, sFCInterimPropId);
					psInputs.SetProperty(&quot;FCCLInterimFlag&quot;, &quot;Y&quot;);
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
					/*if(sFCInterimPlan != &quot;&quot;)
					{
						pInputs1 = TheApplication().NewPropertySet();
						pOutputs1 = TheApplication().NewPropertySet();
						svc1 = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						pInputs1.SetProperty(&quot;ProcessName&quot;, &quot;VHA Sharing Modify Workflow&quot;);
						pInputs1.SetProperty(&quot;Object Id&quot;, strOrderId);
						pInputs1.SetProperty(&quot;SharingIntegId&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
						pInputs1.SetProperty(&quot;AddProductName&quot;, sFCInterimPlan);
						pInputs1.SetProperty(&quot;New Proposition&quot;, &quot;Y&quot;);
						svc1.InvokeMethod(&quot;RunProcess&quot;, pInputs1, pOutputs1);
					}*/
				}
				
				var sEnableMSO = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;ENABLE_PEGAMSO&quot;); //CMID
				if(sEnableMSO==&quot;Y&quot;)
				{
					var sPegaRPCWF = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;PEGA_RPC_WF&quot;);
					if(sPegaRPCWF==&quot;Y&quot;)
					{
						var sPegaWF = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						var psInputs12 = TheApplication().NewPropertySet();
						var psOutputs12 = TheApplication().NewPropertySet();
						psInputs12.SetProperty(&quot;ProcessName&quot;, &quot;VHA Pega MSO RPC WF&quot;);
						psInputs12.SetProperty(&quot;IntegrationId&quot;, oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
						psInputs12.SetProperty(&quot;OrderId&quot;, strOrderId);
						psInputs12.SetProperty(&quot;SessionId&quot;, strSessionId);
						sPegaWF.InvokeMethod(&quot;RunProcess&quot;, psInputs12, psOutputs12);
					}
					else
					{
						var svcUpg = TheApplication().GetService(&quot;VF Upgrade Postpaid BS TBUI&quot;); 
						var psIn10 = TheApplication().NewPropertySet();
						var psOut10 = TheApplication().NewPropertySet();
						psIn10.SetProperty(&quot;Custom Asset Integration Id&quot;,oAssetBC.GetFieldValue(&quot;Integration Id&quot;));
						psIn10.SetProperty(&quot;Order Id&quot;,strOrderId);	
						svcUpg.InvokeMethod(&quot;Get Root Order Item Id&quot;,psIn10,psOut10);
						var sRootOrderItemId = psOut10.GetProperty(&quot;Root Order Item Id&quot;);
						var sRootLineItemIntId = psOut10.GetProperty(&quot;RootLineItemIntId&quot;);
						
						var svcPega = TheApplication().GetService(&quot;VHA Pega Order Validation BS&quot;); 
						var psIn11 = TheApplication().NewPropertySet();
						var psOut11 = TheApplication().NewPropertySet();
						psIn11.SetProperty(&quot;RootOrderItemId&quot;,sRootOrderItemId);
						psIn11.SetProperty(&quot;OrderId&quot;,strOrderId);	
						psIn11.SetProperty(&quot;SessionId&quot;,strSessionId);
						svcPega.InvokeMethod(&quot;AddTBUIMSMSOPegaOffer&quot;,psIn11,psOut11);
					}

				}
				irec = oAssetBC.NextRecord();

				

				}
				
			}
		}
	}
	
	catch(e)
	{
		throw e;
	}
	finally
	{
		svc1 = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		bsInvokeWorkflow = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		svc = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		oAssetBC = null;
		oAssetBO = null;
	}
}"
			   SEQUENCE="15"
			   UPDATED="05/06/2025 04:36:25"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpdateLineitems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnUpdateLineitems(sOrderId,GroupId,sGroupName,sharLeadIntId,sharLeadMSISDN)
{
  try
  {
		  var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		  var psInputs = TheApplication().NewPropertySet();
		  var psOutputs = TheApplication().NewPropertySet();
		  var psOutputs1 = TheApplication().NewPropertySet();
		  var iNoOfParent,sGroupId,sSharingAction,sLead;
		
		  
		  psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VHA Order Line Items - Sharing Thin.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VHA Order Line Items - Sharing Thin.Parent Order Item Id] IS NULL&quot;);
		  psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Sharing Order Item IO&quot;);
		  bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		  var sParentType = psOutputs.GetChild(0).GetChild(0).GetType();
		  
		     if(sParentType == &quot;ListOfVHA Sharing Order Item IO&quot;)
		     {
			      iNoOfParent = psOutputs.GetChild(0).GetChild(0).GetChildCount();
			
			      if(iNoOfParent &gt; 0)
			      {
				       for (var i = 0; i &lt; iNoOfParent; i++) 
				       {
					        sGroupId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Group Id&quot;);
					        sSharingAction = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Sharing Action Calc&quot;);
					        sLead = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Is Lead&quot;);
					        if(sSharingAction != &quot;&quot;)
							{
					         	if(sSharingAction == &quot;Add Member&quot;)
					         	{
					         		psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Group Id&quot;,GroupId);
					         	}
					         		psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;VHA Sharing  Group Name&quot;,sGroupName);
					         		if(sLead == &quot;Y&quot; &amp;&amp; sSharingAction == &quot;Remove Member&quot;)
					         		{
					         		psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;,&quot;Sharing Remove Lead&quot;);
					         		}
					         		else
					         		{
					         		psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Action&quot;,sSharingAction);
					         		}
					         	if(sGroupId == &quot;&quot;)
					        	{
					         		psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;VF Sharing Asset&quot;,&quot;Y&quot;); 
									psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing Lead MSISDN&quot;,sharLeadMSISDN);
									psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Sharing New Lead MSISDN&quot;,sharLeadIntId);
					        	}
							}
					        
				       }
			      }
		     }
		 bsEAIService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psOutputs1); 
 }
 catch(e)
 {
 	throw(e);
 } 
 finally
 {
 	bsEAIService = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
 }   
}"
			   SEQUENCE="16"
			   UPDATED="06/28/2024 18:49:20"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpdateSharingDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnUpdateSharingDetails(Inputs,Outputs)
{
	try
	{
		var strGroupId = Inputs.GetProperty(&quot;GroupId&quot;);
		var strBillingAccountid = Inputs.GetProperty(&quot;BillingAccountid&quot;);
		var strSharingAction = Inputs.GetProperty(&quot;SharingAction&quot;);
		var strAssetId = Inputs.GetProperty(&quot;AssetId&quot;);
		var strNewLeadMSISDN = Inputs.GetProperty(&quot;NewLeadMSISDN&quot;);
		var strLeadMSISDN = Inputs.GetProperty(&quot;LeadMSISDN&quot;);
		var strOldAssetId = Inputs.GetProperty(&quot;OldAssetId&quot;);
		var strOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
		if(strOldAssetId == &quot;&quot;)
		{
			strOldAssetId	= &quot;XXXX&quot;;
		}
		var oSharingGroupBO = TheApplication().GetBusObject(&quot;VHA Sharing Account BO&quot;);
		var oBillingAccBC = oSharingGroupBO.GetBusComp(&quot;VF Billing Account&quot;);
		var oAssetBC = oSharingGroupBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
		var oGroupBC = oSharingGroupBO.GetBusComp(&quot;VHA Sharing Group&quot;);
		var sSearchspec = &quot;&quot;;
		var sLeadIntegrationId = &quot;XXXX&quot;;
		var sCount = &quot;&quot;;
		var irec = &quot;&quot;;
		var strGroupAssetId = &quot;&quot;;
		var sMSISDN = &quot;&quot;;
		var sNewLeadIntegrationId = &quot;&quot;;
		var sSharingDebug = &quot;&quot;;
		var dtRequestDate = new Date();
		var sysdate = (dtRequestDate.getMonth() + 1) + &quot;/&quot; + dtRequestDate.getDate() + &quot;/&quot; + dtRequestDate.getFullYear() + &quot; &quot; + dtRequestDate.getHours() + &quot;:&quot; + dtRequestDate.getMinutes() + &quot;:&quot; + dtRequestDate.getSeconds();
		
		
		if(strGroupId != &quot;&quot;)
		{
			oGroupBC.ActivateField(&quot;Lead Integeration Id&quot;);
			oGroupBC.ClearToQuery();
			oGroupBC.SetSearchSpec(&quot;Id&quot;,strGroupId);
			oGroupBC.ExecuteQuery(ForwardOnly);
			if(oGroupBC.FirstRecord())
			{
				sLeadIntegrationId = oGroupBC.GetFieldValue(&quot;Lead Integeration Id&quot;);
			}
		}
	
	
		if(strSharingAction == &quot;Add Member&quot;)
		{
			sSearchspec = &quot;([Id] = &apos;&quot; + strAssetId + &quot;&apos; OR [Integration Id] = &apos;&quot; + sLeadIntegrationId + &quot;&apos;) AND [Parent Asset Id] IS NULL&quot;;
			//sSearchspec = &quot;[Sharing Select] = &apos;Y&apos; AND [Parent Asset Id] IS NULL&quot;;
		}
		if(strSharingAction == &quot;Remove Member&quot;)
		{
			sSearchspec = &quot;[Sharing Group Id] = &apos;&quot; + strGroupId + &quot;&apos; AND [Parent Asset Id] IS NULL&quot;;
			if(strOrderType == &quot;Change Proposition&quot;)
			{
				sSearchspec = &quot;[Sharing Group Id] = &apos;&quot; + strGroupId + &quot;&apos; AND [Status] = &apos;Active&apos; AND [Parent Asset Id] IS NULL&quot;;
			}
			fnGroupDismantle (Inputs,Outputs);
		}
		
		if(strBillingAccountid !=&quot;&quot; &amp;&amp; strGroupId != &quot;&quot; &amp;&amp; sSearchspec != &quot;&quot;)
		{
			oBillingAccBC.SetViewMode(AllView);
			oAssetBC.ActivateField(&quot;Sharing Group Id&quot;);
			oAssetBC.ActivateField(&quot;Sharing Select&quot;);
			oAssetBC.ActivateField(&quot;MSISDN&quot;);
			oAssetBC.ActivateField(&quot;Integration Id&quot;);
			oAssetBC.ActivateField(&quot;Last Sharing Date&quot;);
			oBillingAccBC.ClearToQuery();
			oBillingAccBC.SetSearchSpec(&quot;Id&quot;,strBillingAccountid);
			oAssetBC.SetSearchExpr(sSearchspec);
			oBillingAccBC.ExecuteQuery(ForwardOnly);
			if(oBillingAccBC.FirstRecord() &amp;&amp; oAssetBC.FirstRecord())
			{
				sCount = oAssetBC.CountRecords();
				irec = oAssetBC.FirstRecord();
				while(irec)
				{
					strGroupAssetId = oAssetBC.GetFieldValue(&quot;Id&quot;);
					sMSISDN = oAssetBC.GetFieldValue(&quot;MSISDN&quot;);
					if(strSharingAction == &quot;Add Member&quot;)
					{
						oAssetBC.SetFieldValue(&quot;Sharing Group Id&quot;,strGroupId);
						oAssetBC.SetFieldValue(&quot;Sharing Select&quot;,&quot;&quot;);
						oAssetBC.SetFieldValue(&quot;Last Sharing Date&quot;,sysdate);
					}
					if(strSharingAction == &quot;Remove Member&quot; &amp;&amp; (strGroupAssetId == strAssetId || strGroupAssetId == strOldAssetId))
					{
						oAssetBC.SetFieldValue(&quot;Sharing Group Id&quot;,&quot;&quot;);
						oAssetBC.SetFieldValue(&quot;Last Sharing Date&quot;,sysdate);
					}
					if(strSharingAction == &quot;Remove Member&quot; &amp;&amp; sCount &lt;= 2 &amp;&amp; Inputs.GetProperty(&quot;DismantleGroup&quot;) == &quot;Y&quot; &amp;&amp; strGroupAssetId != strAssetId &amp;&amp; strGroupAssetId != strOldAssetId)
					{
						oAssetBC.SetFieldValue(&quot;Sharing Group Id&quot;,&quot;&quot;);
						oAssetBC.SetFieldValue(&quot;Last Sharing Date&quot;,sysdate);
					}
					if(strSharingAction == &quot;Remove Member&quot; &amp;&amp; strNewLeadMSISDN != &quot;&quot; &amp;&amp; strLeadMSISDN != &quot;&quot; &amp;&amp; sMSISDN != &quot;&quot; &amp;&amp; strNewLeadMSISDN == sMSISDN)
					{
						sNewLeadIntegrationId = oAssetBC.GetFieldValue(&quot;Integration Id&quot;);
					}
					oAssetBC.WriteRecord();
					irec = oAssetBC.NextRecord();
				}
				sSharingDebug = &quot;Inputs: GroupId-&quot; + strGroupId + &quot;|BillingAccountid- &quot; + strBillingAccountid + &quot;|SharingAction- &quot; +strSharingAction + &quot;|AssetId- &quot; + strAssetId +&quot;|Searchspec- ([Id] =  &quot;+ strAssetId +&quot; OR [Integration Id] = &quot;+ sLeadIntegrationId +&quot; ) AND [Parent Asset Id] IS NULL |sCount- &quot; + sCount;
				Outputs.SetProperty(&quot;SharingDebug&quot;,sSharingDebug);
			}
			oGroupBC.ActivateField(&quot;Sharing Status&quot;);
			oGroupBC.ActivateField(&quot;Lead Integeration Id&quot;);
			oGroupBC.ClearToQuery();
			oGroupBC.SetSearchSpec(&quot;Id&quot;,strGroupId);
			oGroupBC.ExecuteQuery(ForwardOnly);
			if(oGroupBC.FirstRecord())
			{
				if(strSharingAction == &quot;Add Member&quot;)
					oGroupBC.SetFieldValue(&quot;Sharing Status&quot;,&quot;Active&quot;);
				if(strSharingAction == &quot;Remove Member&quot; &amp;&amp; sCount &lt;= 2 &amp;&amp; Inputs.GetProperty(&quot;DismantleGroup&quot;) == &quot;Y&quot;)
					oGroupBC.SetFieldValue(&quot;Sharing Status&quot;,&quot;Inactive&quot;);
				if(strSharingAction == &quot;Remove Member&quot; &amp;&amp; strNewLeadMSISDN != &quot;&quot; &amp;&amp; strLeadMSISDN != &quot;&quot; &amp;&amp; sNewLeadIntegrationId != &quot;&quot;)
					oGroupBC.SetFieldValue(&quot;Lead Integeration Id&quot;,sNewLeadIntegrationId);
					
				oGroupBC.WriteRecord();
			}
		}
	}
	
	catch(e)
	{
		throw e;
	}
	finally
	{
		oGroupBC = null;
		oAssetBC = null;
		oBillingAccBC = null;
		oSharingGroupBO = null;
	}
}"
			   SEQUENCE="17"
