			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetCoverageDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetCoverageDetails(Inputs, Outputs)
{
	try
	{
		
		var sFWAOldId = Inputs.GetProperty(&quot;FWAOldAddrId&quot;);
		var sSessionId = Inputs.GetProperty(&quot;SessionId&quot;);

		var bcCov = TheApplication().GetBusObject(&quot;VF Coverage Check&quot;).GetBusComp(&quot;VF Coverage Check&quot;);
		
		with(bcCov)
		{					 
	
			SetViewMode(AllView);
			ClearToQuery();						
			ActivateField(&quot;Latitude&quot;);
			ActivateField(&quot;Longitude&quot;);
			ActivateField(&quot;Asset Id&quot;);
			SetSearchSpec(&quot;Asset Id&quot;,sSessionId);
			SetSortSpec(&quot;Created (DESCENDING)&quot;);										
		    ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				Outputs.SetProperty(&quot;Latitude&quot;,GetFieldValue(&quot;Latitude&quot;));	
				Outputs.SetProperty(&quot;Longitude&quot;,GetFieldValue(&quot;Longitude&quot;));						
			}
			else
			{	
					
				var sAddrBC = TheApplication().GetBusObject(&quot;VHA Account BO&quot;).GetBusComp(&quot;VHA CUT Address&quot;);
				if(sFWAOldId != &quot;&quot;)
				{
				with(sAddrBC)
				{	
						 
					
					SetViewMode(AllView);
					ClearToQuery();						
					ActivateField(&quot;Longitude&quot;);
					ActivateField(&quot;Latitude&quot;);
					SetSearchSpec(&quot;Id&quot;,sFWAOldId);										
				    ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						Outputs.SetProperty(&quot;Latitude&quot;,GetFieldValue(&quot;Latitude&quot;));	
						Outputs.SetProperty(&quot;Longitude&quot;,GetFieldValue(&quot;Longitude&quot;));
					}
				  }
				}
			}
		}
									
	}
	catch(e)
	{	
		
		throw(e);
	}
	finally
	{
		sAddrBC = null;
		
	}
} 


  

