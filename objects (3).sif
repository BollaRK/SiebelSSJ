			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnValidatePostpayIdDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnValidatePostpayIdDetails(Inputs,Outputs)
{
	try
	{
		var ActiveView = Inputs.GetProperty(&quot;ActiveView&quot;);
		var sCallDVS = Inputs.GetProperty(&quot;CallDVSTransaction&quot;);
		var sMedCardDVSSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EnableDVSForMC&quot;);
		var sErrMsg = &quot;&quot; ,sAction = &quot;&quot; ,sContactId = &quot;&quot;,sIDType = &quot;&quot;,sView =&quot;&quot;,sIdTypeCalc = &quot;&quot;,sReferenceNum = &quot;&quot;,sMaxLimRchd = &quot;&quot;;
		// Check for Existing Id with Same Id Type
		if(ActiveView!=&quot;VHA Capture Same Id Details View&quot;)
		{
			sErrMsg = fnCheckForExistingId(Inputs);
		}

		if(sErrMsg == &quot;&quot; || sErrMsg == null)
			sErrMsg = fnFieldValidations(Inputs);
		if(sErrMsg == &quot;&quot; || sErrMsg == null)
		{
			fnPostpayValidationDts(Inputs,Outputs);
			sErrMsg = Outputs.GetProperty(&quot;ErrMsg&quot;);				
		}
		Outputs.SetProperty(&quot;ErrMsg&quot;,sErrMsg);

		if((Inputs.GetProperty(&quot;IDType&quot;) == &quot;Medicare Card&quot; || Inputs.GetProperty(&quot;IDType&quot;) == &quot;Green Medicare Card&quot;) &amp;&amp; Inputs.GetProperty(&quot;Action&quot;) == &quot;CaptureIdTBC&quot; &amp;&amp; sMedCardDVSSwitch == &quot;N&quot; &amp;&amp; fnQueryDLAvailable(Inputs)== &quot;Y&quot;)
		{
				Outputs.SetProperty(&quot;CallDVSTransaction&quot;,&quot;N&quot;);
				Outputs.SetProperty(&quot;DVSOverAllSts&quot;,&quot;DVSDisabled&quot;);
				Outputs.SetProperty(&quot;DVSStatus&quot;,&quot;DVSDisabled&quot;);
		}
		else if((Outputs.GetProperty(&quot;MaxLimRchd&quot;) == &quot;Y&quot; || sCallDVS == &quot;N&quot;) &amp;&amp; (Inputs.GetProperty(&quot;Action&quot;) != &quot;CaptureConId&quot;))
		{
			Outputs.SetProperty(&quot;CallDVSTransaction&quot;,&quot;N&quot;);
			Outputs.SetProperty(&quot;DVSOverAllSts&quot;,&quot;DVSDisabled&quot;);
			Outputs.SetProperty(&quot;DVSStatus&quot;,&quot;DVSDisabled&quot;);
		}
		else
		{
			Outputs.SetProperty(&quot;CallDVSTransaction&quot;,sCallDVS);
			Outputs.SetProperty(&quot;DVSOverAllSts&quot;,Inputs.GetProperty(&quot;DVSOverAllSts&quot;));
			Outputs.SetProperty(&quot;DVSStatus&quot;,Inputs.GetProperty(&quot;DVSStatus&quot;));
		}

		var sDLId = Inputs.GetProperty(&quot;Id_LicenseNumber&quot;);
		if(sDLId != &quot;&quot; &amp;&amp; sDLId != null)
			Outputs.SetProperty(&quot;Id_LicenseNumber&quot;,sDLId.toUpperCase());

	} 
	catch (e) 
	{
		throw(e);
	}
	finally 
	{
		sIDType = null;

	}
}"
