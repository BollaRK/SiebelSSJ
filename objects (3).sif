			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepaymentDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepaymentDetails(Inputs, Outputs)
{
 try
 {

  //balajiM created for 19.3 - 6/29/2019
  var oBO = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);
  var oPrepayBC = oBO.GetBusComp(&quot;VHA Prepayment Credit Card Details&quot;);
  var oOrderEntryBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
  var oPrepayXMBC = oOrderEntryBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
  var oOrderBO = TheApplication().GetBusObject(&quot;VHA Order Entry Thin BO&quot;);
  var oOrderBC = oOrderBO.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;); 
   var sPrepaymentId = Inputs.GetProperty(&quot;Prepayment Id&quot;);

  var sBillingId = &quot;&quot;, sOrderId = &quot;&quot;, sCustName, sOrderNum; 
  var sToPrepayAmtSur = 0, sUpfrontAmount = 0, sSurchargeAmt = 0, sTotalprep = 0, sRemainingPrep = 0;
  with(oPrepayBC)
  {
		   SetViewMode(AllView);
		   ClearToQuery();
		   SetSearchSpec(&quot;Id&quot;, sPrepaymentId );
		   ExecuteQuery(ForwardOnly);  
		   
		   var irec= FirstRecord();
		   if(FirstRecord())
		   {  
		    sOrderId  = GetFieldValue(&quot;Order Id&quot;);
            if (sOrderId != &quot;&quot;)
            { 
	            with(oPrepayXMBC)
	            {
	               ActivateField(&quot;PP Amount Paid Upfront&quot;);
                   ActivateField(&quot;Surcharge Amount&quot;);
                  ActivateField(&quot;Total Prepayment&quot;);
	               SetViewMode(AllView);
			       ClearToQuery();
                   SetSearchSpec(&quot;Order Id&quot;, sOrderId);
                   ExecuteQuery(ForwardOnly);
                   var srec = FirstRecord();
					if (FirstRecord())
					{

                       sUpfrontAmount = GetFieldValue(&quot;PP Amount Paid Upfront&quot;);
                      sTotalprep = GetFieldValue(&quot;Total Prepayment&quot;);
                      sRemainingPrep = ToNumber(sTotalprep) - ToNumber(sUpfrontAmount);
                      
					}
	            }
              
              with(oOrderBC)
	            {
	               ActivateField(&quot;Order Number&quot;);
	               SetViewMode(AllView);
			       ClearToQuery();
	               SetSearchSpec(&quot;Id&quot;, sOrderId);
                   ExecuteQuery(ForwardOnly);
                   var srec = FirstRecord();
					if (FirstRecord())
					{
					  sOrderNum = GetFieldValue(&quot;Order Number&quot;);
					}
	            }
               
           } 
        
        Outputs.SetProperty(&quot;OrderNumber&quot;,sOrderNum);
        //Outputs.SetProperty(&quot;PrepaymentAmount&quot;,sToPrepayAmtSur);
        Outputs.SetProperty(&quot;AmountAllocated&quot;,sUpfrontAmount);
        Outputs.SetProperty(&quot;MPPAPPContractAmount&quot;,sTotalprep);
        Outputs.SetProperty(&quot;MPPAPPContractRemaining&quot;,sRemainingPrep);
     }
  }
  
  }
  
 catch(e)
 {
  throw(e);
 }
 finally
 {
  oPrepayBC = null;
  oPrepayXMBC = null;
  oOrderBC = null;
  oBO = null;
  oOrderEntryBO = null;
  oOrderBO = null;
 }
}"
