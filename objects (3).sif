			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="LogException"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function LogException(ErrorMsg,FunctionName,ObjectId)
{
 
	try
	{ 
		 var sErrorMessage;
		 var bsError;
		 var psErrIn;
		 var psErrOut;
		 bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		 psErrIn = TheApplication().NewPropertySet();
		 psErrOut = TheApplication().NewPropertySet();
		 psErrIn.SetProperty(&quot;SourceName&quot;, &quot;VHA CID Sync Data from Pega BS&quot;);
		 psErrIn.SetProperty(&quot;FunctionName&quot;, FunctionName);
		 psErrIn.SetProperty(&quot;Error Message&quot;,ErrorMsg);
		 //psErrIn.SetProperty(&quot;Error Code&quot;,&quot;10604&quot;);
		 psErrIn.SetProperty(&quot;Order Id&quot;,ObjectId);
		 psErrIn.SetProperty(&quot;Notes&quot;,ErrorMsg.substring(0,399));
		 bsError.InvokeMethod(&quot;LogException&quot;, psErrIn, psErrOut);
	}// end of try
	catch(e)
	{
		 /* Define Error */
		 if(!defined(e.errText))
		 {
		  sErrorMessage = e.toString();
		 }
		 else
		 {
		     sErrorMessage = e.errText;
		    }
		 throw(sErrorMessage);
	}
	finally
	{
		 /* Destroy Objects */
		 psErrIn = null;
		 psErrOut = null;
		 bsError = null;
	}
}"
