			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mQueryOLI"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mQueryOLI(Inputs, Outputs)
{
	/* * Component Name      : VF Postpay Utilities TBUI
	 * Method Name           : 	mQueryOLI
	 * Component Information : 
	 * Modification History  :
	 * Date			Author		Config #	  Description
	 * ============ ===========	===========	  ==========================================================
	   23/10/2014   ROSELINE   	Created for INC000010663275	 */	
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var boOrders = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrderLineItems = boOrders.GetBusComp(&quot;VF Order Line Item - Light&quot;);
		with(bcOrderLineItems)
		{		
			SetViewMode(AllView);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;VF Port In TBUI&quot;);
			ActivateField(&quot;VF Port In - Service Account TBUI&quot;);
			ActivateField(&quot;VF Port In - Service Number TBUI&quot;);
			ActivateField(&quot;VF Port In - DOB TBUI&quot;);
			ActivateField(&quot;VF IMEI TBUI&quot;);
			ActivateField(&quot;VF Handset Id TBUI&quot;);
			ActivateField(&quot;VF Handset Code TBUI&quot;);
			ActivateField(&quot;VF Device TBUI&quot;);
			ActivateField(&quot;VF ConnectionType&quot;);
			ActivateField(&quot;VF SIM TBUI&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;Product&quot;);
			ActivateField(&quot;VF MSISDN TBUI&quot;);
			ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			ClearToQuery();
			var searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
			SetSearchExpr(searchst);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				Outputs.SetProperty(&quot;BillAccId&quot;, GetFieldValue(&quot;Billing Account Id&quot;));
				Outputs.SetProperty(&quot;VF Port In TBUI&quot;, GetFieldValue(&quot;VF Port In TBUI&quot;));
				Outputs.SetProperty(&quot;VF Port In ServiceAccount&quot;, GetFieldValue(&quot;VF Port In - Service Account TBUI&quot;));
				Outputs.SetProperty(&quot;VF Port In MSISDN&quot;, GetFieldValue(&quot;VF Port In - Service Number TBUI&quot;));
				Outputs.SetProperty(&quot;VF Port In DOB&quot;, GetFieldValue(&quot;VF Port In - DOB TBUI&quot;));
				Outputs.SetProperty(&quot;VF IMEI TBUI&quot;, GetFieldValue(&quot;VF IMEI TBUI&quot;));
				Outputs.SetProperty(&quot;VF Handset Id TBUI&quot;, GetFieldValue(&quot;VF Handset Id TBUI&quot;));
				Outputs.SetProperty(&quot;VF Handset Code TBUI&quot;, GetFieldValue(&quot;VF Handset Code TBUI&quot;));
				Outputs.SetProperty(&quot;VF Device TBUI&quot;, GetFieldValue(&quot;VF Device TBUI&quot;));
				Outputs.SetProperty(&quot;VF ConnectionType&quot;, GetFieldValue(&quot;VF ConnectionType&quot;));
				Outputs.SetProperty(&quot;SIM&quot;, GetFieldValue(&quot;VF SIM TBUI&quot;));
				Outputs.SetProperty(&quot;RootOrderItemId&quot;, GetFieldValue(&quot;Root Order Item Id&quot;));
				Outputs.SetProperty(&quot;Product&quot;, GetFieldValue(&quot;Product&quot;));
				Outputs.SetProperty(&quot;MSISDN&quot;, GetFieldValue(&quot;VF MSISDN TBUI&quot;));
				Outputs.SetProperty(&quot;VF Stock Indicator TBUI&quot;, GetFieldValue(&quot;VF Stock Indicator TBUI&quot;));	
			}
		}//with
	}
	catch(e)
	{
		throw(e)
	}
	finally
	{
		bcOrderLineItems = null;
		boOrders = null;
	}
}"
