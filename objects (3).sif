			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCancelSIMSwap"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCancelSIMSwap(Inputs, Outputs)
{
	try
	{
		var psInputs,psOutputs,bsInvokeWorkflow,psInputsChild;
		//var sRequestId = Inputs.GetProperty(&quot;RequestId&quot;);
		//var sSIMType = Inputs.GetProperty(&quot;SIM Type&quot;);
		//var sConfirmationCode = Inputs.GetProperty(&quot;Confirmation Code&quot;);
		//var sICCID = Inputs.GetProperty(&quot;ICCID&quot;);
		
		var sSIMType = TheApplication().GetProfileAttr(&quot;VHASIMType&quot;);
		var sConfirmationCode = TheApplication().GetProfileAttr(&quot;VHAConfirmationCode&quot;);
		var sRequestId = TheApplication().GetProfileAttr(&quot;VHARequestId&quot;);
		var sICCID = TheApplication().GetProfileAttr(&quot;VHAICCID&quot;);
		var sActivationCode = TheApplication().GetProfileAttr(&quot;VHAActivationCode&quot;); //Added by sachi 20/02/2020 for eSIM Simplification
		
		var sSIMTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
		var sComponent = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Component&quot;);
		var sMode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Mode&quot;);
		
		if(sSIMType == sSIMTypeLOV &amp;&amp; sICCID != null &amp;&amp; sICCID != &quot;&quot; &amp;&amp; sRequestId != null &amp;&amp; sRequestId != &quot;&quot; &amp;&amp; sConfirmationCode != null &amp;&amp; sConfirmationCode != &quot;&quot;)
		{
			var psInputs = TheApplication().NewPropertySet();
			var psInputsChild = TheApplication().NewPropertySet();
			var psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;Component&quot;, sComponent);
			psInputs.SetProperty(&quot;Mode&quot;, sMode);
			psInputsChild.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
			psInputsChild.SetProperty(&quot;SuppressError&quot;,&quot;Y&quot;);
			psInputsChild.SetProperty(&quot;RequestId&quot;, sRequestId);
			psInputsChild.SetProperty(&quot;Action Code&quot;, &quot;Deallocate&quot;);
			psInputsChild.SetProperty(&quot;OrderSubType&quot;, &quot;SIM Swap&quot;);
			psInputsChild.SetProperty(&quot;Confirmation Code&quot;,sConfirmationCode);
			psInputsChild.SetProperty(&quot;ICCID&quot;,sICCID);
			psInputsChild.SetProperty(&quot;Activation Code&quot;,sActivationCode); //Added by sachi 20/02/2020 for eSIM Simplification
			psInputs.AddChild(psInputsChild);
			bsInvokeWorkflow = TheApplication().GetService(&quot;Server Requests&quot;);
			bsInvokeWorkflow.InvokeMethod(&quot;SubmitRequest&quot;, psInputs, psOutputs);
		}
	}
	catch(e)
	{
		//throw(e);
	}
	finally
	{
		TheApplication().SetProfileAttr(&quot;VHASIMType&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;VHAConfirmationCode&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;VHARequestId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;VHAICCID&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;VHAActivationCode&quot;,&quot;&quot;);  //Added by sachi 20/02/2020 for eSIM Simplification
		bsInvokeWorkflow = null;
	}
}"
