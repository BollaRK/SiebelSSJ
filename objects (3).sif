			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateBuscomp"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...  
function mUpdateBuscomp(Inputs, Outputs)
{
	var sBuscomp=null,sBusobject=null,boActive=null,bcActive=null,delimiter = &quot;&quot;,fieldNameList=&quot;&quot;;
	var fieldNameArr=null,fieldValueList=&quot;&quot;, fieldValueArr=null,searchExp=&quot;&quot;,isRecord=null,mc=0;
	try
	{
		sBuscomp = Inputs.GetProperty(&quot;BusCompName&quot;);
		sBusobject = Inputs.GetProperty(&quot;BusObjectName&quot;);
		delimiter=Inputs.GetProperty(&quot;Delimeter&quot;);
		if(delimiter == &quot;&quot; || delimiter == null)
			delimiter = &quot;;&quot;;
		fieldNameList = Inputs.GetProperty(&quot;FieldName&quot;);
		fieldValueList = Inputs.GetProperty(&quot;FieldValue&quot;);
		searchExp = Inputs.GetProperty(&quot;SearchExp&quot;);
		boActive = TheApplication().GetBusObject(sBusobject);
		bcActive = boActive.GetBusComp(sBuscomp);	
		fieldNameArr = fieldNameList.split(delimiter);
		fieldValueArr = fieldValueList.split(delimiter);
		with (bcActive)
		{
			ClearToQuery();
			SetViewMode(AllView);
			for (var m=0;m&lt;fieldNameArr.length;m++)
			{
				ActivateField(fieldNameArr[m]);
			}
			SetSearchExpr(searchExp);
			ExecuteQuery(ForwardOnly);
			mc=0;
			isRecord = FirstRecord();
			while(isRecord)
			{
				for(var k=0;k&lt;fieldNameArr.length;k++)
				{ 
					SetFieldValue(fieldNameArr[k],fieldValueArr[k]);
					//WriteRecord();
				}
				WriteRecord();
				mc++;
				isRecord = NextRecord();
			}
		}
		Outputs.SetProperty(&quot;NumAffRows&quot;,mc);
	}
	catch(e)
	{ 
		throw e;
	}
	finally
	{
		sBuscomp=null;
		mc=null;
		sBusobject=null;
		boActive=null;
		bcActive=null;
		delimiter = null;
		fieldNameList=null;
		fieldNameArr=null;
		fieldValueList=null;
		fieldValueArr=null;
		searchExp=null;
		isRecord=null;
	}
}
"
