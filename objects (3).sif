			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInvokePostConfiguration"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInvokePostConfiguration(Inputs, bsOutputs)
{
	/*
	* Component Name        : 	mSetNotificationRO
	* Method Name           : 	
	* Component Information : 	Checks for order line item MSO orders if notification msisdn flag is checked
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 24/03/2015	Subramanaian			For aggregated alerts
	*/
	
	try
	{
		TheApplication().Trace(&quot;CheckNotification:mCheckNotification&quot;);
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		//var sType = Inputs.GetProperty(&quot;TransactionType&quot;);
		var sCustAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Item Task Simple&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;VF Order Item Task Simple&quot;);
		 /* Subramanian 2.2.2015: Added write record to write the flag value even if the user does not step off the record 
		TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;Order Entry - Line Items&quot;).WriteRecord(); -- Not required.*/
		var sErrorFlg = &quot;&quot;;
		with(bcOrder)
		{
				SetViewMode(AllView);
				ClearToQuery();
				var Searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND ([Notification MSISDN] = &apos;Y&apos;)&quot;;
				SetSearchExpr(Searchst);
				ExecuteQuery(ForwardBackward);
				if(FirstRecord())
				{
					sErrorFlg = &quot;N&quot;;
					bsOutputs.SetProperty(&quot;RaiseError&quot;, sErrorFlg);
				}
				else
				{
					sErrorFlg = &quot;Y&quot;;
						bsOutputs.SetProperty(&quot;RaiseError&quot;, sErrorFlg);
				}
				
		}
	
	}
	catch (e)
	{
		throw e;
	}
	finally
	{

		
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		bcOrder = null;
		boOrder = null;
		bsOutputs = null;
		

	}
}"
			   SEQUENCE="6"
			   UPDATED="08/17/2021 21:36:31"
			   UPDATED_BY="SADMIN"
			   CREATED="04/20/2015 02:05:56"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetNotificationRO"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetNotificationRO(Inputs, Outputs)
{
	/*
	* Component Name        : 	mSetNotificationRO
	* Method Name           : 	
	* Component Information : 	Sets notification msisdn column in order line item RO if notification method is email
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 24/03/2015	Subramanaian						Initial Version - Cloned from VF Wizard Utilities
	*/
	var bcBillingProfile, bcAccount;
	var sCustomerType;
	var sOrderId;
	var sAccountId;
	var sMakeRO = &quot;N&quot;;
	var sNotificationMethod = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_NOTFCTN_TYPE&quot;,&quot;TXT&quot;);
	try
	{
		var boCurrent = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		//bcAccount = boCurrent.GetBusComp(&quot;Account&quot;);
		var bcFinanProf = boCurrent.GetBusComp(&quot;VF Com Invoice Profile TBUI&quot;);
		//bcBillingProfile = boCurrent.GetBusComp(&quot;VF Billing Account TBUI&quot;);
		
		sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);

		//bcFinanProf.ActivateField(&quot;Notification Method&quot;);
		with(bcFinanProf)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchExpr(&quot;[Account Id] = &apos;&quot;+sAccountId+&quot;&apos; AND [Notification Method] = &apos;Email&apos;&quot;); 		
			ExecuteQuery(ForwardOnly); 
			if(FirstRecord())
			{
				sMakeRO = &quot;Y&quot;;
				Outputs.SetProperty(&quot;MakeRO&quot;,sMakeRO);
			}
			else
			{
				sMakeRO = &quot;N&quot;;
				Outputs.SetProperty(&quot;MakeRO&quot;,sMakeRO);
			}
		}
	}
	catch (e)
	{
		Outputs.SetProperty(&quot;ErrMsg&quot;,  e);
	}
	finally
	{
		//bcAccount = null;
		bcFinanProf = null;
	 	//bcBillingProfile = null;
 		boCurrent = null;
	}
		
}"
			   SEQUENCE="7"
