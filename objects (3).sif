			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPlanName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPlanName(Inputs,Outputs)
{
	try
	{
		var sOrderSubType = Inputs.GetProperty(&quot;Order Sub Type&quot;);
		var sRegenerateQR = Inputs.GetProperty(&quot;Regenerate QR Code&quot;);
		var sRequestId = Inputs.GetProperty(&quot;Request Id&quot;);
		var sPlanName = &quot;&quot;;
		var bo, bc;
		var	sTemplateName = &quot;&quot;;
		
		if(sOrderSubType == &quot;SIM Swap&quot; || sOrderSubType == &quot;UPGRADE&quot;) // Changed for Atom Phase2 SIT defect#445
			sTemplateName = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_QR_TEMPLATE&quot;,&quot;SIMSwap&quot;);
		else
			sTemplateName = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_QR_TEMPLATE&quot;,&quot;NonSIMSwap&quot;);
	
		if(sOrderSubType == &quot;SIM Swap&quot; || sRegenerateQR == &quot;Y&quot;)
		{
			bo = TheApplication().GetBusObject(&quot;VF Asset Mgmt - Asset  Thin&quot;)
			bc = bo.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
			with(bc)
			{
				ActivateField(&quot;VF Rate Plan&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[Id] = &apos;&quot;+sRequestId+&quot;&apos;&quot;);
				ExecuteQuery();
				if(FirstRecord())
					sPlanName = GetFieldValue(&quot;VF Rate Plan&quot;);
			}
		}
		else
		{
			bo = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
			bc = bo.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
			with(bc)
			{
				ActivateField(&quot;Product&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[Root Order Item Id] = &apos;&quot;+sRequestId+&quot;&apos; AND [Primary Product Flag] = &apos;Y&apos; AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
				ExecuteQuery();
				if(FirstRecord())
					sPlanName = GetFieldValue(&quot;Product&quot;);
			}
		}
		Outputs.SetProperty(&quot;Plan Name&quot;,sPlanName);
		Outputs.SetProperty(&quot;Template Name&quot;,sTemplateName);
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
		bc = null;
		bo = null;
	}
}"
