			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{

	/*
	 * Component Name        : 	VF Applet Wizard Utilities
	 * Method Name           : 	PreInvokeMethod
	 * Component Information : 	\
	 *							 
	 *
	 * Modification History  :
	 * Date			Author		Config #	Description
	 * ============ ===========	===========	================================
	 */

	try
	{
		var psErrorInput;
		var psErrorOutput;
		var bsError;
		var strErrorMessage = &quot;&quot;;

		switch (MethodName)	
		{	
		    

			//Kalidas:18/07/2019:Code added to Prepayment 19.3 Drop3
			case &quot;DeletePrepayment&quot;:
				mDeletePrepayment(Inputs,Outputs);
				break;
			case &quot;ValidateContactRole&quot;:
				mCheckCustomerRole(Inputs,Outputs);
				break;
								
			case &quot;SubmitOrder&quot;:
				mSubmitOrder (Inputs, Outputs);
				break;
				
			case &quot;SetProfileAttr&quot;:
				mSetProfileAttr (Inputs, Outputs);
				break;
				
			case &quot;SSJSetProfileAttr&quot;:
				mSSJSetProfileAttr (Inputs, Outputs);
				break;
							
			case &quot;PostComplete&quot;:
				mPostComplete (Inputs, Outputs);
				break;
			/*Subramanian - Added to make the notification read only if Email*/	
			case &quot;SetNotificationRO&quot; :
			    mSetNotificationRO (Inputs, Outputs);
			    break;
			/**Subramanian 7/7/15: Added for PKE000000022349 - Generate POP Gets hanged
			*Method call to get the Integration Id using Asset Id from the IMEI History view in cases where there is no 
			order id/number associated to the IMEI */
			case &quot;GeneratePOP&quot; :
				mGenPop (Inputs,Outputs);
				break;
					    
			case &quot;CallSubmitOrder&quot;:
				mCallSubmitOrder (Inputs, Outputs);
				break;

			case &quot;CallSubmitOrderPrepayments&quot;:
			mCallSubmitOrderPrepayments (Inputs, Outputs);
			break;
			
			case &quot;UpdatePIN&quot;:
				mUpdatePIN (Inputs, Outputs);
				break;
				
			case &quot;ValidateMPPContract&quot;:
				mValidateMPPContract (Inputs, Outputs);
				break;
				
			case &quot;ValidateOrder&quot;:
				mValidateOrder (Inputs, Outputs);
				break;
				
			case &quot;ValidateCustomerDetails&quot;:
				mValidateCustomerDetails (Inputs, Outputs);
				break;

			case &quot;ValidateIDDetails&quot;:
				mValidateIDDetails (Inputs, Outputs);
				break;
				
			case &quot;ValidateContactDetails&quot;:
				mValidateContactDetail (Inputs, Outputs);
				break;
				
			case &quot;ValidateCreditCheckDetail&quot;:
				mValidateCreditCheckDetail (Inputs, Outputs);
				break;
			
			case &quot;ValidateBillingDetail&quot;:
				mValidateBillingDetail (Inputs, Outputs);
				break;
			
			case &quot;SetCustomerBillSegmentDefault&quot;:
				mSetCustomerBillSegmentDefault (Inputs, Outputs);
				break;
				
			case &quot;ValidateApproveMPPLimit&quot;:
				mValidateApproveMPPLimit (Inputs, Outputs);
				break;	
				
			case &quot;ValidateServiceDetails&quot;:
				mValidateServiceDetails (Inputs, Outputs);
				break;		
	
			case &quot;ValidateEmail&quot;:
				var emailAddress = Inputs.GetProperty(&quot;ShipEmailId&quot;);
				mValidateEmail(emailAddress); // Sri :Added for Email Validation
				break;	
					
				//Roseline : Added for UNISIM Defect# 1208	
			case &quot;ValidateUNISIMCustomerDetails&quot;:
				mValidateUNISIMCustomerDetails (Inputs, Outputs);
				break;
			case &quot;CheckProductRatePlan&quot;:
			   mCheckProductRatePlan (Inputs, Outputs); //Vinoth:Added for PKE21674
			   break; 
			 case &quot;ValidateShippingDetails&quot;:
				mValidateShippingDetail(Inputs, Outputs); //Aarthi:Added for T&amp;T2
				break;
			 case &quot;InsertEquipment&quot;:	//NIRMAL : Added for PKE000000037492
				fnInsertEquipment(Inputs); 
				break;
			case &quot;ValidatePhoneNumber&quot;:
				var strNumber = Inputs.GetProperty(&quot;PhoneNumber&quot;);
				var strFieldName = Inputs.GetProperty(&quot;FieldName&quot;);
				var sUniSIMFlg = Inputs.GetProperty(&quot;UniSIMFlag&quot;);
				mValidatePhoneNumber(strNumber,strFieldName,sUniSIMFlg);								
				break;
			case &quot;SetDOM&quot;://VHA Muthushankari 9/9/2017 - Added for R17.4B Freedom CIR
				mSetDOM(Inputs, Outputs);
				break;
			case &quot;ValidateKoganIdDetails&quot;:
				mValidateKoganIdDetails(Inputs, Outputs);
				break;
			case &quot;UpdatePrepayments&quot;:
				mPrepaymentsOrderUpdate(Inputs, Outputs);
				break;
			case &quot;ValidateCustomerAccount&quot;:        //Ravindra: 30/Sep/2024: Added for imagine project.
				mValidateCustomerAccount(Inputs, Outputs);
				break;
			case &quot;DigitalEmailCheck&quot;:        //Ravindra: 02/Jan/2025: Added for imagine project.
				mDigitalEmailCheck(Inputs, Outputs);
				break;
			case &quot;CheckPrePayBillingExists&quot;:        //Ravindra: 02/Jan/2025: Added for imagine project.
				mCheckPrePayBillingExists(Inputs, Outputs);
				break;
			case &quot;CheckPostPayBillingExists&quot;:        //Ravindra: 02/Jan/2025: Added for imagine project.
				mCheckPostPayBillingExists(Inputs, Outputs);
				break;
			default :
				break;
		}
		return (CancelOperation);
	}
	catch (e)
	{
		//TARIQ - 18/JUL/2014 - Commented the below block and added the new one
		/*if(e.errText != &quot;&quot;)
		{
			strErrorMessage = e.errText;
		}
		else
		{
			strErrorMessage = e.toString();
		}*/
		if (defined(e.errText))
		{
			strErrorMessage = e.errText; 
		}
		else
		{
			strErrorMessage = ToString(e); 
		}


	/*	psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Wizard Utilities&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;Service_PreInvokeMethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strErrorMessage); 

		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		bsError.InvokeMethod(&quot;HandleException&quot;, psErrorInput,psErrorOutput);*/ // commented for Defect #1192
		TheApplication().RaiseErrorText(strErrorMessage);	
		//BASUA - End
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;	
	}
}"
