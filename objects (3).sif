			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CallCalculateChargeForQuoteChild"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CallCalculateChargeForQuoteChild(Inputs, Outputs)
{
	var qtBC = null, qtRecord = null, QuoteId=&quot;&quot;, wfBS = null, wfInp=null, wfOut = null;
	try
	{
		QuoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		if(QuoteId != &quot;&quot; &amp;&amp; QuoteId != null)
		{
			qtBC = TheApplication().GetBusObject(&quot;VF Order Header&quot;).GetBusComp(&quot;VF Order Header&quot;);
			wfBS = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			wfInp = TheApplication().NewPropertySet();
			wfOut = TheApplication().NewPropertySet();
			with(qtBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;QuoteId&quot;);
				SetSearchSpec(&quot;QuoteId&quot;, QuoteId);
				ExecuteQuery(ForwardOnly);
				qtRecord = FirstRecord();
				while(qtRecord)
				{
					wfInp.Reset();
					wfOut.Reset();
					wfInp.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Calculate Charges&quot;);
					wfInp.SetProperty(&quot;SkipNavigation&quot;, &quot;TRUE&quot;);
					wfInp.SetProperty(&quot;SSJFlag&quot;, &quot;Y&quot;);
					wfInp.SetProperty(&quot;OrderId&quot;, GetFieldValue(&quot;Id&quot;));
					wfInp.SetProperty(&quot;Object Id&quot;, GetFieldValue(&quot;Id&quot;));
					wfBS.InvokeMethod(&quot;RunProcess&quot;,wfInp, wfOut);
					qtRecord = NextRecord();
				}
	
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		qtBC = null;
		qtRecord = null;
		QuoteId=null;
		wfBS = null;
		wfInp=null;
		wfOut = null;
	}
}"
