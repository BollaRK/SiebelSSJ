			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInheritCustomerAddressToBilling"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInheritCustomerAddressToBilling( Inputs, Outputs )
{
/*
 * Component Name        : 	VF Address Toolkit Service
 * Method Name           : 	mInheritCustomerAddressToBilling
 * Component Information : 	
 *
 * Modification History  :
 * Date			Author		Config #	  Description
 * ============ ===========	===========	  ==========================================================
21/7/2014   MURALIDHARANK   FOR TBUI Address
 */	
  try
 {		

	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Address Toolkit Service.mInheritCustomerAddressToBilling&quot;);
	}
	//*************************************************************************************
	// Declare Variables
	//*************************************************************************************	
	
	var psErrorInput;
	var psErrorOutput;
	var bsError;
	var sErrorMessage;
	
	var idBillAccount;
	var idCustAccount;
	var idAddress;
	
	var boAccount;
	var boAccountCus;
	var bcAddress;
	var bcAccount;
	var bcCutAddress;
	var bcCutAddressInter;
	
	var boBilling;
	var bcBilling;
	
	var strAttenTo;
	var dStartDT;
	var dEndDT;	
	
	
	//*************************************************************************************
	// Get Input Property
	//*************************************************************************************	
	idBillAccount = Inputs.GetProperty( &quot;BillingAccountId&quot; );
	if ( idBillAccount == &quot;&quot; )
	{
		throw (TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;10335&quot;));
	}

	//*************************************************************************************
	// Get Customer Account Id from Billing Account
	//*************************************************************************************	
	
	boBilling = TheApplication().GetBusObject( &quot;VF Billing Account&quot; );
	bcBilling = boBilling.GetBusComp( &quot;VF Billing Account&quot; );
	
	bcBilling.ClearToQuery();
	bcBilling.ActivateField( &quot;Master Account Id&quot; );
	bcBilling.ActivateField( &quot;Primary Address Id&quot; );
	bcBilling.SetViewMode( AllView );
	bcBilling.SetSearchSpec( &quot;Id&quot;, idBillAccount );
	bcBilling.ExecuteQuery( ForwardOnly );
	
	if ( !bcBilling.FirstRecord() )
	{
		throw (TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;10336&quot;));
	}	
	
	idCustAccount = bcBilling.GetFieldValue( &quot;Master Account Id&quot; );

	
	//*************************************************************************************
	// Get Parent Account and its Primary Address Id
	//*************************************************************************************	
	boAccount = TheApplication().GetBusObject( &quot;Account&quot; );
	bcAccount = boAccount.GetBusComp( &quot;Account&quot; );
	
	bcAccount.ClearToQuery()
	bcAccount.ActivateField( &quot;Primary Address Id&quot; );
	bcAccount.SetViewMode( AllView );
	bcAccount.SetSearchSpec( &quot;Id&quot;, idCustAccount );
	bcAccount.ExecuteQuery( ForwardOnly );
	
	if ( !bcAccount.FirstRecord() )
	{
		throw (TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;10336&quot;));
	}
	
	idAddress = bcAccount.GetFieldValue( &quot;Primary Address Id&quot; );
	
	//*************************************************************************************
	// Get Customer Primary Address and make a copy of it.
	//*************************************************************************************	
	bcCutAddress = boAccount.GetBusComp( &quot;CUT Address&quot; );

	bcCutAddress.ClearToQuery();
	bcCutAddress.SetViewMode( AllView );
	bcCutAddress.ActivateField(&quot;Attention to&quot;);
	bcCutAddress.ActivateField(&quot;Start Date&quot;);
	bcCutAddress.ActivateField(&quot;End Date&quot;);	
	bcCutAddress.SetSearchSpec( &quot;Id&quot;, idAddress );
	bcCutAddress.ExecuteQuery( ForwardBackward );
	
	if ( !bcCutAddress.FirstRecord() )
	{
		throw (TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;99314&quot; ));
	}
	
	strAttenTo = bcCutAddress.GetFieldValue(&quot;Attention to&quot;);
	dStartDT = bcCutAddress.GetFieldValue(&quot;Start Date&quot;);
	dEndDT = bcCutAddress.GetFieldValue(&quot;End Date&quot;);	
	
	//added code to fix defect 6575 - when the primary address record is copied,
	//a new record was being added to s_con_addr for CA and new 
	//address, resulting in both address records showing up under CA
	
	boAccountCus = TheApplication().GetBusObject( &quot;Account&quot; );
	bcAddress = boAccountCus.GetBusComp( &quot;CUT Address&quot; );
	with (bcAddress)
	{
		ClearToQuery();
		SetViewMode( AllView );		
		SetSearchSpec( &quot;Id&quot;, idAddress );
		//DF2568 VF Huik 11/07/08 SetUserProperty 
		SetUserProperty(&quot;IsCopyRecord&quot;, &quot;Y&quot;); 
		ExecuteQuery();	
		NewRecord( 3 ); // NewAfterCopy
		WriteRecord();		
	}
	
	
	
	//bcCutAddress.NewRecord( 3 ); // NewAfterCopy
	//bcCutAddress.WriteRecord();
	
	//*************************************************************************************
	// Create intersection between Billing Account and the new address
	//*************************************************************************************	
	bcCutAddressInter = boAccount.GetBusComp( &quot;Com Account Address Intersection&quot; );
	
	bcCutAddressInter.NewRecord( NewAfter );
	bcCutAddressInter.SetFieldValue(&quot;Attention to&quot;,strAttenTo);
	bcCutAddressInter.SetFieldValue(&quot;Start Date&quot;,dStartDT);
	bcCutAddressInter.SetFieldValue(&quot;End Date&quot;,dEndDT);	
	bcCutAddressInter.SetFieldValue( &quot;Account Id&quot;, idBillAccount ); 
	//bcCutAddressInter.SetFieldValue( &quot;Address Id&quot;, bcCutAddress.GetFieldValue( &quot;Id&quot; ) );
	bcCutAddressInter.SetFieldValue( &quot;Address Id&quot;, bcAddress.GetFieldValue( &quot;Id&quot; ));
	bcCutAddressInter.WriteRecord();
	
	//*************************************************************************************
	// Set Primary Address Id on the Billing Account
	//*************************************************************************************	
	bcBilling.SetFieldValue( &quot;Primary Address Id&quot;, bcAddress.GetFieldValue( &quot;Id&quot; ) );
	bcBilling.WriteRecord();
	
 } 
 catch(e)
 {
	if(gErrorMessage != &quot;&quot;)
	{
		// Error Handling
		sErrorMessage = &quot;VF Address Toolkit Service.mInheritCustomerAddressToBilling: &quot; + gErrorMessage;
		gErrorMessage = &quot;&quot;;
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Address Toolkit Service&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;mInheritCustomerAddressToBilling&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	else
	{
		if (!defined(e.errText))
		{
			e.errText = ToString(e);
		}
		sErrorMessage = e.errText;
	}
	
	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Address Toolkit Service.mInheritCustomerAddressToBilling.Error: &quot; + sErrorMessage);
	}

 }
 finally
 {
		/*Below variables are nullified by JAGJIT on 22/03/2019*/
		bcAccount = null;
		bcAddress = null;
		bcBilling = null;
		bcCutAddress = null;
		bcCutAddressInter = null;
		boAccount = null;
		boAccountCus = null;
		boBilling = null;
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
		  //end 22/03/2019
	// Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Address Toolkit Service.mInheritCustomerAddressToBilling&quot;);
	}		

 }
}"
