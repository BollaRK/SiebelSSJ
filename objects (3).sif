			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...
function fnValidateLoyalty(Inputs,Outputs)
{
	try
	{
		var sOfferBO =TheApplication().GetBusObject(&quot;VF CAT Offer Management&quot;);
		var sOfferBC = sOfferBO.GetBusComp(&quot;VHA Offer Report&quot;);
		var sOfferId=Inputs.GetProperty(&quot;OfferId&quot;);
		var sAstId=Inputs.GetProperty(&quot;AstIntId&quot;);
		Outputs.SetProperty(&quot;Status&quot;, &quot;Valid&quot;);

		with(sOfferBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Reward Type&quot;);
			SetSearchSpec(&quot;Offer History Id&quot;,sOfferId);
			SetSearchSpec(&quot;Asset Integration Id&quot;,sAstId);        
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				if(GetFieldValue(&quot;Reward Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;SPL_RATE_LIST_TYPE&quot;,&quot;Loyalty Discount&quot;))
					Outputs.SetProperty(&quot;Status&quot;, &quot;Invalid&quot;);
			 
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOfferBC = null;
		sOfferBO = null;
	}
}
  
