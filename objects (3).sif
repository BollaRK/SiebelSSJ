			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	try
	{
		switch(MethodName)
		{
			case &quot;GetParentOrderId&quot;:
			var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			var sConnectOrdId =	mGetParentOrderId(sOrderId);
			Outputs.SetProperty(&quot;ConnectOrderId&quot;,sConnectOrdId);
			break;
			
			case &quot;CalculatePrepayments&quot;:
			mCalculatePrepayments(Inputs, Outputs);
			break;
			
			case &quot;GetPrepaymentDetails&quot;:
			mGetPrepaymentDetails(Inputs, Outputs);
			break;
			
			case &quot;UpfrontPrepayment&quot;:
			mUpfrontPrepayment(Inputs, Outputs);
			break;
			
			case &quot;RecalculatePrepayment&quot;:
			mRecalculatePrepayment(Inputs, Outputs);
			break;
			
			case &quot;DeleteCCDetails&quot;:
			mDeleteCCDetails(Inputs, Outputs);
			break;
			
			case &quot;QueryPrepayment&quot;:
			mQueryPrepayment(Inputs, Outputs);
			break;
			
			case &quot;GetBillingStatus&quot;:
			mGetBillAccStatus(Inputs, Outputs);
			break;
			
			case &quot;UpdateDevicePP&quot;:
				mUpdateTotalDevicePP (Inputs,Outputs);
				break;
		    
		    case &quot;UpgradeUpdateDevicePP&quot;:
				mUpgradeUpdateTotalDevicePP (Inputs,Outputs);
				break;
				
			case &quot;APPPrepayAmtAllocation&quot;:
				mAPPPrepayAmtAllocation (Inputs,Outputs);
				break;

			case &quot;APPCalculate&quot;:
				mAPPCalculate (Inputs,Outputs);
				break;

			case &quot;APPNextValidations&quot;:
				mAPPNextValidations (Inputs,Outputs);
				break;
				
			case &quot;mUpdCred&quot;:
 				mUpdCred(Inputs, Outputs);
 				break;

 			case &quot;UpdGPPContract&quot;:	
 				mUpdGPPContract(Inputs, Outputs);
 				break;		
    			
    		case &quot;UpdAPPContract&quot;:	
 				mUpdAPPContract(Inputs, Outputs);
 				break;
 				
 			case &quot;ValidateTerminateMPPGPP&quot;:	
 				mValidateTerminateMPPGPP(Inputs, Outputs);
 				break;
 				
			case &quot;MPPPrepaymentAllocation&quot;:
				mMPPPrepaymentAllocation(Inputs,Outputs);
				break;
				
			case &quot;ZeroDollarContract&quot;:
				mZeroDollarContract(Inputs,Outputs);
				break;
			
			case &quot;APPAttribUpdate&quot;:
				mAPPAttribUpdate(Inputs,Outputs);
				break;
				
			case &quot;CalcRemEL&quot;:
				mCalcRemEL(Inputs,Outputs);
				break;
				
			case &quot;ValidateAPPTerm&quot;:
				mValidateAPPContractTerm(Inputs, Outputs);
				break;
				
			case &quot;UpdateAPPAttrUpg&quot;:
				mUpgradeAPPAttrUpdate(Inputs,Outputs);
				break;
			
			case &quot;RefreshCCDetails&quot;:
				mRefreshCreditCadrdDetails(Inputs,Outputs);
				break;
				
			case &quot;DeletePPRecords&quot;:
				mDeletePrepayments(Inputs,Outputs);
				break;

			case &quot;PrepaymentsOLS&quot;:
				mPrepaymentsOLS(Inputs,Outputs);
				break;	
				
			case &quot;PrepaymentsOrderUpdate&quot;:
				mPrepaymentsOrderUpdate(Inputs, Outputs);
				break;

			case &quot;DeletePrepaymentContracts&quot;:
				mDeletePrepaymentContracts(Inputs, Outputs);
				break;

			//28/05/2021: Added as a part of P3: Tallyman Issue.
			case &quot;UpdateServiceOrderId&quot;:
				mUpdateServiceOrderId(Inputs, Outputs);
				break;
				
			default:
			break;
		}
		return (CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}

	return (ContinueOperation);
}"
