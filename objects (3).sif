			   SEQUENCE="11"
			   UPDATED="05/04/2026 15:12:14"
			   UPDATED_BY="ANGANAD"
			   CREATED="09/04/2024 22:53:49"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateFWAOverrideValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateFWAOverrideValidation(Inputs,Outputs) 
{
var bcOrder = &quot;&quot;,bcName = &quot;&quot;,bcDFAName = &quot;&quot;,QuoteId = &quot;&quot;,sLoginName = &quot;&quot;,FwaNetwork = &quot;&quot;;
try 
	{
	
	QuoteId = Inputs.GetProperty(&quot;OrderId&quot;);
	
	var sCovType4G = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;SPL_RATE_LIST_TYPE&quot;,&quot;VFAUPostPayFWA4G&quot;);
	var sCovType5Gnsa = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;SPL_RATE_LIST_TYPE&quot;,&quot;VFAUPostPayFWA5GNSA&quot;);
	bcOrder = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
    
    bcDFAName = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VFDfa Order Entry Line Items Thin BC&quot;);
	with (bcOrder) 
		{
            SetViewMode(AllView);
            ActivateField(&quot;Quote Id&quot;);
            ActivateField(&quot;Parent Order Id&quot;);
            ActivateField(&quot;Order Sub Type&quot;);
            ActivateField(&quot;VF Order Function&quot;);
            ClearToQuery();
            SetSearchExpr(&quot;[Quote Id] = &apos;&quot; + QuoteId + &quot;&apos; OR [Parent Order Id] = &apos;&quot; + QuoteId + &quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			chldOrdrecord = FirstRecord();
            if (chldOrdrecord) 
			{
                while (chldOrdrecord) 
				{
                    ChildOrderId = GetFieldValue(&quot;Id&quot;); // connect order row-id
                    
                    with (bcDFAName) 
					{
                        //query for root line items
                        SetViewMode(AllView);
                        ActivateField(&quot;Order Header Id&quot;);
                        ActivateField(&quot;Action Code&quot;);
                        ActivateField(&quot;Parent Order Item Id&quot;);
                        ActivateField(&quot;Special Rating List Type&quot;);
						ActivateField(&quot;FWA Override User Id&quot;);
                        ClearToQuery();
                        SetSearchExpr(&quot;[Order Header Id] = &apos;&quot; + ChildOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
						
                        ExecuteQuery(ForwardOnly);
                        Frecord = FirstRecord();
                        while (Frecord) 
						{
                           
							FwaNetwork = GetFieldValue(&quot;Special Rating List Type&quot;);
							
							if(FwaNetwork == sCovType4G || FwaNetwork == sCovType5Gnsa)
							{
							  sLoginName = TheApplication().GetProfileAttr(&quot;Login Name&quot;);
							  SetFieldValue(&quot;FWA Override User Id&quot;,sLoginName);
							  WriteRecord();
							}
							 Frecord = NextRecord();
						}
					}

					chldOrdrecord = NextRecord();
				}
			}
		}
	
	}
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        ChildOrderId = null;
        lovSwitch = null;
        bcName = null;
        Frecord = null;
        bcDFAName = null;
        bcOrder = null;
        bcAttr = null;
    }
}"
			   SEQUENCE="12"
			   UPDATED="05/04/2026 15:12:14"
