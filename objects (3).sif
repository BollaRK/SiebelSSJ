			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mIndexOf"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF String Utilities
 * Method Name           : 	mIndexOf
 * Component Information : 	This function is simply the String.indexOf method
 *							
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 21/09/2006	DFiggis					Initial Version
 * 19/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages.
 */
function mIndexOf(Inputs, Outputs)
{

	//***************************************
	//* Constants and Variables
	//***************************************
	var strOffSet;
	var strSubString;
	var strText;
	var intIndexOf = &quot;-1&quot;;	

	try
	{
		strOffSet    = Inputs.GetProperty(&quot;OffSet&quot;);
		strSubString = Inputs.GetProperty(&quot;SubString&quot;);		
		strText      = Inputs.GetProperty(&quot;Text&quot;);	

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF String Utilities.mIndexOf.strOffSet=&quot; + strOffSet + &quot;.strSubString=&quot; + strSubString);
		}
		
		if (strOffSet == &quot;&quot; &amp;&amp; strSubString == &quot;&quot; &amp;&amp; strText == &quot;&quot;)
		{
			throw (&quot;VFError - The input paramater was not specified&quot;);
		}

		//***************************************
		//* Get the Index Of
		//***************************************
		intIndexOf = strText.indexOf(strSubString, strOffSet);		
		
		Outputs.SetProperty(&quot;IndexOf&quot;, intIndexOf);			
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);		
	}
	finally
	{
 		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF String Utilities.mIndexOf.intIndexOf=&quot; + intIndexOf);
		}
	}	
}"
			   SEQUENCE="26"
			   UPDATED="04/29/2026 01:04:25"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="04/29/2026 01:04:25"
			   CREATED_BY="RAVIKUMARB">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mModifyMSISDNformat"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mModifyMSISDNformat(Inputs, Outputs)
{
/*
 * Component Name        : 	VF String Utilities
 * Method Name           : 	mModifyMSISDNformat
 * * Modification History  :
 * Date			Author		Config #	Description              Comments
 * ============ ===========	===========	===============          =================
 * 04/04/2024   SHARAN    eSIM Activation email requirement    To change the format of the MSISDN
 */
	//***************************************
	//* Constants and Variables
	//***************************************
   var sMSISDN;
   var sFrmtdMSISDN;
   
   try
   {
   		sMSISDN= Inputs.GetProperty(&quot;MSISDN&quot;);
		//sFrmtdMSISDN=sMSISDN.substring(2).replace(/(\d{4})(\d{3})(\d{3})/, &apos;0$1 $2 $3&apos;);
		sFrmtdMSISDN=sMSISDN.replace(/^61/, &quot;0&quot;).replace(/(\d{4})(\d{3})(\d{3})/, &quot;$1 $2 $3&quot;);
		Outputs.SetProperty(&quot;FormattedMSISDN&quot;,sFrmtdMSISDN );
		
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);		
	}
	finally
	{
 		
	}
}
"
			   SEQUENCE="27"
