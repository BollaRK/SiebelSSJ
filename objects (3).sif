			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetModemProvisioningSystem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetModemProvisioningSystem(Inputs, Outputs)
{
/*
 * Component Name        :  VHA FBB BS
 * Method Name           :  mGetModemProvisioningSystem
 * Component Information :  This function will check the Modem compatibility matrix against Product Class and return the Modem Provisioning System 
 * Modification History  :
 * Date   Author  Config # Description
 * ============ =========== ===========================================
 * 28-Jan-2025  NROY        Initial version 
 */ 
	try
	{
		var sProductClass = &quot;&quot;;
		var sProvisioningSystem = &quot;&quot;;
		
		var boConfig = TheApplication().GetBusObject(&quot;VHA Configuration List&quot;);
		var bcConfig = boConfig.GetBusComp(&quot;VHA Configuration List&quot;);

		sProductClass = Inputs.GetProperty(&quot;ProductClass&quot;);
		
		if(sProductClass != &quot;&quot; &amp;&amp; sProductClass != null)
		{
			with(bcConfig)
			{
				ClearToQuery();
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;String 2&quot;);
				ActivateField(&quot;String 3&quot;);
				ActivateField(&quot;String 5&quot;);
				ActivateField(&quot;Active Flg&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Type&quot;,&quot;TPGT_MODEM_COMPATIBILITY_MATRIX&quot;);
				SetSearchSpec(&quot;String 2&quot;,sProductClass);
				SetSearchSpec(&quot;String 3&quot;, &quot;Live&quot;);
				SetSearchSpec(&quot;Active Flg&quot;, &quot;Y&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sProvisioningSystem = GetFieldValue(&quot;String 5&quot;);
				}
			}
		}
		
		Outputs.SetProperty(&quot;ModemProvisioningSystem&quot;,sProvisioningSystem);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{ 
		bcConfig = null;
		boConfig = null;
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Date Time Utilities.mGetModemProvisioningSystem&quot;);
		}
	}
}"
