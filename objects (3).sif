			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mZeroDollarContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mZeroDollarContract(Inputs,Outputs)
{
	
try{	
	var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
	var sRootOrderItemId = Inputs.GetProperty(&quot;Root Order Item Id&quot;);
	var sOrderBO = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
	var sOrdBC = sOrderBO.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
	var sLineBC = sOrderBO.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
	var sXA = sOrderBO.GetBusComp(&quot;VF Order Item XA&quot;);
	var sIsRec1 = &quot;&quot;;
	var sIsRec2 = &quot;&quot;;
	var sIsRec3 = &quot;&quot;;
	var sAttrName = &quot;Contract Amount&quot;;
	var sAttrVal = &quot;&quot;;
	var sSaleItemId = &quot;&quot;;
	var sSale = &quot;Sale&quot;;
	var sContAmt = 0;
	var sOrderItemId = &quot;&quot;;
	
	with(sOrdBC)
	{
		ActivateField(&quot;Id&quot;);
		ClearToQuery();
		SetSearchExpr(&quot;[Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
		ExecuteQuery(ForwardOnly);
		sIsRec1 = FirstRecord();
		if(sIsRec1)
		{
			with(sLineBC)
			{
				ActivateField(&quot;Id&quot;);
				ActivateField(&quot;Contract Type&quot;);
				ActivateField(&quot;Root Order Item Id&quot;);
				ClearToQuery();
				if(sRootOrderItemId != &quot;&quot; &amp;&amp; sRootOrderItemId != null)
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Root Order Item Id] = &apos;&quot;+sRootOrderItemId+&quot;&apos;&quot;);
				else
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				sIsRec2 = FirstRecord();
				while(sIsRec2)
				{
					sOrderItemId = GetFieldValue(&quot;Id&quot;);
					with(sXA)
					{
						ActivateField(&quot;Object Id&quot;);
						ActivateField(&quot;Name&quot;);
						ActivateField(&quot;Text Value&quot;);
						ClearToQuery();
						SetSearchExpr(&quot;[Object Id] = &apos;&quot;+sOrderItemId+&quot;&apos; AND [Name] = &apos;&quot;+sAttrName+&quot;&apos; AND [Text Value] = &apos;0&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						sIsRec3 = FirstRecord();
						if(sIsRec3)
						{
														
							sSaleItemId = sOrderItemId;
						}
					
					}
					
					if(sSaleItemId != &quot;&quot; &amp;&amp; sSaleItemId != null)
					{
						
						sSaleItemId = &quot;&quot;;
						SetFieldValue(&quot;Contract Type&quot;, sSale);
						WriteRecord();
						
					}
					sIsRec2 = NextRecord();
				}
			}
			
			
		}
	}
}
	
catch(e)
{

throw(e);
}	

finally
{
	sOrderId = null; 
	 sOrderBO = null; 
	 sOrdBC = null; 
	 sLineBC = null; 
	 sXA = null; 
	 sIsRec1 = null; 
	 sIsRec2 = null; 
	 sIsRec3 = null; 
	 sAttrName = null; 
	 sAttrVal = null; 
	 sSaleItemId = null;
	 sSale = null; 
}
}"
