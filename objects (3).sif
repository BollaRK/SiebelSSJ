			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckOrdSubmtdTwoWaySMSSent"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckOrdSubmtdTwoWaySMSSent(Inputs, Outputs)
{
	var quoteId=&quot;&quot;,ordBC = null,ShowBanner = &quot;N&quot;,sSearchExp = &quot;&quot;, childRec=null,childOrdBC = null;
	try
	{
		quoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		if(quoteId != &quot;&quot; &amp;&amp; quoteId != null)
		{
			ordBC = TheApplication().GetBusObject(&quot;VHA Order - 3 Step Upgrade&quot;).GetBusComp(&quot;VHA Order Header - 3 Step Header&quot;);
			
			with(ordBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Order Status&quot;);
				sSearchExp = &quot;[Id] = &apos;&quot; + quoteId + &quot;&apos;&quot;;
				SetSearchExpr(sSearchExp);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					if(GetFieldValue(&quot;Order Status&quot;) == &quot;Order Submitted&quot;)
					{
						childOrdBC = TheApplication().GetBusObject(&quot;VF Order Header&quot;).GetBusComp(&quot;VF Order Header&quot;);
						with(childOrdBC)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;Status&quot;);
							ActivateField(&quot;QuoteId&quot;);
							ActivateField(&quot;OrdSMSSent&quot;);
							ActivateField(&quot;FulflmntOrdSMSSent&quot;);
							sSearchExp = &quot;[QuoteId] = &apos;&quot; + quoteId + &quot;&apos;&quot;;
							SetSearchExpr(sSearchExp);
							ExecuteQuery(ForwardOnly);
							childRec = FirstRecord();
							if(FirstRecord())
							{
								while(childRec)
								{
									if((GetFieldValue(&quot;OrdSMSSent&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;OrdSMSSent&quot;) != null) || (GetFieldValue(&quot;FulflmntOrdSMSSent&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;FulflmntOrdSMSSent&quot;) != null))
									{
										ShowBanner = &quot;Y&quot;;
										break;
									}
									childRec = NextRecord();
								}
							}
						}
					}
				}		
			}
		}
		Outputs.SetProperty(&quot;ShowBanner&quot;, ShowBanner);	
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		quoteId=null;		
		ShowBanner = null;
		sSearchExp = null;
		childRec=null;
		childOrdBC = null;
		ordBC = null;		
	}
}"
