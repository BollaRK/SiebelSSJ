			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeallocateeSIM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeallocateeSIM(Inputs, Outputs)
{
	try
	{
		var psInputs,psOutputs,bsInvokeWorkflow,psInputsChild;
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sRemoveService = Inputs.GetProperty(&quot;RemoveService&quot;);
		var sRootLineItemId = Inputs.GetProperty(&quot;RootLineItemId&quot;);
        var sVFBulkFlag = Inputs.GetProperty(&quot;VF Bulk Flag&quot;);
		var sSuppressError = &quot;Y&quot;;
		var sSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);
		var sPhysicalSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;Physical&quot;);//Divya added for physical SIM deallocation in Cancel Order Flow.
		var sComponent = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Component&quot;);
		var sMode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DEALLOCATE_ESIM&quot;,&quot;Mode&quot;);
		var sSearchExpr = &quot;&quot;;
		
		if(sRemoveService != &quot;Y&quot;)
		{
			sSearchExpr = &quot;[Order Header Id] = &apos;&quot;+ sOrderId +&quot;&apos; AND [Shipping] = &apos;&quot;+ sSIMType +&quot;&apos; AND [Parent Order Item Id] IS NULL AND [VF SIM TBUI] IS NOT NULL&quot;;
					
			var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items&quot;);
			var bcOrderItem = boOrder.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
			bcOrderItem.ActivateField(&quot;Root Order Item Id&quot;);
			//bcOrderItem.ActivateField(&quot;VF SIM TBUI&quot;);
			bcOrderItem.ActivateField(&quot;Order Sub Type&quot;);
			bcOrderItem.ActivateField(&quot;EID&quot;);
			bcOrderItem.ClearToQuery();
			bcOrderItem.SetSearchExpr(sSearchExpr);
			bcOrderItem.ExecuteQuery();
			var isRecord = bcOrderItem.FirstRecord();
			var eSIMCount= bcOrderItem.CountRecords();
			if(eSIMCount &gt; 0)//Divya added to check the eSIm count
			{
			while(isRecord)
			{
				psInputs = TheApplication().NewPropertySet();
				psInputsChild = TheApplication().NewPropertySet();
				psOutputs = TheApplication().NewPropertySet();
				psInputs.SetProperty(&quot;Component&quot;, sComponent);
				psInputs.SetProperty(&quot;Mode&quot;, sMode);
				psInputsChild.SetProperty(&quot;ProcessName&quot;, &quot;VHA Manage eSIM Process&quot;);
				psInputsChild.SetProperty(&quot;SuppressError&quot;, sSuppressError);
                psInputsChild.SetProperty(&quot;VF Bulk Flag&quot;, sVFBulkFlag);
				psInputsChild.SetProperty(&quot;RequestId&quot;, bcOrderItem.GetFieldValue(&quot;Root Order Item Id&quot;));
				psInputsChild.SetProperty(&quot;EID&quot;, bcOrderItem.GetFieldValue(&quot;EID&quot;));
				psInputsChild.SetProperty(&quot;Action Code&quot;, &quot;Deallocate&quot;);
				psInputsChild.SetProperty(&quot;OrderSubType&quot;, bcOrderItem.GetFieldValue(&quot;Order Sub Type&quot;));
				psInputs.AddChild(psInputsChild);
				bsInvokeWorkflow = TheApplication().GetService(&quot;Server Requests&quot;);
				bsInvokeWorkflow.InvokeMethod(&quot;SubmitRequest&quot;, psInputs, psOutputs);
				isRecord = bcOrderItem.NextRecord();
			}
			}
			//Phsyical SIM deallocation code starts
			
			var sSearchExpression = &quot;[Order Header Id] = &apos;&quot;+ sOrderId +&quot;&apos; AND ( [Shipping] = &apos;&quot;+ sPhysicalSIMType +&quot;&apos; OR [Shipping] IS NULL ) AND [Parent Order Item Id] IS NULL AND [VF SIM TBUI] IS NOT NULL&quot;;
			var boOrderOne = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items&quot;);
			var bcOrderItemOne = boOrderOne.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
			bcOrderItemOne.ActivateField(&quot;Root Order Item Id&quot;);
			bcOrderItemOne.ActivateField(&quot;Order Header Id&quot;);
			//bcOrderItem.ActivateField(&quot;VF SIM TBUI&quot;);
			bcOrderItemOne.ActivateField(&quot;Order Sub Type&quot;);
			bcOrderItemOne.ClearToQuery();
			bcOrderItemOne.SetSearchExpr(sSearchExpression);
			bcOrderItemOne.ExecuteQuery();
			var isRecordOne = bcOrderItemOne.FirstRecord();
			var PhysicalCount= bcOrderItemOne.CountRecords();
			
			if(PhysicalCount &gt; 0)
			{
			while(isRecordOne)
			{
			var sROLID=bcOrderItemOne.GetFieldValue(&quot;Root Order Item Id&quot;);
			var sOrderHeaderId=bcOrderItemOne.GetFieldValue(&quot;Order Header Id&quot;);
			var boOrderSI = TheApplication().GetBusObject(&quot;VF Order Entry - SIM Relationship TBUI&quot;);//Cloned from Order Entry - Line Items BC - mDealloacateSIM()
			var strORDERLISIMREL	= &quot;VF Order Entry - SIM Relationship&quot;;
			var strORDERLIIMSIREL	= &quot;VF Order Entry - IMSI Relationship&quot;;

			if(sROLID != null &amp;&amp; sROLID != &quot;&quot; &amp;&amp; sROLID != &quot;NULL&quot; &amp;&amp; sOrderHeaderId== sOrderId)
			{
			deleteResourceRelationship(boOrderSI, strORDERLISIMREL, sROLID)
			deleteResourceRelationship(boOrderSI, strORDERLIIMSIREL, sROLID)
			
			var psInputs,psOutputs,bsInvokeBS;
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;OrderLineItemId&quot;, sROLID);
			bsInvokeBS = TheApplication().GetService(&quot;VF Postpay Utilities TBUI&quot;);
			bsInvokeBS.InvokeMethod(&quot;NullifySIM&quot;, psInputs, psOutputs);
			}
				isRecordOne = bcOrderItemOne.NextRecord();
			}
			}
			
			
			
		}
		

	}
	catch(e)
	{
		//throw(e);
	}
	finally
	{
		/*Below variables are nullified by GURUPRASAD on 23/10/2019*/
		if(defined(bcOrderItem)) { bcOrderItem = null; }
		if(defined(boOrder)) { boOrder = null; }
		bsInvokeWorkflow = null;
	}
}"
			   SEQUENCE="11"
			   UPDATED="09/19/2022 21:15:12"
			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 20:19:57"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteQRCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteQRCode(Inputs, Outputs)
{
 var psErrorInput, psErrorOutput, sErrorMessage, bsError; 
 try
 {
	var sFileName = &quot;&quot;;
	var sFileFullPath = &quot;&quot;;
	var RetVal = &quot;&quot;;
	var sFilePath = Inputs.GetProperty(&quot;AttachmentFilePath&quot;);
	var sSourceId = Inputs.GetProperty(&quot;Source Id&quot;);

	var boQRCode = TheApplication().GetBusObject(&quot;VHA QR Code Attachement BO&quot;);
	var bcQRCode = boQRCode.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);

	bcQRCode.ClearToQuery();
	bcQRCode.SetSearchExpr(&quot;[Source Id]=&apos;&quot;+sSourceId+&quot;&apos;&quot;);
	bcQRCode.ExecuteQuery();
	if(bcQRCode.FirstRecord())   
	{
		sFileName = bcQRCode.GetFieldValue(&quot;SourceFileName&quot;);
		sFileFullPath = sFilePath + sFileName;
		RetVal = bcQRCode.InvokeMethod(&quot;DeleteFile&quot;,sFileFullPath);
		if( RetVal == &quot;Success&quot;)
			bcQRCode.DeleteRecord();
	}
 }
 catch(e)
 {
	var sErrorMessage;
	if(!defined(e.errText))
	{
		 sErrorMessage = e.toString();
	}
	else
	{
		sErrorMessage = e.errText;
	}
	psErrorInput  = TheApplication().NewPropertySet();
	psErrorOutput = TheApplication().NewPropertySet();
	bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
	psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VHA ATOM eSIM Processing Service&quot;);
	psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;DeleteQRCodeFile&quot;);
	psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
	bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
	sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	TheApplication().RaiseErrorText(e);
 }
 finally
 {  
	bcQRCode = null;
	boQRCode = null;
	return (ContinueOperation);
 } 
}"
			   SEQUENCE="13"
