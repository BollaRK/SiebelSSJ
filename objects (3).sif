			   NAME="mtoUpperCase"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF String Utilities
 * Method Name           : 	mtoUpperCase
 * Component Information : 	This function is simply the String.toUpperCase() method
 *							
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 15/03/2011	RT					Initial Version
 * 19/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages.
 */
function mtoUpperCase(Inputs, Outputs)
{

	//***************************************
	//* Constants and Variables
	//***************************************
	var strText;	

	try
	{
		strText   = Inputs.GetProperty(&quot;Text&quot;);	

		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF String Utilities.mtoUpperCase =&quot; + strText);
		}
		
		if (strText != &quot;&quot;)
		{
			//Convert into Upper Case
			Outputs.SetProperty(&quot;TextUpperCase&quot;, strText.toUpperCase());
		}
				
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);		
	}
	finally
	{
 		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF String Utilities.mtoUpperCase =&quot; + strText);
		}
	}	
}"
