			   UPDATED_BY="SADMIN"
			   CREATED="05/19/2019 20:19:58"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="meSIMValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function meSIMValidation(Inputs,Outputs)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var oBC = oBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
		
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sRecExist = &quot;&quot;, sLineNum = &quot;&quot;, sErrMsg = &quot;&quot;, sErrMSg2 = &quot;&quot;;
		var sVoice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Voice&quot;);
		var sMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;MBB&quot;);
		var seSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;eSIM&quot;);
		var sStockIndicator =  TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
		var sConnectType =  TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SERVICE_STOCK_TBUI&quot;, &quot;SIM Only&quot;);
		var sAccountConnType =  TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Account Level Proposition&quot;);
		//VHA - Guruprasad - 01/01/2020 - Added above variable (sAccountConnType) for PKE#78587
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			with(oBC)
			{
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Shipping&quot;);
				ActivateField(&quot;VF Line Number&quot;);
				ActivateField(&quot;Reservation Id&quot;);
				ActivateField(&quot;Reservation Status&quot;);
				ActivateField(&quot;VF Root Siebel Product Type&quot;);
				ClearToQuery();
				SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [VF ConnectionType] &lt;&gt; &apos;&quot;+sAccountConnType+&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Shipping] IS NULL AND ([VF Root Siebel Product Type] = &apos;&quot;+sVoice+&quot;&apos; OR [VF Root Siebel Product Type] = &apos;&quot;+sMBB+&quot;&apos;)&quot;);
				ExecuteQuery(ForwardOnly);//VHA - Guruprasad - 01/01/2020 - Added above condition ([VF ConnectionType] &lt;&gt; &apos;&quot;+sAccountConnType+&quot;&apos;) for PKE#78587
				sRecExist = FirstRecord();
				if(sRecExist)
				{
					sLineNum = GetFieldValue(&quot;VF Line Number&quot;);	
					if(GetFieldValue(&quot;Reservation Id&quot;)==&quot;&quot; || (GetFieldValue(&quot;Reservation Id&quot;) !=&quot;&quot; &amp;&amp; GetFieldValue(&quot;Reservation Status&quot;) !=&quot;Reserved&quot;))
					sErrMsg = &quot;Line Number:&quot; + sLineNum + &quot; - Please select SIM Type (‘eSIM’ or ‘Physical’).&quot;;
				}			
				else
				{
					ActivateField(&quot;VF Stock Indicator TBUI&quot;);
					ActivateField(&quot;VF ConnectionType&quot;);
					ClearToQuery();
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Shipping] = &apos;&quot;+seSIMType+&quot;&apos; AND [VF Stock Indicator TBUI] = &apos;&quot;+sStockIndicator+&quot;&apos; AND [VF ConnectionType] = &apos;&quot;+sConnectType+&quot;&apos; AND ([VF Root Siebel Product Type] = &apos;&quot;+sVoice+&quot;&apos; OR [VF Root Siebel Product Type] = &apos;&quot;+sMBB+&quot;&apos;)&quot;);
					ExecuteQuery(ForwardOnly)
					sRecExist = FirstRecord();
					if(sRecExist)
					{
						sLineNum = GetFieldValue(&quot;VF Line Number&quot;);			
						sErrMsg = &quot;Line Number:&quot; + sLineNum + &quot; -  eSIM and SIM Only has to be In Stock. Please change Stock Indicator to In Stock and Allocate eSIM.&quot;;
					}
				}
				
				
			}
			if (sErrMsg == &quot;&quot; || sErrMsg == null)
			{
				var psOut = TheApplication().NewPropertySet();		
 				mCheckSIMTypeForIMEIDevice(sOrderId, psOut);
				sErrMSg2 = psOut.GetProperty(&quot;IMEIDeviceError&quot;);
			}
				 
				if (sErrMsg != &quot;&quot;) 
				{	 
					Outputs.SetProperty(&quot;eSIMErr&quot;, sErrMsg);
				}
				else if(sErrMSg2 != &quot;&quot;)
				{
					Outputs.SetProperty(&quot;eSIMErr&quot;, sErrMSg2);
				}
				else
				{
					Outputs.SetProperty(&quot;eSIMErr&quot;, &quot;&quot;);
				}
			
				
		}
	}
	catch(e)
	{
		
	}
	finally
	{
		oBC = null;
		oBO = null;
	}
}"
