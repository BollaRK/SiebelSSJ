			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateDeviceDiscounts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here.. 
function mValidateDeviceDiscounts(sOfferId,Inputs)
{
	try{

		var sReturn = &quot;Valid&quot;;
		var sOrderFunction = Inputs.GetProperty(&quot;OrderFunction&quot;);
		var sUpgOfferType = Inputs.GetProperty(&quot;UpgOfferType&quot;);

		if(sOrderFunction == &quot;UPGRADE&quot; &amp;&amp; sUpgOfferType == &quot;Outright with Every Device&quot;)
		{
			sReturn = &quot;Valid&quot;;
			
		}
		else if(sOrderFunction == &quot;UPGRADE&quot;)
		{
			sReturn = &quot;Invalid&quot;;
			
		}
		else
		{
			sReturn = &quot;Valid&quot;;
		
		}
		
		return(sReturn);
	
	}//end try
	
	catch(e)
	{
	
		throw (e);

	}//end catch
	

} 
"
