			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mQueryPrepayment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mQueryPrepayment(Inputs, Outputs)
{
	
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;OrderSubType&quot;);
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);		
		var sPPAmt = 0;
		var sStatus = &quot;&quot;;
		var sUPIStatus = &quot;&quot;;
		var sPrepayId = &quot;&quot;;
		var sSkipInteg = &quot;N&quot;;
		var UPISkipInt = TheApplication().GetProfileAttr(&quot;UPIFlag&quot;);//Vasavi added for Florida project
		var sSuccess = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_STATUS&quot;,&quot;Success&quot;);
		var sLOVSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_SWITCH&quot;,&quot;CREDIT_CARD_PAYMENT&quot;);
		if(sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{
			if(sOrderSubType == &quot;Fulfilment&quot;)
			{
				sOrderId = mGetParentOrderId(sOrderId);//Suresh G - Added for PKE000000078268
			}
			with(sBC)
			{
			   ActivateField(&quot;PP Amount Paid Upfront&quot;);               
               ActivateField(&quot;Id&quot;);
               ActivateField(&quot;Order Id&quot;);
               ActivateField(&quot;Prepayment Status&quot;);
			   ActivateField(&quot;PaymentStatus&quot;);
               SetViewMode(AllView);
		       ClearToQuery();
               SetSearchSpec(&quot;Order Id&quot;, sOrderId);
               ExecuteQuery(ForwardOnly);
               var srec = FirstRecord();
				if (FirstRecord())
				{
					sPrepayId = GetFieldValue(&quot;Id&quot;);
					sStatus = GetFieldValue(&quot;Prepayment Status&quot;);
					sUPIStatus = GetFieldValue(&quot;PaymentStatus&quot;);
					sPPAmt = GetFieldValue(&quot;PP Amount Paid Upfront&quot;);
					if((sPrepayId != null &amp;&amp; sPrepayId != &quot;&quot;) &amp;&amp; (ToNumber(sPPAmt) == 0 || (sPPAmt == null &amp;&amp; sPPAmt == &quot;&quot;)))
					{
						DeleteRecord();//Delete prepayment record in case of 0 Prepayment
					}
				}
			
			}
		}
				
		if (UPISkipInt == &quot;Y&quot;)		
		{
			if (sUPIStatus != &quot;Approved&quot; &amp;&amp; ToNumber(sPPAmt) &gt; 0 &amp;&amp; (sPrepayId != null &amp;&amp; sPrepayId != &quot;&quot;))
			{
				sSkipInteg = &quot;Y&quot;;
			}
		}
		else 
		{
			if (sStatus != sSuccess &amp;&amp; ToNumber(sPPAmt) &gt; 0 &amp;&amp; (sPrepayId != null &amp;&amp; sPrepayId != &quot;&quot;))
			{
				sSkipInteg = &quot;Y&quot;;
			}
		}
		if(sLOVSwitch == &quot;ON&quot;)
		{ 
			sSkipInteg = &quot;N&quot;;
		}
		
		Outputs.SetProperty(&quot;PrepaymentId&quot;, sPrepayId);
		Outputs.SetProperty(&quot;SkipInteg&quot;, sSkipInteg);
		Outputs.SetProperty(&quot;Prepayment Status&quot;, sStatus);
		Outputs.SetProperty(&quot;ReadytoPay Upfront&quot;, sPPAmt);
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderId = null;
		sBO = null;
		sBC = null;
		sPPAmt = null;
		sStatus = null;
		sPrepayId = null;
		sSkipInteg = null;
		sSuccess = null;
	}
	
	
}"
			   SEQUENCE="21"
			   UPDATED="04/29/2026 19:01:30"
			   UPDATED_BY="VISHALM"
			   CREATED="09/30/2019 11:48:10"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRecalculatePrepayment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mRecalculatePrepayment(Inputs, Outputs)
{
//VHA Prashanth 200519: Called from RTE On Pick of Device/Secondary Device and Accessories.
//TBUI View - Select Proposition &amp; Customize page
//To ensure Next Button is NOT clicked without doing Calculate Prepayments.

var oBO = TheApplication().ActiveBusObject();
var oBC = oBO.GetBusComp(&quot;VHA Calculate Prepayment TBC&quot;);
var i=1;
var sPrepOption = &quot;&quot;;
var sVoluntary = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;, &quot;Voluntary&quot;);
var sInvoluntary = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;, &quot;Involuntary&quot;);
	try{
	oBC.ActivateField(&quot;Recalculate Prepayment&quot;);
	oBC.ActivateField(&quot;Prepayment Option&quot;);
	sPrepOption = oBC.GetFieldValue(&quot;Prepayment Option&quot;);
	if(sPrepOption == sVoluntary || sPrepOption == sInvoluntary)
	{
	oBC.SetFieldValue(&quot;Recalculate Prepayment&quot;, i);
	oBC.WriteRecord();
	}
	}
	catch(e)
	{
	throw e;
	}
	finally
	{
	i=null;
	oBC=null;
	oBO=null;
	sPrepOption = null;
	sVoluntary = null;
	sInvoluntary = null;
	}
//End
}"
