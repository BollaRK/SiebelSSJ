			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMoveFile"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMoveFile(Inputs, Outputs)
{
	try
	{
		var sAttachmentId = Inputs.GetProperty(&quot;AttachmentId&quot;);
		var sBatchId = Inputs.GetProperty(&quot;BatchId&quot;);
		var sOldFilePath = Inputs.GetProperty(&quot;DataFilePath&quot;);	
		var sFileName = Inputs.GetProperty(&quot;FileName&quot;);
		var sNewFilePath = Inputs.GetProperty(&quot;NewFilePath&quot;);
		var sNewFileName = &quot;&quot;;
		var sExportLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_QR_ATT_TYPE&quot;,&quot;Input File&quot;);
		sNewFileName = sNewFilePath + &quot;/&quot; + sFileName + &quot;.csv&quot;;
		
		if(Clib.rename(sOldFilePath, sNewFileName) != 0) 
			throw (&quot;Can not move file &quot;+sOldFilePath+&quot; to &quot;+ sNewFileName);
		else
		{	
			var boQRCode = TheApplication().GetBusObject(&quot;VHA QR Code Attachement BO&quot;);
			var bcQRCode = boQRCode.GetBusComp(&quot;VHA QR Code Attachments BC&quot;);
			bcQRCode.ActivateField(&quot;SourceFileSrcPath&quot;);
			bcQRCode.ActivateField(&quot;SourceOrderId&quot;);
			bcQRCode.ActivateField(&quot;Type_Code&quot;);
			bcQRCode.ClearToQuery();
			bcQRCode.SetSearchExpr(&quot;[Id]=&apos;&quot;+sAttachmentId+&quot;&apos;&quot;);
			bcQRCode.ExecuteQuery();
			if(bcQRCode.FirstRecord())   
			{
				bcQRCode.SetFieldValue(&quot;SourceFileSrcPath&quot;,sNewFileName);
				bcQRCode.SetFieldValue(&quot;SourceOrderId&quot;,sBatchId);
				bcQRCode.SetFieldValue(&quot;Type_Code&quot;,sExportLOV);
				bcQRCode.WriteRecord();
			}
		}
		Outputs.SetProperty(&quot;NewFilePath&quot;,sNewFileName);
		
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e); 
	}
	finally
	{	
	}
}"
