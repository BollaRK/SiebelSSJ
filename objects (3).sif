			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckCustomerAge"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckCustomerAge(sDOB)
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 04/06/2014	Neel		Cloned from VF Wizard Utilities
*/
{
	try 
	{ 	
		//Declare objects

		var dToday = new Date();
				
		//Declare variables
		var sCompareDate = &quot;&quot;;
		var sTodayYear = &quot;&quot;;
		var sCompareYear = &quot;&quot;;
		var sCompareMonth = &quot;&quot;;
		var sCompareDay = &quot;&quot;;
		var sDOBYear = &quot;&quot;;
		var sDOBMonth = &quot;&quot;;
		var sDOBDay = &quot;&quot;;
		var bCustomerAgeValid = &quot;No&quot;;
		var sCount = &quot;&quot;;
				
		
		if (sDOB == &quot;&quot;)
		{
			throw &quot;Date of Birth is Required&quot;;
		}

		// sDOB = bcCA.GetFieldValue(&quot;Primary Contact Birth Date&quot;);

		//GetfieldValue of the DOB stores the field in the form mm/dd/yyyy
		//so we want to break this string into its day, month and year components
		sCount = sDOB.length;
		sDOBMonth = sDOB.substring(0,2);
		sDOBDay = sDOB.substring(3,5);
		sDOBYear = sDOB.substring(6,sCount);

		//BASUA - TD#14822 - Start
		//Removed calls to UTC date methods. With this fix DOB is checked against current Server date (not UTC)
		sTodayYear = dToday.getFullYear();
		sCompareMonth = dToday.getMonth();
		sCompareDay = dToday.getDate();
		//BASUA - TD#14822 - End
	
		//Manipulate date values.
		sCompareYear = sTodayYear - 18;//Subtract 18 to find the year the customer
									   //must have been born after.
		sCompareMonth = sCompareMonth + 1;//Add 1 because the months 
										 //are returned as 0 to 11.
		
		//Convert to string values for concatenations
		sCompareYear = sCompareYear.toString();
		sCompareMonth = sCompareMonth.toString();
		sCompareDay = sCompareDay.toString();
		sDOBYear = sDOBYear.toString();
		sDOBMonth = sDOBMonth.toString();
		sDOBDay = sDOBDay.toString();
		
		if (sCompareMonth.length == 1)
		{
			sCompareMonth = &quot;0&quot; + sCompareMonth;
		}
		
		if (sCompareDay.length == 1)
		{
			sCompareDay = &quot;0&quot; + sCompareDay;
		}

		if (sDOBMonth.length == 1)
		{
			sDOBMonth = &quot;0&quot; + sDOBMonth;
		}
		
		if (sDOBDay.length == 1)
		{
			sDOBDay = &quot;0&quot; + sDOBDay;
		}
		
		sCompareDate = sCompareYear + sCompareMonth + sCompareDay;
		sDOB = sDOBYear + sDOBMonth + sDOBDay;
		
		if (sCompareDate &gt;= sDOB)
		{
			//Customer is 18 or older. Allow credit check to continue.
			bCustomerAgeValid = &quot;Yes&quot;;
		}
		
		return bCustomerAgeValid;
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		//Destroy objects
		dToday = null;
	}
}"
