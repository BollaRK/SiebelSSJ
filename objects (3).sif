			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSelectExistingSharingGroup"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="
function mSelectExistingSharingGroup(Inputs, Outputs)
{
	try
	{
		var sBillAcntId = Inputs.GetProperty(&quot;BillingAccntId&quot;);
		var sGroupId = Inputs.GetProperty(&quot;SharingGroupId&quot;);
		var sFlag = Inputs.GetProperty(&quot;SharingFlag&quot;);
		if(sBillAcntId != null &amp;&amp; sBillAcntId !=&apos;&apos; &amp;&amp; sGroupId !=&apos;&apos; &amp;&amp; sGroupId != null)
		{
	//		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	//		var sBC = sBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);
			var sBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
			var sBC = sBO.GetBusComp(&quot;VHA Sharing Asset Mgmt - Asset - Header&quot;);
			var sSearchExpr = &quot;[Billing Account Id]=&apos;&quot; +sBillAcntId+ &quot;&apos; AND [Sharing Group Id]=&apos;&quot; +sGroupId+ &quot;&apos;&quot;;
			with(sBC)
			{
			ActivateField(&quot;Billing Account Id&quot;);	
			ActivateField(&quot;Sharing Group Id&quot;);
			ActivateField(&quot;Sharing Select&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchExpr(sSearchExpr);
			ExecuteQuery(ForwardOnly);
			var irec = FirstRecord();
//			throw(sSearchExpr +&quot;&quot;+ CountRecords());
			if(irec)
				{
				while(irec)
					{
					SetFieldValue(&quot;Sharing Select&quot;,sFlag);
					irec = NextRecord();
					}
				WriteRecord();			
				}
			}
		
		}
	
	}
	catch(e)
	{
		if (defined(e.errText))
		{
		var strError = e.errText + &quot;\r&quot; + e.toString(); 
		}
		else
		{
		var strError = e.toString(); 
		}
	throw (strError);
	}	
	finally
	{
		sBC = null;
		sBO = null;
	}
	
}"
