			   NAME="mGetRewardType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Your public declarations go here...
function mGetRewardType(sOfferId)
{
	try {
        
        var sSiebelSpecialType = &quot;&quot;;
        var boOffer = TheApplication().GetBusObject(&quot;VF Rewards Offer Matrix&quot;);
        var sbcReward = boOffer.GetBusComp(&quot;VF Rewards&quot;);

        with (sbcReward) {
            SetViewMode(AllView);
            ActivateField(&quot;Parent Row Id&quot;);
            ActivateField(&quot;Offer Id&quot;);
            ActivateField(&quot;Special Rating Type&quot;);
            ClearToQuery();
            SetSearchExpr(&apos;[Offer Id] = &quot;&apos; + sOfferId + &apos;&quot;&apos;);
            ExecuteQuery(ForwardOnly);

            if (FirstRecord())
			{
                sSiebelSpecialType = GetFieldValue(&quot;Special Rating Type&quot;);
            }
           
		}
		return(sSiebelSpecialType);
    }//end try
    catch(e)
	{
		throw(e);
	}
	finally
	{
		sbcReward = null;
		boOffer = null;
	}
}
"
