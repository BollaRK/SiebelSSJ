			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:04:15"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCheckNonFBBFrmGroup"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCheckNonFBBFrmGroup(sGroupId)
{
try
{
	/*******************************************************************
	VHA Suresh: Added for R17.3 PIPE: Sharing
	Checks if any NON FBB Service is available in Group.
	*******************************************************************/
	var NonFBBServiceExists = &quot;N&quot;;
	if(sGroupId != &apos;&apos; &amp;&amp; sGroupId != null)
	{
	var AssetBO = TheApplication().GetBusObject(&quot;VHA Sharing Order Items BO&quot;);
	var AssetBC = AssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header - Thin&quot;);

	with(AssetBC)
	{
		ActivateField(&quot;Sharing Group Id&quot;);
		ActivateField(&quot;VF Siebel Product Type&quot;);
		ClearToQuery();
		SetViewMode(AllView);				
		SetSearchSpec(&quot;Sharing Group Id&quot;, sGroupId);
		ExecuteQuery(ForwardOnly);
		var irec = FirstRecord();
		while(irec)
		{
			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SHARING_INELIG_PROD_TYPE&quot;,GetFieldValue(&quot;VF Siebel Product Type&quot;)) == &quot;&quot;)
			NonFBBServiceExists = &quot;Y&quot;;
		irec = NextRecord();
		}
	}
	}
	return(NonFBBServiceExists);
	
}
catch(e)
{
throw(e);
}
finally
{
	if(defined(AssetBC)) {  AssetBC = null; }
	if(defined(AssetBO)) {  AssetBO = null; }
}
}"
