			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ClearRootLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ClearRootLineItem(Inputs, Outputs)
{
	var bcName = null,Frecord=null, BoName= null, RootOrderLineItemId= null, Msg=&quot;Success&quot;, LineIntegId=null, strOrderId=null;
	try
	{
		RootOrderLineItemId = Inputs.GetProperty(&quot;RootOrderLineItemId&quot;);
		strOrderId = Inputs.GetProperty(&quot;ChildOrderId&quot;);
		if(RootOrderLineItemId != &quot;&quot; &amp;&amp; RootOrderLineItemId != null)
		{	
			bcName = TheApplication().GetBusObject(&quot;Order Entry - Line Items&quot;).GetBusComp(&quot;Order Entry - Line Items&quot;);
			with(bcName)
			{
				SetViewMode(AllView);
                ActivateField(&quot;Id&quot;);
                ClearToQuery();
                SetSearchExpr(&quot;[Id] = &apos;&quot;+RootOrderLineItemId+&quot;&apos;&quot;);
                ExecuteQuery(ForwardOnly);
                if(FirstRecord())
                {   
                    DeleteRecord();
					CleanUpChildOrder(strOrderId);
					Msg = &quot;Success&quot;;
                }
			}
		}
		else
			Msg = &quot;Root Line Item Id can&apos;t be blank.&quot;;
		Outputs.SetProperty(&quot;ErrorMessage&quot;,Msg);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		RootOrderLineItemId = null;
		bcName = null;
		Frecord=null;
		BoName=null;
	}
}"
