			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
try
	{
		var sIgniteR2Switch = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;IGNITER2&quot;);
		switch(MethodName)
		{
			case &quot;PortInTBUI&quot;:
				CreateRequestTNR(Inputs, Outputs);			
				break;
				
			case &quot;CreateOrder&quot;:
				mCreateOrder(Inputs, Outputs);			
				break;
			
			case &quot;GetPrimaryContactNumber&quot;:
				mGetPrimaryMSISDN(Inputs, Outputs);			
				break;

			case &quot;GetAddressId&quot;:  //Ravindra: Added for getting address id in imagine project 23/12/2024
					mGetAddress(Inputs,Outputs);		
				break;
			
			case &quot;ValidateCustomer&quot;:
				 ValidateCustomerInfo(Inputs, Outputs);
				if(TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;) == &quot;Change Location FWA&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;InvokeFWAConnect&quot;) == &quot;Yes&quot;)
					mGetAddress(Inputs,Outputs);		
				break;

			case &quot;ValidateCustomerPrimaryInfo&quot;://SBBAU-Imagine
				 ValidateCustomerPrimaryInfo(Inputs, Outputs);		
				break;

			case &quot;PretoPostDefault&quot;:
				PretoPostDefault(Inputs, Outputs);			
				break;
			
			case &quot;CreateShipment&quot;:
				CreateShipment(Inputs, Outputs);			
				break;
			
			case &quot;DeleteFulfilmentOrder&quot;:
				DeleteFulfilmentOrder(Inputs, Outputs);			
				break;
				
			case &quot;SetDealerCode&quot;:
				SetDealerCode(Inputs, Outputs);			
				break;

			case &quot;SetDealerProfAttr&quot;:
				SetDealerProfAttr(Inputs, Outputs);			
				break;

			case &quot;InheritCustomerAddressToBilling&quot;:
				mInheritCustomerAddressToBilling(Inputs, Outputs );
				break;
				
			case &quot;NullifySIM&quot;:
				mNullifySIM(Inputs, Outputs);
				break;
				
			case &quot;CancelOrder&quot;:
				mCancelOrder(Inputs, Outputs);
				mDeleteOrderHeader(Inputs, Outputs);
				if(sIgniteR2Switch==&quot;ON&quot;)
					mIgnCancelOrd(Inputs,Outputs)
				break;
			
			case &quot;QueryOLI&quot;:
				mQueryOLI(Inputs, Outputs);			
				break;
			
			//VF:ROSELINE 15/04/2015 - Added for R15.2 Plans and Offers CR
			case &quot;ValidatePromoCode&quot;:
				mValidatePromoCode(Inputs, Outputs);
				mValidateShipment(Inputs, Outputs);	//DM:09/09/2015:Added for PKE000000016034				
				break;
				
			//SK 9.4.19: R19.2 Promo code CR - Checks promo code entered in line item is added to offer history or not.
			/*case &quot;ValidatePromoCodeOfferHist&quot;:
				
				mValidatePromoCodeOfferHist(Inputs, Outputs);				
				break;*/
			//VHA NandhiniG 11/6/19 : Added for MR03 - Bulk Tool Update
			case &quot;ValidateBulkConnectPortInPromoCode&quot;:
				mValidateBulkConnectPortInPromoCode(Inputs, Outputs);				
				break;

			case &quot;SetSMSFlag&quot;:
				mSetSMSFlg(Inputs, Outputs);				
				break;
			case &quot;SpeedUpdateOrder&quot;://Added for Imagine Proh-SBABU
				mSpeedUpdateOrder(Inputs, Outputs);				
				break;

			case &quot;ReuseModemAsset&quot;://Added for Reusemodem - Sakthi
				mReuseModemAsset(Inputs, Outputs);				
				break;

			case &quot;COLOrderDetails&quot;://Added for COL Order- Sakthi
				mCOLOrderDetails(Inputs, Outputs);				
				break;

			case &quot;COLSetOrder&quot;://Added for COL Order- Sakthi
				mCOLSetOrder(Inputs, Outputs);				
				break;

			case &quot;COLOrderTypeUpd&quot;://Added for COL Order- Sakthi
				mCOLOrderTypeUpd(Inputs, Outputs);				
				break;

			case &quot;GeoSiteAPINewCall&quot;://Added for GeoSiteAPI Decoupling- Sakthi
				mGeoSiteAPINewCall(Inputs, Outputs);				
				break;

			case &quot;ValidatePostpayIdDetails&quot;:
				fnValidatePostpayIdDetails(Inputs,Outputs);		
				break;
						
					
			default:
				throw (&quot;Unknown MethodName = &quot; + MethodName);
		}

		return (CancelOperation);	
	}
catch (e)
	{
		TheApplication().RaiseErrorText(e.toString());
	}
finally
	{

	}
	return (ContinueOperation);
}
"
