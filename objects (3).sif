			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateExistingSharingRecords"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateExistingSharingRecords(Inputs,Outputs)
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sBillingAccountId = Inputs.GetProperty(&quot;BillingAccountId&quot;);
		var sGroupId = &quot;&quot;;
		var sGroupName = &quot;&quot;;
		var sSharingBO = TheApplication().GetBusObject(&quot;VHA Sharing Item BO&quot;);
		var sSharingBC = sSharingBO.GetBusComp(&quot;VHA Order Line Items - Sharing Thin&quot;);
		with(sSharingBC)
		{
			sSharingBC.SetViewMode(AllView);
			sSharingBC.ActivateField(&quot;Order Header Id&quot;);
			sSharingBC.ActivateField(&quot;Parent Order Item Id&quot;);
			sSharingBC.ActivateField(&quot;Sharing Action Calc&quot;);
			sSharingBC.ActivateField(&quot;Sharing Group Id&quot;);
			sSharingBC.ClearToQuery();
			var sSearchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId +&quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
			sSharingBC.SetSearchExpr(sSearchst);
			sSharingBC.ExecuteQuery(ForwardOnly);
			var isRec = sSharingBC.FirstRecord();
			while(isRec)
			{
				var sSharingAction = sSharingBC.GetFieldValue(&quot;Sharing Action Calc&quot;);
				if(sSharingAction == &quot;Remove Member&quot; || sSharingAction == &quot;Existing Member&quot;)
				{
					sGroupId = sSharingBC.GetFieldValue(&quot;Sharing Group Id&quot;);	
				}	
				isRec =  sSharingBC.NextRecord();
			}
			if(sGroupId != &quot;&quot; || sGroupId != null)
			{
				var sGroupBO = TheApplication().GetBusObject(&quot;VHA Sharing Account BO&quot;);
				var sGroupBC = sGroupBO.GetBusComp(&quot;VHA Sharing Group&quot;);
				with(sGroupBC)
				{
					sGroupBC.ActivateField(&quot;Shraing Group Name&quot;);
					sGroupBC.ActivateField(&quot;Id&quot;);
					sGroupBC.ClearToQuery();
					sGroupBC.SetSearchSpec(&quot;Id&quot;, sGroupId);
					sGroupBC.ExecuteQuery(ForwardOnly);
					var isRecord = sGroupBC.FirstRecord();
					if(isRecord)
					{
						var sGroupName = sGroupBC.GetFieldValue(&quot;Shraing Group Name&quot;);
					}
					var sActiveBO = TheApplication().ActiveBusObject();
					var sGroupTBC = sActiveBO.GetBusComp(&quot;VHA Sharing Group TBC&quot;);
					with (sGroupTBC)
					{
						sGroupTBC.ClearToQuery();
                        sGroupTBC.ExecuteQuery();

						if(!sGroupTBC.FirstRecord())
						{
						sGroupTBC.NewRecord(NewAfter);
						sGroupTBC.SetFieldValue(&quot;Sharing Group Name&quot;,sGroupName);
						sGroupTBC.SetFieldValue(&quot;Sharing Group Id&quot;,sGroupId);
						if(sGroupTBC.GetFieldValue(&quot;Sharing Selection&quot;) != &quot;Y&quot;)
						{
							sGroupTBC.SetFieldValue(&quot;Sharing Selection&quot;,&quot;Y&quot;);
						}
						sGroupTBC.SetFieldValue(&quot;Select Flag&quot;,&quot;Y&quot;);
						sGroupTBC.WriteRecord();
						}
						else
						{
						sGroupTBC.SetFieldValue(&quot;Sharing Group Name&quot;,sGroupName);
						sGroupTBC.SetFieldValue(&quot;Sharing Group Id&quot;,sGroupId);
						if(sGroupTBC.GetFieldValue(&quot;Sharing Selection&quot;) != &quot;Y&quot;)
						{
							sGroupTBC.SetFieldValue(&quot;Sharing Selection&quot;,&quot;Y&quot;);
						}
						sGroupTBC.SetFieldValue(&quot;Select Flag&quot;,&quot;Y&quot;);
						sGroupTBC.WriteRecord();
}
						

					}
				}
			}
		}		
	}

	catch(e)
	{
		throw e;
	}
	finally
	{
		sSharingBC = null;
		sSharingBO = null;
		sGroupBC = null;
		sGroupBO = null;
		sGroupTBC = null;
		sActiveBO = null;		
	}
}"
