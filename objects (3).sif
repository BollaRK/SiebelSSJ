			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateAttachments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateAttachments (Inputs, Outputs)
{
 var psErrorInput, psErrorOutput, sErrorMessage, bsError;

 
 var sParentIdFieldValue;
 var sParentIdFieldName;
 var sAttachmentBusinessObjectName;
 var sAttachmentBusinessComponentName;
 var sAttachmentFileNameFieldName;
 var sAttachmentRecordName;
 var sAttachmentFileName;
 var sAttachmentFilePath;
 var RetVal;
 var intret = ContinueOperation;
    var sAttachmentType = &quot;&quot;;
    var sAttachmentTypeFieldName = &quot;&quot;;
// Object variable declaration
 var boAttachmentBusinessObject;
 var bcAttachmentBusinessComponent;
 var sLineItemId = &quot;&quot;;

 try
 {

   //sAttachmentType = Inputs.GetProperty(&quot;AttachmentType&quot;);
   //sParentIdFieldValue = Inputs.GetProperty(&quot;SourceCostId&quot;);
   sAttachmentRecordName = Inputs.GetProperty(&quot;AttachmentRecordName&quot;);
   sAttachmentFilePath = Inputs.GetProperty(&quot;AttachmentFilePath&quot;);
   var sFilePath = sAttachmentFilePath + &quot;/&quot; + sAttachmentRecordName +&quot;.csv&quot;;
   var sBulkHeaderId = Inputs.GetProperty(&quot;BulkHeaderId&quot;);
   
   boAttachmentBusinessObject = TheApplication().GetBusObject(&quot;VF Bulk Initiator&quot;);
   bcAttachmentBusinessComponent = boAttachmentBusinessObject.GetBusComp(&quot;VF Import Attachments&quot;);
   
   bcAttachmentBusinessComponent.NewRecord(0);
   
   RetVal = bcAttachmentBusinessComponent.InvokeMethod(&quot;CreateFile&quot;,sFilePath,&quot;SourceFileName&quot;, &quot;Y&quot;);

	//bcAttachmentBusinessComponent.SetFieldValue(&quot;SourceFileDeferFlg&quot;,&quot;R&quot;);
//	bcAttachmentBusinessComponent.SetFieldValue(&quot;SourceOrderId&quot;, sParentIdFieldValue);
   bcAttachmentBusinessComponent.SetFieldValue(&quot;Source Id&quot;, sBulkHeaderId);
   bcAttachmentBusinessComponent.SetFieldValue(&quot;SourceFileName&quot;, sAttachmentRecordName);
   //bcAttachmentBusinessComponent.SetFieldValue(&quot;Type_Code&quot;,&quot;BULKESIMIMPFILE&quot;);
   bcAttachmentBusinessComponent.WriteRecord();
   
   var sAttachmentId = bcAttachmentBusinessComponent.GetFieldValue(&quot;Id&quot;);
   Outputs.SetProperty(&quot;AttachmentRecordId&quot;,sAttachmentId);
   Outputs.SetProperty(&quot;FilePath&quot;,sFilePath);

 }
 catch(e)
 {

  var sErrorMessage;
  
  
  if(!defined(e.errText))
  {
         sErrorMessage = e.toString();
     }
     else
     {
      sErrorMessage = e.errText;
     }
  
  psErrorInput  = TheApplication().NewPropertySet();
  psErrorOutput = TheApplication().NewPropertySet();
  bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
  psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VHA ATOM eSIM Processing Service&quot;);
  psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;AttachQRCode&quot;);
  psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
  bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
  sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);

  TheApplication().RaiseErrorText(e);

 }
 finally
 {
  
  bcAttachmentBusinessComponent = null;
  boAttachmentBusinessObject = null;
  return (CancelOperation);
 }
 
}"
