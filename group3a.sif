			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRefreshScreen"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mRefreshScreen()
{
/*
 * Component Name        :  Com Invoice Profile
 * Method Name           : 	refreshScreen
 * Component Information : 	Refresh screen if Payment Method has change
 *							If not just refresh this bus comp.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 21/02/2005	TAlihos					Initial Version
 * 17/05/2005	TAlihos					Updated to resolve W2 defect 2160. 
 *										requeried parent bc to reflect updated payment method.	
 */
	var bcParentBusComp;
	var boBillingAccount;
	var strParentBusCompName;

	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Com Invoice Profile.refreshScreen&quot;); 
		}

		// Find out what the parent bus comp is...
		bcParentBusComp = this.ParentBusComp();
		
		// Lets check to make sure the parent is not null
		if (bcParentBusComp != null)
		{
			strParentBusCompName = bcParentBusComp.Name();
		}
	
		// Lets check to see who the parent is....
		if (strParentBusCompName == &quot;VF Billing Account&quot;)
		{
	
			// Refresh the single record in the VF billing Account bus comp
			// Now lets get the Parent BC Id
			var strBillingAccountId = bcParentBusComp.GetFieldValue(&quot;Id&quot;);
			// And now refresh teh Parent BC
			bcParentBusComp.ClearToQuery();
			bcParentBusComp.SetViewMode(AllView);
			bcParentBusComp.SetSearchSpec(&quot;Id&quot;, strBillingAccountId);
			bcParentBusComp.ExecuteQuery();
		}
			
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		throw (strError);
	}
	finally
	{
		bcParentBusComp = null;
		boBillingAccount = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;END:Com Invoice Profile.strParentBusCompName=&quot; + strParentBusCompName);
		}
	}	
}"
			   SEQUENCE="18"
