			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSysPref"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSysPref( strPrefName )
{
/*
 * Component Name        : Com Invoice Profile
 * Method Name           : IsBillSegmentPrepay
 * Component Information : This method checks whether the customer account bill
 *						   segment Prepay or Postpay.  The comparison is against
 *						   the Prepay bill segment stored in System Preferences for
 *						   bulk provisioning.
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 18/12/2006	RP					Initial
 */


 try
 {
  	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:Com Invoice Profile.mGetSysPref&quot;);
	}
	
	var boSysPref;
	var bcSysPref;
	
	boSysPref = TheApplication().GetBusObject( &quot;System Preferences&quot;  );
	bcSysPref = boSysPref.GetBusComp( &quot;System Preferences&quot; );
	
	bcSysPref.ClearToQuery();
	bcSysPref.ActivateField( &quot;Value&quot; );
	bcSysPref.SetSearchSpec( &quot;Name&quot;, strPrefName );
	bcSysPref.ExecuteQuery( ForwardOnly );
	
	if ( bcSysPref.FirstRecord() )
		return( bcSysPref.GetFieldValue( &quot;Value&quot; ) );
	else
		return( &quot;&quot; );

 }
 catch( e )
 {
 	if (defined(e.errText))
	{
		var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		var strError = arguments.callee + ToString(e); 
	}
   	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:Com Invoice Profile.mGetSysPref.Error:&quot; + strError );
	}
	throw( strError );
 }
 finally
 {
   	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:Com Invoice Profile.mGetSysPref&quot;);
	}
	
	bcSysPref = null;
	boSysPref = null;
 } 
}"
			   SEQUENCE="16"
			   UPDATED="11/01/2018 14:02:00"
