			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDelivery"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDelivery(sNewDeliveryMethod)
{
	try{
		sOldDeliveryMethod = this.GetFieldValue(&quot;VHA Delivery Method&quot;);
		var sStatus = &quot;Auto-Created&quot;;
		var sPaymentType = &quot;Other&quot;;
		var sComments = &quot;Delivery method changed from &quot;+sOldDeliveryMethod+&quot; to &quot;+sNewDeliveryMethod;
		if( sOldDeliveryMethod != sNewDeliveryMethod)
		{
			if(sNewDeliveryMethod == &quot;Email&quot;)
			{
				if(this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;Y&quot;){
					this.SetFieldValue(&quot;Suppress Paper&quot;,&quot;N&quot;);
					}
				this.SetFieldValue(&quot;Email Bill&quot;, &quot;Y&quot;);
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VHA Delivery Method&quot;, &quot;Email&quot;);
				//this.WriteRecord();
			}
			else if(sNewDeliveryMethod == &quot;MyVodafone&quot;)

			{
				this.SetFieldValue(&quot;Suppress Paper&quot;,&quot;Y&quot;);
				//this.SetFieldValue(&quot;Email Bill&quot;, &quot;N&quot;);
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VHA Delivery Method&quot;, &quot;MyVodafone&quot;);
				//this.WriteRecord();
			}
			else if(sNewDeliveryMethod == &quot;Paper&quot;)

			{
				
				if(this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;Y&quot;){
					this.SetFieldValue(&quot;Suppress Paper&quot;,&quot;N&quot;);
					}
				this.SetFieldValue(&quot;Email Bill&quot;, &quot;N&quot;);
				this.SetFieldValue(&quot;VHA Delivery Method&quot;, &quot;Paper&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;,&quot;&quot;);
				
			}
			if(sOldDeliveryMethod == &quot;&quot; || sOldDeliveryMethod == null)
				sComments = &quot;Delivery method &quot;+sNewDeliveryMethod + &quot; has been selected&quot;;
			mCreateActivity(sComments,&quot;Delivery Method Change&quot;,sPaymentType,sStatus);
			
		}
		return(CancelOperation);
	}
	
	catch(e){
		throw(e);
	}
	finally{
		
	}
}"
			   SEQUENCE="15"
