			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
/*
 * Component Name        : 	Order Entry - Line Items
 * Method Name           : 	BusComp_PreWriteRecord
 * Component Information :  One-off charges need a static price copied in
 *							from the column RX_AVG_PRICE in the table
 *							S_PROD_INT (this is populated during product
 *							sync). Code to do this is located here.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 6/04/2006	JLing		DF12867		Initial Version
 */


	// Error Handling declarations
	var psErrorInput;
	var psErrorOutput;
	var bsError;	
	var strError = &quot;&quot;;

	// Return value
	var iReturnValue = ContinueOperation;
	
	// Other vars
	var sProdId;
	var sProdType;
	var sCurPrice = &quot;&quot;;
	var sPrice = &quot;&quot;;
	
	var boProduct;
	var bcProduct;
	
	


	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;TRACE START:Order Entry - Line Items.BusComp_PreWriteRecord&quot;);
		}	

		sProdId = this.GetFieldValue(&quot;Product Id&quot;);	
		sProdType = this.GetFieldValue(&quot;Product Type&quot;);
		sCurPrice = this.GetFieldValue(&quot;Product Sync Stored Price&quot;);
	
		
		// Only do this if this record is a One-off Charge
		// Do a recheck - dont ever set this again if its set once.
		if ((sProdType == gOneOffChargeType) &amp;&amp; (sCurPrice == &quot;&quot;))
		//if (sProdType == gOneOffChargeType)
		{

			// Query the product table and copy in value from 
			// RX_AVG_PRICE to local column COST_AMT
			// This is in the &quot;Product Sync Stored Price&quot; field

			boProduct = TheApplication().GetBusObject(&quot;Admin Product Definition&quot;);
			// Need a non cached query on products
			bcProduct = boProduct.GetBusComp(&quot;VF Internal Product - Non Cached&quot;);
			bcProduct.ClearToQuery();
			bcProduct.SetViewMode(AllView);
			bcProduct.ActivateField(&quot;Product Sync Price&quot;);
			bcProduct.SetSearchSpec(&quot;Id&quot;, sProdId);
			bcProduct.ExecuteQuery(ForwardOnly);			
			
			// Get the value in RX_AVG_PRICE
			if (bcProduct.FirstRecord())
			{
				sPrice = bcProduct.GetFieldValue(&quot;Product Sync Price&quot;);
				//this.ActivateField(&quot;Product Sync Stored Price&quot;);
				
				if (sPrice == &quot;&quot;)
				{
					// If no price is present, set this col to zero.
					this.SetFieldValue(&quot;Product Sync Stored Price&quot;, 0);
				} else
				{
					// Otherwise, copy the value of RX_AVG_PRICE into this bc
					this.SetFieldValue(&quot;Product Sync Stored Price&quot;, sPrice);
				}
			}
	
			
			/*var strview = TheApplication().ActiveViewName();
			if (strview == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;)
			{
			    var psInputs,psOutputs,bsInvokeWorkflow,strorderlineid;
	            psInputs = TheApplication().NewPropertySet();
				psOutputs = TheApplication().NewPropertySet();
				strorderlineid = this.GetFieldValue(&quot;Id&quot;);
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Order Line Item Query TBUI&quot;);
				psInputs.SetProperty(&quot;Object Id&quot;, strorderlineid);
				bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
				return (CancelOperation);
		    }*/
		    
	
	
	
	
		
		}


		return (iReturnValue);
	}
	catch(e)
	{
	
		strError = ToString(e);

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Line Items BC&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_NewRecord&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		
		bcProduct = null;
		boProduct = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.BusComp_PreWriteRecord&quot;);
		}		
	}
	
}"
			   SEQUENCE="11"
			   UPDATED="06/07/2016 01:52:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2014 00:40:44"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	Order Entry - Line Items
 * Method Name           :	BusComp_SetFieldValue
 * Component Information :	Removing the non-standard charcaters from the User Name field.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 28/08/2014   Muralidharank SIT 2249 Added to Set Stock Indicator								
 */
function BusComp_SetFieldValue (FieldName)
{
	try
	{
	    //************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;TRACE START:Order Entry - Line Items.BusComp_SetFieldValue&quot;);
		}	

		
		switch (FieldName)
		{
            // Code for the DF 11212 to remove the non-standard characters from User Name field.  		
		    case &quot;VF Installed Asset Name&quot;:
	    		// Added condition to skip validation for other regions Def 11684 --Sibi Chakko
	    		if (this.GetFieldValue(&quot;Account ARII&quot;) == &quot;Australia&quot;)
	    		{
		    		var strUname = GetFieldValue(&quot;VF Installed Asset Name&quot;);
		     		var strFinalString;	  
		     		var strLength = strUname.length;
		     		var strArray = new Array(strLength);
		     		var i = 0;
		     		var j = 0;
		     		var strChar;
		     		var CharCode;  
	              	     
		               for(i=0;i&lt;strLength;i++)
		  	    		 {
	      		 			strChar = strUname.charAt(i);
	      		 			CharCode = strChar.charCodeAt(0);
	      		 			// Added condition to skip validation for numerals Def 11684 --Sibi Chakko
		      		 		if(((CharCode &gt;64) &amp;&amp; (CharCode &lt; 91)) || ((CharCode &gt;96) &amp;&amp; (CharCode&lt;123)) || ((CharCode&gt;47) &amp;&amp; (CharCode&lt;58)))
	
	      	     	 		 {      			 	 
	      			   			 strArray[j]=strChar;
	      		 				 j++;
	      		     		 }
	      		      		 else
	      		      		 {
	      		 				strArray[j] = &quot; &quot;;
	      						j++;
	      			  		 }
	      				 }
	      	  		strFinalString = strArray.join(&quot;&quot;);
		 	  		SetFieldValue(&quot;VF Installed Asset Name&quot;, strFinalString);
		 	  		break; // Code for the DF 11212 Ends.
				}
				
			case &quot;VF ConnectionType&quot;:
			var strconnectiontype = this.GetFieldValue(&quot;VF ConnectionType&quot;);
			var strview = TheApplication().ActiveViewName();
			if((strview == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;) &amp;&amp; (strconnectiontype==&quot;Account Level Proposition&quot;))
				{
					SetFieldValue(&quot;VF Stock Indicator TBUI&quot;, &quot;In Stock&quot;);
				}
				break;	
				
			case &quot;VF Sharing Order&quot;:
				this.ActivateField(&quot;VF Sharing Order&quot;);
				var sActiveView = TheApplication().ActiveViewName();
		       	if(this.GetFieldValue(&quot;VF Sharing Order&quot;) == &quot;N&quot;)
		       	{		
					this.ActivateField(&quot;Sharing Lead MSISDN Id&quot;);
					this.ActivateField(&quot;Sharing New Lead MSISDN Id&quot;);
					this.ActivateField(&quot;Sharing Action&quot;);
					if ((sActiveView == &quot;VF Customise Service View Upgrade - InStock - TBUI&quot; || sActiveView == &quot;VF Customise Services View –  TBUI&quot;) &amp;&amp; (this.GetFieldValue(&quot;Sharing Group Id&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Sharing Group Id&quot;) == null || this.GetFieldValue(&quot;Sharing Action Calc&quot;) == &quot;&quot;))
					//if(this.GetFieldValue(&quot;Sharing Action Calc&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Sharing Group Id&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Sharing Group Id&quot; == null)) 
					{
						this.SetFieldValue(&quot;Sharing Lead MSISDN Id&quot;,&quot;&quot;);
						this.SetFieldValue(&quot;Sharing New Lead MSISDN Id&quot;,&quot;&quot;);
						this.SetFieldValue(&quot;Sharing Action&quot;,&quot;&quot;);
						this.WriteRecord();
					}
				}//Added code for PKE000000045550
			break;		
				
			/*	case &quot;VF MSISDN TBUI&quot;:
		
				try
					{
						var psInputs,psOutputs,bsInvokeBS;
						var psErrorInput;
						var psErrorOutput;
						var bsError;	
						var strError = &quot;&quot;;
						//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
			            psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;MSISDN&quot;, this.GetFieldValue(&quot;VF MSISDN TBUI&quot;));
						psInputs.SetProperty(&quot;Product Group&quot;, &quot;General&quot;);
						psInputs.SetProperty(&quot;RootLineItemId&quot;, this.GetFieldValue(&quot;Id&quot;));
						bsInvokeBS = TheApplication().GetService(&quot;VF Bulk Processing Service&quot;);
						bsInvokeBS.InvokeMethod(&quot;Allocate MSISDN&quot;, psInputs, psOutputs);
						return(ContinueOperation);
					}
					catch(e)
					{
						strError = ToString(e);
						psErrorInput  = TheApplication().NewPropertySet();
						psErrorOutput = TheApplication().NewPropertySet();
						bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
						psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Order Entry - Line Items BC&quot;);
						psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_SetField&quot;);
						psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
						bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
						strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
						TheApplication().RaiseErrorText(strError);
					}
					finally
					{
						psInputs=null;
						psOutputs=null;
						bsInvokeBS=null;
						psErrorInput=null;
						psErrorOutput=null;
						bsError=null;
					}
				
				break;*/
	
		}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Order Entry - Line Items.BusComp_SetFieldValue.strError=&quot; + strError);
		}
		//var strDisplayError = ErrorHandling(strError, &quot;BusComp_SetFieldValue&quot;); //TD11803
		//TheApplication().RaiseErrorText(strDisplayError);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.BusComp_SetFieldValue&quot;);
		}
		
	}
}"
			   SEQUENCE="12"
			   UPDATED="09/30/2019 12:01:51"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2014 00:40:44"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="Y"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
try
	{
	if(sNewRecord == &quot;Y&quot; &amp;&amp; this.GetFieldValue(&quot;Parent Order Item Id&quot;) == &quot;&quot;)
	{
		try
		{
			var strType = this.GetFieldValue(&quot;VF Service Order Sub Type&quot;);
			var psInputs,psOutputs,bsInvokeBS;
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;OrderId&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
			psInputs.SetProperty(&quot;AssetIntId&quot;, this.GetFieldValue(&quot;Asset Integration Id&quot;));
			psInputs.SetProperty(&quot;OrderItemId&quot;, this.GetFieldValue(&quot;Id&quot;));
			bsInvokeBS = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
			bsInvokeBS.InvokeMethod(&quot;UpdateAssetOrderItem&quot;, psInputs, psOutputs);
			if (strType != &quot;Suspend&quot; &amp;&amp; strType != &quot;Restore&quot; &amp;&amp; strType != &quot;Change SIM&quot; &amp;&amp; strType != &quot;Reactivate&quot; &amp;&amp; strType != &quot;Change SIM&quot; &amp;&amp; strType != &quot;Decon/Con Transfer TO&quot;)
			{
			 if(psOutputs.GetProperty(&quot;VF Sharing Asset&quot;) != &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Sharing Asset&quot;,psOutputs.GetProperty(&quot;VF Sharing Asset&quot;));
			 if(psOutputs.GetProperty(&quot;VF Current Parent MSISDN&quot;) != &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Current Parent MSISDN&quot;,psOutputs.GetProperty(&quot;VF Current Parent MSISDN&quot;));
			 this.WriteRecord();
			 }
		}
		catch(e)
		{
		}
		finally
		{
			psInputs = null;
			psOutputs = null;
			bsInvokeBS = null;
		}
	}
	var strview = TheApplication().ActiveViewName();
	var strnewmsisdnid = this.GetFieldValue(&quot;New MSISDN Id&quot;);
	var sNewTBUIMSISDN = this.GetFieldValue(&quot;VF MSISDN TBUI&quot;);
	var sPortin = this.GetFieldValue(&quot;VF Port In TBUI&quot;);
	var strordertype = this.ParentBusComp().GetFieldValue(&quot;VF Order Type TBUI&quot;);
	if (sPortin == &quot;No&quot; &amp;&amp; sNewTBUIMSISDN != null &amp;&amp; sNewTBUIMSISDN != &quot;&quot; &amp;&amp; strordertype != &quot;Pre to Post transfer&quot; &amp;&amp; (strnewmsisdnid == &quot;&quot; || strnewmsisdnid == null))
		{
		var psInputs,psOutputs,bsInvokeBS;
		var psErrorInput;
		var psErrorOutput;
		var bsError;	
		var strError = &quot;&quot;;
		//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();
		psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
		psInputs.SetProperty(&quot;MSISDN&quot;, this.GetFieldValue(&quot;VF MSISDN TBUI&quot;));
		psInputs.SetProperty(&quot;Product Group&quot;, &quot;General&quot;);
		//psInputs.SetProperty(&quot;RootLineItemId&quot;, this.GetFieldValue(&quot;Id&quot;));
		psInputs.SetProperty(&quot;Root Line Item Id&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));//Subramani-04SEP2014
		bsInvokeBS = TheApplication().GetService(&quot;VF Bulk Processing Service&quot;);
		bsInvokeBS.InvokeMethod(&quot;Allocate MSISDN&quot;, psInputs, psOutputs);
		}
	}
catch(e)
	{
	strError = ToString(e);
	psErrorInput  = TheApplication().NewPropertySet();
	psErrorOutput = TheApplication().NewPropertySet();
	bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
	psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Order Entry - Line Items BC&quot;);
	psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_WriteRecord&quot;);
	psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
	bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
	strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	TheApplication().RaiseErrorText(strError);
	}
finally
	{
	psInputs=null;
	psOutputs=null;
	bsInvokeBS=null;
	psErrorInput=null;
	psErrorOutput=null;
	bsError=null;
	refreshScreen();
	}
	//TARIQ - 19SEP2014 - Commented the code - Since getting the selected record error randomly when allocating MSISDN
}"
			   SEQUENCE="13"
			   UPDATED="06/07/2016 01:52:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/23/2014 22:42:43"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetCustomFieldsForPromServiceOrders"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Nikhil Joshi: 28.07.2014: Added for Promotion Bundling
function SetCustomFieldsForPromServiceOrders (sOrderId,sLineItemId)
{
	try
	{
		this.ActivateField(&quot;Action Code&quot;);
		this.ActivateField(&quot;Parent Order Item Id&quot;);
		var sApp=TheApplication(), sErrorMsg=&quot;&quot;, bRecord=false, bUpdateFields=false, i=0;
		var sOwnerContactId=&quot;&quot;,sBillingAccountId=&quot;&quot;,sContactMM=&quot;&quot;,sContactFirstName=&quot;&quot;,sContactLastName=&quot;&quot;;
		var sServicePIN=&quot;&quot;,sVFInstalledAssetName=&quot;&quot;,sVFServiceOrderSubType=&quot;&quot;;
		var sBO,sBC,sBO1,sBC1;
		sBO = sApp.GetBusObject(&quot;Order Item&quot;);
		sBC = sBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		sBO1 = sApp.GetBusObject(&quot;QAS Account Address Billing&quot;);
		sBC1 = sBO1.GetBusComp(&quot;VF Billing Account&quot;);
		with(sBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Billing Account Id&quot;);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Owner Contact Id&quot;);
			ActivateField(&quot;Service PIN&quot;);
			ActivateField(&quot;VF Installed Asset Name&quot;);
			ActivateField(&quot;VF Service Order Sub Type&quot;);
//			ActivateField(&quot;Display Reason Code&quot;);
//			ActivateField(&quot;VF Comments&quot;);
//			ActivateField(&quot;VF TNR Id&quot;);
//			ActivateField(&quot;VF Transfer Sub Type Connect&quot;);
			SetSearchExpr(&quot;[Id] = &apos;&quot;+sLineItemId+&quot;&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			for(bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			{
				sBillingAccountId = GetFieldValue(&quot;Billing Account Id&quot;);
				sOwnerContactId = GetFieldValue(&quot;Owner Contact Id&quot;);
				sServicePIN = GetFieldValue(&quot;Service PIN&quot;);
				sVFInstalledAssetName = GetFieldValue(&quot;VF Installed Asset Name&quot;);
				sVFServiceOrderSubType = GetFieldValue(&quot;VF Service Order Sub Type&quot;);
				if(sVFServiceOrderSubType == &quot;&quot; || sVFServiceOrderSubType == null)
					SetFieldValue(&quot;VF Service Order Sub Type&quot;, &quot;Connect&quot;);
				if((sOwnerContactId != &quot;&quot; &amp;&amp; sOwnerContactId != null &amp;&amp; sServicePIN != &quot;&quot; &amp;&amp;
				sServicePIN != null &amp;&amp; sVFInstalledAssetName != &quot;&quot; &amp;&amp; sVFInstalledAssetName != null) ||
				(sBillingAccountId == &quot;&quot; || sBillingAccountId == null))
					continue;
				with(sBC1)
				{
					ActivateField(&quot;Password&quot;);
					ActivateField(&quot;Primary Contact Id&quot;);
					ActivateField(&quot;Billing Account Primary Contact First Name&quot;);
					ActivateField(&quot;Billing Account Primary Contact Last Name&quot;);
					ActivateField(&quot;Billing Account Primary Contact M/M&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Id] = &apos;&quot;+sBillingAccountId+&quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sServicePIN = GetFieldValue(&quot;Password&quot;);
						sOwnerContactId = GetFieldValue(&quot;Primary Contact Id&quot;);
						sContactFirstName = GetFieldValue(&quot;Billing Account Primary Contact First Name&quot;);
						sContactLastName = GetFieldValue(&quot;Billing Account Primary Contact Last Name&quot;);
						sContactMM = GetFieldValue(&quot;Billing Account Primary Contact M/M&quot;);
						if(sContactMM != &quot;&quot; &amp;&amp; sContactMM != null)
							sVFInstalledAssetName = sContactMM+&quot; &quot;+sContactFirstName+&quot; &quot;+sContactLastName;
						else if(sContactLastName != &quot;&quot; &amp;&amp; sContactLastName != null)
							sVFInstalledAssetName = sContactFirstName+&quot; &quot;+sContactLastName;
					}
				}
				if(GetFieldValue(&quot;Owner Contact Id&quot;) == &quot;&quot; || GetFieldValue(&quot;Owner Contact Id&quot;) == null)
					SetFieldValue(&quot;Owner Contact Id&quot;, sOwnerContactId);
				if(GetFieldValue(&quot;Service PIN&quot;) == &quot;&quot; || GetFieldValue(&quot;Service PIN&quot;) == null)
					SetFieldValue(&quot;Service PIN&quot;, sServicePIN);
				if(GetFieldValue(&quot;VF Installed Asset Name&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Installed Asset Name&quot;) == null)
					SetFieldValue(&quot;VF Installed Asset Name&quot;, sVFInstalledAssetName);
//				if(GetFieldValue(&quot;Display Reason Code&quot;) == &quot;&quot; || GetFieldValue(&quot;Display Reason Code&quot;) == null)
//					SetFieldValue(&quot;Display Reason Code&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF Comments&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Comments&quot;) == null)
//					SetFieldValue(&quot;VF Comments&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF TNR Id&quot;) == &quot;&quot; || GetFieldValue(&quot;VF TNR Id&quot;) == null)
//					SetFieldValue(&quot;VF TNR Id&quot;, &quot;&quot;);
//				if(GetFieldValue(&quot;VF Transfer Sub Type Connect&quot;) == &quot;&quot; || GetFieldValue(&quot;VF Transfer Sub Type Connect&quot;) == null)
//					SetFieldValue(&quot;VF Transfer Sub Type Connect&quot;, &quot;&quot;);
				WriteRecord();
			}//for(bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Line Number&quot;);
			ActivateField(&quot;Line Number&quot;);
			SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Root Order Item Id] = [Id]&quot;);
			SetSortSpec(&quot;Created(ASCENDING)&quot;);
			ExecuteQuery(ForwardOnly);
			for(i=1,bRecord=FirstRecord();bRecord;bRecord=NextRecord())
			{
				SetFieldValue(&quot;VF Line Number&quot;, i++);
				WriteRecord();
			}
		}//with(sBC)
	}
	catch(e)
	{
		sErrorMsg += e.errText;
		sApp.RaiseErrorText(sErrorMsg);
	}
	finally
	{
		sApp = null;
		sBC = sBO = null;
		/*Below variables are nullified by JAGJIT on 25/03/2019*/
		sBC1 = null;
		sBO1 = null;
	}
}"
