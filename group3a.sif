			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncBillingAccount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	VF Billing Account
 * Method Name           :	mSyncBillingAccount
 * Component Information :	Call the &quot;VF Account Sync Service&quot;.
 *							All errors including BS errors will be caught and logged.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/01/2005	MSL						Initial Version
 * 12/05/2005	TAlihos 				W2 Defect 1210 and 1221 changed the method being called  
 *										in VF Synch Account And Subscription business service
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages								
 */
function mSyncBillingAccount()
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.mSyncAccount&quot;);
		}
		
		/*******************************
		* Declare Objects
		*******************************/
		var bsSyncAccount;
		var psSyncInput;
		var psSyncOutput;

		psSyncInput		= TheApplication().NewPropertySet();			
		psSyncOutput	= TheApplication().NewPropertySet();
		bsSyncAccount	= TheApplication().GetService(&quot;VF Synch Account And Subscription&quot;);

		/*******************************
		* Invoke business service
		*******************************/		
		psSyncInput.SetProperty(&quot;BillingAccountId&quot;, this.GetFieldValue(&quot;Id&quot;));	
			
		//TAlihos 12/05/2005: Changed Param being passed in from SyncAccount
		//  TO SyncBillingAccount.
		bsSyncAccount.InvokeMethod(&quot;SyncBillingAccount&quot;, psSyncInput, psSyncOutput);
		
		if (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;).length &gt; 0)
			throw (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;));
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.mSyncAccount.strError= &quot; + strError);
		}
     	throw (strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.mSyncAccount&quot;);
		}
		
		psSyncInput = null;
		psSyncOutput = null;
		bsSyncAccount = null;
	}
}"
