			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeallocateMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeallocateMSISDN()
{
	try
	{
		 
		var psInputs,psOutputs,bsInvokeWorkflow;
		var sIsMSISDN = this.GetFieldValue(&quot;New MSISDN&quot;); //Subramanian 12SEP2014: Added to check if MSISDN value is null or not
		

		if(sIsMSISDN != &quot;&quot;)
		{
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Order Line Item Deallocate Number TBUI&quot;);
			psInputs.SetProperty(&quot;RowId&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
			psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));
			psInputs.SetProperty(&quot;Product Type&quot;, this.GetFieldValue(&quot;Product Type&quot;));
			psInputs.SetProperty(&quot;New MSISDN&quot;, this.GetFieldValue(&quot;New MSISDN&quot;));
			psInputs.SetProperty(&quot;New MSISDN Id&quot;, this.GetFieldValue(&quot;New MSISDN Id&quot;));
			bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			refreshScreen();
			bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
			refreshScreen();
		}
		else
		{	
			if( this.GetFieldValue(&quot;VF Port In TBUI&quot;) != &quot;No&quot;)
			{
				this.SetFieldValue(&quot;VF Port In - Service Account TBUI&quot;,&quot;&quot;); 
				this.SetFieldValue(&quot;VF Port In - DOB TBUI&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;VF Port In - Service Number TBUI&quot;,&quot;&quot;);
			}
			else
			{
				this.SetFieldValue(&quot;VF MSISDN TBUI&quot;,&quot;&quot;);
			}	
		}
	}
	catch(e)
	{
		refreshScreen();
		throw (e);
	}
	finally
	{
		/*Below variables are nullified by JAGJIT on 25/03/2019*/
		psInputs = null;
		psOutputs = null;
		bsInvokeWorkflow = null;


	}
}"
