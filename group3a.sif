			<BUSCOMP_BROWSER_SCRIPT
			   BROWSER_GROUP="All"
			   INACTIVE="N"
			   NAME="LaunchExtApp"
			   NEEDS_HIGH_INTERACTIVITY="Y"
			   PROCEDURE="LaunchExtApp"
			   SCRIPT="function LaunchExtApp(url)
{

	try
	{
		var sOptions = &quot;dialogWidth:880px;dialogHeight:560px;resizable:yes;status:no&quot;;
		var sArr=&quot;&quot;;
		
		url = encodeURI(url);
		theApplication().ShowModalDialog(url, sArr, sOptions);
	}
	catch(e)
	{
		theApplication().SWEAlert(e.toString());
	}
	finally
	{}
}"
