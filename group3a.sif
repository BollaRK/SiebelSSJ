			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{
	gAddressBeforeValue = this.GetFieldValue(&quot;Cal Full Address&quot;);	
	gAddressStartDate   = this.GetFormattedFieldValue(&quot;Start Date&quot;);
	TheApplication().SetProfileAttr(&quot;QAS Query Executed&quot;,&quot;N&quot;); // PR265
	TheApplication().SetProfileAttr(&quot;QASAppletInvoked&quot;,&quot;N&quot;);//VF CMA 15/06/09 - Added for NZ AVS QAS Search
	var sActiveView = TheApplication().ActiveViewName();// QAS Change Address Req - June 6-2014
	if (sActiveView == &quot;VF Connection View - Billing Detail&quot; || sActiveView == &quot;VF Billing Account Detail - Address View&quot;)
	{
	TheApplication().SetProfileAttr(&quot;QASChangeInvoked&quot;,&quot;Y&quot;); 
	}
	else
	{
		TheApplication().SetProfileAttr(&quot;QASChangeInvoked&quot;,&quot;N&quot;); //VF CMA 12/06/2014; To allow smart scripts to work as per BAU
	}
	
	
	
	/* ZZ commented out - pending resolution of SR in Siebel support site 38-1678938551 
	gAddressAttentionTo = this.GetFieldValue(&quot;Attention to&quot;);
	*/	
}"
