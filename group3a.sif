			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="deleteResourceRelationship"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function deleteResourceRelationship(boOrder, strBusCompName, strRootOrderLIId)
{
	var bcResourceRel;
	try
	{
		bcResourceRel = boOrder.GetBusComp(strBusCompName);
		bcResourceRel.ClearToQuery();
		bcResourceRel.ActivateField(&quot;Relationship Parent Id&quot;);
		bcResourceRel.SetSearchSpec(&quot;Relationship Parent Id&quot;, strRootOrderLIId);
		bcResourceRel.ExecuteQuery(ForwardOnly);
		var bRecordsExist = bcResourceRel.FirstRecord();
		var strid = bcResourceRel.GetFieldValue(&quot;Id&quot;);
		while (bRecordsExist) 
		{
			bcResourceRel.DeleteRecord();
			//bRecordsExist = bcResourceRel.FirstSelected();//TARIQ-25AUG2014-Commented this line
			bRecordsExist = bcResourceRel.FirstRecord();//TARIQ-25AUG2014-Added this line
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		
		bcResourceRel = null; /* This variable is nullified by JAGJIT on 25/03/2019*/

	}
	
}"
