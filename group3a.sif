			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="InvokeWorkflow"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function InvokeWorkflow(strWorkflowName)
{
/*
 * Component Name        : 	FS shipment
 * Function Name         : 	InvokeWorkflow
 * Component Information : 	Invokes the Workflow based on the name that is passed in
 
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 07/10/2009	MSL			R9.5		Initial Version.
 */
try
{
 	// Declare variables and objects
 	var bsWFManager;
	var psOutputs;
	var psInputs;
	var strWorkflowProcessError;

	// Instantiate Objects
	bsWFManager = TheApplication().GetService (&quot;Workflow Process Manager&quot;);
	psOutputs = TheApplication().NewPropertySet();
	psInputs = TheApplication().NewPropertySet();
	
	// Set the Object Id. This should be the Row Id of the Shipping Record
	psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Id&quot;));
	psInputs.SetProperty(&quot;ProcessName&quot;, strWorkflowName);

	// Invoke the workflow. All errors are handled in the workflow
	bsWFManager.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
}
					
catch (e)
{
	//Throw back to the calling function
	throw (e);
}
finally
{
	bsWFManager = null;
	psOutputs = null;
	psInputs = null;
}
}"
