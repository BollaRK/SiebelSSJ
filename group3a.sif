			<FIELD
			   CALCULATED="Y"
			   CALCULATED_VALUE="IIf ([VF MPP RCC]  IS  NOT  NULL , &quot;$&quot; + [VF MPP RCC], IIf ([VF IMEI RCC] = &quot;N/A&quot;, &quot;$0&quot;, IIf ([VF IMEI RCC] IS NULL , &quot;$0&quot;, &quot;$&quot; + [VF IMEI RCC])))"
			   COMMENTS="VF:Roseline 30/07/2014 - Created to show RCC in Line Item level in TBUI Order Summary View
IIf ([VF IMEI RCC] = &quot;N/A&quot;, &quot;0&quot;, &quot;$&quot; + [VF IMEI RCC])
IIf ([VF MPP RCC]  IS  NOT  NULL , &quot;$&quot; + [VF MPP RCC], IIf ([VF IMEI RCC] = &quot;N/A&quot;, &quot;$0&quot;, &quot;$&quot; + [VF IMEI RCC]))
"
			   COMPOSITE="N"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="Y"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="Y"
			   INACTIVE="N"
			   LINK_SPECIFICATION="N"
			   MESSAGE_DISPLAY_MODE="User Msg with Error Code Only"
			   MULTI_VALUED="N"
			   NAME="VF RCC"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   USE_DEFAULT_SENSITIVITY="Y"
			   UPDATED="10/12/2014 15:24:31"
