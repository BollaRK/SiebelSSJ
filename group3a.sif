			   UPDATED_BY="GOPALJ"
			   CREATED="01/09/2026 22:35:23"
			   CREATED_BY="GOPALJ">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
try
	{
		var bcOrder = this.ParentBusComp();
		
		if(FieldName == &quot;Freight Cost&quot;)
		{
			if (bcOrder != null)
			{
				bcOrder.SetFieldValue(&quot;VF Calculate Charges DateTime&quot;,&quot;&quot;);
				bcOrder.WriteRecord();
			}
		}
		
		if(FieldName == &quot;Ship To ID&quot;)
		{
		var storeqas = TheApplication().GetProfileAttr(&quot;QAS Pick DTS&quot;);
		if(storeqas == &quot;Y&quot;)
		{
		this.ActivateField(&quot;VHA Store Code&quot;);
		this.SetFieldValue(&quot;VHA Store Code&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;QAS Pick DTS&quot;,&quot;&quot;);
		}
		}
		if(FieldName == &quot;Receive Unknown Flag&quot;) // VHA NandhiniG 18/03/2020 : Added for R20.1 - Shipment Address CR
		{
		this.SetFieldValue(&quot;Unknown Order type&quot;,&quot;&quot;); //VHA NandhiniG 16/05/2020 : Added for PSMA Project
		if(TheApplication().GetProfileAttr(&quot;VHAUncheckPickPrimaryFlag&quot;) == &quot;Y&quot;){
			TheApplication().SetProfileAttr(&quot;VHAUncheckPickPrimaryFlag&quot;,&quot;&quot;);
		}
		else
		{
			this.ActivateField(&quot;Ship To ID&quot;);
			this.ActivateField(&quot;VF Account Id&quot;);
			this.ActivateField(&quot;VHA Address Type&quot;);
			this.ActivateField(&quot;VF Ship To Address Id&quot;);
			this.ActivateField(&quot;VF Intelligence Search Address&quot;);
			var sAcctId = this.GetFieldValue(&quot;VF Account Id&quot;);
			var sAddrId = &quot;&quot;,sPriAddrId =&quot;&quot;;
			var sExist = &quot;N&quot;;
			sPriAddrId = this.GetFieldValue(&quot;VF Ship To Address Id&quot;);
			sAddrId = this.GetFieldValue(&quot;Ship To ID&quot;);
			if(this.GetFieldValue(&quot;Receive Unknown Flag&quot;) == &quot;Y&quot; &amp;&amp; (sPriAddrId != sAddrId))
				{
					sPriAddrId = this.GetFieldValue(&quot;VF Ship To Address Id&quot;);
					if (sPriAddrId != null &amp;&amp; sPriAddrId != &quot;&quot;)
						{
							var oBC = this.GetPicklistBusComp(&quot;VF Shipment Street Address&quot;); 
							with (oBC)
							{
								ClearToQuery();
								SetViewMode(AllView);	   		
								SetSearchSpec(&quot;Id&quot;, sPriAddrId);
								ExecuteQuery();
								if (FirstRecord())
								{
									Pick();
									sExist = &quot;Y&quot;;
								}
							}
						}
				}
			if((this.GetFieldValue(&quot;Receive Unknown Flag&quot;) == &quot;N&quot;) &amp;&amp; (this.GetFieldValue(&quot;VHA ShipmentAddr Type&quot;) != &quot;Shipment&quot;))
				{
					sAddrId = this.GetFieldValue(&quot;Ship To ID&quot;);
					if(sAcctId != null &amp;&amp; sAcctId != &quot;&quot;)
						{
							var sBO = TheApplication().GetBusObject(&quot;VHA Shipment Address&quot;);
							var sBC = sBO.GetBusComp(&quot;VHA Shipment Address&quot;);
							with(sBC)
							{
								ClearToQuery();
								SetViewMode(AllView);
								ActivateField(&quot;Account Id&quot;);
								ActivateField(&quot;Shipment Address Id&quot;);
								ActivateField(&quot;End Date&quot;);			
								var searchst1 = &quot;[Account Id] = &apos;&quot; + sAcctId + &quot;&apos; AND [End Date] IS NULL&quot;;
								SetSearchExpr(searchst1);
								ExecuteQuery(ForwardOnly);
								if (FirstRecord())
								{
									sAddrId = GetFieldValue(&quot;Shipment Address Id&quot;);
								}
							}
						}
					if (sAddrId != null &amp;&amp; sAddrId != &quot;&quot;)
						{
							var oBC = this.GetPicklistBusComp(&quot;VF Shipment Street Address&quot;); 
							with (oBC)
							{
								ClearToQuery();
								SetViewMode(AllView);	   		
								SetSearchSpec(&quot;Id&quot;, sAddrId);
								ExecuteQuery(ForwardOnly);
								if (FirstRecord())
								{
									Pick();
									sExist = &quot;Y&quot;;
								}
							} 
						}
				}
			if(sExist == &quot;Y&quot;)
				{
				this.ActivateField(&quot;Cal addr end&quot;);
				this.ActivateField(&quot;Cal addr start&quot;);
					if(this.GetFieldValue(&quot;Cal addr start&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Cal addr start&quot;) == null)
						this.SetFieldValue(&quot;VF Intelligence Search Address&quot;,this.GetFieldValue(&quot;Cal addr end&quot;));
					else
						this.SetFieldValue(&quot;VF Intelligence Search Address&quot;,this.GetFieldValue(&quot;Cal addr start&quot;) + &quot; &quot; + this.GetFieldValue(&quot;Cal addr end&quot;));
				this.WriteRecord();
				this.InvokeMethod(&quot;RefreshRecord&quot;);
				}
		  }
		} // ENDS HERE
	}
	catch(e)
	{
		throw(e)
	}
	finally
	{
		bcOrder = null;
	}
}"
