			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreDeleteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreDeleteRecord ()
{
	//Neel UAT QC 2733
	//Need to Deallocate items
	//Deallocating MSISDN
	
	//if(this.GetFieldValue(&quot;Root Order Item Id&quot;) == &quot;&quot;)
	//{
	
		TheApplication().TraceOn();
		TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord&quot;);
		
		this.ActivateField(&quot;VF Order Type TBUI&quot;);
		var sOrderType = this.GetFieldValue(&quot;VF Order Type TBUI&quot;);
		//Deallocating SIM - beacuse its Allocating on Set Field Value, check for transaction type too
		if(sOrderType != &quot;Pre to Post transfer&quot;)
		{
		try
		{
			TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : MSISDN : &quot; + this.GetFieldValue(&quot;VF SIM TBUI&quot;));
			if(this.GetFieldValue(&quot;VF SIM TBUI&quot;) != &quot;&quot;)
			{
				TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : mDeallocateSIM : Start&quot;);
				//this.WriteRecord();
				mDeallocateSIM();
				//refreshScreen();
				//this.WriteRecord();
				TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : mDeallocateSIM : End&quot;);
			}
		}
		catch(e)
		{
			//refreshScreen();
			throw (e);
		}
		
		}	//end of if(sOrderType != &quot;Pre to Post transfer&quot;)	
		
		//Deallocating IMEI 
		try
		{
			TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : MSISDN : &quot; + this.GetFieldValue(&quot;VF IMEI TBUI&quot;));
			if(this.GetFieldValue(&quot;VF IMEI TBUI&quot;) != &quot;&quot;)
			{
				TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : mDeallocateIMEI : Start&quot;);
				//refreshScreen(); 
				TheApplication().SetProfileAttr(&quot;TBUIDEALLOCATEIMEI&quot;,&quot;Y&quot;);
				var psInputs,psOutputs,bsInvokeWorkflow;
		        psInputs = TheApplication().NewPropertySet();
				psOutputs = TheApplication().NewPropertySet();
				psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM DeAllocate IMEI TBUI&quot;);
				psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
				psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
				psInputs.SetProperty(&quot;RootOrderItemId&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));
				bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
				TheApplication().SetProfileAttr(&quot;TBUIDEALLOCATEIMEI&quot;,&quot;N&quot;);	
				//refreshScreen();
				TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : mDeallocateIMEI : End&quot;);
				bsInvokeWorkflow = null;
				psInputs = null;
				psOutputs = null;
			}
		}
		catch(e)
		{
			//refreshScreen();
			throw (e);
		}
		
		//Deallocating MSISDN - check to see if already allocated, or else skip, check for transaction type too
		if(sOrderType != &quot;Pre to Post transfer&quot;)
		{
		try
		{
			TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : MSISDN : &quot; + this.GetFieldValue(&quot;VF MSISDN TBUI&quot;));
			if(this.GetFieldValue(&quot;VF MSISDN TBUI&quot;) != &quot;&quot;)
			{
				TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : DeallocateNewMSISDNOK : Start&quot;);
				//refreshScreen(); 
				//this.WriteRecord();
				//this.InvokeMethod(&quot;DeallocateNewMSISDNOK&quot;);
				//this.WriteRecord();
				//refreshScreen();
				
				
				var sNewMSIDN = this.GetFieldValue(&quot;New MSISDN Id&quot;);
				if(sNewMSIDN != &quot;&quot;)
				{
					var psInputs,psOutputs,bsInvokeWorkflow;
			        psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Order Line Item Deallocate Number TBUI&quot;);
					psInputs.SetProperty(&quot;RowId&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
					psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;Product Type&quot;, this.GetFieldValue(&quot;Product Type&quot;));
					psInputs.SetProperty(&quot;New MSISDN&quot;, this.GetFieldValue(&quot;New MSISDN&quot;));
					psInputs.SetProperty(&quot;New MSISDN Id&quot;, this.GetFieldValue(&quot;New MSISDN Id&quot;));
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
					bsInvokeWorkflow = null;
					psInputs = null;
					psOutputs = null;	
					TheApplication().Trace(&quot;VF Order Entry - Line Items : BusComp_PreDeleteRecord : DeallocateNewMSISDNOK : End&quot;);
				}
								
				
			}
		}
		catch(e)
		{
			//refreshScreen();
			throw (e);
		}
		}//end of if(sOrderType != &quot;Pre to Post transfer&quot;)	
	//}// only for root product
	
	return (ContinueOperation);
}"
