			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{	
	// Created for Auditing 
	// KARP : 03/11/2011 : Updated For Femtocell		
	try
	{
		gPassword = this.GetFieldValue(&quot;Password&quot;);
		//VIVIND: Setting the Profile Attr for the BA Type
		gBATypeChange = this.GetFieldValue(&quot;Master Account Type&quot;);
		TheApplication().SetProfileAttr(&quot;BATypeChange&quot;,gBATypeChange);
		var sId = this.GetFieldValue(&quot;Id&quot;);
		TheApplication().SetProfileAttr(&quot;VF_BILLING_ACCOUNT_ID&quot;,sId);
		var sPayCalc = this.GetFieldValue(&quot;Check AU Prepay Calc&quot;); //VHA: 10/10/2014: PREM: Added the line of code to get the field value.
		TheApplication().SetProfileAttr(&quot;ISAUPrepayNew&quot;,sPayCalc); //VHA: 10/10/2014: PREM: Added the line of code to set the profile attribute.
		
		var sPrepayCalc = this.GetFieldValue(&quot;VF Check AU Prepay calc&quot;);//Added for AprBFX SIT Defect 3686
		TheApplication().SetProfileAttr(&quot;ISAUPrepayForBA&quot;,sPrepayCalc);//Added for AprBFX SIT Defect 3686
		TheApplication().SetProfileAttr(&quot;ISAUPrepay&quot;,sPrepayCalc);//Added for AprBFX SIT Defect 3686
		
	}
	catch (e)
	{
			TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
	}

}"
