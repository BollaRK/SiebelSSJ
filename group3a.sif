			<BUSCOMP_BROWSER_SCRIPT
			   BROWSER_GROUP="All"
			   INACTIVE="N"
			   NAME="RetrieveAutoInvoke"
			   NEEDS_HIGH_INTERACTIVITY="Y"
			   PROCEDURE="RetrieveAutoInvoke"
			   SCRIPT="function RetrieveAutoInvoke()
{

	try
	{
		var psInputs, psOutputs, bsTP, sFlg, sErr;
		psInputs = theApplication().NewPropertySet();
		psOutputs = theApplication().NewPropertySet();
		
		bsTP = theApplication().GetService(&quot;QAS - Business Service&quot;);
		psOutputs = bsTP.InvokeMethod(&quot;RetrieveAutoInvoke&quot;, psInputs);
		sFlg = psOutputs.GetProperty(&quot;Status&quot;);
		sErr = psOutputs.GetProperty(&quot;ErrorMessage&quot;);
		
		if(sErr != &quot;&quot; &amp;&amp; sErr.length &gt; 0)
		{
			throw(sErr);
		}
		
		return sFlg;
	}
	catch(e)
	{
		throw(e.toString());
	}
	finally
	{
		bsTP=null;
	}
}"
			   UPDATED="07/26/2014 19:21:50"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_BROWSER_SCRIPT>
			<BUSCOMP_BROWSER_SCRIPT
			   BROWSER_GROUP="All"
			   INACTIVE="N"
			   NAME="RetrieveTPDetails"
			   NEEDS_HIGH_INTERACTIVITY="Y"
			   PROCEDURE="RetrieveTPDetails"
			   SCRIPT="function RetrieveTPDetails (BOName, BCName, RecId, AddrId, TouchPoint, AutoInvoke)
{

	try
	{
		var psInputs, psOutputs, bsTP, sTP, sErr;
		psInputs = theApplication().NewPropertySet();
		psOutputs = theApplication().NewPropertySet();
		
		bsTP = theApplication().GetService(&quot;QAS - Business Service&quot;);
		psInputs.SetProperty(&quot;TouchPoint&quot;, TouchPoint);
		psInputs.SetProperty(&quot;AddressId&quot;, AddrId);
		psInputs.SetProperty(&quot;RecordId&quot;, RecId);
		psInputs.SetProperty(&quot;BOName&quot;, BOName);
		psInputs.SetProperty(&quot;BCName&quot;, BCName);
		psInputs.SetProperty(&quot;AutoInvoke&quot;, AutoInvoke);
		psOutputs = bsTP.InvokeMethod(&quot;GetTouchPointDetails&quot;, psInputs);
		
		sErr = psOutputs.GetProperty (&quot;ErrorMessage&quot;);
		
		if (sErr.length &gt; 0)
		{
			throw sErr;
		}
		
		sTP = psOutputs.GetProperty(&quot;Details&quot;);
		
		return sTP;
	}
	catch(e)
	{
		throw(e.toString());
	}
	finally
	{
		bsTP=null;
	}
}"
			   UPDATED="07/26/2014 19:21:50"
