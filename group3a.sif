			   CALCULATED="Y"
			   CALCULATED_VALUE="IIf (Language () = &quot;JPN&quot; OR Language () = &quot;CHS&quot; OR Language () = &quot;CHT&quot; OR Language () = &quot;KOR&quot;, [CityStateZipCountry JPN], [CityStateZipCountry ENU])"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="N"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="N"
			   INACTIVE="N"
			   LINK_SPECIFICATION="N"
			   MESSAGE_DISPLAY_MODE="User Msg with Error Code Only"
			   MULTI_VALUED="N"
			   NAME="CityStateZipCountry"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   TYPE="DTYPE_TEXT"
			   USE_DEFAULT_SENSITIVITY="Y"
			   UPDATED="07/26/2014 19:22:14"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:22:14"
			   CREATED_BY="SADMIN">
			</FIELD>
			<FIELD
			   CALCULATED="Y"
			   CALCULATED_VALUE=" [City] + IIf([City] IS NULL,&quot;&quot;, &quot;, &quot;) + [State] + IIf([State] IS NULL,&quot;&quot;, &quot; &quot;) + [Postal Code] + IIf([Postal Code] IS NULL,&quot;&quot;, &quot; &quot;) + [Country]"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="N"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="N"
			   INACTIVE="N"
			   LINK_SPECIFICATION="N"
			   MESSAGE_DISPLAY_MODE="User Msg with Error Code Only"
			   MULTI_VALUED="N"
			   NAME="CityStateZipCountry ENU"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   TYPE="DTYPE_TEXT"
			   USE_DEFAULT_SENSITIVITY="Y"
			   UPDATED="07/26/2014 19:22:14"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:22:14"
			   CREATED_BY="SADMIN">
			</FIELD>
			<FIELD
			   CALCULATED="Y"
			   CALCULATED_VALUE="[Postal Code] + IIf([Postal Code] IS NULL,&quot;&quot;, &quot; &quot;) + [Country] + [State] + [City]"
