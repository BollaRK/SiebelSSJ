			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="FindParentBillingProfile"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function FindParentBillingProfile(iPropSet, oPropSet)
{
	//////////////////////////////////////////////////////////////////////////////
	// Description: This function will traverse the parent account tree recursivly
	//              until it finds an account with a paying billing profile.
	//              Return true if it finds a parent account with paying billing
	//              profile.  Return false otherwise.
	//
	// Inputs:		iPropSet.Account Id: 		The Account Id.
	// Outputs:		oPropSet.Currency Code:  	Paying Account&apos;s Currency Code
	//              oPropset.Bill Frequency:	Paying Account&apos;s Bill Frequency
	//				oPropSet.Bill Cycle Day:	Paying Account&apos;s Bill Cycle Day
	//////////////////////////////////////////////////////////////////////////////
	
	var accountBO = TheApplication().GetBusObject(&quot;Account&quot;);
	var accountBC = accountBO.GetBusComp(&quot;Account&quot;);
	var accountId = iPropSet.GetProperty(&quot;Account Id&quot;);
	var returnVal = true;
	var profileBC;
	var payMethod;
	var parentAccountId;
	
	// Get the account record
	accountBC.SetViewMode(AllView);
	accountBC.ClearToQuery();
	accountBC.SetSearchSpec(&quot;Id&quot;, accountId);
	accountBC.ExecuteQuery();
	
	if (accountBC.FirstRecord())
	{
		// Get the billing profile of the account
		profileBC = accountBO.GetBusComp(&quot;Com Invoice Profile&quot;);
		profileBC.ActivateField(&quot;Payment Method&quot;);
		profileBC.ActivateField(&quot;Bill Frequency&quot;);
		profileBC.ActivateField(&quot;Bill Cycle Day&quot;);
		profileBC.ExecuteQuery();  //execute BC constrained by link
		
		if (profileBC.FirstRecord())
		{			
			payMethod = profileBC.GetFieldValue(&quot;Payment Method&quot;);
			
			if( payMethod != &quot;Non-Paying&quot;)
			{
				// This account is a paying account.
				// Copy the billing information and return.
				oPropSet.SetProperty(&quot;Currency Code&quot;, accountBC.GetFieldValue(&quot;Currency Code&quot;));
				oPropSet.SetProperty(&quot;Bill Frequency&quot;,profileBC.GetFieldValue(&quot;Bill Frequency&quot;));
				oPropSet.SetProperty(&quot;Bill Cycle Day&quot;,profileBC.GetFieldValue(&quot;Bill Cycle Day&quot;));  
				profileBC = null;
				accountBC = null;
				accountBO = null;				
				return returnVal;
			}
		}

		// This account is not a valid paying account, so check the parent.
		parentAccountId = accountBC.GetFieldValue(&quot;Parent Account Id&quot;);
			
		if (parentAccountId != &quot;&quot;)
		{
			// Keep looking recursively
			iPropSet.SetProperty(&quot;Account Id&quot;, parentAccountId);
			returnVal = FindParentBillingProfile(iPropSet, oPropSet);
		}
		else
		{
			// We reach the root but still no paying account.
			// Return false.
			returnVal = false;
		}
	}
	
	profileBC = null;
	accountBC = null;
	accountBO = null;				
	
	return returnVal;	
}"
			   SEQUENCE="9"
			   UPDATED="06/07/2014 00:17:27"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="IsBillSegmentPrepay"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function IsBillSegmentPrepay()
{
/*
 * Component Name        : Com Invoice Profile
 * Method Name           : IsBillSegmentPrepay
 * Component Information : This method checks whether the customer account bill
 *						   segment Prepay or Postpay.  The comparison is against
 *						   the Prepay bill segment stored in System Preferences for
 *						   bulk provisioning.
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 18/12/2006	RP					Initial
 */
	
 try
 {
 	// Trace
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:Com Invoice Profile.IsBillSegmentPrepay&quot;);
	}
	
	var strARII;
	var strSysPrefBillSeg;
	var strCABillSeg;
	
	// Either link spec or force active
	strCABillSeg = this.GetFieldValue( &quot;Bill Segment&quot; )
	strARII      = this.GetFieldValue( &quot;ARII&quot; );
	strSysPrefBillSeg = mGetSysPref( &quot;VF Prepay AU Bill Segment&quot; );  // include Fiji as well
	
	if ( strCABillSeg == strSysPrefBillSeg )
		return( &quot;Y&quot; );
	else
		return( &quot;N&quot; );
	
 }
 catch( e )
 {
	if (defined(e.errText))
	{
		var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		var strError = arguments.callee + ToString(e); 
	}
	// Trace
 	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:Com Invoice Profile.IsBillSegmentPrepay.Error:&quot; + strError );
	}
	throw( strError );
 }
 finally
 {
 	// Trace
 	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:Com Invoice Profile.IsBillSegmentPrepay&quot;);
	}
 }

}"
