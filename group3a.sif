			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckForExistingCustomer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckForExistingCustomer (sAccountId){
/*
 * Component Name        : VF Com Invoice Profile TBUI
 * Method Name           : mCheckForExistingCustomer
 * Component Information : created to check for existing customer for PKE000000060904 
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 20/09/2018	Aruns					Initial
 */

		
		try
		{
		var sBO = TheApplication().GetBusObject(&quot;VF Generic TBUI BO&quot;);
		var sBC = sBO.GetBusComp(&quot;VF Asset Mgmt Asset Thin TBUI&quot;);
		var ExistingCustomer = &quot;N&quot;;
		    if(sAccountId != &quot;&quot;)
			{
			with(sBC)
				{
				
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Service Account Id&quot;);
				var SerachExpr = &quot;[Service Account Id] = &apos;&quot;+sAccountId+&quot;&apos;&quot;;
				SetSearchExpr(SerachExpr);
				ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{
							ExistingCustomer = &quot;Y&quot;;							
							}
				}
			}
			return(ExistingCustomer);
	     
	    }
		
		catch(e)
		{
		throw(e);
		}
		finally
		{
		sBC = null;
		sBO = null;
		}
	}"
