			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	BusComp_PreSetFieldValue
 * Component Information : 	Event handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	======================================
 * 19/12/04     ZAHIDZ		W2 Build	added validation code for address type
   09/08/14     MURALIDHARANK 1847     MURALIDHARANK 8/9/2014 SIT 1847 Manual Address Fix
 */


//MURALIDHARANK 8/9/2014 SIT 1847 Manual Address Fix
switch (FieldName)
	{
		case &quot;VF Manual Address Flg&quot;:
		var bQASExecuted = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;); //Added for PKE000000023205 fix - chitra - 29/05/2015
		if (bQASExecuted != &quot;Y&quot;)
			{
				TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query PSMA at least once before saving an unvalidated address.&quot;);
			}
		if(FieldValue == &quot;Y&quot;)
		{
		    this.SetFieldValue(&quot;Validation Status&quot;,&quot;2&quot;);
			this.SetFieldValue(&quot;Address Floor&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Address Floor Type&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Address Format&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Address Street Type - AU&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;City AU&quot;,&quot;&quot;);
		//	this.SetFieldValue(&quot;Country&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;DPID&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;POBox&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Postal Code AU&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;State&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Street Address&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Street Address 2&quot;,&quot;&quot;);
			this.SetFieldValue(&quot;Freeform address line 1&quot;, &quot;&quot;);
		}
		break;
		//Added by Kailash for PKE38363
		case &quot;End Date&quot;:
		case &quot;SSA Primary Field&quot;:
		if(this.GetFieldValue(&quot;End Date&quot;) != &quot;&quot; || this.GetFieldValue(&quot;SSA Primary Field&quot;) == &quot;Y&quot;)
		{
			TheApplication().RaiseErrorText(&quot;Primary Address cannot be ended!&quot;);
		}
		break;		
		//Added by Kailash for PKE38363
	}
	//MURALIDHARANK 8/9/2014 SIT 1847 Manual Address Fix
	return(ValidateAddressType(FieldName, FieldValue));
	
	

	
}"
			   SEQUENCE="15"
			   UPDATED="06/10/2020 16:32:39"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	BusComp_PreWriteRecord
 * Component Information : 	Method handler
 * Called From			 :
 * Called To			 :	VF Address Toolkit Service
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 02/03/2004	VLi						Change address to uppercase
 * 19/03/2004	VLi						Set AddrCountry to Account Home Network
 * 25/03/04		JDM						Added validation to enfore the population of the fields &apos; Postal Code&apos; and &apos;State&apos;
 										if the address is primary for an australian account.
 * 02/04/2004	PK						Get the Home Network from a user property for
 *										cases where address is not created in the GUI.
 * 10/9/2004	JE						Added validation: primary address should be in
 *										Australia for Australian accounts.
 * 13/9/2004	JE						Moved RaiseErrorText to finally.
 * 14/10/2004	JE				d2334	Initialise sErrorMessage
 * 22/12/2004   ZZ			W2 Build	added &apos;AddrCopyRecordFlag&apos; condition for wave 2
 * 06/05/2008	DO			PRD7967		Set the DPID back to null if the address is invalid  
 * 27/05/2008	Karthik		PRD7967		Set the Validation Status to &apos;2&apos; if a QAS error was encountered
 * 13/06/2008	Huik		AVS DF2494	Set Address Street Type - AU = &quot;Street&quot; if address is valid 
 *										and Address Street Type is null
 * 16/06/2008	Huik		DF2515 (AVS)If Address Type is Oversea, will not check if ARII = Country
 *							DF2507 (AVS)
 *02/07/2009   CMA          AVS NZ      Added condition country = &apos;AUS&apos;, to avoid impact on NZ functionality
 *                                      and included set Checked Flag=&apos;Checked&apos;, if AVS Query applet is atleast invoked
 */

	var bsError, psErrorInput, psErrorOutput;
	var sErrorMessage = &quot;&quot;;
	var svc, Inputs, Outputs; 
	var sReturnCode	= ContinueOperation;
	//Kalidas:05/07/2015:Code added for Address Validation CR
	var sActiveView = TheApplication().ActiveViewName();
	if(sActiveView == &quot;VF Billing Details View - TBUI&quot; || sActiveView == &quot;VF Connection Wizard View - Billing Detail - TBUI&quot;)
	{
		var sManulaflg = this.GetFieldValue(&quot;VF Manual Address Flg&quot;);
		if(sManulaflg == &quot;Y&quot;)
		{
			var sPostVal = TheApplication().GetProfileAttr(&quot;PostalCodeValidateTriggered&quot;);
			if(sPostVal == &quot;N&quot;)
				TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query AusPost atleast once before saving an unvalidated address.&quot;);
		}
	
	}
	//Kalidas:05/07/2015:End of code

 	try
 	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.BusComp_PreWriteRecord.UserProp:AccountHomeNetwork=&quot; + this.GetUserProperty(&quot;AccountHomeNetwork&quot;));
		}
		
		// no need to continue - attribute is set before write record of address record happens in code
		// this flag is set in Account BC BusComp_WriteRecord event in PropAddrToBillingAcct function
		if (TheApplication().GetProfileAttr(&quot;AddrCopyRecordFlag&quot;) == &quot;Y&quot;)
		{ 
			return(sReturnCode);
		}
		
		//VF DO PRD7967 06/05/2008
		if (this.GetFieldValue(&quot;Validation Status&quot;) != &quot;1&quot;)
		{
			this.SetFieldValue(&quot;DPID&quot;, &quot;&quot;);
		}

		//VF Karthik PRD7967 27/05/2008 - Set the Validation Status to &quot;2&quot; if QAS error was encountered
		if (TheApplication().GetProfileAttr(&quot;VFQASError&quot;) == &quot;1&quot;)
		{
			this.SetFieldValue(&quot;Validation Status&quot;, &quot;2&quot;);
		}
		
		//VF Karthik PRD7967 27/05/2008 - For Adrs type = &quot;Overseas&quot;,
		//Validation Status is always valid
		if (this.GetFieldValue(&quot;Address Format&quot;) == &quot;Overseas&quot;)
		{
			this.SetFieldValue(&quot;Validation Status&quot;, &quot;1&quot;);
		}
		
		//VF Karthik PRD7967 03/06/2008 - If QAS is down skip prewrite validations
		//if (TheApplication().GetProfileAttr(&quot;VFQASError&quot;) != &quot;1&quot;)
		if (TheApplication().GetProfileAttr(&quot;VFQASError&quot;) == &quot;3&quot;)//Neel Changed
		{
			sReturnCode = ValidateAddressFields();
		}
		
		//VF Huik DF2494 13/06/2008//VF CMA 02/07/09 added condition country
		if ((this.GetFieldValue(&quot;Validation Status&quot;) == &quot;1&quot;)
			&amp;&amp; (this.GetFieldValue(&quot;Address Street Type - AU&quot;) ==  &quot;&quot;)
			&amp;&amp; (this.GetFieldValue(&quot;Country&quot;) == &quot;Australia&quot;))
		{ 
			var sNA = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ADDRESS_STREET_TYPE&quot;, &quot;Street&quot;);
			this.SetFieldValue(&quot;Address Street Type - AU&quot;, sNA);
			this.SetFieldValue(&quot;Validation Status&quot;, &quot;1&quot;);
		}
		
		//VF CMA 06/07/09 - Added setting checked flag = &apos;Checked&apos;, if AVS query applet is invoked irrespective to valid add/. picked or not
		//if (TheApplication().GetProfileAttr(&quot;QASAppletInvoked&quot;) == &apos;Y&apos;)
		//this.SetFieldValue(&quot;Checked Flag AVS&quot;, &quot;Checked&quot;);
		//VF CMA 06/07/09 - Added below stmt if addresses is created/updated by external source i.e, Onlince Customer Survey
       	/*if (TheApplication().GetProfileAttr(&quot;VFQASIsInbound&quot;) == &quot;Y&quot;)
       	{
       	   this.SetFieldValue(&quot;Validation Status&quot;, &quot;2&quot;);
       	   this.SetFieldValue(&quot;Checked Flag AVS&quot;, &quot;Unchecked&quot;);
       	   this.SetFieldValue(&quot;Processed Flag AVS&quot;, &quot;Unprocessed&quot;);
       	   this.SetFieldValue(&quot;DPID&quot;, &quot;&quot;);
       	}*/
		
	}
	catch(e)
	{

		if(gErrorMessage != &quot;&quot;)
		{
			//*************************************
			//* Error Handling
			//*************************************
			sErrorMessage = &quot;BC CUT Address - PreWriteRecord: &quot; + gErrorMessage;
			gErrorMessage = &quot;&quot;;
			psErrorInput  = TheApplication().NewPropertySet();
			psErrorOutput = TheApplication().NewPropertySet();
			bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
			psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;BC CUT Address&quot;);
			psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreWriteRecord&quot;);
			psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
			bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
			sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		}
		else
		{
			if (!defined(e.errText))
			{
				e.errText = ToString(e);
			}
		
			sErrorMessage = e.errText;
		}
		
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.BusComp_PreWriteRecord&quot; + &quot;Err=&quot; + sErrorMessage);
		}

	}
	finally
	{
		
		this.SetUserProperty(&quot;AccountHomeNetwork&quot;, &quot;&quot;);
		
		// destroy std vars
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;

		// Release objects
		svc = null;
		Inputs = null;
		Outputs = null;

		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.BusComp_PreWriteRecord&quot;);
		}
		
		// error has to be raised after user property cleared, or error msg will be lost.
		if (sErrorMessage != &quot;&quot;)
		{
			TheApplication().RaiseErrorText(sErrorMessage);
		}
		
		return (sReturnCode);
	}
}"
			   SEQUENCE="16"
			   UPDATED="05/16/2019 19:50:08"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	CUT Address
 * Method Name           :	BusComp_SetFieldValue
 * Component Information :	If certain fields change in this object they need to be
 *							communicated to externals. Set UserProp for use in
 *							WriteRecord as part of Account Sync framework.
 *
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========		================================
 * 10/01/2005	MSL							Initial Version
 * 24/06/2005	TAlihos		W2Defect 2886	Added additional case state to monitor
 *											SSA Primary Field any changes in Account Primary Address
 * 27/02/2008   shanmukl    #6981           Added End Date field to trigger sync when modified
 * 06/05/2008	DO			PRD7967			Added sync account/sub cases for City AU and Postal Code AU.
 *											Set Validation Status addresses that are manually changed
 *											rather than picked in from QAS pickmap
 * 27/05/2008	Karthik		PRD7967			Set the Validation Status to &apos;2&apos; if a QAS error was encountered
 * 05/06/2008   Huik		DF2480 (AVS)	GetProfie Attriube &quot;IsInbound&quot; for BC CUT Address update
 *											If &quot;Y&quot; skip checking QAS
 * 08/06/2008	Huik		DF2496/2052(AVS)Don&apos;t reset Validation Status for Primary Address (Write twice)
 *											Same applies to Attention To, End date
 * 11/06/2008	Huik		DF2499 (AVS)	AU AVS will use new field Address Street Type - AU instead of
 *											Address Street Type (BAU for NZ)
 * 29/07/2008	MGT			DF8622 (AVS)	There is no need to trigger an update of the validation flag
 *											when SSA Primary field is modified.
 * 13/07/09     CMA         NZ AVS 402		Updating Processed flag to Unprocessed, when the address is updated as Invalid after AVS validation
 */
function BusComp_SetFieldValue (FieldName)
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.SetFieldValue&quot;);
		}
		
		// only convert to upper case if the address is created thru the gui or interface
		// if it is a cascade copy from CA to BA then it is already in upper case - no need to convert
		if (TheApplication().GetProfileAttr(&quot;AddrCopyRecordFlag&quot;) != &quot;Y&quot;)
			ConvertToUpperCase(FieldName);
		
		switch (FieldName)
		{
			//bhava 12/06/24: Created for tallyman to PCC
			case &quot;Address Type&quot;:
			case &quot;Type&quot;:
			case &quot;Start Date&quot;:
				this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
				return (ContinueOperation);
				break;
				//End of PCC Changes
			case &quot;Address Building&quot;:
			case &quot;Address Floor&quot;:
			case &quot;Address Floor Type&quot;:
			case &quot;Address Format&quot;:
			case &quot;Address Street Type&quot;:
			// DF2499 (AVS) HUIK 11/06/08
			// Add new field to store street type value for au avs
			// case &quot;Address Street Type - AU&quot;:
			case &quot;Attention to&quot;:
			case &quot;City&quot;:
			case &quot;Country&quot;:
			case &quot;District&quot;:
			case &quot;Freeform address line 1&quot;:
			case &quot;Freeform address line 2&quot;:
			case &quot;POBox&quot;:
			case &quot;Postal Code&quot;:
			case &quot;Private Bag&quot;:
			case &quot;Private Bag Name&quot;:
			case &quot;Primary Address Flg&quot;:
			case &quot;Rural Delivery&quot;:
			case &quot;State&quot;:
			case &quot;Street Address&quot;:
			case &quot;Street Address 2&quot;:
			//Added 24/06/2005 TAlihos 
			case &quot;SSA Primary Field&quot;:
			//Added 27/02/2008 shanmukl for #6981
			case &quot;End Date&quot;:			
			//VF DO PRD7967 06/05/2008
			case &quot;City AU&quot;:
			case &quot;Postal Code AU&quot;:

				this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
				this.SetUserProperty(&quot;SyncSubscription&quot;, &quot;Y&quot;);
				//VF Huik DF2480 (AVS) Check if it is from SSG
				//If Yes skip the check of QAS error
			
				if (TheApplication().GetProfileAttr(&quot;VFQASIsInbound&quot;) != &quot;Y&quot;)
				{
					//VF DO PRD7967 06/05/2008
					// Karthik 30-05-2008 Set Validation Status = 2 if QAS is down
					if (TheApplication().GetProfileAttr(&quot;VFQASError&quot;) == &quot;1&quot;)
					{ 
						this.SetFieldValue(&quot;Validation Status&quot;, &quot;2&quot;);
					}
					// VF Huik DF2496 (AVS) 08/06/08
					// Only set Validation status if gCheckedQAS is false AND field is
					// not SSA Primary Field
					else if (((this.GetFieldValue(&quot;Validation Status&quot;) == &quot;1&quot;)
							|| (this.GetFieldValue(&quot;Validation Status&quot;) == &quot;2&quot;))
							&amp;&amp; ((FieldName == &quot;SSA Primary Field&quot;) 
							|| (FieldName == &quot;End Date&quot;)
							|| (FieldName == &quot;Attention to&quot; )))
					{
					}
					// DF8622 Mark Troy
					else if (FieldName != &quot;SSA Primary Field&quot;)
					{
						this.SetFieldValue(&quot;Validation Status&quot;, &quot;0&quot;);
					}
							
				}				
				break;

			/* Call upon WriteRecord
			case &quot;Start Date&quot;:
			case &quot;Account Primary Address Id&quot;:
			case &quot;Parent Primary Address Id&quot;:
			case &quot;Primary Account Address Id&quot;:
			case &quot;SSA Primary Field&quot;:
				this.SetUserProperty(&quot;StartDateChanged&quot;, &quot;Y&quot;);
				break;
			*/

			default:
				break;
		}
		//VF CMA 13/07/09 - Updating Processed flag to Unprocessed, when the address is updated as Invalid after AVS validation
		if(this.GetFieldValue(&quot;Validation Status&quot;) == &apos;0&apos;)
		{
			this.SetFieldValue(&quot;Processed Flag AVS&quot;, &quot;Unprocessed&quot;);
		}
		else if(this.GetFieldValue(&quot;Validation Status&quot;) == &apos;1&apos;)
		{
			this.SetFieldValue(&quot;Processed Flag AVS&quot;, &quot;Processed&quot;);
		}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
	    
	    //************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.SetFieldValue.strError=&quot; + strError);
		}
     	TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.SetFieldValue&quot;);
		}
	}
}"
			   SEQUENCE="17"
			   UPDATED="03/20/2025 04:53:19"
			   UPDATED_BY="BHAVA"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	BusComp_WriteRecord
 * Component Information : 	Method handler
 * Called To			 :	VF Address Toolkit Service
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/02/2004	VLi						Parsing variables to create Activity
 * 01/03/2004	VLi						Add Trace statement and exception handling
 * 02/04/2004	PK						Added means of bypassing this code that won&apos;t
 *										work when not executed in the UI.
 * 14/10/2004	JE			d2334		Removed unnecessary ActivateField
 * 12/01/2005	MSL						Call mSyncAccount for certain fields (See SetFieldValue)
 * 31/01/2005	MSL						Call mSyncSubscription for certain fields (See SetFieldValue)
 * 27/05/2009	LiV			PR265		Added code to reset the profile attribute
 */
 
	// Declare all objects destroyed in the finally statement
 	var bsError, psErrorInput, psErrorOutput;
 	
 	var sErrorMessage = &quot;&quot;;
	var sReturnCode = ContinueOperation;
	
	
	
 	try
 	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.BusComp_WriteRecord.strBypassWriteRecordCode=&quot; + strBypassWriteRecordCode);
		}
		
		// Added for TBUI - to check postal code length	
		var sView = TheApplication().ActiveViewName(); 
		if(sView == &quot;VF Connection Wizard View - Billing Detail - TBUI&quot;)
		{
			var sPostCode = this.GetFieldValue(&quot;Postal Code AU&quot;);
			var sLength = sPostCode.length;
			if(sLength != 4)
			{
				sErrorMessage = &quot;Please enter four digit Postal Code number&quot;;
				TheApplication().RaiseErrorText(&quot;Please enter four digit Postal Code number&quot;);
			}
		}//End of TBUI
		
		// LIV - PR265: Reset profile attribute
		TheApplication().SetProfileAttr(&quot;QAS Query Validation&quot;, &quot;N&quot;);
		
		sActiveView1 = TheApplication().ActiveViewName(); //STE:Skipped this based on ActiveViewName//Priya: Added TBUI view To end date BA address Upgrade 15/5/09
		if(sActiveView1 == &quot;VF Billing Account Detail - Address View&quot; || sActiveView1 ==&quot;VF Connection Wizard View - Billing Detail - TBUI&quot; || sActiveView1 ==&quot;VF Billing Details View - TBUI&quot;) //VHA 19.3/PKE/NIRMAL/21MAY2019/Added 2nd view for PKE000000057945
		{
			if(sParentAddrId != sCurrentId)
			{
				if(sParentAddrId != null &amp;&amp; sParentAddrId != &quot;&quot; &amp;&amp; sParentAddrId.toUpperCase() != &quot;NO MATCH ROW ID&quot;)
				{
			
					var bsProdModSvc = TheApplication().GetService(&quot;VHA Interactive Service&quot;);
					var psBSInputs = TheApplication().NewPropertySet();
					var psBSOutputs = TheApplication().NewPropertySet();
					psBSInputs.SetProperty(&quot;AddressId&quot;, sParentAddrId);
					psBSInputs.SetProperty(&quot;AccountId&quot;, sParentAccntId);
					bsProdModSvc.InvokeMethod(&quot;UpdateContactEndDate&quot;, psBSInputs, psBSOutputs);
					
					var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
					var psIn = TheApplication().NewPropertySet();
					var psOut = TheApplication().NewPropertySet();
					psIn.SetProperty(&quot;Refresh All&quot;,&quot;Y&quot;);
					svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;,psIn,psOut);
					
					//this.InvokeMethod(&quot;RefreshRecord&quot;);
					
				}
	
			}
		}
		
		// no need to create an activity, when we propagate address from customer to billing account(s)
		// this flag is set in Account BC BusComp_WriteRecord event in PropAddrToBillingAcct function
		if (TheApplication().GetProfileAttr(&quot;AddrCopyRecordFlag&quot;) != &quot;Y&quot;)
		{ 
			CreateAddressUpdateActivity();
		}
		
		// MSL - 10/01/2005 Synchronise address details if certain fields have been changed. 
		// (See SetFieldValue)
		if (this.GetUserProperty(&quot;SyncAccount&quot;) == &quot;Y&quot;
			&amp;&amp; this.GetFieldValue(&quot;Account Status&quot;) != 
			TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_BILL_ACCT_STATUS&quot;,&quot;Open&quot;))
		{
			this.SetUserProperty(&quot;SyncAccount&quot;, &quot;N&quot;);
			mSyncAccount();
		}
		
		// MSL - 31/01/2005 Synchronise address details if certain fields have been changed. 
		// (See SetFieldValue)
		// NB Only synch subscription details for Customer Accounts
		if (this.GetUserProperty(&quot;SyncSubscription&quot;) == &quot;Y&quot;
			&amp;&amp; this.GetFieldValue(&quot;Account Type Code&quot;) == &quot;Customer&quot;
			&amp;&amp; this.GetFieldValue(&quot;Account Status&quot;) != 
			TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_BILL_ACCT_STATUS&quot;,&quot;Open&quot;))
		{
			this.SetUserProperty(&quot;SyncSubscription&quot;, &quot;N&quot;);
			mSyncSubscription();
		}
		
		
	}
	catch(e)
	{
		// error caught
		if(!defined(e.errText))
	        e.errText = e.toString();
	        
		sErrorMessage = e.errText;

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;CUT Address&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_WriteRecord&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.BusComp_WriteRecord&quot; + &quot;Err=&quot; + sErrorMessage);
		}

		TheApplication().RaiseErrorText(sErrorMessage);
	}
	finally
	{
		// destroy objects
		bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		//bsProdModSvc = null;
		psBSInputs = null;
		psBSOutputs = null;
		//svcUI = null;
		psIn = null;
		psOut = null;
		//end 18/03/2019

		/*Below variables are nullified by Balamurugan on 03/10/2019*/
		if(defined(bsProdModSvc)) { bsProdModSvc = null; }
		if(defined(svcUI)) { svcUI = null; }
		
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.BusComp_WriteRecord&quot;);
		}
		return(sReturnCode);
	}
}"
			   SEQUENCE="18"
			   UPDATED="10/05/2019 02:32:12"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ConvertToUpperCase"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ConvertToUpperCase(FieldName)
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	ConvertToUpperCase
 * Component Information : 	support function
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	========================================
 * 18/04/05     ZAHIDZ		W2 Build	used to convert AU addresses to upper case
 */
  try
	{
		var sAccountNetwork;
		// When addresses are not created in the GUI the implicit join to account
		// is not valid so the value of the Account Home Network is not accessible.
		// To allow the case conversion to fire, the Account Home Network is passed
		// in as a user property.	
		if ((this.GetUserProperty(&quot;AccountHomeNetwork&quot;) != &quot;&quot;)
			&amp;&amp;	(this.GetFieldValue(&quot;Account Home Network&quot;) == &quot;&quot;))
		{
			sAccountNetwork = this.GetUserProperty(&quot;AccountHomeNetwork&quot;);			
		}
		else
		{
			sAccountNetwork = this.GetFieldValue(&quot;Account Home Network&quot;);
		}
		
		// convert all addresses that have accounts with Australia as their homenetwork
		if (sAccountNetwork.toUpperCase() == &quot;AUSTRALIA&quot;)
		{
			switch(FieldName)			
			{
				case &quot;Attention to&quot;:
				case &quot;Address Floor&quot;:
				case &quot;Address Building&quot;:
				case &quot;Street Address 2&quot;:
				case &quot;Street Address&quot;:
				case &quot;POBox&quot;:
				case &quot;Private Bag&quot;:
				case &quot;Private Bag Name&quot;:
				case &quot;Rural Delivery&quot;:
				case &quot;Freeform address line 1&quot;:
				case &quot;Freeform address line 2&quot;:
					this.SetFieldValue(FieldName,this.GetFieldValue(FieldName).toUpperCase());
					break;
								
				default: break; // nothing
			}	
		}
	}
	catch(e)
	{
		throw (e);	
	}
	finally
	{
		// nothing
	}
}"
			   SEQUENCE="2"
			   UPDATED="07/26/2014 19:21:50"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateAddressUpdateActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CreateAddressUpdateActivity()
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	CreateAddressUpdateActivity
 * Component Information : 	support function
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	=========================
 * 08/02/05     ZAHIDZ		W2 Build	initial build for wave 2
 */
	try
	{
		var strBypassWriteRecordCode;		
		var bcParent, svc; 
		var bsError, psErrorInput, psErrorOutput;
 		var sErrorMessage = &quot;&quot;;
 		var category, type, status, desc, comment;

		var Inputs  = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();
				
		if (gNewAddressRecord == false) // only create activity for an updated address record
		{
			strBypassWriteRecordCode = this.GetUserProperty(&quot;BypassWriteRecord&quot;);
		
			if (strBypassWriteRecordCode == &quot;&quot;)
			{
	        	bcParent = this.ParentBusComp();
				if (bcParent != null)
				{	
					if (bcParent.Name() == &quot;Contact&quot;)
					{
						Inputs.SetProperty(&quot;Contact Id&quot;, bcParent.GetFieldValue(&quot;Id&quot;));
					}
					else
					{
						Inputs.SetProperty(&quot;Account Object Id&quot;, bcParent.GetFieldValue(&quot;Id&quot;));
					}
				}
				
				desc = &quot;Address Updated&quot;;
				comment = &quot;&quot;;
				
				/* ZZ - commented out pending resolution of SR in Siebel support web 38-1678938551			
				if (gAddressAttentionTo != this.GetFieldValue(&quot;Attention to&quot;))
				{
					comment = &apos;Attention to before update: &quot;&apos; + gAddressAttentionTo + &apos;&quot;   &apos;;
					comment = comment + &apos;Attention to after update: &quot;&apos; + this.GetFieldValue(&quot;Attention to&quot;) + &apos;&quot;   &apos;;
				}
				*/
				
				if (gAddressStartDate != this.GetFormattedFieldValue(&quot;Start Date&quot;))
				{
					comment = comment + &apos;Start date before update: &quot;&apos; + gAddressStartDate + &apos;&quot;   &apos;;
					comment = comment + &apos;Start date after update: &quot;&apos; + this.GetFormattedFieldValue(&quot;Start Date&quot;) + &apos;&quot;   &apos;;
				}
				
				
				if (gAddressBeforeValue != this.GetFieldValue(&quot;Cal Full Address&quot;))
				{
					comment = comment + &apos;Address before update: &quot;&apos; + gAddressBeforeValue + &apos;&quot;   &apos;;
					comment = comment + &apos;Address after update: &quot;&apos;  + this.GetFieldValue(&quot;Cal Full Address&quot;) + &apos;&quot;&apos;;
				}					
					
				// Set up property set for Activity generation
				Inputs.SetProperty(&quot;Asset Object Id&quot;, &quot;&quot;);
				Inputs.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);
				Inputs.SetProperty(&quot;Type&quot;, &quot;Address Update&quot;);
				Inputs.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
				Inputs.SetProperty(&quot;Description&quot;, desc);
				Inputs.SetProperty(&quot;Comment&quot;, comment);
				svc = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);		
				svc.InvokeMethod(&quot;GenerateActivity&quot;, Inputs, Outputs);	
			}
		}
	}
	catch(e)
	{
		// error caught
		if(!defined(e.errText))
	        e.errText = e.toString();
	        
		sErrorMessage = e.errText;

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;CUT Address&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_WriteRecord&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.BusComp_WriteRecord&quot; + &quot;Err=&quot; + sErrorMessage);
		}

		TheApplication().RaiseErrorText(sErrorMessage);
	}
	finally
	{
		this.SetUserProperty(&quot;BypassWriteRecord&quot;, &quot;&quot;);
			
		// Release objects
       	bcParent = null;
		svc = null;
		Inputs = null;
		Outputs = null;
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		//end 18/03/2019
				
		// reset address before image fields
		gAddressBeforeValue = this.GetFieldValue(&quot;Cal Full Address&quot;);
		// gAddressAttentionTo = this.GetFieldValue(&quot;Attention to&quot;);
		gAddressStartDate   = this.GetFormattedFieldValue(&quot;Start Date&quot;);
		
		// used to avoid creating an activity audit trail for newly created record
		gNewAddressRecord = false;
	}
}"
			   SEQUENCE="3"
			   UPDATED="04/12/2019 14:15:45"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateAddressFields"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateAddressFields()
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	ValidateAddressFields
 * Component Information : 	support function
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	========================================
 * 19/12/04     ZAHIDZ		W2 Build	added validation code for address fields 
 *										based on FR.W2.600.240
 * 02/03/2005	JDM			W2 Build	Added logic to check for the existence of a parent BC before getting the &apos;Start Date&apos;
 										field value. The &apos;Start Date&apos; field is implicitly joined from S_CON_ADDR and in the 
 										context of inbound interfaces the record needs to be searched for explicitly to 
 										retrieve a value for the &apos;Start Date&apos;
 * 02/05/2008	DO			PRD7967		Updated checking of City AU and Postal Code AU fields
 * 11/06/2008	Huik		DF2499 (AVS)AU AVS will use new field Address Street Type - AU instead of
 *										Address Street Type (BAU for NZ)
 * 13/06/2008	Huik		DF2494 (AVS)AU AVS will allow empty field for street type IFF if address is valid
 * 27/05/2009	LiV			PR265		Added code to throw error if QAS search has not been triggered
 * 10/06/2009	LiV			DF4193		Fixed missing validations for Private Bag and Locked Bag
 * 17/06/2009	Madhan      NZ AVS       Added validation code for NZ address fields 
 * 19/09/2009	NG			R9.5		Modified to allow NZ Postal Code to be entered by the QAS or Zipcode picklist fields.
 */
 
  try
	{
		var sErrorMessage = &quot;&quot;;
		var sCountry, sAddrType;
		var psErrorInput, psErrorOutput, bsError;
		var vReturnVal = ContinueOperation;
		
		var boAccount;
		var bcComAccountIntersection;
		
		var sAccountId;
		var sStartDate;
		var sParentBusComp;
		
		// VL - Moved to the top for PR265
		sAddrType = this.GetFieldValue(&quot;Address Format&quot;);
		sCountry = this.GetFieldValue(&quot;Country&quot;);
		
		//Neel 27.08.2014 - Skipped for TBUI Address Validation.
		/*sActiveView1 = TheApplication().ActiveViewName(); //STE:Skipped this based on ActiveViewName
		if(sActiveView1 != &quot;VF Billing Account Detail - Address View&quot;  )
		{
			// VL - Added for PR265 to force user to search QAS at least once
			if (TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;) == &quot;N&quot; &amp;&amp;
			TheApplication().GetProfileAttr(&quot;QAS Query Validation&quot;) == &quot;Y&quot; &amp;&amp;
			sCountry == &quot;Australia&quot; &amp;&amp; (sAddrType != &quot;Overseas&quot; &amp;&amp; sAddrType != &quot;Rural&quot;))
			{
				vReturnVal = CancelOperation;
				gErrorMessage = &quot;VFErrorCode#10131&quot;;
				throw(gErrorMessage);
			}
			//VF CMA 07/07/09 - Added atleast once QAS applet has to be invoked
			if (TheApplication().GetProfileAttr(&quot;QASAppletInvoked&quot;) == &quot;N&quot; &amp;&amp;
			sCountry == &quot;New Zealand&quot; &amp;&amp; (sAddrType != &quot;Overseas&quot; &amp;&amp; sAddrType != &quot;Service&quot;))
			{
				vReturnVal = CancelOperation;
				gErrorMessage = &quot;VFErrorCode#10131&quot;;
				throw(gErrorMessage);
			}
		}*/
		
		
		if (this.ParentBusComp())	
		{
			sStartDate = this.GetFieldValue(&quot;Start Date&quot;);
		}
		else
		{			
			// If the Account Id global variable has been set by the inbound interface then explicitly
			// search the for Com Account Address Intersection record
			sAccountId = this.GetUserProperty(&quot;AccountId&quot;);
			
			if (sAccountId != &quot;&quot;)
			{
				boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
				bcComAccountIntersection = boAccount.GetBusComp(&quot;Com Account Address Intersection&quot;);
			
				with (bcComAccountIntersection)
				{
					ClearToQuery();
					ActivateField(&quot;Account Id&quot;);
					ActivateField(&quot;Address Id&quot;);
					ActivateField(&quot;Start Date&quot;);
					SetSearchSpec(&quot;Account Id&quot;, sAccountId);
					SetSearchSpec(&quot;Address Id&quot;, this.GetFieldValue(&quot;Id&quot;));
				
					ExecuteQuery(ForwardOnly);
				
					if (FirstRecord())
					{
						sStartDate = GetFieldValue(&quot;Start Date&quot;);
					} // End if (FirstRecord())
				}// End with (bcComAccountIntersection)					
			} // End if (sAccountId != &quot;&quot;)				
		} // End else
				
		if (sStartDate == &quot;&quot;)
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10090&quot;;
			throw(gErrorMessage);
		
		}
		
		switch(sAddrType.toUpperCase())
		{
			case &quot;STREET&quot;:
				 if ((this.GetFieldValue(&quot;Street Address 2&quot;) == &quot;&quot;) &amp;&amp; (sCountry != &apos;New Zealand&apos;)) // Street #;VF CMA 17/06/09 Validation whose country is other than NZ
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10091&quot;;
					throw(gErrorMessage);
				 }
				 else if ((this.GetFieldValue(&quot;Street Address&quot;) == &quot;&quot;) &amp;&amp; (sCountry != &apos;New Zealand&apos;)) // Street address;VF CMA 17/06/09 Validation whose country is other than NZ
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10092&quot;;
					throw(gErrorMessage);
				 }
				 else if ((this.GetFieldValue(&quot;Street Address 2 NZ&quot;) == &quot;&quot;) &amp;&amp; (sCountry == &apos;New Zealand&apos;)) // Street #;VF CMA 17/06/09 Validation whose country is NZ
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10091&quot;;
					throw(gErrorMessage);
				 }
				 else if ((this.GetFieldValue(&quot;Street Address NZ&quot;) == &quot;&quot;) &amp;&amp; (sCountry == &apos;New Zealand&apos;)) // Street address;VF CMA 17/06/09 Validation whose country is NZ
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10092&quot;;
					throw(gErrorMessage);
				 }
				 // VF 13/06/2008 Huik DF2494 (AVS) 
				 // AU AVS will allow empty field for street type IFF if address is valid
				 
				 // VF 11/06/2008 Huik DF2499 (AVS) &quot;Check Address Street Type - AU&quot; as well
				 //else if (this.GetFieldValue(&quot;Address Street Type&quot;) == &quot;&quot;) // Street type
				 else if ((this.GetFieldValue(&quot;Address Street Type&quot;) == &quot;&quot;) 
				 &amp;&amp; (sCountry.toUpperCase() != &quot;AUSTRALIA&quot; &amp;&amp; sCountry.toUpperCase() != &quot;NEW ZEALAND&quot;))
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10093&quot;;
					throw(gErrorMessage);
				 }
				 else if ((this.GetFieldValue(&quot;Address Street Type - AU&quot;) == &quot;&quot;) 
				 &amp;&amp; (sCountry.toUpperCase() == &quot;AUSTRALIA&quot;)
				 &amp;&amp; (this.GetFieldValue(&quot;Validation Status&quot;) != &quot;1&quot;))
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10093&quot;;
					throw(gErrorMessage);
				 }
				 break;
			case &quot;PO BOX&quot;:
			case &quot;GPO BOX&quot;:
				 if (this.GetFieldValue(&quot;POBox&quot;) == &quot;&quot;)
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10094&quot;;
					throw(gErrorMessage);
				 } 
				 break;
			
			case &quot;PRIVATE BAG&quot;:
			case &quot;LOCKED BAG&quot;:
				 if (this.GetFieldValue(&quot;Private Bag&quot;) == &quot;&quot;) // private/locked bag number
				 {
				 	vReturnVal = CancelOperation;
					gErrorMessage = &quot;VFErrorCode#10095&quot;;
					throw(gErrorMessage);
				 }
				 break;
			default: vReturnVal = ContinueOperation;
		}
		
		// VF 2494 sCountry move to front
		// check remaining fields
		// sCountry = this.GetFieldValue(&quot;Country&quot;);
		
		//VF DO PRD7967 02/05/2008 - Added if block to check City AU rather than City if the Billing Account is Australian
		if ((this.GetFieldValue(&quot;Calc Country Toggle AU Street&quot;) == &quot;AUStreet&quot; 
			|| this.GetFieldValue(&quot;Calc Country Toggle AU Post&quot;) == &quot;AUPost&quot;
			|| this.GetFieldValue(&quot;Calc Country Toggle AU GPO&quot;) == &quot;AUGPO&quot;
			|| this.GetFieldValue(&quot;Calc Country Toggle AU PrivateBag&quot;) == &quot;AUPrivateBag&quot; //4193
			|| this.GetFieldValue(&quot;Calc Country Toggle AU LockedBag&quot;) == &quot;AULockedBag&quot;) //4193
			&amp;&amp; this.GetFieldValue(&quot;City AU&quot;) == &quot;&quot; 
			&amp;&amp; sAddrType.toUpperCase() != &quot;OVERSEAS&quot;) // suburb/town
		{
		 	vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10096&quot;;
			throw(gErrorMessage);
		}
		/*else if((this.GetFieldValue(&quot;City NZ&quot;) == &quot;&quot;) 
			&amp;&amp; (sCountry == &apos;New Zealand&apos;)
			&amp;&amp; (sAddrType != &apos;Overseas&apos; &amp;&amp; sAddrType != &apos;Service&apos;))//VF CMA 17/06/09 - Added to check City NZ rather than City AU/City
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10096&quot;;
			throw(gErrorMessage);
		}*/////VF CMA 29/08/09 - Commented no longer required, Suburb/town is not mandatory for NZ
		//VF DO PRD7967 02/05/2008 - Updated condition so that City is checked if the Billing Account is not from Australia
		//VF CMA 17/06/09 - Updated condition with Country != NZ, So that City is not checked for NZ.
		else if ((this.GetFieldValue(&quot;Calc Country Toggle AU Street&quot;) != &quot;AUStreet&quot; 
			&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU Post&quot;) != &quot;AUPost&quot;
			&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU GPO&quot;) != &quot;AUGPO&quot;
			&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU PrivateBag&quot;) != &quot;AUPrivateBag&quot; //4193
			&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU LockedBag&quot;) != &quot;AULockedBag&quot;) //4193
			&amp;&amp; (this.GetFieldValue(&quot;Calc Country Toggle NZ Street&quot;) != &quot;NZStreet&quot;)
			&amp;&amp; this.GetFieldValue(&quot;City&quot;) == &quot;&quot; 
			&amp;&amp; sAddrType.toUpperCase() != &quot;OVERSEAS&quot;) // suburb/town
		{
		 	vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10096&quot;;
			throw(gErrorMessage);
		}
		else if (this.GetFieldValue(&quot;State&quot;) == &quot;&quot; &amp;&amp; sAddrType.toUpperCase() != &quot;OVERSEAS&quot; &amp;&amp; sCountry.toUpperCase() == &quot;AUSTRALIA&quot;)
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10070&quot;;
			throw(gErrorMessage);
		}
		else if (this.GetFieldValue(&quot;District&quot;) == &quot;&quot; &amp;&amp; (sAddrType.toUpperCase() == &quot;OVERSEAS&quot;)) // city
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10097&quot;;
			throw(gErrorMessage);
		}
		//VF DO PRD7967 02/05/2008 - Added if block to check Postal Code AU rather than Postal Code if the Billing Account is Australian AU
		else if ((this.GetFieldValue(&quot;Calc Country Toggle AU Street&quot;) == &quot;AUStreet&quot;
		|| this.GetFieldValue(&quot;Calc Country Toggle AU Post&quot;) == &quot;AUPost&quot;
		|| this.GetFieldValue(&quot;Calc Country Toggle AU GPO&quot;) == &quot;AUGPO&quot;
		|| this.GetFieldValue(&quot;Calc Country Toggle AU PrivateBag&quot;) == &quot;AUPrivateBag&quot; //4193
		|| this.GetFieldValue(&quot;Calc Country Toggle AU LockedBag&quot;) == &quot;AULockedBag&quot;) //4193) 
		&amp;&amp; this.GetFieldValue(&quot;Postal Code AU&quot;) == &quot;&quot; 
		&amp;&amp; sAddrType.toUpperCase() != &quot;OVERSEAS&quot;) 
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10069&quot;;
			throw(gErrorMessage);			
		}

		//VF DO PRD7967 02/05/2008 - Updated condition so that Postal Code is checked if the Billing Account is not from Australia
		//VF CMA 17/06/09 - Updated condition with Country != NZ, So that Postal Code is not checked for NZ.
		else if ((this.GetFieldValue(&quot;Calc Country Toggle AU Street&quot;) != &quot;AUStreet&quot; 
		&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU Post&quot;) != &quot;AUPost&quot;
		&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU GPO&quot;) != &quot;AUGPO&quot;
		&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU PrivateBag&quot;) != &quot;AUPrivateBag&quot; //4193
		&amp;&amp; this.GetFieldValue(&quot;Calc Country Toggle AU LockedBag&quot;) != &quot;AULockedBag&quot;) //4193)
		&amp;&amp; (this.GetFieldValue(&quot;Calc Country Toggle NZ Street&quot;) != &quot;NZStreet&quot;)
		&amp;&amp; this.GetFieldValue(&quot;Postal Code&quot;) == &quot;&quot; 
		&amp;&amp; sAddrType.toUpperCase() != &quot;OVERSEAS&quot;)
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10069&quot;;
			throw(gErrorMessage);			
		}		
		else if (this.GetFieldValue(&quot;Country&quot;) == &quot;&quot;)
		{
			vReturnVal = CancelOperation;
			gErrorMessage = &quot;VFErrorCode#10087&quot;;
			throw(gErrorMessage);
		}
	}
	catch(e)
	{
		if(gErrorMessage != &quot;&quot;)
		{
			// Error Handling
			sErrorMessage = &quot;BC CUT Address - PreSetFieldValue: &quot; + gErrorMessage;
			gErrorMessage = &quot;&quot;;
			psErrorInput  = TheApplication().NewPropertySet();
			psErrorOutput = TheApplication().NewPropertySet();
			bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
			psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;BC CUT Address&quot;);
			psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreSetFieldValue&quot;);
			psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
			bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
			sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		}
		else
		{
			if (!defined(e.errText))
			{
				e.errText = ToString(e);
			}
			sErrorMessage = e.errText;
		}
	}
	finally
	{	
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		
		boAccount = null;
		bcComAccountIntersection = null;
		
		if (sErrorMessage != &quot;&quot;)
		{
			TheApplication().RaiseErrorText(sErrorMessage);
		}
		return (vReturnVal);
	}
}"
			   SEQUENCE="8"
			   UPDATED="05/11/2016 02:21:18"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateAddressType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateAddressType(FieldName, FieldValue)
{
/*
 * Component Name        : 	CUT Address
 * Method Name           : 	ValidateAddressType
 * Component Information : 	support function
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	========================================
 * 19/12/04     ZAHIDZ		W2 Build	added validation code for address type,
 *									    address type for cutomer account must be  
 *										street or rural
 * 28/06/06		RP			Defect13854 Added Overseas to checking of the type list
 * 26/05/08		Karthik		PRD7967		Removed Overseas as primary address.
 */
    
  try
	{
		var vPrimaryFlag, vAddrType, sAddrType = &quot;&quot;;
		var sErrorMessage = &quot;&quot;;
		var psErrorInput, psErrorOutput, bsError;
		var bcParent;
		var vReturnVal = ContinueOperation;
		
		// only monitor for changes to primary and address type field
		if (FieldName == &quot;SSA Primary Field&quot; || FieldName == &quot;Address Format&quot;) 
		{	
			bcParent = this.ParentBusComp();
			// only invoke the logic for parent BC [Account]
			if (bcParent != null)
			{
				// the test for null and Name() needs to be separate
				// conditions or runtime errors can occur
				if (bcParent.Name() == &quot;Account&quot;)
				{
					if (bcParent.GetFieldValue (&quot;Account Type Code&quot;) == &quot;Customer&quot;)
					{
						// get the primary flag
						if (FieldName == &quot;SSA Primary Field&quot;)
						{
							vPrimaryFlag = FieldValue;
						}
						else
						{
							vPrimaryFlag = this.GetFieldValue(&quot;SSA Primary Field&quot;);
						}
			
						// get the address type
						if (FieldName == &quot;Address Format&quot;)
						{
							vAddrType = FieldValue;
						}
						else
						{
							// Address Format is force active
							vAddrType = this.GetFieldValue(&quot;Address Format&quot;); 
						}
						
						//Karthik - PRD 7967 - Removed Overseas from the primary address
						sAddrType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_PRI_ADDR_TYPE&quot;, vAddrType); // Balaji M A: PSMA Addrees Release: Changed to LOV
						if (vPrimaryFlag == &quot;Y&quot; &amp;&amp; sAddrType != &quot;Y&quot;)
						{
							vReturnVal = CancelOperation;
							gErrorMessage = &quot;VFErrorCode#10089&quot;;
							throw(gErrorMessage);
						}
					}
				}
				sActiveView1 = TheApplication().ActiveViewName(); //STE:Skipped this based on ActiveViewName //Priya: Added TBUI view To end date BA address Upgrade 15/5/09
				if(sActiveView1 == &quot;VF Billing Account Detail - Address View&quot; || sActiveView1 == &quot;VF Connection Wizard View - Billing Detail - TBUI&quot; || sActiveView1 ==&quot;VF Billing Details View - TBUI&quot;)  //VHA 19.3/PKE/NIRMAL/21MAY2019/Added 2nd view for PKE000000057945
				{	
				
					if(bcParent.Name() == &quot;VF Billing Account&quot; || bcParent.Name() == &quot;VF Billing Account TBUI&quot;) //VHA 19.3/PKE/NIRMAL/21MAY2019/Added 2nd BC for PKE000000057945
					{
					
						if(FieldName == &quot;SSA Primary Field&quot; &amp;&amp; FieldValue == &quot;Y&quot;)
						{


							sParentAddrId = bcParent.GetFieldValue(&quot;Primary Address Id&quot;); 
				 			sParentAccntId = bcParent.GetFieldValue(&quot;Id&quot;);
						
						}
					
					}
				}
			}
		}
	}
	catch (e)
	{
		if(gErrorMessage != &quot;&quot;)
		{
			// Error Handling
			sErrorMessage = &quot;BC CUT Address - PreSetFieldValue: &quot; + gErrorMessage;
			gErrorMessage = &quot;&quot;;
			psErrorInput  = TheApplication().NewPropertySet();
			psErrorOutput = TheApplication().NewPropertySet();
			bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
			psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;BC CUT Address&quot;);
			psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreSetFieldValue&quot;);
			psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
			bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
			sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		}
		else
		{
			if (!defined(e.errText))
			{
				e.errText = ToString(e);
			}
			sErrorMessage = e.errText;
		}
		
	}
	finally
	{
		bcParent = null;
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
		
		if (sErrorMessage != &quot;&quot;)
		{
			TheApplication().RaiseErrorText(sErrorMessage);
		}
		return (vReturnVal);
	}	
}"
			   SEQUENCE="9"
			   UPDATED="06/10/2020 16:32:39"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="getBillingAccountId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	CUT Address
 * Method Name           :	BusComp_getBillingAccountId
 * Component Information :	Account Synch needs the Billing Account Id but 
 *							the Account Id on the CUT Address record
 *							can be the Billing or the Customer Account Id.
 *							If it is the customer account it is necessary to 
 *							retrieve the Billing Account Ids.
 *							NB For Customer Account addresses there should only
 *							be one pre-paid billing account but this function
 *							assumes that there can be more if this changes.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 12/01/2005	MSL						Initial Version
 */
function getBillingAccountId(&amp;arrBillingAccountIds)
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.getBillingAccountId&quot;);
		}
		
		//************************************
		//* Declare objects / variables
		//************************************
		var boAccount = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);
		var bcAccount = boAccount.GetBusComp(&quot;VF Billing Account&quot;);
		var blnRecordExists;
		var iCount = 0;
		
		//************************************
		//* Query for billing accounts - return all Active ones found
		//************************************
		with (bcAccount)
		{
			SetViewMode(AllView);
			SetSearchSpec(&quot;Master Account Id&quot;, this.GetFieldValue(&quot;Account Id&quot;));
			//SetSearchSpec(&quot;Account Status&quot;, &quot;&lt;&gt; &apos;&quot;&quot;Open&quot;&quot;&apos;&quot;);
			SetSearchSpec(&quot;Account Status&quot;, &quot;&lt;&gt; &apos;Open&apos;&quot;);

			ExecuteQuery(ForwardOnly);
			
			blnRecordExists = FirstRecord();
			
			while(blnRecordExists)
			{
				arrBillingAccountIds[iCount] = GetFieldValue(&quot;Id&quot;);
				iCount++;
				blnRecordExists = NextRecord();
			}
		}
	}
	catch (e)
	{
		throw (e);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.getBillingAccountId&quot;);
		}
		bcAccount = null;
		boAccount = null;
	}
}"
			   SEQUENCE="4"
			   UPDATED="07/26/2014 19:21:50"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetPrimary"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="// Bharat     18/06/2014      Created New for Set Primary Button 
function mSetPrimary()
{
	try
	{
		if (this.GetFieldValue(&quot;End Date&quot;) != &quot;&quot;)
		{
			TheApplication().RaiseErrorText(&quot;The Address cannot have End date for Primary&quot;);
		}
		else
		{
			this.ActivateField(&quot;SSA Primary Field&quot;);
			this.SetFieldValue(&quot;SSA Primary Field&quot;, &quot;Y&quot;);
			this.WriteRecord();
			var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
			var psIn = TheApplication().NewPropertySet();
			var psOut = TheApplication().NewPropertySet();
			svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;,psIn,psOut);
		}
	//	return (CancelOperation);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		/*Below variables are nullified by JAGJIT on 18/03/2019*/
		//svcUI = null;
		psIn = null;
		psOut = null;
		if(defined(svcUI)) { svcUI = null; } //Balamurugan 03/10/2019 - Nullified variable
		//end 18/03/2019
	}
			
}"
			   SEQUENCE="5"
			   UPDATED="10/05/2019 02:32:12"
			   UPDATED_BY="SADMIN"
			   CREATED="07/26/2014 19:21:50"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncAccount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	CUT Address
 * Method Name           :	BusComp_SyncAccount
 * Component Information :	Call the &quot;VF Account Sync Service&quot;.
 *							All errors including BS errors will be caught and logged.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 12/01/2005	MSL						Initial Version
 */
function mSyncAccount()
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.mSyncAccount&quot;);
		}
		
		/*******************************
		* Declare Objects / Variables
		*******************************/
		var bsSyncAccount;
		var psSyncInput;
		var psSyncOutput;
		var arrBillingAccountIds = new Array;
		var iCount = 0;

		psSyncInput		= TheApplication().NewPropertySet();			
		psSyncOutput	= TheApplication().NewPropertySet();
		bsSyncAccount	= TheApplication().GetService(&quot;VF Synch Account And Subscription&quot;);

		/*******************************
		* Derive billing account id
		*******************************/
		if (this.GetFieldValue(&quot;Account Type Code&quot;) == &quot;Billing&quot;)
			arrBillingAccountIds[0] = this.GetFieldValue(&quot;Account Id&quot;);
		else if (this.GetFieldValue(&quot;Account Type Code&quot;) == &quot;Customer&quot;)
			getBillingAccountId(arrBillingAccountIds);
			
		/*******************************
		* Invoke business service
		*******************************/
		//while (arrBillingAccountIds[iCount].length &gt; 0)
		for(iCount = 0; iCount&lt;arrBillingAccountIds.length; iCount++) //VHA 19.3/PKE/NIRMAL/21MAY2019/Changed to for loop for PKE000000057945
		{
			psSyncInput.SetProperty(&quot;BillingAccountId&quot;, arrBillingAccountIds[iCount]);
			bsSyncAccount.InvokeMethod(&quot;SyncAccount&quot;, psSyncInput, psSyncOutput);
			
			if (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;).length &gt; 0)
				throw (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;));
		
			//iCount ++; //VHA 19.3/PKE/NIRMAL/21MAY2019/Commented for PKE000000057945
		}
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.mSyncAccount.strError= &quot; + strError);
		}
     	throw (strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.mSyncAccount&quot;);
		}
		
		psSyncInput = null;
		psSyncOutput = null;
		bsSyncAccount = null;
	}
}"
			   SEQUENCE="6"
