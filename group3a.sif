			<BUSCOMP_BROWSER_SCRIPT
			   BROWSER_GROUP="All"
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   NEEDS_HIGH_INTERACTIVITY="Y"
			   PROCEDURE="BusComp_PreSetFieldValue"
			   SCRIPT="function BusComp_PreSetFieldValue (fieldName, value)
{
	//added below code for Billing profile revamp CIR 17.1
	if(fieldName == &quot;Notification Method&quot; &amp;&amp; value == &quot;None&quot;){
		if(confirm(&quot;The notification method has been selected as &apos;None&apos;. If the customer wishes to receive important billing related communications, please change this value to TXT, Email or Both&quot;))
			return(&quot;ContinueOperation&quot;);
		else
			return(&quot;CancelOperation&quot;);
	}
	return (&quot;ContinueOperation&quot;);
}"
			   UPDATED="04/03/2017 18:34:21"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:26"
			   CREATED_BY="SADMIN">
			</BUSCOMP_BROWSER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="(declarations)"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="var gBillMedia;
var gPresentment;
var gSuspendPayment;
var gMandatoryPayment;
//TAlihos 21/02/2005 Added to drive Referesh Screen function
var gOldPaymentMethod;
var gNewPaymentMethod;
// MSL 25/01/07 - Defect #23199 Set gPaymentMethodChanged to false
// by default otherwise the screen is always refreshed
var gPaymentMethodChanged = false;

// Benita 27/03/07 - Defect #24722 Added to trigger page refresh when the Payment Type changes
var gOldPaymentType;
var gNewPaymentType;
var gPaymentTypeChanged = false;

//REB - 23/11/07 - set up booleans = flase for triggers to NP BA propogation for Defect # 6506.
var bAccountingTypeChng = false;
var bBillFormatChng = false;

var gOldAccountingType = &quot;&quot;;
var gNewAccountingType = &quot;&quot;;

//REB - New Global declarations for Defect # 6506
var gNewMediaType = &quot;&quot;;
var gOldMediaType = &quot;&quot;;
var gNewBillFormat = &quot;&quot;;
var gOldBillFormat = &quot;&quot;;
//baranwas- Global declaration for EBP
//var gEmailOptIn = &quot;Y&quot;; //08-Feb-2014-santoshb-commented this line and wrote below line QC263
var gEmailOptIn = &quot;&quot;;
var gBillChargesOverrideReason = &quot;&quot; ; //08-Feb-2014-santoshb- QC263
var gEmailBillTo = &quot;&quot;;
var gEmailBillToLastUpdated = &quot;&quot;;
var gCurrentTimeStamp = &quot;&quot;;
//Huik - EBP DF2702
var gSuppressPaper = &quot;&quot;;


//*************************************
//* Used for Error Handling
//*************************************
var gErrorMessage;
// VF 02/05/06 JSK
var bSuspendPayment = false;
var	bBillMedia = false;
var	bPresentment = false;
var	bMandatoryPayment = false;

//VF Josel-Added for SR NZ000446.
var sNewValue;
var sPrevValue;
var sDebitPrevValue;
var sDebitNewValue;
var sCreditPrevValue;
var sCreditNewValue;
var sOldDeliveryMethod;

//Roseline - 09/08/2014 - Moved the comments from PreWriteRecord Event to here.
/*
 * Component Name        : Com Invoice Profile
 * Method Name           : BusComp_PreWriteRecord
 * Component Information : 
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 04/04/2005	JSK					Call mValidateBSB for NZ Direct Debit Validation
 * 15/04/2005   Benita				Add Credit Card Validation for New Zealand
 * 11/07/2005	Terry P				Defect 2944: Top level billing account can not be &apos;Non Paying&apos;
 * 02/05/2006	JSK		DF13288		Added CreatePresentmentActivity();		
 * 18/05/2006 	JSK 	DF14046		Added Validation for Suspend Date 
 *									Suspend Date &gt;= Today() AND &lt; Today() + 31
 * 									(Siebel validation date format is US format.)
 * 27/06/06		RP		Defect15054	Prevent write record if update to Accounting Type is made when
 *									the Billing Account is Overdue.
 * 05/07/06		RP		Defect15482	Update Suppress Mail depending on whether Notification method is
 *									selected
 * 04/12/2006 	CY 		Defect22118	Fixed the Date validation using getTime() for Suspend End Date comparison.
 * 
 * 15/12/2006	RP		Defect21774	Added check if Payment Method is not Prepay, then check for non 
 *									prepay Bill Segment on Customer Account
 * 27/12/2007   HUIK	Defect 6522 Added code to prevent partner portal to create duplicate billing profile
 * 06/03/2008	VLI		DF7455		Commented out codes from DF6506
 * 20/03/08		podec	Defect 7545  Added code to propulate credit card type based on CC number.
 * 03/07/08		HUIK	DF2678 EBP	Notification Method can&apos;t be blank if ARII is AU
 * 13/08/08		HUIK	PIE158 EBP	Avoid EBP validation check for Prepay Connection
 * 18/08/08		HUIK	DF8769 EBP	Partner Poral NZ can create paper bill	
 * 16/10/08     SAHUS   PCR4   EBP	Changes for PCR4 to make Paper bill charges Override mandatory
 * 24/10/2008   Baranwas			Added code for Dishonour fee interface
 * 27/10/08		HUIK	DF8989 EBP 	Default Paper bill reason code for corporate account
 * 14/10/09		SLV					Bulk Update Bill Profile - allow them to change the validity status
 *									field (do not automatically set to Not Validated every time
 *									the email bill to field is changed.
 * 25/01/10		NG		DF8828		Bypass CC expiration validation
 * 11/05/10     DFiggis R10.3 CA    Added validatino for payment method for VHA CA approval project.
 * 14/04/2011   VikasK  R11.1 SR    Bypass mandatory payment method validation for existing migrated account
 * 26/06/2011   Sailaja SE11C		mUpdateNotificationMSISDN
 *									Update MSISDN For TXT to Dummy MSISDN if the field is blank and no active assets
 *									Throw error if active assets
 * 21/11/2012	VIVIND	TD16245		Put in validation for the Credit Card Expiry year as NaN, 4 Digits and not less than the current year
 *									For the UI only
 * 19/12/2012   SIBIC	TD16245	    Added changes to the Credit Card Expiry year validation to consider the first four digits from online 
 * 									transaction as a valid year
 * 28/03/2013	VISHALS	QC 1164     Extra validation to have been placed to check whether Parent BusComp =&quot;VF Billing Account&quot; or not
 * 05/08/2013	AS		WOW CIR		Removed rule to enable paper bill through Partner Portal
 *									
 */"
