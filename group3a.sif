			   COMMENTS="IIf ([Base Price = &quot;0&quot;, &quot;&quot;, [Base Price] - [Base Price] + IfNull (([Base Price] - [Unit Price]) / [Base Price] * 100.0, IfNull ([Discount Percent], IfNull ([Discount Amount] / [Base Price] * 100.0, [Discount]))))"
