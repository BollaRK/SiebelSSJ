			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mQueryUpdateShipmentAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mQueryUpdateShipmentAddress(sAddrId)
{
	//We have updated the Ship to Addr Id, now query the values and update the FS Shipment BC
	//Neel 08.10.2014
	try
	{

		
		var sShipmentId = this.GetFieldValue(&quot;Id&quot;);
		this.WriteRecord();
		
		TheApplication().Trace(&quot;sShipmentId::&quot;+sShipmentId);
		var sShipmentAddrBO = TheApplication().GetBusObject(&quot;VF Generic TBUI BO&quot;);
		var sShipmentAddrBC = sShipmentAddrBO.GetBusComp(&quot;VF Shipment Address&quot;); 
		TheApplication().Trace(sShipmentAddrBO);
		TheApplication().Trace(sShipmentAddrBC);
		sShipmentAddrBC.ClearToQuery();
		sShipmentAddrBC.SetViewMode(AllView);
		sShipmentAddrBC.SetSearchSpec(&quot;Id&quot;, sAddrId);
		sShipmentAddrBC.ExecuteQuery();
		if(sShipmentAddrBC.FirstRecord())
		{
			var sAddrFormat = sShipmentAddrBC.GetFieldValue(&quot;Address Format&quot;);
			var sAddrFloorType = sShipmentAddrBC.GetFieldValue(&quot;Address Floor Type&quot;);
			var sAddrFloor = sShipmentAddrBC.GetFieldValue(&quot;Address Floor&quot;);
			var sAddrBulding = sShipmentAddrBC.GetFieldValue(&quot;Address Building&quot;);
			var sAddrStreet2 = sShipmentAddrBC.GetFieldValue(&quot;Street Address 2&quot;);
			var sAddrStreetType = sShipmentAddrBC.GetFieldValue(&quot;Address Street Type&quot;);
			var sAddrStreet = sShipmentAddrBC.GetFieldValue(&quot;Street Address&quot;);
			var sAddrCity = sShipmentAddrBC.GetFieldValue(&quot;City AU&quot;);
			var sAddrState = sShipmentAddrBC.GetFieldValue(&quot;State&quot;);
			var sAddrPostal = sShipmentAddrBC.GetFieldValue(&quot;Postal Code AU&quot;);
			var sAddrCountry = sShipmentAddrBC.GetFieldValue(&quot;Country&quot;);
			var sAddrPrivateBag = sShipmentAddrBC.GetFieldValue(&quot;Private Bag&quot;);
			var sAddrRuralDel = sShipmentAddrBC.GetFieldValue(&quot;Rural Delivery&quot;);
			var sAddrPrivateBagName = sShipmentAddrBC.GetFieldValue(&quot;Private Bag Name&quot;);
			//sShipmentAddrBC.GetFieldValue(&quot;DPID&quot;);
			//sShipmentAddrBC.GetFieldValue(&quot;Validation Status&quot;);
		}
		sShipmentAddrBC = null;
		sShipmentAddrBO = null;
		
		
		TheApplication().Trace(&quot;sAddrFormat::&quot;+sAddrFormat);
		TheApplication().Trace(&quot;sAddrFloorType::&quot;+sAddrFloorType);
		TheApplication().Trace(&quot;sAddrFloor::&quot;+sAddrFloor);
		TheApplication().Trace(&quot;sAddrBulding::&quot;+sAddrBulding);
		TheApplication().Trace(&quot;sAddrStreet2::&quot;+sAddrStreet2);
		TheApplication().Trace(&quot;sAddrStreetType::&quot;+sAddrStreetType);
		TheApplication().Trace(&quot;sAddrStreet::&quot;+sAddrStreet);
		TheApplication().Trace(&quot;sAddrCity::&quot;+sAddrCity);
		TheApplication().Trace(&quot;sAddrState::&quot;+sAddrState);
		TheApplication().Trace(&quot;sAddrPostal::&quot;+sAddrPostal);
		TheApplication().Trace(&quot;sAddrCountry::&quot;+sAddrCountry);
		TheApplication().Trace(&quot;sAddrPrivateBag::&quot;+sAddrPrivateBag);
		TheApplication().Trace(&quot;sAddrRuralDel::&quot;+sAddrRuralDel);
		TheApplication().Trace(&quot;sAddrPrivateBagName::&quot;+sAddrPrivateBagName);
		
		TheApplication().Trace(&quot;Shipment Address Fetched&quot;);
		
		
		//Update FS shipment Record
		var sShipmentBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sShipmentBC = sShipmentBO.GetBusComp(&quot;VF FS Shipment TBUI&quot;);
		
		TheApplication().Trace(sShipmentBO);
		TheApplication().Trace(sShipmentBC);
		
		sShipmentBC.ClearToQuery();
		sShipmentBC.SetViewMode(AllView);
		sShipmentBC.ActivateField(&quot;VF Address Format&quot;);
		sShipmentBC.ActivateField(&quot;VF Address Floor Type&quot;);
		sShipmentBC.ActivateField(&quot;VF Address Floor&quot;);
		sShipmentBC.ActivateField(&quot;VF Address Building&quot;);
		sShipmentBC.ActivateField(&quot;VF Address Street Type&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment Street #&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment Street Address&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment City&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment State&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment Zipcode&quot;);
		sShipmentBC.ActivateField(&quot;VF Shipment Country&quot;);
		sShipmentBC.ActivateField(&quot;VF Private Bag&quot;);
		sShipmentBC.ActivateField(&quot;VF Private Bag Name&quot;);
		sShipmentBC.ActivateField(&quot;VF Rural Delivery&quot;);
		sShipmentBC.SetSearchSpec(&quot;Id&quot;,sShipmentId);
		sShipmentBC.ExecuteQuery();
		var x = sShipmentBC.CountRecords();
		TheApplication().Trace(&quot;ShipmentRecord::&quot;+x);
		if(sShipmentBC.FirstRecord())
		{
			TheApplication().Trace(&quot;Trying to Update Shipment Record....&quot;);
			sShipmentBC.SetFieldValue(&quot;VF Address Format&quot;, sAddrFormat);
			sShipmentBC.SetFieldValue(&quot;VF Address Floor Type&quot;, sAddrFloorType);
			sShipmentBC.SetFieldValue(&quot;VF Address Floor&quot;, sAddrFloor);
			sShipmentBC.SetFieldValue(&quot;VF Address Building&quot;, sAddrBulding);
			sShipmentBC.SetFieldValue(&quot;VF Address Street Type&quot;, sAddrStreetType);
			sShipmentBC.SetFieldValue(&quot;VF Shipment Street #&quot;, sAddrStreet2);
			sShipmentBC.SetFieldValue(&quot;VF Shipment Street Address&quot;, sAddrStreet);
			sShipmentBC.SetFieldValue(&quot;VF Shipment City&quot;, sAddrCity);
			sShipmentBC.SetFieldValue(&quot;VF Shipment State&quot;, sAddrState);
			sShipmentBC.SetFieldValue(&quot;VF Shipment Zipcode&quot;, sAddrPostal);
			sShipmentBC.SetFieldValue(&quot;VF Shipment Country&quot;, sAddrCountry);
			sShipmentBC.SetFieldValue(&quot;VF Private Bag&quot;, sAddrPrivateBag);
			sShipmentBC.SetFieldValue(&quot;VF Private Bag Name&quot;, sAddrPrivateBagName);
			sShipmentBC.SetFieldValue(&quot;VF Rural Delivery&quot;, sAddrRuralDel);
//			this.SetFieldValue(&quot;DPID&quot;, sShipmentBC.GetFieldValue(&quot;DPID&quot;));
//			this.SetFieldValue(&quot;Validation Status&quot;, sShipmentBC.GetFieldValue(&quot;Validation Status&quot;));
//			this.SetFieldValue(&quot;Freeform address line 1&quot;, sShipmentBC.GetFieldValuey(&quot;Freeform address line 1&quot;));
//			this.SetFieldValue(&quot;Freeform address line 2&quot;, sShipmentBC.GetFieldValue(&quot;Freeform address line 2&quot;));
			sShipmentBC.WriteRecord();
			TheApplication().Trace(&quot;Shipment Record Committed....&quot;);
		}
		sShipmentBC=null;
		sShipmentBO=null;
	
		return(CancelOperation);

	}
	catch(e)
	{
		throw(e);
	}
	finally
	{

	}
}"
