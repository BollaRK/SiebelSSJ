			   MULTI_VALUED="N"
			   NAME="LOY Points Total"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   TYPE="DTYPE_NUMBER"
			   USE_DEFAULT_SENSITIVITY="Y"
			   UPDATED="06/10/2014 00:41:16"
