			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : mCreateActivity
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 29/06/2008	josel				Create an activity certain field values are updated. 
 *									
 */

function mCreateActivity(sActivityCommentsFld,sDesc,sPaymentType,sStatus)
{
	try
	{
	
	// Trace statement
			if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
			{ 
				TheApplication().Trace(&quot;START:Com Invoice Profile.mCreateActivity():&quot;); 
			}
		
	
	
		    var inputActivity;
			var outputActivity;
			var AutoActivity;
			var sAccountId;
			var bsError;
			
		
	            sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
	            inputActivity = TheApplication().NewPropertySet();
				outputActivity = TheApplication().NewPropertySet();
				//Arpita removed calling BS and called generic WF for Activity creation fi IP18 - 23-04-2019
				
				AutoActivity = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			
				//Sets the activity comments variable
				
				
				with (inputActivity)
		    	{
	    			SetProperty(&quot;ProcessName&quot;, &quot;VF Generate Activity General&quot;);
					SetProperty(&quot;Type&quot;, sPaymentType);
	    			SetProperty(&quot;Description&quot;, sDesc);
	    			SetProperty(&quot;Account Object Id&quot;, sAccountId);
		    		SetProperty(&quot;Status&quot;,sStatus);
	    			SetProperty(&quot;Comment&quot;, sActivityCommentsFld);
	    			SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);
				}	  	
			  
				  	AutoActivity.InvokeMethod(&quot;RunProcess&quot;, inputActivity, outputActivity);		
			}
				
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
	   	// Trace
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.mCreateActivity.Error:&quot; + strError );
		}
		throw( strError );
	}
		finally
		{
		
		    AutoActivity		= null;
			inputActivity 		= null;
			outputActivity 		= null;
			
			
			
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
			{
				TheApplication().Trace(&quot;END: Com Invoice Profile.mCreateActivity()&quot;);
			}
	
		}
}"
