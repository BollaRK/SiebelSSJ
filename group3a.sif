		   NAME="VFDfa Order Entry Order Thin BC"
		   NO_DELETE="N"
		   NO_INSERT="N"
		   NO_MERGE="Y"
		   NO_UPDATE="N"
		   OWNER_DELETE="N"
		   POPUP_VISIBILITY_AUTO_ALL="Y"
		   POPUP_VISIBILITY_TYPE="Organization"
		   SCRIPTED="Y"
		   TABLE="S_ORDER"
		   TYPE="Non-Transient"
		   UPDATED="01/09/2026 16:02:04"
		   UPDATED_BY="SADMIN"
		   CREATED="01/09/2026 16:02:04"
		   CREATED_BY="SADMIN">
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="(declarations)"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*function BusComp_SetFieldValue (FieldName)
{
/*******************************************************************
/* Date: 		2/12/04
/* Author: 		Sarah Vale
/* Description: Added case for &apos;Future Submit Date&apos;
/*-----------------------------------------------------------------
/*	Date		Upd By					Description
/*	11/02/2005	TAlihos					Added case statement to set global 
/* 										Sales person changed flag to &quot;TRUE&quot; 
/*	10/08/2005	TAlihos					W2 defect 5562. Removed the VF Suspend End Date case
/*										statement.This case statement called the mSuspendDate()which 
/* 										incorrectly set the ReqShipDate to eqaul the value
/*										in the VF Suspend End Date. Also removed the method that this
/* 										case statement called.	
/*	17/05/2007	CY		DF26819			Remove condition on Order status.
/*	07/06/2009	Santosh	DF#11032		Added case for Requested Ship Date field 
/*  22/09/09	AGoenka					Added call to UpdateShippingStatus() when Order Status is set to Submitted 
/*  16/09/2009  Raja    DF#11480        Commented the if condition checking for &quot;Modify&quot; orders.
/*	3/11/2010	SLV		R10.5			When status is updated call new function to
/*										set various fields in siebel - used in failed order reporting
/*  25/07/2011  XA		R11.C			Added code to refresg when Bypass Reason Set after the Submit Order Validation	
/*	21/03/2012	SV		WBI Replacement	Added Code for new order status &apos;Provisioning Error&apos; introduced as part of WBI Replacement project.
/*  05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
/*******************************************************************/

/*
	var psErrorInput;
	var psErrorOutput;
	var sErrorMessage;
	var bsError;   
	var sOrderStatusSub = &quot;Submitted&quot;;
	var sOrderStatusCom = &quot;Complete&quot;;

	try
	{
		this.ActivateField(&quot;Status&quot;); // Added for DF#11032
		var sOrderStatus = this.GetFieldValue(&quot;Status&quot;); // Added for DF#11032
		this.ActivateField(&quot;Future Submit Date&quot;); // Added for DF#11033
		var sFutureDate = this.GetFieldValue(&quot;Future Submit Date&quot;); // Added for DF#11033		
		var sOrderType = this.GetFieldValue(&quot;Order Sub Type&quot;);
		var sSalesPerson = this.GetFieldValue(&quot;VF Sales Person&quot;);
		var sTravellerLogin = TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_TRAVELLER_PARAMS&quot;,&quot;Interface Login&quot;);
		
		switch (FieldName)
		{
			//VF Wave 2 - 2/12/04 - Sarah Vale
			//Added for FR700.130 to set the Requested Ship
			//Date field when the user sets the Future Submit
			//Date
			case &quot;Future Submit Date&quot;:
				gNewFutSubmitDate = this.GetFieldValue(&quot;Future Submit Date&quot;); //11032
				mSetReqShipDate();		
			break;
			//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
			case &quot;VHA Override MSISDN&quot;:
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdOvrdMSISDN = &quot;Y&quot;;				
			break;
			case &quot;VHA Override SMS&quot;:
				//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdOvrdSMS = &quot;Y&quot;;
				
				if(TheApplication().ActiveViewName() == &quot;VF Order Entry - Line Items XA View&quot;)
				{
					this.WriteRecord();
				}
			break;
				
			//VF 11/2/05 - Added case for W2.FR 600.050  - Automatic Activities
			//Need to set gVFSalesPersonChgdFlg = &quot;TRUE&quot; to whatever this field is set 
			case &quot;VF Sales Person&quot;:
				// Defect 26819 - remove condition on Order Status
				gVFSalesPersonChgdFlg = true;
				//Findout what what the status of the Order is
				//if(sOrderStatusSub == this.GetFieldValue(&quot;Status&quot;) || sOrderStatusCom == this.GetFieldValue(&quot;Status&quot;) )
				//{
					//Set global Sales person changed flag to &quot;FALSE&quot; 
				//	gVFSalesPersonChgdFlg = true;
				//}
				//else
				//{
					//Set global Sales person changed flag to &quot;TRUE&quot; 
				//	gVFSalesPersonChgdFlg = false;

				//}
							
			break;
		
			case &quot;Status&quot;:
			
			  		switch(this.GetFieldValue(&quot;Status&quot;))
			  		{
			  			case &quot;Complete&quot;:
			  				//If is VF Traveller interface requested
			  				if((sOrderType == &quot;Modify&quot;) &amp;&amp; (sSalesPerson == sTravellerLogin))
			  					this.SetUserProperty(&quot;VFTravellerCompleted&quot;,&quot;Y&quot;);
			  				break;
				  		case &quot;Failed&quot;:
			  			case &quot;Internal Error&quot;:
			  			case &quot;Provisioning Error&quot;:	//SV, 21Mar2012, Added for WBI Replacement Project.	  			
			  				if((sOrderType == &quot;Modify&quot;) &amp;&amp; (sSalesPerson == sTravellerLogin))
			  					this.SetUserProperty(&quot;VFTravellerFailed&quot;,&quot;Y&quot;);
			  				break;
			  			case &quot;Port In Failed&quot;:
			  				decrementFailedPortIMEI();
			  				break;
			  				
			  				//Added for IMEI Phase 2
			  			case &quot;Submitted&quot;:
//AG added for updating Shipping record status if there are any new shipping records 
							UpdateShippingStatus();																	
//			  			
			  				if(sOrderType == &quot;Connect&quot;)
			  				mGetHSMVersionID();
			  				break;		  			
			  				
			  		}	
			  		
			  		//SLV 3/11/10 - Release 10.5
			  		//Set various datetime fields used in failed order reporting
			  		SetOrderDateTimeMetrics(this.GetFieldValue(&quot;Status&quot;), TheApplication().GetProfileAttr(&quot;OldStatusValue&quot;));
			  		TheApplication().SetProfileAttr(&quot;OldStatusValue&quot;, &quot;&quot;);
			  				  	
				break;
				
					
				
				//11032 start
				
			case &quot;Requested Ship Date&quot;:
					gNewReqShipDate = this.GetFieldValue(&quot;Requested Ship Date&quot;);
					// The below line is commented as part of defect 11480. The code should work for all type of Orders.
				    //if(sOrderType == &quot;Modify&quot;)
						mSetFutureShipDate();
					
			break;	
				//11032 end				
			
			//XA: R11.C - Paperless: Explicitly write &amp; refresh once the paperless bypass reason is selected after the Submit validation Failure.	
			case &quot;VF Digital Contract Bypass Reason&quot;:
				if(TheApplication().GetProfileAttr(&quot;profAttrContractCheckFailed&quot;) == &quot;Y&quot;)
				{
					var sByPass = this.GetFieldValue(&quot;VF Digital Contract Bypass Reason&quot;);
					//Refresh the current Record
					this.InvokeMethod(&quot;RefreshRecord&quot;);
					this.SetFieldValue(&quot;VF Digital Contract Bypass Reason&quot;, sByPass);
					TheApplication().SetProfileAttr(&quot;profAttrContractCheckFailed&quot;, &quot;N&quot;);				
				}
				//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdByPassReason = &quot;Y&quot;;
			break;	
			
				
		}


	}
	catch(e)
	{
	
		//Error Caught
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Account. SetFieldValue.FieldName=&quot; + FieldName);
		}       
		
		if (defined(e.errText))
		{
			sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			sErrorMessage = e.toString(); 
		}

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Orders&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_SetFieldValue&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(sErrorMessage);
     }
     finally
     {
      	bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
		sErrorMessage = null;    
     }
}*/"
			   SEQUENCE="1"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/22/2026 00:03:56"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*******************************************************************
 * Component Name        : 	Order Entry - Orders
 * Method Name           : 	BusComp_PreSetFieldValue
 * Component Information : 	
/*-----------------------------------------------------------------
/*	Date			Upd By					Description
/*	14/02/2005		TAlihos					Initital version.
/*
/*	12/10/2005		TAlihos	W2 Defect 6999	Added logic to check if New Billing Account Id is equal to 
/*											Old Billing Account Id. If it is then an error will be thrown.									
/*	13/06/2009		santosh		DF#11032	Set the global variables for Future Date and requeste date.
/*	28/05/2010      RANIM                        Added for MPP eligibility check
/*	3/11/2010		SLV		R10.5			When status is updated call new function to
/*											set various fields in siebel - used in failed order reporting	
/*											This is done from presetfieldvalue as for this case we need to know
/*											the old value
/*  27/11/2013		SS		R14.1			Added conditions for new field for Caring
/*******************************************************************/

function BusComp_PreSetFieldValue (FieldName, FieldValue)
{ 
	var psErrorInput;
	var psErrorOutput;
	var sErrorMessage;
	var bsError;   
	var bsOrderToolkit;
	var psInputs, psOutputs;  
	
	try
	{
		//Assign to get the current user&apos;s Sales Channel and  
		//Branch information. 
		switch (FieldName)
		{
			case &quot;VF Sales Person&quot;:
					//Set global Sales person variables
					gOldVFSalesPerson = this.GetFieldValue(&quot;VF Sales Person&quot;);
					gOldVFSalesChannelBranch = this.GetFieldValue(&quot;VF Sales Channel-Branch Calc&quot;);
			
			break;
			
			//VF 12/10/05 - Added case for W2 defect 6999
			case &quot;New Billing Account Id&quot;:
			
				
			
				if(FieldValue == this.GetFieldValue(&quot;Billing Account Id&quot;) )
				{
					
					//If it is then lets let the user know this really isn&apos; good.
					//and they are required to select a new BA top transfer to.
				
					throw(&quot;VFErrorCode#10340&quot;)
				}
										
			break;

					
			//start 11032
			case &quot;Requested Ship Date&quot;:
			
					gOldReqShipDate = this.GetFieldValue(&quot;Requested Ship Date&quot;);
					
			break;
			
			case &quot;Future Submit Date&quot;:
			
					gOldFutSubmitDate = this.GetFieldValue(&quot;Future Submit Date&quot;);
					//Indivar Added for PKE000000123976 - 17/07/2025
					this.ActivateField(&quot;Future Submit Date CL&quot;);
					var Fut = this.GetFieldValue(&quot;Future Submit Date CL&quot;);
					var sBtn = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;COL_FUTURE_DATE&quot;,&quot;COL&quot;);
					if (Fut == &quot;Y&quot; &amp;&amp; sBtn == &quot;ON&quot;)
					{
						throw(&quot;VFErrorCode#30005&quot;);
					}
			break;
					
			// RANIM:28/May/10:Added for MPP eligibility check
          	case &quot;VF CC Payment Accepted&quot; :	
          			var strIsCCPaymentValid = 	IsCCPaymentValid(this.GetFieldValue(&quot;Id&quot;));			
					if ( strIsCCPaymentValid != &quot;Y&quot;)
					{ throw(&quot;VFErrorCode#30004&quot;);
					}
					
					
			break; //end 11032		
			
			//SLV Release 10.5 - set order date time fields used in failed order reporting
			case &quot;Status&quot;:
				if (FieldValue == &quot;Submitted&quot;)
				{
					TheApplication().SetProfileAttr(&quot;OldStatusValue&quot;, this.GetFieldValue(&quot;Status&quot;));
				}
			break;
			//Sangeethas 27/11/2013 added below case for Caring R14.1
/*			case &quot;VF Parent Order Num&quot;:
				if(FieldValue != null &amp;&amp; FieldValue != &quot;&quot;)
				{
				    bsOrderToolkit = TheApplication().GetService(&quot;VF OM Order Toolkit Service&quot;);
				    psInputs = TheApplication().NewPropertySet();
				    psOutputs = TheApplication().NewPropertySet();
				    psInputs.SetProperty(&quot;OrderNumber&quot;, FieldValue);
				    bsOrderToolkit.InvokeMethod(&quot;GetSharingIndicator&quot;, psInputs, psOutputs);
				    
				    if (psOutputs.GetProperty(&quot;SharingIndicator&quot;) != &quot;Parent Connection&quot;)
				    {
				    	UndoRecord();
				    	throw(&quot;VFErrorCode#20141&quot;);
				    }
				  }
			break;*/
			//end of changes by SS 27/11/2013 for caring	
			// VF TP 13/08/2014 Commented as part of mso rel2 changes	
			case &quot;VF Parent Service Order Id&quot;:
				if(FieldValue != null &amp;&amp; FieldValue != &quot;&quot;)
				{
				    bsOrderToolkit = TheApplication().GetService(&quot;VF OM Order Toolkit Service&quot;);
				    psInputs = TheApplication().NewPropertySet();
				    psOutputs = TheApplication().NewPropertySet();
				    psInputs.SetProperty(&quot;ServiceOrderId&quot;, FieldValue);
				    bsOrderToolkit.InvokeMethod(&quot;GetSharingIndicator&quot;, psInputs, psOutputs);
				    
				    if (psOutputs.GetProperty(&quot;SharingIndicator&quot;) != &quot;Parent Connection&quot;)
				    {
				    	UndoRecord();
				    	throw(&quot;VFErrorCode#20141&quot;);
				    }
				  }
			break; 
		}
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			sErrorMessage = e.toString();
		}
		else
		{
	    	sErrorMessage = e.errText;
	    }
	    
	    
	    psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Orders&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_SetFieldValue&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(sErrorMessage);   
	   	
     }
     finally
     {
     	psErrorInput 	= null; 
		psErrorOutput	= null; 
 		bsError			= null;    
		sErrorMessage 	= null; 
		/*Below variables are nullified by JAGJIT on 18/03/2019*/ 
		bsOrderToolkit 	= null;  
		psInputs 	= null;  
		psOutputs 	= null;  

     }
}"
			   SEQUENCE="8"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:41"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
/*******************************************************************
/* Date: 		2/12/04
/* Author: 		Sarah Vale
/* Description: Added case for &apos;Future Submit Date&apos;
/*-----------------------------------------------------------------
/*	Date		Upd By					Description
/*	11/02/2005	TAlihos					Added case statement to set global 
/* 										Sales person changed flag to &quot;TRUE&quot; 
/*	10/08/2005	TAlihos					W2 defect 5562. Removed the VF Suspend End Date case
/*										statement.This case statement called the mSuspendDate()which 
/* 										incorrectly set the ReqShipDate to eqaul the value
/*										in the VF Suspend End Date. Also removed the method that this
/* 										case statement called.	
/*	17/05/2007	CY		DF26819			Remove condition on Order status.
/*	07/06/2009	Santosh	DF#11032		Added case for Requested Ship Date field 
/*  22/09/09	AGoenka					Added call to UpdateShippingStatus() when Order Status is set to Submitted 
/*  16/09/2009  Raja    DF#11480        Commented the if condition checking for &quot;Modify&quot; orders.
/*	3/11/2010	SLV		R10.5			When status is updated call new function to
/*										set various fields in siebel - used in failed order reporting
/*  25/07/2011  XA		R11.C			Added code to refresg when Bypass Reason Set after the Submit Order Validation	
/*	21/03/2012	SV		WBI Replacement	Added Code for new order status &apos;Provisioning Error&apos; introduced as part of WBI Replacement project.
/*  05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
/*******************************************************************/

	var psErrorInput;
	var psErrorOutput;
	var sErrorMessage;
	var bsError;   
	var sOrderStatusSub = &quot;Submitted&quot;;
	var sOrderStatusCom = &quot;Complete&quot;;

	try
	{
		this.ActivateField(&quot;Status&quot;); // Added for DF#11032
		var sOrderStatus = this.GetFieldValue(&quot;Status&quot;); // Added for DF#11032
		this.ActivateField(&quot;Future Submit Date&quot;); // Added for DF#11033
		var sFutureDate = this.GetFieldValue(&quot;Future Submit Date&quot;); // Added for DF#11033		
		var sOrderType = this.GetFieldValue(&quot;Order Sub Type&quot;);
		var sSalesPerson = this.GetFieldValue(&quot;VF Sales Person&quot;);
		var sTravellerLogin = TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_TRAVELLER_PARAMS&quot;,&quot;Interface Login&quot;);
		
		switch (FieldName)
		{
			//VF Wave 2 - 2/12/04 - Sarah Vale
			//Added for FR700.130 to set the Requested Ship
			//Date field when the user sets the Future Submit
			//Date
			case &quot;Future Submit Date&quot;:
				gNewFutSubmitDate = this.GetFieldValue(&quot;Future Submit Date&quot;); //11032
				mSetReqShipDate();		
			break;
			//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
			case &quot;VHA Override MSISDN&quot;:
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdOvrdMSISDN = &quot;Y&quot;;				
			break;
			case &quot;VHA Override SMS&quot;:
				//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdOvrdSMS = &quot;Y&quot;;
				
				if(TheApplication().ActiveViewName() == &quot;VF Order Entry - Line Items XA View&quot;)
				{
					this.WriteRecord();
				}
			break;
				
			//VF 11/2/05 - Added case for W2.FR 600.050  - Automatic Activities
			//Need to set gVFSalesPersonChgdFlg = &quot;TRUE&quot; to whatever this field is set 
			case &quot;VF Sales Person&quot;:
				// Defect 26819 - remove condition on Order Status
				gVFSalesPersonChgdFlg = true;
				//Findout what what the status of the Order is
				//if(sOrderStatusSub == this.GetFieldValue(&quot;Status&quot;) || sOrderStatusCom == this.GetFieldValue(&quot;Status&quot;) )
				//{
					//Set global Sales person changed flag to &quot;FALSE&quot; 
				//	gVFSalesPersonChgdFlg = true;
				//}
				//else
				//{
					//Set global Sales person changed flag to &quot;TRUE&quot; 
				//	gVFSalesPersonChgdFlg = false;

				//}
							
			break;
		
			case &quot;Status&quot;:
			
			  		switch(this.GetFieldValue(&quot;Status&quot;))
			  		{
			  			case &quot;Complete&quot;:
			  				//If is VF Traveller interface requested
			  				if((sOrderType == &quot;Modify&quot;) &amp;&amp; (sSalesPerson == sTravellerLogin))
			  					this.SetUserProperty(&quot;VFTravellerCompleted&quot;,&quot;Y&quot;);
			  				break;
				  		case &quot;Failed&quot;:
			  			case &quot;Internal Error&quot;:
			  			case &quot;Provisioning Error&quot;:	//SV, 21Mar2012, Added for WBI Replacement Project.	  			
			  				if((sOrderType == &quot;Modify&quot;) &amp;&amp; (sSalesPerson == sTravellerLogin))
			  					this.SetUserProperty(&quot;VFTravellerFailed&quot;,&quot;Y&quot;);
			  				break;
			  			case &quot;Port In Failed&quot;:
			  				decrementFailedPortIMEI();
			  				break;
			  				
			  				//Added for IMEI Phase 2
			  			case &quot;Submitted&quot;:
//AG added for updating Shipping record status if there are any new shipping records 
							UpdateShippingStatus();																	
//			  			
			  				if(sOrderType == &quot;Connect&quot;)
			  				mGetHSMVersionID();
			  				break;		  			
			  				
			  		}	
			  		
			  		//SLV 3/11/10 - Release 10.5
			  		//Set various datetime fields used in failed order reporting
			  		SetOrderDateTimeMetrics(this.GetFieldValue(&quot;Status&quot;), TheApplication().GetProfileAttr(&quot;OldStatusValue&quot;));
			  		TheApplication().SetProfileAttr(&quot;OldStatusValue&quot;, &quot;&quot;);
			  				  	
				break;
				
					
				
				//11032 start
				
			case &quot;Requested Ship Date&quot;:
					gNewReqShipDate = this.GetFieldValue(&quot;Requested Ship Date&quot;);
					// The below line is commented as part of defect 11480. The code should work for all type of Orders.
				    //if(sOrderType == &quot;Modify&quot;)
						mSetFutureShipDate();
					
			break;	
				//11032 end				
			
			//XA: R11.C - Paperless: Explicitly write &amp; refresh once the paperless bypass reason is selected after the Submit validation Failure.	
			case &quot;VF Digital Contract Bypass Reason&quot;:
				if(TheApplication().GetProfileAttr(&quot;profAttrContractCheckFailed&quot;) == &quot;Y&quot;)
				{
					var sByPass = this.GetFieldValue(&quot;VF Digital Contract Bypass Reason&quot;);
					//Refresh the current Record
					this.InvokeMethod(&quot;RefreshRecord&quot;);
					this.SetFieldValue(&quot;VF Digital Contract Bypass Reason&quot;, sByPass);
					TheApplication().SetProfileAttr(&quot;profAttrContractCheckFailed&quot;, &quot;N&quot;);				
				}
				//Soumalya:Added for setting VHA Override SMS for SSJ child orders CM-9903
				if(this.GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Quote Order&quot;)
					prpgtChldOrdByPassReason = &quot;Y&quot;;
			break;	
			
				
		}


	}
	catch(e)
	{
	
		//Error Caught
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Account. SetFieldValue.FieldName=&quot; + FieldName);
		}       
		
		if (defined(e.errText))
		{
			sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			sErrorMessage = e.toString(); 
		}

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Orders&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_SetFieldValue&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(sErrorMessage);
     }
     finally
     {
      	bsError = null;
		psErrorInput = null;
		psErrorOutput = null;
		sErrorMessage = null;    
     }
}"
			   SEQUENCE="9"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetOrderDateTimeMetrics"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SetOrderDateTimeMetrics(sCurrentOrderStatus, sOldOrderStatus)
{
/*
* Component Name        : 	Order Entry - Orders
* Method Name           : 	SetOrderDateTimeMetrics
* Component Information : 	Called from SetFieldValue when the staus is set
*							Depending on the status set, set various datetime field values
*							Values will be used in reporting failed orders
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 03/11/2010	SLV			Release 10.5  Initial Version
* 12/11/2010	KARP		Removed Check on sOldOrderStatus for updating First Submit DateTime	
* 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages												
*/
 try
 	{
		//declare variables
 		var iClibTime = Clib.time();
		var dtNow = Date.fromSystem(iClibTime);
		var sFormattedDate;
		var sFormattedDateTime;
		var iNoTimesSubmit = this.GetFieldValue(&quot;VF No Of Times Submitted&quot;);

		sFormattedDate = (dtNow.getUTCMonth() + 1) + &quot;/&quot; + dtNow.getUTCDate() + &quot;/&quot; + dtNow.getUTCFullYear();
    	sFormattedDateTime = sFormattedDate + &quot; &quot; +
                   dtNow.getUTCHours() + &quot;:&quot; + dtNow.getUTCMinutes() + &quot;:&quot; + dtNow.getUTCSeconds();
	
		switch (sCurrentOrderStatus)
		{
			case &quot;Submitted&quot;:
				//set VF First Submit DateTime field to Now if this is the first time
				//the order has been submitted
				var sOrderChannel = this.GetFieldValue(&quot;VF Order Channel&quot;);
				var sOrderType = this.GetFieldValue(&quot;Order Sub Type&quot;);
				if (sOrderChannel == &quot;VHA Online Store&quot; &amp;&amp; sOrderType == &quot;Fulfilment&quot;)
				{
				//Do Nothing
				
				}
				else
				{
					var sFirstSubmitDate = this.GetFieldValue(&quot;VF First Submit DateTime&quot;);
					if (sFirstSubmitDate == &quot;&quot; || sFirstSubmitDate == null)
					{
						this.SetFieldValue(&quot;VF First Submit DateTime&quot;, sFormattedDateTime);
					}
					
					//set the number of times submitted value
					if (iNoTimesSubmit == &quot;&quot;)
					{
						iNoTimesSubmit = 0;
					}
						
					//increase by 1
					iNoTimesSubmit = ToInteger(iNoTimesSubmit);
					iNoTimesSubmit++;
						
					this.SetFieldValue(&quot;VF No Of Times Submitted&quot;, ToString(iNoTimesSubmit));
					this.WriteRecord();
				}
			break;
			
			case &quot;Complete&quot;:
				//set VF Order Complete DateTime field to Now if status changes to complete
				if (this.GetFieldValue(&quot;VF Order Complete DateTime&quot;) == &quot;&quot;)
				{
					this.SetFieldValue(&quot;VF Order Complete DateTime&quot;, sFormattedDateTime);
					this.WriteRecord();
				}
			break;
			
			case &quot;On Hold&quot;:
				//set VF Status On Hold DateTime field to Now if status changes to on hold
				if (this.GetFieldValue(&quot;VF Status On Hold DateTime&quot;) == &quot;&quot;)
				{
					this.SetFieldValue(&quot;VF Status On Hold DateTime&quot;, sFormattedDateTime);
					this.WriteRecord();
				}
			break;
			
		}
					
			
 	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
}"
			   SEQUENCE="6"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateShippingStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*******************************************************************
 * Component Name        : 	Order Entry - Orders
 * Method Name           : 	UpdateShippingStatus
 * Component Information : 	 Added subroutine to update child Shipping status for all new Shipping records, after
 *							 order Status is set to Submitted
 * Modification History  :
 * Date			Author	Config #	Description
 * ==========	======= ===========	=====================================
 * 13/09/09		AG					Subroutine to update child Shipping status before submit order WF is called
 * 06/10/09		AA				    Defect 4616
 * 10/02/11     HKM	                Defcet 13554
 * 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 *******************************************************************
 */
function UpdateShippingStatus()
{
	try
	{
			var sOrderId = this.GetFieldValue(&quot;Id&quot;);
		 // var boOrder = this.BusObject(); //defect 4616 // don&apos;t use same bo instance.
			//var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;); // defect 13554 create new instance//TARIQ-Commented
            //var bcShipment = boOrder.GetBusComp(&quot;FS Shipment&quot;);//TARIQ-Commented
			var bcShipment = TheApplication().GetBusObject(&quot;VF FS Shipment Update&quot;).GetBusComp(&quot;VF FS Shipment&quot;);//TARIQ-Added
			with (bcShipment)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Status&quot;);
				ActivateField(&quot;Primary Order Id&quot;);
				SetSearchSpec(&quot;Primary Order Id&quot;, sOrderId);
				SetSearchSpec(&quot;Status&quot;, &quot;NEW&quot;);
				ExecuteQuery(ForwardOnly);
				var isRecord= FirstRecord();

				while (isRecord)
				{
					SetFieldValue(&quot;Status&quot;, &quot;SUBMITTED&quot;);
					WriteRecord();
					isRecord = NextRecord();
				}
			}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Orders.UpdateShippingStatus&quot;);
		}	
		bcShipment = null;
		//boOrder = null;//TARIQ-Commented
	}

}"
			   SEQUENCE="7"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="decrementFailedPortIMEI"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function decrementFailedPortIMEI()
{
/*
* Component Name        : 	Order Entry - Orders
* Method Name           : 	decrementFailedPortIMEI
* Component Information : 	Called by SetFieldValue when the staus = &quot;Port In Failed&quot;
*							Checks for an allocated IMEI and decrements the IMEI List if found
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
*  20/01/2009	NG			DF9609		Initial version 
*  05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages												
*/
 try
 	{
 		// declare objects
     	var boOrder = this.BusObject();
 		var bcOrder;
 		var bcRootLineItem;
 		var bcIMEI = boOrder.GetBusComp(&quot;VF Allocate IMEI&quot;);
 		
 		var boVFIMEIList;
 		var bcVFIMEIList;
 		
 		// declare variables
 		var strOrderId;
 		var strIMEI
 		var iTimesSold;
 		var strTimesSold;
 		
      	// trace
     	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Order Entry - Orders.decrementFailedPortIMEI&quot;);
		}     
		
		strOrderId	= this.GetFieldValue(&quot;Order Id&quot;);
		
		if (strOrderId == &quot;&quot;)
		{
			throw (&quot;VFErrorCode#99354 - Order Id not passed into the function.&quot;);
		}

		bcRootLineItem = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		
		queryForRootLineItem(bcRootLineItem, strOrderId);
		
		with(bcIMEI)
		{
			ClearToQuery();
			ExecuteQuery();
			if(FirstRecord())
			{
				strIMEI = GetFieldValue(&quot;IMEI&quot;);
				
				// query the IMEI List and update accordingly
				boVFIMEIList = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
				bcVFIMEIList = boVFIMEIList.GetBusComp(&quot;VF IMEI List&quot;);
				
				with(bcVFIMEIList)
				{
					SetViewMode(AllView)
					ClearToQuery();
					ActivateField(&quot;Number of Times Sold&quot;);
					SetSearchSpec(&quot;IMEI&quot;, strIMEI);
					ExecuteQuery(ForwardOnly);		
	
					if (FirstRecord())
					{
						iTimesSold = ToNumber(GetFieldValue(&quot;Number of Times Sold&quot;));
					
						//decrement times sold by 1
						if(iTimesSold &gt; 0)
							iTimesSold = iTimesSold - 1;

						strTimesSold = ToString(iTimesSold);
						// update the existing record
						SetFieldValue(&quot;Number of Times Sold&quot;, strTimesSold);
						WriteRecord();
				
					}
				}
				
			}
		}			
 	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
 	finally
 	{
 		// destory objects
 		bcVFIMEIList = null;
 		boVFIMEIList = null;
 		bcIMEI = null;
 		bcRootLineItem = null;
 		bcOrder = null;
 		boOrder = null;
 		
 	}
  

}"
			   SEQUENCE="2"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetHSMVersionID"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*******************************************************************
/* Component Name        : 	Order Entry - Orders
/* Method Name           : 	mGetHSMVersionID
/* Date					 :	02/07/09
/* Author				 :	HR
/* Description			 : 	Code Added to get the LIVE version of Handset Matrix and 
/*							store
/*
/* Date		Author			Config			Description
/* 02/07/09	HR		Initial Version	Code Added to get the LIVE version of Handset Matrix 
/* 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
/*******************************************************************/

function mGetHSMVersionID()
{

	try
		{
		
		//Declare Objects

		var boMatrix = TheApplication().GetBusObject(&quot;VF Handset Matrix&quot;);
		var bcMatrixVers = boMatrix.GetBusComp(&quot;VF Handset Matrix Version&quot;);
		var strBatchId;
		


			with(bcMatrixVers)
			{
				SetViewMode(AllView)
				ClearToQuery();
				ActivateField(&quot;Batch Id&quot;);
				ActivateField(&quot;Version Status&quot;);
				SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
				strBatchId = GetFieldValue(&quot;Batch Id&quot;);
				this.SetFieldValue(&quot;HSM Version Id&quot;, strBatchId);
				WriteRecord();
				}
			}
		}

		catch(e)
		{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
		}
 		finally
 		{
 		// destory objects
 		bcMatrixVers = null;
 		boMatrix = null; 			
 		}
}"
			   SEQUENCE="3"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetReqShipDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetReqShipDate()
{
/*******************************************************************
/* Date: 		2/12/04
/* Author: 		Sarah Vale
/* Description: Added code which works out whether future submit date needs to be
/*				changed, depending on organisations.  Then value is inserted into
/*				Requested Ship Date.
/*
/* CHANGES
/*
/* Date		Author	Config			Description
/* 02/5/06	SLV		Defect 13041	Now set the requested ship date to 1 second past midnight
/*									on the day AFTER the future submit date.  This is to prevent
/*									Infranet from blowing up.
/* 16/02/07	EHui	Defect 23824	Modified requested ship date to exactly midnight on the day 
/*									of the future submit date, i.e. 00:00:00
/* 06/11/07 Khui	Defect 6105		For future dated orders, Billing Effective Date should be 00:00:00 
									on whatever the future date specified by the user is 
								    i.e. use the same logic that was used to set the effective date of 
								    future dated orders.
								    Effective Date set to 1 sec before Billing Effective Date
/* 14/05/08 Ehurley 				Added code to cater for NZ orders created by a login with no Timezone set
/*									Current behaviour is to set to server local time (AU), we need to add 2 hours
 *									when the order is NZ.
/* 11/06/09	Santosh Defect#11032	When user modifies Future Date field to null in order then check/set various conditions.
/* 03/10/09	AnoopS Defect#11741		Changed Future submitted date validation
/*******************************************************************/

	//Condition that Number of Submits = 0 is necessary as we don&apos;t want
	//Requested Ship Date changing after the order has been submitted
	if (this.GetFieldValue(&quot;Number Of Submits&quot;) == 0)
	{
		try
		{
			//Trace
			if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			{			
				TheApplication().Trace(&quot;START: Order Entry - Orders; Method - SetFieldValue&quot;);
			}
			
			//Set some constants
			var VODA_AU = &quot;Vodafone AU&quot;;
			var VODA_DEF = &quot;Organisation other than AU or NZ&quot;;
			var ZONE_AU = &quot;(GMT+10:00) Canberra, Melbourne, Sydney&quot;;
			var AU_NZ_TIME_DIFF = 2;
			//and some variables
			var sFutureSubmit;
			var dtFutureSubmit;
			var timeFutureSubmit;
			var sLoginId;
			var boEmployee;
			var bcEmployee;
			var sUserTimeZone;
			var sVFOrganisation;
			var sAccountId;
			var boAccount;
			var bcAccount;
			var sAccountOrg;
			var sFormattedDate;
			var sFormattedDateTime;
			//DF6105 variables
			var sFormattedDateMinus1Sec;
			var sFormattedDateTimeMinus1Sec;
			
			//var iClibTime = Clib.time();					
			//var dtToday = new Date.fromSystem(iClibTime);  //PRAKASHN 12/05/2014: commented code as the future date change waas throughing exception as a part of upgrade
			var dtToday = Date.fromSystem(Clib.time());	//PRAKASHN 12/05/2014: Updated code as per 8.1 format.
			var sOrderStatus;// Added for DF#11032
			//Added code by AnoopS for TD11741 
			var sValidMont;
			var sValidDay;
			var sValidYear;
			var sValidFutureSubmit;
			var sValidSysDate;
			var sValidSysDatePlus;
			//GOPALJ Added the new Variables for Future date CR
			var sVFAgentFutureDays;
            var sVFAdminFutureDays;
            var sVFFDateRespCheckFlag;

			//GOPALJ Added for Future Date CR
			sVFAgentFutureDays = this.GetFieldValue(&quot;VFAgentFutureDays&quot;);
            sVFAdminFutureDays = this.GetFieldValue(&quot;VFAdminFutureDays&quot;);
            sVFFDateRespCheckFlag = this.GetFieldValue(&quot;VFFDateRespCheckFlag&quot;);
			
			//Get the Future Submit Date and set to be a date object
			sFutureSubmit = this.GetFieldValue(&quot;Future Submit Date&quot;);
					sValidMont = sFutureSubmit.substring(0,2);
					sValidDay = sFutureSubmit.substring(3,5);
					sValidYear = sFutureSubmit.substring(6,10);
					sValidFutureSubmit = sValidYear + sValidMont +  sValidDay;

			    //End changes for 11287 and 7525 
			var SysDate = this.GetFieldValue(&quot;SysDate&quot;);
					sValidMont = SysDate.substring(0,2);
					sValidDay = SysDate.substring(3,5);
					sValidYear = SysDate.substring(6,10);
					sValidSysDate = sValidYear + sValidMont +  sValidDay;
                    //GOPALJ Added for Future Date CR
					 if (sVFFDateRespCheckFlag == &quot;Y&quot;)
					    {
                      var SysDatePlus = this.GetFieldValue(&quot;VFAdminMaxDays&quot;);
					  TheApplication().SetProfileAttr(&quot;RespAdmin&quot;,sVFAdminFutureDays);
					     }
					   else
					     {
                       var SysDatePlus = this.GetFieldValue(&quot;VFAgentmaxDays&quot;);
					   TheApplication().SetProfileAttr(&quot;RespAdmin&quot;,sVFAgentFutureDays);
					    }
			//var SysDatePlus = this.GetFieldValue(&quot;SysDate Plus 90&quot;);
					sValidMont = SysDatePlus.substring(0,2);
					sValidDay = SysDatePlus.substring(3,5);
					sValidYear = SysDatePlus.substring(6,10);
					sValidSysDatePlus = sValidYear + sValidMont +  sValidDay;
			//End of Code by Anoop for 11741
		    var sFormattedTodayDate = (dtToday.getMonth() + 1) + &quot;/&quot; + dtToday.getDate() + &quot;/&quot; + dtToday.getFullYear();
		    var	sFormattedTodayDateTime = sFormattedTodayDate + &quot; &quot; + dtToday.getHours() + &quot;:&quot; + dtToday.getMinutes() + &quot;:&quot; + dtToday.getSeconds();
		
			sOrderStatus = this.GetFieldValue(&quot;Status&quot;); // Added for DF#11032
			
			if (gNewFutSubmitDate == &quot;&quot;)
			{		//start of 11302
				if(sOrderStatus == &quot;On Hold&quot;)
					{
					
						this.SetFieldValue(&quot;Billing Effective Date&quot;, &quot;&quot;);
				 		this.SetFieldValue(&quot;Requested Ship Date&quot;, sFormattedTodayDateTime);
				 		this.WriteRecord();
				 		
					}
				else 
					if(sOrderStatus == &quot;Pending&quot;)
					{
						this.SetFieldValue(&quot;Requested Ship Date&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;Billing Effective Date&quot;, &quot;&quot;);
						this.WriteRecord();
						
					}	
					else
					{			//end of 11032
				
					this.SetFieldValue(&quot;Requested Ship Date&quot;, &quot;&quot;);
					//PDefect 6105
					this.SetFieldValue(&quot;Billing Effective Date&quot;, &quot;&quot;);
					this.WriteRecord();
					}
			}
			else
			//changed by Anoop for TD 11741
			 if(sValidFutureSubmit&lt; sValidSysDate || sValidFutureSubmit &gt; sValidSysDatePlus)
			 
			 	{	
			 		if(sOrderStatus == &quot;Pending&quot;)
			 		{
				 		this.SetFieldValue(&quot;Requested Ship Date&quot;, &quot;&quot;);
				 		this.SetFieldValue(&quot;Billing Effective Date&quot;, &quot;&quot;);
				 		this.SetFieldValue(&quot;Future Submit Date&quot;, &quot;&quot;);
				 		this.WriteRecord();
				 		throw(&quot;VFErrorCode#99399&quot;); 
			 		}
			 		else 
			 		 if(sOrderStatus == &quot;On Hold&quot;)
			 		 {
			 		 
			 			this.SetFieldValue(&quot;Requested Ship Date&quot;, sFormattedTodayDateTime);
				 		this.SetFieldValue(&quot;Billing Effective Date&quot;, &quot;&quot;);
				 		this.SetFieldValue(&quot;Future Submit Date&quot;, &quot;&quot;);
				 		this.WriteRecord();
				 		throw(&quot;VFErrorCode#99399&quot;); 
			 		 
			 		 }
			 	}
			 
			 	else 
				{
				
						dtFutureSubmit = new Date(sFutureSubmit);
						
						timeFutureSubmit = dtFutureSubmit.getTime();			
						
						//VF EHui Defect 23824 16/02/07 - Changed to midnight on future date exactly.
						//and NOT 1 second past midnight one day AFTER future date.
						
						//dtFutureSubmit.setTime(timeFutureSubmit + (60 * 60 * 24 * 1000));
						dtFutureSubmit.setTime(timeFutureSubmit);
						
						//dtFutureSubmit.setHours(00, 00, 01);
						dtFutureSubmit.setHours(00, 00, 00);
						
						//Get Time for later use
						timeFutureSubmit = dtFutureSubmit.getTime();
						
						//Find the timezone of the person logged in
						sLoginId = TheApplication().LoginId();
						
						boEmployee = TheApplication().GetBusObject(&quot;Employee&quot;);
						bcEmployee = boEmployee.GetBusComp(&quot;Employee&quot;);
						
						bcEmployee.ClearToQuery();
						bcEmployee.SetViewMode(AllView);
						bcEmployee.ActivateField(&quot;Time Zone Name&quot;);
						bcEmployee.SetSearchSpec(&quot;Id&quot;, sLoginId);
						bcEmployee.ExecuteQuery(ForwardOnly);
						
						if (bcEmployee.FirstRecord())
						{
							sUserTimeZone = bcEmployee.GetFieldValue(&quot;Time Zone Name&quot;);
						
							if (sUserTimeZone == ZONE_AU)
							{
								sVFOrganisation = VODA_AU;
							}							
							else
							{
								sVFOrganisation = VODA_DEF;
							}
						}
									
						//Find the organisation of the account on the order
						sAccountId = this.GetFieldValue(&quot;Account Id&quot;);
						
						boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
						bcAccount = boAccount.GetBusComp(&quot;Account&quot;);
						
						bcAccount.ClearToQuery();
						bcAccount.SetViewMode(AllView);
						bcAccount.ActivateField(&quot;Primary Organization&quot;);
						bcAccount.SetSearchSpec(&quot;Id&quot;, sAccountId);
						bcAccount.ExecuteQuery(ForwardOnly);
						
						if (bcAccount.FirstRecord())
						{
							sAccountOrg = bcAccount.GetFieldValue(&quot;Primary Organization&quot;);
						}
			
						//DEBUG TRACE STATEMENTS
						//if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
						//{			
						//	TheApplication().Trace(&quot;Future Date = &quot; + dtFutureSubmit);	
						//	TheApplication().Trace(&quot;sAccountId	= &quot; + sAccountId);
						//	TheApplication().Trace(&quot;sAccountOrg = &quot; + sAccountOrg);
						//	TheApplication().Trace(&quot;User Organisation = &quot; + sVFOrganisation);
						//}
						
						//So now we know the organisation of the order, and of the person
						//who created the order.  If they are different (for example a CSR
						//from AU who is creating an order for a customer from NZ) then we
						//need to manipulate the Requested Ship Date to take this into
						//account.
						
						if ((sAccountOrg != sVFOrganisation) &amp;&amp; (sVFOrganisation != VODA_DEF))
						{
							//If the user&apos;s org is AU, and the account is NZ we need to take off 2 hours
							//to account for difference in time zone
							if (sAccountOrg == VODA_AU)
							{
								dtFutureSubmit.setTime(timeFutureSubmit - (AU_NZ_TIME_DIFF * 60 * 60 * 1000));
							}							
						}
						
						var aDate = new Date();
						var sTimezone = Math.round(aDate.getTimezoneOffset() / 60);
		
						// If the login has no default timezone, the current local timezone of the server is Australia
						// and the order header indicates this is an NZ order, we need to subtract 2 hours to account
						// for the difference in timezone
						if ((sVFOrganisation == VODA_DEF) &amp;&amp; (sTimezone == -10 || sTimezone == -11 ))
						{
								dtFutureSubmit.setTime(timeFutureSubmit - (AU_NZ_TIME_DIFF * 60 * 60 * 1000));
		
						}				
						
						//Date must be formatted to MM/DD/YYYY hh:mm:ss
						sFormattedDate = (dtFutureSubmit.getMonth() + 1) + &quot;/&quot; + dtFutureSubmit.getDate() + &quot;/&quot; + dtFutureSubmit.getFullYear();
			    		sFormattedDateTime = sFormattedDate + &quot; &quot; +
			                    dtFutureSubmit.getHours() + &quot;:&quot; + dtFutureSubmit.getMinutes() + &quot;:&quot; + dtFutureSubmit.getSeconds();
						
						//PDefect6105 - New Request Ship Date
						timeFutureSubmit = dtFutureSubmit.getTime();
						dtFutureSubmit.setTime(timeFutureSubmit - 1000);
						sFormattedDateMinus1Sec = (dtFutureSubmit.getMonth() + 1) + &quot;/&quot; + dtFutureSubmit.getDate() + &quot;/&quot; + dtFutureSubmit.getFullYear();
			    		sFormattedDateTimeMinus1Sec = sFormattedDateMinus1Sec + &quot; &quot; +
			                    dtFutureSubmit.getHours() + &quot;:&quot; + dtFutureSubmit.getMinutes() + &quot;:&quot; + dtFutureSubmit.getSeconds();
						
						
						if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
						{			
							TheApplication().Trace(&quot;Final Date String = &quot; + sFormattedDateTime);		
						}
			
						// Set Objects to null here because as we do a setfieldvalue
						// the code doesn&apos;t run through the &apos;finally&apos; section
						bcAccount = null;
						boAccount = null;
						bcEmployee = null;
						boEmployee = null;
						
						//PDefect6105 Replace Requested Ship Date with Bill Effective Date		
							//Finally set the Requested Ship Date...
							//this.SetFieldValue(&quot;Requested Ship Date&quot;, sFormattedDateTime);
						 this.SetFieldValue(&quot;Billing Effective Date&quot;, sFormattedDateTime);
						 this.SetFieldValue(&quot;Requested Ship Date&quot;, sFormattedDateTimeMinus1Sec);
						 this.WriteRecord();
					}
						
					//Trace
					if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
					{			
						TheApplication().Trace(&quot;END: Order Entry - Orders; Method - SetFieldValue&quot;);
					}
		}
		catch(e)
		{
			throw(e);
		}
	}
}"
			   SEQUENCE="4"
			   UPDATED="04/22/2026 00:03:56"
			   UPDATED_BY="KRISHNAS"
			   CREATED="04/21/2026 14:54:42"
			   CREATED_BY="KRISHNAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="queryForRootLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*******************************************************************
 * Component Name        : 	Order Entry - Orders
 * Method Name           : 	queryForRootLineItem
 * Component Information : 	Queries for the root line item activating the required fields.
 *							It relies on the Order Entry - Orders bus comp to provide
 *							the correct context via the link.
/*-----------------------------------------------------------------
/*	Date			Upd By				Description
/*	14/02/2005		TAlihos				Initital version.
/*  05/08/2014	  	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
/*******************************************************************/
function queryForRootLineItem(bcRootLineItem, strOrderId)
{
	/******************
	/*Declare Objects
	/******************/
	
	
	
	/******************
	/*Declare Variables
	/******************/
	
//	var sAssetIntId; 	sAssetIntId = bcRootLineItem.GetFieldValue(&quot;Asset Integration Id&quot;);

	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Order Entry - Orders.queryForRootLineItem&quot;);
		}

		bcRootLineItem.ClearToQuery();
		bcRootLineItem.SetViewMode(AllView);
		bcRootLineItem.ActivateField(&quot;Order Header Id&quot;);
		bcRootLineItem.ActivateField(&quot;Asset Integration Id&quot;);
		bcRootLineItem.ActivateField(&quot;Primary MSISDN&quot;);
		bcRootLineItem.SetSearchSpec(&quot;Order Header Id&quot;, strOrderId);
		bcRootLineItem.ExecuteQuery(ForwardBackward)

		//Now lets see if a record is returned			
	
		if (!bcRootLineItem.FirstRecord())
		{
			throw (&quot;VFErrorCode#99306 - Could not find line item&quot;);
		}
	
	
	
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Order Entry - Orders.queryForRootLineItem&quot;);
		}	
	}
}"
			   SEQUENCE="5"
