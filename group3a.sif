			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncSubscription"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	CUT Address
 * Method Name           :	BusComp_mSyncSubscription
 * Component Information :	Call the &quot;VF Account Sync Service&quot;.
 *							All errors including BS errors will be caught and logged.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 31/01/2005	MSL						Initial Version
 */
function mSyncSubscription()
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:CUT Address.mSyncSubscription&quot;);
		}
		
		/*******************************
		* Declare Objects
		*******************************/
		var bsSyncAccount;
		var psSyncInput;
		var psSyncOutput;

		psSyncInput		= TheApplication().NewPropertySet();			
		psSyncOutput	= TheApplication().NewPropertySet();
		bsSyncAccount	= TheApplication().GetService(&quot;VF Synch Account And Subscription&quot;);

		/*******************************
		* Invoke business service
		*******************************/
		psSyncInput.SetProperty(&quot;AccountId&quot;, this.GetFieldValue(&quot;Account Id&quot;));
		bsSyncAccount.InvokeMethod(&quot;SyncSubscription&quot;, psSyncInput, psSyncOutput);
		
		if (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;).length &gt; 0)
			throw (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;));
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:CUT Address.mSyncSubscription.strError= &quot; + strError);
		}
     	throw (strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:CUT Address.mSyncSubscription&quot;);
		}
		
		psSyncInput = null;
		psSyncOutput = null;
		bsSyncAccount = null;
	}
}"
