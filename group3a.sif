			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateKoganCreditCardTokenNumber"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateKoganCreditCardTokenNumber(FieldValue,sCardType)
{
	try
	{
		//SK 24.1.18 - Below variables and code modified to validate credit card number using Luhn&apos;s algorithm
		//Variables 
		var sum = 0;
		var sDigit = 0;
		var bEven = false;
		var n;
		//var sCardTypeLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CC_TYPE&quot;,&quot;AMEX&quot;);
		//BC field values retrieved
		var sCCTokenNo;
		
		if(FieldValue != &quot;&quot; &amp;&amp; !isNaN(FieldValue))// balajiM added for Miami  - by pass for BT token - 29/Apr/2022
		{	
			if (FieldValue.indexOf(&quot; &quot;) &gt; 0)
			{				
				//TheApplication().RaiseErrorText(&quot;Credit Crad Token Number must be entered with no spaces.&quot;);
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9102&quot;)); //VHA Sneha:Modified for KOGAN
			}

			if ((FieldValue.indexOf(&quot;(&quot;) &gt; 0) || (FieldValue.indexOf(&quot;)&quot;) &gt; 0))
			{
				//TheApplication().RaiseErrorText(&quot;Credit Crad Token Number must be entered with no brackets.&quot;);
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9103&quot;)); //VHA Sneha:Modified for KOGAN

			}
			if (isNaN(FieldValue) || FieldValue.indexOf(&quot;.&quot;) &gt; 0)
			{
				//TheApplication().RaiseErrorText(&quot;Credit Crad Token Number must be numeric&quot;);
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9104&quot;)); //VHA Sneha:Modified for KOGAN
			}
			//VHA Muthushankari 10/4/2018 - Added the below code as part of PKE000000060580(FTTC CR)
			var sCardLength = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_KOGAN_CC_DIGIT_VALIDATION&quot;,sCardType);
			if(FieldValue.length != ToNumber(sCardLength))
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9105&quot;, sCardLength)); 
			/*if(sCardType != null &amp;&amp; sCardType != &quot;&quot;)
			{
				if(sCardType == sCardTypeLOV)
				{ 
					if(FieldValue.length != 15)
						TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9105&quot;, &quot;15&quot;)); 	//VHA Sneha:Modified for KOGAN
				}
				else if(FieldValue.length != 16)
				{ 
					//TheApplication().RaiseErrorText(&quot;Invalid Credit Crad Token Number. It must be either an 16 digit number&quot;);
					TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9105&quot;, &quot;16&quot;)); 	//VHA Sneha:Modified for KOGAN
				}
			}*/
			
			//Lughn&apos;s Algorithm implemented to validate Credit Card Number entered by the user
			sCCTokenNo = FieldValue;
			
			//for loop to loop through the credit card number
			for (n=sCCTokenNo.length-1; n&gt;=0 ; n--) {
				
				sDigit = ToNumber(sCCTokenNo.charAt(n)); //Gets the digit from CC number at nth position
				
				//bEven flag to double only the alternate digits and check if greater than 9
				if (bEven) {
					sDigit *= 2;
					if (sDigit&gt;9) {
							sDigit -= 9;
					}
				}
				sum += sDigit;
				bEven = !bEven;	
			}
			
			//Throw validation if sum modulo 10 gives any remainder
			if ( sum%10 == 0) {
				TheApplication().RaiseErrorText(&quot;VHA_PIPE_9108&quot; + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PIPE_9108&quot;)); 
			}
		}
								
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	}
}"
			   SEQUENCE="24"
			   UPDATED="06/20/2022 16:57:04"
			   UPDATED_BY="SADMIN"
			   CREATED="03/27/2018 15:46:29"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateNotificationMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateNotificationMSISDN(FieldValue)
{
	//Chitra added for TIR 16.4 release - 19/9/2016
	try
	{
			var sDummyMSISDN = mGetSysPref(&quot;VF Dummy Notification MSISDN&quot;);
			if(FieldValue != sDummyMSISDN)
			{
				if(FieldValue != &quot;&quot;)
						{	
							if (FieldValue.indexOf(&quot; &quot;) &gt; 0)
							{				
								TheApplication().RaiseErrorText(&quot;Notification MSISDN must be entered with no spaces.&quot;);
							}
				
							if ((FieldValue.indexOf(&quot;(&quot;) &gt; 0) || (FieldValue.indexOf(&quot;)&quot;) &gt; 0))
							{
								TheApplication().RaiseErrorText(&quot;Notification MSISDN must be entered with no brackets.&quot;);
				
							}
							if (isNaN(FieldValue) || FieldValue.indexOf(&quot;.&quot;) &gt; 0)
							{
								TheApplication().RaiseErrorText(&quot;Notification MSISDN must be numeric&quot;);
							}
								
				            if( FieldValue.indexOf(&quot;614&quot;) != 0 || FieldValue.length != 11)
				            { 
								if(TheApplication().GetProfileAttr(&quot;VHAConnectFBB&quot;) == &quot;Y&quot;)
								{
									TheApplication().RaiseErrorText(&quot;Invalid MSISDN. It must be either an 11 digit number starting with &apos;614&apos;&quot;); 	
								}
								else
								{
									TheApplication().RaiseErrorText(&quot;Invalid MSISDN. It must be either an 11 digit number starting with &apos;614&apos; or &apos;61499999&apos;&quot;); 
						    	}
						    }
																		
						}
			}					
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	}
}"
