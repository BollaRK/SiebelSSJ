			<FIELD
			   CALCULATED="Y"
			   CALCULATED_VALUE="IfNull ([Unit Price], IfNull ([Adjusted List Price] * (100.0 - [Discount Percent]) / 100.0, IfNull ([Adjusted List Price] - [Discount Amount], IfNull ([Adjusted List Price] * (100.0 - [Discount]) / 100.0, [Adjusted List Price]))))"
			   COMMENTS="Changed for Handheld IfNull fix.  Original: &quot;IfNull ([Unit Price], IfNull ([Base Price] * (100.0 - [Discount Percent]) / 100.0, IfNull ([Base Price] - [Discount Amount], IfNull ([Base Price] * (100.0 - [Discount]) / 100.0, [Base Price]))))&quot;"
			   CURRENCY_CODE_FIELD="Currency Code"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   EXCHANGE_DATE_FIELD="Exchange Date"
			   FORCE_ACTIVE="N"
			   HIDDEN="Y"
			   IMMEDIATE_POST_CHANGES="N"
