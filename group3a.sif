			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
/*
 * Method Name           : 	BusComp_PreInvokeMethod
 * Component Information : 	Supports the Reshipment, Cancel Shipment and Retrieve Status
 *							methods. Invokes corresponding workflow processes.
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ==========	======= ===========	=====================================
 * 09/09/2009	AG					eUpgrade shipment
 * 07/10/2009	MSL		Defect 4566 Re-written to call the Invoke Workflow function and re-written the error handling
 *									All workflow exceptions are handled in the workflow now.
  */
 
 	var iReturnValue = ContinueOperation;
 	
	try
	{
		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:FS Shipment.PreInvokeMethod.MethodName=&quot; + MethodName);
		}
		
		// Declare Variables / Objects
		var psErrorInput;
		var psErrorOutput;
		var bsError;
		
		switch (MethodName)
		{
			case &quot;Cancel&quot;:
				InvokeWorkflow(&quot;VF Cancel Shipment Framework&quot;);
				this.InvokeMethod(&quot;RefreshRecord&quot;);
				
				iReturnValue = CancelOperation;
				break;

			case &quot;RetreiveStatus&quot;:
				InvokeWorkflow(&quot;VF Shipment Retrieve Status&quot;);
				this.InvokeMethod(&quot;RefreshRecord&quot;);
				
				iReturnValue = CancelOperation;
				break;

			case &quot;Resubmit&quot;:
				this.WriteRecord();
				InvokeWorkflow(&quot;VF Resubmit Shipment Request&quot;);
				this.InvokeMethod(&quot;RefreshRecord&quot;);
								
				iReturnValue = CancelOperation;
				break;

			case &quot;RequestReshipment&quot;:
				this.SetFieldValue(&quot;Status&quot;, &quot;CANCELLED&quot;);
				this.WriteRecord();
				
				this.NewRecord(3); // New After Copy
				this.SetFieldValue(&quot;Status&quot;, &quot;NEW&quot;);
				this.SetFieldValue(&quot;VF Reship Flag&quot;, &quot;N&quot;);
				this.SetFieldValue(&quot;Freight Cost&quot;,0);
				this.SetFieldValue(&quot;VF Reship Flag&quot;, &quot;Y&quot;);
				this.WriteRecord();
				iReturnValue = CancelOperation;
				break;
			default:				
				break;

		}
		return (iReturnValue);
	}
	catch(e)
	{	
		//*************************************
		//* Error Handling
		//*************************************
		if (defined(e.errText))
		{
			var sErrorMessage = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var sErrorMessage = arguments.callee + ToString(e); 
		}
		
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:FS Shipment.BusComp_PreInvokeMethod.&quot; + sErrorMessage);
		}
		
		psErrorInput  = TheApplication().NewPropertySet();			
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;FS Shipment&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;PreInvokeMethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		
		TheApplication().RaiseErrorText(sErrorMessage);
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
	}
}"
