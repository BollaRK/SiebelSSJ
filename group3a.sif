			<BUSCOMP_SERVER_SCRIPT
			   COMMENTS="VF AG 24/08/09 added new for upgrade Shipment functionality"
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
/*
 * Component Name        : 	FS Shipment
 * Method Name           : 	BusComp_PreWriteRecord
 * Component Information :  Value Band needs to be populated from Asset Header.Value Band field.
 *							Root Order line Item record for parent Order is queried and value for Asset
 *							Integration Id is received from there. This Asset Integration Id is used for 
 *							querying Asset Header record and value of Value Band field is set to 
 *							VF Value Band field of current shipment record
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 30/08/2009	AGoenka		PR211		Initial Version
 * 25/06/2010	Mahend					Defaulted the valueband value to 4 if its null.
 * 03/09/2012	SZK			TD14653		Added validation to check that there is only one Address of each Shipment Type
 */
try{

	var sOrderId = this.GetFieldValue(&quot;Primary Order Id&quot;);
	var sAssetIntgId = null;
	var sValueBand;
	var	sSearchExpr;
	var sOrderExist;
	var sShipType,sCurrentId; // Added for TD14653
    var strEaiFlg = TheApplication().GetProfileAttr(&quot;EAI_FLAG&quot;); // Added for TD14653

	if (sNewRecord == &quot;Y&quot;)
	{
		var sBOOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sBCOrder = sBOOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var sBCShip = sBOOrder.GetBusComp(&quot;FS Shipment&quot;);
		var sBCOrdLnItem = sBOOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var sBCAssetHdr = sBOOrder.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
	
		
		with (sBCOrder)
		{	
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			
			sOrderExist = FirstRecord();
		}//end with Order BC
		sSearchExpr = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] is NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
		
		if (sOrderExist)
		{
			with (sBCOrdLnItem)
			{	
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Asset Integration Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);
				
				if (FirstRecord())
				{
					sAssetIntgId = GetFieldValue(&quot;Asset Integration Id&quot;);
				}//end if firstrecord
			}//end with OrderLnItem BC
		}//end if OrderExist	
		if (sAssetIntgId != null &amp;&amp; sAssetIntgId != &quot;&quot;)
		{
			with (sBCAssetHdr)
			{	
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Integration Id&quot;);
				ActivateField(&quot;Value Band&quot;);
				SetSearchSpec(&quot;Integration Id&quot;,sAssetIntgId);
				ExecuteQuery(ForwardOnly);
				
				if (FirstRecord())
				{
					sValueBand = GetFieldValue(&quot;Value Band&quot;);
					// Mahend:25/06/10 : Added for R10.4
					if((sValueBand==&quot;&quot;) || (sValueBand == null))
					{
       					sValueBand = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;DEF_VALUE_BAND&quot;,&quot;VALUEBAND&quot;);
       				
					}//Ends
					this.SetFieldValue(&quot;VF Value Band&quot;, sValueBand);
				}//end if
			}//end with AssetHdr BC					
		}//end if AssetIntId
		
	  // 03/09/2012 SZK TD14653 : Start
	  if(strEaiFlg != &quot;Y&quot;)
	  {	
		  sShipType = this.GetFieldValue(&quot;Ship Via&quot;);
		  sCurrentId = this.GetFieldValue(&quot;Id&quot;);
	      mCheckShipmentType(sOrderId,sShipType,sCurrentId);
	  }      
      // 03/09/2012 SZK TD14653 : End

//		mCheckUpgradesShippingType()

	}//end if NewRecord
	
	
	// NEEL - CHANGES START
	var sNewShipAddrId = TheApplication().GetProfileAttr(&quot;TBUINewShippingAddrId&quot;);
	if(sNewShipAddrId != &quot;&quot;)
	{
		var sAccntId = this.GetFieldValue(&quot;Account Id&quot;);
		this.SetFieldValue(&quot;Ship To ID&quot;, sNewShipAddrId);
		this.WriteRecord();
		
		//Fetch Shipment Address BC with new address
		mQueryUpdateShipmentAddress(sNewShipAddrId);
		
	}
	
	//NEEL - CHANGES END
	
}//end try
catch(e)
{
	if (defined(e.errText))
	{
		var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
	}
	else
	{
		var strError = arguments.callee + ToString(e); 
	}
	throw (strError);
}
finally
{
	//sBCShip = null; /* This variable is nullified by Sharukh on 29/03/2019*/
	if(defined(sBCShip)) { sBCShip = null; } //Balamurugan 14/10/2019 - Nullified variable

	sBCOrdLnItem = null;
	sBCOrder = null;
	sBCAssetHdr = null;
	sBOOrder = null;

	


	TheApplication().SetProfileAttr(&quot;TBUINewShippingAddrId&quot;, &quot;&quot;);
}
	return (ContinueOperation);
}"
			   SEQUENCE="12"
