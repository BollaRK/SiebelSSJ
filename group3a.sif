			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="refreshScreen"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function refreshScreen()
{
/*
 * Component Name        : 	Order Entry - Line Items
 * Method Name           : 	refreshScreen
 * Component Information : 	Refreshes the screen to reflect changes to data.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 16/03/2005	PK						Initial Version
 * 05/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
 	var boOrderEntry;
	var bcTransfer;
 
	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:Order Entry - Line Items.refreshScreen&quot;); 
		}
		
		// Refresh the multiple line items by performing a query
		this.ExecuteQuery(ForwardBackward);			// ForwardBackward since in the UI


		// If the user is using Transfer Number Request, we also need to refresh this BC.
		if (TheApplication().ActiveViewName() == &quot;VF Order Entry - Pending Transfer Number Request View&quot;)
		{
			boOrderEntry = this.BusObject();
			bcTransfer = boOrderEntry.GetBusComp(&quot;VF Transfer Number Request&quot;);

			// Refresh the multiple records by performing a query
			bcTransfer.ExecuteQuery(ForwardBackward);						
		}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		bcTransfer = null;	
		boOrderEntry = null;

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;END:Order Entry - Line Items.refreshScreen&quot;);
		}
	}	
}"
