			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckShipmentType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckShipmentType(sOrderId,sShipType,sCurrentId)
{
/*
 * Component Name        : 	FS shipment
 * Function Name         : 	mCheckShipmentType
 * Component Information : 	Checks that there are not more than one shipping record for a type
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/09/2012	SZK		     TD14653     Initial Version.
 * 21/09/2012	VIVIND					Change the Status as CANCELLED from Cancelled
 */
try
	{
	    var strError;
	    var strReturn = ContinueOperation;
		var boShipAddr = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcShipAddr = boShipAddr.GetBusComp(&quot;FS Shipment&quot;);
		var searchst = &quot;[Primary Order Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Ship Via] = &apos;&quot; + sShipType + &quot;&apos; AND [Status] &lt;&gt; &apos;CANCELLED&apos; AND [Id] &lt;&gt; &apos;&quot;+ sCurrentId + &quot;&apos;&quot;;  

	
				with (bcShipAddr)
				{	
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Primary Order Id&quot;);
						ActivateField(&quot;Ship Via&quot;);
						/*SetSearchSpec(&quot;Primary Order Id&quot;, sOrderId);
						SetSearchSpec(&quot;Ship Via&quot;, sShipType);
						SetSearchSpec(&quot;Status&quot;, &quot;&lt;&gt; &apos;CANCELLED&apos;&quot;);*/
						SetSearchExpr(searchst);
						ExecuteQuery(ForwardOnly);
						
						if (FirstRecord())
						{
							 strError = TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;10196&quot;);
							 throw (strError);
							 strReturn = CancelOperation;
						}

				}
		
			
			return (strReturn);
	}
	catch(e)
	{
		if (!defined(e.errText))
		{
			TheApplication().RaiseErrorText(e.toString());
		}
		else
		{
			TheApplication().RaiseErrorText(e.errText);
		}
	}
	finally
	{
		bcShipAddr = null;
		boShipAddr = null;
	}
}"
			   SEQUENCE="3"
			   UPDATED="01/09/2026 22:35:23"
