			<BUSCOMP_SERVER_SCRIPT
			   COMMENTS="VF AG 24/08/09 added new for upgrade Shipment functionality"
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
/*
 * Component Name        : 	FS Shipment
 * Method Name           : 	BusComp_NewRecord
 * Component Information :  To set default Shipment Address to be as Primary Address of the parent Account,
 *							to set default Contact to be Primary Contact of the parent Account 
 *							and to Predefault Ship Via field based upon value of WBI Reason Code field value
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 30/08/2009	AGoenka		PR211		Initial Version
 * 06/10/2010	Nizam					Updated for R10.5 butterfly deferred fulfilment
 * 04/04/2011   DFiggis     R11.l       If Telesales Fufilment order set freight to zero.
 *
 */
try
{
	sNewRecord = &quot;Y&quot;;
	var LOVText = null;
	var searchst1 = &quot;&quot;;
	var sOrderSubType = &quot;&quot;,sOrderSubTypeTBUI = &quot;&quot;,sOrderFunctn = &quot;&quot;,sOrg = &quot;&quot;,sKoganOrg = &quot;&quot;,sNBNOrder = &quot;&quot;; //VHA NandhiniG 29/03/20 : Added for R20.1 - Shipment Address CR
	var sAcctId = this.GetFieldValue(&quot;VF Account Id&quot;);
	var psInputs2 = TheApplication().NewPropertySet();
	var psOutputs2 = TheApplication().NewPropertySet();
	psInputs2.SetProperty(&quot;System Preference Name&quot;, &quot;VF Shipment Freight&quot;);

	var bsGetSysPref = TheApplication().GetService(&quot;VF Get System Preference&quot;);
	bsGetSysPref.InvokeMethod(&quot;Get System Preference&quot;, psInputs2, psOutputs2);
	
	var sFrCharge = psOutputs2.GetProperty(&quot;System Preference Value&quot;);
	var nFrCharge = ToNumber(sFrCharge);
	var sOrderChannel = this.ParentBusComp().GetFieldValue(&quot;VF Order Channel&quot;);  //4/4/2011 DFiggis R11.1
	if (isNaN(nFrCharge) || TheApplication().GetProfileAttr(&quot;NoFreightCharge&quot;) == &quot;Y&quot;
		|| sOrderChannel == &quot;Telesales&quot;) 
		this.SetFieldValue(&quot;Freight Cost&quot;, 0);
	else
		this.SetFieldValue(&quot;Freight Cost&quot;, nFrCharge);		
		
	var LOVText = null;
	var sAddrId = this.GetFieldValue(&quot;Ship To ID&quot;);
	TheApplication().SetProfileAttr(&quot;CustomerAccountId&quot;,sAcctId);

	if(sAcctId != null &amp;&amp; sAcctId != &quot;&quot;)//Suresh G - 9/3/2020- MR01 - Capture Delivery Address CR
	{
		this.ParentBusComp().ActivateField(&quot;Order Sub Type&quot;);
		this.ParentBusComp().ActivateField(&quot;VF Order Type TBUI&quot;);
		this.ParentBusComp().ActivateField(&quot;VF Order Function&quot;);
		this.ParentBusComp().ActivateField(&quot;Organization&quot;);
		sOrderSubType = this.ParentBusComp().GetFieldValue(&quot;Order Sub Type&quot;);
		sOrderSubTypeTBUI = this.ParentBusComp().GetFieldValue(&quot;VF Order Type TBUI&quot;);
		sOrderFunctn = this.ParentBusComp().GetFieldValue(&quot;VF Order Function&quot;);
		sOrg = this.ParentBusComp().GetFieldValue(&quot;Organization&quot;);
		sKoganOrg = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORG_CONFIGURATION&quot;,sOrg);
		sNBNOrder = TheApplication().GetProfileAttr(&quot;VHAConnectFBB&quot;);
		if((sOrderSubType == &quot;Connect&quot; &amp;&amp; sKoganOrg != &quot;Y&quot; &amp;&amp; sNBNOrder != &quot;Y&quot; &amp;&amp; (sOrderSubTypeTBUI == &quot;New Connection&quot; || (sOrderSubTypeTBUI == &quot;&quot; || sOrderSubTypeTBUI == null))) || (sOrderFunctn == &quot;UPGRADE&quot; || sOrderFunctn == &quot;Upgrade&quot;) || sOrderSubTypeTBUI == &quot;New APP&quot;)
		{
			var sBO = TheApplication().GetBusObject(&quot;VHA Shipment Address&quot;);
			var sBC = sBO.GetBusComp(&quot;VHA Shipment Address&quot;);
			with(sBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Account Id&quot;);
				ActivateField(&quot;Shipment Address Id&quot;);
				ActivateField(&quot;End Date&quot;);			
				searchst1 = &quot;[Account Id] = &apos;&quot; + sAcctId + &quot;&apos; AND [End Date] IS NULL&quot;;
				SetSearchExpr(searchst1);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{
					sAddrId = GetFieldValue(&quot;Shipment Address Id&quot;);
				}
			}
		}
	}
	
	if (sAddrId != null &amp;&amp; sAddrId != &quot;&quot;)
	{
		var oBC = this.GetPicklistBusComp(&quot;VF Shipment Street Address&quot;); 
	   	with (oBC)
	   	{
	   		ClearToQuery();
			SetViewMode(AllView);	   		
			SetSearchSpec(&quot;Id&quot;, sAddrId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
				Pick();
	   	} 
	}

	var sConId = this.GetFieldValue(&quot;VF Ship To Contact Id&quot;);
	if (sConId != null &amp;&amp; sConId != &quot;&quot;)
	{
		var sBC = this.GetPicklistBusComp(&quot;VF Ship To Contact Last Name&quot;); 
	   	with (sBC)
	   	{
	   		ClearToQuery();
			SetViewMode(AllView);	   		
			SetSearchSpec(&quot;Id&quot;, sConId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
				Pick();
	   	} 
	}
/*
	var sWBIRsnCd = this.GetFieldValue(&quot;VF Order WBI Reason Code&quot;);
	if (sWBIRsnCd == &quot;Brightpoint&quot;)
		this.SetFieldValue(&quot;Ship Via&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_SHIPPING_METHOD&quot;,&quot;Hardware&quot;)); 
	else if (sWBIRsnCd == &quot;Pinpoint&quot;)
		this.SetFieldValue(&quot;Ship Via&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_SHIPPING_METHOD&quot;,&quot;Non-Device&quot;)); 
*/		
}//end try
catch(e)
{
	if (defined(e.errText))
	{
		var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
	}
	else
	{
		var strError = arguments.callee + ToString(e); 
	}
	throw (strError);

}

finally
{

   oBC = null;
   sBC = null;

/*Below variables are nullified by Sharukh on 29/03/2019*/
	psInputs2 = null;
	psOutputs2 = null;
	bsGetSysPref = null;

   
}
}"
			   SEQUENCE="8"
