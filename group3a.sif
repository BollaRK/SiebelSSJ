			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateEmail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateEmail(strEmail)
{
// Check for special characters in the email and throw a user friendly
// Error message. Replaces the Validation property

	try
	{
		if (strEmail.length &gt; 0)
		{		

			if (strEmail.indexOf(&quot;@&quot;) == -1 || strEmail.indexOf(&quot;.&quot;) == -1)
				throw(&quot;VFErrorCode#10517 The email address must include the characters @ and .&quot;);
		}
	}
	catch(e)
	{
		throw(e.toString());
	}
	finally
	{
	}
}"
