			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="oldUpdateNonPayingChildren"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function oldUpdateNonPayingChildren(inputs)
{	// REB - Not used so renamed to &apos;old&apos; - replaced with mUpdateNonPayingChildren as per defect # 6506
	//////////////////////////////////////////////////////////////////////////////
	// Description: This function will find the non-paying children accounts and  
	//              and set the Bill Frequency, Bill Cycle Day according to the
	//              parent.
	//
	// Inputs:		inputs.Account Id: 		The Parent Account Id.
	//              inputs.Bill Cycle Day   The Parent Bill Cycle Day
	//              inputs.Bill Frequency   The Parent Bill Frequency
	//////////////////////////////////////////////////////////////////////////////

	var accountId = inputs.GetProperty(&quot;Account Id&quot;);
	var billDay = inputs.GetProperty(&quot;Bill Cycle Day&quot;);
	var billFreq = inputs.GetProperty(&quot;Bill Frequency&quot;);
	var accountBO = TheApplication().GetBusObject(&quot;Account&quot;);
	var profileBC = accountBO.GetBusComp(&quot;Com Invoice Profile&quot;);
	var isRecord;
	
	profileBC.ActivateField(&quot;Parent Account Id&quot;);
	profileBC.ActivateField(&quot;Payment Method&quot;);
	profileBC.ActivateField(&quot;Bill Frequency&quot;);
	profileBC.ActivateField(&quot;Bill Cycle Day&quot;);
	profileBC.ActivateField(&quot;Account Id&quot;);
	profileBC.ClearToQuery();
	profileBC.SetSearchSpec(&quot;Parent Account Id&quot;, accountId);
	profileBC.SetSearchSpec(&quot;Payment Method&quot;, &quot;Non-Paying&quot;);
	profileBC.ExecuteQuery();
	
	isRecord = profileBC.FirstRecord();
	while (isRecord)
	{
		profileBC.SetFieldValue(&quot;Bill Cycle Day&quot;, billDay);
		profileBC.SetFieldValue(&quot;Bill Frequency&quot;, billFreq);
		accountId = profileBC.GetFieldValue(&quot;Account Id&quot;);
		// Once the WriteRecord() is invoke, the function will be invoked for the 
		// current child accound record to achieve the recurrsion automatically
		profileBC.WriteRecord();
		isRecord = profileBC.NextRecord();
	}
	
	profileBC = null;
	accountBO = null;
	
}"
