	<PROJECT
	   ALLOW_OBJECT_LOCKING="Y"
	   COMMENTS="VF - MKo 21/01/04 - Order Entry UI changes."
	   INACTIVE="N"
	   LANGUAGE_LOCKED="ENU"
	   LOCKED="Y"
	   LOCKED_DATE="09/03/2019 17:22:00"
	   NAME="VF Order (UI)"
	   UI_FREEZE="N"
	   LOCKED_BY_NAME="SADMIN"
	   UPDATED="09/03/2019 17:22:00"
	   UPDATED_BY="SADMIN"
	   CREATED="03/28/2014 15:46:03"
	   CREATED_BY="SADMIN"
	   FIO_PLACEHOLDER_FIO="TRUE">
		<BUSINESS_COMPONENT
		   CACHE_DATA="N"
		   CLASS="CSSBCBase"
		   COMMENTS="GJENA:12122025 Added for DFA"
		   DIRTY_READS="Y"
		   DISTINCT="N"
		   FORCE_ACTIVE="N"
		   GENREASSIGNACT="N"
