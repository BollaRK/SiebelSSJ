			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckUpgradesShippingType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckUpgradesShippingType()
{
/*
 * Component Name        : 	FS shipment
 * Function Name         : 	mCheckUpgradesShippingAddress
 * Component Information : 	Checks for Shipping details match Order Line Items products and there are not 
 *							more than one shipping record for a type
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/098/2009	AGOENKA				Initial Version.
 */
	try
	{
		var strOrderId = this.GetFieldValue(&quot;Primary Order Id&quot;);
		var strShipType = this.GetFieldValue(&quot;Ship Via&quot;);
		var strPrimProdLineItemId, strPrimProdId, strOfferPlanId,strOfferProdName,sErrMessage;
		var strCSRUpgradeFlag;
		var strWBIReasonCd = &quot;&quot;;
		var strAssetIntId, strAssetId, BPType, PPType;
		
		var DEVICE_PROD_NAME = &quot;Device&quot;;
		var NON_DEVICE_PROD_NAME = &quot;Other Item&quot;;
		var ACCESS_PROD_NAME = &quot;Accessory Item&quot;;
		var SHIPPING_METHOD_FIELD= &quot;Ship Via&quot;
		var BRIGHTPOINT_METHOD = &quot;Brightpoint&quot;;
		var PINPOINT_METHOD = &quot;Pinpoint&quot;;
		var strSearchExpr;


		var boAsset = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		var bcOffer = boAsset.GetBusComp(&quot;VF Upgrade Offer&quot;);
		var bcAsset = boAsset.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);

		var boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLineItems = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcFSShipment = boOrder.GetBusComp(&quot;FS Shipment&quot;);

		bcOrder.ClearToQuery();
		bcOrder.SetViewMode(AllView);
		bcOrder.SetSearchSpec(&quot;Id&quot;,strOrderId);
		bcOrder.ExecuteQuery();


		bcOrderLineItems.SetSearchExpr(&quot;[Parent Order Item Id] is null&quot;);
		bcOrderLineItems.ExecuteQuery();
		if (bcOrderLineItems.FirstRecord() != true)
		{		TheApplication().RaiseErrorText(&quot;There are no Upgrade Products added to Parent Order. Hence, you can not add a shipping address&quot;);
				return(CancelOperation);
		}
		else 
			strAssetIntId = bcOrderLineItems.GetFieldValue(&quot;Asset Integration Id&quot;);

		bcAsset.ClearToQuery();
		bcAsset.SetViewMode(AllView);
		bcAsset.SetSearchSpec(&quot;Integration Id&quot;,strAssetIntId);
		bcAsset.ExecuteQuery();
		if (bcAsset.FirstRecord())
			strAssetId = bcAsset.GetFieldValue(&quot;Asset Id&quot;);

		bcOffer.ClearToQuery();
		bcOffer.SetSearchSpec(&quot;Order Id&quot;,strOrderId);
		bcOffer.SetSearchSpec(&quot;Root Asset Id&quot;,strAssetId);
		bcOffer.ExecuteQuery(ForwardOnly);
		
		if (bcOffer.FirstRecord())
		{
			strCSRUpgradeFlag = bcOffer.GetFieldValue(&quot;CSR Upgrade Flag&quot;);
			
			if (strCSRUpgradeFlag == &quot;Y&quot;)
			{

				strSearchExpr = &quot;[Product] = &apos;&quot; + DEVICE_PROD_NAME + &quot;&apos; OR &quot;
							+ &quot;[Product] = &apos;&quot; + ACCESS_PROD_NAME + &quot;&apos;&quot;;

				bcOrderLineItems.SetSearchExpr(strSearchExpr);
				bcOrderLineItems.ExecuteQuery(ForwardOnly);
				
				if (bcOrderLineItems.FirstRecord() &amp;&amp; strShipType == BRIGHTPOINT_METHOD)
				{	BPType = true;
					bcFSShipment.ClearToQuery();
					bcFSShipment.SetViewMode(AllView);
					bcFSShipment.ActivateField(&quot;Primary Order Id&quot;);
					bcFSShipment.ActivateField(SHIPPING_METHOD_FIELD);
					bcFSShipment.SetSearchSpec(&quot;Primary Order Id&quot;,strOrderId);
					bcFSShipment.SetSearchSpec(SHIPPING_METHOD_FIELD,BRIGHTPOINT_METHOD);
					bcFSShipment.SetSearchSpec(&quot;Status&quot;,&quot;New&quot;);					
					bcFSShipment.ExecuteQuery();
					
					if (bcFSShipment.FirstRecord())
					{
						TheApplication().RaiseErrorText(&quot;There is already an existing Shipping record of same Shipping Type, under same Order. &quot; +
						+ &quot;You can not have 2 NEW shipping records with same type for same Order&quot;);
						return(CancelOperation);
					}
				}
				else
					BPType = false;
										
				bcOrderLineItems.SetSearchSpec(&quot;Product&quot;,NON_DEVICE_PROD_NAME);
				bcOrderLineItems.ExecuteQuery();
				
				if (bcOrderLineItems.FirstRecord() &amp;&amp; strShipType == PINPOINT_METHOD)
				{
					PPType = true;
					bcFSShipment.ClearToQuery();
					bcFSShipment.SetViewMode(AllView);
					bcFSShipment.ActivateField(&quot;Primary Order Id&quot;);
					bcFSShipment.ActivateField(SHIPPING_METHOD_FIELD);
					bcFSShipment.SetSearchSpec(&quot;Primary Order Id&quot;,strOrderId);
					bcFSShipment.SetSearchSpec(SHIPPING_METHOD_FIELD,PINPOINT_METHOD);
					bcFSShipment.SetSearchSpec(&quot;Status&quot;,&quot;New&quot;);										
					bcFSShipment.ExecuteQuery();
					
					if (bcFSShipment.FirstRecord())
					{
						TheApplication().RaiseErrorText(&quot;There is already an existing Shipping record of same Shipping Type, under same Order. &quot; +
						+ &quot;You can not have 2 NEW shipping records with same type for same Order&quot;);
						return(CancelOperation);
					}
					
				}
				else
					PPType = false;

//				if (BPType == false &amp;&amp; PPType == false)
//				{
//					TheApplication().RaiseErrorText(&quot;The value of Shipping type is not matching with the Upgrade Product on the parent Order. Please &quot; +
//					+ &quot;select different value for Shipping Type&quot;);
//					return(CancelOperation);
//				}
				
			}
		}

	}
	catch(e)
	{
		if(defined(e.errText))
		{
			gErrorMessage = &quot;VFErrorCode#09115 &quot; + arguments.callee + e.errText + &quot;/r/n&quot; + ToString(e);
		}
		else
		{
			gErrorMessage = &quot;VFErrorCode#09115 &quot; + arguments.callee + ToString(e);
		}

		throw(gErrorMessage);
	}
	finally
	{

/*Below variables are nullified by Sharukh on 29/03/2019*/

bcOffer = null;
bcAsset = null;
bcOrder = null;
bcOrderLineItems = null;
bcFSShipment = null;
boAsset = null;
boOrder = null;


	} 
}"
