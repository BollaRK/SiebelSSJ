			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
/*************************************************************************************
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_NewRecord
 * Component Information :	Gets the MVG  and realted Associate BC
 *							behind the Primary Contact Last Name field and 
 *							then queries the Associate BC for Parent Primary Contact Id.
 *							If a record is returned it invokes the 
 *							Associate method to create a billing account contact record
 *							contact record  contact record for the billing account using 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/05/2005	TAlihos					Initial Version Created to resolve W2 defect 
 * 15/07/2005	RP						Set gNewFlag to indicate that this is a new record						
 /************************************************************************************/
	try
	{
		
		
		//*******************************
		/* Declare Objects
		//*******************************/
		var bcContactMVG;
		var ContactMVGAssocBC;
		var bcParent;
	
		//*******************************
		/* Declare variables
		//*******************************/
		var strPrimaryConId;
		var strPARENTNAME = &apos;Account&apos;;
		
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_NewRecord&quot;);
		}
		
		
		// Lets setup parent BC and check to see if
		//it&apos;s in the correct context.
		bcParent = this.ParentBusComp();
	
		if (bcParent.Name() == strPARENTNAME)
		{
		
			
			var sCustName = this.ParentBusComp().GetFieldValue(&quot;Name&quot;);
			
			//02/07/2015 : Mahesh : Below If condition based on Customer Name added for PKE 19301 with customer approval.
			if(sCustName != &quot;EXPIRED NUMBER&quot;)
		{
			// set New flag
			gNewFlag = true;
			
			// If we are in the correct context we can set 
			// up our vairables
			strPrimaryConId = bcParent.GetFieldValue(&quot;Primary Contact Id&quot;);
			
			//Now lets see if parent has a primary contact?
			if (strPrimaryConId != &quot;&quot; &amp;&amp; strPrimaryConId != &quot;No Match Row Id&quot; &amp;&amp; strPrimaryConId != null)
			{
				//Set MVG object
				bcContactMVG = this.GetMVGBusComp(&quot;Primary Contact Last Name&quot;);
				
				//Now the we have our MVG lets get our Associate BC						
				ContactMVGAssocBC = bcContactMVG.GetAssocBusComp();
			
				//Now lets find the contact record which we so desired to Associate
				ContactMVGAssocBC.ClearToQuery();
				ContactMVGAssocBC.SetViewMode(AllView);
				ContactMVGAssocBC.SetSearchSpec(&quot;Id&quot;, strPrimaryConId);
				ContactMVGAssocBC.ExecuteQuery();
				
				//If our query returns a Contact
				if(ContactMVGAssocBC.FirstRecord())
				{
					try
					{
						//Now we are picking the record from MVG BC
						ContactMVGAssocBC.Associate(NewAfter);
					}
					catch(e)
					{
						throw (e.errText);
					}
				}
			}
			}
		}
	}
	catch (e)
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_NewRecord&quot;);
		}
	
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	TheApplication().RaiseErrorText(strErrorMessage);
		
	
	}
	finally
	{
	
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_NewRecord&quot;);
		}
	
		//*************************************
		//* Destroy Objects
		//*************************************
		bcParent = null;
		bcContactMVG = null;	
		ContactMVGAssocBC	= null;

	}	
}"
			   SEQUENCE="7"
			   UPDATED="09/18/2015 07:37:56"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:46"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
/*
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_PreInvokeMethod
 * Component Information :	Allows the user to invoke the mSyncAccount() method to 
 *							create a new Billing or Synchronise account   
 *							externals systems . 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 20/01/2005	TAlihos						Initial Version
 */

	try
	{	
		//************************************
		//* Declare Variables
		//************************************
		
		var sIntReturn = CancelOperation;
		var strCONSTBAPREPAY  = &apos;Prepay&apos;;
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_PreInvokeMethod&quot;);
		}
		
		//************************************
		//check to see if metho being 
		//invoked is mSyncAccount if
		//so then call function
		//************************************
		if (MethodName == &quot;mSyncBillingAccount&quot;)
		{
			mSyncBillingAccount();
		}
		if (MethodName == &quot;IsActive&quot;)
		{
			return(ContinueOperation);	
		}
		return(sIntReturn);	
		
		if (MethodName == &quot;ShowPopup&quot;)	
		{
			return(sIntReturn);
		}	
		if (MethodName == &quot;VFPayBill&quot;)	
		{
			return(sIntReturn);
		}
		if (MethodName == &quot;mAuthentication&quot;)	
		{
			return(sIntReturn);
		}
		
		
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	
     	//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_PreInvokeMethod.strErrorMessage= &quot; + strErrorMessage);
		}
     	var strDisplayError = ErrorHandling(strErrorMessage, &quot;BusComp_PreInvokeMethod&quot;);
     	TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_PreInvokeMethod&quot;);
		}
	}
}"
			   SEQUENCE="8"
			   UPDATED="09/30/2022 17:58:24"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:46"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreNewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreNewRecord ()
{
/*************************************************************************************
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_PreNewRecord
 * Component Information :	DF6081 requires validation for new BA
 * 							having an address associated with the parent CA.
 *							It is assumed that there will be a primary address
 *							against the CA.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 19/02/2008	VL			DF6081		Initial version created to resolve defect
 * 21/02/2008	VL			DF7410		Needs to exclude billing account created by WF
/************************************************************************************/
	try
	{
		
		
		//*******************************
		/* Declare Objects
		//*******************************/
		var bcParent;
	
		//*******************************
		/* Declare variables
		//*******************************/
		var strPrimaryAddrId = null;
		var strPARENTNAME = &quot;Account&quot;;
		var strNoValidate = &quot;&quot;;
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
		
		//The profile attribute is set to TRUE by VF OM New Account Creation called by WF
		strNoValidate = TheApplication().GetProfileAttr(&quot;VFBulkBAAddrNoValidation&quot;);
		
		// Lets setup parent BC and check to see if it&apos;s in the correct context.
		bcParent = this.ParentBusComp();
	
		if (bcParent.Name() == strPARENTNAME)
		{
			if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			{
				TheApplication().Trace(&quot;VF Billing Account.BusComp_PreNewRecord: No Validation attribute is &quot; + strNoValidate);
			}
			if (strNoValidate != &quot;TRUE&quot;)
			{
				// If we are in the correct context we can set up our vairables
				strPrimaryAddrId = bcParent.GetFieldValue(&quot;Primary Address Id&quot;);
				if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
				{
					TheApplication().Trace(&quot;VF Billing Account.BusComp_PreNewRecord: Primary Address Id is &quot; + strPrimaryAddrId);
				}
				// Validate if parent has a primary address
				if (strPrimaryAddrId == &quot;&quot; 
					|| strPrimaryAddrId == null 
					|| strPrimaryAddrId.toUpperCase() == &quot;NO MATCH ROW ID&quot;)
				{
					TheApplication().RaiseErrorText(&quot;Address is missing in Customer Account.&quot;);
					throw &quot;Address is missing in Customer Account&quot;;
				}
			}
		}
	}
	catch (e)
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
	
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	TheApplication().RaiseErrorText(strErrorMessage);
	}
	finally
	{
	
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
	
		//*************************************
		//* Destroy Objects
		//*************************************
		bcParent = null;
		strNoValidate = null;
		strPrimaryAddrId = null;
		strPARENTNAME = null;
	}
}"
			   SEQUENCE="9"
			   UPDATED="03/28/2014 21:45:46"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:46"
