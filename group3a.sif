			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckPaymentMethodType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckPaymentMethodType()
{
/*
 * Component Name        : 	Com Invoice Profile
 * Method Name           : 	mCheckPaymentMethodType
 * Component Information : 	Checks to see if the Payment method type is allowed
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/05/2010	DFiggis		R10.3 CA    Added for VHA Credit Approval.
 */
   	try
   	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.mCheckPaymentMethodType&quot;);
		}   	
   	
   		//Validate to ensure Payment Method is allowed	
	   	var svc = TheApplication().GetService(&quot;VF Credit Fraud Check Toolkit Service - VHA&quot;);

		var Inputs = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();
		
		var strCAId = this.GetFieldValue(&quot;Master Account Id&quot;);
		var strPayType = this.GetFieldValue(&quot;Payment Type&quot;);
		Inputs.SetProperty(&quot;Customer Account Id&quot;, strCAId);		
		Inputs.SetProperty(&quot;Payment Type&quot;, strPayType);
		
		svc.InvokeMethod(&quot;Check Billing Payment Method&quot;, Inputs, Outputs);
		
		var strIsValid = Outputs.GetProperty(&quot;Is Valid Payment Type&quot;);
		if (strIsValid == &quot;N&quot;)
		{
			//throw(&quot;VFErrorCode#09118 - The Billing Profile Payment Type seleted is not allowed for this customer.  Please choose another Payment Type.&quot;);
			//VF: Roseline 20/08/2014 - Changed the error message similar to that in Merlin for QC Defect#1875
			throw(&quot;New customers are not allowed to have a payment type of &apos;Other&apos;. Please modify the payment type field.&quot;);
			
		}
				   		
		return (ContinueOperation);
	}
	catch(e)
	{
	//VF:Roseline 21/08/2014 - Commented the code for suppressing the &apos;Compiled function&apos; in the error message for defect#1875
		/*var strError = &quot;&quot;;
		
		if (defined(e.errText))
		{
			strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
		}
		else
		{
			strError = arguments.callee + ToString(e); 
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.mCheckPaymentMethodType.strError= &quot; + strError);
		}
		
		throw(strError); */
		
		
			throw (e); //VF:Roseline 21/08/2014 - Added for defect# 1875
     	
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.PreWriteRecord&quot;);
		}
		
		svc = null;
		Inputs = null;
		Outputs = null;
		
	}	
}"
