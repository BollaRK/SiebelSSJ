				</FIELD_USER_PROP>
			</FIELD>
			<FIELD
			   CALCULATED="Y"
			   CALCULATED_VALUE="IIf(([LOY Override Price Flag] = &apos;Y&apos; OR [LOY Bid Flag] = &apos;Y&apos;),IfNull([LOY Points Used Total],[LOY Points Total]), IfNull([LOY Points Total],[LOY Points Max Total]))"
			   COMMENTS="This field is introduced because the value of Points field in LOY Transaction will derive value from this. This can be either LOY Points Used Total or LOY Points Total or LOY Points Max Total. If either of Override Price Flag or Bid Flag is Y (actually Override Price Flag should be Y whenever Bid Flag is Y) , it is the non-null value between LOY Points Used Total and LOY Points Total, otherwise it would be the non-null value between LOY Points Total and LOY Points Max Total. This is so because if override Price Flag is Y (in case of bid, points to pay conversion or manual override in case of Member services), the value entered in Points field in Transaction will be the actual value charged to the member. If Override Price Flag is not Y, there are two cases. The quote could have been created from Employee facing UI or not. In the first case, currently override price flag is not set to Y even if the user changes the points value after choosing a record from LOY Product Points. In this case, LOY Points Total should be taken. If the quote is not created through Employee facing UI, LOY Points Total will be null. Hence LOY Points Max Total should be taken and populated in the Transaction since Promotions would act upon this price and are expected to charge LOY Points Used Total(the simulated value)."
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="N"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="N"
			   INACTIVE="N"
			   LINK_SPECIFICATION="N"
			   MESSAGE_DISPLAY_MODE="User Msg with Error Code Only"
			   MULTI_VALUED="N"
			   NAME="LOY Points Txn Total"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   TYPE="DTYPE_NUMBER"
			   USE_DEFAULT_SENSITIVITY="Y"
			   UPDATED="06/10/2014 00:41:16"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2014 00:41:16"
			   CREATED_BY="SADMIN">
				<FIELD_USER_PROP
				   INACTIVE="Y"
				   NAME="Required"
				   VALUE="[LOY Flag] = &quot;Y&quot;"
				   UPDATED="06/10/2014 00:41:16"
				   UPDATED_BY="SADMIN"
				   CREATED="06/10/2014 00:41:16"
				   CREATED_BY="SADMIN">
				</FIELD_USER_PROP>
			</FIELD>
			<FIELD
			   CALCULATED="N"
			   COLUMN="POINTS_USED"
			   COMMENTS="If Override Price Flag = Y, this will have the TOTAL Points value after override/Points to Pay conversion/Bid. Otherwise, it will have the total simulated value in Points. This is the actual total value that would be charged to the member"
			   COMPOSITE="N"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="N"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="N"
			   INACTIVE="N"
