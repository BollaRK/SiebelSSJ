			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Account
 * Method Name           : 	BusComp_ChangeRecord
 * Component Information : 	Standard 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/02/2005	VLim					Initial
 * 23/09/2005	FK 						extra initialization for global variables def #6846
 * 12/10/2005	FK 						extra initialization commneted as create other problems def #7442
 * 27/06/06		RP			Defect15054 Added gAccountingType;
 */
function BusComp_ChangeRecord ()
{
	try
	{
		gBillMedia = this.GetFieldValue(&quot;Media Type&quot;);
		gNewMediaType = this.GetFieldValue(&quot;Media Type&quot;);
		gOldMediaType = this.GetFieldValue(&quot;Media Type&quot;);
		gPresentment = this.GetFieldValue(&quot;Presentment&quot;);
		gSuspendPayment = this.GetFieldValue(&quot;Suspend Payment&quot;);
		gMandatoryPayment = this.GetFieldValue(&quot;Mandatory Payment&quot;);
		gOldAccountingType = this.GetFieldValue(&quot;Accounting Type&quot;);
		gNewAccountingType = this.GetFieldValue(&quot;Accounting Type&quot;);
		gOldBillFormat = this.GetFieldValue(&quot;Bill Format&quot;);
		gNewBillFormat = this.GetFieldValue(&quot;Bill Format&quot;);
		
		//Added for TIR 08
		if(this.ParentBusComp() != null &amp;&amp; this.ParentBusComp() != &quot;&quot;)
   		{
			if(this.ParentBusComp().Name() == &quot;VF Billing Account TBUI&quot; || this.ParentBusComp().Name() == &quot;VF Billing Account&quot;)
			{
					this.ParentBusComp().ActivateField(&quot;VF Customer Type&quot;);
					var sCustType = this.ParentBusComp().GetFieldValue(&quot;VF Customer Type&quot;);
					TheApplication().SetProfileAttr(&quot;sCustType&quot;,sCustType);
			}
		}
		
	}
	catch (e)
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
	TheApplication().SetProfileAttr(&quot;BillProfileNew&quot;,&quot;N&quot;);
		// nothing
	}

}"
			   SEQUENCE="26"
			   UPDATED="11/01/2018 14:02:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
