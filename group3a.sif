			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
/*
 * Component Name        : 	Order Entry - Line Items
 * Method Name           : 	BusComp_PreInvokeMethod
 * Component Information : 	Triggers functions based on this bus comp.
 *							Methods are mostly supported using User Properties
 *							but extra code to support enabling/disabling of 
 *							buttons, record refreshs &amp; error handling is here.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 16/03/2005	PK			W2			Initial Version
   4/8/2014     MURALIDHARANK           Added the Deallocate IMEI from BC userproperty to Script PreInvoke
 */
	// Error Handling declarations
	var psErrorInput;
	var psErrorOutput;
	var bsError;	
	var strError = &quot;&quot;;

	// Return value
	var iReturnValue;

	try
	{
		// trace stmt - exclude IsActive since WebApplet_PreCanInvoke calls it a billion times
		if ((TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) &amp;&amp; (MethodName != &quot;IsActive&quot;))
		{
			TheApplication().Trace(&quot;START:Order Entry - Line Items.PreInvokeMethod.MethodName=&quot; + MethodName);
		}		

		switch (MethodName)
		{
		
			case &quot;ReconfigureCxProd&quot;: //Subramanian 30SEP2014: added the code to update configuration status
					this.SetFieldValue(&quot;VF Configuration Status&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CONFIG_STATUS&quot;, &quot;Customized&quot;));
					this.WriteRecord();
					break;   
			// Requests that run workflows need a refresh record to display the changes they make
			case &quot;DeallocateNewMSISDN&quot;:
			    mDeallocateMSISDN();
			   	iReturnValue = CancelOperation;
				/*try
				{
					refreshScreen(); 
					//this.WriteRecord();
					this.InvokeMethod(MethodName + &quot;OK&quot;);
					refreshScreen();
					iReturnValue = CancelOperation;
				}
				catch(e)
				{
					refreshScreen();
					throw (e);
				}*/
				break;
				case &quot;DeallocateSIM&quot;:
				try
				{
				 
					//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
					mDeallocateSIM();
					var psInputs,psOutputs,bsInvokeBS;
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;OrderLineItemId&quot;, this.GetFieldValue(&quot;Id&quot;));
					bsInvokeBS = TheApplication().GetService(&quot;VF Postpay Utilities TBUI&quot;);
					refreshScreen();
					bsInvokeBS.InvokeMethod(&quot;NullifySIM&quot;, psInputs, psOutputs);
				//this.SetFieldValue(&quot;VF SIM TBUI&quot;,&quot;&quot;);*/
					refreshScreen();
					iReturnValue = CancelOperation;
				}	
				catch(e)
				{
					throw (e);
				}
				break;
				
				case &quot;DeallocateIMEI&quot;:
			
				try
				{
					 
					TheApplication().SetProfileAttr(&quot;TBUIDEALLOCATEIMEI&quot;,&quot;Y&quot;);
					var psInputs,psOutputs,bsInvokeWorkflow;
		            psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM DeAllocate IMEI TBUI&quot;);
					psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
					psInputs.SetProperty(&quot;Order Line Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
					psInputs.SetProperty(&quot;RootOrderItemId&quot;, this.GetFieldValue(&quot;Root Order Item Id&quot;));
					bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
					refreshScreen();
					bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);	
					refreshScreen();
					iReturnValue = CancelOperation;
				}
				catch(e)
				{
					throw (e);
				}
					
				break;	
		
			
			default:
				iReturnValue = ContinueOperation;
			break;
		}		
		return (iReturnValue);
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			strError = arguments.callee + ToString(e); 
		}

		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Order Entry - Line Items BC&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_PreInvokeMethod&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		psErrorInput = null;
		psErrorOutput = null;
		bsError = null;
	/*Below variables are nullified by JAGJIT on 25/03/2019*/
		/*psInputs = null;
		psOutputs = null;
		bsInvokeWorkflow = null;
		bsInvokeBS = null;*/

           /*Below variables are nullified by BALAGURU on 03/10/2019*/
          if(defined(psInputs)) { psInputs = null; }
		  if(defined(psOutputs)) { psOutputs = null; }
		  if(defined(bsInvokeWorkflow)) { bsInvokeWorkflow = null; }
		  if(defined(bsInvokeBS)) { bsInvokeBS = null; } 

		if ((TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) &amp;&amp; (MethodName != &quot;IsActive&quot;))
		{
			TheApplication().Trace(&quot;END:Order Entry - Line Items.PreInvokeMethod.MethodName=&quot; + MethodName + &quot; strError=&quot; + strError);
		}
	}
}"
			   SEQUENCE="9"
			   UPDATED="10/05/2019 02:32:13"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2014 00:40:44"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	try
	{	
		switch (FieldName)
		{
			//TARIQ-02SEP2014-Retrofitted-Commented since the validation is already handled in CreateTNRRequest function
			/*case &quot;VF TNR Id&quot;:
				try
				{
					var bsValidate,psIn,psOut;
					var sRowId = this.GetFieldValue(&quot;Id&quot;);
					var strOldTNRId = this.GetFieldValue(&quot;VF TNR Id&quot;);
					var sOrderHeaderId = this.GetFieldValue(&quot;Order Header Id&quot;);
					bsValidate = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
					psIn = TheApplication().NewPropertySet();
					psOut = TheApplication().NewPropertySet();
					psIn.SetProperty(&quot;LineItemId&quot;, sRowId);
					psIn.SetProperty(&quot;OrderId&quot;, sOrderHeaderId);
					psIn.SetProperty(&quot;TNRId&quot;, FieldValue);
					psIn.SetProperty(&quot;OldTNRId&quot;, strOldTNRId);
					bsValidate.InvokeMethod(&quot;ValidateLineItems&quot;, psIn, psOut);
					sRefresh = &quot;Y&quot;;
					break;
				}
				catch(e)
				{
					throw(e);
				}
				finally
				{
					psIn = null;
					psOut = null;
					bsValidate = null;
				}*/
			case &quot;VF IMEI TBUI&quot;:
			if(FieldValue != null &amp;&amp; FieldValue != &quot;&quot;)
			{
						var psInputs,psOutputs,bsInvokeWorkflow;
						var psErrorInput;
						var psErrorOutput;
						var bsError;	
						var strError = &quot;&quot;;
						var strErrorMsg=&quot;&quot;;
			            psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Allocate IMEI TBUI&quot;);
						psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;OLI Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;IMEI&quot;, FieldValue);
						bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
						strErrorMsg = psOutputs.GetProperty(&quot;Error Message&quot;);
						if(strErrorMsg != &quot;&quot;)
						{
							TheApplication().RaiseErrorText(strErrorMsg);
						}
			}		
						return(ContinueOperation);
				break;
		
		case &quot;VF SIM TBUI&quot;:
		
				try
					{
						if(FieldValue != null &amp;&amp; FieldValue != &quot;&quot;)
					{
						var psInputs,psOutputs,bsInvokeBS,strNewSIMId,psInp;
						var psErrorInput;
						var psErrorOutput;
						var bsError;	
						var strError = &quot;&quot;;
						var strsimstatus =&quot;&quot;;
						//TheApplication().SetProfileAttr(&quot;IsDedicated&quot;,&quot;FALSE&quot;);
			            psInputs = TheApplication().NewPropertySet();
			            psInp = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;Root Order Item Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						//psInputs.SetProperty(&quot;SIM&quot;, FieldValue);
						var sSIMValue = FieldValue; //Selva#13/09/2014 Defect#2135
					  	if (sSIMValue.length == 10)
							{			
							var boSystemPref = TheApplication().GetBusObject(&quot;System Preferences&quot;);  
				   			var bcSystemPref = boSystemPref.GetBusComp(&quot;System Preferences&quot;);
				   			var strValue =&quot;&quot;;
			       			with (bcSystemPref)
				   				{
				    				ClearToQuery();
				    				ActivateField(&quot;Name&quot;);
				    				ActivateField(&quot;Value&quot;);
				    				SetViewMode(AllView);
				    				SetSearchSpec(&quot;Name&quot;,&quot;VF SIM Prefix Value&quot;);
				    				ExecuteQuery(ForwardOnly);
				    				if(FirstRecord())strValue = GetFieldValue(&quot;Value&quot;);    
				  				}		
								sSIMValue = strValue + sSIMValue;
								//this.SetFieldValue(&quot;VF SIM TBUI&quot;,sSIMValue);								
							   }
						if(TheApplication().GetProfileAttr(&quot;VFReuseModemFlg&quot;) == &quot;&quot;)//SakthiR Added for reuse modem 
						{
							psInputs.SetProperty(&quot;SIM&quot;, sSIMValue);
							bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
							bsInvokeBS.InvokeMethod(&quot;CheckSIMOnExistingOrder&quot;, psInputs, psOutputs);
							psInputs.Reset();
							psOutputs.Reset();
							bsInvokeBS = TheApplication().GetService(&quot;VF OM Query SIM Details&quot;);
							psInputs.SetProperty(&quot;ARII&quot;, &quot;Australia&quot;);
							//psInputs.SetProperty(&quot;New Serial Number&quot;, FieldValue);
							psInputs.SetProperty(&quot;New Serial Number&quot;, sSIMValue);//Selva#13/09/2014 Defect#2135
							psInputs.SetProperty(&quot;Service Provider&quot;, &quot;Vodafone AU&quot;);
							bsInvokeBS.InvokeMethod(&quot;QuerySIMDetails&quot;, psInputs, psOutputs);
							strsimstatus = psOutputs.GetProperty(&quot;Status&quot;);
							//MURALIDHARANK 15/09/2014 Defect 2427 Check on Existing SIM Status
							//if((strsimstatus == &quot;Received&quot;) || (strsimstatus == &quot;Cancelled&quot;)) //VF:Roseline 10/10/2014 - Removed for INC000010657283
							if((strsimstatus == &quot;Received&quot;) || (strsimstatus == &quot;Available&quot;)) //VF:Roseline 10/10/2014 - Added for INC000010657283
							{
								psInp = psOutputs.Copy();
								psInputs.Reset();
								psOutputs.Reset();
								bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
								bsInvokeBS.InvokeMethod(&quot;CreateNewSIMAndIMSI&quot;, psInp, psOutputs);
								strNewSIMId = psOutputs.GetProperty(&quot;SIM Id&quot;);
								psInputs.Reset();
								psOutputs.Reset();
								bsInvokeBS = TheApplication().GetService(&quot;VF OM New Resource Creation&quot;);
								psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
								psInputs.SetProperty(&quot;New SIM Id&quot;, strNewSIMId);
								psInputs.SetProperty(&quot;Root Line Item Id&quot;,this.GetFieldValue(&quot;Root Order Item Id&quot;));
								bsInvokeBS.InvokeMethod(&quot;SetLineItemNewSIMAndIMSI&quot;, psInputs, psOutputs);
							}	
							else
							{
								//strError=&quot;SIM is not available for allocation&quot;;
								//Neel 07.10.2014 - Change Error Message
								strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
								TheApplication().RaiseErrorText(strError);
							}
						}
					}
						return(ContinueOperation);
					}
					catch(e)
					{
						if((strError !=null) &amp;&amp; (strError !=&quot;&quot;))
						{
							//throw(e);
							strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
							TheApplication().RaiseErrorText(strError);
						}
						else
					{
						strError=&quot;INF Error- The entered SIM is either not found, or not in the correct status to be allocated.  Please try a different SIM number&quot;
						strError = ToString(e);
						psErrorInput  = TheApplication().NewPropertySet();
						psErrorOutput = TheApplication().NewPropertySet();
						bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
						psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Order Entry - Line Items BC&quot;);
						psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_PreSetField&quot;);
						psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
						bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
						strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
						TheApplication().RaiseErrorText(strError);
					}
					}
					finally
					{
						psInputs=null;
						psOutputs=null;
						bsInvokeBS=null;
						psErrorInput=null;
						psErrorOutput=null;
						psInp=null;
						bsError=null;
					}
				
			break;
			
		/*case &quot;VF MSISDN TBUI&quot;:
		
				try
					{
						var psInputs,psOutputs,bsInvokeWorkflow;
						var psErrorInput;
						var psErrorOutput;
						var bsError;	
						var strError = &quot;&quot;;
			            psInputs = TheApplication().NewPropertySet();
						psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF Allocate IMEI TBUI&quot;);
						psInputs.SetProperty(&quot;Object Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;OLI Id&quot;, this.GetFieldValue(&quot;Id&quot;));
						psInputs.SetProperty(&quot;Order Id&quot;, this.GetFieldValue(&quot;Order Header Id&quot;));
						psInputs.SetProperty(&quot;IMEI&quot;, this.GetFieldValue(&quot;VF IMEI TBUI&quot;));
						bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
						//psOutputs().SetProperty(&quot;IMEIRecords&quot;);
						return(ContinueOperation);
					}
					catch(e)
					{
						strError = ToString(e);
						psErrorInput  = TheApplication().NewPropertySet();
						psErrorOutput = TheApplication().NewPropertySet();
						bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
						psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Order Entry - Line Items BC&quot;);
						psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;BusComp_PreSetField&quot;);
						psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
						bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
						strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
						TheApplication().RaiseErrorText(strError);
					}
					finally
					{
						psInputs=null;
						psOutputs=null;
						bsInvokeWorkflow=null;
						psErrorInput=null;
						psErrorOutput=null;
						bsError=null;
					}
				
			break;*/
		
		
		}
		return (ContinueOperation);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		
		/*bcSystemPref = null;
		boSystemPref = null;
		bsInvokeWorkflow = null;*/

        
        /* Below variables are nullified by BALAGURU on 03/10/2019*/
		if(defined(bcSystemPref)) { bcSystemPref = null; }
		if(defined(boSystemPref)) { boSystemPref = null; }
		if(defined(bsInvokeWorkflow)) { bsInvokeWorkflow = null; }


	}
}"
