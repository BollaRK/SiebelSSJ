			<FIELD
			   CALCULATED="N"
			   COLUMN="LOY_NUM_POINTS"
			   COMMENTS="This field will be populated only when a quote is created from UI. In this case, if a record is picked from LOY Picklist Product Points, this field will hold the same value as LOY Points Max. After this, the value may be overridden by the user. Hence it will either contain the base points value or overriden value - both per quantity."
			   COMPOSITE="N"
			   DISABLE_SEARCH="N"
			   DISABLE_SORT="N"
			   FORCE_ACTIVE="N"
			   HIDDEN="N"
			   IMMEDIATE_POST_CHANGES="Y"
			   INACTIVE="N"
			   JOIN="S_ORD_ITM_LOYX"
			   LINK_SPECIFICATION="N"
			   MESSAGE_DISPLAY_MODE="User Msg with Error Code Only"
			   MULTI_VALUED="N"
			   NAME="LOY Points"
			   NO_COPY="N"
			   READ_ONLY="N"
			   REQUIRED="N"
			   TYPE="DTYPE_NUMBER"
			   USE_DEFAULT_SENSITIVITY="Y"
