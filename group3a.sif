			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckSyncUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	Com Invoice Profile
 * Method Name           :	BusComp_SyncAccount
 * Component Information :	If any of the fields below have changed set the
 *							UserProp indicator - used in WriteRecord.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/01/2005	MSL						Initial Version
 * 10/02/2005	TAlihos					Update to include the Partner BC field as a 
 *										trigger field for and Account Sync Update transaction
 * 13/04/2005 	JSK						Added Payment Term
 * 16/06/2005	JSK						Defect 2923. When payment Type is VCC, it should not trigger off
 *										Account Sync. (It should check if CCP RegId is checked first)
 * 10/10/2008	SAHUSUS					Added code to make Bill Charges Override field sync enabled. 
 * 08/07/2009	NP						Defect 9686. Added code to include two more additional fields
 */
 function mCheckSyncUpdate(strFieldName)
{
	try
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.mCheckSyncUpdate&quot;);
		}
		switch (strFieldName)
		{
			case &quot;Media Type&quot;:
			case &quot;Presentment&quot;:
			case &quot;Suppress Paper&quot;:
			case &quot;Include Call Details&quot;:
			case &quot;Notification Method&quot;:
			case &quot;Email&quot;:
			case &quot;Payment Term&quot;:
			case &quot;MSISDN For TXT&quot;:
			case &quot;Suspend Payment&quot;:
			case &quot;Bill Format&quot;:
			case &quot;CCP Reg Id&quot;:
			case &quot;Credit Card Type&quot;:
			case &quot;Credit Card Number&quot;:
			case &quot;Credit Card Name&quot;:
			case &quot;Expiration Month&quot;:
			case &quot;Expiration Year&quot;:
			case &quot;Bank Account Name&quot;:
			case &quot;Bank Branch&quot;:
			case &quot;Bank Account Number&quot;:
			case &quot;Direct Debit Reference&quot;:
			case &quot;Accounting Type&quot;:
			case &quot;VF Detailed Data Usage&quot;:
			// Added by NP - 28/07/2009 for Defect 9686
			//TAlihost - 10/02/2005 Added to trigger Account Sync 
			//Update transaction
			case &quot;Partner&quot;:
			//BARAS - 05/06/08 Added for EBP.
			case &quot;Email Bill To&quot;:
			case &quot;Validity Status&quot;:
				this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
				break;
			//SAHUSUS - 10/10/2008 Added for PCR4
			case &quot;Bill Charges Override&quot;:
			    this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
			    break;
			case &quot;VHA Delivery Method Calc&quot;:
			    this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
			    break; 
            case &quot;Bill Charges Override Reason&quot;:
			   this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
			    break; 
            
			//JSK - 16/06/2005 If Payment Type is VCC, it should check CCP RegId before 
			// sending info to Infranet
			case &quot;Payment Type&quot;:
			{
				if(this.GetFieldValue(&quot;Payment Type&quot;) != &quot;VCC&quot;)
					this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
			}
				break;
			default:
				break;
		}
	}
	catch (e)
	{
		throw (e);
	}
	finally
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.mCheckSyncUpdate&quot;);
		}
	}
}"
