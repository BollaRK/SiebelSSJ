			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateNonPayingChildren"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateNonPayingChildren(inputs)
{
/*
 * Component Name        :	Com Invoice Profile
 * Method Name           :	mUpdateNonPayingChildren
 * Component Information :	Generic function to update the child non paying billing accounts
 * 							with the info passed in in the property set inputs
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 22/11/2005	REB			D #6506		Initial Version
 */
try
{
	var sAccountId = inputs.GetProperty(&quot;Account Id&quot;);
	var accountBO = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);
	var profileBC = accountBO.GetBusComp(&quot;VF Com Invoice Profile&quot;);
	var isRecord;
	
	//Remove the Account Id from the property set so that we do not try and Set it later with SetMultipleFieldValues method
	inputs.RemoveProperty(&quot;Account Id&quot;);

		//locate &amp; update the childeren
		profileBC.ActivateField(&quot;Parent Account Id&quot;);
		profileBC.ActivateField(&quot;Payment Method&quot;);
		profileBC.ClearToQuery();
		profileBC.SetSearchSpec(&quot;Parent Account Id&quot;, sAccountId);
		profileBC.SetSearchSpec(&quot;Payment Method&quot;, &quot;Non Paying&quot;);
		profileBC.ExecuteQuery();
		isRecord = profileBC.FirstRecord();
		while (isRecord)
		{
			profileBC.SetMultipleFieldValues(inputs);
			profileBC.WriteRecord();
			isRecord = profileBC.NextRecord();
		}
}
catch (e)
{
	if (defined(e.errText))
	{
		var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
	}
	else
	{
		var strError = arguments.callee + ToString(e); 
	}
	//************************************
	//* Trace Statement
	//************************************
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:Com Invoice Profile.UpdateNonPayingChildren.strError= &quot; + strError);
	}
   	throw (strError);
}
finally
{
	//************************************
	//* Trace Statement
	//************************************
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;END:Com Invoice Profile.UpdateNonPayingChildren&quot;);
	}
	profileBC = null;
	accountBO = null;
}
}"
			   SEQUENCE="20"
			   UPDATED="11/01/2018 14:02:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateNotificationMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Com Invoice Profile
 * Function Name         : 	mUpdateNotificationMSISDN
 * Component Information : 	Updates MSISDN For TXT field to Dummy MSISDN if Billing Account have no assets and CA is of Type:Person
 *							Throws error as field is required if null.
 *							Dummy MSISDN value is from System Preference: VF Dummy notification MSISDN
 *
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========		================================
 * 22/06/2011	Sailaja		SE11C			Initial Version
 */

function mUpdateNotificationMSISDN()
{
	try
	{
		//Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.mUpdateNotificationMSISDN&quot;);
		}

		var sBillAccId;
		var sAccType;
		var sNotMSISDN;
		var sDummyMSISDN;
		var sNotifMethod;
		var boAccount;
		var bcAsset;
		
		this.ActivateField(&quot;Account Id&quot;);
		this.ActivateField(&quot;MSISDN For TXT&quot;);
		
		sBillAccId = this.GetFieldValue(&quot;Account Id&quot;);
		sAccType = this.GetFieldValue(&quot;Master Account Type&quot;);
		sNotMSISDN = this.GetFieldValue(&quot;MSISDN For TXT&quot;);
		sNotifMethod = this.GetFieldValue(&quot;Notification Method&quot;);
		
		if(sAccType == &quot;Person&quot; &amp;&amp; sNotMSISDN == &quot;&quot; &amp;&amp; 
		   (sNotifMethod == &quot;TXT&quot; || sNotifMethod == &quot;Email and TXT&quot;))
		{
			boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
			bcAsset = boAccount.GetBusComp(&quot;Asset Mgmt - Asset - Header - Flat&quot;);
		
			bcAsset.ActivateField(&quot;Status&quot;);
			bcAsset.SetViewMode(AllView);
			bcAsset.ClearToQuery();
			bcAsset.SetSearchSpec(&quot;Billing Account Id&quot;, sBillAccId);
			bcAsset.SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;);
			bcAsset.SetSearchSpec(&quot;Parent Asset Id&quot;, &quot;IS NULL&quot;);
			bcAsset.ExecuteQuery();
		
			if(bcAsset.FirstRecord())
			{
				throw (&quot;VFErrorCode#10525&quot;);
			}
			else
			{	
				sDummyMSISDN = mGetSysPref(&quot;VF Dummy Notification MSISDN&quot;);	
				this.SetFieldValue(&quot;MSISDN For TXT&quot;,sDummyMSISDN);
			}
		}
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			var sErrorMessage = e.toString();
		}
		else
		{
	    	var sErrorMessage = e.errText;
	    }
     	
		//Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.mUpdateNotificationMSISDN &quot; + sErrorMessage);
		}

     	throw(sErrorMessage);
	}
	finally
	{
		//Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.mUpdateNotificationMSISDN&quot;);
		}
		
		bcAsset = null;
		boAccount = null;
	}
}"
