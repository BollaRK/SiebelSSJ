			   CREATED_BY="SADMIN">
				<FIELD_USER_PROP
				   INACTIVE="Y"
				   NAME="Required"
				   VALUE="[LOY Flag] = &quot;Y&quot;"
				   UPDATED="06/10/2014 00:41:16"
