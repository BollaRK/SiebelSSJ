			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
	try
	{
			//VF HariKM 27/10/2011 Added for R11E - SMS on Customer Deatil update
				switch(MethodName)
				{
					case &quot;UndoRecord&quot;:
						this.SetUserProperty(&quot;PaymentMethodUpdt&quot;,&quot;&quot;);
						this.SetUserProperty(&quot;EmailBillToUpdt&quot;,&quot;&quot;);
						this.SetUserProperty(&quot;SuspendPaymentUpdt&quot;,&quot;&quot;);
						//return (CancelOperation);
						TheApplication().SetProfileAttr(&quot;BypassCCNumValidation&quot;,&quot;&quot;);//15/04/2015 RR:Added to reset the profile attribute set for bypassing CC Number validation
					break;
					
						//14/05/2015 Gayathri: Added for PCI Integration
					case &quot;VFConfirmCreditCard&quot;:
						var BAN = TheApplication().GetProfileAttr(&quot;BAN&quot;);//04/06/2015 RR:Added for PCI
							BAN = &quot;BAN:&quot;+BAN;
						var strId = this.GetFieldValue(&quot;Id&quot;);
						var strWF = TheApplication().GetService(&quot;Workflow Process Manager&quot;); 
						var strinp = TheApplication().NewPropertySet(); 
						var strout = TheApplication().NewPropertySet(); 
						strinp.SetProperty(&quot;Identifier&quot;,strId);
						strinp.SetProperty(&quot;ClientRef&quot;,BAN);
						strinp.SetProperty(&quot;ProcessName&quot;,&quot;VF PCI Token Complete Workflow&quot;);
						strWF.InvokeMethod(&quot;RunProcess&quot;,strinp,strout); 
						var strCCNum = strout.GetProperty(&quot;CCToken&quot;);
						var strCCType = strout.GetProperty(&quot;CCType&quot;);
						var strCCExpYr = strout.GetProperty(&quot;CCExpYr&quot;);
						var strCCExpMonth = strout.GetProperty(&quot;CCExpMon&quot;);
						var strCCExp = strout.GetProperty(&quot;CCExpDt&quot;);
						var strCCHolderName = strout.GetProperty(&quot;CCHolder&quot;);
						var sFusionCode	       = strout.GetProperty(&quot;BWErrCode&quot;);
						var sException  		   = strout.GetProperty(&quot;WorkflowWithError&quot;);
						var sDispMessage	       = strout.GetProperty(&quot;Display Error Message&quot;);
						var sErrorMessage    	   = strout.GetProperty(&quot;Error Message&quot;);
						var sErrorStatus    	   = strout.GetProperty(&quot;ErrorStatus&quot;);//YP Added to identify Error
						
								   
						  //if (sFusionCode != 0 &amp;&amp; sException == true)
					 
						if (sErrorStatus == &quot;FAILED&quot;)//YP added this for error handling
						{
							//External Errors
							TheApplication().RaiseErrorText(sErrorMessage);
						}           
						else
						{
						this.ActivateField(&quot;Expiration Year&quot;);
						this.ActivateField(&quot;Expiration Month&quot;);
						this.ActivateField(&quot;Credit Card Number&quot;);
						this.ActivateField(&quot;Credit Card Name&quot;);
						this.ActivateField(&quot;Credit Card Type&quot;);
						//this.ActivateField(&quot;CC Number Token Not Enc&quot;);
						this.SetFieldValue(&quot;Credit Card Number&quot;,strCCNum);
						this.SetFieldValue(&quot;Credit Card Name&quot;,strCCHolderName);
						this.SetFieldValue(&quot;Credit Card Type&quot;,strCCType);
						this.SetFieldValue(&quot;Expiration Year&quot;,strCCExpYr);
						this.SetFieldValue(&quot;Expiration Month&quot;,strCCExpMonth);
						//this.SetFieldValue(&quot;CC Number Token Not Enc&quot;,strCCNum);
						TheApplication().RaiseErrorText(sErrorMessage);//YP added this for displaying success message
						}
									  
							   
					  //End of Code
					return (CancelOperation);
					break;
					
					case &quot;VFCaptureCreditCard&quot;:
						return (CancelOperation);
					break;
				}
				return (ContinueOperation);
	}
	catch (e) 
	{	
		throw(e);
	}
	finally
	{
		/*Below variables are nullified  by JAGJIT on 18/03/2019*/
		var strinp = null;
		var strout = null;
		//var strWF = null;
		if(defined(strWF)) { strWF = null; }//This variable is nullified by BALAMURUGAN on 24/10/2019
	}
}"
			   SEQUENCE="28"
			   UPDATED="11/06/2019 15:08:24"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : BusComp_PreSetFieldValue
 * Component Information : Standard event
 *
 * Modification History  :
 * Date			Author	Config #	  Description
 * ============	=======	===========	  =================================
 * 21/02/2005	TAlihos				  Used to set global variable
 * 02/05/2006	JSK		Defect 13288  Added for Creating SuspendPayment Activity		
 * 27/06/06		RP		Defect 15054  Added code for storing new Accounting Type
 * 28/03/07		Benita	Defect 24722  Added code for setting Payment Type variable  
 * 12/03/08		podec	Defect 7545   Added code to validated Bank Account number field
 *									  for number.
 * 20/03/08		podec	Defect 7545	  Added validation for Diners Club Card. 
 * 03/07/08		Huik	DF2702 EBP	  Added for EBP
 * 11/07/2008   josel   DF 8462       Added code for SR 446.
 * 24/10/2008   Baranwas			  Added code for Dishonour fee interface
 * 29/04/2009	MSL		PR247		  Validate the email in script to throw a user friendly message
 * 14/10/09		SLV					  Bulk Update Bill Profile - set a user prop when
 *									  validity status field is changed
 * 23/03/2010   KP      Release 10.3  Validation for [Email Bill To] &amp; {Notification Email] modified
 * 24/04/2010	Raja	DF #12351	  Added validation for &quot;Credit Card Name&quot; field.
 * 01/03/2011	CS		TD 13791	  Account Number has no validation
 * 19/04/2011   SZk     TD 13850      Added extra validation
 * 15/11/2013	ASHOKR	QC1572		Added validation to stop unwanted activity getting created on clicking suspend payment.
 * 08/02/2014	santoshb QC 263		Commented out code for QC1572 and added code for QC#263
 */
function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
/*
Commented out by Mark Troy 01/03/2004 - Not required for Wave 1.

	/////
	// Description: This function will do the following when Payment Method is 
	//				changed.
	//				1) When Payment Method is set to Non-Paying and Parent Account 
	//                 is null, it will error out.
	//				2) When Payment Method is set to Non-Paying, it will check 
	//                 there is valid paying parent.
	//              3) When Payment Method is set to Non-Paying with a valid paying
	//                 parent, it will update the account Billing Frequency, 
	//				   Billing Cycle and Currency Code with the values from the 
	//				   paying parent.
	//				4) When the Payment Method is set to Non-Paying, it will set 
	//                 the Account Class to Service.  Otherwise, Account Class will
	//                 be set to Customer.
	////
*/
	try
	{
		/****
		* Trace Statement
		****/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.PreSetFieldValue&quot;);
		}		
		/****
		*	Declare Variables
		****/
	
		
		var returnVal = ContinueOperation;
		var input1, output1, input2, output2, oBS1, oBS2;
	
		/****
		*	TAlihos 21/02/2005 - Lets check to see which
		*	field is getting set
		*****/
	
		switch (FieldName)
		{
		
			//NIRMAL 31/08/2015	 Added for PKE000000017837
	        case &quot;Bank Account Name&quot; :
	        case &quot;Bank Account Number&quot; :
	        case &quot;Bank Branch&quot; :
	                if(this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Direct Debit&quot;){
	                        if(FieldValue == &quot;&quot; || FieldValue == null){
	                                throw(FieldName + &quot; is Required Field. Please enter the value to Proceed...&quot;);
	                        }
	                }      
	        break;
	       
	        case &quot;Payment Type&quot;:
	                // Get profile attributes set at task &quot;VF Capture Billing Details Task&quot;
	                //var ExistingCustomer = TheApplication().GetProfileAttr(&quot;ExistingCustomer&quot;);
	                var ExistingCustomer =  mCheckForExistingCustomer(this.GetFieldValue(&quot;Master Account Id&quot;)); //Aruns:20/09/2018: created to check for existing customer for PKE000000060904 
	                //var sAccountType = TheApplication().GetProfileAttr(&quot;Account Type&quot;);
	                //var sIntendedUsage = TheApplication().GetProfileAttr(&quot;VF Intended Usage&quot;);
	                var sIntendedUsage = this.GetFieldValue(&quot;VHA Intended Usage&quot;);
	                var sAccountType = this.GetFieldValue(&quot;Master Account Type&quot;);
	                var sAllowPaymentTypeResp = this.GetFieldValue(&quot;VHA Allow Payment Type&quot;);
	                // Check if customer is new or existing
	                if(ExistingCustomer == &quot;Y&quot;){
	                        var sCustomerType = &quot;Existing&quot;;
	                } else {
	                        var sCustomerType = &quot;New&quot;;
	                }
	                if (sCustomerType == &quot;New&quot; &amp;&amp; sAccountType == &quot;Person&quot; &amp;&amp; sIntendedUsage == &quot;Private&quot; &amp;&amp; sAllowPaymentTypeResp != &quot;Y&quot;){                
	                        // If a billing payment type of &apos;Other&apos; is selected                    
	                        if (FieldValue == &quot;Other&quot;){
	                                throw(&quot;New customers are not allowed to have a payment type of &apos;Other&apos;. Please modify the payment type field&quot;);
	                        }
	                }
	                //VHA Sneha:Added for 18.3 CIR
	                gOldPaymentType = this.GetFieldValue(&quot;Payment Type&quot;);
	                if ((this.GetUserProperty(&quot;StatusChanged&quot;) != &quot;Y&quot;))
					{
			    		sPrevValue = this.GetFieldValue(&quot;Payment Type&quot;);
			    	}
		 			sNewValue = FieldValue;
	            	this.SetUserProperty(&quot;StatusChanged&quot;, &quot;Y&quot;);
	            	/*if (FieldValue == &quot;Credit Card&quot;)
            		{
            			this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            		}
            		if (FieldValue == &quot;Direct Debit&quot;)
            		{
            			this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;);
            		}*/
	            	if (this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;)
	            	{
	            	this.SetUserProperty(&quot;PaymentTypeFee&quot;, &quot;Y&quot;);
	            	}
	        break;
			//End. NIRMAL. PKE000000017837.
	
			//TAlihos 21/02/2005 Added case statement to set global variable
			case &quot;Payment Method&quot;:
				gOldPaymentMethod = this.GetFieldValue(&quot;Payment Method&quot;);
			break;	
			//added for EBP activity creation when EMail OptIn flag is checked Baranwas 02Jun08
			case &quot;Email Bill&quot;:
				gEmailOptIn = this.GetFieldValue(&quot;Email Bill&quot;);
			//	this.SetUserProperty(&quot;EmailBill&quot;, &quot;Y&quot;); // QC 1572
			break;
			// added for smartscript connections
			case &quot;Email&quot;:
				//ValidateEmail(FieldValue);
				oBS1 = TheApplication().GetService(&quot;VF Validation Service&quot;);	
				input1 = TheApplication().NewPropertySet();	
				output1 = TheApplication().NewPropertySet();
				input1.SetProperty(&quot;EmailAddress&quot;, FieldValue);
				oBS1.InvokeMethod(&quot;ValidateEmailAddress&quot;, input1, output1);					
			break;
			// BaranwaS Set the validity status to &quot;Not Validated&quot;, every time Email Bill TO field is changed
			case &quot;Email Bill To&quot;:
			     //Email validation updated			     
				//ValidateEmail(FieldValue);
				oBS2 = TheApplication().GetService(&quot;VF Validation Service&quot;);	
				input2 = TheApplication().NewPropertySet();	
				output2 = TheApplication().NewPropertySet();
				input2.SetProperty(&quot;EmailAddress&quot;, FieldValue);
				oBS2.InvokeMethod(&quot;ValidateEmailAddress&quot;, input2, output2);	
				gEmailBillTo = this.GetFieldValue(&quot;Email Bill To&quot;);
				this.SetUserProperty(&quot;EmailBillToChanged&quot;, &quot;Y&quot;);
			break;
			case &quot;Validity Status&quot;:
				if (TheApplication().GetProfileAttr(&quot;bIsBulkUpdate&quot;) == &quot;Y&quot;)
				{
					this.SetUserProperty(&quot;ValidityStatusChangedviaBulk&quot;, &quot;Y&quot;);
				}
			break;
			case &quot;Bill Charges Override Reason&quot;: //8feb2014-santoshb-added condition for QC#263
				gBillChargesOverrideReason = this.GetFieldValue(&quot;Bill Charges Override Reason&quot;);
			break;
			
			case &quot;Email Bill To Last Updated&quot;:
				gEmailBillToLastUpdated = this.GetFieldValue(&quot;Email Bill To Last Updated&quot;);
			break;
			case &quot;Suppress Paper&quot;:
				gSuppressPaper = this.GetFieldValue(&quot;Suppress Paper&quot;);
			//	this.SetUserProperty(&quot;SuppressBill&quot;, &quot;Y&quot;); // QC1572
			break;
			//Benita 28/03/2007 Added case statement to set global variable
			/*case &quot;Payment Type&quot;:
				gOldPaymentType = this.GetFieldValue(&quot;Payment Type&quot;);
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;StatusChanged&quot;) != &quot;Y&quot;))
				{
			    	sPrevValue = this.GetFieldValue(&quot;Payment Type&quot;);
			    }
	 			sNewValue = FieldValue;
            	this.SetUserProperty(&quot;StatusChanged&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
            	
            	//baranwas 24/10/2008 Dishonour Fee notification
            	if (this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;)
            	this.SetUserProperty(&quot;PaymentTypeFee&quot;, &quot;Y&quot;);
            	//end of code Baranwas 24/10/2008
				break;*/
						
				// VF JSK 02/06/2006 Added for Creating Activity
			case &quot;Suspend Payment&quot;:
				bSuspendPayment = true;
			break;

			case &quot;Mandatory Payment&quot;:
				bMandatoryPayment = true;
			break;
		
			case &quot;Presentment&quot;:
				bPresentment = true;
				break;
				
			case &quot;Media Type&quot;:
				gNewMediaType = FieldValue;
				bBillMedia = true
				break;
			
			case &quot;Accounting Type&quot;:
				gNewAccountingType = FieldValue;
				bAccountingTypeChng = true;
				break;	

			case &quot;Bill Format&quot;:
				gNewBillFormat = FieldValue;
				bBillFormatChng = true;
				break;
			//podec-Defect 7545-Validate Bank Account Number 
			case &quot;Bank Account Number&quot;:
			case &quot;Bank Account Number - Display&quot;:  // TD 13791
				if(isNaN(FieldValue))
				{
					var sInvalidBnkAccntNum = &quot;VFErrorCode#98150:Invalid Bank Account Number. It should be numeric.&quot;;
					throw(sInvalidBnkAccntNum)
				}
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sDebitPrevValue = this.GetFieldValue(&quot;Bank Account Number&quot;);
			    }
	 			sDebitNewValue = FieldValue;
            	this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
				
			case &quot;Bank Account Name&quot;:
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sDebitPrevValue = this.GetFieldValue(&quot;Bank Account Name&quot;);
			    }
	 			sDebitNewValue = FieldValue;
            	this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;		
							
			case &quot;Direct Debit Reference&quot;:
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sDebitPrevValue = this.GetFieldValue(&quot;Direct Debit Reference&quot;);
			    }
	 			sDebitNewValue = FieldValue;
            	this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;	
							
			case &quot;Bank Branch Code&quot;:
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sDebitPrevValue = this.GetFieldValue(&quot;Bank Branch Code&quot;);
			    }
	 			sDebitNewValue = FieldValue;
            	this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
			
			case &quot;Credit Card Name&quot;:
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;) &amp;&amp; (this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Credit Card&quot;)) //VF SZK 19/04/2011 def13850 Added extra validation
				{ 	
				  		//Indumathi: 28/12/2017 - Added validation for Kogan
				  		var slen = FieldValue.length;
						var isAlpha = Clib.strspn(FieldValue, &quot; ABCDEFGHIJKLMNOPQRSTUVWXYZabcdfeghijklmnopqrstuvwxyz&quot;);
						// start of 12351: Strictly the field should not allow numeric.
						if((!isNaN(FieldValue) &amp;&amp; this.GetFieldValue(&quot;VHA Is Kogan&quot;) != &quot;Y&quot;) || (isAlpha != slen &amp;&amp; this.GetFieldValue(&quot;VHA Is Kogan&quot;) == &quot;Y&quot;))
				 		{
						var sInvalidCreditCardName = &quot;VFErrorCode#99985:Card holder Name is Invalid.&quot;;
						throw(sInvalidCreditCardName);
						} //  end of 12351		
			    	sCreditPrevValue = this.GetFieldValue(&quot;Credit Card Name&quot;);
			    }
	 			sCreditNewValue = FieldValue;
            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
				
			//podec-Defect 7545-populate Cctype automatically based on Cc NUmber. 
			case &quot;Credit Card Number - Display&quot;:
				if(this.GetFieldValue(&quot;ARII&quot;)==&quot;Australia&quot;)
				{
					TheApplication().SetProfileAttr(&quot;sCCFlag&quot;,&quot;Y&quot;);
					TheApplication().SetProfileAttr(&quot;sCCFieldName&quot;,&quot;Credit Card Number - Display&quot;);
				}
				//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sCreditPrevValue = this.GetFieldValue(&quot;Credit Card Number - Display&quot;);
			    }
	 			sCreditNewValue = FieldValue;
            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.	
				break;
			//Indumathi: 03/01/2018 - Added below code for Kogan
			case &quot;CC Number Token Not Enc&quot;:
				if(this.GetFieldValue(&quot;VHACreditCardDisableCalc&quot;) == &quot;Y&quot;)
				{
				//VHA Muthushankari 10/4/2018 - Commented the below code and moved to PreWriteRecord as part of PKE000000060580(FTTC CR)
				//	var sCardType = this.GetFieldValue(&quot;Credit Card Type&quot;);
				//	ValidateKoganCreditCardTokenNumber(FieldValue,sCardType);	
					if(this.GetFieldValue(&quot;ARII&quot;)==&quot;Australia&quot;)
					{
						TheApplication().SetProfileAttr(&quot;sCCFlag&quot;,&quot;Y&quot;);
						TheApplication().SetProfileAttr(&quot;sCCFieldName&quot;,&quot;CC Number Token Not Enc&quot;);
					}
					if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
					{
				    	sCreditPrevValue = this.GetFieldValue(&quot;CC Number Token Not Enc&quot;);
				    }
		 			sCreditNewValue = FieldValue;
	            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	}
				break;
			//podec-Defect7545-validation for diners club card, American Express Card.
			case &quot;Credit Card Type&quot;:
				//VF-josel,Added for SR NZ000446.
				/*if(this.GetFieldValue(&quot;VHACreditCardDisableCalc&quot;) == &quot;Y&quot;)
				{
					var sCardNumber = this.GetFieldValue(&quot;CC Number Token Not Enc&quot;);
					ValidateKoganCreditCardTokenNumber(sCardNumber,FieldValue);
				}*/
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sCreditPrevValue = this.GetFieldValue(&quot;Credit Card Type&quot;);
			    }
	 			sCreditNewValue = FieldValue;
            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
		
		case &quot;Expiration Month&quot;:
			//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sCreditPrevValue = this.GetFieldValue(&quot;Expiration Month&quot;);
			    }
	 			sCreditNewValue = FieldValue;
            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
		
		
		case &quot;Expiration Year&quot;:
			//VF-josel,Added for SR NZ000446.
				if ((this.GetUserProperty(&quot;DirectDebitStatus&quot;) != &quot;Y&quot;))
				{
			    	sCreditPrevValue = this.GetFieldValue(&quot;Expiration Year&quot;);
			    }
	 			sCreditNewValue = FieldValue;
            	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
            	//VF josel-End of code for SR NZ000446.
				break;
		//Chitra added for TIR 16.4 release - 19/9/2016
		case &quot;MSISDN For TXT&quot;:
				var pattern  = /( )/g;
				FieldValue = FieldValue.replace(pattern,&quot;&quot;);
				ValidateNotificationMSISDN(FieldValue);
				this.SetUserProperty(&quot;NotificationMSISDN&quot;,FieldValue);
			break;
		default:
		 	break;

			return (returnVal);	
		}

	}
	catch (e)
	{
		if (defined(e.errText))
		{
		
			var strError = e.errText;
		}
		else
		{
			
			var strError = ToString(e);
		}
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.PreSetFieldValue.strError= &quot; + strError);
		}
		
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.PreSetFieldValue&quot;);
		}
		
		input1 = null;
		output1 = null;
		input2 = null;
		output2 = null;		
		oBS1 = null;
		oBS2 = null;	
	}

}"
			   SEQUENCE="29"
			   UPDATED="11/01/2018 14:02:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
	var svc;
	var Input;
	var Output;
	var sCCRegistrationId;
	var strCardExpiry;
	var numCardExpiry; 
	var lenCardExpiry;
	var dateToday;
	var dateYear;
    var strCardExpiryMonth;
    var numCardExpiryMonth;
    var dateMonth;
	var sCCErrMsg = &apos;N&apos;;		
    try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.PreWriteRecord&quot;);
		}

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;Old Accounting: &quot; + gOldAccountingType + &quot; New Accounting: &quot; + gNewAccountingType );
		}
		if (this.GetUserProperty(&quot;NotificationMSISDN&quot;) != &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;Calc Notification Method TXT&quot;) != &quot;Y&quot;)
		{
			this.SetFieldValue(&quot;MSISDN For TXT&quot;,this.GetUserProperty(&quot;NotificationMSISDN&quot;));
			this.SetUserProperty(&quot;NotificationMSISDN&quot;,&quot;&quot;);
		}
		//PKE000000092250
		var sView5 = TheApplication().ActiveViewName(); 
		if(sView5 == &quot;VF Billing Details View - TBUI&quot; || sView5 == &quot;VF Connection Wizard View - Billing Detail - TBUI&quot;)
		{
		if(this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Direct Debit&quot;) 
		{
		
		var sBankAccountName = this.GetFieldValue(&quot;Bank Account Name&quot;);
        var sBankAccountNum = this.GetFieldValue(&quot;Bank Account Number&quot;);
        var sBankAccountBranch = this.GetFieldValue(&quot;Bank Branch&quot;);
		if (sBankAccountBranch == &quot;&quot; || sBankAccountBranch == null) {
			throw(&quot;VFErrorCode#99696&quot;);
        }
		if (sBankAccountNum == &quot;&quot; || sBankAccountNum == null) {
            throw(&quot;VFErrorCode#99697&quot;);
        }
		if (sBankAccountName == &quot;&quot; || sBankAccountName == null) {
            throw(&quot;VFErrorCode#99698&quot;);
        }
		}
		}





        // BaranwaS Set the validity status to &quot;Not Validated&quot;, every time Email Bill To field is changed
		// BaranwaS Set the Email Bill To Last Updated to current system date, every time Email Bill To field is changed. However, 
		// Do not update if these fields if field is changed through EBP Batch tool.
		var sUserProp = this.GetUserProperty(&quot;EmailBillToChanged&quot;);
		if(sUserProp ==&quot;Y&quot; &amp;&amp; gEmailBillTo != this.GetFieldValue(&quot;Email Bill To&quot;) &amp;&amp; TheApplication().GetProfileAttr(&quot;EBPBatchUpdate&quot;) !=&quot;Y&quot;)// &amp;&amp; TheApplication().GetProfileAttr(&quot;EBPBatchUpdateOptIn&quot;) !=&quot;Y&quot;))
		{	
			var dtDate = new Date();
			var sFormattedDate = (dtDate.getMonth() + 1) + &quot;/&quot; + dtDate.getDate() + &quot;/&quot; + dtDate.getFullYear();
		    var	sFormattedDateTime = sFormattedDate + &quot; &quot; + dtDate.getHours() + &quot;:&quot; + dtDate.getMinutes() + &quot;:&quot; + dtDate.getSeconds();

			TheApplication().SetProfileAttr(&quot;EBPBatchUpdate&quot;, &quot;&quot;)
			
			//SLV Bulk Update Bill Profile
			//Allow this bulk process to set the validity status
			if (this.GetUserProperty(&quot;ValidityStatusChangedviaBulk&quot;) != &quot;Y&quot;)
			{
				this.SetFieldValue(&quot;Validity Status&quot;, &quot;Not Validated&quot;);
			}
			//gCurrentTimeStamp = this.GetFieldValue(&quot;Calc Current TimeStamp&quot;);
			this.SetFieldValue(&quot;Email Bill To Last Updated&quot;, sFormattedDateTime);
		}
		this.SetUserProperty(&quot;EmailBillToChanged&quot;, &quot;&quot;);	
  		if(TheApplication().GetProfileAttr(&quot;VF AU Upgrades Smartscript&quot;) == &quot;Y&quot;)//VF-R13.0 ,Production defect 1366,VIJAYE
    	{
    		return (ContinueOperation);
    	}
    	// VF:Roseline 09/08/2014 - Removed the Credit card type validation from PreSetFieldValue to here
    	// Validation for diners club card, American Express Card.
    	if(this.GetFieldValue(&quot;ARII&quot;)==&quot;Australia&quot;)
		{
			var sCCNum = this.GetFieldValue(&quot;Credit Card Number&quot;);	// VHA Suresh P: Moved the line before the If Loop for INC000013198148- Kogan Issue
			
			//Indumathi: 03/01/2018 - Modified sCCNum variable value for Kogan
			if(this.GetFieldValue(&quot;VHACreditCardDisableCalc&quot;) == &quot;Y&quot;)
				var sCCNum = this.GetFieldValue(&quot;CC Number Token Not Enc&quot;);
			
			if(isNaN(sCCNum)){//BalajiM - Miami 07/04/2022
			//ahphanumeric
				sCCNum = this.GetFieldValue(&quot;Credit Card First 6&quot;);
			}

			var sCCType = this.GetFieldValue(&quot;Credit Card Type&quot;);
			if(this.GetFieldValue(&quot;Payment Type&quot;)==&quot;Credit Card&quot;){//BalajiM - Miami 07/04/2022
				if (sCCType ==&quot;Diners Club&quot;)
				{
					if(
						sCCNum.indexOf(&quot;38&quot;)==0 ||
						sCCNum.indexOf(&quot;36&quot;)==0 ||
						sCCNum.indexOf(&quot;300&quot;)==0 ||
						sCCNum.indexOf(&quot;301&quot;)==0 ||
						sCCNum.indexOf(&quot;302&quot;)==0 ||
						sCCNum.indexOf(&quot;303&quot;)==0 ||
						sCCNum.indexOf(&quot;304&quot;)==0 ||							
						sCCNum.indexOf(&quot;305&quot;)==0 ||
						sCCNum.indexOf(&quot;2014&quot;)==0 ||
						sCCNum.indexOf(&quot;2149&quot;)==0)
					{}
					else
					{
						var sInvalidDinerType = &quot;VFErrorCode#98151:The credit card number you entered does not appear to be valid.Please check the card number you entered or select another credit card.&quot;;
						throw(sInvalidDinerType);
					}	
				}
				else if	(sCCType ==&quot;American Express&quot;) 
				{	
					if(sCCNum.indexOf(&quot;34&quot;)==0 ||
					sCCNum.indexOf(&quot;37&quot;)==0)
					{}
					else
					{	var sInvalidDinerType = &quot;VFErrorCode#98151:The credit card number you entered does not appear to be valid.Please check the card number you entered or select another credit card.&quot;;
						throw(sInvalidDinerType);
					}	
				}
			}
		}		    	
   	//PODEC defect#7545 - Blitz Project - Populate CCtype based on CCNumber
    	var sCCFlag = 	TheApplication().GetProfileAttr(&quot;sCCFlag&quot;);
		var sCCFieldName = TheApplication().GetProfileAttr(&quot;sCCFieldName&quot;);
		if (sCCFlag ==&quot;Y&quot; &amp;&amp; (sCCFieldName == &quot;Credit Card Number - Display&quot; || sCCFieldName == &quot;CC Number Token Not Enc&quot;))	//Indumathi: 03/01/2018 - Modified for Kogan
		{
			TheApplication().SetProfileAttr(&quot;sCCFlag&quot;,&quot;N&quot;);
			TheApplication().SetProfileAttr(&quot;sCCFieldName&quot;,&quot;&quot;);
			
			var sCCNum = this.GetFieldValue(&quot;Credit Card Number&quot;);	// VHA Suresh P: Moved the line before the If Loop for INC000013198148- Kogan Issue
			
			//Indumathi: 03/01/2018 - Modified sCCNum variable value for Kogan
			if(this.GetFieldValue(&quot;VHACreditCardDisableCalc&quot;) == &quot;Y&quot;)
			var sCCNum = this.GetFieldValue(&quot;CC Number Token Not Enc&quot;);
			
			if(isNaN(sCCNum)){//BalajiM - Miami 07/04/2022
			//ahphanumeric
				sCCNum = this.GetFieldValue(&quot;Credit Card First 6&quot;);
			}
					var sCCType = &quot;&quot;;
					var cAMEX = &quot;American Express&quot;;
					var cDINERS = &quot;Diners Club&quot;;
					var cVISA = &quot;VISA&quot;;
					var cMASTERCARD = &quot;MasterCard&quot;;
										
					if (sCCNum.indexOf(&quot;4&quot;) == 0)
					{
						sCCType = cVISA;
					}
					else if(sCCNum.indexOf(&quot;51&quot;)==0 ||
							sCCNum.indexOf(&quot;52&quot;)==0 ||
							sCCNum.indexOf(&quot;53&quot;)==0 ||
							sCCNum.indexOf(&quot;54&quot;)==0 ||
							sCCNum.indexOf(&quot;55&quot;)==0)
					
					{
						sCCType = cMASTERCARD;
					}
					else if(sCCNum.indexOf(&quot;34&quot;)==0 ||
							sCCNum.indexOf(&quot;37&quot;)==0)
					{
						sCCType = cAMEX;
					}
					else if(
							sCCNum.indexOf(&quot;38&quot;)==0 ||
							sCCNum.indexOf(&quot;36&quot;)==0 ||
							sCCNum.indexOf(&quot;300&quot;)==0 ||
							sCCNum.indexOf(&quot;301&quot;)==0 ||
							sCCNum.indexOf(&quot;302&quot;)==0 ||
							sCCNum.indexOf(&quot;303&quot;)==0 ||
							sCCNum.indexOf(&quot;304&quot;)==0 ||							
							sCCNum.indexOf(&quot;305&quot;)==0 ||
							sCCNum.indexOf(&quot;2014&quot;)==0 ||
							sCCNum.indexOf(&quot;2149&quot;)==0)
					{
						sCCType = cDINERS;
					}
					
					if (sCCType !=&quot;&quot;)
					{
						this.SetFieldValue(&quot;Credit Card Type&quot;,sCCType);
					}
		} 
		//VHA Muthushankari 10/4/2018 - Added the below code as part of PKE000000060580(FTTC CR)
		if(this.GetFieldValue(&quot;VHACreditCardDisableCalc&quot;) == &quot;Y&quot;)
    	{
    		var sCardNum = this.GetFieldValue(&quot;CC Number Token Not Enc&quot;);
    		var sCardType = this.GetFieldValue(&quot;Credit Card Type&quot;);
    		sCCErrMsg = &apos;Y&apos;;
			ValidateKoganCreditCardTokenNumber(sCardNum,sCardType);
			sCCErrMsg = &apos;N&apos;;
		}
	//Added 27/12/2007 by Huik. Defect 6522 Add script to prevent duplicate billing profile to be created 
		    var accountBO = TheApplication().GetBusObject(&quot;Account&quot;);
			var accountBC = accountBO.GetBusComp(&quot;Account&quot;);
			var accountId = this.GetFieldValue(&quot;Account Id&quot;)
			var profileBC = accountBO.GetBusComp(&quot;Com Invoice Profile&quot;);
			var isprofileBCRecord;
	
			// Get the account record
			accountBC.SetViewMode(AllView);
			accountBC.ClearToQuery();
			accountBC.SetSearchSpec(&quot;Id&quot;, accountId);
			accountBC.ExecuteQuery();
		
			if (accountBC.FirstRecord())
			{
				// Get the billing profile of the account
				profileBC.SetSearchSpec(&quot;Account Id&quot;, accountId);
				profileBC.ExecuteQuery();  //execute BC constrained by link
				isprofileBCRecord = profileBC.FirstRecord();
				
				while (isprofileBCRecord)
				{	
					//if a profile already existed, compared the two to see if they are 
					//different records, if different, throw an error
					var sid = this.GetFieldValue(&quot;Id&quot;);
					var toid =  profileBC.GetFieldValue(&quot;Id&quot;);
					if (this.GetFieldValue(&quot;Id&quot;)!= profileBC.GetFieldValue(&quot;Id&quot;))
					{		
					 throw( &quot;mSubmit &quot; + &quot;VFErrorCode#10355&quot; );
					}
					
					isprofileBCRecord = profileBC.NextRecord();
				}
			}
		//DF8989 HUIK 27/10/08 Default Paper bill reason code for corporate account
		if(
		this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; &amp;&amp; 
		this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot; &amp;&amp; 
		this.GetFieldValue(&quot;Master Account Type&quot;) != &quot;Person&quot; &amp;&amp;
		this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;N&quot; &amp;&amp; 
    	this.GetFieldValue(&quot;Email Bill&quot;) == &quot;N&quot;
		)
		{
			this.SetFieldValue(&quot;Bill Charges Override Reason&quot;, &quot;Business&quot;);
		}
		
		// VF 13/08/08 Huik VF EBP PIE158
    	// VF 03/07/08 Huik VF EBP DF2678
    	if (
    	this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; &amp;&amp;
    	this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot; &amp;&amp; 
    	this.GetFieldValue(&quot;Notification Method&quot;) == &quot;&quot;)
    	{
    		throw (&quot;VFErrorCode#10358&quot;);
    	}
    	//Partner Portal can&apos;t select paper bill
    	//VF 05/08/2013 AS Remove rule for WOW CIR
    	/*
    	if (TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel eChannel for CME&quot;
    	&amp;&amp; this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;N&quot; 
    	&amp;&amp; this.GetFieldValue(&quot;Email Bill&quot;) == &quot;N&quot;
    	// VF 18/08/08 EBP Prod DF8769
    	&amp;&amp; this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;
    	&amp;&amp; this.GetFieldValue(&quot;Master Account Type&quot;) == &quot;Person&quot;)
    	//&amp;&amp; this.GetFieldValue(&quot;Calc Applet Toggle - Bus AU FJ&quot;) != &quot;Bus AU FJ&quot;)
    	{
    		throw (&quot;VFErrorCode#10360&quot;);
    	}*/
    	
    	if (
    	// VF 13/08/08 Huik VF EBP PIE158
    	//VF 16/10/08 Changes for PCR4 to make Paper bill charges Override mandatory--susil sahu
    	this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; &amp;&amp;
    	this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot; &amp;&amp; 
    	this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;N&quot; &amp;&amp;
    	this.GetFieldValue(&quot;Email Bill&quot;) == &quot;N&quot; &amp;&amp;
	 	(this.GetFieldValue(&quot;Bill Charges Override Reason&quot;) == &quot;&quot; || this.GetFieldValue(&quot;Bill Charges Override&quot;)==&quot;&quot;))
    	{
    		throw (&quot;VFErrorCode#10359&quot;);
    	}
    	
		// Check for Customer Account Bill Segment 
		if( this.GetFieldValue(&quot;Payment Method&quot;) != &quot;Prepay&quot; )
		{
			if ( IsBillSegmentPrepay() == &quot;Y&quot; )
			{
				throw(  &quot;VFErrorCode#10353&quot; );
			}
		} 
		   	
		// Compare old and new Accounting Type
		if ( gNewAccountingType != gOldAccountingType )
		{		
			// Check whether billing account is overdue. Infranet can&apos;t handle update
			// to billing record when it is in debt.
			if ( this.ParentBusComp().GetFieldValue( &quot;Account Status&quot; ) == &quot;Overdue&quot; )
			{
				// Don&apos;t allow update
				throw( &quot;mSubmit &quot; + &quot;VFErrorCode#10351&quot; );
			}
		}

    	//Added 18/05/2006 by JSK. Defect 14046 Over-write Siebel Validation
		if(this.GetFieldValue(&quot;Suspend Payment&quot;) == &quot;Y&quot;)        
		{
			//Defect 22118
			//if(this.GetFieldValue(&quot;Suspend Payment End Date&quot;) &lt; this.GetFieldValue(&quot;SysDate&quot;)
			//|| this.GetFieldValue(&quot;Suspend Payment End Date&quot;) &gt; this.GetFieldValue(&quot;SysDate Plus 31&quot;))

			var SysEndDate = new Date(this.GetFieldValue(&quot;Suspend Payment End Date&quot;)).getTime();
			var SysDate = new Date(this.GetFieldValue(&quot;SysDate&quot;)).getTime();
			var SysDatePlus = new Date(this.GetFieldValue(&quot;SysDate Plus 34&quot;)).getTime();

			if((SysEndDate &lt; SysDate) || (SysEndDate &gt; SysDatePlus))
	 		{	
	 		        gErrorMessage = &quot;mSubmit &quot; + &quot;VFErrorCode#10349&quot;;
					throw(gErrorMessage);
	    	}
	    }	
	     
		var bcParent = this.ParentBusComp(); //VF:VISHALS:08/04/2013:QC1164
		if (bcParent != null &amp;&amp; bcParent.Name() == &quot;VF Billing Account&quot;) //VF:VISHALS:08/04/2013:QC1164
		{
		//Added 11/07/2005 by TP. Defect 2944 top level billing account can not be &apos;Non Paying&apos; 
        	if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Non Paying&quot; &amp;&amp; this.ParentBusComp().GetFieldValue(&quot;Parent Account Type Code&quot;)==&quot;Customer&quot;)
 			{	
 			        gErrorMessage = &quot;mSubmit &quot; + &quot;VFErrorCode#10333&quot;;
					throw(gErrorMessage);
					//throw(&quot;Top level billing account must be paying&quot;);
    		}	
    	}    	   	
    	// Defect 15482. Added so Suppress Paper is updated automatically to N if Notification Method is 
    	// null pr updated to Y if Notification Method is not null.
    	
    	/* Commented out code because it made it impossible to Suppress Mailing  
    	Removed as 16K character limit was reached.
    	*/
    	
    	// VF JSK 02/06/2006 Defect 13288
    	if (bSuspendPayment)
		{
			CreateSuspendPaymentActivity();
			bSuspendPayment = false;
		}
		if(bBillMedia)
		{
			CreateBillMediaActivity();
			bBillMedia = false;
		}
		
		if(bPresentment)
		{
			CreatePresentmentActivity();
			bPresentment = false;
		}

		if(bMandatoryPayment)
		{
			CreateMandatoryPayActivity();
			bMandatoryPayment = false;
		}

		/* VF VLI 06/03/2008 DF7455
    	//End D6506
        */
		//	Added by baranwas 23/10/2008 for Dishonour fee interface
		
		var sPayTypeFee = this.GetUserProperty(&quot;PaymentTypeFee&quot;);
		if(sPayTypeFee ==&quot;Y&quot; &amp;&amp; gOldPaymentType != this.GetFieldValue(&quot;Payment Type&quot;))
		{	
		
			var dtDate = new Date();
			var sFormattedDate = (dtDate.getMonth() + 1) + &quot;/&quot; + dtDate.getDate() + &quot;/&quot; + dtDate.getFullYear();
		    var	sFormattedDateTime = sFormattedDate + &quot; &quot; + dtDate.getHours() + &quot;:&quot; + dtDate.getMinutes() + &quot;:&quot; + dtDate.getSeconds();

			this.SetFieldValue(&quot;Payment Type Last Updated&quot;, sFormattedDateTime);
		
		}
		this.SetUserProperty(&quot;PaymentTypeFee&quot;, &quot;&quot;);
		//end of code Baranwas 23/10/2008
		
	    //DF8828 Bypass credit card expiration validation for EBP bulk updates
		if (TheApplication().GetProfileAttr(&quot;EBPBatchUpdate&quot;) == &quot;Y&quot;)
				TheApplication().SetProfileAttr(&quot;BypassCCExpirationValidation&quot;, &quot;Y&quot;);

		//DF 11/5/2010 R10.3 VHA Credit Approval.
		if (this.GetFieldValue(&quot;Channel Type&quot;) != &quot;3MIG&quot;)
		{
		    mCheckPaymentMethodType();
 		}
 		mUpdateNotificationMSISDN(); //SE11C
 		
 		// TD16245: VF VIVIND: 21/11/2012: Added the check for Expiration year of Credit Card.
 		// TD16245: SIBIC : changes to consider only first four digit as valid year value for online transaction 
        
 		if(this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Credit Card&quot;)
 		{
			if(TheApplication().ActiveViewName() != &quot;VHA Connection Wizard View - Exist Billing Detail - TBUI - SSJ&quot;)
		{
         var org = this.GetFieldValue(&quot;VHAUserOrg&quot;);
         var IsKogan = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORG_CONFIGURATION&quot;,org);
 		if(IsKogan == &quot;Y&quot;)
 		{
 			strCardExpiry = this.GetFieldValue(&quot;Expiration Year&quot;);
 			strCardExpiryMonth = this.GetFieldValue(&quot;Expiration Month&quot;);
 			numCardExpiryMonth = ToNumber(strCardExpiryMonth); 
 			strCardExpiry = strCardExpiry.substring(0,4); //SIBIC changes to consider only first four digit
			numCardExpiry = ToNumber(strCardExpiry); 
			lenCardExpiry = strCardExpiry.length;
			dateToday = new Date();
			dateYear = dateToday.getFullYear();
			dateMonth = dateToday.getMonth() + 1;
		
			if(isNaN(numCardExpiry) || lenCardExpiry != &apos;4&apos;)
 			{
 		      throw(&quot;VFErrorCode#11067&quot;);
 			}
 			else if(numCardExpiry &lt; dateYear)
 			{
      			throw(&quot;VFErrorCode#91111&quot;);
 			 // TheApplication().RaiseErrorText(&quot;The Expiry Year selected is in the past, please check and select the correct Expiry Year.&quot;);
 			}
 			else if(numCardExpiry == dateYear &amp;&amp; dateMonth &gt; numCardExpiryMonth &amp;&amp; numCardExpiryMonth != &quot;&quot;)
 			{
 			  throw(&quot;VFErrorCode#91112&quot;);
//			  TheApplication().RaiseErrorText(&quot;The Expiry Month selected is in the past, please check and select the correct Expiry Month and Year.&quot;);
 			}
 			else
 			{	
 				this.SetFieldValue(&quot;Expiration Year&quot;, strCardExpiry);
				this.SetFieldValue(&quot;Expiration Month&quot;, strCardExpiryMonth);
 			}
 			
 		}
 		else
 		{
 			strCardExpiry = this.GetFieldValue(&quot;Expiration Year&quot;);
 			strCardExpiry = strCardExpiry.substring(0,4); //SIBIC changes to consider only first four digit
			numCardExpiry = ToNumber(strCardExpiry); 
			lenCardExpiry = strCardExpiry.length;
			dateToday = new Date();
			dateYear = dateToday.getFullYear();
			if(isNaN(numCardExpiry) || lenCardExpiry != &apos;4&apos; || numCardExpiry &lt; dateYear)
 			{
 				throw (&quot;VFErrorCode#11067&quot;);
 			}
 			else
 			{	
 				this.SetFieldValue(&quot;Expiration Year&quot;, strCardExpiry);
 			}
 		}  
 	
 		}
 	
 		
 		
 		return (ContinueOperation);
	}
	}
	catch (e)
	{
		if(sCCErrMsg == &apos;Y&apos;)
			TheApplication().RaiseErrorText(e.toString());
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + e.toString(); 
		}
		else
		{
			var strError = arguments.callee + e.toString(); 
		}
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.PreWriteRecord.strError= &quot; + strError);
		}
		var strDisplayError = ErrorHandling(strError, &quot;BusComp_PreWriteRecord&quot;);
		TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		svc 	= null;
		Input 	= null;
		Output 	= null;
		//DF6522
		accountBO = null;
		accountBC = null;
		profileBC = null;
		bcParent = null; //VF:VISHALS:26/04/2013:QC1164
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.PreWriteRecord&quot;);
		}	
	}
	return (ContinueOperation);
}"
			   SEQUENCE="30"
			   UPDATED="01/13/2026 22:16:39"
			   UPDATED_BY="RAVIKUMARB"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : BusComp_SetFieldValue
 * Component Information : Standard event
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 13/12/2004	VLim				Create an activity when Presentment or
 *									Media Type has been updated.
 * 16/12/2004	MSL					Placed error handling in this function &amp;
 *									taken out of custom functions &amp; General Tidy Up
 * 13/01/2005	MSL					Call mCheckSyncUpdate to see if certain fields have
 *									been updated and need to be propagated to externals.
 * 27/01/2005	MSL					Clear the CCP Reg Id if the Payment Type Changes from VCC
 * 09/02/2005   VLim				Remove the creation of an Activity when it has
 *									changed into WriteRecord method.
 * 21/02/2005	TAlihos				Added case statement to set referesh screen
 * 									global variable to True when ever Payment Method has changed
 * 11/04/2005	JKim				Added padding for New Zealand Direct Debit
 * 28/03/2007	Benita				Clear the CCP Reg Id and trigger a page refresh if the payment 	
 *									type changes from VCC.
 * 22/09/09		SLV					Check a profile attribute before checking sync
 *									status - bulk process to update bill profile details calls
 *									this code and does a sync account synchronously so we don&apos;t want
 *									to call sync account from here.
 * 18/10/2011   HARIKM				Added code in seting Useserproperty for fields update
 * 03/04/2019	Pallavi					Added for Unified Application
 */
function BusComp_SetFieldValue (FieldName)
{
	try
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.SetFieldValue&quot;);
		}		
		/*********************************************
		*	MSL 08/12/2004 - Left pad bank account 
		*	number with zeroes for Australia.
		*********************************************/
		if(FieldName == &quot;Bank Account Number&quot; &amp;&amp; this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;
		 	&amp;&amp; this.GetFieldValue(FieldName).length &gt; 0 &amp;&amp; this.GetFieldValue(FieldName).length &lt; 9)
		{
			this.SetFieldValue(FieldName, Clib.rsprintf(&quot;%09s&quot;, this.GetFieldValue(FieldName)));
		}
		// TD 13791
		else if(FieldName == &quot;Bank Account Number - Display&quot; &amp;&amp; this.GetFieldValue(&quot;ARII&quot;) == &quot;Australia&quot;
			&amp;&amp; this.GetFieldValue(FieldName).length &gt; 0 &amp;&amp; this.GetFieldValue(FieldName).length &lt; 9)
		{
			this.SetFieldValue(&quot;Bank Account Number&quot;, Clib.rsprintf(&quot;%09s&quot;, this.GetFieldValue(&quot;Bank Account Number&quot;)));
		}
		
		
		if(FieldName == &quot;Email Bill&quot;)//Added for TBUI - to make sync with merlin flow
		{
			var sVal = this.GetFieldValue(&quot;Email Bill&quot;);
			if(sVal != &quot;Y&quot;)
			{
				this.SetFieldValue(&quot;Suppress Paper&quot;,&quot;Y&quot;);	 
                this.WriteRecord();
			}
		}
/*		if(TheApplication().ActiveViewName == &quot;VF Connection Wizard View - Billing Detail - TBUI&quot; || TheApplication().GetProfileAttr(&quot;ViewName&quot;) == &quot;FourthView&quot;)
		{
		if (FieldName == &quot;Email Bill To&quot;)
			{
				var sMail = this.GetFieldValue(&quot;Email Bill To&quot;);
				this.SetFieldValue(&quot;Email&quot;,sMail);
				this.WriteRecord();	
			}
		}*/	
		//End TBUI - to make sync with merlin flow
		
		/* VLim 09/02/05:  Moved code below to WriteRecord method - to only
		*  create Activities when the user has saved.
		/*********************************************
		*	MSL 09/12/2004 - Create an activity when 
		*	the mandatory payment flag has changed.
		*********************************************/
		switch (FieldName)
		{
		/*case &quot;Mandatory Payment&quot;:
			CreateMandatoryPayActivity();
			break;
		*/	
		/*********************************************
		*	VLim 13/12/2004 - Create an activity when 
		*	the Presentment, Bill Media or Suspend Payment
		*	has been updated.
		*********************************************/
		/*
		case &quot;Presentment&quot;:
			CreatePresentmentActivity();
			break;
			
		case &quot;Media Type&quot;:
			CreateBillMediaActivity();
			break;
			
		case &quot;Suspend Payment&quot;:
			CreateSuspendPaymentActivity();
			break;
		*/	
		/************************************************
		*	MSL 27/01/05 Clear the CCP Reg Id if the 
		*	Payment Type Changes from VCC. Don&apos;t write record
		*	incase the user wished to Undo their change.
		*************************************************/
		
		// Benita 28/03/07 Commented out and replaced Marvin&apos;s code 
		
		//case &quot;Payment Type&quot;:
		//	if(this.GetFieldValue(&quot;ARII&quot;) == &quot;New Zealand&quot;)
		//		if(this.GetFieldValue(FieldName) != &quot;VCC&quot;)
		//			this.SetFieldValue(&quot;CCP Reg Id&quot;, &quot;&quot;);
		//	break;
			
		/************************************************
		*	Benita 28/03/07 Clear the CCP Reg Id and trigger a page 
		*   refresh if the Payment Type Changes from VCC . 
		*   Don&apos;t write record in case the user wished to 
		*   Undo their change.
		*************************************************/
		case &quot;Credit Card Number - Display&quot;:
		case &quot;CC Number Token Not Enc&quot;:	//Indumathi: 03/01/2018 - Added for Kogan
		case &quot;Credit Card Number&quot;:
				TheApplication().SetProfileAttr(&quot;BypassCCNumValidation&quot;,&quot;N&quot;);
                                  	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
		break;
		
		case &quot;Payment Type&quot;:
			// /VF HARIKM 18/10/2011 R11E
			//03/04/2019: Pallavi :Modified for unified application
			/*if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot;
				&amp;&amp; TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel Power Communications&quot;)*/
				if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot;
				&amp;&amp; TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Care&quot;))
		       {
		       	this.SetUserProperty(&quot;PaymentMethodUpdt&quot;, &quot;Payment Method&quot;);
		       }
		       //VF End	
		    	break;	
		case &quot;VHA Delivery Method Calc&quot;://Nithu added for 17.1 CIR
				mDelivery(this.GetFieldValue(&quot;VHA Delivery Method Calc&quot;));
				break; 
		case &quot;Bill Charges Override Reason&quot;:
				mPaperBillReasonCode(this.GetFieldValue(&quot;Bill Charges Override Reason&quot;));
				break;   	
		case &quot;Email Bill To&quot;:
		case &quot;Allow Email To Use For Marketing&quot;://R13.0,Spam Phase2,21-12-2012,VIJAYE
				//03/04/2019: Pallavi :Modified for unified application
				/*if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; 
					&amp;&amp; TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel Power Communications&quot;)*/
				if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; 
					&amp;&amp; TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Care&quot;))
		       {
		       	this.SetUserProperty(&quot;EmailBillToUpdt&quot;, &quot;Email Address - Billing&quot;);
		       }
		       if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; 
					&amp;&amp; this.GetFieldValue(&quot;Allow Email To Use For Marketing&quot;)==&quot;Y&quot;)//R13.0,Spam Phase2,21-12-2012,VIJAYE,Start
		       {
		       	this.SetUserProperty(&quot;VFUpdateEmailFlg&quot;, &quot;Y&quot;);
		       }
		       else
		       	this.SetUserProperty(&quot;VFUpdateEmailFlg&quot;, &quot;N&quot;);//R13.0,Spam Phase2,21-12-2012,VIJAYE,End
			break;
		
		
		case &quot;Suspend Payment&quot;:
				//03/04/2019: Pallavi :Modified for unified application
				/*if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; 
					&amp;&amp; this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Direct Debit&quot;
					&amp;&amp; TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel Power Communications&quot;)*/
				if(this.GetFieldValue(&quot;Payment Method&quot;) == &quot;Postpay&quot; 
					&amp;&amp; this.GetFieldValue(&quot;Payment Type&quot;) == &quot;Direct Debit&quot;
					&amp;&amp; TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Care&quot;))
		       {
		       	 this.SetUserProperty(&quot;SuspendPaymentUpdt&quot;, &quot;Suspend Payment - Direct Debit&quot;);
		       }
			break;
	 	// VF end of code HARIKM 18/10/2011 R11E
	 			
		//TAlihos 21/02/2005 Added case statement to set global variable
		case &quot;Payment Method&quot;:
			gNewPaymentMethod = this.GetFieldValue(&quot;Payment Method&quot;);
			if (gNewPaymentMethod == gOldPaymentMethod)
			{
				gPaymentMethodChanged = false;
			}
			else
			{
				gPaymentMethodChanged = true;
			}
			
		    break;
		    	    
case &quot;Bank Account Name&quot; :
	     case &quot;Bank Account Number&quot; :
	     case &quot;Bank Branch&quot; :
	     case &quot;Direct Debit Reference&quot; :
	     	this.SetUserProperty(&quot;DirectDebitStatus&quot;, &quot;Y&quot;); 
	       	break; 
	     case &quot;Credit Card Type&quot; :
	     case &quot;Expiration Year&quot; :
	     case &quot;Expiration Month&quot; :
	     case &quot;Credit Card Name&quot; :
	     	this.SetUserProperty(&quot;CreditCardStatus&quot;, &quot;Y&quot;);
	     	break;
		 default:
			break;  
		    
		}
		//SLV 22/09/09 - Check to see if called from bulk process, if so don&apos;t check for sync account
		if (TheApplication().GetProfileAttr(&quot;bIsBulkUpdate&quot;) != &quot;Y&quot;)
		{
			// MSL - 13/10/2005 Call mCheckSyncUpdate. In its own function for neatness.
			mCheckSyncUpdate(FieldName);
		}
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e);
			TheApplication().RaiseErrorText(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e);
			TheApplication().RaiseErrorText(e); 
		}
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.SetFieldValue.strError= &quot; + strError);
		}
		var strDisplayError = ErrorHandling(strError, &quot;BusComp_SetFieldValue&quot;);
		TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.SetFieldValue&quot;);
		}	
	}
}"
			   SEQUENCE="31"
			   UPDATED="05/15/2019 23:31:34"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : BusComp_WriteRecord
 * Component Information : Standard event
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 13/01/2005	MSL					Call mSyncAccount for certain fields (See mCheckSyncUpdate)
 * 09/02/2005	VLim				Create Activity if Bill Media, Presentment,  
 *									Suspend Payment or Mandatory Payment has changed.
 * 21/02/2005	TAlihos				Added logic to refereshScreen if payment method ,  
 *									has changed
 * 02/05/2006	JSK		DF13288		Comment out CreatePresentmentActivity();		
 *									this will be moved to PreWriteRecord.  
 * 28/03/2007	Benita	DF24722		Added logic to refresh screen if the Payment Type 
 *									changed from VCC
 *
 * 14/05/2008	BaranwaS EBP		Create activity when Email OptIn flag is checked	
 * 03/07/2008	Huik	 EBP DF2702 Create activity if invoice is paper bill
 * 11/07/2008   josel   DF 8462     Added code for SR 446.
 * 18/10/2011   HARIKM	R11E		Added Code for R11E it creates record in SMS queue BC based on Userproperty Type
 * 15/11/2013	ASHOKR	QC1572		Added validation to stop unwanted activity getting created on clicking suspend payment.
 * 08/02/2014	santoshb QC 263		Commented out code for QC1572 and added one more if stmt
 */
function BusComp_WriteRecord ()
{
	try
	{
	var sActivityCommentsFld;
	var sDesc;
	var bsProcessSMS;//HARIKM R11E
	var psInputs, psOutputs;
	var sMSISDN, sAccountID, sBAN; //HARIKM R11E
	var sBillingAccId;
	var sPaymentType;
	var sStatus;
	var bsMarkPrefUpdateFlg,psMarkInputs,psMarkOutputs,boBillingAcc,bcBillingAcc;
	
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.WriteRecord&quot;);
		}
	
		/***********************************************
		* TAlihos - 21/02/2005 Lets see if payment Type has changed
		***********************************************/
		/***********************************************
		* JSK - 16/06/2005 Commented out as per instructions of Damon.
		* this is causing problems in partner portal as well as losing pointer.
		***********************************************/
	
		if (gPaymentMethodChanged)
		{
			mRefreshScreen(); //23/09/2005 semicolon added FK
			
			//reset global variable to stop the mRefreshScreen 
			//function from being called again.
			gPaymentMethodChanged = false;
		}	
	
		if (gPaymentTypeChanged)
		{
			mRefreshScreen(); //23/09/2005 semicolon added FK
			
			//reset global variable to stop the mRefreshScreen 
			//function from being called again.
			gPaymentTypeChanged = false;
		}	
		
		
	//VF-josel added for SR NZ000446	
	
	if(this.GetUserProperty(&quot;StatusChanged&quot;)== &quot;Y&quot;)
		{
			
			this.SetUserProperty(&quot;StatusChanged&quot;,&quot;N&quot;);
		
			if(this.GetUserProperty(&quot;DirectDebitStatus&quot;)== &quot;Y&quot;)
			{
				this.SetUserProperty(&quot;DirectDebitStatus&quot;,&quot;N&quot;);
				sActivityCommentsFld = &quot;Payment Type updated from &quot; + sPrevValue + &quot; to &quot; + sNewValue + &quot; and Direct Debit details has been updated.&quot;;
			}	
			else if(this.GetUserProperty(&quot;CreditCardStatus&quot;)== &quot;Y&quot;)
			{
				this.SetUserProperty(&quot;CreditCardStatus&quot;,&quot;N&quot;);
				sActivityCommentsFld = &quot;Payment Type updated from &quot; + sPrevValue + &quot; to &quot; + sNewValue + &quot; and Credit Card details has been updated.&quot;;
			}
			else
			{
				sActivityCommentsFld = &quot;Payment Type updated from &quot; + sPrevValue + &quot; to &quot; + sNewValue;
			}
			sDesc=&quot;Payment Type Updated&quot;;
			sPaymentType=TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;TODO_TYPE&quot;,&quot;Payment Type Update&quot;);
			sStatus=&quot;Done&quot;;
			mCreateActivity(sActivityCommentsFld,sDesc,sPaymentType,sStatus);
		}
		
		if(this.GetUserProperty(&quot;DirectDebitStatus&quot;)== &quot;Y&quot;)
		{
			this.SetUserProperty(&quot;DirectDebitStatus&quot;,&quot;N&quot;);
			sActivityCommentsFld = &quot;Bank Details has been Updated&quot;;
			sDesc=&quot;Bank Details Updated&quot;;
			sPaymentType=TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;TODO_TYPE&quot;,&quot;Direct Debit Update&quot;);
			sStatus=&quot;Done&quot;;
			mCreateActivity(sActivityCommentsFld,sDesc,sPaymentType,sStatus);
		
		
}
		
		if(this.GetUserProperty(&quot;CreditCardStatus&quot;)== &quot;Y&quot;)
	{
			this.SetUserProperty(&quot;CreditCardStatus&quot;,&quot;N&quot;);
			sActivityCommentsFld = &quot;Credit Card Details has been Updated&quot;;
			sDesc=&quot;Credit Card Details Updated&quot;;
			sPaymentType=TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;TODO_TYPE&quot;,&quot;Credit Card Update&quot;);
			sStatus=&quot;Done&quot;;
			mCreateActivity(sActivityCommentsFld,sDesc,sPaymentType,sStatus);
		}
			
	//VF-josel End  of code for SR NZ000446	
		
	
	
	
		/* DEJ - 12/07/2005 Uncommented briefly until final fix complete
		*/
		/***********************************************
		* MSL - 10/01/2005 Synchronise account details  
		* if certain fields have been changed.
		***********************************************/
		if (this.GetUserProperty(&quot;SyncAccount&quot;) == &quot;Y&quot;)
		{
			this.SetUserProperty(&quot;SyncAccount&quot;, &quot;N&quot;);
			mSyncAccount();
		}
		
	
		if(gSuppressPaper != &quot;&quot; || gEmailOptIn != &quot;&quot; || gBillChargesOverrideReason != &quot;&quot;) //8feb2014-QC263 -santoshb
		{
			if((gSuppressPaper != this.GetFieldValue(&quot;Suppress Paper&quot;)
			|| gEmailOptIn != this.GetFieldValue(&quot;Email Bill&quot;))
			&amp;&amp; this.GetFieldValue(&quot;Suppress Paper&quot;) == &quot;N&quot;
			&amp;&amp; this.GetFieldValue(&quot;Email Bill&quot;) == &quot;N&quot;)
			{
		
				
			//	&amp;&amp; this.GetUserProperty(&quot;EmailBill&quot;) == &quot;Y&quot;			//QC1572
			//	&amp;&amp; this.GetUserProperty(&quot;SuppressPaper&quot;) == &quot;Y&quot;)	//QC1572
			
				//	this.SetUserProperty(&quot;EmailBill&quot;, &quot;N&quot;);  		//QC1572
				//	this.SetUserProperty(&quot;SuppressPaper&quot;, &quot;N&quot;);		//QC1572
					CreatePaperBillActivity();
			//	}
			}
		}
		
		//DF8828 reset the bypass cc expiration flag
		TheApplication().SetProfileAttr(&quot;BypassCCExpirationValidation&quot;, &quot;&quot;);
		// VF HARIKM - 18/10/2011 Added for R11E project SMS on Customer detail Update
		if (this.GetUserProperty(&quot;PaymentMethodUpdt&quot;) == &quot;Payment Method&quot; || 
		this.GetUserProperty(&quot;EmailBillToUpdt&quot;) == &quot;Email Address - Billing&quot; ||
		this.GetUserProperty(&quot;SuspendPaymentUpdt&quot;) == &quot;Suspend Payment - Direct Debit&quot;)
		{
			bsProcessSMS = TheApplication().GetService(&quot;VF Process SMS Matrix Service&quot;);
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
			sMSISDN = this.GetFieldValue(&quot;MSISDN For TXT&quot;);
			sAccountID = this.GetFieldValue(&quot;Master Account Id&quot;);
			sBAN = this.GetFieldValue(&quot;Billing Account Number&quot;);
			
			psInputs.SetProperty(&quot;BAN&quot;, sBAN);
			psInputs.SetProperty(&quot;Account ID&quot;, sAccountID);
			psInputs.SetProperty(&quot;MSISDN&quot;, sMSISDN);
			if (this.GetUserProperty(&quot;PaymentMethodUpdt&quot;) == &quot;Payment Method&quot;)
			{
			  	psInputs.SetProperty(&quot;SMSType&quot;, this.GetUserProperty(&quot;PaymentMethodUpdt&quot;));
			  bsProcessSMS.InvokeMethod(&quot;VFQueueSMSNotification&quot;, psInputs, psOutputs);
			} 
			if(this.GetUserProperty(&quot;EmailBillToUpdt&quot;) == &quot;Email Address - Billing&quot;)
			{
			 	psInputs.SetProperty(&quot;SMSType&quot;, this.GetUserProperty(&quot;EmailBillToUpdt&quot;));
			  bsProcessSMS.InvokeMethod(&quot;VFQueueSMSNotification&quot;, psInputs, psOutputs);
			} 
			if(this.GetUserProperty(&quot;SuspendPaymentUpdt&quot;) == &quot;Suspend Payment - Direct Debit&quot;)
			{
			  	psInputs.SetProperty(&quot;SMSType&quot;, this.GetUserProperty(&quot;SuspendPaymentUpdt&quot;));
			  bsProcessSMS.InvokeMethod(&quot;VFQueueSMSNotification&quot;, psInputs, psOutputs);
			} 
		}
		if(this.GetUserProperty(&quot;VFUpdateEmailFlg&quot;)==&quot;Y&quot;)//R13.0,Spam Phase2,21-12-2012,VIJAYE
		{
			sBillingAccId=this.GetFieldValue(&quot;Account Id&quot;);

			if(sBillingAccId!=&quot;&quot;)
			{
				 boBillingAcc = TheApplication().GetBusObject(&quot;VF Billing Account&quot;);
		 		 bcBillingAcc = boBillingAcc.GetBusComp(&quot;VF Billing Account&quot;);
		 	 	with (bcBillingAcc)
			 	{
					ActivateField(&quot;VF Marketing Marker&quot;)
					ClearToQuery();
				 	SetViewMode(AllView);
				 	SetSearchSpec(&quot;Id&quot;, sBillingAccId);
				 	ExecuteQuery(ForwardOnly);
				 	if(FirstRecord())
				 	{
				 		SetFieldValue(&quot;VF Marketing Marker&quot;,&quot;Y&quot;);
				 		WriteRecord();
				 	}
				 }//with
			if(TheApplication().GetProfileAttr(&quot;BillProfileNew&quot;)!=&quot;Y&quot;)
				{

					bsMarkPrefUpdateFlg = TheApplication().GetService(&quot;VF Marketing Preferences Email Opt In Out Service&quot;);
					psMarkInputs = TheApplication().NewPropertySet();
					psMarkOutputs = TheApplication().NewPropertySet();
					psMarkInputs.SetProperty(&quot;EntityName&quot;, &quot;BillingProfile&quot;);
					psMarkInputs.SetProperty(&quot;BillingAccountId&quot;, sBillingAccId);
					bsMarkPrefUpdateFlg.InvokeMethod(&quot;CreateComponentRequest&quot;, psMarkInputs, psMarkOutputs);
				}
				
				
			}//if(sBillingAccId!=&quot;&quot;)
		}
		
		this.SetUserProperty(&quot;PaymentMethodUpdt&quot;,&quot;&quot;);
		this.SetUserProperty(&quot;EmailBillToUpdt&quot;,&quot;&quot;);
		this.SetUserProperty(&quot;SuspendPaymentUpdt&quot;,&quot;&quot;);
		
// End of code VF HARIKM - 18/10/2011 R11E project SMS on Customer detail Update

	TheApplication().SetProfileAttr(&quot;BypassCCNumValidation&quot;,&quot;&quot;);//15/04/2015 RR:Added to reset the profile attribute set for bypassing CC Number validation
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
			TheApplication().RaiseErrorText(e);
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
			TheApplication().RaiseErrorText(e);
		}
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:Com Invoice Profile.WriteRecord.strError= &quot; + strError);
		}
		var strDisplayError = ErrorHandling(strError, &quot;BusComp_WriteRecord&quot;);
		TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		/********************************************
		* Trace Statement
		********************************************/
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.WriteRecord&quot;);
		}
		this.SetUserProperty(&quot;VFUpdateEmailFlg&quot;, &quot;N&quot;);
		//HARIKM Nullify Objects R11E
		psInputs = null;
		psOutputs = null;
		bsProcessSMS = null;
		bsMarkPrefUpdateFlg = null;
		psMarkInputs = null;
		psMarkOutputs = null;
		bcBillingAcc	=	null;
		boBillingAcc	=	null;
		TheApplication().SetProfileAttr(&quot;BillProfileNew&quot;,&quot;N&quot;);
		gEmailOptIn = &quot;&quot;;	// 8Feb2014-santoshb-reset global variable QC#263
		gBillChargesOverrideReason = &quot;&quot; ;
		gSuppressPaper = &quot;&quot;;
		
	}
}"
			   SEQUENCE="32"
			   UPDATED="11/01/2018 14:02:00"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateBillMediaActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : CreateBillMediaActivity
 * Component Information : Standard event
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 13/12/2004	VLim				Create an activity when the Bill Media 
 *									has been updated.
 * 09/02/2005	VLim				Add Comment and change Description to be the same
 *									as Type.
 */
function CreateBillMediaActivity()
{
	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.CreateBillMediaActivity&quot;);
		}       
	
	 	var bsError;
		var	psErrorInput;
		var psErrorOutput;
		var svc = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);
		var Inputs = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();
		var sType = TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;TODO_TYPE&quot;,&quot;Bill Media Change&quot;);
			
		Inputs.SetProperty(&quot;Account Object Id&quot;, this.GetFieldValue(&quot;Account Id&quot;));
		Inputs.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);	
		Inputs.SetProperty(&quot;Type&quot;, sType);
		Inputs.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
		Inputs.SetProperty(&quot;Description&quot;, sType);
		Inputs.SetProperty(&quot;Comment&quot;, &quot;The Bill Media has been changed.&quot;);

		svc.InvokeMethod(&quot;GenerateActivity&quot;, Inputs, Outputs);
	}
	catch (e)
	{
		// Logging of the error take place at the calling function - just throw a description
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		
		psErrorInput  = TheApplication().NewPropertySet();			
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Com Invoice Profile&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;CreateBillMediaActivity&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		//*************************************
		//* Destroy Objects
		//*************************************
		psErrorInput 		= null;
		psErrorOutput 		= null;
		bsError		 		= null;
		svc 				= null;
		Inputs 				= null;
		Outputs 			= null;

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.CreateBillMediaActivity&quot;);
		}
	}
}"
			   SEQUENCE="2"
			   UPDATED="06/07/2014 00:17:27"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:27"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateEmailOptInActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : Com Invoice Profile
 * Method Name           : CreateEMailOptInActivity
 * Component Information : Standard event
 *
 * Modification History  :
 * Date			Author	Config #	Description
 * ============	=======	===========	=================================
 * 14/05/2008	BaranwaS  EBP		Create an activity when the EMail OptIn flag is checked.
  */
function CreateEmailOptInActivity()
{
	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:Com Invoice Profile.CreateEmailOptInActivity&quot;);
		}       
	
	 	var bsError;
		var	psErrorInput;
		var psErrorOutput;
		var svc = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);
		var Inputs = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();
		var sType = TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;TODO_TYPE&quot;,&quot;Default&quot;);
			
		// It places restriction on Type LOV to be the child of &apos;System Generated&apos;
		Inputs.SetProperty(&quot;Account Object Id&quot;, this.GetFieldValue(&quot;Account Id&quot;));
		Inputs.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);	
		Inputs.SetProperty(&quot;Type&quot;, sType);
		Inputs.SetProperty(&quot;Description&quot;, sType);
		Inputs.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
		Inputs.SetProperty(&quot;Comment&quot;, &quot;Customer has opted for Email Bill.&quot;);


		svc.InvokeMethod(&quot;GenerateActivity&quot;, Inputs, Outputs);
	}
	catch (e)
	{
		// Logging of the error take place at the calling function - just throw a description
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		
		psErrorInput  = TheApplication().NewPropertySet();			
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;Com Invoice Profile&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;CreatePresentmentActivity&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
		TheApplication().RaiseErrorText(strError);
	}
	finally
	{
		//*************************************
		//* Destroy Objects
		//*************************************
		psErrorInput 		= null;
		psErrorOutput 		= null;
		bsError		 		= null;
		svc 				= null;
		Inputs 				= null;
		Outputs 			= null;

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:Com Invoice Profile.CreateEmailOptInActivity&quot;);
		}
	}
}"
