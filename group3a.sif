			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPaperBillReasonCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPaperBillReasonCode(sNewReason)
{
try{
	switch(sNewReason){
		case &quot;Elderly (Never Charge)&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;Elderly&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Never Charge&quot;);
				//this.WriteRecord();
				break;
		case &quot;Disadvantaged&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Never Charge&quot;);
				//this.WriteRecord();
				break;		
		case &quot;Incarcerated (Never Charge)&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;Incarcerated&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Never Charge&quot;);
				//this.WriteRecord();
				break;
		case &quot;No Internet (Never Charge)&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;Internet Access&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Never Charge&quot;);
				//this.WriteRecord();
				break;
		case &quot;Disability (Never Charge)&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;Disability&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Never Charge&quot;);
				//this.WriteRecord();
				break;
		case &quot;Customer Requested (Charge)&quot;:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;Customer Request&quot;);
				this.SetFieldValue(&quot;Bill Charges Override&quot;, &quot;Charge&quot;);
				//this.WriteRecord();
				break;
		default:
				this.SetFieldValue(&quot;Paper Bill Reason Note&quot;, &quot;&quot;);
				break;	
		}
	return(CancelOperation);
	}
	
catch(e){

	throw(e);
	}
	
finally{

	}
}"
