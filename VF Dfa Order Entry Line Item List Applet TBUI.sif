			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateOrderCancellation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateOrderCancellation()
{
 try
 	{
     	var boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
 		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);;
 		var bcRootLineItem;
		var strFulOrderNum = this.BusComp().ParentBusComp().GetFieldValue(&quot;VF Fulfilment Order Number&quot;);
		var strFulOrderStatus =&quot;&quot;;
		var strFulOrderStatuAs = &quot;&quot;;  
		if (strFulOrderNum != &quot;&quot;)
		{
			with(bcOrder)
			{
				ActivateField(&quot;Status&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Order Number&quot;, strFulOrderNum);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					strFulOrderStatus = GetFieldValue(&quot;Status&quot;);
					if(strFulOrderStatus == &quot;Cancelled&quot;)
					{
						//Allow Cancel
				 	}
				 	else
				 	{
						throw(&quot;Connect Order cannot be Cancelled/Deleted as the related fulfilment Order: &apos;&quot;+strFulOrderNum+&quot;&apos; is in the status : &quot;+ strFulOrderStatus);
			 		}
				}	
			}
		}
 	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e);
		}
		TheApplication().RaiseErrorText(strError);
	}
 	finally
 	{
		bcOrder = null;
		boOrder = null;
 	}
}"
