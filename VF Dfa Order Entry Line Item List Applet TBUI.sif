			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCancelServiceOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCancelServiceOrder(MethodName)
{
try
{
	var bsRespCheck;
 	var psInputs;
 	var psOutputs;
 	var sExists = &quot;&quot;;
 	var psInput1,psOutput1,svc1;
 	var boOrder,bcOrderLineItem,boAsset,bcOffer,bcAsset,strAssetIntId,strAssetId,strOrderId,psInput,psOutput,svc;
 	this.BusComp().ActivateField(&quot;VF Stock Indicator TBUI&quot;);
 	this.BusComp().ActivateField(&quot;VF TNR Id&quot;);
	var strStockIndicator =	this.BusComp().GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
	var strVFTNRId =	this.BusComp().GetFieldValue(&quot;VF TNR Id&quot;);
	
	boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
	bcOrderLineItem = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
	bcOrderLineItem.ClearToQuery();
	bcOrderLineItem.SetViewMode(AllView);
	bcOrderLineItem.InvokeMethod(&quot;SetAdminMode&quot;, &quot;TRUE&quot;)
	bcOrderLineItem.SetSearchSpec(&quot;Id&quot;,this.BusComp().GetFieldValue(&quot;Root Order Item Id&quot;));
	bcOrderLineItem.ExecuteQuery();
	
	if (bcOrderLineItem.FirstRecord())
	{
		
		strOrderId = this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;);
	//	strAssetIntId = bcOrderLineItem.GetFieldValue(&quot;Asset Integration Id&quot;);
	
		mDeleteFulfilmentItem(); //Subramanian : Added for deleting fulfilment items 	
		svc	= TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		psInput = TheApplication().NewPropertySet();
		psOutput = TheApplication().NewPropertySet();
		psInput.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Cancel Order&quot;);
		psInput.SetProperty(&quot;TNRId&quot;, strVFTNRId);
		if(MethodName == &quot;VFDeleteRecord&quot;)
		psInput.SetProperty(&quot;RemoveService&quot;, &quot;Y&quot;);
		
		psInput.SetProperty(&quot;Object Id&quot;, this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;));
		psInput.SetProperty(&quot;RootLineItemId&quot;, this.BusComp().GetFieldValue(&quot;Root Order Item Id&quot;));
		svc.InvokeMethod(&quot;RunProcess&quot;, psInput, psOutput);
		CheckAndProcessPromotion (MethodName);
		if(MethodName == &quot;VFDeleteRecord&quot;)
		{
			bcOrderLineItem.DeleteRecord();
			psInput1 = TheApplication().NewPropertySet();
			psOutput1 = TheApplication().NewPropertySet();
			svc1 = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
			psInput1.SetProperty(&quot;OrderId&quot;, this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;));
			svc1.InvokeMethod(&quot;UpdateLineNumber&quot;, psInput1, psOutput1);
			psInput1.Reset();
			psOutput1.Reset();
			psInput1.SetProperty(&quot;Connect Order Id&quot;, this.BusComp().ParentBusComp().GetFieldValue(&quot;Id&quot;));
			TheApplication().GetService(&quot;VF Order Comments and Validation Msg Concatenation&quot;).InvokeMethod(&quot;UpdateMessageAndComments&quot;, psInput1, psOutput1);
		}
	}
	
 }
	catch (e)
	{
		if(defined(e.errText))
		{
			var sErrorMessage = arguments.callee + e.errText + &quot;/r/n&quot; + ToString(e);
		}
		else
		{
			var sErrorMessage = arguments.callee + ToString(e);
		}
		throw(sErrorMessage);
	}
	finally
	{
		bcOrderLineItem = null;
		boOrder  = null;
		bcOffer = null;
		bcAsset = null;
		boAsset = null;
		psInput = null;
		psOutput = null;
		svc = null;
		psInputs = null;
		psOutputs = null;
		bsRespCheck = null;
		psInput1 = null;
		psOutput1 = null;
		svc1 = null;
	}
}"
