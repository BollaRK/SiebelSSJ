			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTrimErrorMessage"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTrimErrorMessage(sErrorMsg)
{
var pattern3 = /\s*$/g; //Regular Expression for trailing spaces
var pattern4 = /^\s*/g; //Regular Expression for leading spaces
var pattern5 = /\s\s+/g; //Regular Expresion for double spaces
var pattern6 = /\n\r/g; //replace new lines with a blank.
var pattern7 = /\n/g; //replace new lines with a blank.
var pattern8 = /[\n\r]/g; //replace new lines with a blank.
var pattern9 = /[\n]/g; //replace new lines with a blank.
var output = sErrorMsg.replace(pattern3 ,&quot;&quot;);
output = output.replace(pattern4 ,&quot;&quot;);
output = output.replace(pattern5,&quot;&quot;);
output = output.replace(pattern6,&quot;&quot;);
output = output.replace(pattern7,&quot;&quot;);
output = output.replace(pattern8,&quot;&quot;);
output = output.replace(pattern9,&quot;&quot;);
var sSearchText = &quot;(SBL-BPR-00183)--&quot;;
var sSearchTextLen = sSearchText.length;
var sFind = output.lastIndexOf(sSearchText);
var sFullLen = output.length;
if (sFind != &quot;0&quot;)
{
var sFormattedText = output.substring(sFind+sSearchTextLen ,sFullLen);
return(sFormattedText);
}
else
{
return(sErrorMsg);
}


}"
