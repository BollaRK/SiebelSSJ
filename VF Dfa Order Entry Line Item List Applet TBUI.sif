			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteFulfilmentItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteFulfilmentItem()
{
	try
	{
		var orderHId =	this.BusComp().GetFieldValue(&quot;Order Header Id&quot;);
		var sBC = TheApplication().GetBusObject(&quot;VF Task Fulfilment Items&quot;).GetBusComp(&quot;VF Task Fulfilment Items&quot;);
		var sLineId = this.BusComp().GetFieldValue(&quot;Id&quot;);
		with(sBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Order Id&quot;,orderHId);
			SetSearchSpec(&quot;VF Line Item Id&quot;,sLineId);
			ExecuteQuery();
			if(FirstRecord())
			{
				DeleteRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sBC = null;
	}	
}"
