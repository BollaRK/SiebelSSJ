			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckAndProcessPromotion"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckAndProcessPromotion (MethodName)
// Nikhil Joshi: 15.08.2014: Added below code for Promotion Bundling
{
	try
	{
		var sApp = TheApplication(),bsVFProcessPromotion;
		var psInput = sApp.NewPropertySet();
		var psOutput = sApp.NewPropertySet();
		var thisLineItem = this.BusComp();
		thisLineItem.ActivateField(&quot;Product Type Calc&quot;);
		thisLineItem.ActivateField(&quot;Prod Prom Instance Id&quot;);
		if(MethodName == &quot;VFDeleteRecord&quot; &amp;&amp; thisLineItem.GetFieldValue(&quot;Product Type Calc&quot;) == &quot;Promotion&quot;)
		{
			psInput = sApp.NewPropertySet();
			psOutput = sApp.NewPropertySet();
			bsVFProcessPromotion = sApp.GetService(&quot;VF Process Promotion&quot;);
			thisLineItem.ActivateField(&quot;Asset Integration Id&quot;);
			thisLineItem.ActivateField(&quot;Product Id&quot;);
			psInput.SetProperty(&quot;Delete Items&quot;, &quot;Y&quot;);
			psInput.SetProperty(&quot;Order Id&quot;, thisLineItem.ParentBusComp().GetFieldValue(&quot;Id&quot;));
			psInput.SetProperty(&quot;Promotion Integration Id&quot;, thisLineItem.GetFieldValue(&quot;Asset Integration Id&quot;));
			psInput.SetProperty(&quot;Promotion Product Id&quot;, thisLineItem.GetFieldValue(&quot;Product Id&quot;));
			bsVFProcessPromotion.InvokeMethod(&quot;Remove Promotion Items&quot;, psInput, psOutput);
		}
		else if(MethodName == &quot;VFCancel&quot; &amp;&amp; thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;) != &quot;&quot; &amp;&amp;
		thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;) != null)
		{
			psInput = sApp.NewPropertySet();
			psOutput = sApp.NewPropertySet();
			bsVFProcessPromotion = sApp.GetService(&quot;VF Process Promotion&quot;);
			thisLineItem.ActivateField(&quot;Prod Prom Id&quot;);
			thisLineItem.ActivateField(&quot;Product Id&quot;);
			thisLineItem.ActivateField(&quot;Service Account Id&quot;);
			psInput.SetProperty(&quot;Account Id&quot;, thisLineItem.GetFieldValue(&quot;Service Account Id&quot;));
			psInput.SetProperty(&quot;Check Product Id&quot;, thisLineItem.GetFieldValue(&quot;Product Id&quot;));
			psInput.SetProperty(&quot;Promotion Integration Id&quot;, thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;));
			psInput.SetProperty(&quot;Promotion Product Id&quot;, thisLineItem.GetFieldValue(&quot;Prod Prom Id&quot;));
			bsVFProcessPromotion.InvokeMethod(&quot;Verify Promotion Cardinality&quot;, psInput, psOutput);
			if(psOutput.GetProperty(&quot;Cardinality Valid&quot;) == &quot;N&quot;)
			{
				thisLineItem.ActivateField(&quot;MSISDN&quot;);
				thisLineItem.ActivateField(&quot;New MSISDN&quot;);
				thisLineItem.ActivateField(&quot;VF Line Number&quot;);
				if(thisLineItem.GetFieldValue(&quot;MSISDN&quot;) != &quot;&quot; &amp;&amp; thisLineItem.GetFieldValue(&quot;MSISDN&quot;) != null)
					sMsisdn = thisLineItem.GetFieldValue(&quot;MSISDN&quot;);
				if(thisLineItem.GetFieldValue(&quot;New MSISDN&quot;) != &quot;&quot; &amp;&amp; thisLineItem.GetFieldValue(&quot;New MSISDN&quot;) != null)
					sMsisdn = thisLineItem.GetFieldValue(&quot;New MSISDN&quot;);
				boOrder = sApp.GetBusObject(&quot;Order Item&quot;);
				bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
				with(bcOrderLineIt)
				{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Action Code&quot;);
					ActivateField(&quot;Asset Integration Id&quot;);
					ActivateField(&quot;Billing Account Id&quot;);
					ActivateField(&quot;Product Id&quot;);
					ActivateField(&quot;Root Asset Id&quot;);
					ActivateField(&quot;Service Account Id&quot;);
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND ([Asset Integration Id] = &apos;&quot;+
					thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;)+&quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					for(bRecord=FirstRecord();bRecord;bRecord=NextRecord())
					{
						if(GetFieldValue(&quot;Root Asset Id&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;Root Asset Id&quot;) != null)
							sPromotionId = GetFieldValue(&quot;Root Asset Id&quot;);
						else
							sPromotionId = GetFieldValue(&quot;Asset Integration Id&quot;);
						sPromotionProductId = GetFieldValue(&quot;Product Id&quot;);
						sBillingAccount = GetFieldValue(&quot;Billing Account Id&quot;);
						sCustomerAccountId = GetFieldValue(&quot;Service Account Id&quot;);
						psInput.Reset();
						psOutput.Reset();
						psInput.SetProperty(&quot;Asset Id&quot;, sPromotionId);
						psInput.SetProperty(&quot;Asset Product Id&quot;, sPromotionProductId);
						psInput.SetProperty(&quot;Billing Account&quot;, sBillingAccount);
						psInput.SetProperty(&quot;Customer Account Id&quot;, sCustomerAccountId);
						psInput.SetProperty(&quot;Error Msg&quot;, &quot;Promotion definition Invalidated (Promotion Id: &quot;+
						thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;)+&quot;) due to Cancellation of &quot;+
						&quot;Service Order Id \&quot;&quot;+thisLineItem.GetFieldValue(&quot;Id&quot;)+&quot;\&quot; with MSISDN: &quot;+sMsisdn);
						psInput.SetProperty(&quot;Error Num&quot;, &quot;99998&quot;);
						psInput.SetProperty(&quot;FunctionName&quot;, &quot;CheckAndProcessPromotion&quot;);
						psInput.SetProperty(&quot;Msisdn&quot;, sMsisdn);
						psInput.SetProperty(&quot;Notes&quot;, &quot;Promotion definition Invalidated (Promotion Id: \&quot;&quot;+
						thisLineItem.GetFieldValue(&quot;Prod Prom Instance Id&quot;)+&quot;\&quot;) due to Cancellation of &quot;+
						&quot;Service Order Id \&quot;&quot;+thisLineItem.GetFieldValue(&quot;Id&quot;)+&quot;\&quot; with MSISDN: &quot;+sMsisdn);
						psInput.SetProperty(&quot;Order Id&quot;, thisLineItem.ParentBusComp().GetFieldValue(&quot;Id&quot;));
						psInput.SetProperty(&quot;Root Line Item Id&quot;, thisLineItem.GetFieldValue(&quot;Id&quot;));
						psInput.SetProperty(&quot;SourceName&quot;, &quot;VF Order Entry - Line Item List Applet&quot;);
						bsVFProcessPromotion.InvokeMethod(&quot;Log Invalid Promotion Exception&quot;, psInput, psOutput);
					}
				}
			}
		}
	}
	catch(e)
	{
		sApp.RaiseErrorText(e.errText);
	}
	finally
	{
		psOutput = psInput = bsVFProcessPromotion = null;

		/*Below variables are nullified by Sharukh on 28/03/2019*/
		thisLineItem = null;
	}
}"
			   SEQUENCE="1"
			   UPDATED="01/09/2026 16:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:52"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
