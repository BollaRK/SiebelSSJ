			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRetrieveChurnFactor"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Utilities
 * Method Name           : 	mRetrieveChurnFactor
 * Component Information :  This function gets the Churn Score Factor
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/01/2014	HR						Added code for Reconnection Tool Release 14.0
 */
function mRetrieveChurnFactor(sChurnScore)
{
	// Declare variables
	var boChurnFactorMatrix;
	var bcChurnFactorVersion;
	var bcChurnFactorMatrix;
	var strErrId;
	var bsSystemPrefChurn;

	var ChurnFactor = &quot;&quot;;
	var sDefaultChurnFactor = &quot;VF CVM Churn Factor&quot;;
	var psErrorInput = TheApplication().NewPropertySet();
	var psInputs_Churn = TheApplication().NewPropertySet();
	var psOutputs_Churn = TheApplication().NewPropertySet();
	var sSystemPrefChurn;
	
	try
	{
						
		// Query the recommended offers matrix
		boChurnFactorMatrix = TheApplication().GetBusObject(&quot;VF CVM Churn Factor Matrix&quot;);
		bcChurnFactorVersion = boChurnFactorMatrix.GetBusComp(&quot;VF CVM Churn Factor Version Control&quot;);
		bcChurnFactorMatrix = boChurnFactorMatrix.GetBusComp(&quot;VF CVM Churn Factor Matrix&quot;);
		
		bsSystemPrefChurn = TheApplication().GetService(&quot;VF Get System Preference&quot;);
		
		with (bcChurnFactorVersion)
		{
			ClearToQuery();
			ActivateField(&quot;Version Status&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
			ExecuteQuery(ForwardOnly);
			
			if (FirstRecord())
			{
				with (bcChurnFactorMatrix)
				{
					ClearToQuery();
					ActivateField(&quot;Churn Factor&quot;);
					ActivateField(&quot;Churn Score&quot;);
					
					SetViewMode(AllView);

					SetSearchSpec(&quot;Churn Score&quot;, sChurnScore);
					ExecuteQuery(ForwardOnly);

					if (FirstRecord())
					{
						// Set the outputs
						ChurnFactor = GetFieldValue(&quot;Churn Factor&quot;);
						
			
					}
					else
		    		{        	 		           		
		       		 	psInputs_Churn.SetProperty(&quot;System Preference Name&quot;,&quot;VF CVM Churn Factor&quot;);	
						bsSystemPrefChurn.InvokeMethod(&quot;Get System Preference&quot;,psInputs_Churn,psOutputs_Churn);
						ChurnFactor = psOutputs_Churn.GetProperty(&quot;System Preference Value&quot;);
				       	
				       	//Sanjeev - 27/08/2018 R18.4 SIT Defect#53 - Below code commented out and modified code written below it	 		       		 	
			       		/*psErrorInput.SetProperty(&quot;SourceName&quot;, bcChurnFactorMatrix.Name());
						psErrorInput.SetProperty(&quot;FunctionName&quot;, this.Name());
						psErrorInput.SetProperty(&quot;Error Msg&quot;, &quot;Churn Score - &quot; + sChurnScore + &quot; - value does not exist in matrix. System Preference &quot;+sDefaultChurnFactor+&quot; &quot;+ChurnFactor+&quot; was used to default&quot;); 
						psErrorInput.SetProperty(&quot;Error Code&quot;, &quot;99998&quot;);
						psErrorInput.SetProperty(&quot;Login Id&quot;, TheApplication().LoginName());
						psErrorInput.SetProperty(&quot;Notes&quot;, &quot;Error in &quot; + bcChurnFactorMatrix.Name());
						strErrId = bcChurnFactorMatrix.logError(psErrorInput);*/ 
					
						psErrorInput.SetProperty(&quot;SourceName&quot;, &quot;VF CVM Churn Factor Matrix&quot;);
						psErrorInput.SetProperty(&quot;FunctionName&quot;, &quot;mRetrieveChurnFactor&quot;);
						psErrorInput.SetProperty(&quot;Error Msg&quot;, &quot;Churn Score - &quot; + sChurnScore + &quot; - Value does not exist in matrix. System Preference VF CVM Churn Factor &quot;+ChurnFactor+&quot; was used to default&quot;); 
						psErrorInput.SetProperty(&quot;Error Code&quot;, &quot;99998&quot;);
						psErrorInput.SetProperty(&quot;Login Id&quot;, TheApplication().LoginName());
						psErrorInput.SetProperty(&quot;Notes&quot;, &quot;Error in VF CVM Churn Factor Matrix&quot;);
						var bsErrorHandling = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
						var psErrorOutput = TheApplication().NewPropertySet();
						bsErrorHandling.InvokeMethod(&quot;LogException&quot;, psErrorInput, psErrorOutput);
						strErrId = psErrorOutput.GetProperty(&quot;Error Row Id&quot;);
						//End of Code written for R18.4 SIT Defect#53
		    		}
				}			
			}
		}
		
		return(ChurnFactor);	
	}
	catch (e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw e;
	}
	finally
	{
		bcChurnFactorMatrix = null;
		bcChurnFactorVersion = null;
		boChurnFactorMatrix = null;

		
  	/*Below variables are nullified by Sharukh on 02/04/2019*/
		/*psErrorInput = null;
		psInputs_Churn = null;
		psOutputs_Churn = null;
		bsSystemPrefChurn = null;
		bsErrorHandling = null;
		psErrorOutput = null;*/
        
		/*Below variables are nullified by BALAGURU on 03/10/2019*/
		if(defined(psErrorInput)) { psErrorInput = null; }
		if(defined(psInputs_Churn)) { psInputs_Churn = null; }
		if(defined(psOutputs_Churn)) { psOutputs_Churn = null; }
		if(defined(bsSystemPrefChurn)) { bsSystemPrefChurn = null; }
		if(defined(bsErrorHandling)) { bsErrorHandling = null; }
		if(defined(psErrorOutput)) { psErrorOutput = null; }

	}
}"
