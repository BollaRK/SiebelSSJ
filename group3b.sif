			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mTruncate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mTruncate(sValue)
{
/*
 * Component Name        :  VF Upgrade Smartscript Service
 * Method Name           :  mSetRODebugger
 * Component Information :  This method will populate the RO Debugger Fields.
 *
 * Modification History  :
 * Date   		Author  		   Config # 	Description
 * ============ ===============	 =========== ================================
 * 05/01/2014 	Vishal Shanbhag     R 14.0		Initial Version
 * 11/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
try
{
	var sPoint = sValue.indexOf(&quot;.&quot;);
	if(sPoint != -1)
	{
	var sLeft = sValue.substring(0, sPoint);
	var sRight = sValue.substring(sPoint+1, sPoint+3);

	if (sRight == &quot;&quot; || sRight == null )
	{
	sRight = &quot;00&quot;;
	}

	var sTruncValue = sLeft + &quot;.&quot; + sRight;
	}
	else
	{
	sTruncValue = sValue;
	}
	return(sTruncValue);
}
catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{

	}
}"
			   SEQUENCE="40"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCreditAmount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mValidateCreditAmount
 * Component Information :  Validates the CVM Credit amount
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/10/2012	EW						Code moved from PreSetFieldValue
 */
function mValidateCreditAmount(FieldValue)
{
	try
	{
		var sErrorMsg = &quot;&quot;;
		
		// Get the current amount in this field
		var nOldCreditAmt = ToNumber(GetFieldValue(&quot;RO Customer Credit Incl GST&quot;));
				
		// Get the new amount
		var nNewCreditAmt = ToNumber(FieldValue);
				
		if (nNewCreditAmt &lt; 0)
		{
			sErrorMsg = &quot;Please enter an amount greater or equal to zero.&quot;;
			return (sErrorMsg);
		}
				
		// Get the difference
		var nDiff = nNewCreditAmt - nOldCreditAmt;
				
		// Get the remaining target subsidy
		var sManagerOverride = GetFieldValue(&quot;RO Manager Override&quot;);
		var nRemainingTarget = ToNumber(GetFieldValue(&quot;RO Remaining Target Subsidy Incl GST&quot;));
		var nRemainingMax = ToNumber(GetFieldValue(&quot;RO Remaining Max Subsidy Incl GST&quot;));
				
		// If this is a store manager, allow them to go to the max
		if (sManagerOverride == &quot;Y&quot;)
		{
			// Get the maximum total credit allowed
			var nMaxTotalAmt = ToNumber(GetFieldValue(&quot;RO Max Total Credit Amt&quot;));
				
			// Check if the total amount is greater than the max allowed by system preference
			if (nNewCreditAmt &gt; nMaxTotalAmt)
			{
				sErrorMsg = mFormatErrorMessage(&quot;The total amount you have entered for store customer credit is greater than the maximum allowed by the system%s.  Please re-enter&quot;, nMaxTotalAmt);
			}
			else if (nDiff &gt; nRemainingMax)
			{
				sErrorMsg = mFormatErrorMessage(&quot;This exceeds the maximum amount that you can override%s.  Please re-enter.&quot;, nRemainingMax + nOldCreditAmt);
			}
			else
			{
				if (nDiff &gt; nRemainingTarget)
				{
					this.SetFieldValue(&quot;RO Manager Has Overridden&quot;, &quot;Y&quot;);
				}
			}
		}
				
		// Otherwise only allow them to go to the target
		else
		{
			// Get the maximum target credit allowed
			var nMaxTargetAmt = ToNumber(GetFieldValue(&quot;RO Max Target Credit Amt&quot;));
				
			// Check if the total amount is greater than the max allowed by system preference
			if (nNewCreditAmt &gt; nMaxTargetAmt)
			{
				sErrorMsg = mFormatErrorMessage(&quot;The total amount you have entered for store customer credit is greater than the maximum allowed by the system%s.  Please re-enter&quot;, nMaxTargetAmt);
			}				
				
			// If the difference is more than the remaining target subsidy
			else if (nDiff &gt; nRemainingTarget)
			{
				sErrorMsg = mFormatErrorMessage(&quot;This exceeds the maximum amount that you can override%s.  Please re-enter.&quot;, nRemainingTarget + nOldCreditAmt);
			}
		}
											
		// Check if the credit is a one-off
		if (GetFieldValue(&quot;RO Customer Credit Period&quot;) == 1)
		{
			// Get the maximum one-off credit allowed
			var nMaxOneOffAmt = ToNumber(GetFieldValue(&quot;RO Max One Off Credit Amt&quot;));
					
			// Check if the one-off is greater than the max allowed by system preference
			if (nNewCreditAmt &gt; nMaxOneOffAmt)
			{
				sErrorMsg = mFormatErrorMessage(&quot;The amount you have entered for this one-off store customer credit is greater than the maximum allowed by the system%s.  Please re-enter&quot;, nMaxOneOffAmt);
			}
		}
		return (sErrorMsg);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
