			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mFormatErrorMessage"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 
 * Method Name           : 	mFormatErrorMessage
 * Component Information : 	Formats CVM error message
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 08/08/2012	EW						Created for 12.6 CVM RO Phase 2
 * 06/04/2019	Christy					Added for Unified Application
 */

function mFormatErrorMessage(sErrorMessage, nAmount)
{
	var sReplaceText = &quot;&quot;;
	var nRoundedAmount;
	var sUpdatedErrorMessage = &quot;&quot;;
	
	try
	{
		//06/04/2019: Christy :Modified for unified application
		//if (TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) != &quot;Siebel eChannel for CME&quot;)
		if (TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) != TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Retail&quot;))
		{
			nRoundedAmount = Math.round(nAmount * 100) / 100;
			
			sReplaceText = &quot; ($&quot; + nRoundedAmount + &quot;)&quot;;
		}
		
		Clib.sprintf(sUpdatedErrorMessage, sErrorMessage, sReplaceText);
		
		return (sUpdatedErrorMessage);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
