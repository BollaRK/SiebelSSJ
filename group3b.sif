			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetProductIdFromName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetProductIdFromName(ProductName)
{
/*
 * Component Name        : 	VF Upgrade Offer
 * Method Name           : 	GetProductIdFromName
 * Component Information : 	Finds the parent proposition for a primary plan.
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 05/05/2016	Roseline	R16.2 CIRs	Initial Version - SIT defect #55                      
 */
 	try
	{
		var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);

		var sProdName = ProductName;
		var sProdId;

		if(sProdName != null &amp;&amp; sProdName != &quot;&quot;)
		{
			with(bcProduct)
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Name&quot;,sProdName);
				ExecuteQuery();
				
				if(FirstRecord())
					sProdId = GetFieldValue(&quot;Id&quot;);
			}

		}
				
		return(sProdId);
	}
	catch(e)
	{
	
		throw (e);	
	}
	finally
	{
		bcProduct = null;
		boProduct = null;	
	}
}"
