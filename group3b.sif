		   NO_DELETE="N"
		   NO_INSERT="N"
		   NO_MERGE="N"
		   NO_UPDATE="N"
		   OBJECT_LOCKED="N"
		   OWNER_DELETE="N"
		   POPUP_VISIBILITY_AUTO_ALL="N"
		   SCRIPTED="Y"
		   TABLE="S_TU_LOG"
		   TYPE="Transient"
		   UPDATED="04/13/2019 23:31:50"
		   UPDATED_BY="SADMIN"
		   CREATED="04/07/2014 16:30:39"
		   CREATED_BY="SADMIN">
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{	
/*
 * Component Name        : VF Credit Check Status TBC	
 * Method Name           : New Record
 * Component Information : 	
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 08/07/2014	Roseline	Added code to set the session id
 */	
	try
	{
		var sViewName = TheApplication().GetProfileAttr(&quot;ViewName&quot;);
		if(sViewName == &quot;FirstView&quot;)//this profile attrib will be set in each task
		{
			var sSessionId = this.GetFieldValue(&quot;Id&quot;);
			TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,sSessionId);
			this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
		}
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{

	}
}"
			   SEQUENCE="2"
			   UPDATED="08/17/2016 11:13:37"
			   UPDATED_BY="SADMIN"
