			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetMPPRemBal"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  GetMPPRemBal
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/07/2012	MP						Added code for TD15650.
 */
function GetMPPRemBal(strRootAssetId)
{
					
	try
	{
	//Get the MPP Remaining Balance
	var psInput,psOutput,bsGetMPPDetails,iMPPRemBalance = 0;
	
	psInput = TheApplication().NewPropertySet();
	psOutput = TheApplication().NewPropertySet();
	bsGetMPPDetails = TheApplication().GetService(&quot;VF MPP Toolkit Service&quot;);
	
	psInput.SetProperty(&quot;RootAssetId&quot;,strRootAssetId);
	try
	{
		bsGetMPPDetails.InvokeMethod(&quot;MPP Remaining Balance&quot;,psInput,psOutput);				
	}
	catch(e)
	{
		//Supress the exception in case of error.
		//TD#13636 SIT defect
	}
	
	iMPPRemBalance = psOutput.GetProperty(&quot;RemainingBalance&quot;);
	
	return(iMPPRemBalance);
	}
	
	catch(e)
	{
	 throw(e);
	}

	finally
	{
	psInput = null;
	psOutput = null;
	bsGetMPPDetails = null;
	}

}"
