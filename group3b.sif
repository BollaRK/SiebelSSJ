			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPerformROCalc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mPerformROCalc
 * Component Information :  This code is populates the retention optimiser fields
 *							and requeries the HaTCaT offers based upon the upgrade offer
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 05/04/2012	EW						Added code for Release 12.3.
 * 08/08/2012	EW						Updated for 12.6 CVM RO Phase 2
 */
function mPerformROCalc()
{
	// Declare variables
	var boCurrent;
	var bcHaTCaTOffers;
	var bsUpgradeUtils;

	var psInputs, psOutputs;
	
	var sPlanSAMId, sCurrentContractTerm, sCurrentMonthsInContract, sFutureContractTerm, sFutureValueBand, sChurnPropensity, sCurrentValueBand, sUpgradeType, sROFlag, sPlanInvestCtg;
	var nChurnSubsidy, nMaxSubsidy, nTargetSubsidy, nBonusSubsidy;

	try
	{
		// Get fields from current bc
		sPlanSAMId = this.GetFieldValue(&quot;New Plan Code&quot;);
		sCurrentContractTerm = this.GetFieldValue(&quot;RO Current Length of Contract&quot;);
		sCurrentMonthsInContract = this.GetFieldValue(&quot;RO Current Months in Contract&quot;);
		sFutureContractTerm = this.GetFieldValue(&quot;New Term Name Constrained&quot;);
		sChurnPropensity = this.GetFieldValue(&quot;Churn Score With Default&quot;);
		sCurrentValueBand = this.GetFieldValue(&quot;RO Customer Current Value Band&quot;);
		sUpgradeType = mGetUpgradeType(this.GetFieldValue(&quot;Scenario&quot;));
		sROFlag = mGetROFlag(sUpgradeType);
		sPlanInvestCtg = this.GetFieldValue(&quot;Plan Investment Category&quot;);
				
		// Initialise variables
		bsUpgradeUtils = TheApplication().GetService(&quot;VF Upgrade Utilities&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();
		
		psInputs.SetProperty(&quot;ChurnPropensity&quot;, sChurnPropensity);
		psInputs.SetProperty(&quot;CurrentContractTerm&quot;, sCurrentContractTerm);
		psInputs.SetProperty(&quot;CurrentMonthsInContract&quot;, sCurrentMonthsInContract);
		psInputs.SetProperty(&quot;CurrentValueBand&quot;, sCurrentValueBand);
		psInputs.SetProperty(&quot;FutureContractTerm&quot;, sFutureContractTerm);
		psInputs.SetProperty(&quot;PlanSAMId&quot;, sPlanSAMId);
		psInputs.SetProperty(&quot;UpgradeType&quot;, sUpgradeType);
		psInputs.SetProperty(&quot;PlanInvestCtg&quot;, sPlanInvestCtg);								
		
		bsUpgradeUtils.InvokeMethod(&quot;RetrieveAllSubsidyDetails&quot;, psInputs, psOutputs);

		sFutureValueBand = psOutputs.GetProperty(&quot;FutureValueBand&quot;);
		
	//  Max, Target and Best or Bonus Subsidy will be set through new Reconnection Tool Calc
	//nMaxSubsidy = ToNumber(psOutputs.GetProperty(&quot;MaxSubsidyExclGST&quot;));
	//nTargetSubsidy = ToNumber(psOutputs.GetProperty(&quot;TargetSubsidyExclGST&quot;));
	//nBonusSubsidy = ToNumber(psOutputs.GetProperty(&quot;BonusSubsidyExclGST&quot;));
	
		nChurnSubsidy = ToNumber(psOutputs.GetProperty(&quot;ChurnSubsidyExclGST&quot;));

		// Set the fields on the current bc
		this.SetFieldValue(&quot;RO Customer Future Value Band&quot;, sFutureValueBand);
		
	//  Max, Target and Best or Bonus Subsidy will be set through new Reconnection Tool Calc
	//this.SetFieldValue(&quot;RO Max Subsidy&quot;, nMaxSubsidy);
	//this.SetFieldValue(&quot;RO Target Subsidy&quot;, nTargetSubsidy);
	//this.SetFieldValue(&quot;RO Bonus Subsidy&quot;, nBonusSubsidy);
	
		mPerformSubsidyCalc();
	
		this.SetFieldValue(&quot;RO Churn Subsidy&quot;, nChurnSubsidy);
		
		// Set the RO Flag if it has not already been set
		if (this.GetFieldValue(&quot;RO Flag&quot;) == &quot;N&quot;)
		{
			this.SetFieldValue(&quot;RO Flag&quot;, sROFlag);
		}
		
		boCurrent = this.BusObject();
		
		// If in Siebel Express, get the HaTCaT offers from the current bo
		// Neel 18/05/2014 - Do the same for TBUI
		//Roseline 19/06/2014 - Changed BO name from &apos;VF TBUI&apos; to &apos;Order Entry (Sales)&apos;
		if (boCurrent.Name() == &quot;VF Wizard&quot; || this.BusObject().Name() == &quot;Order Entry (Sales)&quot;)
		{
			bcHaTCaTOffers = boCurrent.GetBusComp(&quot;VF CVM HaTCaT Upfront Offer VBC&quot;);
		}
		
		// If in Smartscript, the current bo is the Smartscript player.  Get the HaTCaT offers
		// from the picklist
		else
		{
			bcHaTCaTOffers = this.GetPicklistBusComp(&quot;Smartscript HaTCaT Offer Display&quot;);
		}
		
		// Requery the HaTCaT offers for this selection
		bcHaTCaTOffers.ClearToQuery();
				
		if (this.GetFieldValue(&quot;Offer Matrix Id&quot;) != &quot;&quot;)
		{
			bcHaTCaTOffers.SetSearchSpec(&quot;Upgrade Offer Id&quot;, this.GetFieldValue(&quot;Id&quot;));
		}
		else
		{
			bcHaTCaTOffers.SetSearchSpec(&quot;Upgrade Offer Id&quot;, &quot;&quot;);
		}
		bcHaTCaTOffers.ExecuteQuery();
		
		if (bcHaTCaTOffers.FirstRecord())
		{
			this.SetFieldValue(&quot;HaTCaT Offers Exist&quot;, &quot;Y&quot;);
		}
		else
		{
			this.SetFieldValue(&quot;HaTCaT Offers Exist&quot;, &quot;N&quot;);	
			this.SetFieldValue(&quot;HaTCaT Offers Actioned&quot;, &quot;Y&quot;);
		}
	}
	catch (e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw e;
	}
	finally
	{
		psOutputs = null;
		psInputs = null;
		bsUpgradeUtils = null;
		bcHaTCaTOffers = null;
		boCurrent = null;
	}
}"
			   SEQUENCE="26"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPerformSubsidyCalc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mPerformSubsidyCalc
 * Component Information :  This code will perform the new calculation and 
 *							populates the Max, Target and Best/Bonus Subsidy fields
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/01/2014	HR						Added code for Reconnection Tool Release 14.0
 */

function mPerformSubsidyCalc()
{

	try
	{

	// New Max Subsidy Calculation : 14.0 Reconnection Tool
	
	var sChurnScore = this.GetFieldValue(&quot;Churn Score&quot;);
	var sRCCInclusive = ToNumber(this.GetFieldValue(&quot;Total Offer RCC incl&quot;));
	var sRIVInclusive = ToNumber(this.GetFieldValue(&quot;RIV incl&quot;));
	this.ActivateField(&quot;Offer Matrix RRP incl&quot;);
	var sRRP = ToNumber(this.GetFieldValue(&quot;Offer Matrix RRP incl&quot;));
	var sValueBand = ToNumber(this.GetFieldValue(&quot;Value Band&quot;));
	var sCustCrAmt = ToNumber(this.GetFieldValue(&quot;RO Customer Credit Incl GST&quot;));
	
	
	var nMaxSubsidy;
	var nMaxSubsidyInclGST=0;
	var nTargetSubsidyInclGST=0;
	var nTargetSubsidyInclGSTPerct=0;
	var nBestSubsidyInclGST=0;
	var nBestSubsidyInclGSTPerct=0;
	var nTargetSubsidy;
	var nBonusSubsidy,psInputs1,psOutputs1,sGSTRate,pGSTRate,nGSTRate,bsSystemPref;
	var nTargetBudgetExclGST,nRemainTargetSubsidyExclGST,nBonusBudgetExclGST,nBonusSubsidyExclGST,nMaxBudgetExclGST,nMaxSubsidyExclGST;
	
   	
	   	
	   	psInputs1 = TheApplication().NewPropertySet();
		psOutputs1 = TheApplication().NewPropertySet()
		bsSystemPref = TheApplication().GetService(&quot;VF Get System Preference&quot;);
		psInputs1.SetProperty(&quot;System Preference Name&quot;,&quot;VF GST Computation Rate&quot;);	
		bsSystemPref.InvokeMethod(&quot;Get System Preference&quot;,psInputs1,psOutputs1);
		sGSTRate = psOutputs1.GetProperty(&quot;System Preference Value&quot;);
		nGSTRate = ToNumber(sGSTRate);
		pGSTRate = 1+nGSTRate/100;
	
	// Get the Churn Factor using Churn Score
	var sChurnFactor = mRetrieveChurnFactor(sChurnScore);
	// Get the Churn Factor from System Preference

	var psInputs_Churn = TheApplication().NewPropertySet();
	var psOutputs_Churn = TheApplication().NewPropertySet();
	
	var bsSystemPrefChurn = TheApplication().GetService(&quot;VF Get System Preference&quot;);
	psInputs_Churn.SetProperty(&quot;System Preference Name&quot;,&quot;VF CVM Churn Factor&quot;);	
	bsSystemPrefChurn.InvokeMethod(&quot;Get System Preference&quot;,psInputs_Churn,psOutputs_Churn);
	var sSystemPrefChurn = psOutputs_Churn.GetProperty(&quot;System Preference Value&quot;);
		
	// If Churn Factor not exist, Get the Churn Factor from System Preference, If no System Preference exist Set the Churn Score as 1
	
	if (sChurnFactor != null)
	{
		sChurnFactor = ToNumber(sChurnFactor);
	}
	else
	{		
		if (sSystemPrefChurn != null)
		{
		sChurnFactor = ToNumber(sSystemPrefChurn);
		}
		else
		{
		sChurnFactor = 1;
		}
	}
	
	// Get the Max Total Credit
	
	var psInputs_Max = TheApplication().NewPropertySet();
	var psOutputs_Max = TheApplication().NewPropertySet();
	
	var bsSystemPrefMax = TheApplication().GetService(&quot;VF Get System Preference&quot;);
	psInputs_Max.SetProperty(&quot;System Preference Name&quot;,&quot;VF CVM Dlr Max Total Credit&quot;);	
	bsSystemPrefMax.InvokeMethod(&quot;Get System Preference&quot;,psInputs_Max,psOutputs_Max);
	var sSystemPrefMax = ToNumber(psOutputs_Max.GetProperty(&quot;System Preference Value&quot;));
	
	// If RCC is 0 then RIV - RRP, If RCC &gt; 0 and Value Band is between 1 - 6 then Maximum Subsidy is RCC x Churn Factor and 
	// If Maximum Subsidy breaches Maximum Credit then Max Total Credit System Preference value as Maximum Subsidy
	
	if (sRCCInclusive == 0)
	{
	nMaxSubsidy = sRIVInclusive - sRRP; 
	this.SetFieldValue(&quot;RO Max Subsidy&quot;, nMaxSubsidy);
		if (nMaxSubsidy &gt; sSystemPrefMax)
		{
				nMaxSubsidy = sSystemPrefMax;
				this.ActivateField(&quot;Capping Maximum Available Subsidy Applied&quot;);
				this.SetFieldValue(&quot;Capping Maximum Available Subsidy Applied&quot;, &quot;Y&quot;);
				
		}
	
	}
	else if (sRCCInclusive &gt; 0)
	{
			if (sValueBand &gt;= 1 &amp;&amp; sValueBand &lt;= 6)
			{
				nMaxSubsidy = sRCCInclusive * sChurnFactor; 
				
			}	
			
			if (nMaxSubsidy &gt; sSystemPrefMax)
			{
				nMaxSubsidy = sSystemPrefMax;
				this.ActivateField(&quot;Capping Maximum Available Subsidy Applied&quot;);
				this.SetFieldValue(&quot;Capping Maximum Available Subsidy Applied&quot;, &quot;Y&quot;);
				
			}
	}
	else
	{
	nMaxSubsidy = 0;
	
	}
	nMaxBudgetExclGST = nMaxSubsidy/pGSTRate;
	nMaxSubsidyInclGST = nMaxSubsidy - sCustCrAmt;
	nMaxSubsidyExclGST = nMaxSubsidyInclGST/pGSTRate;
	
	TheApplication().SetProfileAttr(&quot;VFRemainMaxSubsidyNoCrInclGST&quot;,nMaxSubsidy);
	TheApplication().SetProfileAttr(&quot;VFMaxBudgetExclGST&quot;,nMaxBudgetExclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainMaxSubsidyInclGST&quot;,nMaxSubsidyInclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainMaxSubsidyExclGST&quot;,nMaxSubsidyExclGST);
	

	// New Target Subsidy Calculation : 14.0 Reconnection Tool
	
	var psInputs_Target = TheApplication().NewPropertySet();
	var psOutputs_Target = TheApplication().NewPropertySet();
	
	var bsSystemPrefTarget = TheApplication().GetService(&quot;VF Get System Preference&quot;);
	psInputs_Target.SetProperty(&quot;System Preference Name&quot;,&quot;VF CVM Target Subsidy Pct&quot;);	
	bsSystemPrefTarget.InvokeMethod(&quot;Get System Preference&quot;,psInputs_Target,psOutputs_Target);
	var sSystemPrefTarget = ToNumber(psOutputs_Target.GetProperty(&quot;System Preference Value&quot;));
	
	nTargetSubsidy = (sSystemPrefTarget / 100) * nMaxSubsidy;
	nTargetBudgetExclGST = nTargetSubsidy/pGSTRate;
	nTargetSubsidyInclGST = nTargetSubsidy - sCustCrAmt;
	nRemainTargetSubsidyExclGST = nTargetSubsidyInclGST/pGSTRate;
	
	TheApplication().SetProfileAttr(&quot;VFRemainTargetSubsidyNoCrInclGST&quot;,nTargetSubsidy);
	TheApplication().SetProfileAttr(&quot;VFTargetBudgetExclGST&quot;,nTargetBudgetExclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainTargetSubsidyInclGST&quot;,nTargetSubsidyInclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainTargetSubsidyExclGST&quot;,nRemainTargetSubsidyExclGST);
	
	// New Best or Bonus Subsidy Calculation : 14.0 Reconnection Tool
	
	var psInputs_Best = TheApplication().NewPropertySet();
	var psOutputs_Best = TheApplication().NewPropertySet();
	
	var bsSystemPrefBest = TheApplication().GetService(&quot;VF Get System Preference&quot;);
	psInputs_Best.SetProperty(&quot;System Preference Name&quot;,&quot;VF CVM Best Subsidy Pct&quot;);	
	bsSystemPrefBest.InvokeMethod(&quot;Get System Preference&quot;,psInputs_Best,psOutputs_Best);
	var sSystemPrefBest = ToNumber(psOutputs_Best.GetProperty(&quot;System Preference Value&quot;));
	
	nBonusSubsidy = (sSystemPrefBest / 100) * nTargetSubsidy;
	nBonusBudgetExclGST = nBonusSubsidy/pGSTRate;
	nBestSubsidyInclGST = nBonusSubsidy - sCustCrAmt;
	nBonusSubsidyExclGST = nBestSubsidyInclGST/pGSTRate;
	
	TheApplication().SetProfileAttr(&quot;VFRemainBestSubsidyNoCrInclGST&quot;,nBonusSubsidy);
	TheApplication().SetProfileAttr(&quot;VFBonusBudgetExclGST&quot;,nBonusBudgetExclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainBestSubsidyInclGST&quot;,nBestSubsidyInclGST);
	TheApplication().SetProfileAttr(&quot;VFRemainBonusSubsidyExclGST&quot;,nBonusSubsidyExclGST);
	
//	this.SetFieldValue(&quot;RO Max Subsidy&quot;, nMaxSubsidy);
//	this.SetFieldValue(&quot;RO Target Subsidy&quot;, nTargetSubsidy);
//	this.SetFieldValue(&quot;RO Bonus Subsidy&quot;, nBonusSubsidy);
	
	sSkipValidation = &quot;Y&quot;;//Neel 23.09.2014 - added
	
	this.WriteRecord();

 
	
	}	
	catch (e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw e;
	}
	finally
	{
	
		psInputs_Churn = null;
		psOutputs_Churn = null;
		psInputs_Max = null;
		psOutputs_Max = null;
		psInputs_Target = null;
		psOutputs_Target = null;	
		psInputs_Best = null;
		psOutputs_Best = null;
		psInputs1 = null;
		psOutputs1 = null;
		bsSystemPref = null;
		bsSystemPrefTarget = null;
		bsSystemPrefBest = null;
		bsSystemPrefMax = null;

		bsSystemPrefChurn = null;  /* This variable is nullified by Sharukh on 02/04/2019*/


	}

}"
			   SEQUENCE="27"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   COMMENTS="NIRMAL 05/06/2014 : VF Retrofit 8.1 Drop4"
			   INACTIVE="N"
			   NAME="mPerformUpgradeCalc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrasde Offer
 * Method Name           : 	mPerformUpgradeCalc
 * Component Information :  This code is moved over from SetFieldValue and cleaned up a bit
 * Modification History  :
 * Date			Author		Config #	Description
 * 05/06/2014 	NIRMAL		VF Retrofit Added a block of code(mKillPersonalisationProfileAttributes called to kill
 							8.1 Drop4	profile attributes introduced for CVM Personalised Pricing)
 */
function mPerformUpgradeCalc()
{
	var bsUpgradesService, bsCalculateChargeService;
	var psInputs1, psOutputs1, psInputs2, psOutputs2, psInputs3, psOutputs3;
	var sOfferId, strValueBand, strRootAssetId, strNewPlanName, strNewPlanId, sMonthsRemaining, strMonthsIntoContract, sExistingTerm, sValueBand, sDeviceCode, strDeviceName, strCurrentPlanName;
	var RIVExcl, RIVIncl;
	var sBillingAcctId,sServiceAcctId;
	var sOfferedRCCIncl;
	var sScenario, sScenarioDisplay, strPlanInvestmentCategory, sServicePriceList,sProductId;
	var nGSTRate,sFianlRIVValuePect,sFianlRIVExclValue,sFianlRCCExclValue;
	var sNewContractTerm;
	var sPlanInvestmentCategory,bsSystemPref,sGSTRate;
	var SCEN_CURRENT_PLAN_WITH_DEVICE = &quot;Current Plan with Every Device&quot;;
	var SCEN_CURRENT_PLAN_NO_DEVICE = &quot;Current Plan with No Device&quot;;
	var SCEN_EVERY_PLAN_WITH_DEVICE = &quot;Every Valid Plan with Every Device&quot;;
	var SCEN_EVERY_PLAN_NO_DEVICE = &quot;Every Plan with No Device&quot;;
	var SCEN_OUTRIGHT_DEVICE = &quot;Outright with Every Device&quot;;
	var SCEN_ACCOUNT_LEVEL_NO_DEVICE = &quot;Account Level Plan with No device&quot;;
	var sSavingsOnRIVIncl,iSavingsOnRIVIncl,sSavingsOnRIVExcl,tSavingsOnRIVExcl;
	var sEUFCharge = 0, sMPPRemBalance = 0;
	var bIsWaiveEUF;
	var RCCIncl;
	var sNewPlanCode;
	var sCurrentPlanId;
	var psInputsNew,psOutputsNew;
	var IsRoundingRuleAppliedToRCC=&quot;N&quot;;
	var IsNewAquisationRuleApplyToRCC=&quot;N&quot;;
	var sFianlRCCValue,sFianlRIVValue;	
	var isOutright=&quot;N&quot;;
	try
	{//NIRMAL 05/06/2014 : VF Retrofit 8.1 Drop4
		if (TheApplication().GetProfileAttr(&quot;PersInputsSet&quot;) == &quot;Y&quot;)
		{
			mKillPersonalisationProfileAttributes(); // To kill personalised profile attribute
	    } //Till Here. NIRMAL 05/06/2014 : VF Retrofit 8.1 Drop4
	    var sDevice = this.GetFieldValue(&quot;Device Name&quot;); //Added for PKE000000024132 fix - CHitra - 17/06/2015
	    try{this.WriteRecord();} catch(exc){var sErrText = exc.errText; if(sErrText.indexOf(&quot;selected &quot;+
	    &quot;record has been modified by another user since&quot;) &gt; -1) mSetRRP(sDevice); else throw exc;} //In catch block changed to mSetRRP function for PKE000000024132 fix - CHitra - 17/06/2015
	    
	    if(TheApplication().GetProfileAttr(&quot;Reset Resign Upgrade Choice&quot;) == &quot;False&quot;)
		{
			TheApplication().SetProfileAttr(&quot;Reset Resign Upgrade Choice&quot;, &quot;&quot;);					
		}
		else
		{// EW 31/05/2011 - If in the Merlin wizard, do not reset this
			// Neel 18/05/2014 - Perform the same logic as Merlin for TBUI
			//Roseline 19/06/2014 - Changed BO name from &apos;VF TBUI&apos; to &apos;Order Entry (Sales)&apos;
			if (this.BusObject().Name() != &quot;VF Wizard&quot; &amp;&amp; this.BusObject().Name() != &quot;Order Entry (Sales)&quot;)
			{// EW 21/09/2012 - Default this for CVM RO Phase 2
				if (this.GetFieldValue(&quot;New Plan Name&quot;) == &quot;Current Plan&quot;)
				{this.SetFieldValue(&quot;Resign Upgrade Choice&quot;, &quot;Resign&quot;);
				}
				else
				{this.SetFieldValue(&quot;Resign Upgrade Choice&quot;, &quot;N/A&quot;);	
				}
			}
			this.WriteRecord();
		}//end Kpoluru:18/06/2010 
			
		psInputs1 = TheApplication().NewPropertySet();
		psOutputs1 = TheApplication().NewPropertySet();
		psInputs2 = TheApplication().NewPropertySet();
		psOutputs2 = TheApplication().NewPropertySet();
		psInputs3 = TheApplication().NewPropertySet();
		psOutputs3 = TheApplication().NewPropertySet();
	    psInputsNew = TheApplication().NewPropertySet();
	    psOutputsNew = TheApplication().NewPropertySet();
			
		bsCalculateChargeService = TheApplication().GetService(&quot;VF Calculate Charges Service MSO&quot;);
		bsUpgradesService = TheApplication().GetService(&quot;VF Upgrade Smartscript Service&quot;);
						
		/* Mahend:20/05/10: Added for eUpgrade R10.4*/
		// Calculate and set the RIV Details
		strValueBand   = this.GetFieldValue(&quot;Value Band&quot;);
		strRootAssetId = this.GetFieldValue(&quot;Root Asset Id&quot;);
		strNewPlanName = this.GetFieldValue(&quot;New Plan Name&quot;);
		strNewPlanId = this.GetFieldValue(&quot;Offer Matrix Id&quot;);
		strMonthsIntoContract = this.GetFieldValue(&quot;Months Into Contract&quot;);
		strCurrentPlanName = this.GetFieldValue(&quot;Current Plan Name&quot;);
			
		this.ActivateField(&quot;Billing Account Id&quot;);
		this.ActivateField(&quot;Account Id&quot;);
		this.ActivateField(&quot;Service Account Price List Id&quot;);
		this.ActivateField(&quot;Product Id&quot;);
		this.ActivateField(&quot;New Plan Code&quot;);
		this.ActivateField(&quot;New Plan Id&quot;);
		this.ActivateField(&quot;Contract Length&quot;);
		this.ActivateField(&quot;Device Code Temporary&quot;);
		this.ActivateField(&quot;Plan Investment Category&quot;);
		this.ActivateField(&quot;Current Plan Id&quot;);
		this.ActivateField(&quot;Current Plan Id&quot;);
		sBillingAcctId = this.GetFieldValue(&quot;Billing Account Id&quot;);
		sServiceAcctId = this.GetFieldValue(&quot;Account Id&quot;);
		sServicePriceList = this.GetFieldValue(&quot;Service Account Price List Id&quot;);
		sProductId = this.GetFieldValue(&quot;New Plan Id&quot;);
		sNewPlanCode = this.GetFieldValue(&quot;New Plan Code&quot;);
		sOfferId = this.GetFieldValue(&quot;Id&quot;); 
		sDeviceCode = this.GetFieldValue(&quot;Device Code Temporary&quot;);
		sCurrentPlanId = this.GetFieldValue(&quot;Current Plan Id&quot;);
		
		if(strNewPlanName == &quot;Outright&quot;)
			isOutright = &quot;Y&quot;;

		if (strNewPlanName != &quot;&quot; &amp;&amp; strNewPlanName != &quot;Current Plan&quot; &amp;&amp; strNewPlanName != &quot;Outright&quot;)		{
			strPlanInvestmentCategory = mGetPlanInvestmentCategory(strNewPlanName, &quot;&quot;);
		}
		else		{
			strPlanInvestmentCategory = mGetPlanInvestmentCategory(strCurrentPlanName, &quot;&quot;);	
			sProductId = sCurrentPlanId;
			strNewPlanName = strCurrentPlanName;	
		}	
		this.SetFieldValue(&quot;Plan Investment Category&quot;, strPlanInvestmentCategory); // Added for CVM Phase 3
		this.WriteRecord();
			
		psInputs2.SetProperty(&quot;ValueBand&quot;, strValueBand);
		psInputs2.SetProperty(&quot;RootAssetId&quot;, strRootAssetId);
		psInputs2.SetProperty(&quot;NewPlanName&quot;, strNewPlanName);
		psInputs2.SetProperty(&quot;NewPlanId&quot;, strNewPlanId);
		psInputs2.SetProperty(&quot;MonthsIntoContract&quot;, strMonthsIntoContract);
		psInputs2.SetProperty(&quot;PlanInvestmentCategory&quot;, strPlanInvestmentCategory); // Added for CVM Phase 3
		
		//START: Added below code as part of  Reconnection Tool
		psInputs2.SetProperty(&quot;Billing Account Id&quot;, sBillingAcctId);
		psInputs2.SetProperty(&quot;Service Account Id&quot;, sServiceAcctId);
		psInputs2.SetProperty(&quot;Service Account Price List Id&quot;,sServicePriceList);
		psInputs2.SetProperty(&quot;Product Id&quot;,sProductId);
		psInputs2.SetProperty(&quot;Id&quot;, sOfferId);
		psInputs2.SetProperty(&quot;Plan Investment Category&quot;, sPlanInvestmentCategory);
		//END: Reconnection Tool
				
		bsUpgradesService.InvokeMethod(&quot;SetRIV&quot;, psInputs2, psOutputs2);
				
        RIVExcl= psOutputs2.GetProperty(&quot;RIV Excl&quot;);
		RIVIncl= psOutputs2.GetProperty(&quot;RIV Incl&quot;);	
		
		sExistingTerm = psOutputs2.GetProperty(&quot;Existing Term&quot;);
		sNewContractTerm = psOutputs2.GetProperty(&quot;New Contract&quot;);
		// Calculate and set the RCC for inclusive of GST
		sOfferId = this.GetFieldValue(&quot;Id&quot;);						
		psInputs1.SetProperty(&quot;Offer Id&quot;, sOfferId );
		psInputs1.SetProperty(&quot;Tax Type&quot;, &quot;Incl&quot; );
		psInputs1.SetProperty(&quot;RIV Incl&quot;, RIVIncl); //Added as part of Reconnection Tool
		bsUpgradesService.InvokeMethod(&quot;Calculate RCC&quot;,psInputs1,psOutputs1);
		this.InvokeMethod(&quot;RefreshRecord&quot;); //Nikhil Joshi: 30.09.2014: Added for Upgrade MSO
		
		var RCCIncl = psOutputs1.GetProperty(&quot;Total RCC&quot;); //Added as part of Reconnection Tool
		var sDeviceRCC = psOutputs1.GetProperty(&quot;Device RCC&quot;); //VHA 17.4/PKE/NIRMAL/20JUL2017/Added this and below block for PKE000000050477
		if (sDeviceRCC != null &amp;&amp; sDeviceRCC != &quot;&quot;) {
			this.SetFieldValue(&quot;Total Device RCC Calc Incl&quot;,sDeviceRCC);
			this.WriteRecord();
		}
		if(isOutright==&quot;Y&quot;)		{
			sFianlRCCValue = RCCIncl;
			sFianlRIVValue = RIVIncl;
		}
		if(isOutright!=&quot;Y&quot;)	
		{	//START: Added New Logic to Get FINAL RIV and FINAL RCC as part of Reconnection Tool
			psInputs1.SetProperty(&quot;RCC Incl&quot;, RCCIncl);
			psInputs1.SetProperty(&quot;New Contarct&quot;,sNewContractTerm);
			bsUpgradesService.InvokeMethod(&quot;Round Off RCC&quot;, psInputs1, psOutputs1);
			sOfferedRCCIncl = psOutputs1.GetProperty(&quot;Offer RCC Incl&quot;);
			IsRoundingRuleAppliedToRCC = psOutputs1.GetProperty(&quot;IsRoundingRuleAppliedToRCC&quot;);		   	
			psInputsNew.SetProperty(&quot;Offered RCC Incl&quot;, sOfferedRCCIncl);
			psInputsNew.SetProperty(&quot;New Plan Id&quot;,strNewPlanId);
			psInputsNew.SetProperty(&quot;New Plan Code&quot;,sNewPlanCode);
			psInputsNew.SetProperty(&quot;RIV Incl&quot;,RIVIncl);
			psInputsNew.SetProperty(&quot;RCC Incl&quot;,RCCIncl);
			psInputsNew.SetProperty(&quot;Tax Type&quot;,&quot;Incl&quot;);
			psInputsNew.SetProperty(&quot;New Product Code&quot;,sDeviceCode);
			psInputsNew.SetProperty(&quot;Plan Investment Category&quot;,strPlanInvestmentCategory);
			psInputsNew.SetProperty(&quot;New Plan Name&quot;, strNewPlanName);
			bsUpgradesService.InvokeMethod(&quot;Get New Aquisition&quot;, psInputsNew, psOutputsNew);

			sFianlRCCValue = psOutputsNew.GetProperty(&quot;Final RCC Incl&quot;);
			sFianlRIVValue = psOutputsNew.GetProperty(&quot;Final RIV Incl&quot;);
			IsNewAquisationRuleApplyToRCC = psOutputsNew.GetProperty(&quot;IsNewAquisationRuleApplyToRCC&quot;);
		}
		
		sFianlRCCValue = ToNumber(sFianlRCCValue);
		sFianlRIVValue = ToNumber(sFianlRIVValue);
		
		this.ActivateField(&quot;Savings on RIV incl&quot;);
		sSavingsOnRIVIncl = this.GetFieldValue(&quot;Savings on RIV incl&quot;);
		iSavingsOnRIVIncl = ToNumber(sSavingsOnRIVIncl);

	    this.SetFieldValue(&quot;Total Offer RCC incl&quot;,sFianlRCCValue);
		this.SetFieldValue(&quot;RIV incl&quot;,sFianlRIVValue);
		this.SetFieldValue(&quot;Rounding Rule Applied To RCC&quot;,IsRoundingRuleAppliedToRCC);
		this.SetFieldValue(&quot;New Acquisition Rule Applied To RCC&quot;,IsNewAquisationRuleApplyToRCC);
		this.WriteRecord();

		psInputs1 = TheApplication().NewPropertySet();
		psOutputs1 = TheApplication().NewPropertySet();
		bsSystemPref = TheApplication().GetService(&quot;VF Get System Preference&quot;);
		psInputs1.SetProperty(&quot;System Preference Name&quot;,&quot;VF GST Computation Rate&quot;);	
		bsSystemPref.InvokeMethod(&quot;Get System Preference&quot;,psInputs1,psOutputs1);
		sGSTRate = psOutputs1.GetProperty(&quot;System Preference Value&quot;);
		nGSTRate = ToNumber(sGSTRate);
		sFianlRIVValuePect = 1+nGSTRate/100;
		sFianlRIVExclValue = sFianlRIVValue/sFianlRIVValuePect;
		sFianlRCCExclValue = sFianlRCCValue/sFianlRIVValuePect;
		sSavingsOnRIVExcl = iSavingsOnRIVIncl/sFianlRIVValuePect;
		sFianlRIVExclValue = ToString(sFianlRIVExclValue);
		sFianlRCCExclValue = ToString(sFianlRCCExclValue);
		sSavingsOnRIVExcl = ToString(sSavingsOnRIVExcl);
		var tFianlRIVExclValue = mTruncate(sFianlRIVExclValue);
		var tFianlRCCExclValue = mTruncate(sFianlRCCExclValue);
			tSavingsOnRIVExcl = mTruncate(sSavingsOnRIVExcl);
		this.SetFieldValue(&quot;Total Offer RCC excl&quot;,tFianlRCCExclValue);
		this.SetFieldValue(&quot;RIV excl&quot;,tFianlRIVExclValue);
		this.SetFieldValue(&quot;Savings on RIV excl&quot;,tSavingsOnRIVExcl);
		this.WriteRecord();
		mPerformSubsidyCalc();//VIJAYE
		// Set the scenario display				
		sScenario = this.GetFieldValue(&quot;Scenario&quot;);
		if (sScenario == SCEN_CURRENT_PLAN_WITH_DEVICE || sScenario == SCEN_CURRENT_PLAN_NO_DEVICE)
			sScenarioDisplay = &quot;Resign to the same Plan Category&quot;;
		else if (sScenario == SCEN_EVERY_PLAN_WITH_DEVICE || sScenario == SCEN_EVERY_PLAN_NO_DEVICE)
			sScenarioDisplay = &quot;Upgrade to a new Plan Category&quot;;
		else if (sScenario == SCEN_OUTRIGHT_DEVICE)
			sScenarioDisplay = &quot;Purchase a device outright&quot;;	
		else if (sScenario == SCEN_ACCOUNT_LEVEL_NO_DEVICE)
			sScenarioDisplay = &quot;Account level upgrade/resign&quot;;

		this.SetFieldValue(&quot;Scenario Display&quot;, sScenarioDisplay);
		this.WriteRecord();
		// Determine if the early upgrade fee (EUF) can be waived
		sDeviceCode = this.GetFieldValue(&quot;Device Code&quot;);
		strDeviceName = this.GetFieldValue(&quot;Device Name&quot;); 
		sMonthsRemaining = this.GetFieldValue(&quot;Months Remaining&quot;);
		sValueBand = mGetValueBand(this.GetFieldValue(&quot;Value Band&quot;)); //Added for MKT02
			
		if (sScenario != SCEN_OUTRIGHT_DEVICE &amp;&amp; (sScenario == SCEN_CURRENT_PLAN_WITH_DEVICE || sScenario == SCEN_EVERY_PLAN_WITH_DEVICE))
		{					
			psInputs3.SetProperty(&quot;Device Code&quot;, sDeviceCode);
			psInputs3.SetProperty(&quot;Months Remaining&quot;, sMonthsRemaining);
			psInputs3.SetProperty(&quot;Old Contract Period&quot;, sExistingTerm);
			psInputs3.SetProperty(&quot;Value Band&quot;, sValueBand); ////Added for MKT02
	
			bsCalculateChargeService.InvokeMethod(&quot;Is Waive EUF Device&quot;,psInputs3,psOutputs3);
	
			bIsWaiveEUF= psOutputs3.GetProperty(&quot;bIsWaiveEUF&quot;);	
			if(bIsWaiveEUF == &apos;N&apos;)
			{
				// Addeded for CVM Phase 3 Release 13.0
				this.SetFieldValue(&quot;Upgrade Fee Waived&quot;, &quot;No&quot;);
				this.WriteRecord();
			
				if (this.GetFieldValue(&quot;EUF Charge&quot;) != &quot;&quot;)
				{
					sEUFCharge = this.GetFieldValue(&quot;EUF Charge&quot;);
				}
				else
				{
					sEUFCharge = TheApplication().GetProfileAttr(&quot;sEUFCharge&quot;); //Setting the variable to the value of the ProfileAttribute set at SmartScript.
				}
			}
			else // Addeded for CVM Phase 3 Release 13.0
			{
			this.SetFieldValue(&quot;Upgrade Fee Waived&quot;, &quot;Yes&quot;);
			this.WriteRecord();
			}
		}
		else if (sScenario == SCEN_CURRENT_PLAN_NO_DEVICE || sScenario == SCEN_EVERY_PLAN_NO_DEVICE )
		{
			if (this.GetFieldValue(&quot;EUF Charge&quot;) != &quot;&quot;)
			{
				sEUFCharge = this.GetFieldValue(&quot;EUF Charge&quot;);
			}
			else
			{
		 		sEUFCharge = TheApplication().GetProfileAttr(&quot;sEUFCharge&quot;); //Setting the variable to the value captured in the ProfileAtribute set at SmatScript.
			}			 		
		}
		// Calculate and set the remaining MPP Balance	
		var sVariableUpgradeCharge = this.GetFieldValue(&quot;VHA Variable Upgrade Charge&quot;);
		var sCurrentTermM2M = this.GetFieldValue(&quot;RO Current Length of Contract&quot;); //Roseline:01/12/2017 - Added
		//Indumathi: Inactivated below code for R19.3 MHI
		/*if(sScenario != SCEN_OUTRIGHT_DEVICE)
		{
			if (this.GetFieldValue(&quot;MPP Remaining Balance&quot;) != &quot;&quot;)
			{
				sMPPRemBalance = this.GetFieldValue(&quot;MPP Remaining Balance&quot;);
			}
			else if(TheApplication().GetProfileAttr(&quot;sMPPRemBalance&quot;)!=&quot;0&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;sMPPRemBalance&quot;)!=&quot;&quot;)
			{
				sMPPRemBalance = TheApplication().GetProfileAttr(&quot;sMPPRemBalance&quot;); //Setting the variable to the value captured in the ProfileAtribute set at SmartScript.
	   		}//for TD15650
		   	else if(CheckMPPExists(strRootAssetId)==&quot;Y&quot;)
		   	{
		   		// EW - Moved code to sub-function as script exceeded 16K
		   		//Roseline:01/12/2017 - Passed additional input paramters
		   		//sMPPRemBalance = mRecalcMPPBalance(sEUFCharge, sMPPRemBalance, strRootAssetId,sVariableUpgradeCharge);
			   	sMPPRemBalance = mRecalcMPPBalance(sEUFCharge, sMPPRemBalance, strRootAssetId,sVariableUpgradeCharge,bIsWaiveEUF,sCurrentTermM2M);
		   	}
		}// end of if not outright device		   
		//for TD15650
		if(sScenario == SCEN_OUTRIGHT_DEVICE)
		{
			if(CheckMPPExists(strRootAssetId)==&quot;Y&quot;)
		    {
				sMPPRemBalance = GetMPPRemBal(strRootAssetId);
		    }
		}End of R19.3 MHI*/
		
		sEUFCharge = mWaiveOffEUF(sEUFCharge);//Indumathi 23/03/2018: Added for PKE-59566
		//Chitra MPP Waiver CIR Starts 
		this.SetFieldValue(&quot;Estimated Early Upgrade Fee&quot;,sEUFCharge);
		//this.SetFieldValue(&quot;Estimated Remaining MPP Balance&quot;,sMPPRemBalance);//Indumathi: Inactivated for R 19.3 MHI	    		
		// EW 12.3 - Once the offer is set, do the retention optimiser calculations and requery the HaTCaT
		// offers
		if (TheApplication().GetProfileAttr(&quot;RetentionOptimiserFlag&quot;) == &quot;Y&quot; &amp;&amp; GetFieldValue(&quot;Cal Offer Matrix Id&quot;) != &quot;&quot;)
		{
			// Added &apos;strPlanInvestmentCategory&apos; parameter - CVM Phase 3
			mSetCTRDetails(this.GetFieldValue(&quot;Device Code Temporary&quot;), this.GetFieldValue(&quot;New Plan Name&quot;), this.GetFieldValue(&quot;New Plan Code&quot;), this.GetFieldValue(&quot;New Term Name Constrained&quot;), strPlanInvestmentCategory);//VF BASUA 28/08/2012 - Added for CVM P2
			mPerformROCalc();
		}
		// Requery the offer
	    this.WriteRecord();
		this.InvokeMethod(&quot;RefreshRecord&quot;); //Nikhil Joshi: 30.09.2014: Added for Upgrade MSO
	}
	catch (e)
	{
		throw e;
	}
	finally
	{		
		bsUpgradesService = null;
		bsCalculateChargeService = null;
		psInputs1 = null;
		psOutputs1 = null;
		psInputs2 = null;
		psOutputs2 = null;
		psInputs3 = null;
		psOutputs3 = null;
		psInputsNew = null;
		psOutputsNew = null;

		bsSystemPref = null;  /* This variable is nullified by Sharukh on 02/04/2019*/

	}
}"
			   SEQUENCE="28"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPickIMEI"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mPickIMEI
 * Component Information :  This picks the handset from the IMEI
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 * 27/10/2011	EW			11.E		Relabelled outright for Forced MPP &amp;
 *										changed code if product code does
 *										not match
 *				EW			12.6		Updated for CVM RO Phase 2
 */
function mPickIMEI(sIMEI, sResignChoice)
{
	var bcIMEIPick, bcMakePick;
	
	var sErrorMsg = &quot;&quot;;
	var sIMEIProductCode;
	var sSelectedProductCode;
	var sSplProdType,sPropId,sPropCode;
	var Inp,Out;
	
	try
	{
		// If we are not blanking out the IMEI
		if (sIMEI != &quot;&quot;)
		{
			if(sResignChoice == &quot;Resign&quot; || sResignChoice == &quot;Upgrade RRP on Instalment&quot;)
			{
				sSplProdType = this.GetFieldValue(&quot;VHA CurrentPlanSplType&quot;);
				sPropId = this.GetFieldValue(&quot;Current Proposition Id&quot;);
			}
			else
			{
				sSplProdType = this.GetFieldValue(&quot;VHA Spl Prod Type&quot;);
				if(sSplProdType ==&quot;&quot;)
				sSplProdType= this.GetFieldValue(&quot;VHA New Plan NPEY Identifier&quot;);
				var sNewPlan = this.GetFieldValue(&quot;VF CVM Upgrade New Plan Name&quot;);
				if(sNewPlan==&quot;&quot;)
				sNewPlan=this.GetFieldValue(&quot;New Plan Name&quot;)
				var sNewPlanId =&quot;&quot;;
				var oBC = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VF Internal Product TBUI&quot;);
				with (oBC){
					ClearToQuery();
					ActivateField(&quot;Id&quot;);
					SetSearchSpec(&quot;Name&quot;, sNewPlan);
					ExecuteQuery();
					if(FirstRecord())
					{
						sNewPlanId = GetFieldValue(&quot;Id&quot;);	
					}
				}
				var sBS = TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
				Inp = TheApplication().NewPropertySet();
				Out = TheApplication().NewPropertySet();
				Inp.SetProperty(&quot;Plan Id&quot;,sNewPlanId);
				Inp.SetProperty(&quot;Plan Name&quot;, sNewPlan);
				sBS.InvokeMethod(&quot;GetPropositionFromPlan&quot;,Inp,Out);
				sPropId=Out.GetProperty(&quot;Proposition Id&quot;);
			}
			var oBS = TheApplication().GetService(&quot;VF OM Order Toolkit Service&quot;);
			var oBC = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VF Internal Product TBUI&quot;);
			with (oBC){
				ClearToQuery();
				ActivateField(&quot;VOD Row Id&quot;);
				SetSearchSpec(&quot;Id&quot;, sPropId);
				ExecuteQuery();
				if(FirstRecord())
				{
					Inp=TheApplication().NewPropertySet();
					Out = TheApplication().NewPropertySet();
					Inp.SetProperty(&quot;ItemId&quot;,GetFieldValue(&quot;VOD Row Id&quot;));
					Inp.SetProperty(&quot;AttrName&quot;,&quot;Proposition Code&quot;);
					oBS.InvokeMethod(&quot;GetProdAttr&quot;,Inp,Out);
					sPropCode=Out.GetProperty(&quot;Val&quot;);
				}
			}
			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_MODEM_PROP_CODE&quot;,sSplProdType)==&quot;Y&quot; )
				sPropCode=sSplProdType;
				TheApplication().SetProfileAttr(&quot;TT1&quot;,sPropCode+&quot; :&quot;+sPropId+&quot; :&quot;+sSplProdType);
			sErrorMsg = mValidateIMEI(sIMEI,sPropCode);
			
			if (sErrorMsg != &quot;&quot;)
			{
				return (sErrorMsg);
			}
		
			bcIMEIPick = this.GetPicklistBusComp(&quot;IMEI with Pick&quot;);
		
			with (bcIMEIPick)
			{
				ClearToQuery();
				ActivateField(&quot;Product Code&quot;);
				SetSearchSpec(&quot;IMEI&quot;, sIMEI);
				ExecuteQuery(ForwardOnly);
			
				if (FirstRecord())
				{
					// Get the product code of the handset
					sIMEIProductCode = GetFieldValue(&quot;Product Code&quot;);
					
					// If a handset make / model has already been selected and the
					// IMEI does not match this make / model, blank out the offer
					sSelectedProductCode = this.GetFieldValue(&quot;Device Code Temporary&quot;);
					
					if (sSelectedProductCode != &quot;&quot; &amp;&amp; sSelectedProductCode != sIMEIProductCode)
					{
						this.SetFieldValue(&quot;New Plan Name Constrained&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;Device Make Constrained&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;VF CVM Upgrade New Handset Make&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;VF CVM Upgrade New Handset Code&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;VF CVM Upgrade New Plan Name&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;VF CVM Upgrade New Plan Code&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;VF CVM Upgrade New Plan Term&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;RO CTR Subsidy Excl GST&quot;, &quot;&quot;);						
						
						// Set a user property that is checked on SetFieldValue to display a warning
						this.SetUserProperty(&quot;Device Mismatch&quot;, &quot;Y&quot;);
					} 
					
					// If we are doing a resign or outright, then automatically pick in the current plan
					if (this.GetFieldValue(&quot;Device Make Constrained&quot;) == &quot;&quot; &amp;&amp; (sResignChoice == &quot;Resign&quot; || sResignChoice == &quot;Upgrade RRP on Instalment&quot;))
					{
						bcMakePick = this.GetPicklistBusComp(&quot;Device Make Constrained&quot;);
							
						with (bcMakePick)
						{	
							ClearToQuery();
							ActivateField(&quot;Product Code&quot;);
							SetSearchSpec(&quot;Product Code&quot;, sIMEIProductCode);
							ExecuteQuery(ForwardOnly);
		
							if (!FirstRecord())
							{
								if (sResignChoice == &quot;Resign&quot;)
								{
									return(&quot;The IMEI you have entered cannot be used to resign the customer.&quot;);
								}
								else
								{
									return(&quot;The IMEI you have entered cannot be used for an upgrade RRP on instalment.&quot;);
								}
							}
							else
							{
								bcMakePick.Pick();
							}
						}				
					}					
					
					bcIMEIPick.Pick();
					this.SetFieldValue(&quot;Accept Offer&quot;, &quot;Yes&quot;);
				}
				else
				{
					this.SetFieldValue(&quot;IMEI&quot;, sIMEI);				
					this.SetFieldValue(&quot;Vodafone Stock IMEI&quot;, &quot;N&quot;);
				}				
			}						
		}
		else
		{
			this.SetFieldValue(&quot;IMEI&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;Vodafone Stock IMEI&quot;, &quot;&quot;);
		}
		return (&quot;&quot;);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcIMEIPick = null;
		bcMakePick = null;  /* This variable is nullified by Sharukh on 02/04/2019*/

	}
}"
