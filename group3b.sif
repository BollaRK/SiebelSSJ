			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetCTRDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetCTRDetails(sDeviceCode, sPlanName, sPlanCode, sPlanTerm, sPlanInvestmentCategory)
{
/*******************************************************************************
 * Input			: N/A
 * Output			: N/A
 * Summary			: N/A
 *
 * History  :
 * Date			Author		Defect #	Description
 * *****************************************************************************
 * 28/08/2012	BASUA					Initial Version
 * 19/12/2012	HR						Changed for CVM Phase 3 
 *******************************************************************************/
	try
	{
		var obsWizUtilities = TheApplication().GetService(&quot;VF Upgrade Utilities&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var	psOutputs = TheApplication().NewPropertySet();

		var nRevenue, nCost, nCTRSubsidy;
		var sCurrentTerm = this.GetFieldValue(&quot;RO Current Length of Contract&quot;);

		if (sPlanName == &quot;Current Plan&quot; || sPlanName == &quot;Outright&quot;)
		{
			sPlanCode = sPlanName;
			sPlanTerm = sCurrentTerm;
		}
		
		psInputs.SetProperty(&quot;DeviceCode&quot;, sDeviceCode);
		psInputs.SetProperty(&quot;PlanCode&quot;, sPlanCode);
		psInputs.SetProperty(&quot;FutureTerm&quot;, sPlanTerm);
		psInputs.SetProperty(&quot;CurrentMonthsInContract&quot;, this.GetFieldValue(&quot;RO Current Months in Contract&quot;));
		psInputs.SetProperty(&quot;CurrentValueBand&quot;, this.GetFieldValue(&quot;RO Customer Current Value Band&quot;));
		psInputs.SetProperty(&quot;CurrentTerm&quot;, sCurrentTerm);
		psInputs.SetProperty(&quot;PlanInvestmentCategory&quot;, sPlanInvestmentCategory); // Added for CVM Phase 3

		obsWizUtilities.InvokeMethod(&quot;GetOracleCTRSubsidyDetails&quot;, psInputs, psOutputs);

		nRevenue = psOutputs.GetProperty(&quot;Revenue&quot;);
		nCost = psOutputs.GetProperty(&quot;Cost&quot;);
		nCTRSubsidy = psOutputs.GetProperty(&quot;CTRSubsidy&quot;);

		this.SetFieldValue(&quot;RO Handset Revenue Excl GST&quot;, nRevenue);
		this.SetFieldValue(&quot;RO Handset Cost Excl GST&quot;, nCost);
		this.SetFieldValue(&quot;RO CTR Subsidy Excl GST&quot;, nCTRSubsidy);
	}
	catch(e)
	{
	//	var sError = e.toString();//VF:ROSELINE 10/09/2014 - Removed
		throw(e);
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
		obsWizUtilities = null;
	}
}"
			   SEQUENCE="34"
			   UPDATED="09/30/2019 12:01:53"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDefaultValues"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	SetDefaultValues
 * Component Information :  This code is effective a replica of the
 *							current code on the smartscript open
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 * 26/10/2011	EW						Modified code to use common business
 *										service for 11.D (Forced MPP)
 * 27/03/2012	EW						Updated for 12.3 CVM
 * 17/04/2012	BASUA					Updated for 12.3 CVM
 * 08/08/2012	EW						Changed for 12.6 CVM RO Phase 2
 * 19/12/2012   HR						Changed for 13.0 CVM Phase 3 
 * 18/06/2018	INDUMATHI	PKE60741	Modified code to get upgrade ineligibility reason  
 */
function mSetDefaultValues()
{

	var boCurrent;
	var bcAsset;
	var bsUpgradeUtils;
	var psInputs, psOutputs;
	var TBUIUpgrade;
	
	var sEligibleUpgrade, sEligibleResign, sEligibleOutright, sUpgIneligibleReasonCode;
	var sContractEndDate = &quot;&quot;;
	var sCurrentPlanName, sCurrentPropositionId, sEUFCharge, sUpgradeLevel, sMPPBalance, sMonthsInContract, sMonthsRemaining, sUpgradeLevel, sValueBand;
	var nEligibilityScenario;
	var strCurrPacksAndPasses, strCurrHandset, strCurrentTerm; //VF BASUA 17/04/2012 - Added for CVM
	var sPlanInResignExclusion;
	var sContractStartDate = &quot;&quot;;
	var sMPPStartDate,sMPPEndDate;
	var strContractStartDate =&quot;&quot;;
	var strContractEndDate=&quot;&quot;;
	var sAvgDataUsed; //VF:Roseline 10/10/2014 - Added for INC000010659119
	var strAvgDataUsed, strDiscount, strDiscountDate, strDiscountAmt, strDiscountPeriod, strPlanInvestCtg; //VF HR 19/12/2012 - Added ofr CVM Phase 3
	var sVariableUpgradeCharge; //VHA-Vinodhini-27/09/2017-Added for PKE000000053643
	var sMiniSpendProd = &quot;&quot;; //Lavanya Added for PKE 54943
	
	try
	{
		// Initialise all objects
		boCurrent = BusObject();
		
		bcAsset = boCurrent.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
				
		bsUpgradeUtils = TheApplication().GetService(&quot;VF Upgrade Utilities&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();

		// Set the inputs		
		psInputs.SetProperty(&quot;AssetId&quot;, bcAsset.GetFieldValue(&quot;Id&quot;));
		psInputs.SetProperty(&quot;MSISDN&quot;, &quot;&quot;);
	

		// Determine what is eligible
		bsUpgradeUtils.InvokeMethod(&quot;GetUpgradeEligibility&quot;, psInputs, psOutputs);

		// Get the outputs
		sContractEndDate = psOutputs.GetProperty(&quot;ContractEndDate&quot;);
		sCurrentPropositionId = psOutputs.GetProperty(&quot;CurrentPropositionId&quot;);
		sCurrentPlanName = psOutputs.GetProperty(&quot;CurrentPlanName&quot;);
		sEUFCharge = psOutputs.GetProperty(&quot;EUFCharge&quot;);//ARPANS:16/02/2012:TD15228:Removed space between EUF and Charge
		sVariableUpgradeCharge = psOutputs.GetProperty(&quot;VariableUpgradeCharge&quot;);//VHA-Vinodhini-27/09/2017-Added for PKE000000053643
		sUpgradeLevel = psOutputs.GetProperty(&quot;UpgradeLevel&quot;);
		sMPPBalance = psOutputs.GetProperty(&quot;MPPBalance&quot;);
		sMonthsInContract = psOutputs.GetProperty(&quot;MonthsInContract&quot;);
		sMonthsRemaining = psOutputs.GetProperty(&quot;MonthsRemaining&quot;);
		sUpgradeLevel = psOutputs.GetProperty(&quot;UpgradeLevel&quot;);
		sValueBand = psOutputs.GetProperty(&quot;ValueBand&quot;);
		//VF BASUA 17/04/2012 - Added for CVM - Start
		strCurrentTerm = psOutputs.GetProperty(&quot;CurrentTerm&quot;);
		strCurrPacksAndPasses = psOutputs.GetProperty(&quot;CurrentPacksAndPasses&quot;);
		strCurrHandset = psOutputs.GetProperty(&quot;CurrentHandset&quot;);
		//VF BASUA 17/04/2012 - End
		sPlanInResignExclusion = psOutputs.GetProperty(&quot;PlanInResignExclusion&quot;);
		sContractStartDate = psOutputs.GetProperty(&quot;Contract Start Date&quot;);
		sMPPStartDate = psOutputs.GetProperty(&quot;MPP Start Date&quot;);
		sMPPEndDate = psOutputs.GetProperty(&quot;MPP End Date&quot;);
		sMiniSpendProd = psOutputs.GetProperty(&quot;MinimumSpendProd&quot;); //Lavanya Added for PKE 54943

		// Get the eligibility
		sEligibleUpgrade = psOutputs.GetProperty(&quot;EligibleUpgrade&quot;);
		sEligibleResign = psOutputs.GetProperty(&quot;EligibleResign&quot;);
		sEligibleOutright = psOutputs.GetProperty(&quot;EligibleOutright&quot;);
		sUpgIneligibleReasonCode = psOutputs.GetProperty(&quot;UpgIneligibleReasonCode&quot;);//Indumathi-18/06/2018: Added for PKE 60741
		// Get Usage Details CVM Phase 3		
		strAvgDataUsed = psOutputs.GetProperty(&quot;AvgDataUsed&quot;);
		strDiscount = psOutputs.GetProperty(&quot;Discount&quot;);
		strDiscountDate = psOutputs.GetProperty(&quot;DiscountDate&quot;);
		strDiscountAmt = psOutputs.GetProperty(&quot;DiscountAmt&quot;);
		strDiscountPeriod = psOutputs.GetProperty(&quot;DiscountPeriod&quot;);
		strPlanInvestCtg = psOutputs.GetProperty(&quot;PlanInvestCtg&quot;);
		
		TheApplication().Trace(&quot;sContractStartDate:string&quot;+sContractStartDate);
		TheApplication().Trace(&quot;sContractEndDate:string&quot;+sContractEndDate);
		
		TBUIUpgrade = TheApplication().GetProfileAttr(&quot;TBUIUpgrade&quot;); //VF:Roseline 20/08/2014
		
		//Convert String to Date  - VF:Roseline 30/06/2014 - Added for TBUI Upgrade Postpaid flow
		//Perform Date Conversion only for TBUI upgrade flow - VF:Roseline 20/08/2014
		if(TBUIUpgrade == &quot;Y&quot;)
		{
			if(sContractStartDate == &quot;undefined&quot; || sContractStartDate == &quot;&quot; || sContractStartDate == null || sContractStartDate == &quot;No Term&quot;)
			{
				strContractStartDate = &quot;&quot;;
			}
			else 
			{
				strContractStartDate = GetDateFromString(sContractStartDate);
			}
			if(sContractEndDate == &quot;undefined&quot; || sContractEndDate == &quot;&quot; || sContractEndDate == null || sContractEndDate == &quot;No Term&quot;)
			{
				strContractEndDate = &quot;&quot;;
			}
			else 
			{
				strContractEndDate = GetDateFromString(sContractEndDate);
			}
		}
	
	//Lavanya Added for PKE - 54943 - Fixing Early Termination Fee Wrong calculation starts
		var sFeeFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;EUFNewCharge&quot;);

		if(sFeeFlg == &quot;Y&quot;)
		{
			if(sMiniSpendProd == &quot;&quot; || sMiniSpendProd == null) //If condition added part of 54943 18.1 Fix
			{
			sMiniSpendProd = sCurrentPlanName;
			}
			else
			{
			//ToCheck if MinimumSpend is same as rateplan
				if(sMiniSpendProd == sCurrentPlanName)
				{
					sMiniSpendProd = sCurrentPlanName;
				}
				else
				{	
					sMiniSpendProd = sMiniSpendProd;
				}
			}			
	 	psInputs.Reset();
	 	psOutputs.Reset();
		psInputs.SetProperty(&quot;strCurrentTerm&quot;,strCurrentTerm);
		psInputs.SetProperty(&quot;sMonthsRemaining&quot;,sMonthsRemaining);		
		TheApplication().GetService(&quot;VF Calculate Charges Service MSO&quot;).InvokeMethod(&quot;GetMonthsIntoContract&quot;, psInputs, psOutputs);
		sMonthsInContract = psOutputs.GetProperty(&quot;sMonthsInContract&quot;);
	 	var sInp = TheApplication().NewPropertySet();
	 	var sOut = TheApplication().NewPropertySet();
		sInp.SetProperty(&quot;Product Name&quot;,sMiniSpendProd);
		sInp.SetProperty(&quot;Term&quot;,strCurrentTerm);
		sInp.SetProperty(&quot;Months Remaining&quot;,sMonthsRemaining);										
		sInp.SetProperty(&quot;MonthsIntoContract&quot;,sMonthsInContract);
		sInp.SetProperty(&quot;ARII&quot;,&quot;Australia&quot;);								
		TheApplication().GetService(&quot;VF Upgrade Smartscript Service&quot;).InvokeMethod(&quot;Calculate EUF&quot;, sInp, sOut);
		sEUFCharge = sOut.GetProperty(&quot;EUFCharge&quot;);
		sVariableUpgradeCharge = sOut.GetProperty(&quot;VariableUpgradeCharge&quot;);
		}
	//Lavanya Added for PKE - 54943 - Fixing Early Termination Fee Wrong calculation Ends
		
		//Trace Script
		/*TheApplication().Trace(&quot;strContractEndDate:date&quot;+strContractEndDate);
		TheApplication().Trace(&quot;strContractEndDate:date&quot;+strContractEndDate);
		TheApplication().Trace(&quot;sUpgradeLevel&quot;+sUpgradeLevel);
		TheApplication().Trace(&quot;sMonthsInContract&quot;+sMonthsInContract);
		TheApplication().Trace(&quot;sEligibleUpgrade&quot;+sEligibleUpgrade);
		TheApplication().Trace(&quot;sEligibleResign&quot;+sEligibleResign);
		TheApplication().Trace(&quot;sEligibleOutright&quot;+sEligibleOutright);
		TheApplication().Trace(&quot;strCurrentTerm&quot;+strCurrentTerm);
		TheApplication().Trace(&quot;strCurrPacksAndPasses&quot;+strCurrPacksAndPasses);
		TheApplication().Trace(&quot;strCurrHandset&quot;+strCurrHandset);
		TheApplication().Trace(&quot;strAvgDataUsed&quot;+strAvgDataUsed);
		TheApplication().Trace(&quot;strDiscount&quot;+strDiscount);
		TheApplication().Trace(&quot;strDiscountDate&quot;+strDiscountDate);
		TheApplication().Trace(&quot;strDiscountAmt&quot;+strDiscountAmt);
		TheApplication().Trace(&quot;strDiscountPeriod&quot;+strDiscountPeriod);
		TheApplication().Trace(&quot;strPlanInvestCtg&quot;+strPlanInvestCtg);
		TheApplication().Trace(&quot;strContractStartDate&quot;+strContractStartDate);
		TheApplication().Trace(&quot;strContractEndDate&quot;+strContractEndDate);*/

		
		// Default the values
		SetFieldValue(&quot;CSR Upgrade Flag&quot;, &quot;N&quot;);
		SetFieldValue(&quot;Value Band&quot;, sValueBand);
		SetFieldValue(&quot;Upgrade Level&quot;, sUpgradeLevel);
		SetFieldValue(&quot;Current Proposition Id&quot;, sCurrentPropositionId);
		SetFieldValue(&quot;Current Plan Name&quot;, sCurrentPlanName);
		SetFieldValue(&quot;EUF Charge&quot;, sEUFCharge);
		SetFieldValue(&quot;MPP Remaining Balance&quot;, sMPPBalance);		
		SetFieldValue(&quot;Months Remaining&quot;, sMonthsRemaining);
        SetFieldValue(&quot;Months Into Contract&quot;, sMonthsInContract);
		SetFieldValue(&quot;Upgrade Eligibility&quot;, sEligibleUpgrade);
		SetFieldValue(&quot;Resign Eligibility&quot;, sEligibleResign);
		SetFieldValue(&quot;Outright Eligibility&quot;, sEligibleOutright);
		SetFieldValue(&quot;VHA Upgrade Reason&quot;, sUpgIneligibleReasonCode);//Indumathi-18/06/2018: Added for PKE 60741		
		//VF BASUA 17/04/2012 - Added for CVM - Start
		SetFieldValue(&quot;RO Current Length of Contract&quot;, strCurrentTerm);
		SetFieldValue(&quot;Current Packs and Passes&quot;, strCurrPacksAndPasses);
		SetFieldValue(&quot;Current Handset&quot;, strCurrHandset);
			
		//VF BASUA 17/04/2012 - End
		SetFieldValue(&quot;Plan in Resign Exclusion&quot;, sPlanInResignExclusion);
		
		//VHA-Vinodhini-27/09/2017-Added for PKE000000053643
		SetFieldValue(&quot;VHA Variable Upgrade Charge&quot;, sVariableUpgradeCharge);
			
		//VF HR 19/12/2012 - Added for CVM Phase 3 - start
		//VF:ROSELINE 10/10/2014 - Added for INC000010659119 - Show the Average data Used in UI
		if(TBUIUpgrade == &quot;Y&quot;)
		{
			if(strAvgDataUsed != &quot;&quot; || strAvgDataUsed != null)
			{
				sAvgDataUsed = mGetAvgDataUsed(strAvgDataUsed);
				SetFieldValue(&quot;Average Data Display&quot;, sAvgDataUsed);
			}
			else 
			{
				SetFieldValue(&quot;Average Data Display&quot;, strAvgDataUsed);
			}
		}
		else
		{
			SetFieldValue(&quot;Average Data Display&quot;, strAvgDataUsed);
		}
		//Till here
		SetFieldValue(&quot;Is Discount Product&quot;, strDiscount );
		SetFieldValue(&quot;Discount Provision Date&quot;, strDiscountDate);
		SetFieldValue(&quot;Discount Amount&quot;, strDiscountAmt);
		SetFieldValue(&quot;Discount Period&quot;, strDiscountPeriod);
		SetFieldValue(&quot;Plan Investment Category&quot;, strPlanInvestCtg);
		//Set the Dates only for TBUI upgrade flow - VF:Roseline 20/08/2014
		if(TBUIUpgrade == &quot;Y&quot;)
		{
			SetFieldValue(&quot;Asset Activation Date&quot;, strContractStartDate);
			SetFieldValue(&quot;Commitment End Date&quot;, strContractEndDate);
		}
			
		//VF HR 19/12/2012 - Added for CVM Phase 3 - End
		
 		// Determine which eligibility scenario we are in.  This will drive what gets displayed
		// in the applet field and also will help constain the Resign Upgrade Choice selection		 		
 		nEligibilityScenario = mGetEligibilityScenario(sEligibleUpgrade, sEligibleResign, sEligibleOutright);
 		SetFieldValue(&quot;Eligibility Scenario&quot;, nEligibilityScenario);
		WriteRecord();
        
        var sRootAssetId = GetFieldValue(&quot;Root Asset Id&quot;);
        var sId = GetFieldValue(&quot;Id&quot;);
        ActivateField(&quot;VHA Outright Calc&quot;);
        ActivateField(&quot;VHA Upgrade Cal&quot;);
        ActivateField(&quot;VHA Resign Calc&quot;);
        ActivateField(&quot;Wizard Session Id&quot;);
        var sOutrightCalc = GetFieldValue(&quot;VHA Outright Calc&quot;);
        var sUpgradeCalc  = GetFieldValue(&quot;VHA Upgrade Calc&quot;);
        var sResignCalc   = GetFieldValue(&quot;VHA Resign Calc&quot;);
        var sWizardId = GetFieldValue(&quot;Wizard Session Id&quot;);
        
		if(TBUIUpgrade == &quot;Y&quot;) //Set the profile attributes only for TBUI upgrade flow - VF:Roseline 20/08/2014
		{	
			TheApplication().SetProfileAttr(&quot;Contract Start Date&quot;,strContractStartDate);
			TheApplication().SetProfileAttr(&quot;Contract End Date&quot;,strContractEndDate);
		}
		else
		{
			TheApplication().SetProfileAttr(&quot;Contract Start Date&quot;,sContractStartDate);
			TheApplication().SetProfileAttr(&quot;Contract End Date&quot;,sContractEndDate);
		}
		TheApplication().SetProfileAttr(&quot;MPP Start Date&quot;,sMPPStartDate);
		TheApplication().SetProfileAttr(&quot;MPP End Date&quot;,sMPPEndDate);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psOutputs = null;
		psInputs = null;
		bsUpgradeUtils = null;
		bcAsset = null;
		boCurrent = null;
		
		
  	/*Below variables are nullified by Sharukh on 02/04/2019*/
		sInp = null;
		sOut = null;
		
	}
}"
