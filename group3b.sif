			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetRRP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetRRP(sDevice)
{
  try
  {
	//Added for PKE000000024132 fix - CHitra - 17/06/2015
	if(sDevice != &apos;&apos; &amp;&amp; sDevice.length &gt; 0 &amp;&amp; sDevice != null)
	{
	var sPickBC = this.GetPicklistBusComp(&quot;Device Make Constrained&quot;);
	
	with (sPickBC)
	{
		ClearToQuery();
		SetSearchSpec(&quot;Plan Code&quot;, this.GetFieldValue(&quot;Resign Upgrade Choice for Constrain&quot;));				
		SetSearchSpec(&quot;Out of Stock Connect Now&quot;, this.GetFieldValue(&quot;Stock Connect Now Constrain Calc&quot;));
		SetSearchSpec(&quot;Device Name&quot;,sDevice);
		ExecuteQuery(ForwardOnly);
		if (FirstRecord())
		{
			Pick();
			this.WriteRecord();
		}
	}
	mPerformUpgradeCalc();
	}
  }
  
  catch(e)
  {
   throw e;
  }
  finally
  {
   sPickBC = null;
  }
}"
