			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="checkResponsibility"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function checkResponsibility(strResponsibility)
{
/*
 * Component Name        : 	VF Asset Form Applet
 * Method Name           : 	checkResponsibility
 * Component Information : 	This function takes in the calling method and
 *							returns a true or false				
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 18/11/2009	NG			DF11972		Added comments section
 *
 */
 	var bsRespCheck;
	var psInputs;
	var psOutputs;
	
	var strError = &quot;&quot;;

	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Asset Form Applet Applet.checkResponsibility.strResponsibility=&quot; + strResponsibility);
		}	
		
		if (strResponsibility != &quot;&quot;)
		{
			bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
		
			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();
		
			psInputs.SetProperty(&quot;Responsibility&quot;, strResponsibility);
			
			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
			
			return(psOutputs.GetProperty(&quot;Exists&quot;));

		}
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		psInputs = null;
		psOutputs = null;	
		bsRespCheck = null;
		
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Asset Form Applet Applet.checkResponsibility.strError=&quot; + strError);
		}		
	}
}"
			   SEQUENCE="3"
			   UPDATED="03/28/2022 17:01:26"
			   UPDATED_BY="SADMIN"
			   CREATED="09/30/2019 12:01:53"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAddAccessoryItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAddAccessoryItem()
{
/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mAddAccessoryItem
 * Component Information :  This code will set the default Accessory based on the plan type					
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/04/2016	Roseline	R16.2 CIR	Initial version
 */
	try
	{
		var bcItemPick, bcAccessoryPick, sSiebProdType, ItemName, sRowId;
		var sOfferBO = this.BusObject();
		var sOfferBC = sOfferBO.GetBusComp(&quot;VF Upgrade Offer&quot;).GetMVGBusComp(&quot;Accessory Name&quot;); // this.GetPicklistBusComp(&quot;Accessory Name&quot;); //
		var sNewPlan = this.GetFieldValue(&quot;VF CVM Upgrade New Plan Name&quot;);
		var sCurrentPlan = this.GetFieldValue(&quot;Current Plan Name&quot;);
		var sCurrentPropName = this.GetFieldValue(&quot;Current Proposition Name&quot;);
		var sOfferType = this.GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;);	
		//Roseline:18/05/2016 -Changed the LOV Type for CIR Defect#99
		var LovMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ACCESSORY_TYPE&quot;,&quot;MBB&quot;);
		var LovVoice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ACCESSORY_TYPE&quot;,&quot;Voice&quot;);
		//end of Code
		var oProdBO = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var oProdBC = oProdBO.GetBusComp(&quot;Internal Product&quot;);
		var sNewPropName = mGetPropositionFromPlan(sNewPlan);
		var sSearchSt = &quot;[Name] = &apos;&quot; + sNewPropName + &quot;&apos;&quot;;
		var sSearch = &quot;[Name] = &apos;&quot; + sCurrentPropName + &quot;&apos;&quot;;
		var sOfferId = this.GetFieldValue(&quot;Id&quot;);
		var isRec,searchst1,searchst2,searchst;
		var sAccessoryType = &quot;&quot;;
		
		if (sOfferType == &quot;Upgrade to New Plan&quot; &amp;&amp; sNewPlan == &quot;&quot;)
		{
			TheApplication().RaiseErrorText(&quot;Please select Plan first before adding accessory&quot;);
		}	
		with (oProdBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			if(sOfferType == &quot;Upgrade to New Plan&quot;)
				SetSearchExpr(sSearchSt);
			else	
				SetSearchExpr(sSearch);
			ExecuteQuery();
			if (FirstRecord())
				sSiebProdType = GetFieldValue(&quot;Siebel Product Type&quot;);
		}		
		if (sSiebProdType != null &amp;&amp; sSiebProdType != &quot;&quot;)
		{
			var sOfferItemBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
			var sOfferItemBC = sOfferItemBO.GetBusComp(&quot;VF Upgrade Offer Item&quot;);
			with(sOfferItemBC)
			{
				sOfferItemBC.SetViewMode(AllView);
				sOfferItemBC.ClearToQuery();
				sOfferItemBC.ActivateField(&quot;Item Name&quot;);
				sOfferItemBC.ActivateField(&quot;Type&quot;);
				sOfferItemBC.ActivateField(&quot;Upgrades Offer Id&quot;);
				if (sSiebProdType == &quot;MBB&quot;)
					searchst1 = &quot;[Item Name] = &apos;&quot; + LovMBB + &quot;&apos;&quot;;
				else if(sSiebProdType == &quot;Voice&quot;)
					searchst1 = &quot;[Item Name] = &apos;&quot; + LovVoice + &quot;&apos;&quot;;
				//searchst1 = &quot;([Item Name] = &apos;&quot; + LovMBB + &quot;&apos; OR [Item Name] = &apos;&quot; + LovVoice + &quot;&apos;)&quot;;
				searchst2 = &quot; AND [Type] = &apos;Accessory&apos; AND [Upgrades Offer Id] = &apos;&quot; + sOfferId + &quot;&apos;&quot;;
				searchst =  searchst1 + searchst2;
				sOfferItemBC.SetSearchExpr(searchst);
				sOfferItemBC.ExecuteQuery();
				isRec = sOfferItemBC.FirstRecord();
				if(isRec)
				{
					//do nothing
				}
				//	sOfferItemBC.InvokeMethod(&quot;RefreshRecord&quot;);
			else
			{
				sOfferBC.NewRecord(NewAfter);
				sRowId = sOfferBC.GetFieldValue(&quot;Id&quot;);
				bcItemPick = sOfferBC.GetPicklistBusComp(&quot;Item Name&quot;);
				//var name = bcItemPick.GetName();
				with (bcItemPick)
				{	
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Item Name&quot;);
					if (sSiebProdType == &quot;MBB&quot;)
						SetSearchSpec(&quot;Item Name&quot;, LovMBB);
					else if(sSiebProdType == &quot;Voice&quot;)
						SetSearchSpec(&quot;Item Name&quot;, LovVoice);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						Pick();
					}
				}
				sOfferBC.SetFieldValue(&quot;Type&quot;, &quot;Accessory&quot;);
	   			sOfferBC.WriteRecord();
				with(sOfferBC)
				{
					ClearToQuery();
	   				SetViewMode(AllView);
	   				ActivateField(&quot;Item Name&quot;);
	   				SetSearchSpec(&quot;Id&quot;, sRowId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						ItemName = GetFieldValue(&quot;Item Name&quot;);
					}
				}	   			
		  		//this.RefreshRecord();
	   			bcAccessoryPick = this.GetPicklistBusComp(&quot;Accessory Name&quot;);
	   			with (bcAccessoryPick)
		 		{	
		 			ClearToQuery();
	   				SetViewMode(AllView);
	   				ActivateField(&quot;Item Name&quot;);
	   				SetSearchSpec(&quot;Item Name&quot;, ItemName);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						Pick();
					}	
		  		} //with (bcAccessoryPick)
		 	}//else
		 }//with(sOfferItemBC)
		}//if (sSiebProdType != null &amp;&amp; sSiebProdType != &quot;&quot;)
		else
   		{
   			TheApplication().RaiseErrorText(&quot;Please add SIM manually&quot;);
   		}
	 } //try	
	 catch(e)
	 {
	 	throw(e);
	 }
	 finally
	 {
	 	bcItemPick = null;
		sOfferBC = null;
	 	oProdBC = null;
		sOfferBO = null;
		oProdBO = null;
		bcAccessoryPick = null;

		/*Below variables are nullified by Sharukh on 02/04/2019*/
		/*sOfferItemBC = null;
		sOfferItemBO = null;*/

		/*Below variables are nullified by BALAGURU on 03/10/2019*/
		if(defined(sOfferItemBC)) { sOfferItemBC = null; }
		if(defined(sOfferItemBO)) { sBCsOfferItemBO = null; }

	 }	
}"
