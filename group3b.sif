			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	BusComp_NewRecord
 * Component Information :  
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C
 * 08/08/2012	EW						Changed for 12.6 CVM RO Phase 2
 */
function BusComp_NewRecord ()
{
	try
	{
		mSetDefaultValues();
		
		//VINODHINI-23/06/2016-Added for Button enable/Disable
		// Pallavi.15/3/2019.Changed profile attr for Unified Application
		 var UserType = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
		 if(UserType == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Care&quot;))
		 TheApplication().SetProfileAttr(&quot;CheckStkAvaliButton&quot;,&quot;Out of Stock&quot;);
		 if(UserType == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Retail&quot;))
		 TheApplication().SetProfileAttr(&quot;CheckStkAvaliButton&quot;,&quot;In Stock&quot;);
		
			
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
			   SEQUENCE="45"
			   UPDATED="09/30/2019 12:01:51"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  PreInvokeMethod
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 */
function BusComp_PreInvokeMethod (MethodName)
{
	try
	{
		switch (MethodName)
		{
			case &quot;CreateUpgradeOrder&quot;:
				mCreateUpgradeOrder();
				return (CancelOperation);
				
			case &quot;ReselectPlan&quot;:
				mReselectPlan();
				return (CancelOperation);
		
			case &quot;mAddSIM&quot;: //Saravanan : Added for CIR : 29/03/2016
				mAddAccessoryItem();
				return (CancelOperation);
		}
		return (ContinueOperation);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		
	}
}"
			   SEQUENCE="46"
			   UPDATED="09/30/2019 12:01:51"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  PreSetFieldValue
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 * 08/08/2012	EW						Changed for 12.6 CVM RO Phase 2
 * 20/12/2012	VIVIND		QC 1204		Changed the if &amp; else if for &quot;RO Customer Credit Period&quot;
 * 20/12/2012	VIVIND					Added the user property for the defect to check the not null values for RO Period &amp; RO Amount
 */
function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
	var sErrorMsg = &quot;&quot;;
	var sStockIndicator1 = &quot;&quot;;
	
	try
	{
		switch (FieldName)
		{
			// We need to explicitly do a pick if the user does a SetFieldValue.  This is because
			// the picklist is unbounded
			case &quot;IMEI with Pick&quot;:
				//Added as part of PKE#786 on 02/01/2021
				var sStockIndicator1 = &quot;&quot;;
				var sStockIndicator1 = this.GetFieldValue(&quot;Stock Indicator&quot;);
				var sSwitch1 = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;Upgrade TBUI IMEI ReadOly&quot;);
				if ((sSwitch1== &quot;Y&quot;)&amp;&amp;(sStockIndicator1 == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_UPG_STOCK_INDICATOR&quot;, &quot;Out of Stock&quot;)))
				{
				TheApplication().RaiseErrorText(&quot;IMEI value is not allowed when the stock indicator is chosen as Out Of Stock. Please clear the IMEI provided.&quot;);
				}
				with(TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Store Reservation Details Upgrade&quot;))
				{
				if(FirstRecord())
					TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before allocating IMEI.&quot;);
				}
				sErrorMsg = mPickIMEI(FieldValue, this.GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;));
				break;				
				
			case &quot;RO Customer Credit Period&quot;:
				var sNewContractTerm;
			
				// If upgrade to new plan, get the new contract term
				if (GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;) != &quot;Resign&quot;)
				{
					sNewContractTerm = GetFieldValue(&quot;New Term Name Constrained&quot;);
				}
				
				// If resign or outright, get the current contract term
				else if (GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;) == &quot;Resign&quot; || sNewContractTerm == &quot;Outright&quot;)
				{
					sNewContractTerm = GetFieldValue(&quot;RO Current Length of Contract&quot;); 
				}
			
				// If a credit period is greater than the new contract term
				if (ToInteger(FieldValue) &gt; ToInteger(sNewContractTerm))
				{
					sErrorMsg = &quot;This is greater than the length of the contract.  Please re-enter&quot;;
				}
				
				var nTotalCreditAmt = ToNumber(GetFieldValue(&quot;RO Customer Credit Incl GST&quot;));
							
				// Check if the credit is a one-off
				if (FieldValue == 1)
				{
					// Get the maximum one-off credit allowed
					var nMaxOneOffAmt = ToNumber(GetFieldValue(&quot;RO Max One Off Credit Amt&quot;));
					
					// Check if the one-off is greater than the max allowed by system preference
					if (nTotalCreditAmt &gt; nMaxOneOffAmt)
					{
						sErrorMsg = mFormatErrorMessage(&quot;The amount you have entered for this one-off store customer credit is greater than the maximum allowed by the system%s.  Please re-enter&quot;, nMaxOneOffAmt);
					}
				}
				
				this.SetUserProperty(&quot;ROCustCreditPeriodChanged&quot;,&quot;Y&quot;);
				
				break;
				
			case &quot;RO Customer Credit Incl GST&quot;:
				
				sErrorMsg = mValidateCreditAmount(FieldValue);
				
				this.SetUserProperty(&quot;ROCustCreditAmountChanged&quot;,&quot;Y&quot;);
				
				break;
			
			//Roseline:28/04/2016 - Added for R16.2 CIRs - Add SIM functionality for Upgrade Orders	
			case &quot;Stock Indicator&quot;:
		
			var sStockIndicator = this.GetFieldValue(&quot;Stock Indicator&quot;);
			if(sStockIndicator == &quot;Out of Stock&quot; &amp;&amp; FieldValue == &quot;In Stock&quot;)
			{
				this.SetUserProperty(&quot;DeleteAccessoryItems&quot;,&quot;Y&quot;);
			}
			if (sStockIndicator == &quot;In Stock&quot; &amp;&amp; FieldValue == &quot;Out of Stock&quot;)
			{
				with(TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Store Reservation Details Upgrade&quot;))
				{
				if(FirstRecord())
					TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before changing to Out of Stock.&quot;);
				}			
			}
			break;

			case &quot;Resign Upgrade Choice&quot;:
			{
				with(TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Store Reservation Details Upgrade&quot;))
				{
				if(FirstRecord())
					TheApplication().RaiseErrorText(&quot;Please UnReserve Store Reservation before changing Upgrade choice.&quot;);
				}
			}
			break;								
		}
		
		if (sErrorMsg != &quot;&quot;)
		{
			TheApplication().RaiseErrorText(sErrorMsg);
		}
		return (ContinueOperation);		
	}
	catch (e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw e;
	}
	finally
	{
	
	}
}"
			   SEQUENCE="47"
			   UPDATED="06/28/2024 18:53:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  PreSetFieldValue
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 09/01/2012	VIVIND		QC 1202		Added code for Breakfix Jan 2013, for the check on 
 *										&quot;RO Customer Credit Incl GST&quot;&amp;&quot;RO Customer Credit Period&quot;
 * 
*/

function BusComp_PreWriteRecord ()
{
	
	var strROCreditAmount;
	var strROCreditPeriod;
	var pROCustCreditPeriodChanged;
	var pROCustCreditAmountChanged;
	var sAmount;
	var sMonths;
	var sNewPlanId,sNewPropId,sNewPropBC,newGPPType,sNewPrdLine, SIMOLov=&quot;&quot;;
	
	try
	{
		SIMOLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;SIMO_TWO_DOT_ZERO&quot;);
		if(SIMOLov == &quot;SIMO_TWO_DOT_ZERO_Y&quot;)//25062025:RAJUD:Added LOV switch check. 
		{
			sNewPlanId = this.GetFieldValue(&quot;SIMO New Plan Category Id&quot;);
			if (sCheckSIMOValidation == &quot;Y&quot; &amp;&amp; sNewPlanId != &quot;&quot;)
			{
				sCheckSIMOValidation = &quot;N&quot;;
				TheApplication().RaiseErrorText(&quot;Current and New Plan are SIMO.&quot;);
			}
				//TRISHAG R1.2 SIMO 19/2/25
				this.ActivateField(&quot;New Prod Line Name&quot;);
				this.ActivateField(&quot;New Proposition Id&quot;);
				sNewPrdLine = this.GetFieldValue(&quot;New Prod Line Name&quot;);
				sNewPropId = this.GetFieldValue(&quot;New Proposition Id&quot;);
				sNewPropBC = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA Target Plan GPP Simplification&quot;);
						with(sNewPropBC)
						{
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;ChildProdType&quot;);
							SetSearchExpr(&quot;[Id]= &apos;&quot; +sNewPropId+ &quot;&apos; AND [ChildProdType] = &apos;Billing - GPP&apos;&quot;);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
								newGPPType = &quot;Y&quot;;
						}
						if (sNewPrdLine !=&quot;&quot; &amp;&amp; sSimoUpgFlg == &quot;Y&quot; &amp;&amp; newGPPType != &quot;Y&quot;)
						{
							sSimoUpgFlg = &quot;N&quot;;
							TheApplication().RaiseErrorText(&quot;Legacy MTM SIM Only Plan to Market MTM SIM Only Plan Upgrade is not possible. Kindly select a different Plan&quot;);
						}
	
							//end TRISHAG R1.2 SIMO 19/2/25
			}			//end RAJUD 

		pROCustCreditPeriodChanged = this.GetUserProperty(&quot;ROCustCreditPeriodChanged&quot;);//from presetfield
		pROCustCreditAmountChanged = this.GetUserProperty(&quot;ROCustCreditAmountChanged&quot;);//from presetfield
		
		
		
		if(pROCustCreditPeriodChanged == &quot;Y&quot; || pROCustCreditAmountChanged == &quot;Y&quot;)
		{
		
			strROCreditAmount = this.GetFieldValue(&quot;RO Customer Credit Incl GST&quot;);
			strROCreditPeriod = this.GetFieldValue(&quot;RO Customer Credit Period&quot;);
			
			sAmount = strROCreditAmount;
			sMonths = strROCreditPeriod;
			
			if(sSkipValidation == &quot;N&quot;)// Neel - Perform Validation Only on OK of Store Offer Applet
			{
			
				if (sAmount == &quot;&quot; &amp;&amp; sMonths == &quot;&quot;)
				{
					//Do nothing
				}
				else if (sAmount != &quot;&quot; &amp;&amp; sMonths == &quot;&quot;)
				{
					if (sAmount == &quot;0&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Amount cannot be Zero. Please enter valid values for Amount &amp; Months under the Reconnection Offer.&quot;);
					}
					else
					{
						TheApplication().RaiseErrorText(&quot;Amount cannot be set without having the Months. Please enter valid values for Amount &amp; Months under the Reconnection Offer.&quot;);
					}	
				}
				else if  ((sAmount == &quot;&quot; || sAmount == &quot;0&quot;) &amp;&amp; sMonths != &quot;&quot;)
				{
					TheApplication().RaiseErrorText(&quot;Months cannot be set for without having an amount. Please enter valid values for Amount &amp; Months under the Reconnection Offer.&quot;);
				}
			}
			
			sSkipValidation = &quot;N&quot;;
		}
	
		return (ContinueOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		SIMOLov=null;
	}

}"
			   SEQUENCE="48"
			   UPDATED="06/25/2025 21:43:05"
			   UPDATED_BY="RAJUD"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	BusComp_SetFieldValue
 * Component Information :  
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/06/2010	SARITAB						Added code for eUpgrade EUF requirement 10.4 rel
 * SARITAB implemented the try catch block declaring all variables at the begining of the try block
 * 27/06/2011	VIKASK						Added code for R11C:MKT02 - passing Value Band to IsWaiveEUFDevice
 * 01/09/2011	EW							Added code for iPhone 5 readiness
 * 27/10/2011	EW							Changed code for 11.E (Forced MPP)
 * 29/03/2012	EW							Updated for 12.3 (CVM)
 * 13/04/2012	BASUA						Updated for CVM. Release 12.3.
 * 26/07/2012	MP							Updated for TD: 15650
 * 28/08/2012	BASUA						Added code for CVM P2
 * 27/09/2012	EW							Cleaned up code and created sub-function for upgrade calculations
 */
function BusComp_SetFieldValue (FieldName)
{	
	var bcOfferPickList;
	var sCurrentPlanId;				
	var sOfferId, strNewPlanName, strCurrentPlanName, sErrorMessage, sScenario, strDeviceName, strResignUpgradeChoice,sCurrentPrdLine, sRootAstId, GPPType;
	var RelFlg = &quot;&quot;;
	var SCEN_CURRENT_PLAN_WITH_DEVICE = &quot;Current Plan with Every Device&quot;;
	var SCEN_CURRENT_PLAN_NO_DEVICE = &quot;Current Plan with No Device&quot;;
	var SCEN_EVERY_PLAN_WITH_DEVICE = &quot;Every Valid Plan with Every Device&quot;;
	var SCEN_EVERY_PLAN_NO_DEVICE = &quot;Every Plan with No Device&quot;;
	var SCEN_OUTRIGHT_DEVICE = &quot;Outright with Every Device&quot;;
	var SCEN_ACCOUNT_LEVEL_NO_DEVICE = &quot;Account Level Plan with No device&quot;;
	var SIMOLov = &quot;&quot;,Simo=&quot;&quot;;//18062025:RAJUD:Added this for set blank value when user check/uncheck SIMO check box defect CM-3813

	//VF BASUA 13/02/2004 - Start
	//Added for CVM
	var nTotalCredit, nPeriod, nCreditPerMonth;
	//VF BASUA 13/02/2004 - End

	try
	{	
		RelFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_RELEASE_SWITCH&quot;,&quot;RELEASE_ONE_DOT_TWO&quot;);
		SIMOLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;SIMO_TWO_DOT_ZERO&quot;);
		switch(FieldName)
		{

			case &quot;SIM Only Flag&quot;:
				Simo = GetFieldValue(&quot;SIM Only Flag&quot;);
				//18062025:RAJUD:Added this block for set blank value when user uncheck SIMO check box defect CM-3813
				if(SIMOLov == &quot;SIMO_TWO_DOT_ZERO_Y&quot;)
				{
					if (Simo == &quot;Y&quot;)
					{
						//TrishaG added for SIMO R1.2
						var sStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_UPG_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);
						this.SetFieldValue(&quot;Stock Indicator&quot;,sStock) ;							
					}	
					//18062025:RAJUD:Added this for set blank value when user check SIMO check/uncheck box defect CM-3813
					this.SetFieldValue(&quot;VF CVM Upgrade New Handset Make&quot;,&quot;&quot;);
					this.SetFieldValue(&quot;Device Model Temporary&quot;,&quot;&quot;);
					this.SetFieldValue(&quot;VF CVM Upgrade New Plan Name&quot;,&quot;&quot;);
				}
				//end-18062025:RAJUD:Added this block for set blank value when user check/uncheck SIMO check box defect CM-3813	
				break;
					
			case &quot;New Plan Name&quot;:
					if(SIMOLov == &quot;SIMO_TWO_DOT_ZERO_Y&quot;)//25062025:RAJUD:Added LOV switch check. 
					{
						this.ActivateField(&quot;SIMO Current Plan Category Id&quot;);
						//TRISHAG R1.2 SIMO 19/2/25
						this.ActivateField(&quot;Current Prod Line Name&quot;);
						this.ActivateField(&quot;Root Asset Id&quot;);
						sCurrentPlanId = this.GetFieldValue(&quot;SIMO Current Plan Category Id&quot;);
						if (sCurrentPlanId != &quot;&quot; &amp;&amp; RelFlg == &quot;Y&quot;)
							sCheckSIMOValidation = &quot;Y&quot;;
						sCurrentPrdLine = this.GetFieldValue(&quot;Current Prod Line Name&quot;);
						sRootAstId = this.GetFieldValue(&quot;Root Asset Id&quot;);
						var sAssetDtls = TheApplication().GetBusObject(&quot;VHA MSP Admin BO wo link&quot;).GetBusComp(&quot;VHA Simplified Asset Details BC&quot;);
						with(sAssetDtls)
						{
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;RootAssetId&quot;);
							ActivateField(&quot;PlanProdType&quot;);
							SetSearchExpr(&quot;[RootAssetId]= &apos;&quot; +sRootAstId+ &quot;&apos; AND [PlanProdType] = &apos;Billing - GPP&apos;&quot;);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
								GPPType = &quot;Y&quot;;
						}
						if (sCurrentPrdLine !=&quot;&quot; &amp;&amp; RelFlg == &quot;Y&quot; &amp;&amp; sCurrentPlanId == &quot;&quot;  &amp;&amp; GPPType != &quot;Y&quot;)
							sSimoUpgFlg = &quot;Y&quot;;
	
							//end TRISHAG R1.2 SIMO 19/2/25
					}	//end RAJUD
					break;
			case &quot;Override Eligibility&quot;:
				TheApplication().SetProfileAttr(&quot;usrOverrideEligibility&quot;,this.GetFieldValue(&quot;Override Eligibility&quot;));
				break;
		
			//KPoluru: 15/06/2010: 10.4 Early Upgrades: When any offer, accessory or non device  is selected &quot;Resign Upgrade Choice&quot; will
			//be reset so the user is forced to select the resign/upgrade choice to calculate the RCC accordingly
			case &quot;Primary Accessory Item Id&quot;:
			case &quot;Primary Non Device Item Id&quot;:	
				sOfferId = this.GetFieldValue(&quot;Id&quot;);
				
				// EW 31/05/2011 - If in the Merlin wizard, do not reset this
				// Neel 18/05/2014 - Perform the same logic as Merlin for TBUI
				//Roseline 19/06/2014 - Changed BO name from &apos;VF TBUI&apos; to &apos;Order Entry (Sales)&apos;
				if (this.BusObject().Name() != &quot;VF Wizard&quot; &amp;&amp; this.BusObject().Name() != &quot;Order Entry (Sales)&quot;)
				{
					this.SetFieldValue(&quot;Resign Upgrade Choice&quot;, &quot;N/A&quot;);
				}
				this.WriteRecord(); 
//			    this.SetSearchSpec(&quot;Id&quot;, sOfferId); //Nikhil Joshi: 30.09.2014: Commented for Upgrade MSO
//				this.ExecuteQuery();
				this.InvokeMethod(&quot;RefreshRecord&quot;); //Nikhil Joshi: 30.09.2014: Added for Upgrade MSO
				
				break;
			//end Kpoluru:15/06/2010
		
			case &quot;Cal Offer Matrix Id&quot;:				
			case &quot;Times Calculated&quot;:
			
				// EW 27/09/2012 - Perform the upgrade calculations.  Code moved to sub-function so that it
				// can be called directly
				mPerformUpgradeCalc();			
				break;
		
			//KPoluru: 15/06/2010: 10.4 Early Upgrades: Everytime the Upgrade/Resign choice is made
			//in the upgrade/resign smartscripts, RCC will be recalculated 
			// Neel 18/05/2014 - Perform the same logic as Merlin for TBUI
			//Roseline 19/06/2014 - Changed BO name from &apos;VF TBUI&apos; to &apos;Order Entry (Sales)&apos;
			case &quot;Resign Upgrade Choice&quot;:
				if (this.BusObject().Name() != &quot;VF Wizard&quot; &amp;&amp; this.BusObject().Name() != &quot;Order Entry (Sales)&quot;)
				{
					this.WriteRecord();
		
					// Get the details
					sScenario = this.GetFieldValue(&quot;Scenario&quot;); 
					strResignUpgradeChoice = this.GetFieldValue(&quot;Resign Upgrade Choice&quot;);
					strCurrentPlanName = this.GetFieldValue(&quot;Current Plan Name&quot;); 
					strDeviceName = this.GetFieldValue(&quot;Device Name&quot;);
					strNewPlanName = this.GetFieldValue(&quot;New Plan Name&quot;);
					sOfferId = this.GetFieldValue(&quot;Id&quot;);
					bcOfferPickList = this.GetPicklistBusComp(&quot;New Plan Name&quot;);	
					
					// If doing a resign and the upgrade resign choice is changed to &apos;Upgrade&apos;
					if(strNewPlanName == &quot;Current Plan&quot; &amp;&amp; strResignUpgradeChoice == &quot;Upgrade&quot;
					   &amp;&amp; (sScenario == SCEN_CURRENT_PLAN_WITH_DEVICE || sScenario == SCEN_EVERY_PLAN_WITH_DEVICE))
					{
						// Try to pick the &apos;Upgrade&apos; offer
						mPickOffer(bcOfferPickList, strCurrentPlanName, strDeviceName);
					}
					
					// If doing an upgrade on the same plan as current and the upgrade resign choice is changed to &apos;Resign&apos;
					else if(strCurrentPlanName == strNewPlanName &amp;&amp; strResignUpgradeChoice == &quot;Resign&quot;
					   &amp;&amp; (sScenario == SCEN_CURRENT_PLAN_WITH_DEVICE || sScenario == SCEN_EVERY_PLAN_WITH_DEVICE))
					{
						// Try to pick the &apos;Resign&apos; offer
						mPickOffer(bcOfferPickList, &quot;Current Plan&quot;, strDeviceName);
					}
					
					// Redo the upgrade calculations
					mPerformUpgradeCalc();
					
					this.WriteRecord();
//					this.SetSearchSpec(&quot;Id&quot;, sOfferId); //Nikhil Joshi: 30.09.2014: Commented for Upgrade MSO
//					this.ExecuteQuery();
					this.InvokeMethod(&quot;RefreshRecord&quot;); //Nikhil Joshi: 30.09.2014: Added for Upgrade MSO
				}
				var sUpgChoice = GetFieldValue(&quot;Resign Upgrade Choice&quot;);
				//TheApplication().SetProfileAttr(&quot;UpgChoice&quot;,sUpgChoice);
				if(sUpgChoice == null || sUpgChoice == &quot;&quot;)
				{
					
					this.ActivateField(&quot;VF Sales Calc Quote Item Id&quot;);
					var sQuoteItemId = this.GetFieldValue(&quot;VF Sales Calc Quote Item Id&quot;);
					//TheApplication().SetProfileAttr(&quot;UpgChoicePlusQItemId1&quot;,sUpgChoice+&quot;,&quot;+sQuoteItemId);
					if(sQuoteItemId != null &amp;&amp; sQuoteItemId != &quot;&quot;)
					{
						var sQuoteItembc = TheApplication().GetBusObject(&quot;Quote&quot;).GetBusComp(&quot;Quote Item&quot;);
						with(sQuoteItembc)
						{
								
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;VF Sales Calc Order Info&quot;);
							SetSearchSpec(&quot;Id&quot;,sQuoteItemId);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{	
								SetFieldValue(&quot;VF Sales Calc Order Info&quot;,&quot;&quot;);
								WriteRecord();
								
							}
						}
					}
				}
				//this.InvokeMethod(&quot;RefreshRecord&quot;);
				break;
						
		
			case &quot;Stock Indicator&quot;:
				var sStockIndicator = GetFieldValue(&quot;Stock Indicator&quot;);
				
				// If Out of Stock, blank out the IMEI
				if (sStockIndicator == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_UPG_STOCK_INDICATOR&quot;, &quot;Out of Stock&quot;))
				{
				
					TheApplication().SetProfileAttr(&quot;CheckStkAvaliButton&quot;,&quot;Out of Stock&quot;);//Vinodhini-04/06/2016-Added for RTSA
					this.SetFieldValue(&quot;IMEI&quot;, &quot;&quot;);
					this.SetFieldValue(&quot;IMEI with Pick&quot;, &quot;&quot;);

					// If we are using the retention optimiser than do not blank out these fields				
					if (TheApplication().GetProfileAttr(&quot;RetentionOptimiserFlag&quot;) != &quot;Y&quot;)
					{
						this.SetFieldValue(&quot;Device Model Temporary&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;Device Make Temporary&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;New Plan Name Constrained&quot;, &quot;&quot;);
					}
				}		
			
				if(sStockIndicator == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_UPG_STOCK_INDICATOR&quot;, &quot;In Stock&quot;))
				{
				
					TheApplication().SetProfileAttr(&quot;CheckStkAvaliButton&quot;,&quot;In Stock&quot;);//Vinodhini-04/06/2016-Added for RTSA
					
					// If we are using the retention optimiser than do not blank out these fields				
					if (TheApplication().GetProfileAttr(&quot;RetentionOptimiserFlag&quot;) != &quot;Y&quot;)
					{			
						this.SetFieldValue(&quot;Device Code Temporary&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;Device Model Temporary&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;Device Make Temporary&quot;, &quot;&quot;);
						this.SetFieldValue(&quot;New Plan Name Constrained&quot;, &quot;&quot;);
					}
					
				}			
				break;
		
			case &quot;IMEI with Pick&quot;:
				var sIMEIError = &quot;&quot;;
				
				// EW 27/10/2011 - If there was a device mismatch and offer was reset, display a warning message to the user
				if (this.GetUserProperty(&quot;Device Mismatch&quot;) == &quot;Y&quot;)
				{
					this.SetUserProperty(&quot;Device Mismatch&quot;, &quot;&quot;);
					
					if (this.GetFieldValue(&quot;Offer Matrix Id&quot;) == &quot;&quot;)
					{
						sIMEIError = &quot;Product code of the IMEI entered does not match the offer selected. Please reselect the offer.&quot;;
					}
					else
					{
						sIMEIError = &quot;Product code of the IMEI entered did not match the offer selected.  The offer has been reselected with the new product.  Please review the offer before proceeding.&quot;;
					}
				
					TheApplication().RaiseErrorText(sIMEIError);
				}
				break;

			//VF BASUA 13/02/2004 - Start
			//Added for CVM
			case &quot;RO Customer Credit Incl GST&quot;:
			case &quot;RO Customer Credit Period&quot;:
				nTotalCredit = this.GetFieldValue(&quot;RO Customer Credit Incl GST&quot;);
				nPeriod = this.GetFieldValue(&quot;RO Customer Credit Period&quot;);

				if(nTotalCredit.length &gt; 0 &amp;&amp; nPeriod.length &gt; 0)
				{
					nCreditPerMonth = nTotalCredit/nPeriod;

					if(nCreditPerMonth &gt; Math.abs(nCreditPerMonth))
					{
						//Round to two decimal places, in favour of customer
						nCreditPerMonth = Math.ceil(nTotalCredit/nPeriod * 100)/100;
					}

					this.SetFieldValue(&quot;RO Customer Credit Per Month Incl GST&quot;, nCreditPerMonth);
				}
				else
				{
					this.SetFieldValue(&quot;RO Customer Credit Per Month Incl GST&quot;, &quot;&quot;);
				}
				mPerformSubsidyCalc();//Reconnection Tool PH4,VIJAYE,22 Jan 2014
				break;
			//VF BASUA 13/02/2004 - End

			//VF BASUA 29/08/2012 - Start
			//Added for CVM P2
			case &quot;VF CVM Upgrade New Handset Code&quot;:
				if (GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;) == &quot;Upgrade to New Plan&quot;)
				{
					mSetUpgradeHandsetDetails();
					mSetUpgradePlanAndOfferDetails();
				}
				
				break;
			case &quot;VF CVM Upgrade New Plan Code&quot;:
				if (GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;) == &quot;Upgrade to New Plan&quot;)
				{
					mSetUpgradePlanAndOfferDetails();
				}
				break;

			case &quot;Device Make Temporary&quot;:
			 var ViewUpgrade = TheApplication().ActiveViewName();
			 if(ViewUpgrade == &quot;VF Eligibility and Offers View - TBUI&quot; &amp;&amp; (this.GetFieldValue(&quot;Device Make Temporary&quot;) == &quot;Non Device&quot; || this.GetFieldValue(&quot;Device Make Temporary&quot;) == &quot;&quot;))
			 {
			   var sChildofferBC=TheApplication().ActiveBusObject().GetBusComp(&quot;VHA Upgrade Child Offer BC&quot;)
               var sSwapgoInsurace = sChildofferBC.GetFieldValue(&quot;VHA NewDevice Insurance&quot;);
			   if(sSwapgoInsurace!=null &amp;&amp; sSwapgoInsurace!=&quot;&quot;)
			   {
                  sChildofferBC.SetFieldValue(&quot;VHA NewDevice Insurance&quot;,&quot;&quot;);
				  sChildofferBC.WriteRecord();				  
			   } 
            
			 }		
		    	break;
			case &quot;New Plan Name Constrained&quot;: //CMID
				TheApplication().SetProfileAttr(&quot;TBUIPegaUpgrade&quot;,&quot;&quot;);
			break;	
			//VF BASUA 29/08/2012 - End
			default :
				break;	
		} //End of Switch
	} //End of Try
	catch(e)
	{
	//VF:ROSELINE 10/09/2014 - Removed
	/* Define Error */
	/*	if(!defined(e.errText))
		{
			sErrorMessage = e.toString();
		}
		else
		{
   			sErrorMessage = e.errText;
	   	}
		throw(sErrorMessage);*/
		throw e;
	} //End of Catch
	finally
	{
		bcOfferPickList = null;
		SIMOLov=null;//18062025:RAJUD:Added this for set blank value when user check/uncheck SIMO check box defect CM-3813
	}
}"
			   SEQUENCE="49"
			   UPDATED="06/25/2025 21:43:06"
			   UPDATED_BY="RAJUD"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
try {
		var sOfferId = this.GetFieldValue(&quot;Id&quot;);
		if (sOfferId != null &amp;&amp; sOfferId != &quot;&quot;)
		{
//			this.SetSearchSpec(&quot;Id&quot;, sOfferId); //Nikhil Joshi: 30.09.2014: Commented for Upgrade MSO
//			this.ExecuteQuery();
			this.InvokeMethod(&quot;RefreshRecord&quot;); //Nikhil Joshi: 30.09.2014: Added for Upgrade MSO
		}
		//Roseline:28/04/2016 - Added for R16.2 CIRs - Add SIM functionality for Upgrade Orders
		if(this.GetUserProperty(&quot;DeleteAccessoryItems&quot;)==&quot;Y&quot;)//from presetfield
		{
			this.SetUserProperty(&quot;DeleteAccessoryItems&quot;,&quot;N&quot;);
			var sOfferItemBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
			var sOfferItemBC = sOfferItemBO.GetBusComp(&quot;VF Upgrade Offer Item&quot;);
			with(sOfferItemBC)
			{
				sOfferItemBC.SetViewMode(AllView);
				sOfferItemBC.ClearToQuery();
				sOfferItemBC.ActivateField(&quot;Item Name&quot;);
				sOfferItemBC.ActivateField(&quot;Type&quot;);
				sOfferItemBC.ActivateField(&quot;Upgrades Offer Id&quot;);
				var searchst = &quot;[Type] = &apos;Accessory&apos; AND [Upgrades Offer Id] = &apos;&quot; + sOfferId + &quot;&apos;&quot;;
				sOfferItemBC.SetSearchExpr(searchst);
				sOfferItemBC.ExecuteQuery();
				var isRec = sOfferItemBC.FirstRecord();
				while(isRec)
				{
					sOfferItemBC.DeleteRecord();
					isRec = sOfferItemBC.FirstRecord();
				}
			}
			/*var svcUI = TheApplication().GetService(&quot;FINS Teller UI Navigation&quot;);
			var psIn = TheApplication().NewPropertySet();
			var psOut = TheApplication().NewPropertySet();
			psIn.SetProperty(&quot;Refresh All&quot;,&quot;Y&quot;);
			svcUI.InvokeMethod(&quot;RefreshCurrentApplet&quot;,psIn,psOut);*/
			this.SetFieldValue(&quot;Primary Accessory Item Id&quot;,&quot;&quot;);
		}
		var boCurrent = TheApplication().ActiveBusObject();
		//var bcUpgrade = boCurrent.GetBusComp(&quot;VF Upgrade Offer&quot;);
		var bcUpgradeChild = boCurrent.GetBusComp(&quot;VHA Upgrade Child Offer BC&quot;);
		bcUpgradeChild.InvokeMethod(&quot;RefreshBusComp&quot;);

				}
		catch (e)
		{
		throw e;
		}
		finally
		{
		/*Below variables are nullified by Sharukh on 02/04/2019*/
		/*sOfferItemBC = null;
		sOfferItemBO = null;*/

       /*Below variables are nullified by BALAGURU on 03/10/2019*/
       if(defined(sOfferItemBC)) { sOfferItemBC = null; }
	   if(defined(sOfferItemBO)) { sOfferItemBO = null; }

		}
}"
