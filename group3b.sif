			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPickOffer"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  mPickOffer
 * Component Information :  Code copied from SetFieldValue
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 02/10/2012	EW						Created for 12.6
 */
function mPickOffer(bcOfferPickList, strPlanName, strDeviceName)
{
	try
	{
		bcOfferPickList.ActivateField(&quot;Plan Name&quot;);
		bcOfferPickList.ActivateField(&quot;Device Name&quot;);
		bcOfferPickList.ClearToQuery();
		bcOfferPickList.SetSearchSpec(&quot;Plan Name&quot;, strPlanName);				
		bcOfferPickList.SetSearchSpec(&quot;Device Name&quot;, strDeviceName);
		bcOfferPickList.ExecuteQuery(ForwardOnly);
		
		if (bcOfferPickList.FirstRecord())
		{
			TheApplication().SetProfileAttr(&quot;Reset Resign Upgrade Choice&quot;, &quot;False&quot;);
			bcOfferPickList.Pick();
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{

	}
}"
