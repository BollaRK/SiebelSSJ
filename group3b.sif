			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetUpgradeType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetUpgradeType
 * Component Information :  This code is gets the upgrade type based upon the scenario
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 08/08/2012	EW						Created for 12.6 CVM RO Phase 2
 */
function mGetUpgradeType(sUpgradeScenario)
{	
	try
	{
		switch (sUpgradeScenario)
		{
			case &quot;Current Plan with Every Device&quot;: case &quot;Current Plan with No Device&quot;:
				return (&quot;Resign&quot;);
				
			case &quot;Every Valid Plan with Every Device&quot;: case &quot;Every Plan with No Device&quot;:
				return (&quot;Upgrade to New Plan&quot;);
				
			case &quot;Outright with Every Device&quot;:
				return (&quot;Upgrade RRP on Instalment&quot;);
				
			default:
				return (&quot;&quot;);
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
