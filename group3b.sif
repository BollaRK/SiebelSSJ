			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetAvgDataUsed"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetAvgDataUsed(strAvgDataUsed)
{
	/* Component Name       : 	VF Upgrade Offer
	* Method Name           : 	mSetAvgDataUsed
	* Component Information :  This sets the Average Data used in separate lines
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 10/10/2014	ROSELINE				Added for INC000010659119 - Display the Average Date Used in UI
	*/
	try
	{
		var sAvgDataUsed = strAvgDataUsed.replace(/\;/g, &quot;\n&quot;);
		return (sAvgDataUsed);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
			   SEQUENCE="12"
