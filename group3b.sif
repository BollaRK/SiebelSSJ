			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateOrderHeader"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	CreateOrderHeader
 * Method Name           : 	
 * Component Information :  This code is effective a replica of the
 *							current code on the smartscript open
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 * 11/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
function mCreateOrderHeader(sAssetIntId, sProductId, sAssetId, sBillingAcctId, sServiceAcctId)
{
	var bsExistingOrder, bsNewOrder, bsRootProduct, bsInvokeWorkflow;
	var psInputs, psOutputs;
	var sOrderId, sOrderExists;
	var strError;
		
	var ORDER_SUBTYPE = &quot;Modify&quot;;
	var ORDER_TYPE = &quot;Sales Order&quot;;

	try 
	{
		// Initialise objects
		bsExistingOrder = TheApplication().GetService(&quot;VF OM Order Validation&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();
					
		psInputs.SetProperty(&quot;Root Asset Integration Id&quot;,sAssetIntId);
		
		// Check if there is an existing order
		bsExistingOrder.InvokeMethod(&quot;CheckForExistingOrderNoError&quot;, psInputs, psOutputs);
		sOrderExists = psOutputs.GetProperty(&quot;Order Exists&quot;);
		
		// If there is not an existing order
		if (sOrderExists != &quot;Y&quot; || sOrderExists == null) 
		{
			psInputs.Reset();
			psOutputs.Reset();
			
			bsNewOrder = TheApplication().GetService(&quot;VF OM New Order Creation&quot;);
			psInputs.SetProperty(&quot;Billing Account Id&quot;, sBillingAcctId);
			psInputs.SetProperty(&quot;Service Account Id&quot;, sServiceAcctId);
			psInputs.SetProperty(&quot;Order Sub Type&quot;, ORDER_SUBTYPE);
			psInputs.SetProperty(&quot;Order Type&quot;, ORDER_TYPE);
			
            // Madhav added to set  Property sets for NBA for Defaulting
			// Madhav 9/9/10 NBA - Added to default Reason Code &amp; Desc
			if (TheApplication().GetProfileAttr(&quot;NBAReasonCodeDefault&quot;) == &quot;Y&quot;)
			{
				TheApplication().SetProfileAttr(&quot;NBAReasonCodeDefault&quot;,&quot;N&quot;);
				TheApplication().SetProfileAttr(&quot;NBADescriptionDefault&quot;,&quot;&quot;);
            
				psInputs.SetProperty(&quot;NBAReasonCode&quot;, &quot;NBA Offer&quot;);
				psInputs.SetProperty(&quot;NBADescription&quot;, TheApplication().GetProfileAttr(&quot;NBADescriptionDefault&quot;));
			}
			
			// Create a new order header
			bsNewOrder.InvokeMethod(&quot;CreateOrderHeaderWithReasonCode&quot;, psInputs, psOutputs);
			sOrderId = psOutputs.GetProperty(&quot;Order Id&quot;);
		
			// Now modify the line items	
			bsInvokeWorkflow = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			psInputs.Reset();
			psOutputs.Reset();

			psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF OM Create Modify Order Line Items&quot;);
			psInputs.SetProperty(&quot;Billing Account Id&quot;, sBillingAcctId);
			psInputs.SetProperty(&quot;Service Account Id&quot;, sServiceAcctId);
			psInputs.SetProperty(&quot;Asset Integration Id&quot;, sAssetIntId);
			psInputs.SetProperty(&quot;Asset Id&quot;,  sAssetId);
			psInputs.SetProperty(&quot;Object Id&quot;,  sOrderId );
			psInputs.SetProperty(&quot;Active Quote Id&quot;,  sOrderId );
			psInputs.SetProperty(&quot;BypassProductConfigurator&quot;,  &quot;TRUE&quot;);
			bsInvokeWorkflow.InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
		} 
		else 
		{
			sOrderId = &quot;&quot;;
		}
				
		return (sOrderId);
	
	} 
	catch(e) 
	{
		if (defined(e.errText))
		{
			strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			strError = e.toString(); 
		}
		throw (strError);
	} 
	finally 
	{
		psOutputs = null;
		psInputs = null;
		bsInvokeWorkflow = null;
		bsRootProduct = null;
		bsNewOrder = null;
		bsExistingOrder = null;
	}	
}"
			   SEQUENCE="9"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateUpgradeOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	CreateOrder
 * Method Name           : 	
 * Component Information :  This code is effective a replica of the
 *							current code on the smartscript open
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 */
function mCreateUpgradeOrder()
{
	var boCurrent;
	var bcAsset, bcComponentAsset;
	
	var sOrderId, sAssetId, sAssetIntId, sRootProdId, sBillingAcctId, sServiceAcctId;
	
	try
	{
		// Initialise all objects
		boCurrent = BusObject();
		bcAsset = boCurrent.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		bcComponentAsset = mGetComponentAssetBC();
		
		sAssetId = bcAsset.GetFieldValue(&quot;Id&quot;);
		sAssetIntId = bcAsset.GetFieldValue(&quot;Integration Id&quot;);
		sBillingAcctId = bcAsset.GetFieldValue(&quot;Billing Account Id&quot;);
		sServiceAcctId = bcAsset.GetFieldValue(&quot;Service Account Id&quot;);
		
		sRootProdId = bcComponentAsset.GetFieldValue(&quot;Root Product Id&quot;);
					
		sOrderId = mCreateOrderHeader(sAssetIntId, sRootProdId, sAssetId, sBillingAcctId, sServiceAcctId);
		
		if (sOrderId != &quot;&quot;) 
		{
			this.SetFieldValue(&quot;Order Id&quot;, sOrderId);
			this.WriteRecord();
		}
		return (sOrderId);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcComponentAsset = null;
		bcAsset = null;
		boCurrent = null;
	}
}"
			   SEQUENCE="10"
