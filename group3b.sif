			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckMPPExists"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  Check MPP Exists
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/07/2012	MP						Added code for TD15650.
 * 22/10/2012   HARSHAS                 Updated for 12.6 TD 16039, change search spec
 */
function CheckMPPExists(sRootAssetId)
{
		try
		{
				var boAssetMgmt,bcAssetMgmt,bcAssetSubComp,sParAssetId,sMPPExist = &quot;N&quot;;
				
				boAssetMgmt   = TheApplication().GetBusObject(&quot;Asset Management&quot;);		
				bcAssetMgmt   = boAssetMgmt.GetBusComp(&quot;Asset Mgmt - Asset&quot;);
				bcAssetSubComp = boAssetMgmt.GetBusComp(&quot;Asset Mgmt - Asset - Sub-Components&quot;);
				
				bcAssetMgmt.ClearToQuery();
				bcAssetMgmt.SetViewMode(AllView);
				bcAssetMgmt.SetSearchSpec(&quot;Id&quot;, sRootAssetId);
				bcAssetMgmt.ExecuteQuery(ForwardOnly);
				
				if(bcAssetMgmt.FirstRecord())
				{
						sParAssetId = bcAssetMgmt.GetFieldValue(&quot;Id&quot;);
					 
						bcAssetSubComp.ClearToQuery();
						bcAssetSubComp.SetViewMode(AllView);
						bcAssetSubComp.ActivateField(&quot;Product Type&quot;);
						bcAssetSubComp.ActivateField(&quot;Status&quot;);
						bcAssetSubComp.SetSearchSpec(&quot;Parent Asset Id&quot;, sParAssetId);
						//bcAssetSubComp.SetSearchSpec(&quot;Product Name&quot;, &quot;MPP Contract&quot;)//TD16039 COmmented the code
					//	bcAssetSubComp.SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - MPP&quot;)//Revised Search Spec // VF:ROSELINE 10/09/2014 - Removed
					 // VF:Roseline 10/09/2014 - Created for QC defect# 1476 - To retrieve the MPP Remaining Balance for Outright
						bcAssetSubComp.SetSearchSpec(&quot;VF Product Type&quot;, &quot;Billing - MPP&quot;) 
						bcAssetSubComp.SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;)//Active MPP Line items of the asset.				
						bcAssetSubComp.ExecuteQuery(ForwardOnly);	
						if (bcAssetSubComp.FirstRecord())
						{
							sMPPExist = &quot;Y&quot;;
						}
				}
			return(sMPPExist);
		}
	catch(e)
	{
	  throw(e);
	}
	finally
	{
		bcAssetSubComp = null;
		bcAssetMgmt = null;
		boAssetMgmt = null;
	}
}"
			   SEQUENCE="2"
