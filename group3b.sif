			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ReCalculateEstimatedMPPBal"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  ReCalculateEstimatedMPPBal
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/07/2012	MP						Added code for TD15650.
 *27/09/2017    Vinodhini               Added code for PKE000000053643.
 *01/12/2017    Roseline                Added Additional conditions to calculate MPP Balance for M2M plans with Existing MPP contract
 */
function ReCalculateEstimatedMPPBal(iEUF,iMPP,dtPlanStDt,dtPlanEndDt,dtMPPStDt,dtMPPEndDt,sRootAssetId,sVariableUpgradeCharge,bIsWaiveEUF,iCurrentTermM2M)
{
try
{
  var sVariableUpgradeChargeSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_VARIABLE_UPG_CHARGE_SWITCH&quot;, &quot;VARIABLE_UPGRADE_CHARGE_CHECK&quot;);

	if(sVariableUpgradeChargeSwitch == &quot;Y&quot;)  //Added to Switch on/off the sync SIMO wiver CIR logic
	{
		if (sVariableUpgradeCharge != 0) //Added to sync the waive logic(SIMO WAIVER CIR) in both eligibility and MPP page 
		{
			if(iEUF == 0)
			{

			  if(iMPP != &quot;&quot;)
			  {
				if(dtPlanStDt==dtMPPStDt &amp;&amp; dtMPPEndDt&lt;=dtPlanEndDt)
				{
					iMPP = 0;
				}
				else
				{
					iMPP = GetMPPRemBal(sRootAssetId);
				}
			  }
			}
			else
			{
				iMPP = GetMPPRemBal(sRootAssetId);
			}
		}//	if (sVariableUpgradeCharge != 0)
		//Added to recalculate MPP balance for M2M plans becuase M2M plans have no loyalty and Remaining MPP should not be waived off 
     	else if(iCurrentTermM2M == 0) 
		{
			iMPP = GetMPPRemBal(sRootAssetId);
		}
		//Added to recalculate MPP balance only if the Scenario &lt;&gt; Waive. So if the MPP WaiveScenario = charge, Remaining MPP should be calculated 
		 else if(bIsWaiveEUF != &quot;Y&quot;)
		{
			iMPP = GetMPPRemBal(sRootAssetId);
		}
	  }//	if(sVariableUpgradeChargeSwitch == &quot;Y&quot;)
	  
		else
		{
			if(iEUF == 0)
			{

			  if(iMPP != &quot;&quot;)
			  {
				if(dtPlanStDt==dtMPPStDt &amp;&amp; dtMPPEndDt&lt;=dtPlanEndDt)
				{
					iMPP = 0;
				}
				else
				{
					iMPP = GetMPPRemBal(sRootAssetId);
				}
			  }
			}
			else
			{
				iMPP = GetMPPRemBal(sRootAssetId);
			}
		}
		return(iMPP);
}
catch(e)
{
	throw(e);	
}
finally
{
	
}
}"
			   SEQUENCE="44"
