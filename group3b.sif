			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetSubsidyProfAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 
 * Method Name           : 	mSetSubsidyProfAttr
 * Component Information : 	Sets some profile attributes used in the upgrade offer matrix pick applets
 *							based upon the proposed plan
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 08/08/2012	EW						Created for 12.6 CVM RO Phase 2
 * 28/08/2012	BASUA					Modified for CVM P2.
 * 06/02/2013	EW						Modified for CVM P3.
 */

function mSetSubsidyProfAttr(sPlanSAMId, sFutureContractTerm)
{
	var bsUpgradeUtils;
	var psInputs, psOutputs;
	
	var sCurrentPlanName, sCurrentContractTerm, sCurrentMonthsInContract, sFutureValueBand, sChurnPropensity, sCurrentValueBand, sUpgradeType, sPlanInvestCtg; 
	
	try
	{
		// Get fields from current bc
		sCurrentPlanName = this.GetFieldValue(&quot;Current Plan Name&quot;);
		sCurrentContractTerm = this.GetFieldValue(&quot;RO Current Length of Contract&quot;);
		sCurrentMonthsInContract = this.GetFieldValue(&quot;RO Current Months in Contract&quot;);
		sChurnPropensity = this.GetFieldValue(&quot;Churn Score With Default&quot;);
		sCurrentValueBand = this.GetFieldValue(&quot;RO Customer Current Value Band&quot;);
		
		switch (sPlanSAMId)
		{
			case &quot;Outright&quot;:
				sUpgradeType = &quot;Upgrade RRP on Instalment&quot;;
				sFutureContractTerm = sCurrentContractTerm;
				sPlanInvestCtg = mGetPlanInvestmentCategory(sCurrentPlanName, &quot;&quot;);
				break;
			
			case &quot;Current Plan&quot;:
				sUpgradeType = &quot;Resign&quot;;
				sFutureContractTerm = sCurrentContractTerm;
				sPlanInvestCtg = mGetPlanInvestmentCategory(sCurrentPlanName, &quot;&quot;);			
				break;
			
			default:
				sUpgradeType = &quot;Upgrade to New Plan&quot;;
				sPlanInvestCtg = mGetPlanInvestmentCategory(&quot;&quot;, sPlanSAMId);			
				break;
		}

		bsUpgradeUtils = TheApplication().GetService(&quot;VF Upgrade Utilities&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();
		
		psInputs.SetProperty(&quot;ChurnPropensity&quot;, sChurnPropensity);
		psInputs.SetProperty(&quot;CurrentContractTerm&quot;, sCurrentContractTerm);
		psInputs.SetProperty(&quot;CurrentMonthsInContract&quot;, sCurrentMonthsInContract);
		psInputs.SetProperty(&quot;CurrentValueBand&quot;, sCurrentValueBand);
		psInputs.SetProperty(&quot;FutureContractTerm&quot;, sFutureContractTerm);
		psInputs.SetProperty(&quot;PlanSAMId&quot;, sPlanSAMId);
		psInputs.SetProperty(&quot;UpgradeType&quot;, sUpgradeType);
		psInputs.SetProperty(&quot;PlanInvestCtg&quot;, sPlanInvestCtg);											
		
		bsUpgradeUtils.InvokeMethod(&quot;RetrieveAllSubsidyDetails&quot;, psInputs, psOutputs);

		// Set profile attributes.  We need to use profile attributes because this is the only way 
		// they would show up correctly on pick applet.  These profile attributes are not used anywhere else
		// Actual RO calculations do not use profile attributes
		TheApplication().SetProfileAttr(&quot;RO Customer Future Value Band&quot;, psOutputs.GetProperty(&quot;FutureValueBand&quot;));
		TheApplication().SetProfileAttr(&quot;RO Max Subsidy&quot;, psOutputs.GetProperty(&quot;MaxSubsidyExclGST&quot;));
		TheApplication().SetProfileAttr(&quot;RO Target Subsidy&quot;, psOutputs.GetProperty(&quot;TargetSubsidyExclGST&quot;));
		TheApplication().SetProfileAttr(&quot;RO Bonus Subsidy&quot;, psOutputs.GetProperty(&quot;BonusSubsidyExclGST&quot;));
		TheApplication().SetProfileAttr(&quot;RO Churn Subsidy&quot;, psOutputs.GetProperty(&quot;ChurnSubsidyExclGST&quot;));

		//VF BASUA 28/08/2012 - Start
		//Added for CVM P2. Used to show Handset Code on pick applet
		TheApplication().SetProfileAttr(&quot;RO Plan Code&quot;, sPlanSAMId);
		TheApplication().SetProfileAttr(&quot;RO Current Months In Contract&quot;, sCurrentMonthsInContract);
		TheApplication().SetProfileAttr(&quot;RO Current Value Band&quot;, sCurrentValueBand);
		TheApplication().SetProfileAttr(&quot;RO Current Term&quot;, sCurrentContractTerm);
		TheApplication().SetProfileAttr(&quot;RO Future Term&quot;, sFutureContractTerm);
		//VF BASUA 28/08/2012 - End		
		
		TheApplication().SetProfileAttr(&quot;RO Plan Investment Category&quot;, sPlanInvestCtg);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psOutputs = null;
		psInputs = null;
		bsUpgradeUtils = null;
	}
}"
			   SEQUENCE="37"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetUpgradeHandsetDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetUpgradeHandsetDetails()
{
/*******************************************************************************
 * Input			: N/A
 * Output			: N/A
 * Summary			: N/A
 *
 * History  :
 * Date			Author		Defect #	Description
 * *****************************************************************************
 * 28/08/2012	BASUA					Initial Version
 *
 *******************************************************************************/
	try
	{
		var bcPick;
		var sDeviceCode = this.GetFieldValue(&quot;VF CVM Upgrade New Handset Code&quot;);

		if (sDeviceCode != &quot;&quot;)
		{
			bcPick = this.GetPicklistBusComp(&quot;Device Make Temporary&quot;);

			with(bcPick)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Product Code&quot;);
				SetSearchSpec(&quot;Product Code&quot;, sDeviceCode);
				ExecuteQuery(ForwardOnly);

				if(FirstRecord())
				{
					Pick();
				}
			}
		}
		else
		{
			this.SetFieldValue(&quot;Device Make Temporary&quot;, &quot;&quot;);
			this.SetFieldValue(&quot;VHA Device Name&quot;, &quot;&quot;);
		}
	}
	catch(e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw(e);
	}
	finally
	{
		bcPick = null;
	}
}"
			   SEQUENCE="38"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetUpgradePlanAndOfferDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetUpgradePlanAndOfferDetails()
{
/*******************************************************************************
 * Input			: N/A
 * Output			: N/A
 * Summary			: N/A
 *
 * History  :
 * Date			Author		Defect #	Description
 * *****************************************************************************
 * 28/08/2012	BASUA					Initial Version
 *
 *******************************************************************************/
	try
	{
		var bcPick;

		var sPlanCode = this.GetFieldValue(&quot;VF CVM Upgrade New Plan Code&quot;);
		var sPlanTerm = this.GetFieldValue(&quot;VF CVM Upgrade New Plan Term&quot;);
		var sDeviceCode = this.GetFieldValue(&quot;VF CVM Upgrade New Handset Code&quot;);

		if(sPlanCode != &quot;&quot; &amp;&amp; sPlanTerm != &quot;&quot; &amp;&amp; sDeviceCode != &quot;&quot;)
		{
			//Step 2a - Plan and Device are both selected. Time to pick Upgrade Offer
			bcPick = this.GetPicklistBusComp(&quot;New Plan Name Constrained&quot;);

			with(bcPick)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Plan Code&quot;);
				ActivateField(&quot;Product Code&quot;);
				SetSearchSpec(&quot;Plan Code&quot;, sPlanCode);
				SetSearchSpec(&quot;Product Code&quot;, sDeviceCode);
				ExecuteQuery(ForwardOnly);

				if(FirstRecord())
				{
					Pick();
				}
			}
			
			// Perform the upgrade calculations.  Needs to be explicitly called because
			// calling the Pick() above does not trigger SetFieldValue code
			mPerformUpgradeCalc();
		}
		else if(sPlanCode == &quot;&quot; &amp;&amp; this.GetFieldValue(&quot;New Plan Name Constrained&quot;) != &quot;&quot;)
		{
			//Step 2b - Plan cleared. Offer needs to be cleared as well.
			this.SetFieldValue(&quot;New Plan Name Constrained&quot;, &quot;&quot;);
		}
	}
	catch(e)
	{
	//	var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw(e);
	}
	finally
	{
		bcPick = null;
	}
}"
			   SEQUENCE="39"
