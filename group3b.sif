			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetROFlag"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetROFlag
 * Component Information :  This code calculates the RO Flag based upon
 *							the upgrade type
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/08/2012	EW						Updated for 12.6 CVM RO Phase 2
 */
function mGetROFlag(sUpgradeType)
{
	try
	{
		switch (sUpgradeType)
		{
			case &quot;Resign&quot;:
				return (&quot;R&quot;);
				
			case &quot;Upgrade to New Plan&quot;:
				return (&quot;U&quot;);
				
			case &quot;Upgrade RRP on Instalment&quot;:
				return (&quot;O&quot;);
				
			default:
				return (&quot;N&quot;);
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
