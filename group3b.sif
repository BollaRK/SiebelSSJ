			<BUSCOMP_SERVER_SCRIPT
			   COMMENTS="NIRMAL 05/06/2014 : Created for VF Retrofit 8.1 Drop4"
			   INACTIVE="N"
			   NAME="mKillPersonalisationProfileAttributes"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mKillPersonalisationProfileAttributes ()
{
/*
 * Component Name        : 	
 * Method Name           : 	VF Wizard Utilities
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/04/2014	Sibi						Added to code to nullify Profile Attributes
*/

	try
	{
		
		TheApplication().SetProfileAttr(&quot;PersChannelFactor&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersCurrentContractTerm&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersUpgradeLevel&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersResignUpgradeChoice&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersCurrentRatePlan&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersValueBand&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersRootAssetId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersMonthsIntoContract&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersBillingAccountId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersAccountId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersServiceAccountPriceListId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersCurrentPlanId&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersExistingStartDate&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersExistingTerm&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersExistingEndDate&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersCustTenureFactor&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersAverageMarPerUser&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersInputsSet&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;PersByPassErrorLogging&quot;,&quot;&quot;);

		TheApplication().SetProfileAttr(&quot;Personalised_UO_Id&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;Personalised_PlanName&quot;,&quot;&quot;);
		TheApplication().SetProfileAttr(&quot;Personalised_Upgrade_Choice&quot;, &quot;&quot;);

	}
	catch (e)
	{
		throw (e);
	}
	finally
	{
		// Do Nothing
	}

}"
			   SEQUENCE="25"
			   UPDATED="09/30/2019 12:01:52"
