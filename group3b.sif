			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetValueBand"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetValueBand
 * Component Information :  This looks up the value band
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 */
function mGetValueBand(sValueBand)
{
	try
	{
        if (sValueBand ==&quot;&quot; || sValueBand == null)
        {
			sValueBand = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;DEF_VALUE_BAND&quot;, &quot;VALUEBAND&quot;);
		}
		return (sValueBand);	
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
