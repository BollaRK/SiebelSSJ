			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetComponentAssetBC"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetComponentAssetBC
 * Component Information :  This gets the asset component BC
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 */
function mGetComponentAssetBC()
{
	var boCurrent;
	var bcAsset, bcVFComponentAsset, bcComponentAsset;

	var sPrimCAId;

	try
	{
		// Initialise all objects
		boCurrent = BusObject();
		bcAsset = boCurrent.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		bcComponentAsset = boCurrent.GetBusComp(&quot;Asset Mgmt - Asset (Order Mgmt)&quot;);
		bcVFComponentAsset = boCurrent.GetBusComp(&quot;VF Asset Mgmt - Asset (Order Mgmt) eUpgrades&quot;);
	
		// Query the component asset business component to find the primary product
		// This component asset BC represents the primary product id, ie. the plan name.
		// If there is a primary product, we also need to get the term end date so that
		// we can work out how many months remaining in the contract.
		with (bcVFComponentAsset)
		{
			ClearToQuery();		
			ActivateField(&quot;Product Name&quot;);
			ActivateField(&quot;Primary Product Flag&quot;);
			SetSearchSpec(&quot;Primary Product Flag&quot;, &quot;Y&quot;);
			ExecuteQuery(ForwardOnly);
			
			if (FirstRecord())
			{
				sPrimCAId = bcVFComponentAsset.GetFieldValue(&quot;Id&quot;);
			}
			else
			{ 
				TheApplication().RaiseErrorText(&quot;No primary product on the selected asset found&quot;);
			}
		}
		
		with (bcComponentAsset)
		{
			ClearToQuery();
			ActivateField(&quot;Product Name&quot;);
			SetSearchSpec(&quot;Id&quot;, sPrimCAId);
			ExecuteQuery(ForwardOnly);	
		}
		
		return (bcComponentAsset);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		/*bcComponentAsset = null;  /* This variable is nullified by Sharukh on 02/04/2019*/
		
		if(defined(bcComponentAsset)) { bcComponentAsset = null; }/* This variable is nullified by BALAGURU on 03/10/2019*/
		bcVFComponentAsset = null;
		bcAsset = null;
		boCurrent = null;

		

	}
}"
			   SEQUENCE="13"
			   UPDATED="10/05/2019 02:32:14"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetEligibilityScenario"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetEligibilityScenario
 * Component Information :  This calculates the eligibility scenario
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 * 26/10/2011	EW						Simplified for 11.E (Forced MPP)
 */
function mGetEligibilityScenario(sEligibleUpgrade, sEligibleResign, sEligibleOutright)
{
	try
	{
		// VF:Roseline 05/08/2014 - Updated the script to set and show the eligibility scenario in TBUI Upgrade Postpaid flow
		var Display = &quot;&lt;B&gt;&lt;UL&gt;&quot;;
		var UPGRADE_TEXT = &quot;&lt;FONT COLOR=&apos;3300CC&apos;&gt;Upgrade to New Plan&lt;/FONT&gt;&quot;;
		var RESIGN_TEXT = &quot;&lt;FONT COLOR=&apos;009900&apos;&gt;Resign on Current Plan&lt;/FONT&gt;&quot; ;
		var OUTRIGHT_TEXT = &quot;&lt;FONT COLOR=&apos;FF6600&apos;&gt;Upgrade RRP on Instalment&lt;/FONT&gt;&quot;;
		var NOT_ELIGIBLE_TXT = &quot;&lt;FONT COLOR=&apos;CC0000&apos;&gt;Unfortunately you are not eligible for Upgrade to New Plan, Resign on Current Plan, or Outright with Full MPP&lt;/FONT&gt;&quot;;
		
		// Derive the eligibility of the asset
		
		if (sEligibleUpgrade == &quot;Y&quot; &amp;&amp; sEligibleResign == &quot;Y&quot; &amp;&amp; sEligibleOutright == &quot;Y&quot;)
		{
			//Display = &quot;Upgrade to New Plan , Resign on Current Plan , Upgrade RRP on Instalment&quot;;
			Display = Display + UPGRADE_TEXT + &quot;&lt;BR&gt;&quot; + RESIGN_TEXT + &quot;&lt;BR&gt;&quot; + OUTRIGHT_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (1);
		}
		else if (sEligibleUpgrade == &quot;Y&quot; &amp;&amp; sEligibleResign == &quot;N&quot; &amp;&amp; sEligibleOutright == &quot;Y&quot;)
		{
			//Display = &quot;Upgrade to New Plan , Upgrade RRP on Instalment&quot;;
			Display = Display + UPGRADE_TEXT + &quot;&lt;BR&gt;&quot; + OUTRIGHT_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (2);
		}
		else if (sEligibleUpgrade == &quot;N&quot; &amp;&amp; sEligibleResign == &quot;Y&quot; &amp;&amp; sEligibleOutright == &quot;Y&quot;)
		{
			//Display = &quot;Resign on Current Plan , Upgrade RRP on Instalment&quot;;
			Display = Display + RESIGN_TEXT + &quot;&lt;BR&gt;&quot; + OUTRIGHT_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (3);
		}
		else if (sEligibleUpgrade == &quot;Y&quot; &amp;&amp; sEligibleResign == &quot;Y&quot; &amp;&amp; sEligibleOutright == &quot;N&quot;)
		{
			//Display = &quot;Upgrade to New Plan , Resign on Current Plan&quot;;
			Display = Display + UPGRADE_TEXT + &quot;&lt;BR&gt;&quot; + RESIGN_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (4);
		}
		else if (sEligibleUpgrade == &quot;N&quot; &amp;&amp; sEligibleResign == &quot;N&quot; &amp;&amp; sEligibleOutright == &quot;Y&quot;)
		{
			//Display = &quot;Upgrade RRP on Instalment&quot;;
			Display = Display + OUTRIGHT_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (5);
		}
		else if (sEligibleUpgrade == &quot;N&quot; &amp;&amp; sEligibleResign == &quot;Y&quot; &amp;&amp; sEligibleOutright == &quot;N&quot;)
		{
			//Display = &quot;Resign on Current Plan&quot;;
			Display = Display + RESIGN_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (6);
		}
		else if (sEligibleUpgrade == &quot;Y&quot; &amp;&amp; sEligibleResign == &quot;N&quot; &amp;&amp; sEligibleOutright == &quot;N&quot;)
		{
			//Display = &quot;Upgrade to New Plan&quot;;
			Display = Display + UPGRADE_TEXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (7);
		}
		else if (sEligibleUpgrade == &quot;N&quot; &amp;&amp; sEligibleResign == &quot;N&quot; &amp;&amp; sEligibleOutright == &quot;N&quot;)
		{
			//Display = &quot;Unfortunately you are not eligible for Upgrade to New Plan, Resign on Current Plan, or Outright with Full MPP&quot;;
			Display = Display + NOT_ELIGIBLE_TXT;
			this.SetFieldValue(&quot;VF Eligibility Display TBUI&quot;, Display);
			return (0);
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
			   SEQUENCE="14"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetOrderNumber"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetOrderNumber(sOrderId)
{
/*
 * Method Name           :  mGetOrderNumber
 * Component Information : 	
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 06/11/2012	HR	12.6	CVM RO PH2	Initial version			
 *									
 */

try
	{
		// Declare Variables	
		var sOrderNumber = &quot;&quot;;
		
		// Declare Objects
		var	boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var	bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		
		if(sOrderId != &quot;&quot;)
		{
			bcOrder.SetViewMode(AllView);
			bcOrder.ClearToQuery();
			bcOrder.SetSearchSpec(&quot;Id&quot;, sOrderId);
			bcOrder.ExecuteQuery(ForwardOnly);
		}
	
		if(bcOrder.FirstRecord())
		{
			sOrderNumber = bcOrder.GetFieldValue(&quot;Order Number&quot;);
		}

		return(sOrderNumber);
	}
	catch(e)
	{
		// Error Handling		
		var sError = e.toString();
		throw(e);
		
	}	
	finally
	{	
		// Destroy Objects

		/*Below variables are nullified by Sharukh on 02/04/2019*/
		/*var	bcOrder = null;	
		var	boOrder = null;*/
        
		/*Below variables are nullified by BALAGURU on 03/10/2019*/ 
		if(defined(bcOrder)) { bcOrder = null; }
		if(defined(boOrder)) { boOrder = null; }
		
	}
}"
			   SEQUENCE="15"
