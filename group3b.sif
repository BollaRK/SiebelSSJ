			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mRecalcMPPBalance"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  mRecalcMPPBalance
 * Component Information :  Event handler
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 20/08/2012	EW						Moved code from SetFieldValue as it was too long
 *27/09/2017    Vinodhini               Added passed sVariableUpgradeCharge variable for PKE000000053643
 *01/12/2017    Roseline                Passed additional input parameters
 */
function mRecalcMPPBalance(sEUFCharge, sMPPRemBalance, strRootAssetId,sVariableUpgradeCharge,bIsWaiveEUF,sCurrentTermM2M)
{
	var sPlanStDt,sPlanEndDt,sMPPStDt,sMPPEndDt;
	var dtPlanStDt,dtPlanEndDt,dtMPPStDt,dtMPPEndDt;				   		
	var arrDate,iDay,iMonth,iYear;

	try
	{					   		
		sPlanStDt=TheApplication().GetProfileAttr(&quot;Contract Start Date&quot;);
		sPlanEndDt=TheApplication().GetProfileAttr(&quot;Contract End Date&quot;);
		sMPPStDt=TheApplication().GetProfileAttr(&quot;MPP Start Date&quot;);
		sMPPEndDt=TheApplication().GetProfileAttr(&quot;MPP End Date&quot;);
		
		arrDate = sPlanStDt.split(&quot;/&quot;);		
		iDay = ToInteger(arrDate[1]);
		iMonth = ToInteger(arrDate[0]);
		iYear = ToInteger(arrDate[2]);
						
		dtPlanStDt = new Date( iYear, iMonth, iDay);
				   		
		arrDate = sPlanEndDt.split(&quot;/&quot;);		
		iDay = ToInteger(arrDate[1]);
		iMonth = ToInteger(arrDate[0]);
		iYear = ToInteger(arrDate[2]);						
		dtPlanEndDt = new Date( iYear, iMonth, iDay);
						
		//. MPP Start Date is of DD/MM/YYYY format unlike other dates which are of MM/DD/YYYY format
		arrDate = sMPPStDt.split(&quot;/&quot;);		
		iDay = ToInteger(arrDate[0]);
		iMonth = ToInteger(arrDate[1]);
		iYear = ToInteger(arrDate[2]);						
		dtMPPStDt = new Date( iYear, iMonth, iDay);						
		arrDate = sMPPEndDt.split(&quot;/&quot;);		
		iDay = ToInteger(arrDate[1]);
		iMonth = ToInteger(arrDate[0]);
		iYear = ToInteger(arrDate[2]);
						
		dtMPPEndDt = new Date( iYear, iMonth, iDay);
	
		sMPPRemBalance = ReCalculateEstimatedMPPBal(ToNumber(sEUFCharge),ToNumber(sMPPRemBalance),dtPlanStDt,dtPlanEndDt,dtMPPStDt,dtMPPEndDt,strRootAssetId,ToNumber(sVariableUpgradeCharge),bIsWaiveEUF,ToNumber(sCurrentTermM2M));

		return (sMPPRemBalance);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	
	}
}"
