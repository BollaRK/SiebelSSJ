			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mWaiveOffEUF"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mWaiveOffEUF(sEUFCharge)
{
/*
 * Component Name        :  VF Upgrade Offer
 * Method Name           :  mWaiveOffEUF
 * Component Information :  Sets the ETC charge to Zero for fredom plan during Upgrade order - PKE59566
 *
 * Modification History  :
 * Date   Author  Config # Description
 * ============ =========== =========== ================================
 * 23/03/2018 Indumathi   Initial Version 18.2
 * 
 */
 try
 {

  var sFromGroup = &quot;&quot;, sToGroup = &quot;&quot;, mWaiveOffETC = &quot;&quot;;
  var sTransType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_TRANS_TYPE&quot;, &quot;UPGRADE&quot;);
  var sCurPlanVendrNo = this.GetFieldValue(&quot;Current Plan Code&quot;);
  var sNewPlanVendrNo = this.GetFieldValue(&quot;New Plan Code&quot;);
  var sUpgOfferType = this.GetFieldValue(&quot;Resign Upgrade Choice&quot;);
  var boGroupMTX = TheApplication().GetBusObject(&quot;VF Plan Group Matrix&quot;);
  var bcGroupMTX = boGroupMTX.GetBusComp(&quot;VF Plan Group Matrix&quot;);
  var boGroupWavMTX = TheApplication().GetBusObject(&quot;VHA Freedom BO&quot;);
  var bcGroupWavMTX = boGroupWavMTX.GetBusComp(&quot;VHA Plan Group Waive Matrix&quot;);	  
	//Query Rate Plan Group Matrix and fetch Group name for new &amp; current plan
	with(bcGroupMTX)
		{  
	      ClearToQuery;
		  SetViewMode(AllView);
		  ActivateField(&quot;Rate Plan SAM Id&quot;);
		  ActivateField(&quot;Group Name&quot;);
  		  SetSearchExpr(&quot;[Rate Plan SAM Id] = &apos;&quot; + sNewPlanVendrNo + &quot;&apos; OR [Rate Plan SAM Id] = &apos;&quot; + sCurPlanVendrNo + &quot;&apos;&quot;);
		  ExecuteQuery(ForwardOnly);
		  var iRec = FirstRecord();
		  while(iRec)
		  {   
			if(GetFieldValue(&quot;Rate Plan SAM Id&quot;) == sCurPlanVendrNo)
			sFromGroup = GetFieldValue(&quot;Group Name&quot;);
			else if(GetFieldValue(&quot;Rate Plan SAM Id&quot;) == sNewPlanVendrNo)
			sToGroup = GetFieldValue(&quot;Group Name&quot;);
			iRec = NextRecord();
		  }
		 }  
	  if (sUpgOfferType == &quot;Resign&quot;)
      sToGroup   = sFromGroup;
      //Query Plan Group Waive Matrix and confirm for waive off
	  if (sToGroup !=&quot;&quot; &amp;&amp; sFromGroup !=&quot;&quot;)
		  { 
		     with(bcGroupWavMTX)
		     {
		      ClearToQuery;
		      SetViewMode(AllView);
		      ActivateField(&quot;From Group&quot;);
		      ActivateField(&quot;To Group&quot;);
		      ActivateField(&quot;Trans Type&quot;);
		      SetSearchSpec(&quot;From Group&quot;, &quot;&apos;&quot; + sFromGroup + &quot;&apos;&quot;); 
		      SetSearchSpec(&quot;To Group&quot;, &quot;&apos;&quot; + sToGroup + &quot;&apos;&quot;);
		      SetSearchSpec(&quot;Trans Type&quot;, &quot;= &apos;&quot; + sTransType + &quot;&apos; OR [Trans Type] = &apos;&apos;&quot;);
		      ExecuteQuery(ForwardOnly);
		      if (FirstRecord())
		      {   
		         mWaiveOffETC =&quot;Y&quot;;
		      } 
		     }   
		  }		  
		  if (mWaiveOffETC ==&quot;Y&quot;)
		  { 
		   sEUFCharge = &quot;0&quot;;
		  }   
       return(sEUFCharge) 	    
} //End Try
catch(e)
   {
	  if (defined(e.errText))
	  {
	   var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
	  }
	  else
	  {
	   var strError = e.toString(); 
	  }
	  throw (strError);   
   }
   finally
   {    
      bcGroupMTX = null;
      bcGroupWavMTX = null;
      boGroupMTX = null;
      boGroupWavMTX = null;
   }
}"
