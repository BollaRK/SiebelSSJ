			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAddAccessoryItem_old"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAddAccessoryItem_old()
{
	try
	{
		var bcItemPick, bcItemPick1, bcAccessoryPick, sSiebProdType, ItemName, sRowId, bcAccessoryPick1;
		var sOfferBO = this.BusObject();
		var sOfferBC = sOfferBO.GetBusComp(&quot;VF Upgrade Offer&quot;).GetMVGBusComp(&quot;Accessory Name&quot;); // this.GetPicklistBusComp(&quot;Accessory Name&quot;); //
		var sNewPlan = this.GetFieldValue(&quot;VF CVM Upgrade New Plan Name&quot;);
		var sCurrentPlan = this.GetFieldValue(&quot;Current Plan Name&quot;);
		var sOfferType = this.GetFieldValue(&quot;Resign Upgrade Choice with Picklist&quot;);
		var LovMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VFAU_UPGR_ACCESSORY&quot;,&quot;MBB&quot;);
		var LovVoice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VFAU_UPGR_ACCESSORY&quot;,&quot;Voice&quot;);
		var oProdBO = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var oProdBC = oProdBO.GetBusComp(&quot;Internal Product&quot;);
		var sSearchSt = &quot;[Name] = &apos;&quot; + sNewPlan + &quot;&apos;&quot;;
		var sSearch = &quot;[Name] = &apos;&quot; + sCurrentPlan + &quot;&apos;&quot;;
		
		if (sOfferType == &quot;Upgrade to New Plan&quot; &amp;&amp; sNewPlan == &quot;&quot;)
			TheApplication().RaiseErrorText(&quot;Please select Plan first before adding accessory&quot;);
		
		if (sOfferType == &quot;Upgrade to New Plan&quot;)
		{
			with (oProdBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchExpr(sSearchSt);
				ExecuteQuery();
				if (FirstRecord())
					sSiebProdType = GetFieldValue(&quot;Siebel Product Type&quot;);
			}		
			if (sSiebProdType == &quot;MBB&quot; || sSiebProdType == &quot;Voice&quot;)
			{
				sOfferBC.NewRecord(NewAfter);
				sRowId = sOfferBC.GetFieldValue(&quot;Id&quot;);
				if (sSiebProdType == &quot;MBB&quot;)
				{
					bcItemPick = sOfferBC.GetPicklistBusComp(&quot;Item Name&quot;);
					with (bcItemPick)
					{	
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Value&quot;);
						SetSearchSpec(&quot;Value&quot;, LovMBB);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							Pick();
						}
					}
				}	
				else if (sSiebProdType == &quot;Voice&quot;)
				{
					bcItemPick = sOfferBC.GetPicklistBusComp(&quot;Item Name&quot;);
					with (bcItemPick)
					{	
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Value&quot;);
						SetSearchSpec(&quot;Value&quot;, LovVoice);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							Pick();
						}
					}
	   			}
	   			ItemName = sOfferBC.GetFieldValue(&quot;Item Name&quot;);
	   			sOfferBC.SetFieldValue(&quot;Type&quot;, &quot;Accessory&quot;);
	   			sOfferBC.WriteRecord();
		  		//this.RefreshRecord();
	   			bcAccessoryPick = this.GetPicklistBusComp(&quot;Accessory Name&quot;);
	   			with (bcAccessoryPick)
		 		{	
		 			ClearToQuery();
	   				SetViewMode(AllView);
	   				ActivateField(&quot;Item Name&quot;);
	   				SetSearchSpec(&quot;Item Name&quot;, ItemName);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
						{
							Pick();
						}	
		  		} //with
		 	}	//if
			else
	   		{
	   			TheApplication().RaiseErrorText(&quot;Please add SIM manually&quot;);
	   		}
		} //if			 
	 	else if(sOfferType != &quot;Upgrade to New Plan&quot;)
	 	{
	 		with (oProdBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchExpr(sSearch);
				ExecuteQuery();
				if (FirstRecord())
					sSiebProdType = GetFieldValue(&quot;Siebel Product Type&quot;);
			}		
	 		if (sSiebProdType == &quot;MBB&quot; || sSiebProdType == &quot;Voice&quot;)
			{
	    		sOfferBC.NewRecord(NewAfter);
	    		sRowId = sOfferBC.GetFieldValue(&quot;Id&quot;);
	    		if (sSiebProdType == &quot;MBB&quot;)
	    		{
	    			bcItemPick1 = sOfferBC.GetPicklistBusComp(&quot;Item Name&quot;);
					with (bcItemPick1)
					{	
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Value&quot;);
						SetSearchSpec(&quot;Value&quot;, LovMBB);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							Pick();
						}
					}
				}
				else if (sSiebProdType == &quot;Voice&quot;)
				{
					bcItemPick1 = sOfferBC.GetPicklistBusComp(&quot;Item Name&quot;);
					with (bcItemPick1)
					{	
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Value&quot;);
						SetSearchSpec(&quot;Value&quot;, LovVoice);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
							Pick();
						}
					}
	    		}
	    		ItemName = sOfferBC.GetFieldValue(&quot;Item Name&quot;);
	    		sOfferBC.SetFieldValue(&quot;Type&quot;, &quot;Accessory&quot;);
	    		sOfferBC.WriteRecord();
	    		bcAccessoryPick1 = this.GetPicklistBusComp(&quot;Accessory Name&quot;);
	    		with (bcAccessoryPick1)
		 		{	
	   				SetViewMode(AllView);
	   				ClearToQuery();
					ActivateField(&quot;Item Name&quot;);
					SetSearchSpec(&quot;Item Name&quot;, ItemName);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
		   				Pick();
		 			}
		 		}
		 		
		   	}//if
	    	else
	    	{
	    		TheApplication().RaiseErrorText(&quot;Please add SIM manually&quot;);
	    	}		
	 	} //else if	
	 } //try	
	 catch(e)
	 {
	 	throw(e);
	 }
	 finally
	 {
	 	bcItemPick = null;
		bcItemPick1 = null;
		sOfferBC = null;
	 	oProdBC = null;
		sOfferBO = null;
		oProdBO = null;
		bcAccessoryPick = null;
		bcAccessoryPick1 = null;		
	 }	
}"
