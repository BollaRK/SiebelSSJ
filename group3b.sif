			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateIMEI"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mValidateIMEI
 * Component Information :  This code is effective a replica of the
 *							current code on the smartscript open
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 25/05/2011	EW						Added code for Release 11.C.
 */
function mValidateIMEI(sIMEI,sSplProdType)
{
	var bsIMEIService;
	var psInputs, psOutputs;
	
	var sIMEIValid, sError;
	
	try
	{
		bsIMEIService = TheApplication().GetService(&quot;VF IMEI Toolkit Service&quot;);
 		psInputs = TheApplication().NewPropertySet();
 		psOutputs = TheApplication().NewPropertySet();

 		if (sIMEI != null &amp;&amp; sIMEI != &quot;&quot;)
 		{
 			psInputs.SetProperty(&quot;IMEI&quot;, sIMEI);
			psInputs.SetProperty(&quot;SplProductType&quot;,sSplProdType);
 			
 			bsIMEIService.InvokeMethod(&quot;ValidateIMEI&quot;, psInputs, psOutputs);
 			sIMEIValid = psOutputs.GetProperty(&quot;Status&quot;);
 			
 			if (sIMEIValid != &quot;Valid&quot;)
 			{
				return (psOutputs.GetProperty(&quot;ErrorMsg&quot;));
			}
			
			psInputs.Reset();
			psOutputs.Reset();
			
			psInputs.SetProperty(&quot;IMEI&quot;, sIMEI);
			bsIMEIService.InvokeMethod(&quot;QueryIMEIList&quot;, psInputs, psOutputs);

			sError = psOutputs.GetProperty(&quot;Error&quot;);

			if(sError == &quot;Y&quot;)
			{
				return (psOutputs.GetProperty(&quot;ErrorMsg&quot;));
			}
		}
		return (&quot;&quot;);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psOutputs = null;
		psInputs = null;
		bsIMEIService = null;
	}
}"
			   SEQUENCE="42"
			   UPDATED="03/28/2022 17:01:25"
