			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetDateFromString"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           :  GetDateFromString
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 30/06/2014	ROSELINE	Added code for converting string to date for TBUI Upgrade Postpaid Flow*/

function GetDateFromString(sDate)	
{	
	/*	var sYear = sDate.substring(6,10); 
		var sMonth = sDate.substring(3,5);
		var sDay = sDate.substring(0,2);
		var sHour = sDate.substring(11,13);
		// If the hour is invalid, set it to 23
		if ( isNaN(sHour) || (sHour &gt; 23) )
		{
			sHour = &quot;23&quot;;
		}
		
		var sMinute = sDate.substring(14,16);
		// If the minute is invalid, set it to 59
		if ( isNaN(sMinute) || (sMinute &gt; 59) )
		{
			sMinute = &quot;59&quot;;
		}
		var sSecond = sDate.substring(17,19);
		// If the second is invalid, set it to 59
		if ( isNaN(sSecond) || (sSecond &gt; 59) )
		{
			sSecond = &quot;59&quot;;
		}
		
		var oDate = new Date(sYear,sMonth,sDay,sHour,sMinute,sSecond);
		var SiebelDate = sMonth + &quot;/&quot; + sDay + &quot;/&quot; + sYear + &quot; &quot; + sHour + &quot;:&quot; + sMinute + &quot;:&quot; + sSecond;
		return(SiebelDate);
		*/
		var sYear,sMonth,sDay;
		var DateArray = sDate.split(&quot;/&quot;);
   		for (var i = 0; i &lt; DateArray.length; i++)
   		{
		    // NEEL - sDate should be in format DD/MM/YYYY
	    	sYear = DateArray[2];
	    	sMonth = DateArray[1]; //Kalidas:19/08/2014:reverted the changes//Kalidas:18/08/2014:code changed from sMonth = DateArray[1]; // VF:Roseline 28/07/2014 - Reverted the changes
	    	sDay = DateArray[0]; //Kalidas:19/08/2014:reverted the changes//Kalidas:18/08/2014:code changed from sDay = DateArray[0];
     	}
     	
     	//var oDate = new Date(sYear,sMonth,sDay);
     	
     	//var SiebelDate = sDay + &quot;/&quot; + sMonth + &quot;/&quot; + sYear; //ROSELINE 20/08/2014 - Changed to match the format
		var SiebelDate = sMonth + &quot;/&quot; + sDay + &quot;/&quot; + sYear; //NEEL 15AUG2014
		return(SiebelDate);
		
}"
