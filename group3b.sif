			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetROOfferDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetROOfferDetails(bOfferAccepted, bApps)
{
/*******************************************************************************
 * Input			: Offer BC Instance
 * Output			: Offer details in a string
 * Summary			: N/A
 *
 * History  :
 * Date			Author		Defect #	Description
 * *****************************************************************************
 * 04/04/2012	BASUA					Initial Version
 * 09/08/2012	EW						Moved code from VF Wizard Utilities
 *										and made more generic for CVM RO Phase 2
 * 04/11/2012   HR						Included&apos;Order Number&apos; to the activity text CVM RO Phase 2
 * 28/11/2012	EW						Added bOfferAccepted parameter and logic
 * 10/12/2012	EW						Fixed Production Issue
 * 19/12/2012	HR						Addeded Apps parameter and modified activity text logic
 *******************************************************************************/

	var boCurrent;
	var bcOffer, bcHaTCaTOffers;
	
	var sOfferId = &quot;&quot;;
	var strAdditionalOffers = &quot;&quot;;
	var strReturn = &quot;&quot;;
	
	var sOrderId = &quot;&quot;;
	var sOrderNumber = &quot;&quot;;
	var sShipmentAddr =&quot;&quot;;
		
	try
	{
		boCurrent = this.BusObject();
		bcOffer = this;

		sOfferId = bcOffer.GetFieldValue(&quot;Id&quot;);

		// Get Upgrade offer details
		with(bcOffer)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Device Make Temporary&quot;);
			ActivateField(&quot;Device Model Temporary&quot;);
			ActivateField(&quot;New Plan Name&quot;);
			ActivateField(&quot;New Term Name Constrained&quot;);
			ActivateField(&quot;Total Offer RCC incl&quot;);
			ActivateField(&quot;Estimated Early Upgrade Fee Incl GST&quot;);
			ActivateField(&quot;Estimated Remaining MPP Balance&quot;);
			ActivateField(&quot;RO Customer Credit Incl GST&quot;);
			ActivateField(&quot;RO Customer Credit Period&quot;);
			ActivateField(&quot;RO Customer Credit Per Month Incl GST&quot;);
			ActivateField(&quot;Smartscript HaTCaT Offer Display&quot;);
			ActivateField(&quot;Scenario&quot;);
			
			SetSearchSpec(&quot;Id&quot;, sOfferId);
			
			ExecuteQuery(ForwardOnly);

			if(FirstRecord())
			{
				if(GetFieldValue(&quot;New Plan Name&quot;) != &quot;&quot;)
				{
					sOrderId = GetFieldValue(&quot;Order Id&quot;);
					
					// If the offer has not been accepted yet, then get the HaTCaT offers
					// from the upgrade offer
					if (!bOfferAccepted)
					{
						// If in Siebel Express, get the HaTCaT offers from the current bo
						// Neel 18/05/2014 - Do the same for TBUI
						//Roseline 19/06/2014 - Changed BO name from &apos;VF TBUI&apos; to &apos;Order Entry (Sales)&apos;
						if (boCurrent.Name() == &quot;VF Wizard&quot; || this.BusObject().Name() == &quot;Order Entry (Sales)&quot; )
						{
							bcHaTCaTOffers = boCurrent.GetBusComp(&quot;VF CVM HaTCaT Upfront Offer VBC&quot;);
						}
		
						// If in Smartscript, the current bo is the Smartscript player.  Get the HaTCaT offers
						// from the picklist
						else
						{
							bcHaTCaTOffers = this.GetPicklistBusComp(&quot;Smartscript HaTCaT Offer Display&quot;);
						}				
				
						//Get HaTCaT offers
						with(bcHaTCaTOffers)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;Offer Description&quot;);
							ActivateField(&quot;End Date&quot;);
							SetSearchSpec(&quot;Upgrade Offer Id&quot;, sOfferId);
							ExecuteQuery(ForwardOnly);

							if(FirstRecord())
							{
								do
								{
									if(strAdditionalOffers == &quot;&quot;)
									{
										strAdditionalOffers = GetFieldValue(&quot;Offer Description&quot;) + &quot; - &quot; + GetFormattedFieldValue(&quot;End Date&quot;);
									}
									else
									{
										strAdditionalOffers = strAdditionalOffers + &quot;, &quot; + GetFieldValue(&quot;Offer Description&quot;) + &quot; - &quot; + GetFormattedFieldValue(&quot;End Date&quot;);
									}
								}
								while(NextRecord())
							}
						}
					}
					
					// Else if the offer was accepted, get the actual HaTCaT offers from the order instead
					else
					{
						strAdditionalOffers = mGetOrderOffers(GetFieldValue(&quot;Order Id&quot;));
					}

					//Prepare Activity description	
					
					if (bApps == &quot;D&quot;)//for dealers
					{					
					strReturn =	&quot;Upgrade Offer Type : &quot;				+ mGetUpgradeType(GetFieldValue(&quot;Scenario&quot;)) + &quot;.\n&quot; +
								&quot;Make : &quot; 							+ GetFieldValue(&quot;Device Make Temporary&quot;) + &quot;.\n&quot; +
								&quot;Model : &quot; 							+ GetFieldValue(&quot;Device Model Temporary&quot;) + &quot;.\n&quot; +
								&quot;Plan : &quot; 							+ GetFieldValue(&quot;New Plan Name&quot;) + &quot;.\n&quot; +
								&quot;Term : &quot;							+ GetFieldValue(&quot;New Term Name Constrained&quot;) + &quot;.\n&quot; +
								&quot;RCC incl GST : &quot;					+ GetFieldValue(&quot;Total Offer RCC incl&quot;) + &quot;.\n&quot; +
								&quot;Est Early Upgrade / Resign Fee : &quot;	+ GetFieldValue(&quot;Estimated Early Upgrade Fee Incl GST&quot;) + &quot;.\n&quot; +
								&quot;Est Remaining MPP Balance : &quot;		+ GetFieldValue(&quot;Estimated Remaining MPP Balance&quot;) + &quot;.\n&quot; +
								&quot;Additional Offers : &quot;				+ strAdditionalOffers + &quot;.\n&quot; +
								&quot;Store Credit Amount Per Month : &quot;	+ GetFieldValue(&quot;RO Customer Credit Per Month Incl GST&quot;) + &quot;.\n&quot; +
								&quot;Store Credit Number of Months : &quot;	+ GetFieldValue(&quot;RO Customer Credit Period&quot;) + &quot;.\n&quot; +
								&quot;Total Store Credit : &quot;				+ GetFieldValue(&quot;RO Customer Credit Incl GST&quot;) + &quot;.&quot;;
					}
					
					if (bApps == &quot;C&quot;)// for csr
					{
					strReturn =	&quot;Upgrade Offer Type : &quot;				+ mGetUpgradeType(GetFieldValue(&quot;Scenario&quot;)) + &quot;.\n&quot; +
								&quot;Make : &quot; 							+ GetFieldValue(&quot;Device Make Temporary&quot;) + &quot;.\n&quot; +
								&quot;Model : &quot; 							+ GetFieldValue(&quot;Device Model Temporary&quot;) + &quot;.\n&quot; +
								&quot;Plan : &quot; 							+ GetFieldValue(&quot;New Plan Name&quot;) + &quot;.\n&quot; +
								&quot;Term : &quot;							+ GetFieldValue(&quot;New Term Name Constrained&quot;) + &quot;.\n&quot; +
								&quot;RCC incl GST : &quot;					+ GetFieldValue(&quot;Total Offer RCC incl&quot;) + &quot;.\n&quot; +
								&quot;Est Early Upgrade / Resign Fee : &quot;	+ GetFieldValue(&quot;Estimated Early Upgrade Fee Incl GST&quot;) + &quot;.\n&quot; +
								&quot;Upgrade / Resign Fee Waived : &quot;	+ GetFieldValue(&quot;Upgrade Fee Waived&quot;) + &quot;.\n&quot; +
								&quot;Est Remaining MPP Balance : &quot;		+ GetFieldValue(&quot;Estimated Remaining MPP Balance&quot;) + &quot;.\n&quot; +
								&quot;Additional Offers : &quot;				+ strAdditionalOffers + &quot;.\n&quot; +
								&quot;Additional Credit Amount Per Month inc GST : &quot;	+ GetFieldValue(&quot;RO Customer Credit Per Month Incl GST&quot;) + &quot;.\n&quot; +
								&quot;Additional Credit - No of Months : &quot;	+ GetFieldValue(&quot;RO Customer Credit Period&quot;) + &quot;.\n&quot; +
								&quot;Total Additional Credit inc GST : &quot; + GetFieldValue(&quot;RO Customer Credit Incl GST&quot;) + &quot;.&quot;;				
					}		
					
					if (sOrderId != &quot;&quot;)
					{
						// VF HR 06/11/2012 - VF HR 19/12/2012 Updated for CVM Ph3 Release 13.0
						sOrderNumber = mGetOrderNumber(sOrderId);
						strReturn =	strReturn + &quot;\n&quot; + &quot;Order Number : &quot; + sOrderNumber + &quot;.&quot;;
						
						if (bApps == &quot;C&quot;)
						{
							sShipmentAddr = mGetShipmentAddress(sOrderId);
							strReturn =	strReturn + &quot;\n&quot; + &quot;Delivery Address : &quot; + sShipmentAddr + &quot;.&quot;;
						}
					}							
				}
			}
		}

		return strReturn;
	}
	catch(e)
	{
		//var sError = e.toString(); //VF:ROSELINE 10/09/2014 - Removed
		throw(e);
	}
	finally
	{
		bcHaTCaTOffers = null;
		boCurrent = null;
	}
}"
			   SEQUENCE="20"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetShipmentAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetShipmentAddress(OrderId)
{

/*
 * Method Name           :  mGetShipmentAddress
 * Component Information : 	Returns Shipment Address from order
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 19/12/2012	HR	13.0	CVM Phase 3	Initial version			
 *									
 */
 
 try
 {
	
  //  var strStreetType = &quot;Street&quot;;
	
	var boOrder;
	var bcOrder;
	var bcFSShipment;
	
	var strAddress   = &quot;N/A&quot;;

	var strCalcLine1 = &quot;&quot;;
	var strCalcLine2 = &quot;&quot;;
	
	var	strCity      = &quot;&quot;;
	var	strState     = &quot;&quot;;
	var	strPostcode  = &quot;&quot;;
	var	strCountry   = &quot;&quot;;
	
	
	if (OrderId != &quot;&quot;)
	{	
		boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);

		// Get order header	
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Id&quot;, OrderId);
		bcOrder.ExecuteQuery(ForwardOnly);
		
		if (bcOrder.FirstRecord())
		{				
			bcFSShipment = boOrder.GetBusComp( &quot;FS Shipment&quot; );

							
			// Query for Shipment Address under Order
			bcFSShipment.SetViewMode(AllView);
			bcFSShipment.ClearToQuery();
			
			bcFSShipment.ActivateField( &quot;Calculated Address Line 1&quot; );
			bcFSShipment.ActivateField( &quot;Calculated Address Line 2&quot; );
		
			bcFSShipment.ActivateField( &quot;VF Shipment City&quot; );
			bcFSShipment.ActivateField( &quot;VF Shipment State&quot; );
			bcFSShipment.ActivateField( &quot;VF Shipment Zipcode&quot; );
			bcFSShipment.ActivateField( &quot;VF Shipment Country&quot; );
			
		// Vivin please add searhspec if required.	
		//	bcFSShipment.SetSearchSpec( &quot;VF Address Street Type&quot;, strStreetType );
			bcFSShipment.ExecuteQuery( ForwardOnly );
			
					
			if (bcFSShipment.FirstRecord())
			{
			strAddress 	 = &quot;&quot;;	
			strCalcLine1 = bcFSShipment.GetFieldValue( &quot;Calculated Address Line 1&quot; );
			strCalcLine2 = bcFSShipment.GetFieldValue( &quot;Calculated Address Line 2&quot; );

			strCity      = bcFSShipment.GetFieldValue( &quot;VF Shipment City&quot; );
			strState     = bcFSShipment.GetFieldValue( &quot;VF Shipment State&quot; );
			strPostcode  = bcFSShipment.GetFieldValue( &quot;VF Shipment Zipcode&quot; );
			strCountry   = bcFSShipment.GetFieldValue( &quot;VF Shipment Country&quot; );
			
			// Format address
			
			if ( strCalcLine1 != &quot;&quot; )
				strAddress = strAddress + strCalcLine1 + &quot;, &quot;;
			
			if ( strCalcLine2 != &quot;&quot; )
				strAddress = strAddress + strCalcLine2 + &quot;, &quot;;
					
			if ( strCity != &quot;&quot; )
				strAddress = strAddress + strCity + &quot;, &quot;;

			if ( strState != &quot;&quot; )
				strAddress = strAddress + strState + &quot;, &quot;;

			if ( strPostcode != &quot;&quot; )
				strAddress = strAddress + strPostcode + &quot;, &quot;;

			if ( strCountry != &quot;&quot; )
				strAddress = strAddress + strCountry;
				
			}
		}
	}
		
	return(strAddress);
	
 }
 catch( e )
 {
 	if(!defined(e.errText))
	{
		var strError = &quot;mGetShipmentAddress: &quot; + e.toString();
	}
	else
	{
		var strError = &quot;mGetShipmentAddress: &quot; + e.errText;
	}
	
  	throw( strError );
 }
 finally
 {
  	bcFSShipment = null;	
	bcOrder = null;
	boOrder = null;	
 }

}"
			   SEQUENCE="21"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSiebProdType"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSiebProdType(sCurPlanSiebProdType,sNewPlanSiebProdType)
{
try {
   //Chitra MPP Waiver CIR Starts 
      
   var LOVBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);
   var LOVBC = LOVBO.GetBusComp(&quot;List Of Values&quot;);
   var sResult = &quot;N&quot;;
   var searchst = &quot;[Type] = &apos;VF_MPP_NOWAIVE_PROD_TYPES&apos; AND ([Value] = &apos;&quot; + sCurPlanSiebProdType + &quot;&apos; OR [Value] = &apos;&quot; + sNewPlanSiebProdType + &quot;&apos;) AND [Active] = &apos;Y&apos;&quot;;
   LOVBC.ClearToQuery();
   LOVBC.ActivateField(&quot;Type&quot;);
   LOVBC.ActivateField(&quot;Value&quot;);
   LOVBC.ActivateField(&quot;Active&quot;);
   LOVBC.SetSearchExpr(searchst);
   LOVBC.ExecuteQuery(ForwardOnly);
   if (LOVBC.FirstRecord())
				{
					sResult = &quot;Y&quot;;
					
				}
	return(sResult);

	}
	catch (e)
	{
	throw e;
	}
	finally 
	{
	/*Below variables are nullified by Sharukh on 02/04/2019*/
	/*LOVBC = null;
	LOVBO = null;*/

	/*Below variables are nullified by BALAGURU on 03/10/2019*/
    if(defined(LOVBC)) { LOVBC = null; }
	if(defined(LOVBO)) { LOVBO = null; }


}
	 
}"
			   SEQUENCE="22"
			   UPDATED="10/05/2019 02:32:14"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
