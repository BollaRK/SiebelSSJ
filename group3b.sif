			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetOrderOffers"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mGetOrderOffers
 * Method Name           : 	
 * Component Information :  This code gets the added HaTCaT offers from the order
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 28/11/2012	EW						Added code for Release 12.6
 */
function mGetOrderOffers(sOrderId)
{
	var boOrder;
	var bcOfferHistory;
	
	var strAdditionalOffers = &quot;&quot;;
	
	try
	{
		boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		bcOfferHistory = boOrder.GetBusComp(&quot;VF Offer History&quot;);
		
		with (bcOfferHistory)
		{
			ClearToQuery();
			ActivateField(&quot;Order Id Added&quot;);
			ActivateField(&quot;Add Offer Flag&quot;);			
			ActivateField(&quot;Offer Description&quot;);
			ActivateField(&quot;Offer End Date&quot;);
			
			// Search for all offers created from the order that were accepted
			SetSearchSpec(&quot;Order Id Added&quot;, sOrderId);
			SetSearchSpec(&quot;Add Offer Flag&quot;, &quot;Y&quot;);
			ExecuteQuery(ForwardOnly);
			
			if (FirstRecord())
			{
				do
				{
					if(strAdditionalOffers == &quot;&quot;)
					{
						strAdditionalOffers = GetFieldValue(&quot;Offer Description&quot;) + &quot; - &quot; + GetFormattedFieldValue(&quot;Offer End Date&quot;);
					}
					else
					{
						strAdditionalOffers = strAdditionalOffers + &quot;, &quot; + GetFieldValue(&quot;Offer Description&quot;) + &quot; - &quot; + GetFormattedFieldValue(&quot;Offer End Date&quot;);
					}				
				} while (NextRecord());
			}
		}
		return (strAdditionalOffers);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcOfferHistory = null;
		boOrder = null;
	}
}"
			   SEQUENCE="16"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPlanInvestmentCategory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetPlanInvestmentCategory
 * Component Information :  This code gets the plan investment category
 *							for the plan
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 15/02/2013	EW						Added code for Release 13.0
 */
function mGetPlanInvestmentCategory(sPlanName, sPlanCode)
{
	var bsUpgradeUtils;
	var psInputs, psOutputs;
	
	try
	{
		if (sPlanName == &quot;&quot; &amp; sPlanCode == &quot;&quot;)
		{
			return (&quot;&quot;);
		}
		bsUpgradeUtils = TheApplication().GetService(&quot;VF Upgrade Utilities&quot;);
		psInputs = TheApplication().NewPropertySet();
		psOutputs = TheApplication().NewPropertySet();
		
		psInputs.SetProperty(&quot;PlanName&quot;, sPlanName);
		psInputs.SetProperty(&quot;PlanCode&quot;, sPlanCode);
			
		bsUpgradeUtils.InvokeMethod(&quot;GetPlanInvestmentCategory&quot;, psInputs, psOutputs);
		
		var sPlanInvestCtg = psOutputs.GetProperty(&quot;PlanInvestCtg&quot;); 
			
		return (psOutputs.GetProperty(&quot;PlanInvestCtg&quot;));
		
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psOutputs = null;
		psInputs = null;
		bsUpgradeUtils = null;
	}
}"
			   SEQUENCE="17"
			   UPDATED="09/30/2019 12:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="02/08/2018 02:37:12"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPropositionFromPlan"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPropositionFromPlan(sPlanName)
{
/*
 * Component Name        : 	VF Upgrade Offer
 * Method Name           : 	mGetPropositionFromPlan
 * Component Information : 	Finds the parent proposition for a primary plan.
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 05/05/2016	Roseline	R16.2 CIRs	Initial Version - SIT defect #55                      
 */
 try
 {
   
   var oCompExpImpBO = TheApplication().GetBusObject(&quot;Complex Object Export Import&quot;);
   var oPrimProdStructBC = oCompExpImpBO.GetBusComp(&quot;VF Primary Products&quot;);
   var iCount = 0;
   var sRootProdId;
   var sChildProdId;
   var matchRec = false;
   var sPlanId ;
   var sRootProdName;
   			
   sPlanId = GetProductIdFromName(sPlanName);  	
   with(oPrimProdStructBC)
   {
   		SetViewMode(OrganizationView);
        ClearToQuery();       	
      	ActivateField(&quot;Proposition Id&quot;);
      	ActivateField(&quot;Proposition Name&quot;);
      	ActivateField(&quot;Product Id&quot;);
      	ActivateField(&quot;Relationship Name&quot;);
      	ActivateField(&quot;Last Version&quot;);
      	ActivateField(&quot;Orig Id&quot;);
      	SetSearchSpec(&quot;Product Id&quot;, sPlanId);
      	SetSearchSpec(&quot;Last Version&quot;, &quot;0&quot;);
      	SetSearchSpec(&quot;Primary Product&quot;, &quot;Y&quot;);
      	ExecuteQuery(ForwardOnly);
      	var matchRec = FirstRecord();
      	while (matchRec)
      	{
      	     iCount++;
      	     sRootProdId = GetFieldValue(&quot;Proposition Id&quot;);
      	     sRootProdName = GetFieldValue(&quot;Proposition Name&quot;);
      	     matchRec = NextRecord(); 
      	}
	}
 
 	 return(sRootProdName);
 
 }
 catch(e)
 {

		throw (e);	
 }
 finally
 {
 		oPrimProdStructBC = null;
	 	oCompExpImpBO = null;
 }
}"
