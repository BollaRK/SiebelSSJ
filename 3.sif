			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateACN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateACN(acn)
{
	//RR 17/12/2014 SPS: Added for SPS ABN/ACN Integration
	
	var i;

	var l_weight = new Array( 8, 7, 6, 5, 4, 3, 2, 1);
	var l_sum = 0;
	var l_remainder = 0;
	var sCalCheckDigit = 0;
	var i;

	// Ensure ACN is 9 digits long
	if (acn == &quot;&quot; || acn == null || acn.length != 9)
	{
		return false;
	}

	try
	{
		// Sum the multiplication of all the digits and weights
		for (i = 0; i &lt; l_weight.length; i++)
		{
			var x = ToNumber(acn.substring(i,i+1));
			var y = l_weight[i];	
			l_sum += ToNumber(acn.substring(i,i+1)) * ToNumber(l_weight[i]);
		}

		// Divide it by 10 get ther remainder if any
		var divBy10 = Clib.div(l_sum, 10);

		// Divide by 10 to obtain remainder
		l_remainder = divBy10.rem;

		// Complement the remainder to 10
		sCalCheckDigit = (10 - l_remainder == 10) ? 0 : (10 - l_remainder);

		// Compare the calculated check digit with the actual check digit	
		var z = ToNumber(acn.substring(acn.length,acn.length-1));
		if (sCalCheckDigit == z)
		{
			return true;
		}
		else
		{
			return false;
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		//Do Nothing
	}
}"
