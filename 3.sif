			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckContactId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckContactId(sAccountId)
{
		
	try{	
		
		var sBO = TheApplication().GetBusObject(&quot;Account&quot;);
		var sAccntBC = sBO.GetBusComp(&quot;Account&quot;);
		var sContactBC = sBO.GetBusComp(&quot;Contact&quot;);
		var sContIdbc = sBO.GetBusComp(&quot;VF Contact Id&quot;);
		var sDVSSuccessfulTime = new Array();
		var sContactRowId= &quot;&quot;;
		var i = 0;

		if(sAccountId != &quot;&quot; &amp;&amp; sAccountId != null)
		{
			sContIdbc.ActivateField(&quot;State of Issue&quot;);
			sContIdbc.ActivateField(&quot;VHA Updated Cont Id Ref Calc&quot;);
			sContIdbc.ActivateField(&quot;VHA Postpay ID Type Calc&quot;);
			sContIdbc.ActivateField(&quot;VHA ID Expired Calc&quot;);
			sContIdbc.ActivateField(&quot;DVS Successful Time&quot;);
			sAccntBC.ClearToQuery();
			sContactBC.ClearToQuery();
			sContIdbc.ClearToQuery();
			sAccntBC.SetViewMode(AllView);
			sContactBC.SetViewMode(AllView);
			sContIdbc.SetViewMode(AllView);
			sAccntBC.SetSearchSpec(&quot;Id&quot;,sAccountId);
			sAccntBC.ExecuteQuery(ForwardOnly);
			sContIdbc.ExecuteQuery(ForwardBackward);
			if(sAccntBC.FirstRecord())
			{
			if(sContactBC.FirstRecord())
			{
				sContactRowId = sContactBC.GetFieldValue(&quot;Id&quot;);
				if(sContIdbc.FirstRecord())
				{
					with(sContIdbc)
					{
						var irec = FirstRecord();
						//sContIdCount = CountRecords();
						while(irec)
						{							
							sDVSSuccessfulTime[i] =  GetFieldValue(&quot;DVS Successful Time&quot;);
							if(sDVSSuccessfulTime[i] != null &amp;&amp; sDVSSuccessfulTime[i] != &quot;&quot;)
							{
								throw(&quot;You cannot modify the address. If you wish to modify the address, please delete the captured identification details in the next page and try again&quot;);
							}
							i++;
							irec = NextRecord();								
						}
						
					}
					
				}
			}
			}
			
		}
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sBO = null;
		sAccntBC = null;
		sContactBC = null;
		sContIdbc = null;
	}
}"
