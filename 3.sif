	if (FieldName == &quot;VF Customer Type&quot;)//[Nagesh][To exclude Sole Trader from Validation][Drop3]
	{
		var sCustType = this.GetFieldValue(&quot;VF Customer Type&quot;);
		TheApplication().SetProfileAttr(&quot;VFCustType&quot;,sCustType);
	}
	if (FieldName == &quot;VF Customer Segment&quot;)
	{
		var sCustSegment = this.GetFieldValue(&quot;VF Customer Segment&quot;);
		TheApplication().SetProfileAttr(&quot;VFCustSegment&quot;,sCustSegment);
	}//[Nagesh][To exclude Sole Trader from Validation][Drop3]
	
	if (FieldName == &quot;ABN/ACN&quot;)
	{
	/*	var sABNACN = this.GetFieldValue(&quot;ABN/ACN&quot;);
		var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var Input = TheApplication().NewPropertySet();
		var Output = TheApplication().NewPropertySet();
		Input.SetProperty(&quot;ProcessName&quot;, &quot;VF ABR Enquiry Test&quot;);
		Input.SetProperty(&quot;ABN_ACN_Num&quot;, sABNACN);
		svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
		var abnstatus = Output.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;ABN_Status&quot;);
		var ABN_Number = Output.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;ABN_Number&quot;);
		var Entity_Type = Output.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Entity_Type&quot;);
		var Entity_Description = Output.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Entity_Description&quot;);
		var Company_Name = Output.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Company_Name&quot;);
		this.SetFieldValue(&quot;Company Name&quot;, Company_Name);*/
		TheApplication().SetProfileAttr(&quot;VFABNACN&quot;, this.GetFieldValue(&quot;ABN/ACN&quot;));

	}
	
	if (FieldName == &quot;VF ABN Entity Type&quot;)
	{
		var sCustType = this.GetFieldValue(&quot;VF Customer Type&quot;);
	//	if(sCustType == &quot;&quot; || sCustType == null)
	//	{
			var sEntityType = this.GetFieldValue(&quot;VF ABN Entity Type&quot;);
			var sLOVCustType= TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ENTITY_TYPE&quot;, sEntityType);
			if(sLOVCustType == &quot;Sole Trader&quot; || sLOVCustType == &quot;Local Registered Company&quot; || sLOVCustType == &quot;Government&quot;)
			{
				this.SetFieldValue(&quot;VF Customer Type&quot;, sLOVCustType);
			}
			
	//	}
	}
	if(FieldName == &quot;Customer Bill Segment&quot; &amp;&amp; !gNewRec)//VHA Muthushankari 9/9/2017 - Added for R17.4B Freedom CIR
	{
		var sViewName = TheApplication().GetProfileAttr(&quot;ViewName&quot;);
		if(sViewName == &quot;FirstView&quot;)
		{
			var sCustBillSeg = this.GetFieldValue(&quot;Customer Bill Segment&quot;);
			var sRespExists = this.GetFieldValue(&quot;Calc VF Billing Ops Responsibility&quot;);
			var svc = TheApplication().GetService(&quot;VF TBUI Utilities&quot;);
			var input = TheApplication().NewPropertySet();
			var output = TheApplication().NewPropertySet();
			input.SetProperty(&quot;Bill Segment&quot;, sCustBillSeg);
			input.SetProperty(&quot;Resp Exists&quot;,sRespExists);
			svc.InvokeMethod(&quot;SetDOM&quot;,input,output);
			this.SetFieldValue(&quot;IsDOMReadOnly&quot;, &quot;N&quot;); 
			this.SetFieldValue(&quot;DOM&quot;,output.GetProperty(&quot;DOM&quot;));
			this.SetFieldValue(&quot;VF DOM Value&quot;,output.GetProperty(&quot;DOM&quot;)); // VHA:Aruns 16/04/2018: Created for SIM2 GO​18.2 CIR
		   	this.SetFieldValue(&quot;IsDOMReadOnly&quot;, &quot;Y&quot;);
		   
		}
	  }
	    //Ravindra: 23/Sep/2024: Added the below code Customer Segment Validations
	/*	if (FieldName == &quot;VF Customer Segment&quot;)
		{		
			var sPostExst = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);		
			if(sPostExst == &quot;Y&quot;)
            {	
				TheApplication().SetProfileAttr(&quot;sNewCustSeg&quot;,&quot;&quot;);		
				var sNewCustSeg = this.GetFieldValue(&quot;VF Customer Segment&quot;);			
				if(sNewCustSeg !=&quot;&quot; &amp;&amp; sNewCustSeg !=null)
				{
					TheApplication().SetProfileAttr(&quot;sNewCustSeg&quot;, sNewCustSeg);					
				}
			}
		}
		//Ravindra: 23/Sep/2024: Added the below code Customer Type Validations
		if (FieldName == &quot;VF Customer Type&quot;)
		{	
			var sPostExst = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);
			if(sPostExst == &quot;Y&quot;)
			{
				TheApplication().SetProfileAttr(&quot;sNewCustTyp&quot;, &quot;&quot;);
				var sNewCustTyp = this.GetFieldValue(&quot;VF Customer Type&quot;);				
				if(sNewCustTyp !=&quot;&quot; &amp;&amp; sNewCustTyp !=null)
				{
					TheApplication().SetProfileAttr(&quot;sNewCustTyp&quot;, sNewCustTyp);
				}
			}		
		}
			//Ravindra: 23/Sep/2024: Added the below code new ABNACN Validations
		if (FieldName == &quot;ABN/ACN&quot;)
		{
			var sPostExst = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);
			if(sPostExst == &quot;Y&quot;)
			{	
				TheApplication().SetProfileAttr(&quot;sNewABNACN&quot;,&quot;&quot;);
				var sNewABNACN = this.GetFieldValue(&quot;ABN/ACN&quot;);				
				if(sNewABNACN !=&quot;&quot; &amp;&amp; sNewABNACN !=null)
				{
					TheApplication().SetProfileAttr(&quot;sNewABNACN&quot;, sNewABNACN);
				}
			}		
		}*/
	}
	catch (e)
	{
	throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 05/04/2019*/

		if(defined(svc)) { svc = null; }
		if(defined(input)) { input = null; }
		if(defined(output)) { output = null; }
		
	}
}"
