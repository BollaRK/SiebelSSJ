			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
/*
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_PreInvokeMethod
 * Component Information :	Allows the user to invoke the mSyncAccount() method to 
 *							create a new Billing or Synchronise account   
 *							externals systems . 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 20/01/2005	TAlihos						Initial Version
 */

	try
	{	
		//************************************
		//* Declare Variables
		//************************************
		
		var sIntReturn = CancelOperation;
		var strCONSTBAPREPAY  = &apos;Prepay&apos;;
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_PreInvokeMethod&quot;);
		}
		
		//************************************
		//check to see if metho being 
		//invoked is mSyncAccount if
		//so then call function
		//************************************
		if (MethodName == &quot;mSyncBillingAccount&quot;)
		{
			mSyncBillingAccount();
		}
		if (MethodName == &quot;IsActive&quot;)
		{
			return(ContinueOperation);	
		}
		return(sIntReturn);	
		
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	
     	//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_PreInvokeMethod.strErrorMessage= &quot; + strErrorMessage);
		}
     	var strDisplayError = ErrorHandling(strErrorMessage, &quot;BusComp_PreInvokeMethod&quot;);
     	TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_PreInvokeMethod&quot;);
		}
	}
}"
			   SEQUENCE="8"
			   UPDATED="06/07/2014 00:17:07"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreNewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreNewRecord ()
{
/*************************************************************************************
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_PreNewRecord
 * Component Information :	DF6081 requires validation for new BA
 * 							having an address associated with the parent CA.
 *							It is assumed that there will be a primary address
 *							against the CA.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 19/02/2008	VL			DF6081		Initial version created to resolve defect
 * 21/02/2008	VL			DF7410		Needs to exclude billing account created by WF
/************************************************************************************/
	try
	{
		
		
		//*******************************
		/* Declare Objects
		//*******************************/
		var bcParent;
	
		//*******************************
		/* Declare variables
		//*******************************/
		var strPrimaryAddrId = null;
		var strPARENTNAME = &quot;Account&quot;;
		var strNoValidate = &quot;&quot;;
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
		
		//The profile attribute is set to TRUE by VF OM New Account Creation called by WF
		strNoValidate = TheApplication().GetProfileAttr(&quot;VFBulkBAAddrNoValidation&quot;);
		
		// Lets setup parent BC and check to see if it&apos;s in the correct context.
		bcParent = this.ParentBusComp();
	
		if (bcParent.Name() == strPARENTNAME)
		{
			if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			{
				TheApplication().Trace(&quot;VF Billing Account.BusComp_PreNewRecord: No Validation attribute is &quot; + strNoValidate);
			}
			if (strNoValidate != &quot;TRUE&quot;)
			{
				// If we are in the correct context we can set up our vairables
				strPrimaryAddrId = bcParent.GetFieldValue(&quot;Primary Address Id&quot;);
				if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
				{
					TheApplication().Trace(&quot;VF Billing Account.BusComp_PreNewRecord: Primary Address Id is &quot; + strPrimaryAddrId);
				}
				// Validate if parent has a primary address
				if (strPrimaryAddrId == &quot;&quot; 
					|| strPrimaryAddrId == null 
					|| strPrimaryAddrId.toUpperCase() == &quot;NO MATCH ROW ID&quot;)
				{
					TheApplication().RaiseErrorText(&quot;Address is missing in Customer Account.&quot;);
					throw &quot;Address is missing in Customer Account&quot;;
				}
			}
		}
	}
	catch (e)
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
	
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	TheApplication().RaiseErrorText(strErrorMessage);
	}
	finally
	{
	
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_PreNewRecord&quot;);
		}
	
		//*************************************
		//* Destroy Objects
		//*************************************
		bcParent = null;
		strNoValidate = null;
		strPrimaryAddrId = null;
		strPARENTNAME = null;
	}
}"
			   SEQUENCE="9"
			   UPDATED="06/07/2014 00:17:07"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
/*
 * Component Name        : 	VF Billing Account
 * Method Name           : 	BusComp_PreSetFieldValue
 * Component Information : 	Invoke PIN validation BS
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 19/01/2005	SdK						Added PIN validation
 * 29/02/2012	Madhava Prakash			Added a validation to VF Marketing Marker to make sure 
 *										CSRs/Dealers will not update the value of to null from a non null value
 */
 
   	try
   	{		 
		var sErrorMessage;
		var sPINFlag = &quot;N&quot;;
		//Trace stmt
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.PreSetFieldValue.FieldName=&quot; + FieldName + &quot;/&quot; + FieldValue);
		}

		switch(FieldName)
		{
			case &quot;Password&quot;:
				//Muthushankari 27/3/2017 Added for R17.2 Service PIN Validation CIR
				var svc, input, output;
				var eai_flag = TheApplication().GetProfileAttr(&quot;EAI_FLAG&quot;);
				var bulk_flag = TheApplication().GetProfileAttr(&quot;VFBulkPinNoValidation&quot;);
				var post_order_flag = TheApplication().GetProfileAttr(&quot;ASSET_POST_ORDER_FLAG&quot;);
				var post_pre_flag = TheApplication().GetProfileAttr(&quot;VHA_POST_TO_PRE_FLAG&quot;);
				//this.ActivateField(&quot;VHA Responsibility Calc&quot;);
				var resp_exists = this.GetFieldValue(&quot;VHA Responsibility Calc&quot;);
				if (eai_flag == &quot;Y&quot; || bulk_flag == &quot;TRUE&quot; || post_order_flag == &quot;Y&quot; || post_pre_flag == &quot;Y&quot;)
				{
					//Do Nothing
				}
				else if(FieldValue == &quot;&quot; || FieldValue == null)
				{
					svc = TheApplication().GetService(&quot;VF Network Settings BS&quot;);
					input = TheApplication().NewPropertySet();
					input.SetProperty(&quot;Type&quot;, &quot;VHA_PIN_VALIDATION&quot;);
					input.SetProperty(&quot;LIC&quot;, &quot;Log Error&quot;);
					output = TheApplication().NewPropertySet();
					svc.InvokeMethod(&quot;QueryLOV&quot;, input, output);
					var sDesc = output.GetProperty(&quot;Desc&quot;);
					sPINFlag = &quot;Y&quot;;
					TheApplication().RaiseErrorText(sDesc);
				}
				else
				{
					if(resp_exists != &quot;Y&quot;)
					{
						svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
						input = TheApplication().NewPropertySet();
						output = TheApplication().NewPropertySet();
						input.SetProperty(&quot;ProcessName&quot;, &quot;VHA PIN Validation Process&quot;);
						input.SetProperty(&quot;PIN&quot;, FieldValue);
						sPINFlag = &quot;Y&quot;;
						svc.InvokeMethod(&quot;RunProcess&quot;, input, output);
					}
				}
				/*var svc = TheApplication().GetService(&quot;VF PIN Validation&quot;);
				var input = TheApplication().NewPropertySet();
				var output = TheApplication().NewPropertySet();
				
				// Add Servive PIN to prop set
				input.SetProperty(&quot;PIN&quot;, FieldValue);

				try
				{
					// Invoke PIN validation service
					svc.InvokeMethod(&quot;mPinValidation&quot;, input, output);
				}
				catch(e)
				{
					throw e;
				}*/
				
				break;
		
		//12.2 - VF Marketing Marker validation
		
			case &quot;VF Marketing Marker&quot;:
				//Get the current value 
				var sVFMarketingMarker = this.GetFieldValue(&quot;VF Marketing Marker&quot;);				

				//Check if the marketing permissions flag is updated to null value from a non null value
				if(sVFMarketingMarker!=&quot;&quot; &amp;&amp; FieldValue == &quot;&quot;)
				{
					throw(&quot;VFErrorCode#10293&quot;);
				}

				break;
			//VHA NandhiniG 16/8/19 : Added for MR04 - Special Character CIR
				case &quot;Name&quot;:
					if(FieldValue != &quot;&quot; &amp;&amp; FieldValue != null)
					{
						var sValSplCharBs = TheApplication().GetService (&quot;VHA Validate Special Character&quot;);
						var psInputs = TheApplication().NewPropertySet();
						var psOutputs = TheApplication().NewPropertySet();
						psInputs.SetProperty(&quot;String&quot;,FieldValue);
						sValSplCharBs.InvokeMethod(&quot;ValidateSpecialCharacter&quot;, psInputs, psOutputs);
						var sErrMsg = psOutputs.GetProperty(&quot;ErrMsg&quot;);
						if(sErrMsg != &quot;&quot; &amp;&amp; sErrMsg != null)
						{
							gValidateSC = &quot;Y&quot;;
							TheApplication().RaiseErrorText(sErrMsg);
						}
					}
				break;
				//ENDS HERE 


		}
		return (ContinueOperation);
	 }		 
     catch (e)
     {
     	if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }

   		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account. PreSetFieldValue.FieldName=&quot; + FieldName);
		}
		
     	var strDisplayError = ErrorHandling(sErrorMessage, &quot;BusComp_PreSetFieldValue&quot;);
     	if (sPINFlag == &quot;Y&quot;)
     		TheApplication().RaiseErrorText(sErrorMessage);
		else if(gValidateSC == &quot;Y&quot;) //VHA NandhiniG 16/8/19 : Added for MR04 - Special Character CIR
		{
			gValidateSC = &quot;N&quot;;
			throw(e);
		} // ENDS HERE
     	else
     		TheApplication().RaiseErrorText(strDisplayError);
     }
     finally
     {
		// destroy std vars
		sErrorMessage = null;
			
		input = null;
		output = null;
	    svc = null;		

		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account. PreSetFieldValue.FieldName=&quot; + FieldName);
		}
     }
}"
			   SEQUENCE="10"
			   UPDATED="11/06/2019 15:08:07"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
/*
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_SetFieldValue
 * Component Information :	If certain fields change in this object they need to be
 *							communicated to externals. Set UserProp for use in
 *							WriteRecord as part of Account Sync framework.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/01/2005	MSL						Initial Version
 * 25/09/2006	CY			Defect18712	Convert Name to upper case
 */
	try
	{	
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.SetFieldValue.FieldName=&quot; + FieldName);
		}
		
		// Only communicate updates to Accounts that have been created externally
		if (this.GetFieldValue(&quot;Account Status&quot;) != 
		TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;VF_BILL_ACCT_STATUS&quot;,&quot;Open&quot;))
		{
			switch (FieldName)
			{
				case &quot;Credit Limit&quot;:
				case &quot;Name&quot;:
					this.SetUserProperty(&quot;SyncAccount&quot;, &quot;Y&quot;);
					break;
	
				default:
					break;
			}
		}
		//Defect 18712 - convert name to upper case
		switch (FieldName)
		{
			case &quot;Name&quot;:
				//Indumathi - 19/12/2017 - Added validation for KOGAN
			    // var sOrgName = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ORG_NAME&quot;, TheApplication().GetProfileAttr(&quot;Me.Org.Name&quot;));
			    //SK 12.4.18 - Added for KOGAN 18.1 fallout
			    this.ActivateField(&quot;Organization&quot;);
			    var sOrgName = this.GetFieldValue(&quot;Organization&quot;);
			    var sOrgLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORG_NAME&quot;,sOrgName); 
				//if (this.GetFieldValue(&quot;Organization&quot;) == &quot;Vodafone AU&quot; || this.GetFieldValue(&quot;Organization&quot;) == sOrgName)  
				if (sOrgName == sOrgLOV)
				{
					var strName = this.GetFieldValue(&quot;Name&quot;);
					this.SetFieldValue(&quot;Name&quot;, strName.toUpperCase());
				} 
				break;
		}
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	
     	//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.SetFieldValue.strErrorMessage= &quot; + strErrorMessage);
		}
     	var strDisplayError = ErrorHandling(strErrorMessage, &quot;BusComp_SetFieldValue&quot;);
     	TheApplication().RaiseErrorText(strDisplayError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.SetFieldValue&quot;);
		}
	}
}"
			   SEQUENCE="11"
			   UPDATED="05/18/2018 14:32:45"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
/*
 * Component Name        : 	VF Billing Account
 * Method Name           : 	BusComp_WriteRecord ()
 * Component Information : 	Invoke WorkFlow process to create an activity 
 *                          when a BA PIN is updated. 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 07/12/2004	SdK			FR600.020	Created
 * 10/01/2005	MSL						Call mSyncAccount for certain fields (See SetFieldValue)
 * 24/05/2005	TAlihos					W2. Defect 2151 added logic set profile attribute if app is Partner Portal
 										to conserve restrict account searching.
 * 15/07/2005	RP						Added code to inherit customer account primary address when this
 *										is a newly created account. This is only valid for Billing Account
 *										of type &apos;Airtime&apos;
 * 18/08/2005   EH          d 5787      Changed called mSyncAccount() method to mSyncBillingAccount().  mSyncAccount() 
 *                                      does not exist.
 * 30/10/2006	RP			DF20507		Removed restriction of inheriting Customer Account primary address when account
 *										type is not Airtime
 * 27/06/07     DF          #26917      Do not sync if Self Service update   
 * 04/08/10		XA			Butterfly	Check to bypass inherit customer primary address if external system explicitly passes billing Address
 * 02/04/2019	Christy					Added for Unified Application
 */

	try
	{
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.WriteRecord&quot;);
		}
			
		// Added - 24/05/2005 TAlihos check if app is Partner Portal to restrict account searching.
		//02/04/2019: Christy :Modified for unified application
		//if(TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel eChannel for CME&quot;)
		if(TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_USER_TYPE&quot;,&quot;Retail&quot;))
		{
			TheApplication().SetProfileAttr(&quot;VFBillingAccountId&quot;, this.GetFieldValue(&quot;Id&quot;));
		}

		//if ( gNewFlag &amp;&amp; ( this.GetFieldValue( &quot;Type&quot; ) == &quot;Airtime&quot; ) )
		if ( gNewFlag ) 
		{
			// Newly created airtime Billing Account.Call the the function to inherit the 
			// Customer Account Primary address and reset the global New flag
			gNewFlag = false;
			
			//XA 04/08/10: R10.5: Added to bypass inherit if the address is explicitly passed in the Create BA interface.
			if(TheApplication().GetProfileAttr(&quot;profAttrAddressExistsInBA_SS&quot;) != &quot;Y&quot;)
			{
					mInheritCustomerAccountPrimaryAddress();
			}
		}
 
		if(gPassword != this.GetFieldValue(&quot;Password&quot;))
		{
			mCreatePinActivity();
		}
		
		/***********************************************
		* MSL - 10/01/2005 Synchronise account details  
		* if certain fields have been changed.
		* DF - 27/06/07 #26917 - Do not sync if Self Service update
		***********************************************/
		if (this.GetUserProperty(&quot;SyncAccount&quot;) == &quot;Y&quot;
		    &amp;&amp; !TheApplication().gInboundSurveyUpdateFlag)
		{
			this.SetUserProperty(&quot;SyncAccount&quot;, &quot;N&quot;);
			//mSyncAccount(); -- 18/08/2005 Line Commented out for defect 5787 because it should be invoking mSyncBillingAccount
			mSyncBillingAccount();
			
			TheApplication().gSyncSubRequired = true; //DF - 27/06/07 #26917
		}
	
	}
	catch(e)
	{
		if(!defined(e.errText))
		{
			var sErrorMessage = e.toString();
		}
		else
		{
	    	var sErrorMessage = e.errText;
	    }
     	
     	//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.WriteRecord.sErrorMessage= &quot; + sErrorMessage);
		}
     	var strDisplayError = ErrorHandling(sErrorMessage, &quot;BusComp_WriteRecord&quot;);
     	TheApplication().RaiseErrorText(strDisplayError);
	}

	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.WriteRecord&quot;);
		}
		gPassword = this.GetFieldValue(&quot;Password&quot;);
	}
}"
			   SEQUENCE="12"
			   UPDATED="05/12/2019 19:10:25"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ErrorHandling"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Billing Account
 * Function Name         : 	ErrorHandling
 * Component Information : 	Call &quot;VF Error Handling Service&quot; to handle any
 *							errors thrown during Invoice processing.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/01/2004	MSL						Initial Version
 */
function ErrorHandling(strError, strFunction)
{
	try
	{
		//*************************************
		//* Declare Objects
		//*************************************
		var bsError;
		var psErrorInput;
		var psErrorOutput;
		
		psErrorInput  = TheApplication().NewPropertySet();			
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;VF Billing Account&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;, strFunction);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, strError);
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		strError = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	catch (e)
	{
	}
	finally
	{
		//*************************************
		//* Destroy Objects
		//*************************************
		bsError		 		= null;
		psErrorInput 		= null;
		psErrorOutput 		= null;
	}
	return (strError)
}"
			   SEQUENCE="2"
			   UPDATED="06/07/2014 00:17:07"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreatePinActivity"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreatePinActivity()
{
/*
 * Component Name        : 	VF Billing Account
 * Method Name           : 	mCreatePinActivity()
 * Component Information : 	Invoke WorkFlow process to create an activity 
 *                          when a BA PIN is updated. 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 07/12/2004	SdK			FR600.020	Created
 */
 
	try
	{
     	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.mCreatePinActivity()&quot;);
		}       
		var psErrorInput, psErrorOutput, sErrorMessage, bsError; 
		
		var svc = TheApplication().GetService(&quot;VF Generate Activity Service&quot;);
		var Inputs = TheApplication().NewPropertySet();
		var Outputs = TheApplication().NewPropertySet();
		
		var sPassword = this.GetFieldValue(&quot;Password&quot;);
		
			if(sPassword == &quot;&quot;)
			{
				sPassword = &quot;&apos;No Entry&apos;&quot;;
			}
			
			if(gPassword == &quot;&quot;)
			{
				gPassword = &quot;&apos;No Entry&apos;&quot;;
			}
		
		// Set Customer Account Id that asset belongs too		
		var accountId = this.GetFieldValue(&quot;Id&quot;);
	
		// Set customised Inputs variables 
		var activityType = &quot;Billing PIN Update&quot;;		// this is an LOV field
		var activityComm = &quot;The Billing PIN has changed from &quot; + gPassword + &quot; to &quot; + sPassword;
		var activityDesc = &quot;Billing PIN Update&quot;;
		
		Inputs.SetProperty(&quot;Account Object Id&quot;, accountId);
		Inputs.SetProperty(&quot;Asset Object Id&quot;, &quot;&quot;);
		// Category is not working yet pending SR from Siebel. It places restriction on Type LOV to be the child of &apos;General&apos;
		Inputs.SetProperty(&quot;Category&quot;, &quot;System Generated&quot;);
		Inputs.SetProperty(&quot;Type&quot;, activityType);
		Inputs.SetProperty(&quot;Status&quot;, &quot;Auto-Created&quot;);
		Inputs.SetProperty(&quot;Description&quot;, activityDesc);
		Inputs.SetProperty(&quot;Comment&quot;, activityComm);
		
		//25/02/04 TPikoulis. Invoke workflow
		svc.InvokeMethod(&quot;GenerateActivity&quot;, Inputs, Outputs);
		return ContinueOperation;
	}
	catch (e)
	{
     	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.mCreatePinActivity()&quot;);
		}       
	
		if(!defined(e.errText))
		{
			gErrorMessage = &quot;mCreatePinActivity(): &quot; + e.toString();
	  	}
	  	else
	  	{
	    	gErrorMessage = &quot;mCreatePinActivity(): &quot; + e.errText;
	  	}
			
		throw(gErrorMessage);
     	
	}
	finally
	{
		 svc = null;
		 Inputs = null;
		 Outputs = null;
		 accountId = null;
		 activityType = null;
		 activityComm = null;
		 activityDesc = null;
		 bsError = null;
		 psErrorInput = null;
		 psErrorOutput = null;
		 sErrorMessage = null;

     	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.mCreatePinActivity()&quot;);
		}       
	}
}"
