			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInheritCustomerAccountPrimaryAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInheritCustomerAccountPrimaryAddress()
{
/*
 * Component Name        :	VF Billing Account
 * Method Name           :	mInheritCustomerAccountPrimaryAddress
 * Component Information :	Call the &quot;VF Address Toolkit Service&quot; and inherit the Customer 
 *							Account Primary address into this Billing Account. Only do this if 
 *							the billing account has a 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 15/07/2005	RP						Initial Version
 */
 
 try
 {

	//* Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Billing Account.mInheritCustomerAccountPrimaryAddress&quot;);
	}
	
	var psInput;
	var psOutput;
	var bsAddressTool;
	
	psInput = TheApplication().NewPropertySet();
	psOutput = TheApplication().NewPropertySet();
	bsAddressTool = TheApplication().GetService( &quot;VF Postpay Utilities TBUI&quot; );//MURALIDHARANK 21/7/2014 For TBUI
	
	psInput.SetProperty( &quot;BillingAccountId&quot;, this.GetFieldValue( &quot;Id&quot; ) );
	bsAddressTool.InvokeMethod( &quot;InheritCustomerAddressToBilling&quot;, psInput, psOutput );	
	
	
 }
 catch( e )
 {
 	
	if(!defined(e.errText))
	{
		gErrorMessage = e.toString();
 	}
  	else
  	{
    	gErrorMessage = e.errText;
  	}

 	//* Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;ERROR:VF Billing Account.mInheritCustomerAccountPrimaryAddress.Error: &quot; + gErrorMessage );
	}
 }
 finally
 {
	psInput = null;
	psOutput = null;
	bsAddressTool = null;
	
	//* Trace Statement
	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
	{
		TheApplication().Trace(&quot;START:VF Billing Account.mInheritCustomerAccountPrimaryAddress&quot;);
	}
 }
}"
			   SEQUENCE="4"
			   UPDATED="07/21/2014 17:01:57"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncBillingAccount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        :	VF Billing Account
 * Method Name           :	mSyncBillingAccount
 * Component Information :	Call the &quot;VF Account Sync Service&quot;.
 *							All errors including BS errors will be caught and logged.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/01/2005	MSL						Initial Version
 * 12/05/2005	TAlihos 				W2 Defect 1210 and 1221 changed the method being called  
 *										in VF Synch Account And Subscription business service								
 */
function mSyncBillingAccount()
{
	try
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.mSyncAccount&quot;);
		}
		
		/*******************************
		* Declare Objects
		*******************************/
		var bsSyncAccount;
		var psSyncInput;
		var psSyncOutput;

		psSyncInput		= TheApplication().NewPropertySet();			
		psSyncOutput	= TheApplication().NewPropertySet();
		bsSyncAccount	= TheApplication().GetService(&quot;VF Synch Account And Subscription&quot;);

		/*******************************
		* Invoke business service
		*******************************/		
		psSyncInput.SetProperty(&quot;BillingAccountId&quot;, this.GetFieldValue(&quot;Id&quot;));	
			
		//TAlihos 12/05/2005: Changed Param being passed in from SyncAccount
		//  TO SyncBillingAccount.
		bsSyncAccount.InvokeMethod(&quot;SyncBillingAccount&quot;, psSyncInput, psSyncOutput);
		
		if (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;).length &gt; 0)
			throw (psSyncOutput.GetProperty(&quot;BusinessServiceError&quot;));
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e); 
		}
		else
		{
			var strError = arguments.callee + ToString(e); 
		}
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.mSyncAccount.strError= &quot; + strError);
		}
     	throw (strError);
	}
	finally
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.mSyncAccount&quot;);
		}
		
		psSyncInput = null;
		psSyncOutput = null;
		bsSyncAccount = null;
	}
}"
