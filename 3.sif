			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
//VHA KT 22/01/26: Added for SSJFulfilment as per BAU
	try
	{
	if(FieldName == &quot;Required Minimum PP Amount&quot; &amp;&amp; TheApplication().ActiveViewName() == &quot;VF SSJ Prepayments View-TBUI&quot;)
	{
		this.ActivateField(&quot;Required Minimum PP Amount&quot;);
		this.ActivateField(&quot;PP Amount Paid Upfront&quot;);
		var sReqMinAmt = this.GetFieldValue(&quot;Required Minimum PP Amount&quot;);
		var sPPMin = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Prepayment Limit&quot;);
		if (ToNumber(sReqMinAmt) &gt; ToNumber(sPPMin))
		{
		TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;VHA_PREPAYMENT_13&quot;,sPPMin));
		}
	}
	}
	
	catch(e)
	{	
	throw(e);
	}
	
	finally
	{
		sReqMinAmt = null;
		sPPMin	= null;
	}
	
}"
