			this.SetFieldValue(&quot;VF Ship Unit Number&quot;, sFloor);
			this.WriteRecord();
			this.InvokeMethod(&quot;RefreshBusComp&quot;);
		}
		/*var sBusObj = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
		var sBusComp = sBusObj.GetBusComp(&quot;VF Com Financial Profile&quot;);
