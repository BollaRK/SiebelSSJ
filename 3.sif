			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
// Added to include the QAS validation check
try
{	//Subramanian 12/8/14 Added to Enable button by setting profile attribute
	var sView = TheApplication().GetProfileAttr (&quot;ViewName&quot;); // VHA NandhiniG 19/8/19 : Added for MR04 
	var sFBBNewCustFlag = TheApplication().GetProfileAttr(&quot;VFPostCodeAttr&quot;); // VHA NandhiniG 19/8/19 : Added for MR04 
	var sAddNewAcntProf =  TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);
	if(TheApplication().GetProfileAttr(&quot;NBNRetrievePlans&quot;) == &quot;Y&quot; &amp;&amp; FieldName == &quot;VF Customer Segment&quot; &amp;&amp; FieldValue == &quot;Consumer&quot;)
	{
		TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VFCustSegment&quot;));
	}
	if((FieldName == &quot;WSDL Address&quot;) &amp;&amp; (FieldValue != &quot;&quot; || FieldValue != null))
	{
	TheApplication().SetProfileAttr(&quot;TBUIPostChangeAdd&quot;, &quot;Y&quot;);
	}
	if((FieldName == &quot;WSDL Address&quot;) &amp;&amp; (FieldValue == &quot;&quot; || FieldValue == null))
	{
		TheApplication().SetProfileAttr(&quot;TBUIPostChangeAdd&quot;, &quot;N&quot;);
	}//vasavi added for two if conditions for moconsq	
	if((FieldName == &quot;WSDL Service Address&quot;) &amp;&amp; (FieldValue != &quot;&quot; || FieldValue != null))
	{
		TheApplication().SetProfileAttr(&quot;TBUIFWAPostChangeAdd&quot;, &quot;Y&quot;);
	}
	if((FieldName == &quot;WSDL Service Address&quot;) &amp;&amp; (FieldValue == &quot;&quot; || FieldValue == null))
	{
		TheApplication().SetProfileAttr(&quot;TBUIFWAPostChangeAdd&quot;, &quot;N&quot;);
	}
	if(FieldName == &quot;WSDL Shipment Address&quot; &amp;&amp; (FieldValue != &quot;&quot; &amp;&amp; FieldValue != null)) //Sachi - 10-Mar-2020 - Added for Capture Delivery Address CIR - MR1 
	{
	TheApplication().SetProfileAttr(&quot;TBUIPostChangeAddShip&quot;, &quot;Y&quot;);
	}
	if(FieldName == &quot;WSDL Shipment Address&quot; &amp;&amp; (FieldValue == &quot;&quot; || FieldValue == null)) //Sachi - 10-Mar-2020 - Added for Capture Delivery Address CIR - MR1 
	{
		TheApplication().SetProfileAttr(&quot;TBUIPostChangeAddShip&quot;, &quot;N&quot;);
	}
	if(FieldName == &quot;Manual Address Entry&quot; &amp;&amp; FieldValue == &quot;Y&quot;) //Added for PKE000000023205 fix - chitra - 29/05/2015
	{
				var bQASExecuted = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;);
				if (bQASExecuted != &quot;Y&quot;)
					{
						
						TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query PSMA at least once before saving an unvalidated address.&quot;);
					}
		

	}
	//Vasavi added below if for moconsq
	if(FieldName == &quot;FWA Manual Address Entry&quot; &amp;&amp; FieldValue == &quot;Y&quot;)
	{
				var bQASExecuted = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;);
				if (bQASExecuted != &quot;Y&quot;)
					{
						
						TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query PSMA at least once before saving an unvalidated address.&quot;);
					}
		

	}
	if(FieldName == &quot;Manual Shipment Address&quot; &amp;&amp; FieldValue == &quot;Y&quot;) //VHA - Guruprasad - 10/03/2020 - Added for MR1
	{
				var bQASExecuted = TheApplication().GetProfileAttr(&quot;Shipment QAS Query Executed&quot;);
				if (bQASExecuted != &quot;Y&quot;)
					{
						
						TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query Shipment PSMA at least once before saving an unvalidated address.&quot;);
					}
		

	}
	
	//VHA Nandhini G 16/8/19 : Added for MR04 - Special Character CIR 
	var ssjFlow = TheApplication().GetProfileAttr(&quot;SSJFlow&quot;); //SSINGHAL: Added for skiping validations as added at frontend
 
	if(ssjFlow != &quot;Y&quot; &amp;&amp; (FieldName == &quot;Last Name&quot; || FieldName == &quot;First Name&quot; || FieldName == &quot;Middle Name&quot;) &amp;&amp; (FieldValue != &quot;&quot; || FieldValue != null) &amp;&amp; ((sView == &quot;FirstView&quot;) || (sFBBNewCustFlag == &quot;Y&quot;)))
	{
	var sValSplCharBs = TheApplication().GetService (&quot;VHA Validate Special Character&quot;);
	var psInputs = TheApplication().NewPropertySet();
	var psOutputs = TheApplication().NewPropertySet();
	psInputs.SetProperty(&quot;String&quot;,FieldValue);
	sValSplCharBs.InvokeMethod(&quot;ValidateSpecialCharacter&quot;, psInputs, psOutputs);
	var sErrMsg = psOutputs.GetProperty(&quot;ErrMsg&quot;);
	if(sErrMsg != &quot;&quot; &amp;&amp; sErrMsg != null)
		TheApplication().RaiseErrorText(sErrMsg);
	}
	//ENDS HERE
	
	/*if(FieldName == &quot;Manual Address Entry&quot;)
	{
		var sQASE = TheApplication().GetProfileAttr(&quot;QAS Query Executed&quot;);
		if (sQASE != &quot;Y&quot;)
		{
			TheApplication().RaiseErrorText(&quot;Please Use QAS System to Validate the address once.&quot;);
			return (CancelOperation);
		}

	}*/

	/*if(FieldName == &quot;CA PIN&quot; &amp;&amp; sAddNewAcntProf == &quot;Y&quot;)
	{
		if(FieldValue == &quot;&quot; || FieldValue == null)
		{
			this.SetFieldValue(&quot;CA PIN&quot;,&quot;&quot;);
			TheApplication().RaiseErrorText(&quot;CAPIN is required Field. Please enter a value for the field.&quot;);
		}
	}*/

	//Karthika - 10/06/2017 - Added as part of Retrofit
	var sPINFlag = &quot;N&quot;;
	if(FieldName == &quot;CA PIN&quot; &amp;&amp; sSkipPINFlg == &quot;N&quot; &amp;&amp; sAddNewAcntProf != &quot;Y&quot;)
	{
			//Muthushankari 27/3/2017 Added for R17.2 Service PIN Validation CIR
		if(TheApplication().ActiveViewName() == &quot;VF Capture Exst Customer Details Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details – Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details - Postpay TBUI HI&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Customer Details – Postpay - SSJ&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Exst Customer Details Postpay TBUI - SSJ&quot;)
		{
			var svc, input, output;
			var eai_flag = TheApplication().GetProfileAttr(&quot;EAI_FLAG&quot;);
			var bulk_flag = TheApplication().GetProfileAttr(&quot;VFBulkPinNoValidation&quot;);
			var post_order_flag = TheApplication().GetProfileAttr(&quot;ASSET_POST_ORDER_FLAG&quot;);
			//this.ActivateField(&quot;VHA Responsibility Calc&quot;);
			var resp_exists = this.GetFieldValue(&quot;VHA Responsibility Calc&quot;);
			if(FieldValue == &quot;&quot; || FieldValue == null)
			{
				svc = TheApplication().GetService(&quot;VF Network Settings BS&quot;);
				input = TheApplication().NewPropertySet();
				input.SetProperty(&quot;Type&quot;, &quot;VHA_PIN_VALIDATION&quot;);
				input.SetProperty(&quot;LIC&quot;, &quot;Log Error&quot;);
				output = TheApplication().NewPropertySet();
				svc.InvokeMethod(&quot;QueryLOV&quot;, input, output);
				var sDesc = output.GetProperty(&quot;Desc&quot;);
				sPINFlag = &quot;Y&quot;;
				TheApplication().RaiseErrorText(sDesc);
			}
			else if (eai_flag == &quot;Y&quot; || bulk_flag == &quot;TRUE&quot; || resp_exists == &quot;Y&quot; || post_order_flag == &quot;Y&quot;)
				return;
			else
			{
				svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
				input = TheApplication().NewPropertySet();
				output = TheApplication().NewPropertySet();
				input.SetProperty(&quot;ProcessName&quot;, &quot;VHA PIN Validation Process&quot;);
				input.SetProperty(&quot;PIN&quot;, FieldValue);
				sPINFlag = &quot;Y&quot;;
				svc.InvokeMethod(&quot;RunProcess&quot;, input, output);
			}
		}
	}
	if(FieldName == &quot;ABN/ACN&quot;)
	{
		if(TheApplication().ActiveViewName() == &quot;VF Capture Exst Customer Details Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details – Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details - Postpay TBUI HI&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Customer Details – Postpay - SSJ&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Exst Customer Details Postpay TBUI - SSJ&quot;)
		{
			TheApplication().SetProfileAttr(&quot;VHAValidateABNACNTbui&quot;,&quot;N&quot;);
		}
	}
	if(FieldName == &quot;VF Customer Type&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;TBUIPostExstCust&quot;) == &quot;Y&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VHASetCustTypePick&quot;) == &quot;Y&quot;)
	{
		if(TheApplication().ActiveViewName() == &quot;VF Capture Exst Customer Details Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details – Postpay TBUI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details - Postpay TBUI HI&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Customer Details - Postpay TBUI HI&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Customer Details – Postpay - SSJ&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Exst Customer Details Postpay TBUI - SSJ&quot;)
		{
			TheApplication().SetProfileAttr(&quot;VHASetCustTypePick&quot;,&quot;&quot;);
			var sErrMsg = mGetLov(this.GetFieldValue(&quot;VF Customer Type&quot;),FieldValue);
			if(sErrMsg != null &amp;&amp; sErrMsg != &quot;&quot;)
			{
				TheApplication().RaiseErrorText(sErrMsg);
			}
		}
	}
	/*if(FieldName == &quot;Customer Bill Segment&quot; &amp;&amp; gNewRec == &quot;FALSE&quot;)
	{
		var svc = TheApplication().GetService(&quot;VF TBUI Utilities&quot;);
		var input = TheApplication().NewPropertySet();
		var output = TheApplication().NewPropertySet();
		input.SetProperty(&quot;Bill Segment&quot;, FieldValue);
		svc.InvokeMethod(&quot;SetDOM&quot;,input,output);
		this.SetFieldValue(&quot;DOM&quot;,output.GetProperty(&quot;DOM&quot;));
	}*/

}
catch(e)
{
if (sPINFlag == &quot;Y&quot;)
			TheApplication().RaiseErrorText(e.toString());
		else
			throw(e);
}
finally
{

/*Below variables are nullified by Sharukh on 05/04/2019*/

		if(defined(svc)) { svc = null; }
		if(defined(input)) { input = null; }
		if(defined(output)) { output = null; }
}
	return (ContinueOperation);
}"
			   SEQUENCE="11"
