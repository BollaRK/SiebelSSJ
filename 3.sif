			   INACTIVE="N"
			   NAME="Default Display Field"
			   VALUE="Name"
			   UPDATED="06/07/2014 00:17:08"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:08"
			   CREATED_BY="SADMIN">
			</BUSINESS_COMPONENT_USER_PROP>
			<BUSINESS_COMPONENT_USER_PROP
			   INACTIVE="N"
			   NAME="Field Read Only Field: Parent Account Name"
			   VALUE="Parent Account Name Read Only Flag"
