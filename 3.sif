			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateCoverageCheckbyAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCreateCoverageCheckbyAddress(strOriginator, strStreetNum, strStreetName, strStreetType, strSurburb, strState, strPostalCode)
{
	var strCCId = &quot;&quot;;
	var boCoverageChk;
	var bcCoverageChk;
	var strError;
	
	try {
				
		boCoverageChk = TheApplication().GetBusObject(&quot;VF Coverage Check Thin&quot;);
		bcCoverageChk = boCoverageChk.GetBusComp(&quot;VF Coverage Check Thin&quot;);
		with (bcCoverageChk) {
			NewRecord(NewAfter);
			SetFieldValue(&quot;Originator&quot;, &quot;CoverageCheck&quot;);
			SetFieldValue(&quot;StreetNumber&quot;, strStreetNum);
			SetFieldValue(&quot;StreetName&quot;, strStreetName);
			SetFieldValue(&quot;StreetType&quot;, strStreetType);
			SetFieldValue(&quot;Suburb&quot;, strSurburb);
			SetFieldValue(&quot;State&quot;, strState);
			SetFieldValue(&quot;Postcode&quot;, strPostalCode);
			WriteRecord();
			gCCId1 = GetFieldValue(&quot;Id&quot;);
		}
	//	return strCCId;
		
	} catch (e) {
		throw e;
	} finally {
	
		bcCoverageChk = null;
		boCoverageChk = null;
	}
}"
