			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetLov"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetLov(sExistingVal,sNewVal)//VHA Muthushankari - 7/5/2019 - Created for R19.02 ABN/ACN Validation CIR
{
	try
	{
		var BO = TheApplication().GetBusObject(&quot;VHA List Of Values&quot;);
		var BC = BO.GetBusComp(&quot;List Of Values&quot;);
		var sUpdateAvail = &quot;N&quot;;
		var sErrorMsg = &quot;&quot;;
		var sPersonLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CUST_TYPE&quot;,&quot;Person&quot;);
		var sSoleTraderLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CUST_TYPE&quot;,&quot;Sole Trader&quot;);
		var sAddNewAccount = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);//[Nagesh][Defect 272 fix][drop 3.2]
		with(BC)
		{
			ActivateField(&quot;Value&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Type] = &apos;VHA_SWITCH_CA_TYPE&apos; AND [Name] = &apos;&quot;+sExistingVal+&quot;&apos; AND [Value] = &apos;&quot;+sNewVal+&quot;&apos; AND [Active] = &apos;Y&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sUpdateAvail = &quot;Y&quot;;
			}
			if(sUpdateAvail == &quot;N&quot; &amp;&amp; sAddNewAccount != &quot;Y&quot;)
			{
				if(sExistingVal == sPersonLOV || sExistingVal == sSoleTraderLOV)
				{
					sErrorMsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;98304&quot;);
				}
				else
				{
					sErrorMsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;98305&quot;);
				}
			}
		}
		return (sErrorMsg);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		BC = null;
		BO = null;
	}
}"
			   SEQUENCE="4"
			   UPDATED="10/12/2024 19:23:14"
			   UPDATED_BY="NAGESHWARAK"
			   CREATED="09/30/2019 12:01:53"
			   CREATED_BY="SADMIN">
