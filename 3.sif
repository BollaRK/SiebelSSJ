			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{

	if(ToNumber(this.GetFieldValue(&quot;PP Amount Paid Upfront&quot;)) &gt; 0)
		TheApplication().SetProfileAttr(&quot;PrePaymentRO&quot;,&quot;N&quot;);
	else
		TheApplication().SetProfileAttr(&quot;PrePaymentRO&quot;,&quot;Y&quot;);
}"
			   SEQUENCE="1"
			   UPDATED="01/22/2026 18:35:51"
			   UPDATED_BY="KOVIDT"
			   CREATED="09/30/2019 12:01:54"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{

	//VHA KT 22/01/26: Added Field validation for Prepayment Amount for SSJFulfilment as per BAU
