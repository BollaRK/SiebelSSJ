			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_ChangeRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_ChangeRecord ()
{	
	// Created for Auditing 
	// KARP : 03/11/2011 : Updated For Femtocell		
	try
	{
		gPassword = this.GetFieldValue(&quot;Password&quot;);
		//VIVIND: Setting the Profile Attr for the BA Type
		gBATypeChange = this.GetFieldValue(&quot;Master Account Type&quot;);
		TheApplication().SetProfileAttr(&quot;BATypeChange&quot;,gBATypeChange);
		var sId = this.GetFieldValue(&quot;Id&quot;);
		TheApplication().SetProfileAttr(&quot;VF_BILLING_ACCOUNT_ID&quot;,sId);
	}
	catch (e)
	{
			TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
	}

