			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mScanCheckBeforeCreditCheck"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mScanCheckBeforeCreditCheck()
{
/*
 * Component Name        : 	VF Com Financial Profile - Credit Check Applet
 * Method Name           : 	mScanCheckBeforeCreditCheck
 * Component Information : 	This function checks wheather the scan has been done for the ID or not,if not shows the error message.
 *
 * Modification History  :
 * Date			Author		Config #		Description
 * ============ ===========	===========	================================
 * 15/06/2011	VIJAY		Paperless Project			Initial Version
 * 19/07/2011   XA			TD6711			This code is copied from Applet level to this BC &amp; added refined logic
 */
	try
	{
		// Trace Stmt
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:BC - VF Com Financial Profile.mLaunchScanner()&quot;);
		}
			var  dtCreditChkReqDate,vParentAccountId,bIsDealerEligible,boConShowCase,bcIDScanSession;
			var strUploadedSuccessfully,dtUploadedDate,strScanBypassReason,oUploadedDate,vUploadedDateInms,vTimeInms;
			var vScanLmitTime,dtScanCreatedDate,oCreditChkReqDate,vCreditChkReqDateInms,oScanCreatedDate,vdtScanCreatedDateInms,val,iVal;
			var oCreatedDate;
			var vCreatedDateInms;
			var strCurrentSubmitCheckDate;
			var strCurrentSubmitCheckDateInms;
			var strPrimaryScanRecord;
			var Inputs = TheApplication().NewPropertySet();
			var Out = TheApplication().NewPropertySet();
			
			bIsDealerEligible=TheApplication().GetProfileAttr(&quot;IsDealerEnableForIdScan&quot;);
			
			if(bIsDealerEligible==&quot;TRUE&quot;) {
				mUpdateAccountScanEnabled(&quot;Y&quot;);
			} else {
				mUpdateAccountScanEnabled(&quot;N&quot;);
			}
			
			if(bIsDealerEligible==&quot;TRUE&quot;)
			 {
				//dtCreditChkReqDate=this.GetFieldValue(&quot;VF Credit Check Requested Date&quot;);
				strCurrentSubmitCheckDate = this.GetFieldValue(&quot;VF Submit CC Initiated Date Time Calc&quot;);
				oCreditChkReqDate=new Date(strCurrentSubmitCheckDate);
				vCreditChkReqDateInms=oCreditChkReqDate.getTime();
				
				vParentAccountId = this.ParentBusComp().GetFieldValue(&quot;Id&quot;);
				if (vParentAccountId != null &amp;&amp; vParentAccountId != &quot;&quot;)
				{					
					Inputs.SetProperty(&quot;CustId&quot;, vParentAccountId)
					fnUpdateIDScanSession(Inputs, Out);
				}
				//strPrimaryScanRecord = this.ParentBusComp().GetFieldValue(&quot;VF Primary Scan Session Id&quot;);
				strPrimaryScanRecord = Out.GetProperty(&quot;ScanId&quot;);

				//VF RT 27-07-2011: Added as part of the Performance Analysis.
				if(strPrimaryScanRecord == &quot;&quot; || strPrimaryScanRecord == null)
				{
					throw(&quot;Your store is enabled for ID scanning and you have not scanned the customer’s ID documents.  Please create a new ID scanning session.&quot;);  
				}
								
				boConShowCase = TheApplication().GetBusObject(&quot;VF Connection Showcase&quot;);
				bcIDScanSession = boConShowCase.GetBusComp(&quot;VF ID Scan Session&quot;);
				
					with(bcIDScanSession)
				     {
						ClearToQuery();
						ActivateField(&quot;Uploaded Date&quot;);
						ActivateField(&quot;ID Scan Bypass Reason Code&quot;);
						SetSearchSpec(&quot;Id&quot;,strPrimaryScanRecord);
						//SetSearchSpec(&quot;Customer Account Id&quot;,vParentAccountId);
						ExecuteQuery(ForwardOnly);
						if (FirstRecord())
						{
					  		dtUploadedDate	= GetFieldValue(&quot;Uploaded Date&quot;);
							strScanBypassReason	=GetFieldValue(&quot;ID Scan Bypass Reason Code&quot;);
							dtScanCreatedDate=GetFieldValue(&quot;Created&quot;);
							
							val=TheApplication().InvokeMethod (&quot;LookupValue&quot;,&quot;PP_ID_SCAN_DURATION&quot;,&quot;IDScanDurationLimit&quot;);
					 		iVal=ToInteger(val);
					 		vTimeInms=iVal*60*60*1000;
							
							if (dtUploadedDate!=&quot;&quot;)
							{
							 	oUploadedDate=new Date(dtUploadedDate);
								vUploadedDateInms=oUploadedDate.getTime();
								vScanLmitTime=vCreditChkReqDateInms-vUploadedDateInms;
								
					 			if(vScanLmitTime&gt;vTimeInms)
									throw(&quot;Your store is enabled for ID scanning and you have not scanned a recent copy of the customer’s ID document(s) since the previous credit check.  Please create a new ID scanning session.&quot;); 
							 }
							 else
							 {
							 	if(strScanBypassReason != &quot;&quot;)
							 	{
							 		oCreatedDate=new Date(dtScanCreatedDate);
									vCreatedDateInms=oCreatedDate.getTime();
									vScanLmitTime=vCreditChkReqDateInms-vCreatedDateInms;
							 	
							 		if(vScanLmitTime&gt;vTimeInms)
										throw(&quot;Your store is enabled for ID scanning and you have not scanned a recent copy of the customer’s ID document(s) since the previous credit check.  Please create a new ID scanning session.&quot;); 
							 	}
							 	else
							 	{
							 			throw(&quot;You have bypassed the last ID Scanning. Please select a valid ID scanning Bypass Reason code.&quot;); 
							 	}
							 }
						} 
						else
						{
							throw(&quot;Your store is enabled for ID scanning and you have not scanned the customer’s ID documents.  Please create a new ID scanning session.&quot;);  // CUZZILLAR, 13/07/2011, Stop Credit Check if there are no Scan Sessions
						}
				     }//with
				
				}//IsDealerEligible
	
	}//try
	catch(e)
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			TheApplication().Trace(&quot;ERROR:BC-VF Com Financial Profile.mScanCheckBeforeCreditCheck().Err=&quot; + e.errText);
		
		throw (e);
	}
	finally
	{
			bcIDScanSession = null;
			boConShowCase	= null;
			oUploadedDate	= null;
			oScanCreatedDate = null;
			oCreditChkReqDate = null;
			Inputs = null;
			Out = null;
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			TheApplication().Trace(&quot;END:BC-VF Com Financial Profile.mScanCheckBeforeCreditCheck()&quot;);
	}

}//mScanCheckBeforeCreditCheck"
			   SEQUENCE="14"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetCampCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetCampCode
 * Component Information : 	This function will Mask campaign code
 * ============ ===========	===========	================================
 * 14/8/2013	SIBIC		This code is moved as it existed in the Preinvoke method with minor changes for CJ
 *							Moved code to a seprate function as the script limit had reached
 * 08/08/2014	Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages 
 */

function mSetCampCode()
{
 try
 {
 		// Trace statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{ 
			TheApplication().Trace(&quot;START:VF Com Financial Profile.mSetCampCode:&quot;); 
		}	
		
		//VF DO 7/4/10 - 10.3 Credit Approval.
		var sUICampaignCode = this.GetFieldValue(&quot;VF Campaign Code UI&quot;);
		var aField = new Array(); // MADHUR::25-MAY-23::Added for CPVT-648
		var sCampCode = new Array();// MADHUR::25-MAY-23::Added for CPVT-648 
    	aField = sUICampaignCode.split(&quot;,&quot;);// MADHUR::25-MAY-23::Added for CPVT-648
		var sMaskValue = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CC_CAMPAIGN_CD&quot;,&quot;MASK&quot;);
	
		if((sUICampaignCode != &quot;&quot;) &amp;&amp; (sUICampaignCode != sMaskValue) )
		{
			//VF:KPOLURU:05/05/2010:Defect#5197: Set the lIC value to Campaign Code , this is the expected value by 
			//Decision Point, below code gets the LIC not the Value
		
			var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
			var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);			
			var bLOVRecord = &quot;&quot;;
			var sCampaignCode = &quot;&quot;;
			for( var i=0;i&lt;aField.length;i++)// MADHUR::25-MAY-23::Added forloop for CPVT-648 
	    	{
				//KARP 23/07/2010 Constructing a case insensitive search expression					
				var sType = &quot;VF_CC_CAMPAIGN_CD&quot;;
				var sActive = &quot;Y&quot;;
	
				// MADHUR::25-MAY-23::commented beolw searchspec for CPVT-648
				/*var sSearchExpr = &quot;[Type] = &apos;&quot; + sType + &quot;&apos;&quot;
						+ &quot; AND [Active] = &apos;&quot; + sActive + &quot;&apos;&quot;
						+ &quot;	AND [Value] ~LIKE &apos;&quot; + sUICampaignCode + &quot;*&apos;&quot;;*/
	
				// MADHUR::25-MAY-23::Added for CPVT-648
				var sSearchExpr = &quot;[Type] = &apos;&quot; + sType + &quot;&apos;&quot;
						+ &quot; AND [Active] = &apos;&quot; + sActive + &quot;&apos;&quot;
						+ &quot;	AND [Value] ~LIKE &apos;&quot; + aField[i] + &quot;*&apos;&quot;;
	
				with (bcLOV)
				{
					SetViewMode(AllView);
					ActivateField(&quot;Type&quot;);
					ActivateField(&quot;Active&quot;);
					ActivateField(&quot;Value&quot;);
					ActivateField(&quot;Name&quot;);
					ActivateField(&quot;VF Campaign Code&quot;);
					ClearToQuery();
					SetSearchExpr(sSearchExpr);
					ExecuteQuery();
					if(FirstRecord())
					{
						sCampCode[i] = GetFieldValue(&quot;Name&quot;); // MADHUR:25-MAY-23::Added for CPVT-648
						//this.SetFieldValue(&quot;VF Campaign Code&quot;, GetFieldValue(&quot;Name&quot;));// MADHUR::25-MAY-23::COMMENTED for CPVT-648
					}//if(FirstRecord())
				}//with (bcLOV)
			}//for
				this.SetFieldValue(&quot;VF Campaign Code&quot;, sCampCode);// MADHUR::25-MAY-23::Added for CPVT-648
		}//if((sUICampaignCode 
		this.WriteRecord();
			
 }//try
 
 catch (e)
 {
		if (defined(e.errText))
		{
			var sErrorMessage = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var sErrorMessage = e.toString(); 
		}
		
		throw(sErrorMessage);	
 }//catch
 
 finally
 {
	
	/*Below variables are nullified by Sharukh on 01/04/2019*/
	//	bcLOV = null;
	//boLOV = null;
	/*Below variables are nullified by BALAMURUGAN on 24/10/2019*/
		if(defined(bcLOV)) { bcLOV = null; }
		if(defined(boLOV)) { boLOV = null; }


	if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;) 
		{
			TheApplication().Trace(&quot;END: VF Com Financial Profile.mSetCampCode:&quot;);
		}
 }//finally
}"
			   SEQUENCE="15"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDVSTransId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetDVSTransId(AccountId)
{
//VHA NandhiniG 26/07/20 : Changed the SearchSpec and conditions to set the DVS Transaction Id Value in Credit Check Request as part of  Aug Rel - VEVO CIR.	
try
{	
	if(AccountId != null &amp;&amp; AccountId != &quot;&quot;)
	{		
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);	
		var sAccBC = sBO.GetBusComp(&quot;Account&quot;);
		var sConBC = sBO.GetBusComp(&quot;Contact&quot;);
		var sConIdBC = sBO.GetBusComp(&quot;VF Contact Id&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Configuration List&quot;);
		var sContactId = &quot;&quot;, sPPCountryFlag = &quot;Y&quot;,sDVSTranId = &quot;&quot;,sDVSSuccessTime = &quot;&quot;,sLocalPP = &quot;&quot;;
		var sSearchExpr1 = &quot;&quot;;
		var sSearchExpr2 = &quot;&quot;;
		var sDVSId = &quot;&quot;, sPassportId = &quot;&quot;, sLicenseId=&quot;&quot;,sMediId = &quot;&quot;;
		var sInvPPId = &quot;&quot;,sInvDLId = &quot;&quot;,sInvMCId= &quot;&quot;,sValidIDType = &quot;&quot; , sDVSTranId = &quot;&quot;;
		var sPassport = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Passport&quot;);
		var sDrivLicense = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Driver&apos;s Licence&quot;);
		var sMediCard = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_ID_TYPE&quot;, &quot;Medicare Card&quot;);
		var sIP = &quot;NA&quot;, sPP = &quot;NA&quot;, sDL = &quot;NA&quot;, sMC = &quot;NA&quot;,sIPId = &quot;&quot; ,sInvIPId = &quot;&quot;,sVEVOSysdown = &quot;&quot;,sValidIDFlag = &quot;&quot;,sDVSTranIdType = &quot;&quot;,sDVSIdAvailable = &quot;N&quot;;
		
		with(sAccBC)
		{			
		 	ClearToQuery();		
			ActivateField(&quot;Primary Contact Id&quot;);			
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, AccountId);		
			ExecuteQuery();
			if(FirstRecord())
			{
				sContactId = GetFieldValue(&quot;Primary Contact Id&quot;);
			
			
				with (sConBC)
				{					
					SetViewMode(AllView);
					ClearToQuery();					
					ActivateField(&quot;Id&quot;);				
					SetSearchSpec(&quot;Id&quot;, sContactId);
					ExecuteQuery(ForwardOnly);					
					if (FirstRecord())
					{
						with(sConIdBC)
						{
							SetViewMode(AllView);
							ClearToQuery();
							ActivateField(&quot;Id Type&quot;);
							ActivateField(&quot;DVS Transaction Id&quot;);
							ActivateField(&quot;VHA Remove Existing Id&quot;);
							ActivateField(&quot;Country of Issue&quot;);
							ActivateField(&quot;VHA IsVEVOSysdown&quot;);
							ActivateField(&quot;VHA Primary ID Captured Ref&quot;);
						//	sSearchExpr1 = &quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos;	AND ([Id Type] = &apos;&quot;+sPassport+&quot;&apos; OR [Id Type] = &apos;&quot;+sDrivLicense+&quot;&apos; OR [Id Type] = &apos;&quot;+sMediCard+&quot;&apos;) AND [DVS Successful Time] IS NOT NULL AND [DVS Transaction Id] IS NOT NULL&quot;	
						//	SetSearchExpr(&apos;[Contact Id] = &quot;&apos;+sContactId+&apos;&quot;	AND ([Id Type] = &quot;&apos;+sPassport+&apos;&quot; OR [Id Type] = &quot;&apos;+sDrivLicense+&apos;&quot; OR [Id Type] = &quot;&apos;+sMediCard+&apos;&quot;) AND [DVS Successful Time] IS NOT NULL AND [DVS Transaction Id] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &quot;Y&quot; OR [VHA Remove Existing Id] IS NULL)&apos;);
							SetSearchExpr(&apos;[Contact Id] = &quot;&apos;+sContactId+&apos;&quot;	AND ([Id Type] = &quot;&apos;+sPassport+&apos;&quot; OR [Id Type] = &quot;&apos;+sDrivLicense+&apos;&quot; OR [Id Type] = &quot;&apos;+sMediCard+&apos;&quot;) AND [VHA Primary ID Captured Ref] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &quot;Y&quot; OR [VHA Remove Existing Id] IS NULL)&apos;);
						//	SetSearchExpr(&quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos;	AND ([Id Type] = &apos;&quot;+sPassport+&quot;&apos; OR [Id Type] = &apos;&quot;+sDrivLicense+&quot;&apos; OR [Id Type] = &apos;&quot;+sMediCard+&quot;&apos;) AND [VHA Primary ID Captured Ref] IS NOT NULL AND ([VHA Remove Existing Id] &lt;&gt; &apos;Y&apos; OR [VHA Remove Existing Id] IS NULL)&quot;);
							ExecuteQuery(ForwardOnly);	
							var irec = 	FirstRecord();
							if(FirstRecord())
							{
							sDVSIdAvailable = &quot;Y&quot;;			
							while(irec)
							{
								sDVSTranId = GetFieldValue(&quot;DVS Transaction Id&quot;);
								sDVSSuccessTime = GetFieldValue(&quot;DVS Successful Time&quot;);
								
								if(GetFieldValue(&quot;Id Type&quot;) == sPassport)
								{
									sPPCountryFlag = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;PassportCountry|&quot;+GetFieldValue(&quot;Country of Issue&quot;));
									if(sPPCountryFlag == &quot;Y&quot;)
									{
									sLocalPP = &quot;Y&quot;;
										if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
										{
											sPassportId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sPP = &quot;Y&quot;;
										}
										else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
										{
											sPassportId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sPP = &quot;N&quot;;
										}
									}
									else 
									{
										sVEVOSysdown = GetFieldValue(&quot;VHA IsVEVOSysdown&quot;);																	
										if(((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)) || (sVEVOSysdown == 1))
											sIP = &quot;Y&quot;;
										else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
											sIP = &quot;N&quot;;
									}
								}
								else if(GetFieldValue(&quot;Id Type&quot;) == sDrivLicense)
								{	
									if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null)  &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
									{
										sLicenseId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sDL = &quot;Y&quot;;
									}
									else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
									{
										sLicenseId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sDL = &quot;N&quot;;
									}
								}
								else if(GetFieldValue(&quot;Id Type&quot;) == sMediCard)
								{
									if((sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null) &amp;&amp; (sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null))
									{
										sMediId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sMC = &quot;Y&quot;
									}
									else if(sDVSTranId != &quot;&quot; &amp;&amp; sDVSTranId != null)
									{
										sMediId = GetFieldValue(&quot;DVS Transaction Id&quot;);
										sMC = &quot;N&quot;;
									}
								}
								
							irec = NextRecord();		
							}
							}
							if(sLocalPP == &quot;Y&quot;)
								sIP = &quot;NA&quot;;

							var sSearchSpec = &quot;[Type] = &apos;VHA_DVS_CC_REQUEST_VALUE&apos; AND [Active Flg] = &apos;Y&apos; AND [String 1] = &apos;&quot;+sIP+&quot;&apos; AND [String 2] = &apos;&quot;+sPP+&quot;&apos; AND [String 3] = &apos;&quot;+sDL+&quot;&apos; AND [String 4] = &apos;&quot;+sMC+&quot;&apos;&quot;;
							with(sBC)
							{
								ActivateField(&quot;Value&quot;);
								ActivateField(&quot;Name&quot;);
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchExpr(sSearchSpec);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									sValidIDFlag = GetFieldValue(&quot;Name&quot;);
									sDVSTranIdType = GetFieldValue(&quot;Value&quot;);					
								}
							}
							
							if(sDVSTranIdType == &quot;Passport&quot;)
								sDVSId = sPassportId;
							else if (sDVSTranIdType == &quot;DL&quot;)
								sDVSId = sLicenseId;
							else if (sDVSTranIdType == &quot;MC&quot;)
								sDVSId = sMediId;

						if(sDVSIdAvailable == &quot;N&quot;)
							{
								SetViewMode(AllView);
								ClearToQuery();	
								ActivateField(&quot;Id Type&quot;);
								ActivateField(&quot;VHA Primary ID Captured Ref&quot;);
								ActivateField(&quot;VHA Remove Existing Id&quot;);
								SetSearchExpr(&quot;[Contact Id] = &apos;&quot;+sContactId+&quot;&apos; AND ([VHA Remove Existing Id] &lt;&gt; &apos;Y&apos; OR [VHA Remove Existing Id] IS NULL)&quot;);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{
									var isrec1 = FirstRecord();
									while(isrec1)
									{
										if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_CC_NONDVS_ID&quot;,GetFieldValue(&quot;Id Type&quot;)) == &quot;Y&quot;)
										{
											sValidIDFlag = &quot;Y&quot;;
										}
										else if((GetFieldValue(&quot;VHA Primary ID Captured Ref&quot;) == &quot;&quot; || GetFieldValue(&quot;VHA Primary ID Captured Ref&quot;) == null) &amp;&amp; 
										TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_DVS_PP_TBUI&quot;,GetFieldValue(&quot;Id Type&quot;)) == &quot;Y&quot;)
										{
											sDVSSuccessTime = GetFieldValue(&quot;DVS Successful Time&quot;);
											sDVSTranId = GetFieldValue(&quot;DVS Transaction Id&quot;);
											sValidIDFlag = &quot;Y&quot;;
											if(GetFieldValue(&quot;Id Type&quot;) == sPassport &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sPassportId = sDVSTranId;
											else if(GetFieldValue(&quot;Id Type&quot;) == sDrivLicense &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sLicenseId = sDVSTranId;
											else if(GetFieldValue(&quot;Id Type&quot;) == sMediCard &amp;&amp; (sDVSSuccessTime != &quot;&quot; &amp;&amp; sDVSSuccessTime != null))
												sMediId = sDVSTranId;
										}
									isrec1 = NextRecord();
									}
									if(sPassportId != &quot;&quot; &amp;&amp; sPassportId != null)
										sDVSId = sPassportId;
									else if (sLicenseId != &quot;&quot; &amp;&amp; sLicenseId != null)
										sDVSId = sLicenseId;
									else if (sMediId != &quot;&quot; &amp;&amp; sMediId != null)
										sDVSId = sMediId;
								//VHA NandhiniG 07/10/20 : Added for VEVO Post Production issue fix.
								}
							}

						}
					}
				}
			}
		}
	}
	//if(sDVSId != null &amp;&amp; sDVSId != &quot;&quot;)
	//{	
		this.ActivateField(&quot;VHA Device Fraud Check Txn Id&quot;);
		this.ActivateField(&quot;VHA ValidIdIdent&quot;);
		this.SetFieldValue(&quot;VHA Device Fraud Check Txn Id&quot;,sDVSId);
		this.SetFieldValue(&quot;VHA ValidIdIdent&quot;,sValidIDFlag);
		this.WriteRecord();
		this.InvokeMethod(&quot;RefreshBusComp&quot;);
//	}
}

catch(e)
{
throw(e);
}
	
finally
{
	sAccBC = null;
	sConBC = null;
	sConIdBC = null;
	sBC = null;
	sBO = null;
	sContactId = null;
	sSearchExpr1 = null;
	sSearchExpr2 = null;
	sDVSId = null;
		
}
}"
			   SEQUENCE="18"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="11/06/2019 15:08:31"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDealerCode"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetDealerCode()
/*
 * Date			Author	Description
 * ----------   ------	-------------------------------------------------------
 * 22/03/2010	DO		10.3 Credit Approval. Set predefault values for Deal Code
 *						Dealer Description and Sales Channel based off the 
 *						logged on user&apos;s profile.
 * 19/04/2010	DO		10.3 Credit Approval. Defect 39550. Removed references to
 *						Sales Channel because this is now set via the pick map on
 *						the Dealer Description field.
 * 17/6/2010    DFiggis R10.3 UAT#3028 - ReadOnly User property caused error for &quot;New Record&quot;.
                        Admin mode didn&apos;t work so required seperated field
*/
{
	try 
	{ 
		//Declare variables
		var sEmpId = this.GetFieldValue(&quot;VF User Login Id&quot;);
		var sDealer = &quot;&quot;;
		//var sSalesChannel = &quot;&quot;;

		//Declare objects
		var boEmployee = TheApplication().GetBusObject(&quot;Employee&quot;);
		var bcEmployee = boEmployee.GetBusComp(&quot;Employee&quot;);
		
		//Find the employee record associated to the user currently logged in.
		with (bcEmployee)
	 	{
			SetViewMode(AllView);
			ActivateField(&quot;VF Sales Branch Description&quot;); //Dealer Description
			ActivateField(&quot;VF Sales Channel Description&quot;); //Sales Channel
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sEmpId);
			ExecuteQuery();
		}
		
		if (bcEmployee.FirstRecord())
		{
		
			sDealer = bcEmployee.GetFieldValue(&quot;VF Sales Branch Description&quot;);
			
			if (sDealer != &quot;&quot; &amp;&amp; sDealer != null &amp;&amp; sDealer != &quot;undefined&quot;) //Saravanan : 15.2 Defect #48 : 05/05/2015
			{
				//sSalesChannel = bcEmployee.GetFieldValue(&quot;VF Sales Channel Description&quot;);
				
				//Get the picklist that sits on the Dealer Description field
				//DF 17/6/2010 - UAT#3028 - change field to bypass read only user property causing error on &quot;new&quot;.
				//var bcPickList = this.GetPicklistBusComp(&quot;Dealer Description&quot;);
				var bcPickList = this.GetPicklistBusComp(&quot;Dealer Description - Admin&quot;);			
				with (bcPickList)
				{
					ClearToQuery();
					SetSearchSpec(&quot;Description&quot;, &quot;&apos;&quot; + sDealer + &quot;&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						//Pick the dealer description. This will also set the dealer code
						//using the pickmap on the Dealer Description field.
						Pick();
					}
				}
					//this.SetFieldValue(&quot;VF Channel&quot;, sSalesChannel);					
			}//if	
				
				//Destroy picklist object
				bcPickList = null;
	
				//Set the sales channel
		
		}
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	} 
	finally 
	{
		//Destroy objects
		bcEmployee = null;
		boEmployee = null;
	}
}"
			   SEQUENCE="16"
			   UPDATED="04/01/2025 17:55:58"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetDefaultValues"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetDefaultValue
 * Component Information : 	This calls a business service which creates a component
 *							request (batch job) to process the credit check for the account.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/5/2010    DFiggis     R10.3 CA    Moved code from PreInvokeMethod because method reach max text length.	
 * 12/5/2010    DFiggis     #5233       Production fix to set Residential Status for Corporates.			
 */
function mSetDefaultValues()
{

	try 
	{ 		
		/*****************************************************************/
		// Defect 4625 - default field values to 0.
		// Save the record with user data changes
		/*****************************************************************/
		if (this.GetFieldValue(&quot;VF Previous Time at Address&quot;) == &quot;&quot;)
		 	this.SetFieldValue(&quot;VF Previous Time at Address&quot;, &quot;0&quot;);
		if (this.GetFieldValue(&quot;Account Type&quot;) == &quot;Person&quot;)
		{
			if (this.GetFieldValue(&quot;VF Number of Credit Cards&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Number of Credit Cards&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Gross Income&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Gross Income&quot;, &quot;0&quot;);
		}
		else
		{
			if (this.GetFieldValue(&quot;VF Director Net Monthly Income&quot;) == &quot;&quot;)
   			 	this.SetFieldValue(&quot;VF Director Net Monthly Income&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Director Time in Industry&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Director Time in Industry&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Num Partners-Owners&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Num Partners-Owners&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Number of Corporate Entities&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Number of Corporate Entities&quot;, &quot;0&quot;);
			if (this.GetFieldValue(&quot;VF Number of Locations&quot;) == &quot;&quot;)
			 	this.SetFieldValue(&quot;VF Number of Locations&quot;, &quot;0&quot;);
	 	}


		/*****************************************************************/
		// Defect 4789 - Set the Application Type.
		/*****************************************************************/
		if (this.GetFieldValue(&quot;Account Type&quot;) == &quot;Person&quot;)
		 	this.SetFieldValue(&quot;VF Credit Application Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_APP_TYPE&quot;,&quot;Consumer&quot;));
		else
		 	this.SetFieldValue(&quot;VF Credit Application Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CREDIT_APP_TYPE&quot;,&quot;Commercial&quot;));

			
		/*****************************************************************/
		// Defect 5233 - Set the Residential Status for Corporates.
		/*****************************************************************/		
		if (this.GetFieldValue(&quot;Account Type&quot;) != &quot;Person&quot;)
		{
			this.SetFieldValue(&quot;Own or Rent&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_RESIDENTIAL_STATUS&quot;,&quot;Unknown&quot;));
		}
		//01/02/2015RR: Added code for setting proper Intended Usage before submit
		
		var strAccId = this.GetFieldValue(&quot;Account Id&quot;);
		var strType = &quot;&quot;;
		var strCustType = &quot;&quot;;
		var strSTFlg = &quot;&quot;;
		var strBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var strBC = strBO.GetBusComp(&quot;Account&quot;);
		with(strBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;SOHO Customer&quot;);
			ActivateField(&quot;VF Customer Type&quot;); //Saravanan : 24/04/15: Defect# 15.2 - 96
			SetSearchSpec(&quot;Id&quot;,strAccId);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{
				strType = GetFieldValue(&quot;Type&quot;);
				strSTFlg = GetFieldValue(&quot;SOHO Customer&quot;);
				strCustType = GetFieldValue(&quot;VF Customer Type&quot;);	
			}
			if(strCustType == &quot;Person&quot;) // &amp;&amp; (strSTFlg == &quot;N&quot; || strSTFlg == &quot;&quot;))
				this.SetFieldValue(&quot;VF Intended Usage&quot;,&quot;Private&quot;);
			else
				this.SetFieldValue(&quot;VF Intended Usage&quot;,&quot;Commercial&quot;);
		}
		
			
		WriteRecord();
		
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{
		strBC = null;
		strBO = null;
	}
}"
			   SEQUENCE="17"
			   UPDATED="04/01/2025 17:55:57"
			   UPDATED_BY="SADMIN"
			   CREATED="03/28/2014 21:45:48"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetExpiryDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Com Financial Profile
 * Method Name           : 	mSetExpiryDate
 * Component Information : 	This method set the expriy date on the Fin Profile.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/9/2010    DFiggis     R11D        Moved code from PreInvokeMethod because method reach max text length.	
 */
function mSetExpiryDate()
{
	try 
	{ 
		// Start - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
		this.ActivateField(&quot;VF Credit Class&quot;);
		var sCreditClass = this.GetFieldValue(&quot;VF Credit Class&quot;);
		this.ActivateField(&quot;VF Financial Position&quot;);
		var sOccupation = this.GetFieldValue(&quot;VF Financial Position&quot;);
		this.ActivateField(&quot;VF Financial Status&quot;);
		var sEmpStatus = this.GetFieldValue(&quot;VF Financial Status&quot;);
		var sCreditClassCap = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_HARD_CAP_CC&quot;, sCreditClass);	
		
		if(sEmpStatus == &quot;Unemployed&quot; &amp;&amp; sOccupation == null &amp;&amp; sOccupation == &quot;&quot;)//Guru: 12/11/2021 - Added if block as part of PKE#93960
		{
			var strExpiryIncDays = mGetSysPref(&quot;VF UN CC Expiry Window - Days&quot;);
			this.SetFieldValue(&quot;VF Financial Position&quot;, &quot;Unemployed&quot;);
		}
		if(sEmpStatus != &quot;Unemployed&quot; &amp;&amp; sOccupation != &quot;&quot; &amp;&amp; sOccupation != null)
		{
			if((sCreditClass != &quot;&quot; &amp;&amp; sCreditClass != null) &amp;&amp; (sCreditClass == sCreditClassCap))
			{
				var strExpiryIncDays = mGetSysPref(&quot;VF HC CC Expiry Window - Days&quot;); 
			}
			else
			{
				var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;); 
			}
		}
		//End - Sachi - 7th Sep 2018 - Added for Hard Caps R18.4 to set Expiry Date for Assured Cap.
		//R11D 3/9/2011 DFIGGIS Get the credit check increment sys pref
		//var strExpiryIncDays = mGetSysPref(&quot;VF CC Expiry Window - Days&quot;);   			 	   			 	
 		var dToday = new Date();
 		//Get the current time in milliseconds
 		var iToday = dToday.getTime();	
 		//Add 30 days (calculated as milliseconds) to the current time
		//R11D 3/9/2011 DFiggis, remove 30 day hard coding
 		//var iNewExpiryDate = iToday + (30 * 24 * 60 * 60 * 1000);
 		var iNewExpiryDate = iToday + (strExpiryIncDays * 24 * 60 * 60 * 1000);		 		
 		var dNewExpiryDate = new Date(iNewExpiryDate);
		var sDateForm = (dNewExpiryDate.getMonth() + 1) + &quot;/&quot; + dNewExpiryDate.getDate() + &quot;/&quot; + dNewExpiryDate.getFullYear();
		var sTimeForm = sDateForm + &quot; &quot; + dNewExpiryDate.getHours() + &quot;:&quot; + dNewExpiryDate.getMinutes() + &quot;:&quot; + dNewExpiryDate.getSeconds();
 		this.ActivateField(&quot;VF Credit Check Expiry Date&quot;);
		this.ActivateField(&quot;VHA Credit Chk Exp Dt Matrix&quot;);//smart lock pke change
					if((TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;RestrictCCUpdate&quot;)) != &quot;Y&quot;)  //Veera: 05/17/2019: MR2: Added for MR1 Fallout
					{
						if((this.GetFieldValue(&quot;VHA Expiry Date Calc&quot;)) != &quot;Y&quot;)
						{
							this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
							this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
						}	
					}
					else
					{
						this.SetFieldValue(&quot;VF Credit Check Expiry Date&quot;, timeForm);
						this.SetFieldValue(&quot;VHA Credit Chk Exp Dt Matrix&quot;, timeForm);//Guru: 12/11/2021 - Added as part of PKE#93960
					}
 		dNewExpiryDate = null;
 		dToday = null;
   			 			
	} 
	catch(e) 
	{ 
		TheApplication().RaiseErrorText(e); 
	}
	finally 
	{

	}
}"
