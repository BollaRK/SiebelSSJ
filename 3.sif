			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
	try
	{
		var sViewName = TheApplication().GetProfileAttr(&quot;ViewName&quot;);
		var sManageServiceSubType;
		if(sViewName == &quot;FirstView&quot;)//this profile attrib will be set in each task
		{
			var sSessionId = this.GetFieldValue(&quot;Id&quot;);
			sManageServiceSubType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
			if(sManageServiceSubType == &quot;Change NBN Address&quot; || sManageServiceSubType == &quot;Modify&quot; || sManageServiceSubType == &quot;Change Location FWA&quot;)//Sakthi:Modified for FWA
			{
				this.ActivateField(&quot;Session Id&quot;);
				TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
				TheApplication().SetProfileAttr(&quot;ChangeLocTBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
			}
			else
			{
				TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,sSessionId);
			}
			this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
		}
		else
		{
			sManageServiceSubType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
			if(sManageServiceSubType == &quot;Change NBN Address&quot; || sManageServiceSubType == &quot;Modify&quot; || sManageServiceSubType == &quot;Change Location FWA&quot;)//Sakthi:Modified for FWA
			{
				this.ActivateField(&quot;Session Id&quot;);
				TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
				TheApplication().SetProfileAttr(&quot;ChangeLocTBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
			}
		}
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{

	}
}"
			   SEQUENCE="1"
			   UPDATED="02/13/2025 09:06:34"
			   UPDATED_BY="SADMIN"
			   CREATED="08/17/2016 09:03:55"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_WriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_WriteRecord ()
{
	//7.11.2017 - SK - Added for change location previous next issue: after applet was introducted with new searchspec with TBUISessionId
	//, previous next was not updating the correct session id. Hence on write record stamping again
	try
	{
		var sManageServiceSubType;
		
		sManageServiceSubType = TheApplication().GetProfileAttr(&quot;ManageServicesSubType&quot;);
		if(sManageServiceSubType == &quot;Change NBN Address&quot; || sManageServiceSubType == &quot;Modify&quot; || sManageServiceSubType == &quot;Change Location FWA&quot;)//Sakthi:Modified for FWA
		{
			this.ActivateField(&quot;Session Id&quot;);
			TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
			TheApplication().SetProfileAttr(&quot;ChangeLocTBUISessionId&quot;,this.GetFieldValue(&quot;Session Id&quot;));
		}
		
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{

	}
}"
