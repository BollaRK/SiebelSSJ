			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
/*************************************************************************************
 * Component Name        :	VF Billing Account
 * Method Name           :	BusComp_NewRecord
 * Component Information :	Gets the MVG  and realted Associate BC
 *							behind the Primary Contact Last Name field and 
 *							then queries the Associate BC for Parent Primary Contact Id.
 *							If a record is returned it invokes the 
 *							Associate method to create a billing account contact record
 *							contact record  contact record for the billing account using 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 13/05/2005	TAlihos					Initial Version Created to resolve W2 defect 
 * 15/07/2005	RP						Set gNewFlag to indicate that this is a new record						
 /************************************************************************************/
	try
	{
		
		
		//*******************************
		/* Declare Objects
		//*******************************/
		var bcContactMVG;
		var ContactMVGAssocBC;
		var bcParent;
	
		//*******************************
		/* Declare variables
		//*******************************/
		var strPrimaryConId;
		var strPARENTNAME = &apos;Account&apos;;
		
		
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF Billing Account.BusComp_NewRecord&quot;);
		}
		
		
		// Lets setup parent BC and check to see if
		//it&apos;s in the correct context.
		bcParent = this.ParentBusComp();
	
		if (bcParent.Name() == strPARENTNAME)
		{
			// set New flag
			gNewFlag = true;
			
			// If we are in the correct context we can set 
			// up our vairables
			strPrimaryConId = bcParent.GetFieldValue(&quot;Primary Contact Id&quot;);
			
			//Now lets see if parent has a primary contact?
			if (strPrimaryConId != &quot;&quot;)
			{
				//Set MVG object
				bcContactMVG = this.GetMVGBusComp(&quot;Primary Contact Last Name&quot;);
				
				//Now the we have our MVG lets get our Associate BC						
				ContactMVGAssocBC = bcContactMVG.GetAssocBusComp();
			
				//Now lets find the contact record which we so desired to Associate
				ContactMVGAssocBC.ClearToQuery();
				ContactMVGAssocBC.SetViewMode(AllView);
				ContactMVGAssocBC.SetSearchSpec(&quot;Id&quot;, strPrimaryConId);
				ContactMVGAssocBC.ExecuteQuery();
				
				//If our query returns a Contact
				if(ContactMVGAssocBC.FirstRecord())
				{
					try
					{
						//Now we are picking the record from MVG BC
						ContactMVGAssocBC.Associate(NewAfter);
					}
					catch(e)
					{
						throw (e.errText);
					}
				}
			}
		}
	}
	catch (e)
	{
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;ERROR:VF Billing Account.BusComp_NewRecord&quot;);
		}
	
		if(!defined(e.errText))
		{
			var strErrorMessage = e.toString();
		}
		else
		{
	    	var strErrorMessage = e.errText;
	    }
     	TheApplication().RaiseErrorText(strErrorMessage);
		
	
	}
	finally
	{
	
		//************************************
		//* Trace Statement
		//************************************
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF Billing Account.BusComp_NewRecord&quot;);
		}
	
		//*************************************
		//* Destroy Objects
		//*************************************
		bcParent = null;
		bcContactMVG = null;	
		ContactMVGAssocBC	= null;

	}	
}"
			   SEQUENCE="7"
			   UPDATED="06/07/2014 00:17:07"
			   UPDATED_BY="SADMIN"
			   CREATED="06/07/2014 00:17:07"
			   CREATED_BY="SADMIN">
