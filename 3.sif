			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_NewRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_NewRecord ()
{
	
/*
 * Component Name        : 	VF Applet New Record
 * Method Name           : 	PreInvokeMethod
 * Component Information : 	
 *							 
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 06/06/2014	Neel		Added code to predefault DOM and Bill Segment
 * 16/06/2014 	Neel		Added check to bypass setfield for other views.
 */
	
	
	try
	{


	
		var sViewName = TheApplication().GetProfileAttr(&quot;ViewName&quot;);
		if(sViewName == &quot;FirstView&quot;)//this profile attrib will be set in each task
		{
		    gNewRec = true;
			var sSessionId = this.GetFieldValue(&quot;Id&quot;);
			TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,sSessionId);
				
			//Neel - Default DOM and Bill Segment
			var bsTBUIUtilities = TheApplication().GetService(&quot;VF TBUI Utilities&quot;);
			var psInputs = TheApplication().NewPropertySet();
			var psOutputs = TheApplication().NewPropertySet();
				
			psInputs.SetProperty(&quot;Organization&quot;, TheApplication().GetProfileAttr(&quot;gOrgName&quot;));
			//psInputs.SetProperty(&quot;Organization&quot;, &quot;Vodafone AU&quot;);
			bsTBUIUtilities.InvokeMethod(&quot;SetCustomerBillSegmentDefault&quot;, psInputs, psOutputs);
			
			TheApplication().SetProfileAttr(&quot;Testabc&quot;,psOutputs.GetProperty(&quot;BillCycle&quot;)+sSessionId+psOutputs.GetProperty(&quot;BillSegment&quot;));
			this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
			this.SetFieldValue(&quot;Customer Bill Segment&quot;, psOutputs.GetProperty(&quot;BillSegment&quot;));
			this.SetFieldValue(&quot;DOM&quot;, psOutputs.GetProperty(&quot;BillCycle&quot;));
			this.SetFieldValue(&quot;Customer DOM&quot;, psOutputs.GetProperty(&quot;BillCycle&quot;));
			this.SetFieldValue(&quot;VF DOM Value&quot;, psOutputs.GetProperty(&quot;BillCycle&quot;)); // VHA:Aruns 16/04/2018: Created for SIM2 GO​18.2 CIR
			this.SetFieldValue(&quot;IsDOMReadOnly&quot;, &quot;Y&quot;);


		}
		else if(sViewName == &quot;FirstViewExst&quot;) 
		{
			var sSessionId = this.GetFieldValue(&quot;Id&quot;);
			TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,sSessionId);
			this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
			this.SetFieldValue(&quot;IsDOMReadOnly&quot;, &quot;Y&quot;);
		}
		else if(sViewName == &quot;FBBSQView&quot;) //Added for PIPE FBB
		{
			var sSessionId = this.GetFieldValue(&quot;Id&quot;);
			TheApplication().SetProfileAttr(&quot;TBUISessionId&quot;,sSessionId);
			this.SetFieldValue(&quot;Session Id&quot;, sSessionId);
			
		}
		
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
	finally
	{
		bsTBUIUtilities = null;
		gNewRec = false;
	/*Below variables are nullified by Sharukh on 05/04/2019*/

		if(defined(psInputs)) { psInputs = null; }
		if(defined(psOutputs)) { psOutputs = null; }

	//	gNewRec = &quot;FALSE&quot;;//VHA Muthushankari 9/9/2017 - Added for R17.4B Freedom CIR
	}
	
}"
			   SEQUENCE="9"
			   UPDATED="02/23/2026 18:29:44"
			   UPDATED_BY="MONISHAJ"
			   CREATED="04/28/2014 13:19:35"
			   CREATED_BY="SADMIN">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreInvokeMethod (MethodName)
{
try {
	//Neel 10/6/2014 - Added for change Address functionality - after
	//QAS validation, address fields wills be set to readonly. On clicking
	//ChangeAddress button, the field will be cleared off using this script
	
	//Vasavi added for  moconsq
	if(MethodName == &quot;GetAddress&quot;)
	{
		return(CancelOperation);
	}
	if(MethodName == &quot;EditRecordNew&quot;)
	{
		return(CancelOperation);
	}
	if(MethodName == &quot;FWAGetURL&quot;)
	{
		return(CancelOperation);
	}//end Vasavi added for Moconsq

	if(MethodName == &quot;InvokeAddrValidation&quot;)
	{
	var AddrFlag = TheApplication().GetProfileAttr(&quot;AddressFlag&quot;);//FWA
	if(AddrFlag == &quot;Y_MIG&quot;)
	{
	  this.SetFieldValue(&quot;FWA Address Status&quot;, &quot;1&quot;);
	  this.WriteRecord();
	}
	    this.ActivateField(&quot;ValidIdPresent&quot;);
		this.ActivateField(&quot;WSDL Service Address&quot;);
		var sValidIdPresent = this.GetFieldValue(&quot;ValidIdPresent&quot;);
		var sAddNewAccount = &quot;&quot;;
		sAddNewAccount = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);//[Nagesh],[CM-1397]
		var sChgAddrSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_CHANGE_ADDR&quot;, &quot;SWITCH&quot;);
		if(sChgAddrSwitch == &quot;ON&quot;)
		{
			if(sValidIdPresent == &quot;Y&quot; &amp;&amp; sAddNewAccount != &quot;Y&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;)
			{
				TheApplication().RaiseErrorText(&quot;You cannot modify the address. If you wish to modify the address, please delete the captured identification details in the next page and try again&quot;);
			}
			if(this.GetFieldValue(&quot;Address Status&quot;) != &quot;&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;)
			{
				this.SetFieldValue(&quot;Address Status&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;Address Selected&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;WSDL Address&quot;, &quot;&quot;);
				this.WriteRecord();
			}
			//Vasavi added if block for moconsq
			if(this.GetFieldValue(&quot;FWA Address Status&quot;) != &quot;&quot; &amp;&amp; (TheApplication().ActiveViewName() == &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; || TheApplication().ActiveViewName() == &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;))
			{
			    TheApplication().SetProfileAttr(&quot;AddressFlag&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;FWA Address Status&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;FWA Address Selected&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;WSDL Service Address&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VHA FWA Coverage Flag&quot;, &quot;&quot;);
				this.WriteRecord();
			}
		}
		else if(sChgAddrSwitch == &quot;OFF&quot;)
		{
			if(sAddNewAccount != &quot;Y&quot; &amp;&amp; sValidIdPresent == &quot;Y&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;)
			{
				TheApplication().RaiseErrorText(&quot;You cannot modify the address. If you wish to modify the address, please delete the captured identification details in the next page and try again&quot;);
			}
			if(this.GetFieldValue(&quot;Address Status&quot;) != &quot;&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; &amp;&amp; TheApplication().ActiveViewName() != &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;)
			{
				this.SetFieldValue(&quot;Address Status&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;Address Selected&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;WSDL Address&quot;, &quot;&quot;);
				this.WriteRecord();
			}
			//Vasavi added if block for moconsq
			if(this.GetFieldValue(&quot;FWA Address Status&quot;) != &quot;&quot; &amp;&amp; (TheApplication().ActiveViewName() == &quot;VF Capture Customer Details – Postpay FWA TBUI View&quot; || TheApplication().ActiveViewName() == &quot;VF Capture Exst Customer Details – Postpay FWA TBUI View&quot; || TheApplication().ActiveViewName() == &quot;VF Change Location Adress Details-Postpay FWA TBUI&quot;))
			{
			    TheApplication().SetProfileAttr(&quot;AddressFlag&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;FWA Address Status&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;FWA Address Selected&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;WSDL Service Address&quot;, &quot;&quot;);
				this.SetFieldValue(&quot;VHA FWA Coverage Flag&quot;, &quot;&quot;);
				this.WriteRecord();
			}
		}
	return(CancelOperation);
	}
		
	//10/12/2014 RR: SPS: Added for ABN/ACN Integration
	if(MethodName == &quot;InvokeABNACN&quot;)
	{
          var sException = false;
          var sFusionCode, sDispMessage, sErrorMessage;
          
          this.ActivateField(&quot;ABN/ACN&quot;);
          var sABN = this.GetFieldValue(&quot;ABN/ACN&quot;);
          if (sABN.length == 9 || sABN.length == 11)
		  {}
		  else
		  {			
				TheApplication().RaiseErrorText(&quot;Invalid ABN or ACN Number, ABN number must 11 digits long and ACN must be 9 digits long. Please enter the correct numbers to proceed with...&quot;);
		  }
		  
		  if (sABN == &quot;00000000000&quot; || sABN == &quot;00000000001&quot;)
		  {
				TheApplication().RaiseErrorText(&quot;00000000000 / 00000000001 is not a valid ABN/ACN number&quot;);
		  }
		  
		  if (sABN.length == 11)
		  {
		  		var sValidateABN = mValidateABN(sABN);			
				if (sValidateABN == false)
				{
					TheApplication().RaiseErrorText(&quot;Invalid ABN Number Please Enter Valid 11 Digit ABN number to proceed with...&quot;);
				}		  		
		  }
		  if (sABN.length == 9)
		  {
		  		var sValidateACN = mValidateACN(sABN);				
				if (sValidateACN == false)
				{
					TheApplication().RaiseErrorText(&quot;Invalid ACN Number Please Enter Valid 9 Digit ACN Number to proceed with...&quot;);
				}
		  }
          
          var svc       = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
          var Input     = TheApplication().NewPropertySet();
          var Output    = TheApplication().NewPropertySet();
                   
          Input.SetProperty(&quot;ProcessName&quot;, &quot;VF ABR Enquiry&quot;);
          Input.SetProperty(&quot;ABN_ACN_Num&quot;, sABN);        
          svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
                   
          sFusionCode	       = Output.GetProperty(&quot;BWErrCode&quot;);
          sException  		   = Output.GetProperty(&quot;WorkflowWithError&quot;);
          sDispMessage	       = Output.GetProperty(&quot;Display Error Message&quot;);
		  sErrorMessage    	   = Output.GetProperty(&quot;Error Message&quot;);
                   
          if (sFusionCode == 0 &amp;&amp; sException != true)
          {
             	var sCompanyName    = Output.GetProperty(&quot;CompanyName&quot;);
                var sTradingName    = Output.GetProperty(&quot;TradingName&quot;); 
				var sAbnStatus   	= Output.GetProperty(&quot;AbnStatus&quot;); 
				var sEntityType		= Output.GetProperty(&quot;EntityType&quot;); 
				var sTradingDate	= Output.GetProperty(&quot;TradingDate&quot;); 
                             
                this.SetFieldValue(&quot;Trading As&quot;,sTradingName);
                this.SetFieldValue(&quot;Company Name&quot;,sCompanyName);
                //this.SetFieldValue(&quot;VF ABN RO Flag&quot;,&apos;Y&apos;);
                this.WriteRecord();                         
          }
          else
          {
          		if (sDispMessage.length &gt;0)
				{
					//External Errors
	                TheApplication().RaiseErrorText(sDispMessage);
	            }
	            else if (sErrorMessage.length &gt;0)
	            {
	            	//Internal Errors
	            	TheApplication().RaiseErrorText(&quot;VFErrorCode#20002: Integration error with external system EAI.Please Contact the System Administrator.&quot;);
	            }
          }          
          //End of Code
          return(CancelOperation);
	}	
	
	if(MethodName == &quot;ResetABNACN&quot;)
	{
		this.ActivateField(&quot;ABN/ACN&quot;);
		this.ActivateField(&quot;Trading As&quot;);
		this.ActivateField(&quot;Company Name&quot;);
		//this.ActivateField(&quot;VF ABN RO Flag&quot;);
		//this.SetFieldValue(&quot;VF ABN RO Flag&quot;,&apos;N&apos;);
		this.SetFieldValue(&quot;ABN/ACN&quot;,&quot;&quot;);
		this.SetFieldValue(&quot;Trading As&quot;,&quot;&quot;);
    	this.SetFieldValue(&quot;Company Name&quot;,&quot;&quot;);    	
    	this.WriteRecord();
		return(CancelOperation);
	}
	if(MethodName == &quot;TestToggle&quot;)
	{
	TheApplication().RaiseErrorText(&quot;Hi&quot;);
    return(CancelOperation);
	
	}	
	
	if(MethodName == &quot;GetURL&quot;) // STE:Modified the Logic
	{
		//Neel 10.10.2014 - Removed View check;This BC is only used in TBUI;Should work for both
		//Postpaid New/Existing and Pre2Post
		//var sActiveView1 = TheApplication().ActiveViewName();
		//if (sActiveView1 == &quot;VF Capture Customer Details – Postpay TBUI&quot;)
		//{
			this.ActivateField(&quot;Street Address 2&quot;);
			this.ActivateField(&quot;Street Address&quot;);
			this.ActivateField(&quot;Address Street Type&quot;);
			this.ActivateField(&quot;City&quot;);
			this.ActivateField(&quot;State&quot;);
			this.ActivateField(&quot;Postal Code&quot;);
			this.ActivateField(&quot;WSDL Street Name&quot;);
			this.ActivateField(&quot;WSDL Street Number&quot;);
			this.ActivateField(&quot;WSDL Address Type&quot;);
			this.ActivateField(&quot;WSDL Street Type&quot;);
			this.ActivateField(&quot;WSDL Suburb&quot;);
			this.ActivateField(&quot;WSDL State&quot;);
			this.ActivateField(&quot;WSDL Post Code&quot;);	
			this.ActivateField(&quot;Map URL&quot;);
			this.ActivateField(&quot;Status&quot;);
			this.ActivateField(&quot;Coverage Check Id&quot;);
			this.ActivateField(&quot;Manual Address Entry&quot;);
			
			if(this.GetFieldValue(&quot;Manual Address Entry&quot;) != &quot;Y&quot;)
			{
			
				mCreateCoverageCheckbyAddress(&quot;CoverageCheck&quot;,
														this.GetFieldValue(&quot;WSDL Street Number&quot;),
														this.GetFieldValue(&quot;WSDL Street Name&quot;),
														this.GetFieldValue(&quot;WSDL Street Type&quot;),
														this.GetFieldValue(&quot;WSDL Suburb&quot;),
														this.GetFieldValue(&quot;WSDL State&quot;),
														this.GetFieldValue(&quot;WSDL Post Code&quot;)
														);
			}
			else
			{
				mCreateCoverageCheckbyAddress(&quot;CoverageCheck&quot;,
																this.GetFieldValue(&quot;Street Address 2&quot;),
																this.GetFieldValue(&quot;Street Address&quot;),
																this.GetFieldValue(&quot;Address Street Type&quot;),
																this.GetFieldValue(&quot;City&quot;),
																this.GetFieldValue(&quot;State&quot;),
																this.GetFieldValue(&quot;Postal Code&quot;)
																);
			}
															
		
			
			if(gCCId1 != null)
			{
					//invoke Sync Call moved from next button
					var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
    				var Input = TheApplication().NewPropertySet();
    				var Output = TheApplication().NewPropertySet();
    				Input.SetProperty(&quot;ProcessName&quot;, &quot;VF Coverage Check Workflow&quot;);
    				Input.SetProperty(&quot;Object Id&quot;, gCCId1);
    				Input.SetProperty(&quot;CoverageId&quot;, gCCId1);
    				svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
    		
			
			}
			if(gCCId1 != null)
			{
		
			mGetVocerageCheckURL(gCCId1);
			this.SetFieldValue(&quot;Map URL&quot;,gURL);
			this.SetFieldValue(&quot;Status&quot;,gStatus);
			this.SetFieldValue(&quot;Coverage Check Id&quot;,gCCId1);
			this.WriteRecord();
			}												
															
		//TheApplication().RaiseErrorText(&quot;Coverage Check is Processing.&quot;);
		gCCId1 = &quot;&quot;;	
		//}
		
		return(CancelOperation);
	 }
	 
	 //Vasavi added for RAF Project
	 if(MethodName == &quot;ValidateRAFCode&quot;)
     {
		return(CancelOperation);
	 } // end if Vasavi added for RAF Project
    
   //BALAJIM:Added below code for AddnewAccount button invoke
     if(MethodName == &quot;AddNewAccount&quot;)
     {
		TheApplication().SetProfileAttr(&quot;AddNewAccount&quot;,&quot;Y&quot;);
		return(CancelOperation);
	 } //BALAJIM: end if Added below code for AddnewAccount button invoke
   
	return (ContinueOperation);
	}
	catch (e)
	{
	throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 05/04/2019*/

		if(defined(svc)) { svc = null; }
		if(defined(Input)) { Input = null; }
		if(defined(Output)) { Output = null; }
		}

}"
			   SEQUENCE="10"
