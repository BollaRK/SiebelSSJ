			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreWriteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreWriteRecord ()
{
	/*
	* Component Name        : 	VF Capture Customer Details TBC
	* Method Name           : 	PreWriteMethod
	* Component Information : 	
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 06/09/2014	Roseline	TBUI   Nullify the corporate fields for Customer Type &apos;Person&apos;
								   QC Defect# 2437
	*/

	//VHA Muthushankari - 7/5/2019 - Added for R19.02 ABN/ACN Validation CIR
	//Kalidas:12/07/2019:Code added for Crash issue analysis
	var sView = TheApplication().ActiveViewName();
    if((sView == &quot;VF Capture Exst Customer Details Postpay TBUI&quot; || sView == &quot;VF Capture Exst Customer Details Postpay TBUI&quot;|| sView == &quot;VF Capture Customer Details - Postpay TBUI HI&quot;) &amp;&amp; sSKIPWriteFlg == &quot;Y&quot;)
	{
		if(this.GetFieldValue(&quot;VF Customer Segment&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CUSTOMER_SEGMENT&quot;,&quot;Business&quot;))
		{
			//mValidateABNACNDigits(this.GetFieldValue(&quot;ABN/ACN&quot;),this.GetFieldValue(&quot;VF Customer Type&quot;));
			if(TheApplication().GetProfileAttr(&quot;VHAABNACNPickTBUI&quot;) != &quot;Y&quot; &amp;&amp; TheApplication().GetProfileAttr(&quot;VHAValidateABNACNTbui&quot;) == &quot;N&quot;)
				TheApplication().RaiseErrorText(TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;98303&quot;));
			TheApplication().SetProfileAttr(&quot;VHAABNACNPickTBUI&quot;,&quot;&quot;);
			TheApplication().SetProfileAttr(&quot;VHAValidateABNACNTbui&quot;,&quot;&quot;);
		
		}
	}
	else
	{//Kalidas:End of code
		var sABNStatus = this.GetFieldValue(&quot;VF ABN Status&quot;);
		if(sABNStatus != &quot;Active&quot; &amp;&amp; sABNStatus != &quot;&quot; &amp;&amp; sABNStatus != null)
		{
			TheApplication().RaiseErrorText(&quot;ABN Status is Invalid.Ineligible Customer will not be permitted to create a Customer Account &quot;);
		}
		var sValidatePostFlg = this.GetFieldValue(&quot;VF Postcode Validate Flag&quot;);
		var sFWAValidatePostFlg = this.GetFieldValue(&quot;VF FWA Postcode Validate Flag&quot;);//Vasavi added for moconsq
		var sManualAddrFlg 	= this.GetFieldValue(&quot;Manual Address Entry&quot;);
		var sFWAManualAddrFlg 	= this.GetFieldValue(&quot;FWA Manual Address Entry&quot;);//Vasavi added for moconsq
		var sManPostCode=&quot;&quot;;
		//VHA KT 130326: Added for CM-9188
		if(TheApplication().ActiveViewName()==&quot;VF Capture Customer Details – Postpay - SSJ&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Exst Customer Details Postpay TBUI - SSJ&quot;){
		TheApplication().SetProfileAttr(&quot;ManPostCode&quot;, &quot;Y&quot;);
		sManPostCode = TheApplication().GetProfileAttr(&quot;ManPostCode&quot;);
		}
		else
		sManPostCode = TheApplication().GetProfileAttr(&quot;ManPostCode&quot;, &quot;Y&quot;);  //Sachi - 27/03/2020 - Added for R20.1 Capture Delivery Address CIR
		if(sManualAddrFlg == &quot;Y&quot;)
		{
			if(sValidatePostFlg == &quot;N&quot; &amp;&amp; sManPostCode != &quot;Y&quot;)  //Sachi - 27/03/2020 - Modified for R20.1 Capture Delivery Address CIR
			{
				TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query AusPost atleast once before saving an unvalidated address.&quot;);	
			}
		}
		//Vasavi added below if for moconsq
		if(sFWAManualAddrFlg == &quot;Y&quot;)
		{
			if(sFWAValidatePostFlg == &quot;N&quot; &amp;&amp; sManPostCode != &quot;Y&quot;)  //Sachi - 27/03/2020 - Modified for R20.1 Capture Delivery Address CIR
			{
				TheApplication().RaiseErrorText(&quot;VFErrorCode#10131: It is required to query AusPost atleast once before saving an unvalidated address.&quot;);	
			}
		}//end Vasavi

		//Kalidas:30/06/2015:End of code
		var sValidateShipPostFlg = this.GetFieldValue(&quot;VHA Ship Postcode Validate Flag&quot;);  //Start - Added by Sachi - 24/03/2020 - R20.1 Capture Delivery Address
		var sManualShipAddrFlg 	= this.GetFieldValue(&quot;Manual Shipment Address&quot;);
		var sManShipPostCode=&quot;&quot;
		//VHA KT 130326: Added for CM-9188
		if(TheApplication().ActiveViewName()==&quot;VF Capture Customer Details – Postpay - SSJ&quot; || TheApplication().ActiveViewName()==&quot;VF Capture Exst Customer Details Postpay TBUI - SSJ&quot;){
		TheApplication().SetProfileAttr(&quot;ManShipPostCode&quot;, &quot;Y&quot;);
		sManShipPostCode = TheApplication().GetProfileAttr(&quot;ManShipPostCode&quot;);
		}
		else
		sManShipPostCode = TheApplication().GetProfileAttr(&quot;ManShipPostCode&quot;, &quot;Y&quot;);
		if(sManualShipAddrFlg == &quot;Y&quot;)
		{
			if(sValidateShipPostFlg == &quot;N&quot; &amp;&amp; sManShipPostCode != &quot;Y&quot;)
			{
				TheApplication().RaiseErrorText(&quot;It is required to query AusPost atleast once before saving an unvalidated shipping address.&quot;);	
			}
		} //End - Added by Sachi - 24/03/2020 - R20.1 Capture Delivery Address
		try
		{
			//if(this.GetFieldValue(&quot;Customer Type&quot;) == &quot;Person&quot;
			if(this.GetFieldValue(&quot;Customer Type&quot;) == &quot;Person&quot; &amp;&amp; this.GetFieldValue(&quot;Sole Trader&quot;) == &quot;N&quot;)
			{
				this.SetFieldValue(&quot;ABN/ACN&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;Industry Type&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;Trading As&quot;,&quot;&quot;);
				this.SetFieldValue(&quot;Company Name&quot;,&quot;&quot;);
			}
			/*	
			var sCustType = this.GetFieldValue(&quot;VF Customer Type&quot;);
			if (sCustType == &quot;Sole Trader&quot;)
			{
				this.SetFieldValue(&quot;Customer Type&quot;, &quot;Person&quot;);
			}
			else
			{
				this.SetFieldValue(&quot;Customer Type&quot;, &quot;sCustType&quot;);
			}	*/
		}
		catch (e)
		{
			TheApplication().RaiseErrorText(e.toString());
		}
		finally
		{
	
		}
	}
	return (ContinueOperation);
}"
