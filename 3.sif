			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_PreSetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_PreSetFieldValue (FieldName, FieldValue)
{
    
if (FieldName == &quot;Comment&quot;)
{
TheApplication().SetProfileAttr(&quot;SIMSwapEmailAdd&quot;,FieldValue);
}
	return (ContinueOperation);
}"
			   SEQUENCE="9"
			   UPDATED="04/11/2026 19:15:14"
			   UPDATED_BY="SUJATHAS"
			   CREATED="04/11/2026 19:15:14"
			   CREATED_BY="SUJATHAS">
			</BUSCOMP_SERVER_SCRIPT>
			<BUSCOMP_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="BusComp_SetFieldValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
var iRetry = 0;
if(FieldName == &quot;Number of Imports&quot;)
{
this.WriteRecord();
}


if(FieldName == &quot;Comment&quot;)
{
	try 
	{ 
		
		var sId = this.GetFieldValue(&quot;Id&quot;);
		this.ClearToQuery();
		this.SetSearchSpec(&quot;Id&quot;,sId);
		this.ExecuteQuery(ForwardOnly);
		if(this.FirstRecord())
		{
		retry:
		this.WriteRecord();
		}
		this.ClearToQuery();
		this.ExecuteQuery(ForwardBackward);
	}

	catch (e1)
	{             // TD 459
			if (iRetry &gt;= 3)
			{
				throw(e1);
			} 			
			else 
			{
				if (e1.toString().indexOf(&quot;SBL-DAT-00523&quot;) &gt; -1) {
				// selected record has been modified by another user since it was retrieved.  Please continue
				iRetry++;
				goto retry;         
				 // retry update
				} 
				else 
				{
				throw(e1);
				}
			}
	}
}

return (ContinueOperation);
}"
