			   SCRIPT="function BusComp_SetFieldValue (FieldName)
{
try {
		/*var sPostExst = TheApplication().GetProfileAttr(&quot;AddNewAccount&quot;);//[Nagesh][CM-2040]
		var sAddress = this.GetFieldValue(&quot;WSDL Address&quot;);		
			if(sPostExst == &quot;Y&quot; &amp;&amp; sAddress != &quot;&quot; || sAddress != null)
            {
