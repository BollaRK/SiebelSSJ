			   SCRIPT="var gURL=&quot;&quot;;
var gStatus=&quot;&quot;;
var gCCId1=&quot;&quot;;
var gNewRec = false;//VHA Muthushankari 9/9/2017 - Added for R17.4B Freedom CIR
var sSkipPINFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SWITCH&quot;, &quot;SKIP_PIN&quot;);
var sSKIPWriteFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SWITCH&quot;, &quot;SKIP_Write&quot;);"
